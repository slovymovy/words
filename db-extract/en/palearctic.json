            {
                "entry_id": "8beb07a8-201f-3c6a-9eb5-96dc73dfb20d",
                "word": "Palearctic",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0332bfa9-35a3-4bdf-b68c-c8c380cbb1c7",
                        "entry_id": "8beb07a8-201f-3c6a-9eb5-96dc73dfb20d",
                        "tags": [
                            "canonical"
                        ],
                        "form": "the Palearctic"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b010c3e3-0f49-3327-823c-9ebad1001cc5",
                        "entry_id": "8beb07a8-201f-3c6a-9eb5-96dc73dfb20d",
                        "glosses": [
                            "One of the major ecozones of the world, covering Europe, the former territories of the USSR, part of North Africa, and North Asia including the Himalaya foothills."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54eb4104-ca46-41de-9df6-ca7ad423c227",
                        "source_entry_id": "8beb07a8-201f-3c6a-9eb5-96dc73dfb20d",
                        "source_sense_id": "b010c3e3-0f49-3327-823c-9ebad1001cc5",
                        "source_sense_description": "One of the major ecozones of the world",
                        "target_lang_word": "Paléarctique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "60bda4a2-c04f-40eb-afbc-6b2276c8dd44",
                        "source_entry_id": "8beb07a8-201f-3c6a-9eb5-96dc73dfb20d",
                        "source_sense_id": "b010c3e3-0f49-3327-823c-9ebad1001cc5",
                        "source_sense_description": "One of the major ecozones of the world",
                        "target_lang_word": "Paläarktis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paläarktis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c8f752f-cf22-334d-863f-f5a25fee38a2",
                                        "entry_id": "ea3c202d-07d9-3e18-8274-270047ab7bb4",
                                        "glosses": [
                                            "eine biogeografische Region, die die „alten“ Landmassen Europas, Nordafrikas bis zum Südrand der Sahara und Asiens (südlich bis zum Himalaja, also z. B. ohne den Indischen Subkontinent und die Arabische Halbinsel) sowie die vor diesen Gebieten liegenden Inseln umfasst"
                                        ],
                                        "tags": [
                                            "Biogeografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc3d0bf6-fc94-4fcd-b215-f863220571be",
                                                "sense_id": "0c8f752f-cf22-334d-863f-f5a25fee38a2",
                                                "text": "„Die Paläarktis besteht aus Eurasien, mit Ausnahme von Indien und Hinterindien, und schließt Teile Nordafrikas und Kleinasiens ein.“"
                                            },
                                            {
                                                "example_id": "99e550b5-a0ea-489d-b10b-17925b877787",
                                                "sense_id": "0c8f752f-cf22-334d-863f-f5a25fee38a2",
                                                "text": "„Der Grad des Endemismus beträgt bei Landsäugerfamilien der Holarktis 19%, in der Paläarktis sogar nur 3% ( Abb. 2).“"
                                            },
                                            {
                                                "example_id": "31c64bf0-bf25-415a-930d-66183dada822",
                                                "sense_id": "0c8f752f-cf22-334d-863f-f5a25fee38a2",
                                                "text": "„Die Gemeinsamkeiten zwischen der Paläarktis und Nearktis sind auf die ähnliche historische Entwicklung in den mittleren und hohen Breiten zurückzuführen.“"
                                            },
                                            {
                                                "example_id": "a0ad7163-5bf1-433d-aae3-df3af9a3a1ea",
                                                "sense_id": "0c8f752f-cf22-334d-863f-f5a25fee38a2",
                                                "text": "„In den nördlichen Teilen von Nordamerika finden sich daher zahlreiche holarktische Arten, d.h. solche, die sowohl in der Nearktis als auch in der Paläarktis verbreitet sind.“"
                                            },
                                            {
                                                "example_id": "bb2743e7-2586-43f8-af09-879698dce990",
                                                "sense_id": "0c8f752f-cf22-334d-863f-f5a25fee38a2",
                                                "text": "„Die Tatsache, daß in Nordamerika bestimmte Tiergruppen der Paläarktis nicht vorkommen, hat dazu geführt, daß vielfach Arten aus anderen systematischen Gruppen die ökologische Planstelle der fehlenden vertreten (Stellenäquivalenz),“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7e30ca9-c607-4d3a-b28f-d45b33f6ddc4",
                        "source_entry_id": "8beb07a8-201f-3c6a-9eb5-96dc73dfb20d",
                        "source_sense_id": "b010c3e3-0f49-3327-823c-9ebad1001cc5",
                        "source_sense_description": "One of the major ecozones of the world",
                        "target_lang_word": "Palearktyka",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Palearktyka",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "64b91ed4-406f-3423-bff0-237f2316b023",
                                        "entry_id": "a1eb052f-81cb-36fb-b0f1-ba9a3670a746",
                                        "glosses": [
                                            "najrozleglejszy lądowy rejon zoogeograficzny, leżący w obrębie Holarktyki, a obejmujący całą Europę, północną i środkową Azję oraz północną Afrykę"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f993af42-a94c-456a-b5c4-a79923a311ac",
                                                "sense_id": "64b91ed4-406f-3423-bff0-237f2316b023",
                                                "text": "Występuje w całej Palearktyce norniki bure stają się plagą upraw roślinnych."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86b54282-cf2c-45bd-a5f2-34af431a66a8",
                        "source_entry_id": "8beb07a8-201f-3c6a-9eb5-96dc73dfb20d",
                        "source_sense_id": "b010c3e3-0f49-3327-823c-9ebad1001cc5",
                        "source_sense_description": "One of the major ecozones of the world",
