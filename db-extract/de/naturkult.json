                "senses": [
                    {
                        "sense_id": "c12a5405-8dea-3992-a77b-e5fc9ff3e3e6",
                        "entry_id": "b10abc7b-f0b9-334d-a374-0e7026fa73aa",
                        "glosses": [
                            "auf Naturphänomene bezogene Riten (einer einheimischen Urbevölkerung); Verehrung all dessen, was man mit einer idealisierten Natur (zum Beispiel, wie sie bei Rousseau gesehen wird) in Verbindung bringt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "e98ea964-2685-43ee-ba82-5a6e18fc1a3b",
                                "sense_id": "c12a5405-8dea-3992-a77b-e5fc9ff3e3e6",
                                "text": "„Als die slawischen Stämme sich dauerhaft ansiedelten, brachten sie eine Vielzahl von Göttern und Naturkulten mit.“"
                            },
                            {
                                "example_id": "587f7b0e-f3c4-4922-8dba-c7c7947d31d0",
                                "sense_id": "c12a5405-8dea-3992-a77b-e5fc9ff3e3e6",
                                "text": "„Der Naturkult, dessen religiöse Gegenstände in den Ahnenkult aufgenommen und in mythologisch - politische Ahnengötter umgestaltet wurden, scheint mit seinem animistischen Charakter mutterrechtlich zu sein.“"
                            },
                            {
                                "example_id": "228d1026-db8a-480b-ba40-8c4e350fa278",
                                "sense_id": "c12a5405-8dea-3992-a77b-e5fc9ff3e3e6",
                                "text": "„Die Pechpfannenbeleuchtung, die seltsam bewegliche Schatten hervorzauberte, das Zigeunerlager unter dem Sternenhimmel, Musik, Gesang, Tanz und ferner Hörnerklang: das war romantischer Naturkult nach dem Herzen der Zeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
