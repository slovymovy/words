                ],
                "translations": [
                    {
                        "translation_id": "f572ddd5-2002-45ae-8a1f-04a43d3ae08e",
                        "source_entry_id": "64537562-b60e-3b21-8846-b40fb37184d0",
                        "source_sense_id": "21d2b975-3166-3302-978c-bd18585337de",
                        "target_lang_word": "absichtlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absichtlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1fff4eeb-ac5f-3b3d-a6e1-1dd18a096524",
                                        "entry_id": "5a408a7b-b14a-30e5-92c6-60913dba8703",
                                        "glosses": [
                                            "die Auswirkung seiner Handlung wollend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fa99da5-dc1e-46b5-95e6-e4f0c7bcf224",
                                                "sense_id": "1fff4eeb-ac5f-3b3d-a6e1-1dd18a096524",
                                                "text": "Es wurden absichtlich Waldbrände gelegt, um das Terrain im Nachhinein nutzen zu können."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c26d2131-6dc9-477a-8577-f2be93d6b76d",
                        "source_entry_id": "64537562-b60e-3b21-8846-b40fb37184d0",
                        "source_sense_id": "21d2b975-3166-3302-978c-bd18585337de",
                        "target_lang_word": "Absicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Absicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "457a30ab-e656-3279-af2f-fe810577a6fb",
                                        "entry_id": "42fd2d71-a57e-3f68-8a5f-768c430ecf26",
                                        "glosses": [
                                            "Wille, etwas zu realisieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "088a6841-c7d3-4afd-a225-12b7a022af6d",
                                                "sense_id": "457a30ab-e656-3279-af2f-fe810577a6fb",
                                                "text": "„Die Rechtheit der Absicht allein macht nicht schon den ganzen guten Willen.“"
                                            },
                                            {
                                                "example_id": "309df2ac-cf08-4cfc-b13b-887aee57ff4d",
                                                "sense_id": "457a30ab-e656-3279-af2f-fe810577a6fb",
                                                "text": "Es war meine Absicht, dich zu besuchen."
                                            },
                                            {
                                                "example_id": "585d8d70-3ae1-4a54-9beb-b06eb7ec3fb2",
                                                "sense_id": "457a30ab-e656-3279-af2f-fe810577a6fb",
                                                "text": "„Niemand hat die Absicht, eine Mauer zu errichten.“ (Walter Ulbricht, Pressekonferenz in Berlin (Ost) am 15. Juni 1961, 60 Tage vor dem Mauerbau)."
                                            },
                                            {
                                                "example_id": "241c8322-c8cf-4032-98c0-7ca190452213",
                                                "sense_id": "457a30ab-e656-3279-af2f-fe810577a6fb",
                                                "text": "„Candiani, der meine Rache fürchtete, kam zu mir, um mich nach meinen Absichten zu fragen, nahm aber geschwind Reißaus, als ich mit dem Federmesser in der Hand auf ihn losging.“"
                                            },
                                            {
                                                "example_id": "2a73ca0c-e30f-4550-b0e3-7e594c193033",
                                                "sense_id": "457a30ab-e656-3279-af2f-fe810577a6fb",
                                                "text": "„Wiederholt hatte Robert in den nächsten Tagen die Absicht gehabt, eine Unterredung mit dem Sekretär der Präfektur herbeizuführen.“"
                                            },
                                            {
                                                "example_id": "19df6505-c121-440e-a2f2-821cac53dc6c",
                                                "sense_id": "457a30ab-e656-3279-af2f-fe810577a6fb",
                                                "text": "„Ihr offener, zuversichtlicher Ton war jedoch ein hinlänglicher Beweis, daß sie keine Mitwisserschaft habe, was auch um so wahrscheinlicher schien, als es sich kaum denken ließ, daß die Wilden, im Falle sie wirklich etwas Feindseliges im Schilde führten, ihr ihre Absichten kundgetan haben würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "805ff000-415e-3f48-a5da-5d2524fb2ce0",
                                        "entry_id": "42fd2d71-a57e-3f68-8a5f-768c430ecf26",
                                        "glosses": [
                                            "Grund für eine Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54dd8b6a-55ba-4212-a524-2c6e8d64fe3a",
                                                "sense_id": "805ff000-415e-3f48-a5da-5d2524fb2ce0",
                                                "text": "Mein Handeln war von der Absicht getragen, dir Gutes zu tun."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c687d746-c781-37ec-b82c-41fcab0f00a7",
                                        "entry_id": "42fd2d71-a57e-3f68-8a5f-768c430ecf26",
                                        "glosses": [
                                            "besondere Form des Vorsatzes im Strafrecht, die sich dadurch auszeichnet, dass es dem Täter auf den Erfolg ankommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72050a77-48f0-4295-963d-2a19b48b92f9",
                                                "sense_id": "c687d746-c781-37ec-b82c-41fcab0f00a7",
                                                "text": "Einen Diebstahl gemäß § 242 StGB verwirklicht nur, wer mit der Absicht handelt, sich eine fremde Sache zuzueignen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34f70420-7f63-4aca-bb73-7ffeb2ad8092",
                        "source_entry_id": "64537562-b60e-3b21-8846-b40fb37184d0",
                        "source_sense_id": "21d2b975-3166-3302-978c-bd18585337de",
                        "target_lang_word": "vorsätzlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
