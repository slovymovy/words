                "translations": [
                    {
                        "translation_id": "451277a3-82b9-4a66-838e-dc5e009aa9b9",
                        "source_entry_id": "919ef63b-2f3f-3a15-b27c-259984c42c46",
                        "source_sense_id": "e13264cc-6812-32de-95d0-71e86c95ab8f",
                        "target_lang_word": "sou",
