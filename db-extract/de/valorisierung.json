                "senses": [
                    {
                        "sense_id": "70a58231-0b88-3026-9b26-9fe8f565328b",
                        "entry_id": "7c4e8d7f-b3fb-3904-b6fa-ccea56a9120c",
                        "glosses": [
                            "Anpassung aufgrund der Geldentwertung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cb534dc-d887-4cee-80d0-98a5ba0fbaba",
                                "sense_id": "70a58231-0b88-3026-9b26-9fe8f565328b",
                                "text": "„Bemessungsgrundlage für die Leistungsfeststellung in der Unfallversicherung ist ja ein sehr aktueller Wert, nämlich der letzte Jahresarbeitsverdienst, der erst einer entsprechend späteren Valorisierung bedarf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9febcc31-1332-3ab5-ae4a-e74853462952",
                        "entry_id": "7c4e8d7f-b3fb-3904-b6fa-ccea56a9120c",
                        "glosses": [
                            "Ausstattung von etwas Immateriellen mit einem bleibenden Wert für die breite Öffentlichkeit"
                        ],
                        "tags": [
                            "akademische Sprache"
                        ],
                        "examples": [
                            {
                                "example_id": "7bda08cc-9c30-487a-9498-b4481168aa96",
                                "sense_id": "9febcc31-1332-3ab5-ae4a-e74853462952",
                                "text": "„Strategische Periodenziele [der Unternehmen der Schweizerischen Akademie der Geistes- und Sozialwissenschaften sind unter anderem] Valorisierung des kulturellen und sprachlichen Erbes, Vermittlung und Steigerung der Bekanntheit der Publikationen in den Fachgemeinschaften und der Öffentlichkeit.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
