                                                "sense_id": "62f413a5-06d6-3956-8329-e8505c0d992f",
                                                "text": "Wenn man 4cl Gin mit Tonic Water auffüllt, bekommt man einen Gin Tonic."
                                            },
                                            {
                                                "example_id": "e32ce58d-4cb0-4ecf-8421-155c15d1eb7e",
                                                "sense_id": "62f413a5-06d6-3956-8329-e8505c0d992f",
                                                "text": "Gegen einen gepflegten Gin Tonic habe ich nichts einzuwenden."
                                            }
                                        ],
