                                            {
                                                "example_id": "517a1743-e5f9-411f-91bc-3fadcbace138",
                                                "sense_id": "7d77a986-2dab-3517-b92b-fd1a3d4af3d4",
                                                "text": "You should give clear, succinct information to the clients."
                                            },
                                            {
                                                "example_id": "52169263-f235-44f8-b809-9fc8f2fa5fe2",
                                                "sense_id": "7d77a986-2dab-3517-b92b-fd1a3d4af3d4",
                                                "text": "But he made the truth very comfortable, and gave a succinct statement of the young man's brilliant beginnings."
                                            },
                                            {
                                                "example_id": "7b9faa2c-22cb-4f53-98f3-3d7bc2a21a4d",
                                                "sense_id": "7d77a986-2dab-3517-b92b-fd1a3d4af3d4",
                                                "text": "Philip wired a succinct affirmative, and next morning a stranger presented himself at the studio."
                                            },
                                            {
                                                "example_id": "f4d808d1-8296-47fc-826a-5426ae476499",
                                                "sense_id": "7d77a986-2dab-3517-b92b-fd1a3d4af3d4",
                                                "text": "The Derby Carriage Works foreman, when informed that this coach was to be run at 90 m.p.h. to obtain information on bogie hunting, is reported to have offered one succinct word of advice - \"Don't!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daa822a1-e6e9-369e-979f-c73654b4dfd9",
                                        "entry_id": "43efc808-1575-3806-ab64-23e042d20568",
                                        "glosses": [
                                            "Compressed into a tiny area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b18556af-9c9b-4f20-afe0-518e05e307a2",
                                                "sense_id": "daa822a1-e6e9-369e-979f-c73654b4dfd9",
                                                "text": "Unlike general lossless data compression algorithms, succinct data structures retain the ability to use them in-place, without decompressing them first."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aa9f689-f0d9-3522-99d9-de0ef303a475",
                                        "entry_id": "43efc808-1575-3806-ab64-23e042d20568",
                                        "glosses": [
