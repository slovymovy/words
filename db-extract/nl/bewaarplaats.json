                                                "sense_id": "b8ff5762-373c-3afa-8531-bfa41743fa6d",
                                                "text": "And here the adventurers went ashore, unloaded, turned their canoe bottom up in the shelter of thick brush, and cached their supplies temporarily on a pole scaffold, out of reach of prowling depredators."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c9a6840-2a28-3d74-bc73-2b30bfc31f30",
                                        "entry_id": "b96e0df1-f7aa-3e3e-b018-651c835ee17c",
                                        "glosses": [
                                            "To store data in a cache."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
