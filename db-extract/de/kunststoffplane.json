                "senses": [
                    {
                        "sense_id": "d2da94b4-7336-3451-83d6-308052b6aea4",
                        "entry_id": "157f76ae-0648-336f-8bac-f9292f51e0b4",
                        "glosses": [
                            "Decke aus Kunststoff, vorwiegend zur Abdeckung von Fahrzeugen und Waren, als Sichtschutz und zum Schutz vor Regen und Sonneneinstrahlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d73a9c9-a1b5-499a-9730-fde904238675",
                                "sense_id": "d2da94b4-7336-3451-83d6-308052b6aea4",
                                "text": "„Später, als die Firma den Schwerpunkt auf Autoplanen legte, wurden die Kunststoffplanen erst verklebt, heute werden sie thermisch verschweißt.“"
                            },
                            {
                                "example_id": "e28bcdda-18c9-4e7d-9ee2-ad94863342ad",
                                "sense_id": "d2da94b4-7336-3451-83d6-308052b6aea4",
                                "text": "„Eine 20 Jahre alte Frau aus München befuhr mit ihrem Mini den linken Fahrstreifen der zweispurigen Autobahn und versuchte offenbar, einer aufgewirbelten Kunststoffplane auszuweichen.“"
                            },
                            {
                                "example_id": "9e6b2a4a-dab7-4dcf-a179-3fe6e7b7e3f4",
                                "sense_id": "d2da94b4-7336-3451-83d6-308052b6aea4",
                                "text": "„Das Abdecksystem besteht allein aus 2 Meter breiten gewebten Kunststoffplanen, perforiertem PVC-, Stahlrohren und Spannbändern.“"
                            },
                            {
                                "example_id": "00ce4f35-acbc-4b6d-8649-a7adfc9e3775",
                                "sense_id": "d2da94b4-7336-3451-83d6-308052b6aea4",
                                "text": "„Einsatzbetriebe können ihr Engagement für den Zivildienst mit einer wetterfesten und leicht montierbaren Kunststoffplane sichtbar machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
