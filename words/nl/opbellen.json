                        {
                            "text": "Ik zal je morgenochtend even <w>opbellen</w> om de afspraak te bevestigen.",
                            "target_lang_translations": {
                                "en": "I will <w>call</w> you tomorrow morning to confirm the appointment.",
                                "ru": "Я <w>позвоню</w> тебе завтра утром, чтобы подтвердить встречу.",
                                "pl": "<w>Zadzwonię</w> do ciebie jutro rano, żeby potwierdzić spotkanie.",
                                "de": "Ich werde dich morgen früh kurz <w>anrufen</w>, um den Termin zu bestätigen.",
                                "fr": "Je t'<w>appellerai</w> demain matin pour confirmer le rendez-vous.",
                                "it": "Ti <w>chiamerò</w> domani mattina per confermare l'appuntamento.",
                                "cs": "Zítra ráno ti <w>zavolám</w>, abych potvrdil naši schůzku.",
                                "tr": "Randevuyu onaylamak için yarın sabah seni <w>arayacağım</w>.",
                                "es": "Te <w>llamaré</w> mañana por la mañana para confirmar la cita.",
                                "zh": "我明天早上会给你<w>打电话</w>确认预约。"
                            }
                        },
                        {
                            "text": "Je moet de dokter direct <w>opbellen</w> als de pijn erger wordt.",
                            "target_lang_translations": {
                                "en": "You must <w>phone</w> the doctor immediately if the pain gets worse.",
                                "ru": "Тебе нужно немедленно <w>позвонить</w> врачу, если боль усилится.",
                                "pl": "Musisz natychmiast <w>zadzwonić</w> do lekarza, jeśli ból się nasili.",
                                "de": "Du musst sofort den Arzt <w>anrufen</w>, wenn die Schmerzen schlimmer werden.",
                                "fr": "Tu dois <w>appeler</w> le médecin immédiatement si la douleur s'aggrave.",
                                "it": "Devi <w>chiamare</w> subito il medico se il dolore peggiora.",
                                "cs": "Pokud se bolest zhorší, musíš doktorovi okamžitě <w>zavolat</w>.",
                                "tr": "Ağrı şiddetlenirse derhal doktoru <w>aramalısın</w>.",
                                "es": "Debes <w>llamar</w> al médico de inmediato si el dolor empeora.",
                                "zh": "如果疼痛加剧，你应该立刻给医生<w>打电话</w>。"
                            }
                        }
