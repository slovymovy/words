                        "cross_references": []
                    },
                    {
                        "translation_id": "85e25c90-3ec5-4eaf-8493-f242c6e4a0e6",
                        "source_entry_id": "a346424c-5d13-3f49-8a70-033255f4df32",
                        "source_sense_id": "c37f9ef1-d42a-38cb-908f-fd4f1c3dac74",
                        "target_lang_word": "quantum entanglement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quantum entanglement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b58ba5d8-bb0c-392c-9e1c-5b98f6685aec",
                                        "entry_id": "f679097d-fa0b-3e8a-841e-ebedeed08c7a",
                                        "glosses": [
                                            "A quantum mechanical phenomenon in which the quantum states of two or more objects have to be described with reference to each other, even though the individual objects are spatially separated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d15c6b7-c5a1-4ebf-9fc4-79d169fbfb6f",
                        "source_entry_id": "a346424c-5d13-3f49-8a70-033255f4df32",
                        "source_sense_id": "c37f9ef1-d42a-38cb-908f-fd4f1c3dac74",
                        "target_lang_word": "intrication quantique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intrication quantique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ae6e968-61ca-340e-9810-9650a807e3ce",
                                        "entry_id": "68fadc79-2e01-34f2-a943-387a78bb5cd3",
                                        "glosses": [
                                            "Phénomène, observé en physique quantique, dans lequel l’état d’un système de plusieurs particules séparées spatialement ne peut être décrit que globalement en raison de l’existence de corrélations entre les propriétés physiques internes de chacune de ces particules."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4528000c-2802-46f7-8a8b-5bcc87ca83c3",
                                                "sense_id": "0ae6e968-61ca-340e-9810-9650a807e3ce",
                                                "text": "...après une première tentative par Stuart Freedman and John Clauser en 1972, c’est surtout en 1981 qu’une fameuse expérience menée par Alain Aspect et son équipe ouvre la voie à ce qui est bien la confirmation de la « non-localité » quantique, invalidant par la même occasion l’hypothèse du caractère incomplet de la théorie quantique. L’intrication quantique est une réalité !"
                                            },
                                            {
                                                "example_id": "c9ecf485-cd23-47f3-ad4e-e47a44fb9daf",
                                                "sense_id": "0ae6e968-61ca-340e-9810-9650a807e3ce",
                                                "text": "Le chercheur a été récompensé, au côté de l’Américain John Clauser et de l’Autrichien Anton Zeilinger, pour ses découvertes sur l’intrication quantique. Il s'agit d’un phénomène où deux particules restent corrélées, quelle que soit la distance qui les sépare."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
