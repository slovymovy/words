                "senses": [
                    {
                        "sense_id": "27edda34-eef1-3432-a3a0-44e31c26f6db",
                        "entry_id": "754b7bec-9a65-3cec-bbd3-5beb278eef4f",
                        "glosses": [
                            "rozciągły, obszerny, obfity ilościowo"
                        ],
