            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c6e992f-9688-373f-a2e8-920eb0dc53b0",
                    "sense_definition": "Дополнительная работа, выполняемая помимо основной для получения заработка.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "дополнительный заработок",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вечерами он берет <w>халтуру</w> по ремонту квартир.",
                            "target_lang_translations": {
                                "en": "In the evenings, he takes on a <w>gig</w> repairing apartments."
                            }
                        },
                        {
                            "text": "Найти хорошую <w>халтуру</w> в наше время бывает непросто.",
                            "target_lang_translations": {
                                "en": "Finding a good <w>side hustle</w> these days can be difficult."
                            }
                        }
                    ],
                    "synonyms": [
                        "подработка",
                        "приработок",
                        "шабашка"
                    ],
                    "common_phrases": [
