                        "sense_id": "8a9c1f7c-f0db-32a8-90bf-1e9a1d432501",
                        "entry_id": "c5f7d32b-a4c8-3845-bb1c-f229ab4d672c",
                        "glosses": [
                            "Personne qui alphabétise, qui enseigne la lecture et l’écriture."
                        ],
                        "tags": [
                            "Burkina Faso"
                        ],
                        "examples": [
                            {
                                "example_id": "c382fc0e-1905-4734-8f35-a7351112518b",
                                "sense_id": "8a9c1f7c-f0db-32a8-90bf-1e9a1d432501",
                                "text": "La maçonnerie construction, la menuiserie bois, la construction métallique, la mécanique des deux roues, la coupe et la couture et le métier d’alphabétiseur y seront enseignés."
                            },
                            {
                                "example_id": "11130f2f-9e2e-4844-92fa-e5704181b3af",
                                "sense_id": "8a9c1f7c-f0db-32a8-90bf-1e9a1d432501",
                                "text": "Peut-être que Flavie étrangement se reposait des fatigues de sa besogne d’alphabétiseuse […]."
                            },
                            {
                                "example_id": "d3f672ea-95b8-47ed-8b99-43cd723e7efc",
                                "sense_id": "8a9c1f7c-f0db-32a8-90bf-1e9a1d432501",
                                "text": "Le groupe dans le village doit s’engager à loger et nourrir l’alphabétiseur si le village est trop loin de son lieu d’habitation."
                            },
                            {
                                "example_id": "973bff35-0e0f-411c-97d7-f05aba8258f5",
                                "sense_id": "8a9c1f7c-f0db-32a8-90bf-1e9a1d432501",
                                "text": "L’alphabétiseur scolarisant est généralement un professeur qui a d’abord été formé pour l’enseignement primaire et secondaire."
                            }
                        ]
                    }
