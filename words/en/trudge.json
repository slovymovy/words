{
    "word_family": [
        "trudger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d1e1e86-15e8-3cc7-b33a-1ac7e4bebbe5",
                    "sense_definition": "To walk wearily with heavy, slow steps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "walking-wearily",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long day of working in the fields, the farmers had to <w>trudge</w> back to their homes.",
                            "target_lang_translations": {
                                "cs": "Po dlouhém dni práce na poli se farmáři museli <w>plahočit</w> zpět domů."
                            }
                        },
                        {
                            "text": "We had to <w>trudge</w> through deep snow for miles before reaching the cabin.",
                            "target_lang_translations": {
                                "cs": "Museli jsme se míle <w>plahočit</w> hlubokým sněhem, než jsme dorazili k chatě."
                            }
                        }
                    ],
                    "synonyms": [
                        "plod",
                        "slog",
                        "tramp"
                    ],
                    "antonyms": [
                        "skip",
                        "sprint"
                    ],
                    "common_phrases": [
                        "trudge through deep snow",
                        "trudge back home"
                    ],
                    "target_lang_definitions": {
                        "cs": "Jít unaveně těžkými, pomalými kroky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "plahočit se",
                                "target_lang_sense_clarification": "vyjadřuje namáhavou a únavnou chůzi"
                            },
                            {
                                "target_lang_word": "vléci se",
                                "target_lang_sense_clarification": "vyjadřuje pomalý a těžkopádný pohyb"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2fc6abb-3167-3ecc-b58c-cc843366edf0",
                    "sense_definition": "To walk along or over a route in a heavy, laborious manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "walking-wearily",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers continued to <w>trudge</w> the long road despite their extreme exhaustion.",
                            "target_lang_translations": {
                                "cs": "Vojáci se i přes své naprosté vyčerpání dál <w>plahočili</w> dlouhou cestou."
                            }
                        },
                        {
                            "text": "They had to <w>trudge</w> the muddy path to get to the remote village.",
                            "target_lang_translations": {
                                "cs": "Museli se <w>plahočit</w> blátivou cestou, aby se dostali do odlehlé vesnice."
                            }
                        }
                    ],
                    "synonyms": [
                        "traverse",
                        "tramp"
                    ],
                    "common_phrases": [
                        "trudge the long road",
                        "trudge the muddy path"
                    ],
                    "target_lang_definitions": {
                        "cs": "Jít po cestě nebo přes území těžkým, namáhavým způsobem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "plahočit se",
                                "target_lang_sense_clarification": "překonávání cesty s velkým úsilím"
                            },
                            {
                                "target_lang_word": "brodit se",
                                "target_lang_sense_clarification": "použitelné zejména v kontextu náročného terénu, jako je bláto nebo sníh"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79bc6363-374a-3eff-b7e3-dbd9f6f4f9a7",
                    "sense_definition": "A long, tiring, and laborious walk.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning after the landslip, it was an unpleasant <w>trudge</w> through deep mud to get there.",
                            "target_lang_translations": {
                                "cs": "Ráno po sesuvu půdy to byla nepříjemná <w>namáhavá cesta</w> hlubokým blátem, než jsme se tam dostali."
                            }
                        },
                        {
                            "text": "After our car broke down, we faced a long <w>trudge</w> back to the nearest town.",
                            "target_lang_translations": {
                                "cs": "Poté, co se nám rozbilo auto, nás čekala dlouhá <w>úmorná chůze</w> zpět do nejbližšího města."
                            }
                        }
                    ],
                    "synonyms": [
                        "slog",
                        "tramp",
                        "hike"
                    ],
                    "common_phrases": [
                        "long trudge",
                        "unpleasant trudge"
                    ],
                    "target_lang_definitions": {
                        "cs": "Dlouhá, únavná a namáhavá chůze."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "namáhavá cesta",
                                "target_lang_sense_clarification": "popisuje fyzicky vyčerpávající přesun"
                            },
                            {
                                "target_lang_word": "úmorná chůze",
                                "target_lang_sense_clarification": "zdůrazňuje únavu a nepříjemnost takového přesunu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}