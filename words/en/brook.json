        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "146d579c-6ae2-3ef8-83b3-8625411c8a02",
                    "sense_definition": "A body of running water smaller than a river; a small stream.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "water_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat by the shallow <w>brook</w> and watched the water flow over the stones.",
                            "target_lang_translations": {
                                "ru": "Мы сидели у мелкого <w>ручья</w> и смотрели, как вода течет по камням.",
                                "pl": "Siedzieliśmy nad płytkim <w>strumykiem</w> i patrzyliśmy, jak woda przepływa po kamieniach."
                            }
                        },
                        {
                            "text": "A small <w>brook</w> runs through the meadow behind their house.",
                            "target_lang_translations": {
                                "ru": "Маленький <w>ручей</w> протекает через луг за их домом.",
                                "pl": "Mały <w>strumyk</w> płynie przez łąkę za ich domem."
                            }
                        }
                    ],
                    "synonyms": [
                        "stream",
                        "creek"
                    ],
                    "common_phrases": [
                        "babbling brook",
                        "meadow brook"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой естественный водный поток, меньше реки.",
                        "pl": "Niewielki naturalny ciek wodny, mniejszy niż rzeka; mały strumyk."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ручей",
