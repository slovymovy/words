{
    "word_family": [
        "помощь",
        "помогать",
        "помощник",
        "беспомощность",
        "беспомощно"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4f534a03-31f9-395d-ae42-3b46e547c0d2",
                    "sense_definition": "неспособный самостоятельно защитить себя или действовать без посторонней помощи",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "состояние человека",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Маленький ребёнок кажется совершенно <w>беспомощным</w> без своих родителей.",
                            "target_lang_translations": {
                                "en": "A small child seems completely <w>helpless</w> without their parents."
                            }
                        },
                        {
                            "text": "Старик чувствовал себя <w>беспомощным</w> перед лицом болезни.",
                            "target_lang_translations": {
                                "en": "The old man felt <w>helpless</w> in the face of the illness."
                            }
                        }
                    ],
                    "synonyms": [
                        "бессильный",
                        "беззащитный",
                        "слабый"
                    ],
                    "antonyms": [
                        "самостоятельный",
                        "сильный"
                    ],
                    "common_phrases": [
                        "совершенно беспомощный",
                        "беспомощный ребёнок"
                    ],
                    "target_lang_definitions": {
                        "en": "unable to defend oneself or act independently without outside assistance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "helpless",
                                "target_lang_sense_clarification": "unable to manage without help"
                            },
                            {
                                "target_lang_word": "defenseless",
                                "target_lang_sense_clarification": "unable to protect oneself"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8b8f70f-2040-30c1-b8d9-4e8fb0495266",
                    "sense_definition": "выражающий бессилие или свидетельствующий о невозможности что-либо предпринять",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "выражение чувств",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он бросил на меня <w>беспомощный</w> взгляд, когда не смог ответить на вопрос.",
                            "target_lang_translations": {
                                "en": "He gave me a <w>helpless</w> look when he couldn't answer the question."
                            }
                        },
                        {
                            "text": "Её <w>беспомощный</w> жест показал, что она больше ничего не может сделать.",
                            "target_lang_translations": {
                                "en": "Her <w>helpless</w> gesture showed that she could do nothing more."
                            }
                        }
                    ],
                    "synonyms": [
                        "растерянный"
                    ],
                    "antonyms": [
                        "уверенный"
                    ],
                    "common_phrases": [
                        "беспомощный взгляд",
                        "беспомощный жест"
                    ],
                    "target_lang_definitions": {
                        "en": "expressing powerlessness or indicating an inability to take any action"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "helpless",
                                "target_lang_sense_clarification": "showing a lack of control or power"
                            },
                            {
                                "target_lang_word": "powerless",
                                "target_lang_sense_clarification": "lacking the ability to act"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbb620bb-779a-3622-901a-7a9370276ab5",
                    "sense_definition": "выполненный на низком профессиональном уровне, свидетельствующий об отсутствии мастерства",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "качество работы",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Критики назвали этот сценарий <w>беспомощным</w> и скучным.",
                            "target_lang_translations": {
                                "en": "Critics called this script <w>weak</w> and boring."
                            }
                        },
                        {
                            "text": "Эта <w>беспомощная</w> попытка написать стихи вызвала лишь улыбку у редактора.",
                            "target_lang_translations": {
                                "en": "This <w>clumsy</w> attempt at writing poetry only brought a smile to the editor's face."
                            }
                        }
                    ],
                    "synonyms": [
                        "неумелый",
                        "слабый",
                        "дилетантский"
                    ],
                    "antonyms": [
                        "мастерский",
                        "профессиональный"
                    ],
                    "common_phrases": [
                        "беспомощная попытка",
                        "беспомощный текст"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "переносное значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "executed at a low professional level, showing a lack of skill or mastery"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clumsy",
                                "target_lang_sense_clarification": "awkwardly or poorly executed"
                            },
                            {
                                "target_lang_word": "amateurish",
                                "target_lang_sense_clarification": "lacking professional skill"
                            },
                            {
                                "target_lang_word": "weak",
                                "target_lang_sense_clarification": "lacking quality or impact"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}