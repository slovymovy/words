                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5f80791f-7775-47fd-b47f-3b1234f7b8ed",
                                "sense_id": "56cf8a7a-f608-3ca1-bbb6-d7631873ea3d",
                                "text": "I’ve overshared about my mother in print. Let me briefly reshare. It’s complicated."
                            },
                            {
                                "example_id": "d6c6418f-9667-4955-90c6-7b611a534749",
                                "sense_id": "56cf8a7a-f608-3ca1-bbb6-d7631873ea3d",
                                "text": "One participant, Kalae Nouveau, suffered more than others: her original and subsequent posts were deleted, resharing her posts was banned, and her account was shadow-banned, meaning its visibility was restricted."
                            },
                            {
                                "example_id": "5ae9aa47-af19-4e18-b1fd-33a352c1bf83",
                                "sense_id": "56cf8a7a-f608-3ca1-bbb6-d7631873ea3d",
                                "text": "The emphasis on boosting “meaningful social interactions” between friends and family meant that the feed leant towards reshared material, which was often misinformed and toxic. “Misinformation, toxicity and violent content are inordinately prevalent among reshares,” said internal research."
                            },
                            {
                                "example_id": "de2b9d7c-d712-4e13-8bb2-e7bf4e497a5e",
                                "sense_id": "56cf8a7a-f608-3ca1-bbb6-d7631873ea3d",
                                "text": "The Multicultural voices: No Voice account also reshares content from Fair Australia and other accounts with which Daoud says there is a “common understanding”."
                            }
                        ]
                    }
