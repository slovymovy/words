                        "tags": [],
                        "examples": [
                            {
                                "example_id": "006d3da4-7c10-4437-8433-c4c5ae28345a",
                                "sense_id": "15ca3549-deb0-3b1f-a2d3-b63418e875a8",
                                "text": "On distingue ainsi, selon la composition : une texture sableuse, sablo-limoneuse ou limono-sableuse, limoneuse, limono-argileuse ou argilo-limoneuse et argileuse."
                            },
                            {
                                "example_id": "7d1d31d4-327e-4103-949a-151f6f2fc5a1",
                                "sense_id": "15ca3549-deb0-3b1f-a2d3-b63418e875a8",
                                "text": "Au sud-est, par contre, les sols sablo-limoneux secs se prêtent moins aux cultures."
                            },
                            {
                                "example_id": "51336f29-aca4-4c82-95b6-df4cf37e298e",
                                "sense_id": "15ca3549-deb0-3b1f-a2d3-b63418e875a8",
                                "text": "La coupe nord montre une succession de couches sablo-limoneuses (Ha-02 à Ha-06) dont la matrice sableuse est de couleur grise, directement sous le mur AE²."
                            }
