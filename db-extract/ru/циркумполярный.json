                                    {
                                        "sense_id": "3ffb3e19-35fe-30f9-aeaf-e8b7d9a715f4",
                                        "entry_id": "e0f65bf1-6fa4-3306-8cf6-06cd40ff39b2",
                                        "glosses": [
                                            "Se dit d’un objet céleste dont le cercle diurne reste toujours au-dessus de l’horizon à une latitude donnée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "253c3e93-87bc-4f5c-857f-0fa508d508d4",
                                                "sense_id": "3ffb3e19-35fe-30f9-aeaf-e8b7d9a715f4",
                                                "text": "La Grande Ourse est une constellation circumpolaire pour un observateur situé en France."
                                            },
                                            {
                                                "example_id": "d7e026fb-54fc-436b-a089-a03deef993f6",
                                                "sense_id": "3ffb3e19-35fe-30f9-aeaf-e8b7d9a715f4",
                                                "text": "De façon générale, on qualifie une étoile de circumpolaire lorsque sa distance à un pôle est inférieure à 10°."
                                            },
                                            {
                                                "example_id": "3e132ad6-0ae8-4bb8-b95b-f1b8fa287b3c",
                                                "sense_id": "3ffb3e19-35fe-30f9-aeaf-e8b7d9a715f4",
                                                "text": "Ces êtres bougent dans le temps, inversant leurs positions comme les étoiles circumpolaires au cours de la nuit."
                                            }
                                        ]
                                    }
