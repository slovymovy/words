                                            {
                                                "example_id": "fccf292b-d4b8-43ac-a0ef-517b06e00b34",
                                                "sense_id": "1a2a619c-ef3c-37f1-96bd-0d342a3ce75d",
                                                "text": "For I am come to ſet a man at variance* againſt his father, ⁊ the daughter againſt her mother, and the daughter in law againſt her mother in law."
                                            },
                                            {
                                                "example_id": "f6617891-7781-440e-ac00-f29e5d3d68b1",
                                                "sense_id": "1a2a619c-ef3c-37f1-96bd-0d342a3ce75d",
                                                "text": "Odontophobia, or the fear of dental work, seems equally plausible, as does pentheraphobia - fear of the mother-in-law."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea5aceda-8eee-38b7-a7a0-5a2c21846eb0",
