                        "sense_id": "497223ef-30c3-3ef2-8a3c-b0004ea552e3",
                        "entry_id": "e8866700-f3d4-315f-aa6d-a9ee9df4ed3e",
                        "glosses": [
                            "Aggressively assertive; pushy."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "6cc9871e-b8b7-4ca3-b285-e489d34de69b",
                                "sense_id": "497223ef-30c3-3ef2-8a3c-b0004ea552e3",
                                "text": "Mrs. Erlynne, a pushing nobody, with a delightful lisp and Venetian-red hair[…]"
                            }
                        ]
                    }
