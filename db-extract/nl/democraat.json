                    {
                        "sense_id": "44c1ece7-0659-33dd-a1a3-17327f3d5df9",
                        "entry_id": "e4acdd18-23a0-3718-89db-d32b0467b3ad",
                        "glosses": [
                            "aanhanger van de democratie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4910d1db-5fff-4a93-acd0-290eaa1aa102",
                                "sense_id": "44c1ece7-0659-33dd-a1a3-17327f3d5df9",
                                "text": "Controle over het publieke debat is essentieel voor de illiberale democraat. Russen die een te grote mond opzetten krijgen eerst met de oproerpolitie en daarna met de rechter te maken. In veel gevallen – denk aan Pussy Riot of ex-oliemagnaat Chodorkovski – stuurt die je naar het strafkamp. Kremlingezinde media helpen intussen bij het creëren van vijanden, zoals de homogemeenschap, of complottheorieën, zoals over de Oekraïense betrokkenheid bij MH17."
                            }
                        ]
                    },
                    {
                        "sense_id": "5824d516-59df-3def-846e-fc0c1ae30b19",
                        "entry_id": "e4acdd18-23a0-3718-89db-d32b0467b3ad",
                        "glosses": [
                            "lid van de Democratische Partij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eeae3272-035d-4c30-8b96-5202e3c1d7fc",
                                "sense_id": "5824d516-59df-3def-846e-fc0c1ae30b19",
                                "text": "Democraat Chafee is niet langer presidentskandidaat VS"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16ee280d-218b-4145-b199-0dea3d4b2b63",
                        "source_entry_id": "e4acdd18-23a0-3718-89db-d32b0467b3ad",
                        "target_lang_word": "democrat",
