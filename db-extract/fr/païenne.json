                        "entry_id": "3f9b358d-e5f0-357c-9270-462ef9992181",
                        "glosses": [
                            "Personne ne pratiquant pas la religion juive ou chrétienne."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
