                                "target_lang_sense_clarification": "a strong metaphorical craving"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "жажда",
                                "target_lang_sense_clarification": "сильное переносное желание"
                            },
                            {
                                "target_lang_word": "тяга",
                                "target_lang_sense_clarification": "сильное стремление к чему-либо"
                            }
                        ]
                    }
                }
            ]
