        "fr-extract.jsonl": [
            {
                "entry_id": "0dc24027-2b3d-3fe2-9705-d776c9dba06a",
                "word": "comtesse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "42f5871c-28c5-40cd-82b6-787e17617808",
                        "entry_id": "0dc24027-2b3d-3fe2-9705-d776c9dba06a",
                        "tags": [
                            "plural"
                        ],
                        "form": "comtesses"
                    },
                    {
                        "form_id": "d2ea8a2e-7ea8-4805-8f79-400d272b6305",
                        "entry_id": "0dc24027-2b3d-3fe2-9705-d776c9dba06a",
                        "tags": [
                            "masculine"
                        ],
                        "form": "comte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1bb47d85-eb44-383d-90a2-e250c61f408d",
                        "entry_id": "0dc24027-2b3d-3fe2-9705-d776c9dba06a",
                        "glosses": [
                            "Épouse ou veuve d’un comte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b33b670-7436-48ec-ac57-a42ba6cb59c4",
                                "sense_id": "1bb47d85-eb44-383d-90a2-e250c61f408d",
                                "text": "Quoique la comtesse aspirât à régner sur Paris et qu’elle essayât de marcher de pair avec mesdames les duchesses de Maufrigneuse, de Chaulieu, les marquises d’Espard et d’Aiglemont, les comtesses Féraud, de Montcornet, de Restaud, madame de Camps et mademoiselle Des Touches, elle ne céda point à l’amour du jeune vicomte de Portenduère qui fit d’elle son idole."
                            },
                            {
                                "example_id": "99e0f27a-f19a-4af5-9265-3f1209848783",
                                "sense_id": "1bb47d85-eb44-383d-90a2-e250c61f408d",
                                "text": "Je connais des époux assortis :\nQuand « Monsieur » court le guilledou\n« Madame » court la prétantaine\nEt Madame gagne toujours d’une longueur.\nVoilà, comtesse, des steeples-chases autrement divertissants, avouez-le, que ceux de la Marche ou de Vincennes."
                            }
                        ]
                    },
                    {
                        "sense_id": "9853ac2a-47ed-36f4-851b-dbf9acb32ec1",
                        "entry_id": "0dc24027-2b3d-3fe2-9705-d776c9dba06a",
                        "glosses": [
                            "Femme détenant un comté"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e5b8355-73ae-4eaf-a17a-d88d743faf2e",
                                "sense_id": "9853ac2a-47ed-36f4-851b-dbf9acb32ec1",
                                "text": "En 1214, il fit hommage du sénéchalat de Champagne à la comtesse Blanche et à son fils Thibaut, mineur, qu'il jura de défendre, comme étant son homme lige, contre les fils du comte Henri et contre toute créature morte ou vivante."
                            },
                            {
                                "example_id": "dee16d78-e5d7-4a46-a7a3-d61669c59d02",
                                "sense_id": "9853ac2a-47ed-36f4-851b-dbf9acb32ec1",
                                "text": "L’abbaye, dit-on, doit son origine à une comtesse Cuniga, une sorte de Barbe-Bleue en jupons, qui avait empoisonné ses sept maris et terrifiait toute la contrée par ses crimes."
                            },
                            {
                                "example_id": "ed88c11a-de82-4066-b99f-c36c82fe0ca0",
                                "sense_id": "9853ac2a-47ed-36f4-851b-dbf9acb32ec1",
                                "text": "[…], la comtesse fit incarcérer le meurtrier et, après jugement, celui-ci fut pendu. L’exécution eut lieu le jour de Pourim."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab878931-5da2-4dae-8818-fcbc50b3e0b6",
                        "source_entry_id": "0dc24027-2b3d-3fe2-9705-d776c9dba06a",
                        "source_sense_id": "1bb47d85-eb44-383d-90a2-e250c61f408d",
                        "source_sense_description": "Épouse d’un comte",
                        "target_lang_word": "Gräfin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gräfin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5050b3b-a4db-37a7-a4ec-04952b141d6e",
                                        "entry_id": "c6b423b3-46ad-3305-b42e-463b8b66caa3",
                                        "glosses": [
                                            "die Ehefrau eines Grafen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "036a7b8c-c0b6-4022-91f4-b6a44f2503a6",
                                                "sense_id": "b5050b3b-a4db-37a7-a4ec-04952b141d6e",
                                                "text": "Gräfin von Falckenburg hat sich zum Tee angekündigt."
                                            },
                                            {
                                                "example_id": "1a98ddb8-41e2-4383-896a-205afa56b8a4",
                                                "sense_id": "b5050b3b-a4db-37a7-a4ec-04952b141d6e",
                                                "text": "„Aber die Gräfin Thor von Thorfels könnte vielleicht ein Wörtchen dazu sagen?“"
                                            },
                                            {
                                                "example_id": "8663292e-b56a-4af6-a9e3-d7133c482be2",
                                                "sense_id": "b5050b3b-a4db-37a7-a4ec-04952b141d6e",
                                                "text": "„Die Gräfin, ein uneheliches Kind, war Tänzerin im Königlichen Ballett gewesen, getauft auf den Namen Louise Rasmussen.“"
                                            },
                                            {
                                                "example_id": "11c1b168-1297-4efd-9188-00917b9e525c",
                                                "sense_id": "b5050b3b-a4db-37a7-a4ec-04952b141d6e",
                                                "text": "„Und irgendwo unter den Großen sitzt auch die Gräfin.“"
                                            },
                                            {
                                                "example_id": "60d0da6a-77c5-4c53-93ae-ebf5426a84c4",
                                                "sense_id": "b5050b3b-a4db-37a7-a4ec-04952b141d6e",
                                                "text": "„Die Gräfin gab ihren Leuten Anweisung, was sie auf ihre Fluchtwagen laden sollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
