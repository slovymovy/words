                ],
                "senses": [
                    {
                        "sense_id": "a114e9db-d70e-3cc7-9499-a5689cf67a9d",
                        "entry_id": "51a3fb00-ca4a-383a-8184-716db81ce28d",
                        "glosses": [
                            "in de aarde ingegraven, beneden het aardoppervlak, onderaards"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "863d9038-176c-4a3d-a325-3bbd6e880e6e",
                                "sense_id": "a114e9db-d70e-3cc7-9499-a5689cf67a9d",
                                "text": "Zij vonden een ondergrondse ruimte onder de eeuwenoude ruïne."
                            },
                            {
                                "example_id": "805be64e-af66-4b79-8ad6-03dc159af88e",
                                "sense_id": "a114e9db-d70e-3cc7-9499-a5689cf67a9d",
                                "text": "De nieuwe versneller gaat zo’n 24 miljard euro kosten, schrijven de fysici in hun ontwerpstudie. Negen miljard daarvan gaat naar de eerste ontwikkeling van de versneller en de aanleg van een nieuwe ondergrondse tunnel. Een geplande update waarmee later ook andere deeltjes op elkaar geschoten kunnen worden, kost nog eens 15 miljard."
                            },
                            {
                                "example_id": "72205960-a7ab-4b23-9f11-e020b8b814c8",
                                "sense_id": "a114e9db-d70e-3cc7-9499-a5689cf67a9d",
                                "text": "Au! Door een felle steek stond ik ineens weer met beide voeten op de grond, ik had kennelijk op een ondergronds wespennest getrapt."
                            },
                            {
                                "example_id": "b449f23f-8cf2-4fd0-a790-f50103228ca4",
                                "sense_id": "a114e9db-d70e-3cc7-9499-a5689cf67a9d",
                                "text": "In 2018 ontdekte een door het Europees ruimteagentschap (ESA) aangestuurde sonde water onder het ijs van de zuidpool van de planeet. Het lokaliseren van ondergronds water vormt de sleutel bij het bepalen van de mogelijkheden tot leven op Mars, evenals bij het vaststellen of het een permanente bron voor een verkenning door mensen kan vormen."
                            }
                        ]
                    },
                    {
                        "sense_id": "191a12d9-bf39-3772-860c-c304cd76fcc4",
                        "entry_id": "51a3fb00-ca4a-383a-8184-716db81ce28d",
                        "glosses": [
                            "illegaal, onzichtbaar, verborgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26fd5e29-13c9-438b-9e69-fa8f9a321fba",
                                "sense_id": "191a12d9-bf39-3772-860c-c304cd76fcc4",
                                "text": "OM neemt 20 miljoen euro af van ondergrondse bankiers"
                            },
                            {
                                "example_id": "444951bc-b655-4b39-91e9-98910c3c444d",
                                "sense_id": "191a12d9-bf39-3772-860c-c304cd76fcc4",
                                "text": "Ze zouden zonder twijfel in staat zijn om een ondergrondse organisatie op te bouwen met goed functionerende veiligheidsroutines."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99792777-f674-4003-b41d-6279a52f1e11",
                        "source_entry_id": "51a3fb00-ca4a-383a-8184-716db81ce28d",
