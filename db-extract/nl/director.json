                        "sense_id": "fccc2ecd-7f58-322b-9d1e-6d78768d82cd",
                        "entry_id": "4d986ddc-4383-3fbe-bb58-7e02748838e9",
                        "glosses": [
                            "een passief onderdeel van een yagi-antenne dat de antenne een richtwerking geeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a36c9cd1-a201-417e-bd26-0060f9de8db1",
                                "sense_id": "fccc2ecd-7f58-322b-9d1e-6d78768d82cd",
                                "text": "Een yagi-antenne heeft naast de actieve dipool, nog twee soorten passieve elementen: de reflector en de director (meestal meerdere in cascade)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fead747-7a79-474e-a98e-1a5f84d1101a",
                        "source_entry_id": "4d986ddc-4383-3fbe-bb58-7e02748838e9",
                        "source_sense_id": "fccc2ecd-7f58-322b-9d1e-6d78768d82cd",
                        "source_sense_description": "passief onderdeel van een yagi-antenne",
                        "target_lang_word": "Direktor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Direktor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "632b74f5-6660-3e6f-85fe-c20efb30b7b4",
                                        "entry_id": "06ab5e0d-e770-3ec7-a7fe-1ee1c9af5baa",
                                        "glosses": [
                                            "Leiter einer öffentlichen Institution (Hochschule, Schule, Behörde…)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7a3de21-d655-4353-9b41-58562c01dced",
                                                "sense_id": "632b74f5-6660-3e6f-85fe-c20efb30b7b4",
                                                "text": "Viele öffentliche Einrichtungen werden von einem Direktor geleitet, so zum Beispiel ein Zoo durch den Zoodirektor."
                                            },
                                            {
                                                "example_id": "0f18af50-8beb-4b02-b94d-abfccec9e3ed",
                                                "sense_id": "632b74f5-6660-3e6f-85fe-c20efb30b7b4",
                                                "text": "„Der Direktor lehnte an der Wand gegenüber und dachte intensiv an seine Pensionierung und an seine Angelhütte am Templiner See.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f8892087-17c1-3dce-b326-886b1c6c592b",
                                        "entry_id": "06ab5e0d-e770-3ec7-a7fe-1ee1c9af5baa",
                                        "glosses": [
                                            "Leiter eines Betriebes, eines Betriebsteils, einer oder mehrerer Abteilungen oder Zuständigkeitsbereiche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3804bd8c-ab0b-4c12-8885-a563f1f258cf",
                                                "sense_id": "f8892087-17c1-3dce-b326-886b1c6c592b",
                                                "text": "In einem großen Betrieb gibt es Direktoren für verschiedene Betriebszweige."
                                            },
                                            {
                                                "example_id": "897ce51e-e7bd-40c8-8ab8-4dc2d3874ab8",
                                                "sense_id": "f8892087-17c1-3dce-b326-886b1c6c592b",
                                                "text": "Mehrere Direktoren können ein Direktorium bilden."
                                            },
                                            {
                                                "example_id": "1216e66a-d288-4e9c-b744-5db2a3e05aef",
                                                "sense_id": "f8892087-17c1-3dce-b326-886b1c6c592b",
                                                "text": "Dem Vorstand sind die Bereichsleiter, Direktoren und Abteilungsdirektoren unmittelbar unterstellt. Sie bilden die Spitze der Hierarchie eines Unternehmens."
                                            },
                                            {
                                                "example_id": "8e86decb-11b3-479b-aa3d-a7bae2f169b3",
                                                "sense_id": "f8892087-17c1-3dce-b326-886b1c6c592b",
                                                "text": "„Der Direktor glaubt das nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6aa1f577-71f2-48d4-8b6c-6aaa54776070",
                        "source_entry_id": "4d986ddc-4383-3fbe-bb58-7e02748838e9",
