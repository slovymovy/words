                ],
                "translations": [
                    {
                        "translation_id": "6a11e579-5751-4bee-8463-3a00be2a8c3d",
                        "source_entry_id": "88781d40-9990-380b-93c6-077882231ba2",
                        "source_sense_id": "01a358c3-954d-3da7-8298-80293d28876e",
                        "target_lang_word": "sycophant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sycophant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67152c02-d7d5-3a1a-ad71-9d7470a04c2c",
                                        "entry_id": "4ea2a22e-5ab4-3ff0-8739-9265d085b390",
                                        "glosses": [
                                            "One who uses obsequious compliments to gain self-serving favour or advantage from another; a servile flatterer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f525c996-305a-4757-96aa-e3bb251b0bc4",
                                                "sense_id": "67152c02-d7d5-3a1a-ad71-9d7470a04c2c",
                                                "text": "A sycophant will everything admire: / Each verse, each sentence, sets his soul on fire"
                                            },
                                            {
                                                "example_id": "b01c4077-ca44-40f1-8dbe-2f6d2a1bebcd",
                                                "sense_id": "67152c02-d7d5-3a1a-ad71-9d7470a04c2c",
                                                "text": "VVhile a mean Crovvd of Sycophants attend, / And favvn and flatter, creep and cringe and bend; / The Fav'rite bleſſes his ſuperior State, / Riſes o'er all, and hails Himſelf the Great."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e10d5819-4588-3279-adfb-8870e50bee91",
                                        "entry_id": "4ea2a22e-5ab4-3ff0-8739-9265d085b390",
                                        "glosses": [
                                            "One who seeks to gain through the powerful and influential."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ef390e3-92cd-3b79-b84a-a1862e167e32",
                                        "entry_id": "4ea2a22e-5ab4-3ff0-8739-9265d085b390",
                                        "glosses": [
                                            "An informer; a talebearer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bcc55c3-1911-417d-a41a-cb8bbc7a37fa",
                                                "sense_id": "7ef390e3-92cd-3b79-b84a-a1862e167e32",
                                                "text": "[H]is mind had no eye to espy goodness; and therefore accusing sycophants, of all men, did best sort to his nature.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sycophant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90a02387-0ba7-3c7e-b763-ed5d3fbe6928",
                                        "entry_id": "ea1f3569-1144-3cdf-9c3e-7d5e917dee26",
                                        "glosses": [
                                            "To inform against; hence, to calumniate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e62fc6e6-b17a-4330-a1e2-fba335af3a04",
                                                "sense_id": "90a02387-0ba7-3c7e-b763-ed5d3fbe6928",
                                                "text": "As therefore he began in the title, so in the next leaf he makes it his first business to tamper with his reader by sycophanting and misnaming the work of his adversary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abfb8419-5bda-3708-b79a-90ead1b0f720",
                                        "entry_id": "ea1f3569-1144-3cdf-9c3e-7d5e917dee26",
                                        "glosses": [
                                            "To play the sycophant toward; to flatter obsequiously."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99413d60-3139-439e-92ae-cf483206826c",
                        "source_entry_id": "88781d40-9990-380b-93c6-077882231ba2",
                        "source_sense_id": "01a358c3-954d-3da7-8298-80293d28876e",
                        "target_lang_word": "Speichellecker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Speichellecker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5933fcf-f544-3b14-bcfd-4adcf59e6d1f",
                                        "entry_id": "62620fcf-9304-3fa4-951a-3c768556ba06",
                                        "glosses": [
                                            "Person, die versucht, sich bei anderen durch übertriebene Schmeicheleien gutzustellen"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90ef02bc-062c-41f0-b445-a7bfab33a541",
                                                "sense_id": "f5933fcf-f544-3b14-bcfd-4adcf59e6d1f",
                                                "text": "„Wo einer große Töne spuckt, sind immer Speichellecker zu finden.“"
                                            },
                                            {
                                                "example_id": "ef0e4b25-d816-4127-a430-a0724de2bab6",
                                                "sense_id": "f5933fcf-f544-3b14-bcfd-4adcf59e6d1f",
                                                "text": "„Ein anderer Speichellecker berichtete, er sei immer heiter gewesen und keineswegs stolz seinen Kameraden gegenüber; außerdem habe er wie ein Engel gesungen.“"
                                            },
                                            {
                                                "example_id": "f476c2bb-4e3d-42e6-9efe-6e5384c5865f",
                                                "sense_id": "f5933fcf-f544-3b14-bcfd-4adcf59e6d1f",
                                                "text": "„Arthur Bauer wird gerade von dem Speichellecker Matthias Grund umkrochen, der hofft, Arthur werde sein »Buch vom Tode in sieben Abteilungen« verlegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
