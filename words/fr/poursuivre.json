{
    "word_family": [
        "poursuite",
        "poursuivant",
        "suivre"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "45217cf8-a16a-3885-9877-76959990ecb8",
                    "sense_definition": "Continuer une action, une tâche ou une activité que l'on a commencée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "continuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré la fatigue et la pluie, les randonneurs <w>poursuivent</w> leur chemin vers le refuge."
                        },
                        {
                            "text": "Après l'obtention de son diplôme, elle souhaite <w>poursuivre</w> ses études à l'étranger."
                        }
                    ],
                    "synonyms": [
                        "continuer",
                        "prolonger",
                        "maintenir"
                    ],
                    "antonyms": [
                        "abandonner",
                        "interrompre",
                        "cesser"
                    ],
                    "common_phrases": [
                        "poursuivre ses études",
                        "poursuivre son chemin",
                        "poursuivre sa route"
                    ]
                },
                {
                    "sense_id": "b3e29c60-f648-378a-accc-ddfaa699edb1",
                    "sense_definition": "Courir après une personne ou un animal dans l'intention de l'atteindre ou de l'attraper.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "chasse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chien de garde <w>poursuit</w> le voleur à travers tout le jardin sans s'arrêter."
                        },
                        {
                            "text": "Deux agents de police en patrouille ont <w>poursuivi</w> le suspect sur plusieurs kilomètres."
                        }
                    ],
                    "synonyms": [
                        "chasser",
                        "pourchasser",
                        "traquer"
                    ],
                    "antonyms": [
                        "fuir"
                    ],
                    "common_phrases": [
                        "poursuivre un voleur",
                        "poursuivre une proie"
                    ]
                },
                {
                    "sense_id": "fff513c7-19a1-3946-9d47-7a94a7f6c9c9",
                    "sense_definition": "S'efforcer avec ardeur d'obtenir ou d'accomplir un but, un objectif.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "objectif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis son plus jeune âge, ce chercheur <w>poursuit</w> un but très précis dans son laboratoire."
                        },
                        {
                            "text": "L'entreprise <w>poursuit</w> l'objectif de réduire son empreinte carbone d'ici la fin de l'année."
                        }
                    ],
                    "synonyms": [
                        "viser",
                        "briguer",
                        "rechercher"
                    ],
                    "antonyms": [
                        "renoncer",
                        "abandonner"
                    ],
                    "common_phrases": [
                        "poursuivre un but",
                        "poursuivre un objectif",
                        "poursuivre un idéal"
                    ]
                },
                {
                    "sense_id": "eab69a25-8647-34b1-8354-921331d11d3f",
                    "sense_definition": "Engager une action ou une procédure judiciaire contre une personne en justice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La société a décidé de <w>poursuivre</w> son concurrent en justice pour contrefaçon de produit."
                        },
                        {
                            "text": "La victime d'escroquerie a engagé un avocat afin de <w>poursuivre</w> les coupables au tribunal."
                        }
                    ],
                    "synonyms": [
                        "attaquer",
                        "assigner"
                    ],
                    "common_phrases": [
                        "poursuivre en justice",
                        "poursuivre en diffamation"
                    ]
                },
                {
                    "sense_id": "f8251566-df8e-3322-acad-0443d265928e",
                    "sense_definition": "Tourmenter, obséder ou hanter l'esprit d'une personne de manière continue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tourment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le remords de cette grave erreur le <w>poursuit</w> constamment depuis de nombreuses années."
                        },
                        {
                            "text": "Ce souvenir tragique la <w>poursuivait</w> sans relâche, gâchant chacun de ses moments de calme."
                        }
                    ],
                    "synonyms": [
                        "obséder",
                        "tourmenter",
                        "harceler"
                    ],
                    "antonyms": [
                        "apaiser"
                    ],
                    "common_phrases": [
                        "poursuivre sans relâche"
                    ]
                }
            ]
        }
    ]
}