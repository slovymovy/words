        "nl-extract.jsonl": [
            {
                "entry_id": "d3e28061-6430-3d89-abdd-6f6f45fc7333",
                "word": "uitmunten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "63bf12a8-bed3-34de-8ca9-014e7a5d91f3",
                        "entry_id": "d3e28061-6430-3d89-abdd-6f6f45fc7333",
                        "glosses": [
                            "veel beter presteren dan anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4362740-d1a9-46a5-b00d-2f06848ed4e8",
                                "sense_id": "63bf12a8-bed3-34de-8ca9-014e7a5d91f3",
                                "text": "Het Vaticaan denkt niet in jaren maar in eeuwen, zeggen ze. Uitmunten in het aanvoelen van de tijdgeest doet het daarom niet. Modes komen en gaan. Deze kerk is er al bijna twee millennia, heeft flink wat tijdgebonden verschijnselen overleefd en zal er nog flink wat overleven."
                            },
                            {
                                "example_id": "a889631f-ce05-4ae6-8bcf-bbcc919f8200",
                                "sense_id": "63bf12a8-bed3-34de-8ca9-014e7a5d91f3",
                                "text": "22 Jump Street is een keten van meestal vermakelijke sketches over het campusleven die uitmunten in improvisatie, zelfspot en het spelen met genreregels. Maar waar soortgelijke komedies als Bad Neighbours of This is the End nogal zelfvoldaan hip uitvallen en halverwege bij gebrek aan verhaal en karakterontwikkeling inzakken, komt 22 Jump Street dan juist op stoom."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "677ecdf5-2597-4e77-85c8-64373779ddd8",
                        "source_entry_id": "d3e28061-6430-3d89-abdd-6f6f45fc7333",
                        "source_sense_id": "63bf12a8-bed3-34de-8ca9-014e7a5d91f3",
                        "source_sense_description": "excelleren",
                        "target_lang_word": "outshine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outshine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c686002-2c3c-35ee-96b3-cb2b7c8ef75d",
                                        "entry_id": "2d528a8f-eaa9-377b-bd3a-da0654e6ec39",
                                        "glosses": [
                                            "To shine brighter than something else"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7cdc5166-3721-3599-8230-2fec5b20de6b",
                                        "entry_id": "2d528a8f-eaa9-377b-bd3a-da0654e6ec39",
                                        "glosses": [
                                            "To exceed something or someone else, especially in an obvious or flamboyant manner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aebc7ba-12df-4d29-b46b-6b9d3cd7e1e1",
                                                "sense_id": "7cdc5166-3721-3599-8230-2fec5b20de6b",
                                                "text": "Four minutes later Walcott, who until then had been redundant as a lone striker owing to one-star service, was given his first decent pass of the game and duly took his chance to outshine the Senegalese, springing a poorly conceived offside trap to collect Lukas Podolski's ball and stroke a low 15-yard shot past Tim Krul and into the far corner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47c7261d-1ffa-3fc2-ae27-70f13fb5785a",
                                        "entry_id": "2d528a8f-eaa9-377b-bd3a-da0654e6ec39",
                                        "glosses": [
                                            "To shine forth, to give out light."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a2feecc-afa2-4ada-8125-cc148b16ccdc",
                                                "sense_id": "47c7261d-1ffa-3fc2-ae27-70f13fb5785a",
                                                "text": "Bright, outshining beams."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54c30d2c-e459-40e4-9212-009764292d06",
                        "source_entry_id": "d3e28061-6430-3d89-abdd-6f6f45fc7333",
                        "source_sense_id": "63bf12a8-bed3-34de-8ca9-014e7a5d91f3",
                        "source_sense_description": "excelleren",
                        "target_lang_word": "surpass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surpass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3408f43d-1988-3d21-b5d8-11eb10e70987",
                                        "entry_id": "853578a8-50b4-3f1d-b396-7455555e1ca7",
                                        "glosses": [
                                            "To go beyond or exceed (something) in an adjudicative or literal sense."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e145f6ab-8040-43b9-86d6-826b89463336",
                                                "sense_id": "3408f43d-1988-3d21-b5d8-11eb10e70987",
                                                "text": "The former problem student surpassed his instructor's expectations and scored top marks on his examination."
                                            },
                                            {
                                                "example_id": "1d9729e3-b722-45d3-bdf2-366521989fa2",
                                                "sense_id": "3408f43d-1988-3d21-b5d8-11eb10e70987",
                                                "text": "The heavy rains threatened to surpass the capabilities of the levee, endangering the town on the other side."
                                            },
                                            {
                                                "example_id": "69bc241e-bf0d-45b3-9c12-970df1a2a800",
                                                "sense_id": "3408f43d-1988-3d21-b5d8-11eb10e70987",
                                                "text": "“Two or three months more went by; the public were eagerly awaiting the arrival of this semi-exotic claimant to an English peerage, and sensations, surpassing those of the Tichbourne case, were looked forward to with palpitating interest.[…]”"
                                            },
                                            {
                                                "example_id": "93fc641d-d5d4-499c-954d-feb3a022e724",
                                                "sense_id": "3408f43d-1988-3d21-b5d8-11eb10e70987",
                                                "text": "He celebrated at full-time with a beaming smile as he collected the match ball and he notched up another milestone by becoming the sixth Welshman to surpass 50 Premier League goals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
