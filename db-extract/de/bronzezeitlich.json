                "senses": [
                    {
                        "sense_id": "7abb77c2-1ec6-3dcb-a0ba-8ef7492a6185",
                        "entry_id": "d263b3d0-572c-341d-ba0f-40e99a0a0915",
                        "glosses": [
                            "den Zeitraum der Erdgeschichte betreffend, in dem der Mensch vermehrt damit begann, Schmuck, Waffen, Werkzeuge und Ähnliches aus Bronze herzustellen (Bronzezeit)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "335d111e-19c1-4f8a-b746-9fb3d2d2f354",
                                "sense_id": "7abb77c2-1ec6-3dcb-a0ba-8ef7492a6185",
                                "text": "„In einer bronzezeitlichen Proviantbox aus den Berner Alpen hat eine europäische Forschergruppe ungewöhnliche Getreidereste entdeckt.“"
                            },
                            {
                                "example_id": "95db821f-40de-4a77-b283-65739e2010a3",
                                "sense_id": "7abb77c2-1ec6-3dcb-a0ba-8ef7492a6185",
                                "text": "„Forschungen ergaben, dass die [Himmels-]Scheibe [von Nebra] den bronzezeitlichen Menschen als kombinierter Sonnen- und Mondkalender diente.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
