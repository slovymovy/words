                        "examples": [
                            {
                                "example_id": "a59ec469-bc08-47c1-a39b-cbbeff1a91a4",
                                "sense_id": "ed3bf196-fdf9-3aa0-bdac-3d249a971d76",
                                "text": "Aline werd geïnspireerd door het dagboek van Anne Frank. \"Er zijn tienduizenden Anne's van wie wij niks weten. Mijn opa was in de oorlog slagersknecht in Woerden. Toen ik een jaar of tien was liet mijn opa het huis zien waar het slagersgezin woonde. In de oorlog werd het hele gezin - vader, moeder en vier kinderen - van huis gehaald en naar Westerbork gedeporteerd. Alle zes stierven ze later in het vernietigingskamp van Auschwitch. Ik vond dat zo onvoorstelbaar dat het me sindsdien niet meer heeft losgelaten.\""
                            }
                        ]
                    }
