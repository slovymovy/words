                "senses": [
                    {
                        "sense_id": "3fbc7c88-a0ad-3f1d-9e4d-41313e120cbf",
                        "entry_id": "bd6f42cd-f328-394d-85a1-8d2e5617bbd0",
                        "glosses": [
                            "een man die als minister of staatssecretaris deel uitmaakt van een regering"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "9041b0b2-3f00-4afc-a13b-00e9c34d871e",
                                "sense_id": "3fbc7c88-a0ad-3f1d-9e4d-41313e120cbf",
                                "text": "De bewindslieden konden het niet eens worden over de aanwezigheid van de troepen in Afghanistan."
                            },
                            {
                                "example_id": "fd4ac1e0-5dd4-409a-b343-44835f7d342e",
                                "sense_id": "3fbc7c88-a0ad-3f1d-9e4d-41313e120cbf",
                                "text": "Er zou jarenlang voor gewaarschuwd zijn dat de GGD's onvoldoende voorbereid waren op een pandemie, maar met die informatie is niets gedaan. Maar dat gevaar werd door de kabinetten-Rutte onderschat, zeggen meerdere (ex-)GGD-directeuren tegen het AD. \"Bewindslieden vonden onze waarschuwingen belachelijk. 'Infectieziekten zijn voorbij', zei een bewindsman me letterlijk\", aldus ..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2dcf174-3d0d-4b89-af42-568f75fe2f23",
                        "source_entry_id": "bd6f42cd-f328-394d-85a1-8d2e5617bbd0",
                        "source_sense_id": "3fbc7c88-a0ad-3f1d-9e4d-41313e120cbf",
                        "source_sense_description": "een man die als minister of staatssecretaris deel uitmaakt van een regering",
                        "target_lang_word": "Minister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Minister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a71b895-6e41-3afc-a60f-6989802bc357",
                                        "entry_id": "af5a4a42-0a64-3b4d-81c1-f27d0de54990",
                                        "glosses": [
                                            "Leiter eines Ministeriums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9e5348e-5424-42f5-b6dc-029233ecaab9",
                                                "sense_id": "6a71b895-6e41-3afc-a60f-6989802bc357",
                                                "text": "In der Bundesregierung wirken viele Minister mit."
                                            },
                                            {
                                                "example_id": "e50bf9ac-9495-4ba5-b34a-ca2183b8fd54",
                                                "sense_id": "6a71b895-6e41-3afc-a60f-6989802bc357",
                                                "text": "„Diese Einschätzung hatte der Minister weitgehend exklusiv.“"
                                            },
                                            {
                                                "example_id": "9154b2b1-20b1-46cb-aa9a-69dd9853dce4",
                                                "sense_id": "6a71b895-6e41-3afc-a60f-6989802bc357",
                                                "text": "„Parteiübergreifend empören sich Abgeordnete über die Arroganz des Regierungschefs und seiner Minister.“"
                                            },
                                            {
                                                "example_id": "d09340ee-f208-4b7f-a0f6-d564401882b5",
                                                "sense_id": "6a71b895-6e41-3afc-a60f-6989802bc357",
                                                "text": "„Bolkonskij fühlte sich, ermüdet von der Reise und ihren vielen Eindrücken, vom Empfang beim Minister und besonders von dem Diner, unvermögend, die eben gehörten Worte in ihrer ganzen Tragweite zu erfassen.“"
                                            },
                                            {
                                                "example_id": "998b23ca-df08-4c90-8f01-c0efd3650519",
                                                "sense_id": "6a71b895-6e41-3afc-a60f-6989802bc357",
                                                "text": "„Die Koordinierung aller Maßnahmen im Bereich der inneren Sicherheit war Aufgabe des Ministers für Staatssicherheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
