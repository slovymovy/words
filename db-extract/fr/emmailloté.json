                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e48e42d6-aaff-4010-b58b-bc3eb40fc02a",
                                "sense_id": "123bea47-cda8-31d3-9d1f-2cfa74a3c429",
                                "text": "Voilà le bébé emmailloté, disait Cirilli. Dans quelques jours vous n'aurez plus qu'une cicatrice distinguée. De quoi attendrir toute la famille au retour."
                            },
                            {
                                "example_id": "811083f4-9c6c-4fa3-af10-c9da11d579d1",
                                "sense_id": "123bea47-cda8-31d3-9d1f-2cfa74a3c429",
                                "text": "De loin, il aperçut sur une hauteur un long manoir, construction assez hybride, mêlée de Renaissance et de Louis-Philippe, mais ayant grand air tout de même avec ses quatre tourelles et son pont-levis emmailloté de lierre."
                            },
                            {
                                "example_id": "7fce406b-bb2c-48df-b467-b10cbeaa5432",
                                "sense_id": "123bea47-cda8-31d3-9d1f-2cfa74a3c429",
                                "text": "Elle prit une paille emmaillotée de papier de soie, dans un gobelet de nickel, toucha avec cette paille la main velue du Slave et badina : […]"
                            }
                        ]
                    }
                ],
