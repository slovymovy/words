                "senses": [
                    {
                        "sense_id": "a00a4a7e-5c92-3246-b020-b7bb1a1b5cff",
                        "entry_id": "f661cf4a-478d-3278-9ed1-69f0c0b74c56",
                        "glosses": [
                            "schade toebrengend; ziek makend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fd5090a-0c2b-44fa-be53-1829c0a9f409",
                                "sense_id": "a00a4a7e-5c92-3246-b020-b7bb1a1b5cff",
                                "text": "Te veel eten is schadelijk voor de gezondheid."
                            },
                            {
                                "example_id": "789a38fd-d6f0-4c1f-bc28-c99b8560b88e",
                                "sense_id": "a00a4a7e-5c92-3246-b020-b7bb1a1b5cff",
                                "text": "Al snel duiken gezondheidsklachten op. Niet bij Van Nijen, die er nuchter in staat. 'Als het echt erg was, had de GGD wel gewaarschuwd.' Andere bewoners maken zich grote zorgen. 'Een gifwijk!', roepen ze. 'Wij gaan dood hier.' De autoriteiten proberen de onrust te temperen. Volgens de GGD blijft de uitstoot van schadelijke stoffen binnen de normen."
                            },
                            {
                                "example_id": "07028bd6-3cc9-45f5-aca9-6090ddc613cd",
                                "sense_id": "a00a4a7e-5c92-3246-b020-b7bb1a1b5cff",
                                "text": "De tests gingen niet van een leien dakje. De eerste keer was er een probleem met de mobiele draagraket. Een systeem dat ventilatoren gebruikt om schadelijke gassen buiten te houden werkte niet naar behoren. De tweede keer ging het mis omdat medewerkers een ventiel niet hadden opengedraaid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3cedf527-8ff7-455f-a97d-e845da97e19b",
                        "source_entry_id": "f661cf4a-478d-3278-9ed1-69f0c0b74c56",
                        "source_sense_id": "a00a4a7e-5c92-3246-b020-b7bb1a1b5cff",
                        "source_sense_description": "schade toebrengend",
                        "target_lang_word": "schädlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schädlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ab1bc1e-a722-3118-a02d-d35b052ea4f2",
                                        "entry_id": "3f38145a-2519-35c7-8611-7de29054c3cf",
                                        "glosses": [
                                            "zur Schädigung führend, sich nachteilig auswirkend, Schaden verursachend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "075bb4e6-5cb2-4203-b52f-6e05642da6c4",
                                                "sense_id": "0ab1bc1e-a722-3118-a02d-d35b052ea4f2",
                                                "text": "Quecksilber ist sehr schädlich für die Atemwege."
                                            },
                                            {
                                                "example_id": "a9ab44eb-6322-4fa0-acf4-49d69c995e4a",
                                                "sense_id": "0ab1bc1e-a722-3118-a02d-d35b052ea4f2",
                                                "text": "Unterschlagung ist schädlich für die Wirtschaft."
                                            },
                                            {
                                                "example_id": "0f986085-9b1d-44c3-a993-6f4b3f5cb8d0",
                                                "sense_id": "0ab1bc1e-a722-3118-a02d-d35b052ea4f2",
                                                "text": "„Alkohol ist zwar für die Gesundheit des Menschen schädlich, für viele Krankheitserreger ist er dagegen absolut tödlich.“"
                                            },
                                            {
                                                "example_id": "be44871d-7611-4495-af87-66800f005a7d",
                                                "sense_id": "0ab1bc1e-a722-3118-a02d-d35b052ea4f2",
                                                "text": "„Wasserstoff ist ein umweltfreundlicher Energieträger. Bei seiner Verbrennung entstehen keine schädlichen Abgase, sondern nur Wasserdampf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66eed9fc-fd95-45c7-bd27-778a66f5c2ea",
                        "source_entry_id": "f661cf4a-478d-3278-9ed1-69f0c0b74c56",
                        "source_sense_id": "a00a4a7e-5c92-3246-b020-b7bb1a1b5cff",
