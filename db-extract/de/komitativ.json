                "senses": [
                    {
                        "sense_id": "3685dbfd-6ef2-3bff-b7f9-5d79f0fe3331",
                        "entry_id": "64ff2372-6d2c-3ffe-b6f0-0f3cec6f14c2",
                        "glosses": [
                            "Kasus zum Ausdruck der Begleitung (\\\"mit X\\\", \\\"in Begleitung von X\\\")"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b110b7af-cdec-459a-9ea3-7570b4697cea",
                                "sense_id": "3685dbfd-6ef2-3bff-b7f9-5d79f0fe3331",
                                "text": "Finnisch ystäv-ine-en \"mit seinen/m bzw. ihren/m Freund(en)\", wobei -ine- die Endung des Komitativs ist und -en ein Possessivsuffix."
                            },
                            {
                                "example_id": "f602405d-03e8-475e-aa1c-74cc189353ba",
                                "sense_id": "3685dbfd-6ef2-3bff-b7f9-5d79f0fe3331",
                                "text": "Im Türkischen bedeutet arkadaş-la \"mit dem/der Kamerad/in\", wo die Endung -le oder -la je nach Vokalharmonie angehängt wird. Würde man \"mit meinem/meiner Kamerad/in\" sagen wollen, wird zwischen dem Wort und des Postfix des Komitativs der Possessivsuffix -im/-ım eingefügt: arkadaş-ım-la."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
