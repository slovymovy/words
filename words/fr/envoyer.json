{
    "word_family": [
        "envoi",
        "renvoi",
        "renvoyer",
        "envoyé"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fa0357e2-037b-3060-802a-daba939192ed",
                    "sense_definition": "Faire partir quelqu'un ou faire parvenir quelque chose à une destination.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "expedition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>envoie</w> une lettre à ma grand-mère pour son anniversaire."
                        },
                        {
                            "text": "Il doit <w>envoyer</w> un message urgent à son collègue avant midi."
                        }
                    ],
                    "synonyms": [
                        "expédier"
                    ],
                    "common_phrases": [
                        "envoyer un message",
                        "envoyer une lettre",
                        "envoyer un colis"
                    ]
                },
                {
                    "sense_id": "c091ccb6-bb5e-3933-b937-bbe2e967a64d",
                    "sense_definition": "Lancer ou projeter quelque chose avec force.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "propulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur a réussi à <w>envoyer</w> le ballon au fond du filet adverse."
                        },
                        {
                            "text": "Ce coup violent au menton a failli l'<w>envoyer</w> à terre immédiatement."
                        }
                    ],
                    "common_phrases": [
                        "envoyer le ballon",
                        "envoyer à terre"
                    ]
                },
                {
                    "sense_id": "57c31593-8139-3727-86a5-b0b153cc455d",
                    "sense_definition": "Émettre ou diffuser hors de soi de la lumière ou de la chaleur.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soleil d'été <w>envoie</w> ses rayons ardents sur la campagne asséchée."
                        },
                        {
                            "text": "Le phare côtier <w>envoie</w> un signal lumineux régulier aux navires égarés."
                        }
                    ],
                    "common_phrases": [
                        "envoyer de la lumière",
                        "envoyer des rayons"
                    ]
                },
                {
                    "sense_id": "aafe5f7f-93be-3a3b-b8c5-79adb128bc21",
                    "sense_definition": "Consommer ou avaler rapidement de la nourriture ou de la boisson.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "consommation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après l'effort, il s'est <w>envoyé</w> deux grands verres d'eau très fraîche."
                        },
                        {
                            "text": "Ils ont décidé de s'<w>envoyer</w> une pizza entière avant de partir au concert."
                        }
                    ],
                    "common_phrases": [
                        "s'envoyer un verre",
                        "s'envoyer un repas"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "47cfb2ac-060a-399a-aa48-365129ba7d62",
                    "sense_definition": "Adresser promptement et vivement une réplique, une remarque piquante ou un bon mot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant l'échange politique, elle n'a pas hésité à lui <w>envoyer</w> une remarque ironique."
                        },
                        {
                            "text": "L'avocat a su <w>envoyer</w> une réplique cinglante qui a complètement déstabilisé son adversaire."
                        }
                    ],
                    "common_phrases": [
                        "envoyer une pique",
                        "envoyer un bon mot"
                    ]
                }
            ]
        }
    ]
}