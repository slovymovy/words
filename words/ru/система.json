                },
                {
                    "sense_id": "b6878038-e22d-38c7-bcd1-f6f543bdc532",
                    "sense_definition": "Способ записи чисел (система счисления).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Компьютеры обрабатывают информацию в двоичной <w>системе</w>.",
                            "target_lang_translations": {
                                "en": "Computers process information in the binary <w>system</w>.",
                                "zh": "计算机使用二进制<w>进制</w>处理信息。"
                            }
                        },
                        {
                            "text": "В повседневной жизни мы используем десятичную <w>систему</w>.",
                            "target_lang_translations": {
                                "en": "In everyday life, we use the decimal <w>system</w>.",
                                "zh": "在日常生活中，我们使用十<w>进制</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "система счисления"
                    ],
                    "common_phrases": [
                        "двоичная система",
                        "десятичная система"
                    ],
                    "target_lang_definitions": {
                        "en": "A method of representing numbers.",
                        "zh": "一种表示数字的方法。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "system",
                                "target_lang_sense_clarification": "numeral system"
                            },
                            {
                                "target_lang_word": "numeral system",
                                "target_lang_sense_clarification": "mathematical notation"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "进制",
                                "target_lang_sense_clarification": "指数学中的计数系统"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bdc15e5-f8eb-3991-aa86-af371c02b84b",
                    "sense_definition": "Неформальное объединение хиппи и примыкающих к ним молодёжных течений (преимущественно в СССР и России).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В молодости он был частью <w>системы</w> и часто путешествовал автостопом.",
                            "target_lang_translations": {
                                "en": "In his youth, he was part of the <w>System</w> and often hitchhiked.",
                                "zh": "年轻时，他是那个<w>系统</w>的一员，经常搭便车旅行。"
                            }
                        },
                        {
                            "text": "Люди <w>системы</w> имели свой особый сленг и стиль одежды.",
                            "target_lang_translations": {
                                "en": "People of the <w>System</w> had their own special slang and clothing style.",
                                "zh": "那个<w>系统</w>里的人有他们独特的俚语和穿衣风格。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "человек системы"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": "historical context of USSR/90s"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A counter-cultural movement in the USSR, specifically the hippie community.",
                        "zh": "苏联时期的一种反文化运动，特指嬉皮士群体。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "System",
                                "target_lang_sense_clarification": "Soviet hippie subculture"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "系统",
                                "target_lang_sense_clarification": "指苏联时期的嬉皮士亚文化"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57f87b69-7124-392f-ada4-41297fd4605f",
                    "sense_definition": "Совокупность геологических отложений, образовавшихся в течение одного геологического периода.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пермская <w>система</w> была впервые выделена на территории России.",
                            "target_lang_translations": {
                                "en": "The Permian <w>system</w> was first identified in the territory of Russia.",
                                "zh": "二叠<w>系</w>最早是在俄罗斯境内被划分出来的。"
                            }
                        },
                        {
                            "text": "Геологи изучают слои юрской <w>системы</w> в поисках полезных ископаемых.",
                            "target_lang_translations": {
                                "en": "Geologists study the layers of the Jurassic <w>system</w> in search of minerals.",
                                "zh": "地质学家研究侏罗<w>系</w>的地层以寻找矿产资源。"
                            }
                        }
