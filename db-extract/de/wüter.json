                            {
                                "example_id": "783687cd-d86d-459a-9d6d-9db6adf6fc0b",
                                "sense_id": "6bbf90ff-63cc-3631-bdd7-cae69bde0b03",
                                "text": "„Der Wüter von Hinwil ist verhaftet. Aus Hass auf die Behörden verwüstete ein 23-Jähriger das Hinwiler Gemeindehaus. Jetzt sitzt er in U-Haft.“"
                            }
