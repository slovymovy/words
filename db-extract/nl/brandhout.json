                    },
                    {
                        "translation_id": "2ea17083-415c-4291-8f75-e60f1359b5d3",
                        "source_entry_id": "123a893b-9b83-3fd5-adce-50918538e471",
                        "source_sense_id": "edbebdf5-bb58-3239-85d9-b570188fcfc7",
                        "source_sense_description": "hout dat gebruikt wordt om te verbranden",
