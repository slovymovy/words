                        "sense_id": "bde8c3d5-3f43-3c9b-b4a2-00436302dedf",
                        "entry_id": "83c18c28-5080-3ce1-a67a-929e60fe3067",
                        "glosses": [
                            "Intervenir pour libérer une personne qui a été arrêtée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d64ec7b-739a-463f-995a-c5d12c233e4e",
                                "sense_id": "bde8c3d5-3f43-3c9b-b4a2-00436302dedf",
                                "text": "très souvent, le bloc permet de désarrêter des personnes aux mains de la police en déconcentrant, en surprenant et en adoptant une attitude offensive."
                            },
                            {
                                "example_id": "e3413a0c-f8a4-4b96-97c4-0d0e87928a93",
                                "sense_id": "bde8c3d5-3f43-3c9b-b4a2-00436302dedf",
                                "text": "J’ai vu des black blocs désarrêter leurs camarades que la police avait interpellés, sans blesser personne ni rien casser."
                            },
                            {
                                "example_id": "858e83dd-966d-4a47-a863-1acb36bded27",
                                "sense_id": "bde8c3d5-3f43-3c9b-b4a2-00436302dedf",
                                "text": "Tu peux toujours te faire désarrêter plus tard."
                            }
                        ]
                    }
