                                "target_senses": [
                                    {
                                        "sense_id": "16db9497-cb06-3620-be90-9d6f7b6b6ef2",
                                        "entry_id": "65e5db10-8e21-3f6e-86ae-0ca3802d01af",
                                        "glosses": [
                                            "nicht aufschiebbar, sofort zu erledigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c39b10c-db0b-437b-85fe-8aaa11f71fbf",
                                                "sense_id": "16db9497-cb06-3620-be90-9d6f7b6b6ef2",
                                                "text": "Schnell, es ist dringend!"
                                            },
                                            {
                                                "example_id": "1deffdc2-011e-43ba-8355-5d7b613615d6",
                                                "sense_id": "16db9497-cb06-3620-be90-9d6f7b6b6ef2",
                                                "text": "Ich muss mal ganz dringend aufs Klo!"
                                            },
                                            {
                                                "example_id": "ee4c9fd8-82b3-4bc7-8e4d-35c07d94ff63",
                                                "sense_id": "16db9497-cb06-3620-be90-9d6f7b6b6ef2",
                                                "text": "Ich hab vergessen den Herd auszumachen, ich muss dringend zurück nach Hause."
                                            },
                                            {
                                                "example_id": "2a3064c3-5347-415b-8266-53831d78bed3",
                                                "sense_id": "16db9497-cb06-3620-be90-9d6f7b6b6ef2",
                                                "text": "Diesmal ist es noch dringender als beim letzten Mal."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "28fc793e-0fb7-3fa3-a207-50477c140a0e",
                                        "entry_id": "65e5db10-8e21-3f6e-86ae-0ca3802d01af",
                                        "glosses": [
                                            "sehr stark"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98c0666c-612d-4238-9d7c-d207d269931e",
                                                "sense_id": "28fc793e-0fb7-3fa3-a207-50477c140a0e",
                                                "text": "Es besteht der dringende Verdacht, dass er bestochen wurde."
                                            },
                                            {
                                                "example_id": "f93f5262-2c74-4176-bed0-38b924f0a694",
                                                "sense_id": "28fc793e-0fb7-3fa3-a207-50477c140a0e",
                                                "text": "„Damit es keine bösen und vor allem teuren Überraschungen gibt, empfiehlt Goris dringend, sich zumindest die Protokolle der letzten drei Eigentümerversammlungen aushändigen zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
