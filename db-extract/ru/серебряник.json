                        "examples": [
                            {
                                "example_id": "78dec127-2441-403a-8e4e-d70a711c0de1",
                                "sense_id": "2b04ee8c-5231-34d6-9deb-bdda9733ef71",
                                "text": "И вспомнился ему и морщинистый, с седой бородкой, дед, серебряник, как он чеканил серебро своими жилистыми руками и заставлял внука говорить молитвы."
                            }
                        ]
                    }
