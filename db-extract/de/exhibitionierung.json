                "senses": [
                    {
                        "sense_id": "bfef0bd4-b333-3ef9-a7f3-2ffe2379a40d",
                        "entry_id": "f2b536fc-2a5d-3d7a-b68a-0ba851f62c27",
                        "glosses": [
                            "Entblößung, das Sich-zur-Schau-stellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "465083b1-2240-47c3-9bc6-0264ede23c96",
                                "sense_id": "bfef0bd4-b333-3ef9-a7f3-2ffe2379a40d",
                                "text": "„Das Eigentümliche der Übung scheint in der Balance von Exhibitionierung und Verschleierung zu liegen, die sich schon in der eingeforderten Symbolisierung zeigt.“"
                            },
                            {
                                "example_id": "6c8e0fa2-3a79-4460-b688-29d8641593f3",
                                "sense_id": "bfef0bd4-b333-3ef9-a7f3-2ffe2379a40d",
                                "text": "„Das Mitleid, das er bei Varvara erheischen will, ist im Grunde Selbstmitleid und dient zu nichts anderem als der Exhibitionierung seines egomanischen Charakters.“"
                            },
                            {
                                "example_id": "6004785d-7561-4fbe-9aa7-537d98623325",
                                "sense_id": "bfef0bd4-b333-3ef9-a7f3-2ffe2379a40d",
                                "text": "„Die Verinnerlichung und Verdichtung des körperlichen Moments zu dem besonderen Stimmungsgehalt einer Konkretisierung und Exhibitionierung charakteristischer Nuancen und Situationen kann ferner zu ausgesprochen transvestitischen Neigungen führen […].“"
                            },
                            {
                                "example_id": "036fa229-d294-4fc6-a1dd-a9b09d796b9f",
                                "sense_id": "bfef0bd4-b333-3ef9-a7f3-2ffe2379a40d",
                                "text": "„Solche Exhibitionierungen wurden manchmal auch absichtlich herbeigeführt und in ähnlicher Weise zum koketten Spiel verwendet, wie später das Zeigen der Dessous, des seidenbestrumpften Beines oder des Brustansatzes im Dekolleté.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
