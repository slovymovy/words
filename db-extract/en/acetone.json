                        "entry_id": "bf072089-3d43-3132-bc64-16a86327c7fa",
                        "glosses": [
                            "A colourless, volatile, flammable liquid ketone, (CH₃)₂CO, used as a solvent."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
