            {
                "entry_id": "967b0ee5-b15b-34c0-8592-501f6465537a",
                "word": "Megapolitan",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "30fc0841-6cb4-41ab-a197-49418b5363ba",
                        "entry_id": "967b0ee5-b15b-34c0-8592-501f6465537a",
                        "tags": [
                            "plural"
                        ],
                        "form": "Megapolitans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e14abc9-a9e9-3352-b5a1-754ccef4836a",
                        "entry_id": "967b0ee5-b15b-34c0-8592-501f6465537a",
                        "glosses": [
                            "An inhabitant of the ancient city of Megalopolis (now Megalopoli) in Greece."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0827e927-9c06-40d9-b1d5-b2f4617701ba",
                                "sense_id": "9e14abc9-a9e9-3352-b5a1-754ccef4836a",
                                "text": "The Megapolitans whoſe City did abide the ſiege, were compelled to pay as a fine for their rebellion twenty talents to the Athenians, and the Æolians."
                            },
                            {
                                "example_id": "81ecd5a1-a2c6-4c76-9bc5-c98cc4157712",
                                "sense_id": "9e14abc9-a9e9-3352-b5a1-754ccef4836a",
                                "text": "The Lacedæmonians, in Conjunction with the Phocenſes, make War with the Megapolitans, Thebans and Argives. After ſeveral Battles, in which both ſides are ſometimes ſucceſsful, and at other times unſucceſsful, a Truce is concluded between the Lacedæmonians and Megapolitans."
                            },
                            {
                                "example_id": "3bafe4b5-da10-49c0-bbca-15e47b7d673a",
                                "sense_id": "9e14abc9-a9e9-3352-b5a1-754ccef4836a",
                                "text": "When, therefore, the above-mentioned request for help from the Megapolitans reached Athens in 352, Demosthenes expressed himself in favour of complying with it, especially emphasizing the necessity of not allowing Sparta to become too powerful."
                            }
                        ]
                    }
                ],
