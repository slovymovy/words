                ],
                "senses": [
                    {
                        "sense_id": "66272072-6304-341b-b3da-5e04dd223bf7",
                        "entry_id": "aad200c7-e014-3b4a-8e16-3bcf6669de6b",
                        "glosses": [
                            "systematyczny podział czegoś (przedmiotów lub zjawisk) na klasy, działy, poddziały itp. według określonej zasady"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b41eb76-2c85-44b7-9292-bd3cd9902b0f",
                                "sense_id": "66272072-6304-341b-b3da-5e04dd223bf7",
                                "text": "Klasyfikacja minerałów polega na uporządkowaniu ich w gromady, klasy, grupy i szeregi"
                            },
                            {
                                "example_id": "a03f4422-2f9c-4a19-90c7-7fce3928cad6",
                                "sense_id": "66272072-6304-341b-b3da-5e04dd223bf7",
                                "text": "Istnieje kilka różnych kategorii klasyfikacji zapalenia płuc."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ff4db889-a39b-3db6-bc17-86331d1695f6",
                        "entry_id": "aad200c7-e014-3b4a-8e16-3bcf6669de6b",
                        "glosses": [
                            "zaklasyfikowanie danego zjawiska lub przedmiotu do odpowiedniej klasy, grupy itp."
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "37cdeaf3-05c5-3dcb-a20a-53de299114fd",
                        "entry_id": "aad200c7-e014-3b4a-8e16-3bcf6669de6b",
                        "glosses": [
                            "ocena kogoś lub czegoś w skali porównawczej"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bb26785-38c5-46c1-a241-bc503e2f5e1c",
                        "source_entry_id": "aad200c7-e014-3b4a-8e16-3bcf6669de6b",
                        "source_sense_id": "66272072-6304-341b-b3da-5e04dd223bf7",
                        "target_lang_word": "classification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "classification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b43812d-0974-35eb-967f-2cdbc8d946ae",
                                        "entry_id": "df529d2e-dd10-36f6-bb28-2640cc822448",
                                        "glosses": [
                                            "The act of forming into a class or classes; a distribution into groups, as classes, orders, families, etc., according to some common relations or attributes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "383dc098-67a9-4d26-8278-94c17e15b3d8",
                                                "sense_id": "6b43812d-0974-35eb-967f-2cdbc8d946ae",
                                                "text": "Near-synonyms: categorization, typing"
                                            },
                                            {
                                                "example_id": "0e403ccb-6cbc-4a67-876d-f9255682b45f",
                                                "sense_id": "6b43812d-0974-35eb-967f-2cdbc8d946ae",
                                                "text": "On those remote pages it is written that animals are divided into (a) those that belong to the Emperor, (b) embalmed ones, (c) those that are trained, (d) suckling pigs, (e) mermaids, (f) fabulous ones, (g) stray dogs, (h) those that are included in this classification, (i) those that tremble as if they were mad, (j) innumerable ones, (k) those drawn with a verfy fine camel's hair brush, (l) others, (m) those that have just broken a flower vase, (n) those that resemble flies from a distance."
                                            },
                                            {
                                                "example_id": "f9416ffc-f8ac-4e2f-abea-c23a731c86f8",
                                                "sense_id": "6b43812d-0974-35eb-967f-2cdbc8d946ae",
                                                "text": "1997: Chris Horrocks, Introducing Foucault, page 69 (Totem Books, Icon Books; →ISBN\nI’m using mathesis — a universal science of measurement and order …\nAnd there is also taxinomia a principle of 'classification' and ordered tabulation.\nKnowledge replaced universal resemblance with finite differences. History was arrested and turned into tables …\nWestern reason had entered the age of judgement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a34ac5e-03be-499d-9d72-9b06b44f542a",
                        "source_entry_id": "aad200c7-e014-3b4a-8e16-3bcf6669de6b",
                        "source_sense_id": "66272072-6304-341b-b3da-5e04dd223bf7",
                        "target_lang_word": "categorization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "categorization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37186aba-961d-3378-820f-44ec17a5ab4c",
                                        "entry_id": "3af2eb07-d869-3e4a-94ae-33f4e84113e9",
                                        "glosses": [
                                            "A group of things arranged by category."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c05f3e75-61fe-3a67-9b3e-ee2ebb24ff84",
                                        "entry_id": "3af2eb07-d869-3e4a-94ae-33f4e84113e9",
                                        "glosses": [
                                            "The process of sorting or arranging things into categories or classes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6b5bcd8-fa9d-451c-812e-f73c2bc09720",
                                                "sense_id": "c05f3e75-61fe-3a67-9b3e-ee2ebb24ff84",
                                                "text": "It’s fair to say that Wikipedia has spent far more time considering the philosophical ramifications of categorization than Aristotle and Kant ever did."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
