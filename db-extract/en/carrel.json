                "entry_id": "6e911f2e-161d-3fd4-8ff8-71ba7445f4ec",
                "word": "carrel",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1598e4e1-6e25-4fcf-b6ef-ebc83770f454",
                        "entry_id": "6e911f2e-161d-3fd4-8ff8-71ba7445f4ec",
                        "tags": [
