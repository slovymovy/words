                ],
                "senses": [
                    {
                        "sense_id": "3131b6b2-0d28-3faf-8595-556adcb39a91",
                        "entry_id": "9001a8bd-8e40-3df9-a307-d1edca3e0285",
                        "glosses": [
                            "de stoelgang bevorderend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2590390-7180-4010-b946-c3dbae29e7d2",
                                "sense_id": "3131b6b2-0d28-3faf-8595-556adcb39a91",
                                "text": "Dit heeft een sterk laxatieve werking."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ccf686a-f7c3-4c01-afb1-a2f9ed1c2534",
                        "source_entry_id": "9001a8bd-8e40-3df9-a307-d1edca3e0285",
                        "source_sense_id": "3131b6b2-0d28-3faf-8595-556adcb39a91",
                        "source_sense_description": "de stoelgang bevorderend",
                        "target_lang_word": "laxative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laxative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "041200e0-c8a2-3c1b-b367-1f7e3c5ad5ea",
                                        "entry_id": "3f5255e2-02eb-3b64-becb-740891eb2f7f",
                                        "glosses": [
                                            "Having the effect of moving the bowels, or aiding digestion and preventing constipation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49cf08b1-4a21-4dbe-90fd-62995a6c8e51",
                                                "sense_id": "041200e0-c8a2-3c1b-b367-1f7e3c5ad5ea",
                                                "text": "BOlvs in Engliſh is called a morſell. It is a medicine laxatiue, in forme & faſhion it is meanely whole, & it is ſwallowed by litle gobbets."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laxative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b950e95-ce05-3163-9f6f-7bd7fc9e285a",
                                        "entry_id": "0f1fa69d-e485-3427-b694-740836ca097e",
                                        "glosses": [
                                            "Any substance, such as a food or in the form of a medicine which has a laxative effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b1b90a8-3921-42c2-94a3-48ef3fade95d",
                                                "sense_id": "0b950e95-ce05-3163-9f6f-7bd7fc9e285a",
                                                "text": "According to a recent article in the Wall Street Journal, the US is having a love affair with laxatives; Americans of all ages are ingesting so much of the stuff that there are now shortages nationwide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "748311d7-5aff-4e4c-ae51-013bd03be483",
                        "source_entry_id": "9001a8bd-8e40-3df9-a307-d1edca3e0285",
                        "source_sense_id": "3131b6b2-0d28-3faf-8595-556adcb39a91",
                        "source_sense_description": "de stoelgang bevorderend",
                        "target_lang_word": "laxatif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laxatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f8383d5-5866-3d42-8795-9c8d47350ba1",
                                        "entry_id": "0268ad93-e9d4-3e53-9f85-5461aaa98804",
                                        "glosses": [
                                            "Accélérant le transit intestinal, qui ramollit les selles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40368923-7ca6-498a-ba32-a234e924b190",
                                                "sense_id": "7f8383d5-5866-3d42-8795-9c8d47350ba1",
                                                "text": "Ces purgatifs étaient des tisanes laxatives faites avec le séné et le cristal minéral, ordonnées par verrées, les décoctions des tamarins ou les infusions des vulnéraires dans lesquelles on dissolvait la manne et le sel prunelle, les diluta cassiae, les sirops de chicorée avec la rhubarbe, auxquels succédaient encore les cordiaux et doux alexitères, par les raisons alléguées ci-dessus, c’est-à-dire pour fortifier et arrêter les superpurgations qui auraient infailliblement causé quelques funestes abattements ; (…)"
                                            },
                                            {
                                                "example_id": "568c6380-aff7-4386-a9ea-939daa6a13b6",
                                                "sense_id": "7f8383d5-5866-3d42-8795-9c8d47350ba1",
                                                "text": "On y apprend que le fenouil est laxatif, que les feuilles de lys sont un antidote aux morsures de serpent ou qu’une décoction d’absinthe (une plante dont la racine est déjà recommandée en pessaire par Hippocrate) soulage les migraineux quand elle est appliquée sur la chevelure."
                                            },
                                            {
                                                "example_id": "c68766e2-e227-494d-807c-43030a896b97",
                                                "sense_id": "7f8383d5-5866-3d42-8795-9c8d47350ba1",
                                                "text": "Après y avoir apporté certaines modifications, il crée en 1923 le “Vermi-Sirop”. Ce remède laxatif et calmant, à base de plantes dont la tanaisie qui fleurit sur la commune, est vendu en France et au-delà. Paul Garnier, qui lui succède de 1945 à 1960, reprend la fabrication du médicament."
                                            },
                                            {
                                                "example_id": "92c9eb51-317f-43c3-8eef-0a83428be1dc",
                                                "sense_id": "7f8383d5-5866-3d42-8795-9c8d47350ba1",
                                                "text": "Tous les témoins anciens en garantissent l’authenticité, à une exception près : Aristoxène de Tarente, disciple d’Aristote, rapporte en effet dans son livre sur Pythagore que ce dernier « appréciait la fève plus que tous les autres végétaux, disant qu’elle était laxative et émolliente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab76ee68-e8a1-398b-ab38-ae85f7695929",
                                        "entry_id": "0268ad93-e9d4-3e53-9f85-5461aaa98804",
                                        "glosses": [
                                            "Qui provoque l'effusion, l'épanchement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "185d742a-1b80-4e72-89cd-ff24deef3faf",
                                                "sense_id": "ab76ee68-e8a1-398b-ab38-ae85f7695929",
                                                "text": "Cette chose a été vue mille fois dans l’horrible guerre. D’agréables poètes en ont profité pour augmenter leur bagage de quelques alexandrins laxatifs dont les vierges des pharmaciens et les épouses des notaires se sont émues jusqu’à l’effusion des pleurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laxatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae277bb2-6525-3c93-9240-27a87e9e4e77",
                                        "entry_id": "93dd67b6-d401-3169-a196-afcdb4ceeca6",
                                        "glosses": [
                                            "Substance laxative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cb3bda7-bf4b-41b4-9558-cf60360835b0",
                                                "sense_id": "ae277bb2-6525-3c93-9240-27a87e9e4e77",
                                                "text": "Un bon laxatif."
                                            },
                                            {
                                                "example_id": "acc6a357-cc21-43a7-bf7c-daa9663ec93c",
                                                "sense_id": "ae277bb2-6525-3c93-9240-27a87e9e4e77",
                                                "text": "Des laxatifs."
                                            },
                                            {
                                                "example_id": "18091e26-5c56-4106-8e9b-edf0e45af828",
                                                "sense_id": "ae277bb2-6525-3c93-9240-27a87e9e4e77",
                                                "text": "Un laxatif est un purgatif léger, qui agit en douceur, sans irriter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "489b28f0-f7f9-4bf4-8e0a-de0ddc932cab",
                        "source_entry_id": "9001a8bd-8e40-3df9-a307-d1edca3e0285",
