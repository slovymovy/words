                        {
                            "text": "Le médecin lui a expliqué que sa <w>faiblesse</w> musculaire était causée par le manque de vitamines."
                        }
                    ],
                    "synonyms": [
                        "débilité",
                        "fatigue",
                        "lassitude"
                    ],
                    "antonyms": [
                        "force"
                    ],
                    "common_phrases": [
