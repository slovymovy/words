                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8438055-0edd-40cf-ba6e-1553996e0d26",
                                "sense_id": "ded2990c-5a29-3120-9385-7dfb5c33e8bf",
                                "text": "Bedingt durch die Domestikation hat der Haushund meistens einen kürzeren Schädel als die wildlebenden Hunde."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9cf4f890-3ef6-3db4-a019-cba27f53fde9",
