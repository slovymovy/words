                ],
                "senses": [
                    {
                        "sense_id": "db596c5f-b6bd-302d-b3dd-a908f6c999f9",
                        "entry_id": "b85bc2da-2f31-3c55-aed0-5c6c15ba07e2",
                        "glosses": [
                            "An abundance, a rich supply of."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "26cc2782-6741-47ad-b4f5-ac452c979118",
                                "sense_id": "db596c5f-b6bd-302d-b3dd-a908f6c999f9",
                                "text": "The earth did never mean her foizon\nFor those who crown life’s cup with poison\nOf fanatic rage and meaningless revenge—\nBut for those radiant spirits, who are still\nThe standard-bearers in the van of Change."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f1254b7-dcbe-3df7-bada-dffc04654aec",
                        "entry_id": "b85bc2da-2f31-3c55-aed0-5c6c15ba07e2",
                        "glosses": [
                            "Harvest."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "6105587a-e51b-4a6a-9095-45c391219d9c",
                                "sense_id": "2f1254b7-dcbe-3df7-bada-dffc04654aec",
                                "text": "Gon. […]Treaſon, fellony, / Sword, Pike, Knife, Gun, or neede of any Engine / Would I not haue : but Nature ſhould bring forth / Of it owne kinde, all foyzon, all abundance / To feed my innocent people."
                            }
                        ]
                    },
                    {
                        "sense_id": "0015ddd6-fcba-3989-afa7-f86aee22b4e2",
                        "entry_id": "b85bc2da-2f31-3c55-aed0-5c6c15ba07e2",
                        "glosses": [
                            "Strength, power."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
