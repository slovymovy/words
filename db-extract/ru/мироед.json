                                        "entry_id": "41e0c5bd-733c-32bb-a213-2b0e348af705",
                                        "glosses": [
                                            "Someone who extorts; an extortionist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "028389fc-1164-4f6d-b0e6-ae261e2ecd64",
                                                "sense_id": "128cf1f7-39b4-3064-9145-0ba79c6407ad",
                                                "text": "But now I have written unto you not to keep company, if any man that is called a brother be […] an extortioner; with such an one no not to eat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
