                        "glosses": [
                            "tijdsperiode dat een beurs geopend is op een dag; dag dat een beurs geopend is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0653e85b-15a4-4982-90a2-8cdb76d380f9",
                                "sense_id": "56d8f017-94c1-339a-85e5-23b92024469d",
                                "text": "De uitgifteprijzen van de aandelen zakken om die reden naar de onderkant van de aanvankelijk prijsrange. Niets is namelijk vervelender als je op de eerste beursdag te duur wordt gevonden en moet eindigen met verlies. Dan maar genoegen nemen met een lagere opbrengst."
                            },
                            {
                                "example_id": "b52b327b-4f07-4dc7-bc94-e5c3f3ebd7b6",
                                "sense_id": "56d8f017-94c1-339a-85e5-23b92024469d",
                                "text": "Na de slechte beursdag van gisteren is de weg omhoog nog niet gevonden. Op beurzen in Azië daalden de koersen."
                            }
                        ]
                    }
