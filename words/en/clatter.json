{
    "word_family": [
        "clattering",
        "clattery"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ded094c-5289-3293-a3e7-29805106492c",
                    "sense_definition": "To make a continuous series of quick, sharp, hard sounds.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dishes started to <w>clatter</w> in the sink as she washed them quickly.",
                            "target_lang_translations": {
                                "tr": "Bulaşıkları hızlıca yıkarken lavabodaki tabaklar <w>takırdamaya</w> başladı."
                            }
                        },
                        {
                            "text": "Old pans <w>clatter</w> together whenever the truck drives over a bump.",
                            "target_lang_translations": {
                                "tr": "Kamyon her kasisten geçtiğinde eski tencereler birbirine çarpıp <w>takırdıyor</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "rattle"
                    ],
                    "common_phrases": [
                        "clatter together"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hızlı, keskin ve sert sesler çıkararak takırdamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "takırdamak",
                                "target_lang_sense_clarification": "sert nesnelerin çarpışarak ses çıkarması"
                            },
                            {
                                "target_lang_word": "tıkırdamak",
                                "target_lang_sense_clarification": "daha hafif takırtı çıkarmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "353f680e-beee-3468-a531-205c3119b8f3",
                    "sense_definition": "To talk rapidly, continuously, and noisily.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children continue to <w>clatter</w> endlessly during the lunch break.",
                            "target_lang_translations": {
                                "tr": "Çocuklar öğle arasında durmaksızın <w>gevezelik etmeye</w> devam ediyor."
                            }
                        },
                        {
                            "text": "They would <w>clatter</w> on for hours about trivial daily news.",
                            "target_lang_translations": {
                                "tr": "Önemsiz günlük haberler hakkında saatlerce <w>dır dır ederlerdi</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clatter on"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hızlı, sürekli ve gürültülü bir şekilde gevezelik etmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "gevezelik etmek",
                                "target_lang_sense_clarification": "hızlı ve sürekli konuşmak"
                            },
                            {
                                "target_lang_word": "dır dır etmek",
                                "target_lang_sense_clarification": "gürültülü şekilde konuşmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f08d6afb-c8cf-3ec4-9ec9-317ef917a1b2",
                    "sense_definition": "To strike or hit someone hard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He threatened to <w>clatter</w> his rival if he didn't leave immediately.",
                            "target_lang_translations": {
                                "tr": "Hemen gitmezse rakibine bir tane <w>yapıştırmakla</w> tehdit etti."
                            }
                        },
                        {
                            "text": "The angry player decided to <w>clatter</w> into the defender during the game.",
                            "target_lang_translations": {
                                "tr": "Öfkeli oyuncu maç sırasında defans oyuncusuna sertçe <w>çarpmaya</w> karar verdi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal physical violence sense"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Birine sertçe vurmak veya çarpmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yapıştırmak",
                                "target_lang_sense_clarification": "argo; sert darbe vurmak"
                            },
                            {
                                "target_lang_word": "geçirmek",
                                "target_lang_sense_clarification": "argo; birine vurmak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dcc882e5-728b-3b59-80a4-f20bf8034e47",
                    "sense_definition": "A loud, rattling noise made by hard objects striking together.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>clatter</w> of plates startled everyone in the quiet kitchen.",
                            "target_lang_translations": {
                                "tr": "Sessiz mutfakta aniden gelen tabağın <w>takırtısı</w> herkesi irkitti."
                            }
                        },
                        {
                            "text": "The loud <w>clatter</w> of dishes came from the back room.",
                            "target_lang_translations": {
                                "tr": "Arka odadan yüksek bir tabak çanak <w>takırtısı</w> geldi."
                            }
                        }
                    ],
                    "synonyms": [
                        "rattle",
                        "clacking",
                        "clattering"
                    ],
                    "common_phrases": [
                        "clatter of dishes"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sert nesnelerin birbirine çarpmasıyla çıkan yüksek, takırtılı ses."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "takırtı",
                                "target_lang_sense_clarification": "sert cisimlerin çarpışma sesi"
                            },
                            {
                                "target_lang_word": "takır tukur",
                                "target_lang_sense_clarification": "sürekli ve yüksek takırtı sesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52c85b35-c03c-3ed8-a564-a1b8a50f6e4d",
                    "sense_definition": "A noisy disturbance or commotion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden news caused quite a <w>clatter</w> among the staff members.",
                            "target_lang_translations": {
                                "tr": "Ani haber çalışanlar arasında epey bir <w>patırtıya</w> neden oldu."
                            }
                        },
                        {
                            "text": "The argument in the hallway created a loud <w>clatter</w> that interrupted the meeting.",
                            "target_lang_translations": {
                                "tr": "Koridordaki tartışma, toplantıyı bölen yüksek bir <w>patırtı</w> yarattı."
                            }
                        }
                    ],
                    "synonyms": [
                        "commotion",
                        "racket"
                    ],
                    "target_lang_definitions": {
                        "tr": "Gürültülü bir kargaşa veya patırtı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "patırtı",
                                "target_lang_sense_clarification": "gürültülü kargaşa"
                            },
                            {
                                "target_lang_word": "patır kütür",
                                "target_lang_sense_clarification": "gürültülü patırtılı ses/kargaşa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f556c34-83e4-310b-8100-55b9769c5407",
                    "sense_definition": "Loud, confused, or continuous conversation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>clatter</w> of voices filled the crowded cafeteria.",
                            "target_lang_translations": {
                                "tr": "Seslerin sürekli <w>uğultusu</w> kalabalık kafeteryayı doldurdu."
                            }
                        },
                        {
                            "text": "I could barely hear the speaker over the background <w>clatter</w> of chatter.",
                            "target_lang_translations": {
                                "tr": "Arka plandaki sohbet <w>gürültüsü</w> yüzünden konuşmacıyı güçlükle duyabildim."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Yüksek sesli, karmaşık veya sürekli konuşma gürültüsü."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "uğultu",
                                "target_lang_sense_clarification": "konuşma seslerinin oluşturduğu gürültü"
                            },
                            {
                                "target_lang_word": "gürültü",
                                "target_lang_sense_clarification": "konuşma kalabalığının sesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ce6332e-6986-3266-9a2e-47c18ed9adc2",
                    "sense_definition": "A large number or group of things or people, especially children.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She arrived at the park with a whole <w>clatter</w> of kids in tow.",
                            "target_lang_translations": {
                                "tr": "Parka arkasında bir <w>sürü</w> çocukla geldi."
                            }
                        },
                        {
                            "text": "There was a <w>clatter</w> of small items spilled across the floor.",
                            "target_lang_translations": {
                                "tr": "Zemine saçılmış bir <w>yığın</w> küçük eşya vardı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clatter of kids"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Chiefly Irish English"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Çok sayıda şey veya insan (özellikle çocuk) grubu."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sürü",
                                "target_lang_sense_clarification": "kalabalık grup (ör. çocuk sürüsü)"
                            },
                            {
                                "target_lang_word": "yığın",
                                "target_lang_sense_clarification": "büyük miktar veya topluluk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df1a7789-c769-396a-9a29-7c8c973b3374",
                    "sense_definition": "A loose collection of granite rocks covering a hillside.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers carefully navigated the dangerous rocky <w>clatter</w> near the top of the hill.",
                            "target_lang_translations": {
                                "tr": "Dağcılar, tepenin zirvesine yakın tehlikeli kayalık <w>döküntüde</w> dikkatlice ilerlediler."
                            }
                        },
                        {
                            "text": "Large boulders formed a steep <w>clatter</w> along the base of the mountain.",
                            "target_lang_translations": {
                                "tr": "Büyük kayalar, dağın eteği boyunca dik bir <w>kaya döküntüsü</w> oluşturuyordu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Used regionally in southwestern England"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir tepe yamacını kaplayan gevşek granit kayalar kümesi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kaya döküntüsü",
                                "target_lang_sense_clarification": "tepedeki gevşek kaya kümesi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}