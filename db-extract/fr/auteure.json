                "senses": [
                    {
                        "sense_id": "505e43da-cab5-38f0-a009-607e6cdbd28b",
                        "entry_id": "193d8c13-a536-3d45-91a1-8930fb1b58f1",
                        "glosses": [
                            "Créatrice d’une œuvre littéraire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b590b80a-63f1-4cc3-8d16-591957465356",
                                "sense_id": "505e43da-cab5-38f0-a009-607e6cdbd28b",
                                "text": "Madame de Flahault est douée d’une haute intelligence, d’une véritable capacité ; si l’on dit femme auteure, nous dirons que madame de Flahault est une femme administateure."
                            },
                            {
                                "example_id": "275809de-4c93-42fc-90e6-ef27b0a62438",
                                "sense_id": "505e43da-cab5-38f0-a009-607e6cdbd28b",
                                "text": "Mercredi, Catherine Kerambellec, auteure jeunesse, membre du Cercle des écrivains (CEL), est venue guider les enfants pour leur apprendre à réaliser un livre accordéon pop-up."
                            },
                            {
                                "example_id": "a2d53d3b-6904-4299-aa72-b3d58a12ee80",
                                "sense_id": "505e43da-cab5-38f0-a009-607e6cdbd28b",
                                "text": "“Le Maine Libre” a retrouvé Gabrielle Grandière, l’auteure de la célèbre chanson enfantine \"Pirouette cacahuète\"."
                            },
                            {
                                "example_id": "6bf848bd-a7e2-4526-9b89-dc226a49c277",
                                "sense_id": "505e43da-cab5-38f0-a009-607e6cdbd28b",
                                "text": "Mais celles et ceux qui restent attachés à « auteure », qu’est-ce qui vous paraît le plus logique entre une « auteure-compositrice » ou une « autrice-compositrice » ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "38f0f0f5-83e0-3c4d-aff3-f429e526b087",
                        "entry_id": "193d8c13-a536-3d45-91a1-8930fb1b58f1",
                        "glosses": [
                            "Femme à l’origine de quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76706d9b-3630-418a-8fef-4413d24af520",
                                "sense_id": "38f0f0f5-83e0-3c4d-aff3-f429e526b087",
                                "text": "L’auteure de la fusillade au siège de YouTube était une femme"
                            }
                        ]
                    }
