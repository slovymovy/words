                ],
                "senses": [
                    {
                        "sense_id": "84eaac0b-7737-378c-8f31-c2f6ea071710",
                        "entry_id": "1d563feb-7d67-319c-b54c-a5e04b69c732",
                        "glosses": [
                            "Surnom méprisant et injurieux."
                        ],
                        "tags": [
                            "offensive",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "a51a10c9-2df6-4695-8c48-8a2cb049dbab",
                                "sense_id": "84eaac0b-7737-378c-8f31-c2f6ea071710",
                                "text": "Dis-donc ducon, fallait t’en apercevoir plus tôt."
                            },
                            {
                                "example_id": "c1f2167f-6018-4bae-b230-0149ee022456",
                                "sense_id": "84eaac0b-7737-378c-8f31-c2f6ea071710",
                                "text": "Merde, ça brûle ! Prends le chiffon, eh, ducon !"
                            },
                            {
                                "example_id": "6afcec37-845a-4a69-86ad-4888d49e800d",
                                "sense_id": "84eaac0b-7737-378c-8f31-c2f6ea071710",
                                "text": "Ducon venait de me quitter après dix ans de vie commune."
                            },
                            {
                                "example_id": "9eecaca2-c766-4a67-a44f-883bef48ec10",
                                "sense_id": "84eaac0b-7737-378c-8f31-c2f6ea071710",
                                "text": "On te demande pas si t’as vu un truc suspect, ducon, on te demande de raconter TOUT ce que t’as vu."
                            },
                            {
                                "example_id": "f667522c-81c1-444a-86f9-97ec60e0fb5d",
                                "sense_id": "84eaac0b-7737-378c-8f31-c2f6ea071710",
                                "text": "En dépit des « ducon », des « je t’emmerde » et d'inélégants doigts d'honneur, Archi arriva au château avec un quart d'heure de retard."
                            },
                            {
                                "example_id": "083b8038-8930-4fa7-989f-abe24afade24",
                                "sense_id": "84eaac0b-7737-378c-8f31-c2f6ea071710",
                                "text": "Tu verras pas le sous-sol, ducon. Pigé ? Ça rentre dans ta tête ? Foutez-moi le camp."
                            }
                        ]
                    }
                ],
