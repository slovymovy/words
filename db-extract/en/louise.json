    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a4f449a1-5be5-3e7c-b6a6-fd0d6835f18e",
                "word": "Louise",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0b2ea2f0-60e1-3e52-8a86-b27cbe3dcd5d",
                        "entry_id": "a4f449a1-5be5-3e7c-b6a6-fd0d6835f18e",
                        "glosses": [
                            "A female given name from French."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d4ec31f-db69-4424-a0f7-6e6995df9ee9",
                                "sense_id": "0b2ea2f0-60e1-3e52-8a86-b27cbe3dcd5d",
                                "text": "Louise, thy stately name sounds in my ear / Like a sea wave, that gathering, hill on hill, / Upon the blue horizon, smooth and still, / Sweeps to the shore"
                            },
                            {
                                "example_id": "a8e2b062-440b-4f2a-9a18-167f101b6559",
                                "sense_id": "0b2ea2f0-60e1-3e52-8a86-b27cbe3dcd5d",
                                "text": "That's what I baptized her. Mary Louise. Everybody else called her just plain Mary, but that wasn't the way I intended it. I intended it Mary Louise. That's a pretty name, isn't it? Mary Louise. Mary is too...plain?"
                            },
                            {
                                "example_id": "082b5f01-b82e-420f-8be1-39ad2877d97d",
                                "sense_id": "0b2ea2f0-60e1-3e52-8a86-b27cbe3dcd5d",
                                "text": "I've always thought I was too large for a soft, musical name like Louise, too untidy."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3809d6b-4a46-3e82-9ba0-a54837a54104",
                        "entry_id": "a4f449a1-5be5-3e7c-b6a6-fd0d6835f18e",
                        "glosses": [
                            "A municipality of Manitoba, Canada."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48eb7658-e993-449a-ac08-23a4e7ad464c",
                        "source_entry_id": "a4f449a1-5be5-3e7c-b6a6-fd0d6835f18e",
                        "source_sense_description": "feminine form of Louis",
                        "target_lang_word": "Louise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Louise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4320ab9d-95f6-3e55-8330-5210d7301613",
                                        "entry_id": "bd6c6546-177a-321f-b00d-04e471c10c7d",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99d82085-12c9-4975-a9f5-4a8b833b2f93",
                                                "sense_id": "4320ab9d-95f6-3e55-8330-5210d7301613",
                                                "text": "Je suis accoutumé à Louise, se disait-il, elle sait toutes mes affaires ; je serais libre de me marier demain que je ne trouverais pas à la remplacer."
                                            },
                                            {
                                                "example_id": "f4c2b966-c595-40ab-80a1-bcfd16fe2c54",
                                                "sense_id": "4320ab9d-95f6-3e55-8330-5210d7301613",
                                                "text": "Le cuisinier courtisait Louise, la femme de chambre de la comtesse Steinbock."
                                            },
                                            {
                                                "example_id": "d0be0dff-c710-4b49-834d-8505f4f13c73",
                                                "sense_id": "4320ab9d-95f6-3e55-8330-5210d7301613",
                                                "text": "– Est-ce que je peux savoir le nom de ma protectrice ?\n– Louisette… Louise », corrigea-t-elle dignement."
                                            },
                                            {
                                                "example_id": "e2207757-26cf-4fdc-a2d2-67a0f0cedb20",
                                                "sense_id": "4320ab9d-95f6-3e55-8330-5210d7301613",
                                                "text": "Louise avec tes cheveux si blonds. Louise tu ensorcelles tous les garçons. Mon cœur a besoin de toi. Louise je suis à toi."
                                            },
                                            {
                                                "example_id": "df7d7049-6fe7-48fa-a2cb-e39773a62518",
                                                "sense_id": "4320ab9d-95f6-3e55-8330-5210d7301613",
                                                "text": "Une adolescente haïtienne (Wislanda Louimat) dont le grand-père fut « zombifié » fait découvrir cette funeste tradition à une camarade de pensionnat (Louise Labeque) dans ce film plus envoûtant qu’horrifique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
