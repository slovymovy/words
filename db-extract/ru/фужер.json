                "senses": [
                    {
                        "sense_id": "9fe6ac21-958b-3403-9e5b-166fe3ec84bb",
                        "entry_id": "b31fc130-28ee-30c3-9dca-2b1766ffdcc2",
                        "glosses": [
                            "тонкостенный узкий бокал на высокой ножке"
                        ],
                        "tags": [],
