                "senses": [
                    {
                        "sense_id": "97f7ab1a-b03e-3cf3-864e-3a8ab0d83cc6",
                        "entry_id": "fe9a4359-2ec1-3d4b-8088-11f01c4bf26f",
                        "glosses": [
                            "central vowel"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "76f10837-ed7e-4330-820c-4efdcefcd515",
                                "sense_id": "97f7ab1a-b03e-3cf3-864e-3a8ab0d83cc6",
                                "text": "Die Zentralvokale der deutschen Sprache sind stets unbetont. [...] Das Deutsche kennt zwei unbetonte Zentralvokale:\n 1. den (mittelhohen bis hohen) Zentralvokal [ə] [...]\n 2. den niedrigen Zentralvokal [ɐ] [...]"
                            },
                            {
                                "example_id": "a9f0d131-a4a9-4c56-a6e9-b0fb00f7476a",
                                "sense_id": "97f7ab1a-b03e-3cf3-864e-3a8ab0d83cc6",
                                "text": "Bei dem Namen Alexander, der auf unbetonte Silbe mit Schwa + r auslautet, wurde der tiefe Zentralvokal [ɐ] als segmentale Anpassung der zugrundeliegenden Form angesetzt."
                            },
                            {
                                "example_id": "c12aa248-60d0-4448-bca0-215ffd2a9d0f",
                                "sense_id": "97f7ab1a-b03e-3cf3-864e-3a8ab0d83cc6",
                                "text": "Wortartenspezifische Allophone für Flexionssuffixe mit Vollvokal wären höchst untypisch für das Deutsche, dessen Flexionsaffixe alle entweder nicht-silbisch sind oder die Zentralvokale [ə, ɐ] als Silbenkern besitzen."
                            }
                        ]
                    }
                ],
