                        "assiéger l'entrée"
                    ]
                },
                {
                    "sense_id": "7809ed3b-d4d1-391f-a293-05b0388f9abb",
                    "sense_definition": "Harceler ou tourmenter de façon continue par des sollicitations, des reproches ou des pensées obsédantes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les journalistes n'ont pas hésité à <w>assiéger</w> le ministre de questions insistantes."
                        },
                        {
                            "text": "Des souvenirs douloureux continuent d'<w>assiéger</w> son esprit après cet événement tragique."
