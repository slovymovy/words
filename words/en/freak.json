{
    "word_family": [
        "freakish",
        "freaky",
        "freakiness",
        "freakishly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5ec975cd-64a5-3323-a236-7465dd6d0588",
                    "sense_definition": "Someone or something that is markedly unusual, abnormal, or unpredictable.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "unusual_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two-headed snake was considered a <w>freak</w> of nature by the scientists.",
                            "target_lang_translations": {
                                "ru": "Ученые считали двуголовую змею <w>аномалией</w> природы.",
                                "zh": "科学家们认为这条双头蛇是自然界的<w>畸形</w>。"
                            }
                        },
                        {
                            "text": "Snow in the middle of summer is a weather <w>freak</w> that rarely happens.",
                            "target_lang_translations": {
                                "ru": "Снег посреди лета — это погодная <w>аномалия</w>, которая случается редко.",
                                "zh": "盛夏下雪是一种罕见的<w>异常</w>天气现象。"
                            }
                        }
                    ],
                    "synonyms": [
                        "anomaly",
                        "oddity",
                        "rarity",
                        "aberration"
                    ],
                    "common_phrases": [
                        "freak of nature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, животное или явление, которое является крайне необычным, ненормальным или непредсказуемым; уродство природы.",
                        "zh": "指极不寻常、反常或不可预测的人、事物或现象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аномалия",
                                "target_lang_sense_clarification": "отклонение от нормы, часто о природных явлениях"
                            },
                            {
                                "target_lang_word": "урод",
                                "target_lang_sense_clarification": "существо с физическими недостатками (грубо)"
                            },
                            {
                                "target_lang_word": "монстр",
                                "target_lang_sense_clarification": "чудовище, пугающее существо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "畸形",
                                "target_lang_sense_clarification": "指生物体发育异常或反常的现象"
                            },
                            {
                                "target_lang_word": "异类",
                                "target_lang_sense_clarification": "指与众不同或不寻常的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3f7aef6-9655-3c37-88bc-ccd1b172be49",
                    "sense_definition": "An enthusiast or person who has an obsession with or extreme knowledge of a specific subject.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "enthusiast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My brother is a total computer <w>freak</w> who spends all his time coding.",
                            "target_lang_translations": {
                                "ru": "Мой брат — полный компьютерный <w>фанат</w>, который проводит все время за программированием.",
                                "zh": "我哥哥是个电脑<w>迷</w>，整天都花在写代码上。"
                            }
                        },
                        {
                            "text": "She is a health <w>freak</w> who exercises daily and eats only organic food.",
                            "target_lang_translations": {
                                "ru": "Она <w>помешана</w> на здоровье: тренируется каждый день и ест только органическую еду.",
                                "zh": "她是个健康<w>狂</w>，每天锻炼，只吃有机食品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enthusiast",
                        "fanatic",
                        "buff",
                        "geek"
                    ],
                    "common_phrases": [
                        "control freak",
                        "neat freak",
                        "health freak"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Энтузиаст или человек, одержимый определенной темой или обладающий глубокими знаниями в ней.",
                        "zh": "对特定事物有狂热爱好或极深了解的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фанат",
                                "target_lang_sense_clarification": "страстный поклонник чего-либо"
                            },
                            {
                                "target_lang_word": "помешанный",
                                "target_lang_sense_clarification": "человек, одержимый какой-то идеей или занятием"
                            },
                            {
                                "target_lang_word": "гик",
                                "target_lang_sense_clarification": "увлеченный технологиями или поп-культурой человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迷",
                                "target_lang_sense_clarification": "指对某事极其热衷的人"
                            },
                            {
                                "target_lang_word": "狂热爱好者",
                                "target_lang_sense_clarification": "指对某领域有极高热情的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad2ba898-9176-3376-9046-5b5bce2225a8",
                    "sense_definition": "A person who is extremely abnormal in appearance, behavior, or social identity; an oddball.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_outcast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt like a <w>freak</w> at school because he dressed differently from everyone else.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>изгоем</w> в школе, потому что одевался не так, как все.",
                                "zh": "他在学校里感觉自己像个<w>怪人</w>，因为他的穿着和别人不一样。"
                            }
                        },
                        {
                            "text": "People used to stare at him like he was a <w>freak</w> just because of his tattoos.",
                            "target_lang_translations": {
                                "ru": "Люди пялились на него как на <w>фрика</w> только из-за его татуировок.",
                                "zh": "人们过去常常盯着他看，就好像他是个<w>异类</w>，仅仅是因为他有纹身。"
                            }
                        }
                    ],
                    "synonyms": [
                        "weirdo",
                        "oddball",
                        "misfit",
                        "outcast"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often pejorative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который выглядит или ведет себя крайне странно и отличается от общепринятых норм; чудак.",
                        "zh": "在外貌、行为或社会身份上极其怪异的人；怪人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фрик",
                                "target_lang_sense_clarification": "человек с вызывающей внешностью или поведением"
                            },
                            {
                                "target_lang_word": "чудак",
                                "target_lang_sense_clarification": "странный, эксцентричный человек"
                            },
                            {
                                "target_lang_word": "изгой",
                                "target_lang_sense_clarification": "отверженный обществом человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "怪人",
                                "target_lang_sense_clarification": "指行为举止古怪的人"
                            },
                            {
                                "target_lang_word": "异类",
                                "target_lang_sense_clarification": "指被社会视为格格不入的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "339efd05-562e-3937-8560-1cca50856c64",
                    "sense_definition": "A euphemistic form of the word 'fuck', used to express anger, surprise, or lack of concern.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "euphemism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I really do not give a <w>freak</w> about what they think of me.",
                            "target_lang_translations": {
                                "ru": "Мне реально <w>пофиг</w>, что они обо мне думают.",
                                "zh": "我根本不在乎他们怎么看我。"
                            }
                        },
                        {
                            "text": "What the <w>freak</w> is going on in this room?",
                            "target_lang_translations": {
                                "ru": "Что за <w>фигня</w> происходит в этой комнате?",
                                "zh": "这房间里到底在搞什么<w>鬼</w>？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "give a freak",
                        "what the freak"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "euphemistic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Эвфемизм слова 'fuck', используемый для выражения гнева, удивления или безразличия.",
                        "zh": "fuck的委婉语，用于表达愤怒、惊讶或漠不关心。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фигня",
                                "target_lang_sense_clarification": "используется в выражениях удивления или пренебрежения"
                            },
                            {
                                "target_lang_word": "чёрт",
                                "target_lang_sense_clarification": "восклицание досады или удивления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鬼",
                                "target_lang_sense_clarification": "用于疑问句中表示惊讶或不耐烦"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0397ebdd-7a43-3006-8c45-2d9c12414f75",
                    "sense_definition": "A very sexually perverse or adventurous individual.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sexual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a reputation for being a bit of a <w>freak</w> in his romantic life.",
                            "target_lang_translations": {
                                "ru": "У него репутация немного <w>извращенца</w> в романтической жизни.",
                                "zh": "他在感情生活中以有点<w>变态</w>而闻名。"
                            }
                        },
                        {
                            "text": "The lyrics of the song describe her as a <w>freak</w> in the sheets.",
                            "target_lang_translations": {
                                "ru": "Текст песни описывает её как <w>развратницу</w> в постели.",
                                "zh": "歌词将她描述为一个在床上非常<w>狂野</w>的人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pervert"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек с очень смелыми или извращенными сексуальными предпочтениями.",
                        "zh": "在性方面非常大胆或有特殊癖好的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извращенец",
                                "target_lang_sense_clarification": "человек с отклонениями в половой сфере"
                            },
                            {
                                "target_lang_word": "маньяк",
                                "target_lang_sense_clarification": "разг. человек с сильной сексуальной одержимостью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变态",
                                "target_lang_sense_clarification": "指性行为或心理有异常的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cb90a2c-a378-36c7-ba4d-3cdc282afd3d",
                    "sense_definition": "A sudden change of mind or a capricious idea.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "whim",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By some strange <w>freak</w> of fate, we met again ten years later.",
                            "target_lang_translations": {
                                "ru": "По какой-то странной <w>причуде</w> судьбы мы встретились снова десять лет спустя.",
                                "zh": "由于某种奇怪的命运<w>安排</w>，十年后我们又见面了。"
                            }
                        },
                        {
                            "text": "He acted on a sudden <w>freak</w> and decided to paint the entire room red.",
                            "target_lang_translations": {
                                "ru": "Он поддался внезапному <w>капризу</w> и решил покрасить всю комнату в красный.",
                                "zh": "他<w>心血来潮</w>，决定把整个房间漆成红色。"
                            }
                        }
                    ],
                    "synonyms": [
                        "whim",
                        "caprice",
                        "vagary"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапная перемена настроения или капризная идея.",
                        "zh": "突如其来的念头或任性的想法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причуда",
                                "target_lang_sense_clarification": "странное, неожиданное желание или явление"
                            },
                            {
                                "target_lang_word": "каприз",
                                "target_lang_sense_clarification": "внезапное, необоснованное желание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "突发奇想",
                                "target_lang_sense_clarification": "指突然产生的奇怪念头"
                            },
                            {
                                "target_lang_word": "心血来潮",
                                "target_lang_sense_clarification": "指因一时的冲动而产生想法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dba5eae-6a07-3269-b393-dde5c5074ccc",
                    "sense_definition": "A hippie or counterculture member.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "counterculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The park was filled with long-haired <w>freaks</w> playing guitars in the sixties.",
                            "target_lang_translations": {
                                "ru": "В шестидесятые парк был полон длинноволосых <w>неформалов</w>, играющих на гитарах.",
                                "zh": "六十年代的公园里到处都是留着长发的<w>嬉皮士</w>在弹吉他。"
                            }
                        },
                        {
                            "text": "My uncle was a bit of a <w>freak</w> back in the day and lived in a commune.",
                            "target_lang_translations": {
                                "ru": "Мой дядя был немного <w>хиппи</w> в свое время и жил в коммуне.",
                                "zh": "我叔叔当年有点<w>反叛</w>，还住过公社。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hippie"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "1960s/70s slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Хиппи или представитель контркультуры.",
                        "zh": "嬉皮士或反主流文化成员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неформал",
                                "target_lang_sense_clarification": "представитель неформальной субкультуры"
                            },
                            {
                                "target_lang_word": "хиппи",
                                "target_lang_sense_clarification": "участник движения хиппи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嬉皮士",
                                "target_lang_sense_clarification": "指反主流文化的群体成员"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ef560c2f-b3ec-34d0-8d84-f78146b1123d",
                    "sense_definition": "To react extremely or irrationally, usually under distress, excitement, or drug influence.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My parents are going to <w>freak</w> out when they see the dent in the car.",
                            "target_lang_translations": {
                                "ru": "Мои родители <w>взбесятся</w>, когда увидят вмятину на машине.",
                                "zh": "我父母看到车上的凹痕一定会<w>抓狂</w>的。"
                            }
                        },
                        {
                            "text": "She completely <w>freaked</w> when she saw the large spider on her bed.",
                            "target_lang_translations": {
                                "ru": "Она полностью <w>запаниковала</w>, когда увидела огромного паука на своей кровати.",
                                "zh": "当她看到床上那只大蜘蛛时，彻底<w>崩溃</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "panic",
                        "lose it"
                    ],
                    "antonyms": [
                        "calm down"
                    ],
                    "common_phrases": [
                        "freak out"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Остро или иррационально реагировать, обычно в состоянии стресса или возбуждения; беситься.",
                        "zh": "指在压力、兴奋或药物影响下，表现出极端或非理性的反应。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "психовать",
                                "target_lang_sense_clarification": "нервничать, выходить из себя"
                            },
                            {
                                "target_lang_word": "сходить с ума",
                                "target_lang_sense_clarification": "терять рассудок от эмоций"
                            },
                            {
                                "target_lang_word": "паниковать",
                                "target_lang_sense_clarification": "впадать в панику"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抓狂",
                                "target_lang_sense_clarification": "指因情绪失控而表现出极度烦躁或崩溃"
                            },
                            {
                                "target_lang_word": "崩溃",
                                "target_lang_sense_clarification": "指情绪彻底失控"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25dde872-1df1-3ef8-ae67-a968cf601120",
                    "sense_definition": "To streak or mark with various colors.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "visual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The setting sun <w>freaked</w> the sky with shades of purple and orange.",
                            "target_lang_translations": {
                                "ru": "Заходящее солнце <w>раскрасило</w> небо оттенками фиолетового и оранжевого.",
                                "zh": "落日将天空<w>点缀</w>上了紫色和橙色的光影。"
                            }
                        },
                        {
                            "text": "The artist <w>freaked</w> the canvas with wild splashes of paint.",
                            "target_lang_translations": {
                                "ru": "Художник <w>испещрил</w> холст дикими брызгами краски.",
                                "zh": "艺术家用狂野的颜料泼溅<w>装饰</w>了画布。"
                            }
                        }
                    ],
                    "synonyms": [
                        "streak",
                        "variegate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Испещрять или отмечать различными цветами.",
                        "zh": "用各种颜色涂抹或标记。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испещрять",
                                "target_lang_sense_clarification": "покрывать пестрыми пятнами или узорами"
                            },
                            {
                                "target_lang_word": "расписывать",
                                "target_lang_sense_clarification": "украшать узорами или красками"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "点缀",
                                "target_lang_sense_clarification": "指用色彩装饰或覆盖"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6050df7b-4774-34d5-8862-729e9c7c275b",
                    "sense_definition": "Strange, weird, or unexpected.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "unusual_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team lost the game due to a <w>freak</w> goal in the final minute.",
                            "target_lang_translations": {
                                "ru": "Команда проиграла игру из-за <w>случайного</w> гола на последней минуте.",
                                "zh": "球队因为最后一分钟一个<w>离奇的</w>进球输掉了比赛。"
                            }
