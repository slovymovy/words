                "senses": [
                    {
                        "sense_id": "c15d2ff4-215d-39a0-8b65-ef19378305a5",
                        "entry_id": "0f05a8c7-76d0-3104-8d69-1fb8ec0ab058",
                        "glosses": [
                            "Rohr aus Messing"
