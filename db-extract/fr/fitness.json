        "fr-extract.jsonl": [
            {
                "entry_id": "8018aeb7-b868-31e2-b323-e86e90f5799f",
                "word": "fitness",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "17fdb108-bb13-3b31-91a8-3fbc0ccf76b3",
                        "entry_id": "8018aeb7-b868-31e2-b323-e86e90f5799f",
                        "glosses": [
                            "Entrainement physique ; remise en forme."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "b51d42bc-c9bd-45e1-ab55-75f30caca8f9",
                                "sense_id": "17fdb108-bb13-3b31-91a8-3fbc0ccf76b3",
                                "text": "Le centre est ainsi équipé d’une salle de fitness qui couvre pas moins de 524m² (la plus grande jamais vue en Europe par Philippe Collin), de différents espaces consacrés au repos des joueurs pour un total de 145m², d’un espace balnéo pour la récupération et la revalidation, d’une salle de kiné et de médecine."
                            },
                            {
                                "example_id": "86b14718-8463-46ae-aa5e-b06883dd556b",
                                "sense_id": "17fdb108-bb13-3b31-91a8-3fbc0ccf76b3",
                                "text": "Découvrez-la en pleine action dans une vidéo qu’elle a posté sur son site internet et où on la voit au fitness et à la piscine."
                            },
                            {
                                "example_id": "aef52fd9-8e5e-43d9-bea6-cee9e14a1985",
                                "sense_id": "17fdb108-bb13-3b31-91a8-3fbc0ccf76b3",
                                "text": "Des échafaudages à n’en plus finir ont été montés dans le but d’élever un château entouré de douves et doté de multiples équipements, notamment huit chambres, une vaste salle de réception, des salons, deux piscines avec des jacuzzis et une salle de fitness ou encore un sauna."
                            },
                            {
                                "example_id": "3e4f9014-da1d-49f8-ae1b-674bee2590d4",
                                "sense_id": "17fdb108-bb13-3b31-91a8-3fbc0ccf76b3",
                                "text": "Sandrine Martin propose des activités de sport chorégraphié assez intenses, comme la Zumba, le kuduro fit, le strong ou encore le LIA (Low impact aerobic) - sport de fitness en salle s’inspirant des cours d’aérobic - et des activités de renforcement musculaire, toujours en musique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a40dcd91-dae7-4c89-aa38-10929ece7239",
                        "source_entry_id": "8018aeb7-b868-31e2-b323-e86e90f5799f",
                        "source_sense_id": "17fdb108-bb13-3b31-91a8-3fbc0ccf76b3",
                        "target_lang_word": "fitness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fitness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19935bc1-6976-3091-9fcc-f8c573874ddb",
                                        "entry_id": "6836f50b-bfc4-32c5-af29-ccb6db02e497",
                                        "glosses": [
                                            "The condition of being fit, suitable or appropriate."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "441da393-b449-4519-bb0b-c1f87574160e",
                                                "sense_id": "19935bc1-6976-3091-9fcc-f8c573874ddb",
                                                "text": "Having introduced my two characters separately, let me present them together. Why not? He, young, wealthy, honorable; she also young, also intelligent — why not bring them together? There is an eternal fitness in all things, and nothing more so than in the case of man and woman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7576c05f-c697-3b82-a5f0-603ebccbb5ee",
                                        "entry_id": "6836f50b-bfc4-32c5-af29-ccb6db02e497",
                                        "glosses": [
                                            "The cultivation of an attractive and/or healthy physique."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c9f71e3-6fd5-4ab0-b576-99fc8595b80e",
                                                "sense_id": "7576c05f-c697-3b82-a5f0-603ebccbb5ee",
                                                "text": "Carroll has been edging slowly towards full fitness after his expensive arrival from Newcastle United and his partnership with £23m Luis Suarez showed rich promise as Liverpool controlled affairs from start to finish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "266a5e2b-5061-3365-a217-980ed92d0224",
                                        "entry_id": "6836f50b-bfc4-32c5-af29-ccb6db02e497",
                                        "glosses": [
                                            "An organism's or species' degree of success in finding a mate and producing offspring."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24748e65-dc0a-311f-be34-852599d35aa1",
                                        "entry_id": "6836f50b-bfc4-32c5-af29-ccb6db02e497",
                                        "glosses": [
                                            "The condition of being attractive, fanciable or beautiful."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
