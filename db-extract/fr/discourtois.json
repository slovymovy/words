                    {
                        "sense_id": "ae0471c6-bb13-3663-a02a-60237fe0938d",
                        "entry_id": "daa6ac90-0ef9-3a2e-a275-69aa19b262e7",
                        "glosses": [
                            "Des manières discourtoises."
