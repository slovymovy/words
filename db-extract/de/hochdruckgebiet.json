                        "entry_id": "66266cee-276d-3740-96e5-6c47cd6e358a",
                        "glosses": [
                            "Anticyclone, zone de haute pression."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2ad606e-6729-4f94-913e-d5d37e6dbff2",
                                "sense_id": "b26d16e2-59f1-349e-acc4-7e41478fb28c",
                                "text": "Schon seit mehreren Tagen sorgt das Hochdruckgebiet für große Hitze, die in Verbindung mit einer verhältnismäßig hohen Luftfeuchtigkeit für schwer erträgliche Temperaturen sorgt."
                            }
                        ]
