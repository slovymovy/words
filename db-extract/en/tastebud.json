                                        "entry_id": "90d956eb-9c76-3708-8fb1-7e477c5d128f",
                                        "glosses": [
                                            "Certaines petites saillies coniques formées, vers la surface de la peau ou des membranes muqueuses, par des ramifications nerveuses et vasculaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3381cd7-ffdb-4bfa-b467-3a6545717e17",
                                                "sense_id": "55faad35-3600-3021-9007-4bac14ca0399",
                                                "text": "Les papilles de la langue."
                                            },
                                            {
                                                "example_id": "a02679d4-47d3-429c-a6ee-448c686a5a0d",
                                                "sense_id": "55faad35-3600-3021-9007-4bac14ca0399",
                                                "text": "Les papilles des mamelles."
                                            },
                                            {
                                                "example_id": "0f11ecdb-7742-4c0b-ae8c-a24254740ab2",
                                                "sense_id": "55faad35-3600-3021-9007-4bac14ca0399",
                                                "text": "La papille optique est la saillie du nerf optique sur la rétine."
                                            },
                                            {
                                                "example_id": "0e782d95-eb06-41f0-9b4e-b1cf92b114dd",
                                                "sense_id": "55faad35-3600-3021-9007-4bac14ca0399",
                                                "text": "On distinguait parfaitement leur gorge pelée tendue sous l’effort de leurs cris, leur crête cartilagineuse, garnie de papilles violettes."
                                            },
                                            {
                                                "example_id": "8f20e8eb-fe9e-4397-af5e-2acbdec6cb4c",
                                                "sense_id": "55faad35-3600-3021-9007-4bac14ca0399",
                                                "text": "Le plaisir des yeux précède celui des papilles."
                                            }
                                        ]
                                    },
