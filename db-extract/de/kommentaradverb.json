                ],
                "senses": [
                    {
                        "sense_id": "29e0ccd1-7796-3fb6-a1cd-a5560044995e",
                        "entry_id": "e99ba8c8-2c10-3a1a-b094-eaf74902ee5e",
                        "glosses": [
                            "ein Adverb, das einen Kommentar zur Aussage des Satzes abgibt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5f17510-248c-4200-a917-462418c654f7",
                                "sense_id": "29e0ccd1-7796-3fb6-a1cd-a5560044995e",
                                "text": "Kommentaradverbien sind Wörter wie \"leider\", \"natürlich\", \"unzulässigerweise\"."
                            },
                            {
                                "example_id": "0b6f5f4a-aa0e-468d-9ced-b0face37aa88",
                                "sense_id": "29e0ccd1-7796-3fb6-a1cd-a5560044995e",
                                "text": "Kommentaradverbien lassen die Stellungnahme des Sprechers/Schreibers zum Satzinhalt erkennen."
                            },
                            {
                                "example_id": "79eefc5c-7f10-401e-a623-4fde7461ee2f",
                                "sense_id": "29e0ccd1-7796-3fb6-a1cd-a5560044995e",
                                "text": "„Kommentaradverbien verhalten sich syntaktisch wie Adverbien, entsprechen aber funktional, zumindest teilweise, eher Abtönungspartikeln, indem sie eine Bewertung bzw. eine Stellungnahme, den »Kommentar« des Sprechers zum gesamten Sachverhalt ausdrücken können (leider, bedauerlicherweise, glücklicherweise).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
