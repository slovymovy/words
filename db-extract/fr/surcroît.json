                ],
                "senses": [
                    {
                        "sense_id": "67f1bb77-3e17-37d1-9e84-ca5e5c8a58cb",
                        "entry_id": "50665710-dc5e-361d-af80-bcae460eae9e",
                        "glosses": [
                            "Augmentation, accroissement ; ce qui est ajouté à quelque chose et qui en accroît le nombre, la quantité, la force."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eb94268-556f-4ad2-ad0a-4f94fc82fda7",
                                "sense_id": "67f1bb77-3e17-37d1-9e84-ca5e5c8a58cb",
                                "text": "Pour surcroît de misères, une maladie épidémique, d’une nature dangereuse, s’était répandue dans le pays, et,[…], enlevait un grand nombre d’habitants, …."
                            },
                            {
                                "example_id": "589ff142-8f49-4636-9265-77e28379c3a7",
                                "sense_id": "67f1bb77-3e17-37d1-9e84-ca5e5c8a58cb",
                                "text": "Cette exclamation de détresse, loin d’émouvoir les compassions, fut un surcroît d’amusement au bon populaire parisien qui entourait l’échelle."
                            },
                            {
                                "example_id": "72d6aa13-3676-481e-a04d-97789357b2ad",
                                "sense_id": "67f1bb77-3e17-37d1-9e84-ca5e5c8a58cb",
                                "text": "Ces sortes d’affaires s’instruisent sans huissiers ni défenseurs. Le ministère de ceux-ci est déclaré n’être pas obligatoire, et le surcroît de frais qu’il eût occasionné être irrépétible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9541504-f02d-4c01-b2eb-d4d48e390f2a",
                        "source_entry_id": "50665710-dc5e-361d-af80-bcae460eae9e",
                        "source_sense_id": "67f1bb77-3e17-37d1-9e84-ca5e5c8a58cb",
                        "target_lang_word": "Zuwachs",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuwachs",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7859afb8-37b8-36c6-ab65-5bc8dcbb3bce",
                                        "entry_id": "38091536-04a7-3f18-9eeb-e331b5385a76",
                                        "glosses": [
                                            "der Anstieg in Größe oder an Wert von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6f054d-f5bf-4883-b5aa-07fe69a4197d",
                                                "sense_id": "7859afb8-37b8-36c6-ab65-5bc8dcbb3bce",
                                                "text": "„Zuwächse erwartet das Unternehmen aus Hannover allerdings von den Märkten in Asien und Osteuropa.“"
                                            },
                                            {
                                                "example_id": "40a2cbaa-7e15-4a43-a49a-beeccbb96d1d",
                                                "sense_id": "7859afb8-37b8-36c6-ab65-5bc8dcbb3bce",
                                                "text": "„Der Ifo-Geschäftsklimaindex ist im Januar zum nunmehr zehnten Mal in Folge gestiegen. Experten hatten mit einem schwächeren Zuwachs gerechnet.“"
                                            },
                                            {
                                                "example_id": "74a6d783-1ccf-41a6-8faa-251b7d7a9f6e",
                                                "sense_id": "7859afb8-37b8-36c6-ab65-5bc8dcbb3bce",
                                                "text": "„So entfällt mehr als ein Drittel des Zuwachses auf die Q-Modelle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56ec6b05-606e-3885-a66d-69b3c9d6ef07",
                                        "entry_id": "38091536-04a7-3f18-9eeb-e331b5385a76",
                                        "glosses": [
                                            "(künftige) Geburt eines Kindes, Nachwuchs"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09eba93a-1d1d-40fc-b1fd-710690c690e7",
                                                "sense_id": "56ec6b05-606e-3885-a66d-69b3c9d6ef07",
                                                "text": "Haben Deine Schäferhunde schon wieder Zuwachs bekommen?"
                                            },
                                            {
                                                "example_id": "69a03d5e-df17-49cb-930c-ee2cc22079b3",
                                                "sense_id": "56ec6b05-606e-3885-a66d-69b3c9d6ef07",
                                                "text": "„Wie der Ernst denn beabsichtige, seine Familie zu ernähren, nun, da Zuwachs erwartet werde?, fragte Papa, als Ida ihm die Neuigkeiten überbrachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "21760604-2126-3611-a2e5-591b0d76eb13",
                                        "entry_id": "38091536-04a7-3f18-9eeb-e331b5385a76",
                                        "glosses": [
                                            "die Vergrößerung des Bestandes durch das Wachstum der Bäume"
                                        ],
                                        "tags": [
                                            "Forstwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f671b80-f797-4e29-bd5a-24e4fc5ca23a",
                                                "sense_id": "21760604-2126-3611-a2e5-591b0d76eb13",
                                                "text": "Unsere Baumschule hat dieses Jahr einen guten Zuwachs."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0d3b8ad-8f34-43e5-8063-2c89c14ad480",
                        "source_entry_id": "50665710-dc5e-361d-af80-bcae460eae9e",
                        "source_sense_id": "67f1bb77-3e17-37d1-9e84-ca5e5c8a58cb",
