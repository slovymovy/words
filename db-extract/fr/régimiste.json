                        "glosses": [
                            "Personne qui soutient le régime politique en place, quitte à interpréter les faits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "435cdcdc-9183-4179-99f6-4b6ab704457a",
                                "sense_id": "c016e279-d597-345a-9803-b44bb57bb8dd",
                                "text": "Les régimistes sont toujours majoritaires, donc ils font l’opinion. Verbeux et ardents, ils volent au secours des victoires acquises par d’autres."
                            },
                            {
                                "example_id": "6461f1ae-8de2-484f-aced-e588913f01b2",
                                "sense_id": "c016e279-d597-345a-9803-b44bb57bb8dd",
                                "text": "« Oui à votre âge il faut être républicain… À mon âge, mon jeune ami il faut être régimiste. Hier royaliste, aujourd’hui républicain demain… » Il se tut et regarda autour de lui comme s’il craignait d’être écouté."
                            }
                        ]
                    }
