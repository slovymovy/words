                                        "entry_id": "980e12a6-b76a-305c-94cb-985a309898df",
                                        "glosses": [
                                            "Eintopfgericht mit kleinen Fleischstücken, die kräftig (insbesondere mit Paprika) gewürzt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dc9fbd0-0ca9-4522-897a-8f717cc2cffa",
                                                "sense_id": "8de70be6-9e78-34d4-a6cd-7ac5e2f76c97",
                                                "text": "Man sagt, dass Gulasch am besten schmeckt, wenn es mehrmals aufgewärmt wird."
                                            },
                                            {
                                                "example_id": "6dc15c60-7a10-4004-93ef-1a7f06c68832",
                                                "sense_id": "8de70be6-9e78-34d4-a6cd-7ac5e2f76c97",
                                                "text": "„Wodka schmeckte wie das Leben selbst nach dem Szegediner Gulasch der Köchin Rosa.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ca8afc2-e37b-43d7-93f9-0d3fc49879ba",
                        "source_entry_id": "d9745a96-1dd0-321b-a3c6-c4ef0061a0dc",
                        "source_sense_id": "96771b04-e217-30ba-8799-0ea59dc63e5a",
                        "target_lang_word": "гуляш",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гуляш",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dad3d731-d769-35f3-9bf3-5ead5825d9cd",
                                        "entry_id": "462af944-8867-3307-97d9-6b5a4d1ffe0f",
                                        "glosses": [
                                            "кулин. кушанье, приготовленное из кусочков мяса, ту́шенных в соусе с пряностями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f867ed6b-5161-4495-920c-0729edcbcbf9",
                                                "sense_id": "dad3d731-d769-35f3-9bf3-5ead5825d9cd",
                                                "text": "Наконец мы добрались до ресторана и заказали себе гуляш и масляш. Первое — какое-то национальное мясное кушанье пополам с красным перцем, а второе — приторное венгерское вино."
                                            },
                                            {
                                                "example_id": "a535a06c-226f-4c90-912b-047fa4446555",
                                                "sense_id": "dad3d731-d769-35f3-9bf3-5ead5825d9cd",
                                                "text": "Гуляш подать с жареным или отварным картофелем, посыпав мелко нарезанной зеленью петрушки или укропом."
                                            },
                                            {
                                                "example_id": "94cb7001-1a63-4033-8d2d-c66b73551e00",
                                                "sense_id": "dad3d731-d769-35f3-9bf3-5ead5825d9cd",
                                                "text": "Женщины деловито едят гуляш из телятины."
                                            },
                                            {
                                                "example_id": "9809e0f4-3fe0-4789-932e-279af7ed0dbe",
                                                "sense_id": "dad3d731-d769-35f3-9bf3-5ead5825d9cd",
                                                "text": ".. мы возвратились из столовой, захватив с собой в котелке гречневую кашу с гуляшом на ужин."
                                            }
                                        ]
                                    }
                                ]
                            },
