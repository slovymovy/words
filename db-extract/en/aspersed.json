                        "examples": [
                            {
                                "example_id": "ec41077b-b15b-4644-b8e6-453aa40abe04",
                                "sense_id": "7f803f0d-52b3-316d-be40-d4a681c525ea",
                                "text": "Coat of arms in the left-hand bottom corner, a lion or rampant in a field gules, aspersed with billets or. Purchased in Flanders from the subject's descendant, who would not part with the picture until he had cut out the coat[…]"
                            },
                            {
                                "example_id": "08ccd243-1213-4772-81ef-4a739c159c4e",
                                "sense_id": "7f803f0d-52b3-316d-be40-d4a681c525ea",
                                "text": "The arms of the Counts-Dukes of Benavente have a shield quarterly, or a three bands gules and sinople a five escallops argent aspersed, and bordure compony with the arms of Castile and León."
                            }
                        ]
                    }
