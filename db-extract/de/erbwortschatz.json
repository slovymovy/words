                "senses": [
                    {
                        "sense_id": "7d2e5a46-17b1-32f9-b258-314d17a74fc1",
                        "entry_id": "eaef6bec-1915-3db8-bd97-ec9fd289fe2f",
                        "glosses": [
                            "der Teil des Wortschatzes, der aus der Geschichte einer bestimmten Sprache stammt und nicht aus anderen Sprachen entlehnt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "716259b0-f109-4b75-b718-a9113d4bc748",
                                "sense_id": "7d2e5a46-17b1-32f9-b258-314d17a74fc1",
                                "text": "„Der semitische Erbwortschatz des Aramäischen ist zu einem großen Teil bis ins Lexikon der modernen Sprachvarianten erhalten geblieben.“"
                            },
                            {
                                "example_id": "bd9506f9-5bc0-4c8b-bfd8-ddcf8fbcd57b",
                                "sense_id": "7d2e5a46-17b1-32f9-b258-314d17a74fc1",
                                "text": "„Der althochdeutsche Erbwortschatz zeigt Germanisch im Aussterben…oder in der Umschichtung im Hinblick auf eine neue christlich erfüllte Terminologie…oder auf die Wissenschaftsterminologie der septem artes liberales…“"
                            },
                            {
                                "example_id": "87dbb0bf-bddd-4df2-b50e-7f91ff41bb45",
                                "sense_id": "7d2e5a46-17b1-32f9-b258-314d17a74fc1",
                                "text": "„Im Mittelpunkt des germanischen Erbwortschatzes steht ein System von sogenannten starken Verben, die wir aus heutiger Sicht unregelmäßige Verben nennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
