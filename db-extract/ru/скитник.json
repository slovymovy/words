                "senses": [
                    {
                        "sense_id": "c17915bb-f52d-3cc8-a030-e83e1bd8bed2",
                        "entry_id": "684e626e-70ff-3930-86e1-343f7890d44b",
                        "glosses": [
                            "церк. монах или старообрядец, живущий в скиту"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a9a16fa-715b-42f1-8ed2-0fd73d9aef62",
                                "sense_id": "c17915bb-f52d-3cc8-a030-e83e1bd8bed2",
                                "text": "Церквей у них не было и не было тоже и священников, и долгое время скитниками не управляло никакое начальство."
                            },
                            {
                                "example_id": "e3e2e2f5-6a32-4923-9179-cef0b6ed1c2f",
                                "sense_id": "c17915bb-f52d-3cc8-a030-e83e1bd8bed2",
                                "text": "Конечно, и скитники не одним дыхом да молитвой живут, тоже хлебушко едят и от медку не отказываются."
                            }
                        ]
                    }
                ],
