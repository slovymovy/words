                "translations": [
                    {
                        "translation_id": "65df2a00-a322-4794-bc94-ed04017783e7",
                        "source_entry_id": "b6a89f0b-bd36-3818-88d8-e4c0e49dca05",
                        "source_sense_id": "27be2bf1-6a22-3062-aab8-19f5d8dfb9eb",
                        "target_lang_word": "bride price",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bride price",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d46156b9-be74-3499-b2dc-0fcd3f58dda3",
                                        "entry_id": "1635f4d2-bbde-3066-be18-d9194443c77f",
                                        "glosses": [
                                            "In some cultures, a sum of money or other valuables paid by a bridegroom or on his behalf to the family of the bride."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec26ce2b-debf-49bb-ae5b-815c3c903cc9",
                                                "sense_id": "d46156b9-be74-3499-b2dc-0fcd3f58dda3",
                                                "text": "It is well known in Artas as in other villages exactly what the bride price should customarily be—so much for a cousin bride, so much more for a village bride, more still for a stranger."
                                            },
                                            {
                                                "example_id": "1e3ffb5c-9fac-4600-b6a4-36e6a9a24339",
                                                "sense_id": "d46156b9-be74-3499-b2dc-0fcd3f58dda3",
                                                "text": "Taiqian county in Henan province has issued guidelines saying grooms should pay no more than 60,000 yuan (HK$67,000) as a “bride price”, the Chinese tradition that a male partner offers money to his fiancée’s family to secure their marriage."
                                            },
                                            {
                                                "example_id": "0fc94f9e-2f58-4372-bef3-f25ddd7c52aa",
                                                "sense_id": "d46156b9-be74-3499-b2dc-0fcd3f58dda3",
                                                "text": "Their fares across the Atlantic were paid on the understanding that when they married, their Virginian husbands would pay a bride price for them of 150 pounds of tobacco, then worth about £22 (perhaps seven years’ salary for a domestic maid)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
