                        "source_entry_id": "3750d322-77ff-34ac-bc35-cd4b3c3c43a5",
                        "source_sense_description": "(of a line) made up of a series of dots",
                        "target_lang_word": "gepunktet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gepunktet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "006eede0-e91b-30a5-82c4-bf34ecb94079",
                                        "entry_id": "a95c7d5e-4ecb-3fb8-8d3a-6a30da94f858",
                                        "glosses": [
                                            "mit mehreren Punkten versehen oder aus Punkten bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6988c792-4828-4270-8348-1ecb540d27a6",
                                                "sense_id": "006eede0-e91b-30a5-82c4-bf34ecb94079",
                                                "text": "Unterschreiben sie hier auf der gepunkteten Linie."
                                            },
                                            {
                                                "example_id": "160ef6c9-e245-44f2-93f5-164d6ac8456a",
                                                "sense_id": "006eede0-e91b-30a5-82c4-bf34ecb94079",
                                                "text": "Die Mittelachse des Gebäudes war im Plan durch eine gepunktete Linie dargestellt."
                                            },
                                            {
                                                "example_id": "13aa5ebf-23f1-492b-9c68-ad3ca8e063e7",
                                                "sense_id": "006eede0-e91b-30a5-82c4-bf34ecb94079",
                                                "text": "Im Garten finden sich allerhand Exemplare: Rund zwei Zentimeter kurze Schwarze, kleine Helle mit Gehäuse, gepunktete und orangefarbene Schnecken."
                                            },
                                            {
                                                "example_id": "fe6f5b28-e598-480e-8ab4-1a2b85e4a238",
                                                "sense_id": "006eede0-e91b-30a5-82c4-bf34ecb94079",
                                                "text": "Bei der Tour de France trägt der Führende in der Bergwertung ein gepunktetes Trikot."
                                            },
                                            {
                                                "example_id": "ac48f147-a681-407d-8d3a-5a96ed591fbd",
                                                "sense_id": "006eede0-e91b-30a5-82c4-bf34ecb94079",
                                                "text": "Voss ist der siebte deutsche Profi, der das gepunktete Jersey bei der Tour tragen darf. Zuletzt war Tony Martin 2014 im Bergtrikot unterwegs."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
