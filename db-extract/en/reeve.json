                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3024629-cdd5-400a-b2e9-ea8a5aac43cd",
                                                "sense_id": "52c00c78-d2e8-3460-ba84-9c0582b2b486",
                                                "text": "Herr Graf arbeitet bei einer Versicherung."
                                            },
                                            {
                                                "example_id": "cc2da1e1-5381-45ac-aa72-1dfba1e9d0ac",
                                                "sense_id": "52c00c78-d2e8-3460-ba84-9c0582b2b486",
                                                "text": "Frau Graf fährt ein pinkfarbenes Cabrio."
                                            },
                                            {
                                                "example_id": "bb8b3b94-3e71-4079-a018-7f3d52fc049a",
                                                "sense_id": "52c00c78-d2e8-3460-ba84-9c0582b2b486",
                                                "text": "Bei den Grafs ist immer gute Stimmung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
