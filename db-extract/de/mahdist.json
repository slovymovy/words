                "senses": [
                    {
                        "sense_id": "1a9fea7f-fbd5-3fcb-98de-47f434d00912",
                        "entry_id": "a17e3b8a-b914-3b00-aecf-77c96bb0495a",
                        "glosses": [
                            "Teilnehmer an einem Aufstand gegen die ägyptische Herrschaft in den Sudan-Provinzen (Mahdi-Aufstand)"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "7d4376f5-12fc-4677-b49f-79337fa61558",
                                "sense_id": "1a9fea7f-fbd5-3fcb-98de-47f434d00912",
                                "text": "„Der andere fuhr mit Kanonenbooten jener siegreichen britisch-ägyptischen Armee voraus, mit der er kurz zuvor bei Omdurman die gefürchteten Mahdisten vernichtend geschlagen und anschließend ihre Hauptstadt Khartum besetzt hatte.“"
                            },
                            {
                                "example_id": "23186192-5e6f-41d2-89ee-1c50495bc643",
                                "sense_id": "1a9fea7f-fbd5-3fcb-98de-47f434d00912",
                                "text": "„Die Mahdisten, wie sie auch genannt wurden, nahmen Khartum im Januar 1885 ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
