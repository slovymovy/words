                "senses": [
                    {
                        "sense_id": "5d6433e0-464f-37cc-90d6-8bef96508994",
                        "entry_id": "a6f11eb6-444c-35e6-a2e4-3f713a40a39e",
                        "glosses": [
                            "Débarrasser de l’influence et du réseau de Zine el-Abidine Ben Ali."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48c81f3b-1e17-4b6a-aecf-3367ab07cdee",
                                "sense_id": "5d6433e0-464f-37cc-90d6-8bef96508994",
                                "text": "De l'art de débenaliser, démoubarakiser, dékadhafiser"
                            },
                            {
                                "example_id": "553a0311-5ab4-4b88-92d0-f95d35e0e0de",
                                "sense_id": "5d6433e0-464f-37cc-90d6-8bef96508994",
                                "text": "Débenaliser le système : était-ce un rêve ou une réalité ?"
                            },
                            {
                                "example_id": "d7a06d5f-0716-441e-bf43-22de0cbfe66f",
                                "sense_id": "5d6433e0-464f-37cc-90d6-8bef96508994",
                                "text": "Il faut “débenaliser” ce pays."
                            },
                            {
                                "example_id": "3e344eb4-039a-4905-8c58-762ac52a988d",
                                "sense_id": "5d6433e0-464f-37cc-90d6-8bef96508994",
                                "text": "Quelles que soient les réponses possibles, une gymnastique intellectuelle délicate et difficile s’avère nécessaire pour faire le point sur les actes importants, les décisions prises ou non prises, ainsi que pour décortiquer et analyser le processus entamé afin de \"débenaliser\" la politique et \"détrabelsiser\" l’économie du pays."
                            }
                        ]
                    }
                ],
