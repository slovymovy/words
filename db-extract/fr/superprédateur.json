                                "target_senses": [
                                    {
                                        "sense_id": "23ba90cc-3871-353b-9daf-b9b08bbed0ad",
                                        "entry_id": "4aa95be8-d723-34b3-8b96-97b2c17a4c0f",
                                        "glosses": [
                                            "An animal atop the food chain, preying on another animals, and not itself preyed upon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fed25f48-6561-425e-bb8f-8c79a4b4965d",
                                                "sense_id": "23ba90cc-3871-353b-9daf-b9b08bbed0ad",
                                                "text": "a. 2007, Martha Hiatt, quoted in, 2007, Wendell Jamieson, Father Knows Less, or, \"Can I cook my sister?\", Putnam, →ISBN, page 203,\nKiller whales are the oceans' apex predators, which means they are at the top of the food chain."
                                            },
                                            {
                                                "example_id": "f982d139-555d-4737-910c-f0bbc94a5084",
                                                "sense_id": "23ba90cc-3871-353b-9daf-b9b08bbed0ad",
                                                "text": "And marijuana is not a Schedule I any more than a hedgehog is an apex predator. “You’re not scaring anyone, Roland. Get a tattoo.”"
                                            },
                                            {
                                                "example_id": "5a8f1f07-1ec8-4515-8cc2-cb8d8802059e",
                                                "sense_id": "23ba90cc-3871-353b-9daf-b9b08bbed0ad",
                                                "text": "With a bite that could split a shark in two and an armored mug only a mother could love, Dunkleosteus was one of Earth’s earliest apex predators, terrorizing subtropical seas 360 million years ago during the Devonian Period."
                                            },
                                            {
                                                "example_id": "43064775-e4f0-4364-b9d2-db2189cd88ea",
                                                "sense_id": "23ba90cc-3871-353b-9daf-b9b08bbed0ad",
                                                "text": "Alessi did as he was told, and I found out later that [Ghislaine] Maxwell got out and followed me. I didn’t know it yet, but an apex predator was closing in."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
