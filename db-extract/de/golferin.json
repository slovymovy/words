                        "examples": [
                            {
                                "example_id": "d5f32138-3196-481d-b465-74ca6417c162",
                                "sense_id": "16c345d4-214e-34ee-8cee-228b99d621f8",
                                "text": "„Nun hat sich die elfjährige Lucy Li als jüngste Golferin für die US Open qualifiziert.“"
                            },
                            {
                                "example_id": "46d6a2fe-097a-440c-bd02-b6f2bc3f0dcb",
                                "sense_id": "16c345d4-214e-34ee-8cee-228b99d621f8",
                                "text": "Meine Nachbarin Annika ist eine begeisterte Golferin."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da309114-0a3f-49a1-aa67-ba2500612565",
                        "source_entry_id": "fe98c609-1c1e-3bc4-a340-08174a50184d",
                        "source_sense_id": "16c345d4-214e-34ee-8cee-228b99d621f8",
                        "source_sense_description": "Sportlerin, die das Golfspiel ausübt",
                        "target_lang_word": "golfer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "golfer",
