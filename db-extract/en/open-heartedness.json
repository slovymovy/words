                                "example_id": "1fc7449e-2af8-4e4a-8609-e96ca86dc9bf",
                                "sense_id": "0d730297-320f-369f-9676-eea5813c531c",
                                "text": "Open-heartedness is another type of openness. Participants in, for instance, paradigm dialogues should be open-hearted with regard to their reasons and motives, and also regarding the psychological, social and educational factors that may have influenced their thinking."
                            },
                            {
                                "example_id": "828ebe06-9365-46c1-bd23-c37af5112f13",
                                "sense_id": "0d730297-320f-369f-9676-eea5813c531c",
                                "text": "Be sincere and open-hearted with the trusting open-heartedness of a child."
                            }
                        ]
                    },
