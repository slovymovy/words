                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faa893b1-5b0a-44a4-a0b7-6d546abcfe4d",
                                                "sense_id": "efda15a9-2e3d-3991-abd4-1941e6640d97",
                                                "text": "Le I est une voyelle française."
                                            },
                                            {
                                                "example_id": "d69ac581-fbf3-46a7-9756-25bf6c3964f9",
                                                "sense_id": "efda15a9-2e3d-3991-abd4-1941e6640d97",
                                                "text": "A noir, E blanc, I rouge, U vert, O bleu, voyelles,\nJe dirai quelque jour vos naissances latentes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "I",
