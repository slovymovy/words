                "senses": [
                    {
                        "sense_id": "80022dcd-5903-39e2-b694-f38dac6dfcbe",
                        "entry_id": "ccbb1c2f-3477-3c67-917a-a49262b63268",
                        "glosses": [
                            "To leap over, to jump over, to cross by jumping."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4b7ceea0-9c47-4934-80d6-2de86479aaac",
                                "sense_id": "80022dcd-5903-39e2-b694-f38dac6dfcbe",
                                "text": "Nor hedge, nor ditch, nor hill, nor dale she staies, / But overleapes them all, like Robucke light […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6b8c487-3504-3d44-8181-8ca4669e920a",
                        "entry_id": "ccbb1c2f-3477-3c67-917a-a49262b63268",
                        "glosses": [
                            "To pass over; to omit, leave out."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c00f7462-bdde-4765-8029-ed56a0d50355",
                                "sense_id": "e6b8c487-3504-3d44-8181-8ca4669e920a",
                                "text": "It should be noted that even modest German efforts to overleap the power-political constraints on imperial expansion met with sturdy resistance from the established world powers."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1092cca-b76d-3cf3-9db5-f47dc5ddf40e",
                        "entry_id": "ccbb1c2f-3477-3c67-917a-a49262b63268",
                        "glosses": [
                            "To make too much effort in leaping; to leap too far."
                        ],
                        "tags": [
                            "dated",
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "9ea1512b-2c83-4daf-b2fc-8c7c9068d0ae",
                                "sense_id": "c1092cca-b76d-3cf3-9db5-f47dc5ddf40e",
                                "text": "I overleapt myself and stumbled."
                            }
                        ]
                    }
