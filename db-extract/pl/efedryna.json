                "forms": [],
                "senses": [
                    {
                        "sense_id": "6560ecdf-fc1a-305c-9624-589dbc701485",
                        "entry_id": "be7415e7-53b4-37d0-9944-f99ed1f9a909",
                        "glosses": [
                            "organiczny związek chemiczny z grupy alkaloidów, występujący naturalnie w roślinach z rodzaju Ephedra, działający pobudzająco na ośrodkowy układ nerwowy oraz sympatykomimetycznie (pobudza układ współczulny)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52993f71-6afb-4f9e-b5c0-3281b963a41c",
                                "sense_id": "6560ecdf-fc1a-305c-9624-589dbc701485",
                                "text": "W wielu krajach obrót efedryną jest ściśle regulowany – dostępna tylko na receptę, a w wyższych stężeniach – zakazana."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5f59b16-d370-45e3-b473-39fc78746e2c",
                        "source_entry_id": "be7415e7-53b4-37d0-9944-f99ed1f9a909",
                        "source_sense_id": "6560ecdf-fc1a-305c-9624-589dbc701485",
                        "target_lang_word": "ephedrine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ephedrine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07bea381-e685-3b8c-b971-6e3c04a14175",
                                        "entry_id": "16468d5c-86e3-3363-8fd3-b4dfcca2a1ef",
                                        "glosses": [
                                            "A crystalline alkaloid drug C₁₀H₁₅NO obtained from a Chinese ephedra (Ephedra sinica) or synthesized that has the physiological action of epinephrine. It causes constriction of the blood vessels and widening of the bronchial passages and is used in the form of its hydrochloride or sulfate to relieve asthma and hay fever."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3918c3b-54d3-4c08-a2ff-54611d9245fa",
                                                "sense_id": "07bea381-e685-3b8c-b971-6e3c04a14175",
                                                "text": "The great advantage of ephedrine is its effectiveness if taken as a pill, whereas adrenaline works only if injected or inhaled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6daedb12-1ca4-4299-827a-d978ef7c8836",
                        "source_entry_id": "be7415e7-53b4-37d0-9944-f99ed1f9a909",
                        "source_sense_id": "6560ecdf-fc1a-305c-9624-589dbc701485",
                        "target_lang_word": "éphédrine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éphédrine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0fd1308-1009-3f82-8ac4-93ce14efa925",
                                        "entry_id": "008e777b-514f-305b-aaeb-fc29f463aaf0",
                                        "glosses": [
                                            "Alcaloïde blanc cristallisable extrait de divers arbustes du genre éphèdre d’action proche de celle de l’adrénaline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfbe0d40-af1d-4ef3-9396-3831eebd26ff",
                                                "sense_id": "a0fd1308-1009-3f82-8ac4-93ce14efa925",
                                                "text": "Ils aidèrent le conteur à embellir son récit à l’aide d’une mixture végétale qu’ils avaient découverte, le soma, à base d’éphédra, une baie rouge gui, pilée, donne de l’éphédrine, un psychotrope qui contribua à le mettre ne transe et à rendre ses visions plus précises."
                                            },
                                            {
                                                "example_id": "30628165-47e0-4faf-bc98-35f01f9a7760",
                                                "sense_id": "a0fd1308-1009-3f82-8ac4-93ce14efa925",
                                                "text": "Les inconvénients que peut présenter l’administration isolée d’analeptiques a conduit à utiliser de préférence les associations : éphédrine et cardiazol, pressédrine et camphramine."
                                            }
                                        ]
                                    }
