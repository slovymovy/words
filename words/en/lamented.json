                    "frequency": "Middle",
                    "semantic_group_id": "grieve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet deeply <w>lamented</w> the tragic loss of his dearest childhood companion.",
                            "target_lang_translations": {
                                "nl": "De dichter <w>betreurde</w> het tragische verlies van zijn dierbaarste jeugdvriend ten zeerste."
                            }
                        },
                        {
                            "text": "Many citizens <w>lamented</w> that the historical building had been demolished without warning.",
                            "target_lang_translations": {
                                "nl": "Veel burgers <w>beklaagden</w> dat het historische gebouw zonder waarschuwing was gesloopt."
                            }
                        }
                    ],
                    "synonyms": [
                        "mourned",
                        "grieved"
                    ],
                    "antonyms": [
                        "celebrated",
                        "rejoiced"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "verleden tijd en voltooid deelwoord van 'lament': betreurde, beklaagde, rouwde om"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "betreurde",
                                "target_lang_sense_clarification": "jammer vinden, verdriet hebben over"
                            },
                            {
                                "target_lang_word": "beklaagde",
                                "target_lang_sense_clarification": "zijn leedwezen of ongenoegen uiten over"
                            },
                            {
