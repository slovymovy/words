                "senses": [
                    {
                        "sense_id": "b4bc053a-f93e-3f74-b531-8750c7d0e8d5",
                        "entry_id": "7d64b0e2-51ef-3798-ae11-1eabf63be838",
                        "glosses": [
                            "Having a church."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b591aa5-4bd4-4752-ba29-0723eaf88e46",
                                "sense_id": "b4bc053a-f93e-3f74-b531-8750c7d0e8d5",
                                "text": "As to new churches in an already sufficiently churched community can this body say that such churches will not be recognized by the parent body?"
                            }
                        ]
                    },
                    {
                        "sense_id": "7b1d5339-fbd2-3ac2-976a-690a911c7e35",
                        "entry_id": "7d64b0e2-51ef-3798-ae11-1eabf63be838",
                        "glosses": [
                            "Actively participating in church services and activities, and endorsing church doctrines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbee9925-e472-43d9-88a9-1071d17044b7",
                                "sense_id": "7b1d5339-fbd2-3ac2-976a-690a911c7e35",
                                "text": "Most of the presently unchurched have had a traditionally religious background — in fact, to about the same extent as the churched."
                            },
                            {
                                "example_id": "9b55d904-de64-4ccb-b9d9-3910cae108ec",
                                "sense_id": "7b1d5339-fbd2-3ac2-976a-690a911c7e35",
                                "text": "The unchurched are less likely than the churched to be registered to vote: 75 percent of the unchurched, 79 percent of the churched and 82 percent of the superchurched are registered."
                            },
                            {
                                "example_id": "3b87c7fc-cf0e-418e-baff-f59a6c04af9d",
                                "sense_id": "7b1d5339-fbd2-3ac2-976a-690a911c7e35",
                                "text": "Hypothesis H2, that churched men in general would endorse stereotypcially feminine message behavior more than would unchurched men, was tested by means of t-test."
                            }
                        ]
                    }
                ],
