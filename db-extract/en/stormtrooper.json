                                        "sense_id": "f3eb6fdc-e609-3219-87ef-6710d457a695",
                                        "entry_id": "13f50b12-8d41-344a-bee7-c94abcf8e9c9",
                                        "glosses": [
                                            "воен., авиац. военный самолёт, предназначенный для атаки наземных целей противника с небольшой высоты"
                                        ],
                                        "tags": [],
