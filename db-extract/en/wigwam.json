    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fc8b49ba-ac06-3dd6-aa2d-cf54212fb5a0",
                "word": "wigwam",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7298c938-7733-4ea4-a774-0f61c7861c84",
                        "entry_id": "fc8b49ba-ac06-3dd6-aa2d-cf54212fb5a0",
                        "tags": [
                            "plural"
                        ],
                        "form": "wigwams"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86d49588-06e7-33d4-a22a-8c24c0830ef6",
                        "entry_id": "fc8b49ba-ac06-3dd6-aa2d-cf54212fb5a0",
                        "glosses": [
                            "A dwelling having an arched framework overlaid with bark, hides, or mats, used by Native Americans in the northeastern United States."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "33f58cf3-ebe0-3709-8717-c6d63fe3a388",
                        "entry_id": "fc8b49ba-ac06-3dd6-aa2d-cf54212fb5a0",
                        "glosses": [
                            "Any more or less similar dwelling used by indigenous people in other parts of the world."
                        ],
                        "tags": [
                            "dated",
                            "possibly"
                        ],
                        "examples": [
                            {
                                "example_id": "c0ff8617-3c50-46a2-ac06-2daa7601ae77",
                                "sense_id": "33f58cf3-ebe0-3709-8717-c6d63fe3a388",
                                "text": "Their houſes or wigwams, which they call carbets, are built as I have already deſcribed thoſe of the negroes; but inſtead of being covered with the leaves of the manicole-tree, they are covered with the leaves of rattans or jointed canes, here called tas, which grow in cluſters in all marſhy places: [...]"
                            },
                            {
                                "example_id": "ca5d008e-553b-4978-a535-a3356cebbb27",
                                "sense_id": "33f58cf3-ebe0-3709-8717-c6d63fe3a388",
                                "text": "The Fuegian wigwam resembles, in size and dimensions, a haycock. It merely consists of a few broken branches stuck in the ground, and very imperfectly thatched on one side with a few tufts of grass and rushes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2dc00017-4ed6-4369-be66-c6f6ec6f56a0",
                        "source_entry_id": "fc8b49ba-ac06-3dd6-aa2d-cf54212fb5a0",
                        "source_sense_description": "Native American dwelling",
                        "target_lang_word": "wigwam",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wigwam",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "24f0cca0-50b3-3e51-a633-fea3fd0c8b5d",
                                        "entry_id": "5bd8dfc2-8613-378a-bcd8-b6e91e62397e",
                                        "glosses": [
                                            "koepelvormig huis gebruikt door de Noord-Amerikaanse indianen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6282bdd5-eb4d-405c-8975-2ff29d9da618",
                                                "sense_id": "24f0cca0-50b3-3e51-a633-fea3fd0c8b5d",
                                                "text": "De tipi, een kegelvormige indianentent, wordt vaak ten onrechte een wigwam genoemd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b150bdee-2399-49b6-b834-2fd053ea2842",
                        "source_entry_id": "fc8b49ba-ac06-3dd6-aa2d-cf54212fb5a0",
                        "source_sense_description": "Native American dwelling",
                        "target_lang_word": "wigwam",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wigwam",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17324df5-57d4-3b54-a711-85b7fd60e425",
                                        "entry_id": "00c59eda-c5b9-3ef4-909e-e7c6e0d8bab6",
                                        "glosses": [
                                            "Type d’habitation traditionnelle construite par les Amérindiens semi-nomades d’Amérique du Nord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "376b3a63-0c1e-49c5-92a1-e7b6abb83da8",
                                                "sense_id": "17324df5-57d4-3b54-a711-85b7fd60e425",
                                                "text": "Quant aux rafraîchissements, le whisky et le gin, ils circulaient dans de petits verres d’étain, sans parler d’un punch gigantesque qui devait clore cette fête, dont les Indiens parleront longtemps dans leurs wigwams."
                                            },
                                            {
                                                "example_id": "2e9dd3d6-47d8-486e-be88-1740869d8273",
                                                "sense_id": "17324df5-57d4-3b54-a711-85b7fd60e425",
                                                "text": "Avec la petite bande de six à sept gosses dont elle faisait partie, elle avait installé un vaste wigwam au centre de l'immense salon."
                                            },
                                            {
                                                "example_id": "45e5b28f-aef4-429c-8265-5dd40a756b2f",
                                                "sense_id": "17324df5-57d4-3b54-a711-85b7fd60e425",
                                                "text": "Toujours dans la grande famille des hébergements insolites, voici les wigwams et les zomes qui adoptent la forme d’un dôme, les pods dont l’aspect évoque celui d’un demi-tronc d’arbre, les kotas — de plan hexagonal et originaires de Finlande —, les tiny houses, ou micromaisons — nombre d’entre elles présentent la particularité de pouvoir être déplacées, car elles sont équipées de roues —, les « maisons de Hobbit » garnies d’un toit végétalisé, les kerterres — maisonnettes façonnées avec du chanvre, du sable et de la chaux…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4e960d0-b515-4389-b9f1-be66e7b016dd",
                        "source_entry_id": "fc8b49ba-ac06-3dd6-aa2d-cf54212fb5a0",
                        "source_sense_description": "Native American dwelling",
                        "target_lang_word": "Wigwam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wigwam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "263f9451-bd46-32a2-b277-19661689dcf3",
                                        "entry_id": "85260187-b608-32cd-bc3b-950c6fc24316",
                                        "glosses": [
                                            "kuppelförmiges Zelt oder Hütte, die von nordamerikanischen Indianern als Behausung genutzt wird"
                                        ],
                                        "tags": [
                                            "Ethnologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa51ba94-39e0-41c6-be8b-d2deddc7b03a",
                                                "sense_id": "263f9451-bd46-32a2-b277-19661689dcf3",
                                                "text": "Die Fellwände waren kunstvoll mit Tiergestalten bemalt, augenscheinlich war dies der Wigwam eines Häuptlings."
                                            },
                                            {
                                                "example_id": "c5044e32-4190-467c-91c8-c11e24fc3ea9",
                                                "sense_id": "263f9451-bd46-32a2-b277-19661689dcf3",
                                                "text": "„Das Fleisch wurde getrocknet und die Felle zu Kleidern, Werkzeug oder Unterlagen für die Wigwams verarbeitet.“"
                                            },
                                            {
                                                "example_id": "3f442871-9bbf-4e5b-94af-c170e9a624e7",
                                                "sense_id": "263f9451-bd46-32a2-b277-19661689dcf3",
                                                "text": "„So war er bis zu dem Wigwam des Indianers gekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c5da135-edb9-4968-8474-22f85090bd08",
                        "source_entry_id": "fc8b49ba-ac06-3dd6-aa2d-cf54212fb5a0",
