    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4c81731a-8a06-3b24-a8bf-48273aebd489",
                "word": "furiously",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bd3167a3-92bc-4dea-93f0-471a277e24dd",
                        "entry_id": "4c81731a-8a06-3b24-a8bf-48273aebd489",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more furiously"
                    },
                    {
                        "form_id": "91c6c48f-5e35-4b05-ad2a-79356e83b51c",
                        "entry_id": "4c81731a-8a06-3b24-a8bf-48273aebd489",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most furiously"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ccf81bb-3f27-330a-9bbb-aae9a183b40e",
                        "entry_id": "4c81731a-8a06-3b24-a8bf-48273aebd489",
                        "glosses": [
                            "In a furious manner; angrily."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "826b4f75-bb02-4cc8-abd7-5458c8ee2f6d",
                                "sense_id": "2ccf81bb-3f27-330a-9bbb-aae9a183b40e",
                                "text": "He glared furiously at the offender."
                            },
                            {
                                "example_id": "5244078a-9891-4059-ab2f-e4b5346cb44f",
                                "sense_id": "2ccf81bb-3f27-330a-9bbb-aae9a183b40e",
                                "text": "Case in point, as Lichfield detailed on Twitter last week: Almost as soon as the \"hipster effect\" article was published, a man furiously emailed the magazine claiming a photo of him was slanderously used alongside it without his permission. He was, it turned out, mistaken."
                            }
                        ]
                    },
                    {
                        "sense_id": "60e3e782-3be6-3bf8-9431-a1ccc629c3cf",
                        "entry_id": "4c81731a-8a06-3b24-a8bf-48273aebd489",
                        "glosses": [
                            "Quickly; frantically; with great effort or speed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3a80681-6e29-49a3-a71a-1cc994acf1d6",
                                "sense_id": "60e3e782-3be6-3bf8-9431-a1ccc629c3cf",
                                "text": "He tried furiously to get it to work before the deadline."
                            },
                            {
                                "example_id": "804f443d-80bf-4936-8c18-416ced1f0a56",
                                "sense_id": "60e3e782-3be6-3bf8-9431-a1ccc629c3cf",
                                "text": "Again we set to and bailed furiously. Fortunately the storm had now quite gone by[.]"
                            },
                            {
                                "example_id": "b1884d23-f9e3-45ca-8c28-9685c288e9d5",
                                "sense_id": "60e3e782-3be6-3bf8-9431-a1ccc629c3cf",
                                "text": "“It was nonsense to pretend that he was afraid of the scandal, as no possible scandal could attach to him. This attitude of his gave me furiously to think, and I was slowly forced to the conclusion that Alfred Inglethorp wanted to be arrested.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "c0ce8893-4d45-354a-aa64-64afe76dbe9f",
                        "entry_id": "4c81731a-8a06-3b24-a8bf-48273aebd489",
                        "glosses": [
                            "Intensely, as with embarrassment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57dbe89a-7a93-49e4-a202-1d47b1a961d2",
                                "sense_id": "c0ce8893-4d45-354a-aa64-64afe76dbe9f",
                                "text": "Craig, who at twenty was taller than his father, blushed furiously as he practically threw two small boxes on the table in front of the twins. “Happy birthday”, he managed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2d8f8d0-6a61-457c-9895-b5ddee746768",
                        "source_entry_id": "4c81731a-8a06-3b24-a8bf-48273aebd489",
                        "source_sense_description": "in a furious manner; angrily",
                        "target_lang_word": "furieusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "furieusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e625a16-59b6-3357-ace9-4b1012e308ef",
                                        "entry_id": "906057af-dea9-3d6e-90f5-145f39af1a2d",
                                        "glosses": [
                                            "Avec furie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "072e5f68-bc7a-42b9-8c62-e28aed736daf",
                                                "sense_id": "7e625a16-59b6-3357-ace9-4b1012e308ef",
                                                "text": "Vous ne savez pas comment les Jansénistes les tiennent en échec et les pressent si furieusement que, la moindre parole qui leur échappe contre les principes des pères, on les voit incontinent accablés par des volumes entiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42d43339-1a60-376d-9a89-1325f2ea9352",
                                        "entry_id": "906057af-dea9-3d6e-90f5-145f39af1a2d",
                                        "glosses": [
                                            "Extrêmement, excessivement."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ea33034-4fd3-4900-b8e1-c7e310be3987",
                                                "sense_id": "42d43339-1a60-376d-9a89-1325f2ea9352",
                                                "text": "Vous donnez furieusement dans le marquis."
                                            },
                                            {
                                                "example_id": "0a88d1e9-7d30-41f7-880b-ee578e8c78e8",
                                                "sense_id": "42d43339-1a60-376d-9a89-1325f2ea9352",
                                                "text": "C'est que vous êtes furieusement difficile."
                                            },
                                            {
                                                "example_id": "70033c3f-9259-47ad-bca1-a090af874a7b",
                                                "sense_id": "42d43339-1a60-376d-9a89-1325f2ea9352",
                                                "text": "Je suis furieusement tombé, et il n'y a plus de société pour moi."
                                            },
                                            {
                                                "example_id": "404ac2ec-0660-4301-8e15-8f6cde692510",
                                                "sense_id": "42d43339-1a60-376d-9a89-1325f2ea9352",
                                                "text": "Avoir donné le fouet jadis à un duc et pair, cela vous pousse furieusement."
                                            },
                                            {
                                                "example_id": "0c94935b-d4f2-4d72-84a1-74f1c9fc1acf",
                                                "sense_id": "42d43339-1a60-376d-9a89-1325f2ea9352",
                                                "text": "Elle eût donné dix ans de sa vie pour posséder une de ces habitations. La maison qui formait le coin de gauche, et dans laquelle logeait le receveur particulier, la tentait surtout furieusement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "babfc1cb-3f61-498d-8bac-4b3c311df79b",
