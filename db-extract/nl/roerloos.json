                    }
                ],
                "senses": [
                    {
                        "sense_id": "5bbf8427-b0a8-3ad2-a6b8-8048763bf60f",
                        "entry_id": "4aa9351e-f86b-3049-ac8a-1c85c311c861",
                        "glosses": [
                            "volkomen stil, zonder zich te roeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e48279da-7b10-4507-9844-395c6255031f",
                                "sense_id": "5bbf8427-b0a8-3ad2-a6b8-8048763bf60f",
                                "text": "Zij stonden daar roerloos als standbeelden."
                            },
                            {
                                "example_id": "d09bd17c-a107-4770-bb11-1fbdfd84e624",
                                "sense_id": "5bbf8427-b0a8-3ad2-a6b8-8048763bf60f",
                                "text": "Zonder een ooglid te verroeren zat Kleine Woord op zijn stapel plaggen en wachtte roerloos op het geheimzinnige wezen, dat nu bijna de ingang van het huis van het Moeraspaard had bereikt."
                            },
                            {
                                "example_id": "90e319d5-1a3c-4731-a617-56b5e28c52e7",
                                "sense_id": "5bbf8427-b0a8-3ad2-a6b8-8048763bf60f",
                                "text": "' Tot Teresa's vreugde luisterde Olive roerloos naar haar verhaal, terwijl de schaduwen op de muren op zwarte dansers leken en de ui in de pan lag te zweten."
                            },
                            {
                                "example_id": "d11d1f36-dc99-42c1-9f47-254a0bc1ae0b",
                                "sense_id": "5bbf8427-b0a8-3ad2-a6b8-8048763bf60f",
                                "text": "Wat een prachtig geschenk! Ontroerd schoot de gedachte door me heen: zou een levende vader zijn kind ooit zo'n bijzonder geschenk hebben kunnen geven? De vrouw was even opgehouden met praten en in stilte zaten we roerloos in de kamer."
                            }
                        ]
                    },
                    {
                        "sense_id": "1170a23a-1d41-3f65-a39d-54c3a1d3f02e",
                        "entry_id": "4aa9351e-f86b-3049-ac8a-1c85c311c861",
                        "glosses": [
                            "zonder roer"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc39ecfd-33f6-4b24-9e3e-a43436674ebe",
                        "source_entry_id": "4aa9351e-f86b-3049-ac8a-1c85c311c861",
                        "source_sense_id": "5bbf8427-b0a8-3ad2-a6b8-8048763bf60f",
                        "source_sense_description": "bewegingloos",
                        "target_lang_word": "motionless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motionless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "593b034b-ed95-3738-b183-806521daadd0",
                                        "entry_id": "3f9fb490-6cc0-31d5-b846-1c41fd4c323d",
                                        "glosses": [
                                            "At rest, stationary, immobile, not moving."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36625902-d2aa-4887-bd82-a9793ddf757a",
                                                "sense_id": "593b034b-ed95-3738-b183-806521daadd0",
                                                "text": "Nothing was to be seen save flat meadows, cows for the most part feeding unconcernedly, and silvery pollard willows motionless in the warm sunlight."
                                            },
                                            {
                                                "example_id": "9da39e41-8438-419b-ad42-d176b0f95931",
                                                "sense_id": "593b034b-ed95-3738-b183-806521daadd0",
                                                "text": "Nothing could be more businesslike than the construction of the stout dams, and nothing more gently rural than the limpid lakes, with the grand old forest trees marshalled round their margins like a veteran army that had marched down to drink, only to be stricken motionless at the water’s edge."
                                            },
                                            {
                                                "example_id": "17d808cf-a3bf-4bd6-8f59-ab78c031b213",
                                                "sense_id": "593b034b-ed95-3738-b183-806521daadd0",
                                                "text": "We remain motionless in the platform while the ex-Edinburgh draws forward, the points are set, and it is propelled back for attachment. The Edinburgh locomotive uncoupled, a brake test is performed and we're away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
