                "forms": [
                    {
                        "form_id": "7d3a063a-6d27-409b-891c-5a1a149cb2ad",
                        "entry_id": "4a5a33ed-f6a8-343a-b34b-0e7174cdf348",
                        "tags": [
                            "plural"
                        ],
                        "form": "koelvloeistoffen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7e4ad258-35b0-38f7-afee-2aa0a07f01ee",
                        "entry_id": "4a5a33ed-f6a8-343a-b34b-0e7174cdf348",
                        "glosses": [
                            "verzamelnaam voor vloeistoffen die in ruime mate toepassing vinden als middel om oververhitting te voorkomen zoals bij machines, kernenergiecentrales, electronische apparatuur, koelkasten enz. en bij verspanende bewerkingen zoals boren , frezen, draaien enz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec3eca11-7448-4101-bfcc-fd6e33e8054c",
                                "sense_id": "7e4ad258-35b0-38f7-afee-2aa0a07f01ee",
                                "text": "Het niveau en de temperatuur van de koelvloeistof moet voortdurend worden gecontroleerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "da398392-5495-3e01-a682-d65ba6b3a194",
                        "entry_id": "4a5a33ed-f6a8-343a-b34b-0e7174cdf348",
                        "glosses": [
                            "een vloeistof die dient om warmte te transporteren"
                        ],
                        "tags": [
                            "motortechniek"
                        ],
                        "examples": [
                            {
                                "example_id": "1d344b8b-7084-4ccf-8f86-4f81b8a18010",
                                "sense_id": "da398392-5495-3e01-a682-d65ba6b3a194",
                                "text": "Let erop dat het peil van de koelvloeistof niet te laag is, anders loopt de motor onherroepelijk vast."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c8bbde2-f10b-49b0-84f1-512f87cbc99b",
                        "source_entry_id": "4a5a33ed-f6a8-343a-b34b-0e7174cdf348",
                        "source_sense_id": "7e4ad258-35b0-38f7-afee-2aa0a07f01ee",
                        "source_sense_description": "koelvloeistof",
                        "target_lang_word": "Kühlflüssigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kühlflüssigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70421c05-6469-3852-8ca4-cfeccb22063c",
                                        "entry_id": "532f7a96-66ab-3028-94cf-fd7ad7afed4f",
                                        "glosses": [
                                            "flüssige Substanz, die bewirkt, dass die Wärme von einem Gegenstand abtransportiert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d23a07d7-c61f-4b20-8df9-23a990739016",
                                                "sense_id": "70421c05-6469-3852-8ca4-cfeccb22063c",
                                                "text": "„Fehlt Kühlflüssigkeit, füllen Sie diese nach Angaben des Herstellers nach.“"
                                            },
                                            {
                                                "example_id": "4968b8cf-e557-40ea-9512-a66705273101",
                                                "sense_id": "70421c05-6469-3852-8ca4-cfeccb22063c",
                                                "text": "Ein AKW muss gekühlt werden, dafür braucht man Kühlflüssigkeit."
                                            },
                                            {
                                                "example_id": "36b6e69b-e42a-4039-8a62-4b1c21b3d859",
                                                "sense_id": "70421c05-6469-3852-8ca4-cfeccb22063c",
                                                "text": "„Das weltweit größte Rechenzentrum, das Lakeside Technology Center, braucht etwa 100 Megawatt elektrischen Strom, für die Kühlung der Server-Räume nutzt der Betreiber einen riesigen Tank mit über 32 Millionen Liter Kühlflüssigkeit.“"
                                            },
                                            {
                                                "example_id": "1996e18c-425c-410a-9931-1e6adcff67dc",
                                                "sense_id": "70421c05-6469-3852-8ca4-cfeccb22063c",
                                                "text": "„Kühlflüssigkeit prüfen – Kühlflüssigkeit immer bei kaltem Motor prüfen. Bei warmem Motor kann Ihnen die Kühlflüssigkeit beim Öffnen entgegenspritzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e994d4c-aa7a-4632-8816-33b982fc6a0f",
                        "source_entry_id": "4a5a33ed-f6a8-343a-b34b-0e7174cdf348",
                        "source_sense_id": "7e4ad258-35b0-38f7-afee-2aa0a07f01ee",
                        "source_sense_description": "koelvloeistof",
                        "target_lang_word": "coolant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coolant",
