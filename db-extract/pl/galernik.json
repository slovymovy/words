                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f73df87b-5823-472c-afcf-528b90713e55",
                        "source_entry_id": "b0107a24-c789-30d5-b858-28213bf77ca8",
                        "source_sense_id": "e6f46be9-9cf4-3b90-8c9f-f12a6147fff8",
                        "target_lang_word": "Galeerensträfling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Galeerensträfling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd050dee-9c28-377a-8e33-e468b725b78b",
                                        "entry_id": "f1b6f708-b89d-3d61-a1f3-7a52a2a0938c",
                                        "glosses": [
                                            "auf einer Galeere seine Strafe verbüßender Straftäter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24125339-5f9e-40d8-a254-57418f4dadd2",
                                                "sense_id": "dd050dee-9c28-377a-8e33-e468b725b78b",
                                                "text": "„In diesem Land gilt jedoch durch diese Strafe niemand als entehrt, zum Unglück nicht einmal die Galeerensträflinge, die man mehr achtet als die Soldaten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "371c4112-6ad2-4e70-8c1b-b8f735452ee7",
                        "source_entry_id": "b0107a24-c789-30d5-b858-28213bf77ca8",
                        "source_sense_id": "e6f46be9-9cf4-3b90-8c9f-f12a6147fff8",
                        "target_lang_word": "Galeerensklave",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Galeerensklave",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8bb3edc-817b-3211-a5c2-d3a50f75d74c",
                                        "entry_id": "65a27f6c-6c71-3efd-ac00-b13f2fcea80f",
                                        "glosses": [
                                            "Mensch, der zum Rudern auf einer Galeere gezwungen wurde, zum Beispiel durch ein Urteil oder in seiner Eigenschaft als Gefangener/Sklave"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beedb0fa-c47e-4395-8fd1-c91e6c022895",
                                                "sense_id": "f8bb3edc-817b-3211-a5c2-d3a50f75d74c",
                                                "text": "„Andere Alternativen waren, sie als Galeerensklaven in Frankreich, als Leibeigene, wie in den deutschen Staaten üblich, oder wie in Schweden und Dänemark als Bergarbeiter einzusetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a48f40c-ab98-4995-b57c-61ba4d75de99",
                        "source_entry_id": "b0107a24-c789-30d5-b858-28213bf77ca8",
