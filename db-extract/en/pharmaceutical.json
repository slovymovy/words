                                                "sense_id": "bae13357-8fdf-3d93-ab8d-ea5d883368f3",
                                                "text": "Die pharmazeutische Industrie ist ein wichtiger Produktionszweig."
                                            },
                                            {
                                                "example_id": "c8bae5bb-ef0d-4fe0-9a58-0755be85bb6d",
                                                "sense_id": "bae13357-8fdf-3d93-ab8d-ea5d883368f3",
