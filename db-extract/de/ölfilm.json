                "senses": [
                    {
                        "sense_id": "5bc4b689-fa7a-3ea3-b812-8f5843eeab6d",
                        "entry_id": "7ae6fc65-eb27-3313-8595-156a311c7c00",
                        "glosses": [
                            "dünne, hautartige Schicht einer öligen Flüssigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33162533-214f-40cc-8825-f78df11991a1",
                                "sense_id": "5bc4b689-fa7a-3ea3-b812-8f5843eeab6d",
                                "text": "„Fein verteiltes Öl richtet so deutlich weniger Schaden an als ein zusammenhängender Ölfilm an der Wasseroberfläche oder gar Ölplacken am Strand oder im Meeresboden.“"
                            },
                            {
                                "example_id": "0120be98-a89c-491d-9e4b-0c325aae1cae",
                                "sense_id": "5bc4b689-fa7a-3ea3-b812-8f5843eeab6d",
                                "text": "„Leichtflüchtige Bestandteile eines schwimmenden Ölfilms verdunsten innerhalb weniger Tage, schwerflüchtige (hauptsächlich aromatische Kohlenwasserstoffe) verbleiben über Monate im Gewässer, sinken ab und werden langsam abgebaut.“"
                            },
                            {
                                "example_id": "e2844aec-5935-4c71-aadd-dcccaf9a2b74",
                                "sense_id": "5bc4b689-fa7a-3ea3-b812-8f5843eeab6d",
                                "text": "„Der Ölfilm unterbricht die Wechselwirkung zwischen Wasser und Atmosphäre, verschmutzt insbesondere das Gefieder von Seevögeln und schließlich, mit entsprechenden Folgen für Flora und Fauna, Fischerei oder Tourismus, den Spülsaum der Küsten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
