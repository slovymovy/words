                "senses": [
                    {
                        "sense_id": "b409072c-2917-3412-a914-0f2753a67218",
                        "entry_id": "8c8b8690-8394-3ae9-9943-7ba7396cae4d",
                        "glosses": [
                            "den Umriss von etwas (zum Beispiel Herz, Glocke, Tannenbaum, Stern, Mond, Engel, Hase oder Ente) darstellendes, aus Metall oder Plastik gefertigtes Utensil, das in ausgerollten Teig hineingedrückt wird, um Plätzchen herzustellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eed0afcd-be5f-4741-91ba-1cf026efbbda",
                                "sense_id": "b409072c-2917-3412-a914-0f2753a67218",
                                "text": "Stefan benutzt am liebsten seine Ausstechform, die den Umriss der Schweiz darstellt."
                            },
                            {
                                "example_id": "8c9cabe6-9b77-468b-9b4f-8dafd8308d4c",
                                "sense_id": "b409072c-2917-3412-a914-0f2753a67218",
                                "text": "Rüdiger hat sich unlängst eine neue Ausstechform gekauft, mit der er nun 20 cm große Stiefel ausstechen kann."
                            },
                            {
                                "example_id": "1789336b-4c85-4502-9620-dcb0d41bc0cf",
                                "sense_id": "b409072c-2917-3412-a914-0f2753a67218",
                                "text": "Wir haben alle unsere Ausstechformen aus Weißblech weggeschmissen und benutzen nur noch die aus Edelstahl oder Plastik."
                            },
                            {
                                "example_id": "2ad80874-e772-49f3-9edb-e92cdf96d515",
                                "sense_id": "b409072c-2917-3412-a914-0f2753a67218",
                                "text": "Ihrem Schwager, der Staatsanwalt ist, schenkte Ida eine Ausstechform mit Paragrafenmotiv."
                            },
                            {
                                "example_id": "8bd9fb71-102c-4ae6-95aa-6e652d121054",
                                "sense_id": "b409072c-2917-3412-a914-0f2753a67218",
                                "text": "Da Roland für sein Leben gern backt, hat sich bei ihm im Laufe der Zeit eine große Anzahl von Ausstechformen angesammelt."
                            },
                            {
                                "example_id": "6529987a-7dae-426e-809d-01de38b41ca7",
                                "sense_id": "b409072c-2917-3412-a914-0f2753a67218",
                                "text": "Ingolf hat eine Vorliebe für Ausstechformen mit ausgefallenen Motiven wie Eidechsen, Bohrmaschinen oder dem Oscar."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
