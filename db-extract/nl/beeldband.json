                "senses": [
                    {
                        "sense_id": "6718379d-d919-3187-aad1-86ef6728dd75",
                        "entry_id": "f80c1126-5db0-351a-8727-882f72e9cd72",
                        "glosses": [
                            "magnetische band met videoopnames"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4adff95f-93d9-4fac-ab4a-9cb4dd534445",
                                "sense_id": "6718379d-d919-3187-aad1-86ef6728dd75",
                                "text": "Van Peperstraten werkte 20 jaar voor het televisieprogramma Studio Sport. Eerst als beeldbandredacteur en inmiddels al jaren als presentator. De 45-jarige Van Peperstraten presenteerde ook het radioprogramma 'Langs de Lijn'. Zijn medepresentator Tom van 't Hek vertrok onlangs ook bij de NOS."
                            },
                            {
                                "example_id": "ddafe24a-bbee-4dd0-84ad-c2e2e266cd5c",
                                "sense_id": "6718379d-d919-3187-aad1-86ef6728dd75",
                                "text": "Gedetineerden mogen in het bezit zijn van beeldbanden en dvd's, maar het moet wel om de originele opnames gaan, niet om kopieën. Die maatregel moet voorkomen dat beelden of informatie wordt binnengesmokkeld. De beeldbanden worden gecontroleerd, maar de beelden met de kinderen glipten er blijkbaar toch door."
                            },
                            {
                                "example_id": "85772ae2-bdb5-42ac-a733-b69780e79fcc",
                                "sense_id": "6718379d-d919-3187-aad1-86ef6728dd75",
                                "text": "Nooit gehoord van de Golden Age of Live Television in de jaren 50? Vanaf de eerste uitzendingen in Nederland (1951) was live uitzenden de norm en beeldband of 16mm-film de uitzondering."
                            }
                        ]
                    }
