                                    {
                                        "sense_id": "378bf1eb-7845-3d45-98ac-cd53eebbb98d",
                                        "entry_id": "9121b883-eff2-3052-a566-5cc48851a7b7",
                                        "glosses": [
                                            "US spelling of counter-offensive."
                                        ],
                                        "tags": [
                                            "US",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dad9d93e-8658-4998-94a1-ca1e4d6367fe",
                                                "sense_id": "378bf1eb-7845-3d45-98ac-cd53eebbb98d",
                                                "text": "As the war slogs on, a growing flow of Western weapons over the summer is now playing a key role in the counteroffensive, helping Ukraine significantly boost its precision strike capability.\nSince the counteroffensive began, Ukraine said, its forces have reclaimed more than 30 settlements in the Kharkiv region."
                                            }
                                        ]
