                    {
                        "translation_id": "0124e7ad-bbb1-4b92-a280-77571b98c626",
                        "source_entry_id": "2f87e7b9-2ee7-3ae5-9df6-48a53406baba",
                        "source_sense_id": "c7737b20-e71c-31b2-97c8-a8d3944c827b",
                        "source_sense_description": "Randmeer des Pazifischen Ozeans",
                        "target_lang_word": "Banda Sea",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Banda Sea",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19eea119-95b2-380c-993d-81dc93a6dd20",
                                        "entry_id": "5d275b05-58f7-30a7-95e9-ee28911bf545",
                                        "glosses": [
                                            "A large sea bordering the Pacific Ocean near Indonesia and surrounded by many islands, such as Timor and the Banda Islands."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c4e7eec-ce7a-4dab-bee3-fe0dea6b153f",
                                                "sense_id": "19eea119-95b2-380c-993d-81dc93a6dd20",
                                                "text": "The Banda Sea is an interarc basin composed of a series of east-west-trending continental and volcanic ridges separated by anomalously deep oceanic basins."
                                            },
                                            {
                                                "example_id": "7d620867-5d0a-4390-8ef3-7fd67846e296",
                                                "sense_id": "19eea119-95b2-380c-993d-81dc93a6dd20",
                                                "text": "Two main theories exist regarding the origin of the Banda Sea: 1) old oceanic crust trapped by the bending of the Banda Arc or specifically, trapped Mesozoic lithosphere of Indian Ocean affinities, or 2) an active marginal basin of Cenozoic age."
                                            },
                                            {
                                                "example_id": "e77b0519-2406-449f-bdbb-c3c8e6bd6a4a",
                                                "sense_id": "19eea119-95b2-380c-993d-81dc93a6dd20",
                                                "text": "And he was nowhere. This remote island was in the middle of the Banda Sea. The Banda Sea was surrounded by large islands and hazardous rocks. But the middle of the sea was scattered with thousands of small tropical islands and atolls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
