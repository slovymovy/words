                        "cross_references": []
                    },
                    {
                        "translation_id": "953a3515-b673-4848-ae63-c54a5697b4c7",
                        "source_entry_id": "ae9aad42-8358-3ba7-94fe-4a4f31065d87",
                        "source_sense_id": "448cf3c1-d6a2-37f2-8414-b9718584e978",
                        "source_sense_description": "Défaut du bois",
                        "target_lang_word": "ring shake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1ddb5724-1ec5-41fe-8506-2a28e962510b",
                        "source_entry_id": "ae9aad42-8358-3ba7-94fe-4a4f31065d87",
                        "target_lang_word": "Nutte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nutte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2fb1905-e26e-38ad-9bec-e51beb01eaad",
                                        "entry_id": "62438177-1906-3f66-afac-1b672c2016f4",
                                        "glosses": [
                                            "eine Frau, die für Geld sexuelle Handlungen vornimmt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "221c9379-4dc6-4e13-a74c-0b8909bb9780",
                                                "sense_id": "d2fb1905-e26e-38ad-9bec-e51beb01eaad",
                                                "text": "Die Bezeichnung Nutte wird von den betreffenden Personen zugunsten des Ausdrucks Hure abgelehnt."
                                            },
                                            {
                                                "example_id": "13a8f45d-b242-444f-9806-c18807e6594b",
                                                "sense_id": "d2fb1905-e26e-38ad-9bec-e51beb01eaad",
                                                "text": "„Nadine war keine professionelle Nutte. Sie machte das als Hobby, hatte keinen Zuhälter und kannte keine anderen Nutten.“"
                                            },
                                            {
                                                "example_id": "171a24be-00ba-4aa4-9b94-19d7671806c1",
                                                "sense_id": "d2fb1905-e26e-38ad-9bec-e51beb01eaad",
                                                "text": "„Er würde zum Wirt gehen und ihm sagen, dass solche Nutte unmöglich weiter in einem anständigen Hause wohnen könne.“"
                                            },
                                            {
                                                "example_id": "9345cbf6-6509-4871-b216-5d286e74ea56",
                                                "sense_id": "d2fb1905-e26e-38ad-9bec-e51beb01eaad",
                                                "text": "„Am Nebentisch hockten ein paar Nutten.“"
                                            },
                                            {
                                                "example_id": "1d22b5bd-ca3a-4d18-9df6-513ba927aeee",
                                                "sense_id": "d2fb1905-e26e-38ad-9bec-e51beb01eaad",
                                                "text": "„Auf anständige Weise verdient hier keiner sein Geld: Entweder man ist Nutte, Dealer oder Banker.“"
                                            },
                                            {
                                                "example_id": "db05fd60-d399-459b-81d5-a3bf88f8b642",
                                                "sense_id": "d2fb1905-e26e-38ad-9bec-e51beb01eaad",
                                                "text": "„Schicken Sie mir ein paar Nutten und eine Flasche Whiskey mit Eis aufs Zimmer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acc9577b-6eff-4ccc-a324-83db8427f642",
                        "source_entry_id": "ae9aad42-8358-3ba7-94fe-4a4f31065d87",
                        "target_lang_word": "wijf",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wijf",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "da6fda88-00e6-3ffa-b311-40236efb63ae",
                                        "entry_id": "b4057ebe-edbc-3802-af86-e1edfb2f4f6c",
                                        "glosses": [
                                            "vrouw (vaak ook )"
                                        ],
                                        "tags": [
                                            "informal",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ca0050f-0313-4d38-8c3f-4b117baa8551",
                                                "sense_id": "da6fda88-00e6-3ffa-b311-40236efb63ae",
                                                "text": "Wat een lekker wijf!"
                                            },
                                            {
                                                "example_id": "41177f7e-35f5-4f94-acae-e8612042ced2",
                                                "sense_id": "da6fda88-00e6-3ffa-b311-40236efb63ae",
                                                "text": "En ineens stonden ze voor een hol en zagen achterin de gloed van een vuur. Er was een lelijk oud wijf dat, zachtjes mompelend, in een pot boven het vuur stond te roeren."
                                            },
                                            {
                                                "example_id": "7e6e157c-dbdf-49ca-a43d-c7c61b01c9a9",
                                                "sense_id": "da6fda88-00e6-3ffa-b311-40236efb63ae",
                                                "text": "Ook is er kritiek op een van de oprichters van de zender, Lex Harding. Hij zegt in de documentaire dat hij zocht naar \"lekkere wijven, mooie meiden om op televisie te presenteren\". Hij erkent dat het er vroeger anders aan toe ging dan nu. \"Waren opmerkingen overschrijdend naar de maatstaven die nu worden gehanteerd? Zeer zeker. Er werd gevloekt, gescholden en mensen werden uitgelachen.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c2e6742-6acf-3a90-a31f-e1e2cd702d3d",
                                        "entry_id": "b4057ebe-edbc-3802-af86-e1edfb2f4f6c",
                                        "glosses": [
                                            "echtgenote, vrouw [2]"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f017cf32-8d99-4906-a8d5-c5d79b5c7b9b",
                                                "sense_id": "0c2e6742-6acf-3a90-a31f-e1e2cd702d3d",
                                                "text": "En mij zo gunstig eens wou wezen / Van u te maken tot mijn wijf."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
