                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15b7633c-a7cb-4833-a9c2-5d0f1e76f18f",
                                "sense_id": "acbcc5f0-584e-31f6-bbf1-b03d78a89045",
