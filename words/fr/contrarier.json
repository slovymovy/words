                    "semantic_group_id": "artisanat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan commence par <w>contrarier</w> la trame pour consolider l'ouvrage."
                        },
                        {
                            "text": "Cette méthode consiste à <w>contrarier</w> régulièrement chaque fil du tissu."
