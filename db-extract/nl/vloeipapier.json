                        "examples": [
                            {
                                "example_id": "ebfaad62-efd9-4460-a6c9-c4fc61fc1a23",
                                "sense_id": "fa1754bf-5f51-3fc2-be0b-44342b46df62",
                                "text": "Zijn vloeipapier was bijna op, dus ging hij snel naar de winkel."
                            }
                        ]
                    },
                    {
                        "sense_id": "daac6851-a12d-39ee-9d49-4f415f9a005f",
                        "entry_id": "3ab03766-e1ae-3470-ada9-21792b2001cd",
                        "glosses": [
                            "papier om vloeistoffen zoals inkt mee op te zuigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ef2a680-0a41-46ef-a400-d47906b0b893",
                                "sense_id": "daac6851-a12d-39ee-9d49-4f415f9a005f",
                                "text": "De introductie van de balpen en later de computer hebben het vloeipapier praktisch volledig uit de kantoorwereld verdreven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c451043-885d-46b7-8b87-a5cb8492f842",
