                        "entry_id": "b738c2e8-9f52-34ee-a5fc-9808ea0bad6a",
                        "glosses": [
                            "Cathète, côté de l’angle droit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7defcbf-a33c-45be-8fac-1c5be6f3cc18",
                                "sense_id": "cb5e59d9-38c6-3adc-9034-67fd26553c4f",
                                "text": "Ein rechtwinkliges Dreieck hat eine Hypotenuse und zwei Katheten.",
                                "translation": "Un triangle rectangle a une hypoténuse et deux cathètes."
                            },
                            {
                                "example_id": "af068738-0e50-4689-bcb2-2c28e1e62e52",
                                "sense_id": "cb5e59d9-38c6-3adc-9034-67fd26553c4f",
                                "text": "Als Kathete bezeichnet man jede der beiden kürzeren Seiten des rechtwinkligen Dreiecks. Diese beiden Seiten bilden den rechten Winkel.",
                                "translation": "On appelle cathète chacun des deux côtés les plus courts d’un triangle rectangle. Ces deux côtés forment l’angle droit."
                            }
                        ]
                    }
                ],
