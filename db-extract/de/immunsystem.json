                        ],
                        "form": "das Immunsystem"
                    },
                    {
                        "form_id": "05ffebd1-b0e8-425d-94ae-aa016ecf1971",
                        "entry_id": "8dee00f5-5a7f-3530-9319-a0f501ed724c",
                        "tags": [
                            "accusative",
