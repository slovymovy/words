                                    {
                                        "sense_id": "e971458a-f866-3d16-a436-d9a5c2384ff2",
                                        "entry_id": "c7a7c72b-3a1f-3dc7-8ff3-7b06edf4201b",
                                        "glosses": [
                                            "A unisex given name from Hebrew.",
                                            "A male given name from Hebrew; in the Middle Ages given to children baptized with Jordan water brought by crusaders."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52482871-a4f0-400e-bb4e-984f429abf2e",
                                                "sense_id": "e971458a-f866-3d16-a436-d9a5c2384ff2",
                                                "text": "I call him Jordan and it will do. He has no other name before or after. What was there to call him, fished as he was from the stinking Thames? A child can't be called Thames, no and not Nile either, for all his likeness to Moses. But I wanted to give him a river name, a name not bound to anything, just as the waters aren't bound to anything."
                                            },
                                            {
                                                "example_id": "ad1b0e14-1999-46f2-a966-9717e8b072da",
                                                "sense_id": "e971458a-f866-3d16-a436-d9a5c2384ff2",
                                                "text": "Jordan Gee, 37, of Nanticoke, Pennsylvania, was charged with three felony counts of threats against the president and one count of interstate threats, according to the Justice Department."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "441809b2-64fd-3d9c-b85c-78ec5ebb02cf",
