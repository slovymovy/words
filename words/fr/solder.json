                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs années d'efforts, il a enfin réussi à <w>solder</w> son crédit bancaire."
                        },
                        {
                            "text": "L'entreprise a versé le dernier montant requis pour <w>solder</w> son compte chez ce fournisseur."
