                        "moedig",
                        "optimistisch"
                    ],
                    "common_phrases": [
                        "mismoedig stemmen",
                        "mismoedig toekijken"
                    ],
                    "target_lang_definitions": {
                        "en": "With a gloomy, dejected mood; without hope or courage."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "discouraged",
                                "target_lang_sense_clarification": "having lost confidence or hope"
                            },
                            {
                                "target_lang_word": "despondent",
                                "target_lang_sense_clarification": "in low spirits from loss of hope or courage"
                            },
                            {
                                "target_lang_word": "dejected",
                                "target_lang_sense_clarification": "sad and depressed"
                            },
                            {
                                "target_lang_word": "dispirited",
                                "target_lang_sense_clarification": "having lost enthusiasm and hope"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dae42958-ce75-361f-887b-19a956bf480e",
                    "sense_definition": "Wanhopig of geplaagd door diepe wanhoop.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In zijn <w>mismoedige</w> toestand zag hij geen enkele uitweg meer uit de crisis.",
                            "target_lang_translations": {
                                "en": "In his <w>despairing</w> state, he no longer saw any way out of the crisis."
                            }
                        },
                        {
                            "text": "Zij deed een <w>mismoedige</w> poging om de situatie alsnog te redden.",
                            "target_lang_translations": {
                                "en": "She made a <w>half-hearted</w> attempt to salvage the situation anyway."
                            }
                        }
                    ],
                    "synonyms": [
