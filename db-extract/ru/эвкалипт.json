                "senses": [
                    {
                        "sense_id": "335e5fdc-fb32-341c-ba22-f10a84adfd86",
                        "entry_id": "7a2ecf3f-3d37-35f9-a02e-ed1d1411bb27",
                        "glosses": [
                            "ботан. род южных вечнозелёных быстрорастущих деревьев или кустарников из семейства миртовых (Eucalyptus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc2975c6-a22c-4c56-85fe-2f4a1127e482",
                                "sense_id": "335e5fdc-fb32-341c-ba22-f10a84adfd86",
                                "text": "Под высокими зелёными сводами огромных эвкалиптов, миртовых, лавровых и других деревьев, где царил полумрак, подлесок сделался менее густым."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c9ddeb1-6edb-3207-baa7-debc2d8b3f8f",
                        "entry_id": "7a2ecf3f-3d37-35f9-a02e-ed1d1411bb27",
                        "glosses": [
                            "древесина такого дерева"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df9962ea-4a81-4a29-9765-66e12b68d8b8",
                                "sense_id": "7c9ddeb1-6edb-3207-baa7-debc2d8b3f8f",
                                "text": "Первые горные спортивные лыжи изготавливали из ясеня, гикори, эвкалипта."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
