                        "entry_id": "d1add3e1-8133-3af9-9cd7-423812402f22",
                        "glosses": [
                            "Teig zum Backen von Pfannkuchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "becb7ad9-befa-45e2-86ce-c119dfd5c606",
                                "sense_id": "943313d0-3428-35b4-a754-54a5f53bc9ac",
                                "text": "„Shaw ließ den Blick durch den Laden schweifen und roch die Mischung aus heißem Fett, welken Zwiebeln, Speck und Pfannkuchenteig (FRÜHSTÜCK GANZTAGS).“"
                            },
                            {
                                "example_id": "9bebb651-b4af-4fbe-88ac-477357cd712c",
                                "sense_id": "943313d0-3428-35b4-a754-54a5f53bc9ac",
                                "text": "„Sie rührte etwas Pfannkuchenteig an, da Beeder Mackey keine Eier oder Fleisch aß.“"
                            },
                            {
                                "example_id": "4124bf51-bed0-4ab4-98c6-5c64ba515dc4",
                                "sense_id": "943313d0-3428-35b4-a754-54a5f53bc9ac",
                                "text": "„Ich fühle mit Gísli und mache mir Sorgen um ihn, sage ich, blicke von den Seiten auf und stelle fest, dass mein Begleiter jetzt eine schreibunte kurze Hose und ein weißes T-Shirt trägt und am Herd in Pfannkuchenteig rührt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
