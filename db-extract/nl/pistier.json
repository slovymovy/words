                        "examples": [
                            {
                                "example_id": "33eae594-474d-44a0-be91-f7e8dfc45590",
                                "sense_id": "c256868c-3a36-3cbd-9588-5cf8374da0fa",
                                "text": "Je moet ergens een streep zetten, meent hij. Danny Stam stelde zijn afscheid van zijn werk als pistier in de zesdaagsen de laatste jaren steeds weer uit. Dinsdagavond begon de bijna 40-jarige baanwielrenner aan zijn laatste zesdaagse van Rotterdam. Daarna volgen nog Bremen, Berlijn en Kopenhagen en dan zit het er definitief op."
                            },
                            {
                                "example_id": "f5fe8384-c2c6-44f1-b6d2-71cab0bc6009",
                                "sense_id": "c256868c-3a36-3cbd-9588-5cf8374da0fa",
                                "text": "De Nederlandse wielrenner Niki Terpstra zal tijdens de Zesdaagse van Amsterdam een koppel vormen met de Belgische pistier Iljo Keisse. De titelverdedigers hebben hun deelname aan de editie van 2012 toegezegd, meldde de organisatie vandaag."
                            }
                        ]
                    }
