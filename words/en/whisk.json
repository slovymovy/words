{
    "word_family": [
        "whisker",
        "whisking",
        "whiskery"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "77742430-4ed2-32ed-ac41-5215c6435b2d",
                    "sense_definition": "to beat or stir a substance, especially cream or eggs, with a light, rapid movement",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>whisk</w> the egg whites until they form stiff peaks for the meringue.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>взбить</w> яичные белки до устойчивых пиков для меренги."
                            }
                        },
                        {
                            "text": "In a small bowl, <w>whisk</w> the ingredients together to create a smooth dressing.",
                            "target_lang_translations": {
                                "ru": "В небольшой миске <w>взбейте</w> ингредиенты вместе, чтобы получилась однородная заправка."
                            }
                        }
                    ],
                    "synonyms": [
                        "whip",
                        "beat"
                    ],
                    "common_phrases": [
                        "whisk the ingredients together",
                        "whisk the egg whites"
                    ],
                    "target_lang_definitions": {
                        "ru": "взбивать или перемешивать субстанцию (особенно сливки или яйца) быстрыми, легкими движениями"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взбивать",
                                "target_lang_sense_clarification": "кулинарный процесс"
                            },
                            {
                                "target_lang_word": "взболтать",
                                "target_lang_sense_clarification": "смешать ингредиенты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9db40d5-c6a5-3386-9b65-2a84de36165c",
                    "sense_definition": "to take or move someone or something somewhere very quickly and suddenly",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The celebrity was <w>whisked</w> away through a back door to avoid the waiting paparazzi.",
                            "target_lang_translations": {
                                "ru": "Знаменитость быстро <w>увели</w> через заднюю дверь, чтобы избежать ждущих папарацци."
                            }
                        },
                        {
                            "text": "The waiter <w>whisked</w> the plates away as soon as we finished our meal.",
                            "target_lang_translations": {
                                "ru": "Официант <w>унес</w> тарелки, как только мы закончили трапезу."
                            }
                        }
                    ],
                    "synonyms": [
                        "hurry",
                        "rush",
                        "speed"
                    ],
                    "common_phrases": [
                        "whisked away",
                        "whisked off"
                    ],
                    "target_lang_definitions": {
                        "ru": "очень быстро и внезапно переместить кого-либо или что-либо куда-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умчать",
                                "target_lang_sense_clarification": "быстро увезти"
                            },
                            {
                                "target_lang_word": "унести",
                                "target_lang_sense_clarification": "быстро убрать"
                            },
                            {
                                "target_lang_word": "юркнуть",
                                "target_lang_sense_clarification": "быстро скрыться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a95cbd0c-ee7d-3c21-9a19-b9877e89f591",
                    "sense_definition": "to move something with quick, light, sweeping motions",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>whisked</w> the dust off his jacket before entering the meeting room.",
                            "target_lang_translations": {
                                "ru": "Он <w>смахнул</w> пыль со своего пиджака перед тем, как войти в зал заседаний."
                            }
                        },
                        {
                            "text": "The horse <w>whisked</w> its tail to keep the flies away.",
                            "target_lang_translations": {
                                "ru": "Лошадь <w>махнула</w> хвостом, чтобы отогнать мух."
                            }
                        }
                    ],
                    "synonyms": [
                        "sweep",
                        "brush",
                        "flick"
                    ],
                    "common_phrases": [
                        "whisk away dust"
                    ],
                    "target_lang_definitions": {
                        "ru": "двигать чем-либо быстрыми, легкими, смахивающими движениями"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смахивать",
                                "target_lang_sense_clarification": "удалять пыль или капли"
                            },
                            {
                                "target_lang_word": "вихлять",
                                "target_lang_sense_clarification": "о хвосте животного"
                            },
                            {
                                "target_lang_word": "махнуть",
                                "target_lang_sense_clarification": "сделать быстрое движение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed899e7c-347e-3bb6-b1a0-9f1cc8f6c4b5",
                    "sense_definition": "a kitchen tool made of wire loops used for beating eggs or cream",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kitchen_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a wire <w>whisk</w> to make the sauce smooth and creamy.",
                            "target_lang_translations": {
                                "ru": "Она использовала проволочный <w>венчик</w>, чтобы сделать соус однородным и кремообразным."
                            }
                        },
                        {
                            "text": "Make sure you have a balloon <w>whisk</w> ready before you start beating the cream.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что у вас готов <w>венчик</w>, прежде чем начнете взбивать сливки."
                            }
                        }
                    ],
                    "synonyms": [
                        "beater"
                    ],
                    "common_phrases": [
                        "balloon whisk",
                        "wire whisk"
                    ],
                    "target_lang_definitions": {
                        "ru": "кухонный инструмент из проволочных петель для взбивания яиц или сливок"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "венчик",
                                "target_lang_sense_clarification": "кухонная принадлежность"
                            },
                            {
                                "target_lang_word": "взбивалка",
                                "target_lang_sense_clarification": "ручное приспособление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "211bfd36-af6d-30c1-9dbb-296abf40b7cf",
                    "sense_definition": "a quick, light, sweeping movement",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a quick <w>whisk</w> of her hand, she brushed the crumbs off the table.",
                            "target_lang_translations": {
                                "ru": "Быстрым <w>взмахом</w> руки она смахнула крошки со стола."
                            }
                        },
                        {
                            "text": "The cat gave a sudden <w>whisk</w> of its tail and jumped onto the fence.",
                            "target_lang_translations": {
                                "ru": "Кошка внезапно <w>вильнула</w> хвостом и прыгнула на забор."
                            }
                        }
                    ],
                    "synonyms": [
                        "flick",
                        "brush",
                        "sweep"
                    ],
                    "common_phrases": [
                        "quick whisk"
                    ],
                    "target_lang_definitions": {
                        "ru": "быстрое, легкое, смахивающее движение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взмах",
                                "target_lang_sense_clarification": "быстрое движение рукой или хвостом"
                            },
                            {
                                "target_lang_word": "смахивание",
                                "target_lang_sense_clarification": "легкое движение для очистки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f39a92a-8b07-3842-bf78-368f851bd9bf",
                    "sense_definition": "a small brush or broom used for sweeping small areas",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cleaning_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I used a small <w>whisk</w> to clean the sawdust off the workbench.",
                            "target_lang_translations": {
                                "ru": "Я использовал маленькую <w>метёлку</w>, чтобы убрать опилки с верстака."
                            }
                        },
                        {
                            "text": "A handheld <w>whisk</w> is perfect for cleaning crumbs out of car seats.",
                            "target_lang_translations": {
                                "ru": "Ручная <w>щётка</w> идеально подходит для очистки автомобильных сидений от крошек."
                            }
                        }
                    ],
                    "synonyms": [
                        "broom",
                        "brush"
                    ],
                    "common_phrases": [
                        "whisk broom"
                    ],
                    "target_lang_definitions": {
                        "ru": "маленькая щетка или веник для подметания небольших поверхностей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метёлка",
                                "target_lang_sense_clarification": "небольшой веник"
                            },
                            {
                                "target_lang_word": "щётка",
                                "target_lang_sense_clarification": "для уборки крошек или пыли"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}