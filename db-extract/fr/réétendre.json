                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc3b5f36-33a8-4ad9-be7e-452360d927ec",
                                "sense_id": "0d5b88f9-aefa-3792-a227-2f2a70a5217d",
                                "text": "Depuis les nouveaux accords passés entre les deux pays, les lois d’intégration ont été réétendues."
                            },
                            {
                                "example_id": "cc2ef6f3-3bc4-4d21-8fc2-f939dc1a0967",
                                "sense_id": "0d5b88f9-aefa-3792-a227-2f2a70a5217d",
                                "text": "Il serait sûrement opportun de réétendre les objectifs premiers de façon à nous incruster dans les nouveaux marchés."
                            }
                        ]
