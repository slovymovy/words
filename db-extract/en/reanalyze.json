                        "glosses": [
                            "To analyze a lexeme with a different structure from its original, often by misunderstanding."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e6c95ce-bb67-4615-81e4-c6f4a56d6ba4",
                                "sense_id": "8e513e45-ca54-3dfa-8be8-6930edd300d3",
                                "text": "\"SOS\" has, in contemporary usage, been reanalyzed to stand for \"save our souls\"."
                            },
                            {
                                "example_id": "5f74c1b6-736b-4307-a8b7-b18eed8e23f5",
                                "sense_id": "8e513e45-ca54-3dfa-8be8-6930edd300d3",
                                "text": "Thus hamburger (whose true etymology is 'city of Hamburg' + er 'someone from') has been reanalyzed as ham + burger 'burger made with ham.'"
                            }
                        ]
                    }
