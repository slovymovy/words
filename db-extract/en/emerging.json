                                            "copulative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e155e5ce-5ca2-4742-94a5-4d4258970068",
                                                "sense_id": "58eae8cd-1844-3053-baea-2f4399435ab0",
                                                "text": "Het huis bleek veel te groot."
                                            },
                                            {
                                                "example_id": "3b3ff17c-81f9-469e-b1fa-0ccfdf3e7c08",
                                                "sense_id": "58eae8cd-1844-3053-baea-2f4399435ab0",
                                                "text": "De opwarming van de oceanen naar recordtemperaturen heeft het afgelopen jaar tot een dramatische verbleking van de koraalriffen in de oceanen geleid. Wereldwijd lijdt 84 procent van de riffen onder hittestress, meer dan ooit eerder is vastgesteld, blijkt uit onderzoek van landen en gespecialiseerde organisaties in het International Coral Reef Initiative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11adee83-f00c-3df4-ad25-4e82b8694735",
                                        "entry_id": "9560376d-fade-3efa-bcd2-b499facc61cc",
                                        "glosses": [
                                            "~ te zijn uit iets duidelijk (geworden) zijn"
                                        ],
                                        "tags": [
                                            "modal",
                                            "verb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8feff152-1871-4d94-ace4-75287647d25c",
                                                "sense_id": "11adee83-f00c-3df4-ad25-4e82b8694735",
                                                "text": "Hij bleek vroeger in Nederlands Nieuw-Guinea geweest te zijn."
                                            },
                                            {
                                                "example_id": "ddf44c11-3a01-48b3-a850-99e3aca115cd",
                                                "sense_id": "11adee83-f00c-3df4-ad25-4e82b8694735",
                                                "text": "Hoe vrouwen het aanpakten tijdens hun menstruatie weet ik niet precies. Er bestaat een speciale PCT-vrouwenfacebookgroep (women of the PCT) waar onderling tips en tricks over dit soort onderwerpen worden gedeeld. Ik heb er tijdens de tocht niemand over horen praten dus voor alles blijkt een adequate oplossing te zijn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "327d615a-4651-3efc-b316-48ad2cb6d371",
                                        "entry_id": "9560376d-fade-3efa-bcd2-b499facc61cc",
                                        "glosses": [
                                            "naar buiten zichtbaar laten worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52829cb0-0ff6-4b4a-a910-5a1a0aace4d4",
                                                "sense_id": "327d615a-4651-3efc-b316-48ad2cb6d371",
                                                "text": "Geen van deze jonge voetballertjes dacht aan zoiets triviaals als kou. Tenminste, niemand liet dat blijken."
                                            },
                                            {
                                                "example_id": "355e98f9-e22f-4285-bd0b-140e237fc16e",
                                                "sense_id": "327d615a-4651-3efc-b316-48ad2cb6d371",
                                                "text": "Het hoofd van de Rooms-Katholieke Kerk in Nederland, kardinaal Eijk, zegt dat paus Franciscus een groot hart had voor de zwakkeren in de samenleving. \"Dat liet hij steeds weer blijken in zijn teksten en door de bezoeken die hij bracht.\""
                                            }
                                        ]
                                    }
                                ]
