                        "glosses": [
                            "de felle zon die schijnt in een woestijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c17766a-ad01-4ae2-a40a-106e1a10c566",
                                "sense_id": "a8b82a68-0843-348a-a65e-9ca74ffd46a8",
                                "text": "De woestijnzon brandde genadeloos op hen neer en de luchttemperatuur liep tegen de veertig graden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
