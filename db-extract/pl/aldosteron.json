                        "entry_id": "3c9f6474-95f0-3f61-9d8d-9310700e455a",
                        "glosses": [
                            "hormon sterydowy wytwarzany przez warstwę kłębkowatą kory nadnerczy, należący do grupy mineralokortykoidów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5152ab04-809f-4317-88b2-4315e4298d8f",
                                "sense_id": "e51c6c76-8069-3c3f-99e4-95781db94a11",
                                "text": "Januszowi zbadają poziom aldosteronu i kortyzolu, gdyż wykryli mu przypadkowo guz nadnercza w badaniu TK."
                            },
                            {
                                "example_id": "14106539-9901-4d2a-8e45-880795e2933b",
                                "sense_id": "e51c6c76-8069-3c3f-99e4-95781db94a11",
                                "text": "Nadmierne wydzielanie aldosteronu przez nadnercza zmniejsza nerkowe wydalanie Na⁺, zwiększa natomiast wydalanie z moczem K⁺, Mg₂⁺ i NH₄⁺."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
