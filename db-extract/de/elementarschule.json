                "senses": [
                    {
                        "sense_id": "c64564a7-e4a6-3f34-bb2a-acbaa8c3fca0",
                        "entry_id": "aee60e20-b473-3fd5-afc3-1eed5b90b94c",
                        "glosses": [
                            "Schule, deren Gegenstand die Vermittlung grundlegender Kenntnisse ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1ba2db7-430c-4c08-b117-a9d0adff895f",
                                "sense_id": "c64564a7-e4a6-3f34-bb2a-acbaa8c3fca0",
                                "text": "„Viel bedeutsamer aber war die Tatsache, daß nach den Ideen Ratkes durch diese Schulordnung der herkömmlichen Lateinschule eine reguläre Elementarschule vorangestellt wurde und daß diese als allgemeine Volksschule neue Möglichkeiten des deutschen Unterrichts über den Anfangs- und Katechismusunterricht hinaus eröffnete.“"
                            },
                            {
                                "example_id": "1441f3ac-5c83-4841-857b-ecb555c16c21",
                                "sense_id": "c64564a7-e4a6-3f34-bb2a-acbaa8c3fca0",
                                "text": "„In der Elementarschule, die Wilhelm Ostwald gemeinsam mit russischen und lettischen Kindern besuchte, erreichte er gute Leistungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
