                        "source_entry_id": "83a304f4-912b-3a0d-b7ce-ad710cde61e7",
                        "source_sense_id": "f52a3da1-3dc5-3aa2-9fc5-42d7b908445e",
                        "target_lang_word": "пенсионер",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пенсионер",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "eb5d0ade-7439-3a53-befe-d38d45f487be",
                                        "entry_id": "3277c2a1-e5de-3e2c-a6bf-2260c869a7d6",
                                        "glosses": [
                                            "человек, получающий пенсию"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfe42273-38f3-4438-b34a-c844f872f6c0",
                                                "sense_id": "eb5d0ade-7439-3a53-befe-d38d45f487be",
                                                "text": "Ганчук упирал на то, что он персональный пенсионер, что ему восемьдесят шесть и он может умереть каждый миг, а привратник хриплым, злобным голосом орал, что он тоже человек и хочет приходить домой вовремя."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaeb0f9a-63dc-3702-bf4e-e4ca61e50e31",
                                        "entry_id": "3277c2a1-e5de-3e2c-a6bf-2260c869a7d6",
                                        "glosses": [
                                            "перен., разг. пожилой человек"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bbb44342-340f-3401-a6a3-547ba7743975",
                                        "entry_id": "3277c2a1-e5de-3e2c-a6bf-2260c869a7d6",
                                        "glosses": [
                                            "истор. выпускник Императорской академии художеств, получавший денежное пособие (пенсион) для дополнительного совершенствования мастерства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4d03a73-7cef-400d-b6c9-5e73a2604466",
                                                "sense_id": "bbb44342-340f-3401-a6a3-547ba7743975",
                                                "text": "Я сам себе не верю: я ― пенсионер академии, художник, едущий на четыре года за границу совершенствоваться в искусстве. Vivat Academia!"
                                            },
                                            {
                                                "example_id": "69a3368f-162b-425c-be8c-4fe80eb0697e",
                                                "sense_id": "bbb44342-340f-3401-a6a3-547ba7743975",
                                                "text": "Но настало время весеннее, надо было идти на конкурс, то есть на жизнь или на смерть, на Первую золотую медаль, чтобы быть пенсионером Академии."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
