{
    "word_family": [
        "interrogate",
        "interrogator",
        "interrogative",
        "interrogatory"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f940e0d0-6324-3050-a8ae-e8304d59d4fb",
                    "sense_definition": "The act of asking someone a lot of questions for a long time in order to get information, often used in police or military contexts.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "act_of_questioning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police kept the suspect under <w>interrogation</w> for several hours.",
                            "target_lang_translations": {
                                "ru": "Полиция держала подозреваемого на <w>допросе</w> в течение нескольких часов.",
                                "tr": "Polis, şüpheliyi birkaç saat boyunca <w>sorgu</w> altında tuttu."
                            }
                        },
                        {
                            "text": "She refused to answer any questions during the <w>interrogation</w> without her lawyer present.",
                            "target_lang_translations": {
                                "ru": "Она отказалась отвечать на вопросы во время <w>допроса</w> без присутствия своего адвоката.",
                                "tr": "Avukatı hazır bulunmadan <w>sorgu</w> sırasında hiçbir soruya cevap vermeyi reddetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "questioning",
                        "examination"
                    ],
                    "common_phrases": [
                        "police interrogation",
                        "under interrogation",
                        "interrogation room"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс длительного и тщательного задавания вопросов с целью получения информации, часто используется в полиции или военных контекстах.",
                        "tr": "Bir kimseden bilgi almak amacıyla uzun süre boyunca çok sayıda soru sorma eylemi; genellikle polis veya askeri bağlamlarda kullanılır."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "допро́с",
                                "target_lang_sense_clarification": "официальная процедура, допрос подозреваемого"
                            },
                            {
                                "target_lang_word": "опро́с",
                                "target_lang_sense_clarification": "сбор сведений, опрос свидетелей"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sorgu",
                                "target_lang_sense_clarification": "resmi veya hukuki bağlamda sorgulama"
                            },
                            {
                                "target_lang_word": "sorgulama",
                                "target_lang_sense_clarification": "birini detaylıca sorguya çekme eylemi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32504c81-6473-312a-bb4d-399561d84a98",
                    "sense_definition": "A specific question or inquiry.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "act_of_questioning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His repeated <w>interrogations</w> about the missing money made everyone uncomfortable.",
                            "target_lang_translations": {
                                "ru": "Его постоянные <w>расспросы</w> о пропавших деньгах заставили всех чувствовать себя неловко.",
                                "tr": "Kayıp para hakkındaki tekrarlayan <w>sorgu sualleri</w> herkesi rahatsız etti."
                            }
                        },
                        {
                            "text": "She responded to his <w>interrogation</w> with a simple nod.",
                            "target_lang_translations": {
                                "ru": "Она ответила на его <w>вопрос</w> простым кивком.",
                                "tr": "Onun <w>sorgusuna</w> basit bir baş sallamasıyla yanıt verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "question",
                        "inquiry",
                        "query"
                    ],
                    "antonyms": [
                        "answer",
                        "reply"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный вопрос или настойчивое выспрашивание.",
                        "tr": "Belirli bir soru veya araştırma; ısrarlı bir şekilde soru sorma."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вопро́с",
                                "target_lang_sense_clarification": "отдельный вопрос"
                            },
                            {
                                "target_lang_word": "допро́с",
                                "target_lang_sense_clarification": "перен. настойчивые, назойливые вопросы"
                            },
                            {
                                "target_lang_word": "расспро́сы",
                                "target_lang_sense_clarification": "мн. ч. подробное выспрашивание"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "soru",
                                "target_lang_sense_clarification": "yöneltilen bir soru"
                            },
                            {
                                "target_lang_word": "sorgu sual",
                                "target_lang_sense_clarification": "ısrarlı ve detaylı soru sorma"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f206505-36db-395f-9302-5e427a9f6baa",
                    "sense_definition": "A punctuation mark (?) used to indicate a question.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The note of <w>interrogation</w> at the end of the sentence changed its meaning.",
                            "target_lang_translations": {
                                "ru": "Знак <w>вопроса</w> в конце предложения изменил его смысл.",
                                "tr": "Cümlenin sonundaki <w>soru işareti</w> anlamını değiştirdi."
                            }
                        },
                        {
                            "text": "In older texts, this symbol is sometimes called a point of <w>interrogation</w>.",
                            "target_lang_translations": {
                                "ru": "В старых текстах этот символ иногда называют знаком <w>вопроса</w>.",
                                "tr": "Eski metinlerde bu sembole bazen <w>soru işareti</w> denir."
                            }
                        }
                    ],
                    "synonyms": [
                        "question mark"
                    ],
                    "common_phrases": [
                        "note of interrogation",
                        "point of interrogation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знак препинания (?), используемый для обозначения вопроса.",
                        "tr": "Bir soruyu belirtmek için kullanılan noktalama işareti (?)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вопроси́тельный знак",
                                "target_lang_sense_clarification": "знак препинания"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "soru işareti",
                                "target_lang_sense_clarification": "noktalama işareti"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}