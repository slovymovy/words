{
    "word_family": [
        "sagging",
        "saggy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "abc25367-4c27-3764-8c77-59b42ac70f70",
                    "sense_definition": "To sink or bend downward in the middle, especially under weight or pressure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_sinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wooden shelf began to <w>sag</w> under the weight of the heavy books.",
                            "target_lang_translations": {
                                "ru": "Старая деревянная полка начала <w>прогибаться</w> под тяжестью тяжелых книг."
                            }
                        },
                        {
                            "text": "If you don't tighten the clothesline, it will <w>sag</w> in the middle.",
                            "target_lang_translations": {
                                "ru": "Если не натянуть бельевую веревку, она будет <w>провисать</w> посередине."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sag in the middle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прогибаться или опускаться посередине, особенно под воздействием веса или давления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогибаться",
                                "target_lang_sense_clarification": "под весом"
                            },
                            {
                                "target_lang_word": "проседать",
                                "target_lang_sense_clarification": "о конструкции"
                            },
                            {
                                "target_lang_word": "обвисать",
                                "target_lang_sense_clarification": "о веревке или ткани"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3154ad97-6bd4-3d61-bd24-94d36cbda9ae",
                    "sense_definition": "To lean, settle, or give way from a vertical position.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_sinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy gate started to <w>sag</w> on its hinges after years of use.",
                            "target_lang_translations": {
                                "ru": "Тяжелые ворота начали <w>перекашиваться</w> на петлях после многих лет использования."
                            }
                        },
                        {
                            "text": "The old barn began to <w>sag</w> to one side during the storm.",
                            "target_lang_translations": {
                                "ru": "Старый сарай начал <w>крениться</w> набок во время шторма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sag on its hinges"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наклоняться, оседать или смещаться из вертикального положения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перекашиваться",
                                "target_lang_sense_clarification": "о строении или воротах"
                            },
                            {
                                "target_lang_word": "оседать",
                                "target_lang_sense_clarification": "терять устойчивость"
                            },
                            {
                                "target_lang_word": "крениться",
                                "target_lang_sense_clarification": "на бок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3299f4f8-67e7-3923-a328-920523dc0a62",
                    "sense_definition": "To lose firmness, vigor, or spirits; to droop or flag.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His spirits began to <w>sag</w> as the long day of failures continued.",
                            "target_lang_translations": {
                                "ru": "Его присутствие духа начало <w>падать</w> по мере того, как продолжался долгий день неудач."
                            }
                        },
                        {
                            "text": "The team's energy started to <w>sag</w> in the final minutes of the match.",
                            "target_lang_translations": {
                                "ru": "Энергия команды начала <w>иссякать</w> на последних минутах матча."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Терять твердость, бодрость или дух; слабеть или угасать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "падать",
                                "target_lang_sense_clarification": "о духе или настроении"
                            },
                            {
                                "target_lang_word": "ослабевать",
                                "target_lang_sense_clarification": "об энергии или интересе"
                            },
                            {
                                "target_lang_word": "снижаться",
                                "target_lang_sense_clarification": "о показателях или темпе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ab37bf5-a765-3d8f-9cf3-9733ae5869bd",
                    "sense_definition": "To wear one's trousers so that the waist sits well below the hips.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fashion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school principal told the students they were not allowed to <w>sag</w> their pants.",
                            "target_lang_translations": {
                                "ru": "Директор школы сказал ученикам, что им запрещено <w>носить приспущенные штаны</w>."
                            }
                        },
                        {
                            "text": "He chose to <w>sag</w> his jeans as part of his personal style.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>носить джинсы низко</w> как часть своего личного стиля."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sag your pants"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "refers to a specific fashion style"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Носить брюки так, чтобы пояс находился значительно ниже бедер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "носить штаны с низкой посадкой",
                                "target_lang_sense_clarification": "стиль одежды"
                            },
                            {
                                "target_lang_word": "приспускать штаны",
                                "target_lang_sense_clarification": "намеренно"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b9a0d012-66d7-3f70-83cb-cccb9d89e254",
                    "sense_definition": "The state or instance of sinking, bending, or drooping.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_sinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer noticed a slight <w>sag</w> in the bridge's support beams.",
