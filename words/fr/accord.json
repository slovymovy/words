    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "28765dcd-0f68-3c83-b639-302bdf134aed",
                    "sense_definition": "Entente ou conformité de sentiments, d'idées ou de volontés entre plusieurs personnes.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "entente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont pris cette décision importante d'un commun <w>accord</w> après une longue discussion."
                        },
                        {
                            "text": "Les deux amis vivent toujours dans un parfait <w>accord</w> et partagent les mêmes valeurs."
                        }
                    ],
                    "synonyms": [
                        "entente",
                        "harmonie"
                    ],
                    "antonyms": [
                        "désaccord"
                    ],
                    "common_phrases": [
                        "commun accord",
                        "parfait accord"
                    ]
                },
                {
                    "sense_id": "5d2de58d-121a-37a0-b2b6-1e00ab71152b",
                    "sense_definition": "Convention, traité ou pacte conclu entre des personnes, des organisations ou des États pour régler une situation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "traite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux pays ont finalement signé un <w>accord</w> de paix pour stopper la guerre."
                        },
                        {
                            "text": "La direction et les salariés viennent de conclure un <w>accord</w> sur les conditions de travail."
                        }
                    ],
                    "synonyms": [
                        "convention",
                        "pacte",
                        "traité",
                        "compromis"
                    ],
                    "common_phrases": [
                        "signer un accord",
                        "conclure un accord",
                        "accord de paix"
                    ]
                },
                {
                    "sense_id": "350a20d8-2bc8-35cf-8be9-7f75a2635d38",
                    "sense_definition": "Approbation explicite, autorisation ou consentement donné à une proposition ou à une démarche.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "consentement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a donné son <w>accord</w> pour commencer les travaux dès lundi matin."
                        },
                        {
                            "text": "Vous ne pouvez pas publier ce texte sans l'<w>accord</w> écrit de son auteur."
                        }
                    ],
                    "synonyms": [
                        "approbation",
                        "autorisation",
                        "consentement",
                        "assentiment"
                    ],
                    "antonyms": [
                        "refus"
                    ],
                    "common_phrases": [
                        "donner son accord",
                        "sans son accord"
                    ]
                },
                {
                    "sense_id": "e2831c96-26b6-3394-a96d-0617fc453900",
                    "sense_definition": "Règle ou fait de faire concorder les mots entre eux en genre, en nombre ou en personne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur explique la règle de l'<w>accord</w> du participe passé aux élèves attentifs."
                        },
                        {
                            "text": "Cet élève commet souvent des erreurs d'<w>accord</w> grammatical dans ses rédactions scolaires."
                        }
                    ],
                    "common_phrases": [
                        "accord du participe",
                        "accord grammatical"
                    ]
                },
                {
                    "sense_id": "63c6eaf5-772d-344c-8af7-9e182a54272d",
                    "sense_definition": "Combinaison simultanée de plusieurs sons ou notes de musique formant un ensemble harmonique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pianiste commence son morceau en jouant un bel <w>accord</w> majeur."
                        },
                        {
                            "text": "Elle apprend à enchaîner plusieurs <w>accords</w> de guitare pour accompagner son chant."
                        }
                    ],
                    "common_phrases": [
                        "accord parfait",
                        "accords de guitare"
                    ]
                },
                {
                    "sense_id": "55826632-f686-3fc6-b0ff-f82eb036d320",
                    "sense_definition": "Harmonie, juste rapport ou cohérence esthétique ou logique entre plusieurs éléments.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "harmonie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il n'y a aucun véritable <w>accord</w> entre ses belles promesses et ses actions réelles."
                        },
                        {
                            "text": "L'architecte a créé un remarquable <w>accord</w> entre cette maison moderne et le paysage boisé."
                        }
                    ],
                    "synonyms": [
                        "cohérence",
                        "concordance",
                        "harmonie"
                    ],
                    "antonyms": [
                        "discordance",
                        "contradiction"
                    ],
                    "common_phrases": [
                        "parfait accord"
                    ]
                }
            ]
        }
    ]
