                "senses": [
                    {
                        "sense_id": "a1afc0a3-51e4-36a7-8456-6541cd7c792f",
                        "entry_id": "a5b168b4-1564-3a09-b6e6-0d528e44d5f0",
                        "glosses": [
                            "jemand, der mit Graffitis Kunst produziert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "507cbee5-f020-4353-ad8a-ac84241bce2e",
                                "sense_id": "a1afc0a3-51e4-36a7-8456-6541cd7c792f",
                                "text": "„Der Münchner Graffiti-Künstler Mathias Köhler alias „Loomit“ hat im Allgäu einen Hochsilo mit einem Milch-Kunstwerk gestaltet.“"
                            },
                            {
                                "example_id": "5144f325-7043-4f7b-92a9-b7256c77041b",
                                "sense_id": "a1afc0a3-51e4-36a7-8456-6541cd7c792f",
                                "text": "„Übrigens: Als Sprayer machen Sie sich strafbar - da ist es doch weitaus bequemer, Graffiti-Künstler im Geiste zu sein und sich \"Concrete Flower\" aufsprühen.“"
                            },
                            {
                                "example_id": "a35120e6-1595-4895-8d2a-09cf25732cef",
                                "sense_id": "a1afc0a3-51e4-36a7-8456-6541cd7c792f",
                                "text": "„Die in Berlin erscheinende \"Tageszeitung\" (taz) berichtet, dass die Stadt Heidelberg den schweizerischen Graffiti-Künstler Harald Naegeli beauftragt, unbeabsichtigt entfernte Wandbilder wieder aufzusprühen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
