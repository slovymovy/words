                "translations": [
                    {
                        "translation_id": "189e268a-b5d9-47ce-b92d-1e944b7ff344",
                        "source_entry_id": "a4268e2b-46e6-3a30-9e0f-5939f8099c52",
                        "source_sense_id": "f5cdc937-09f7-39c3-85d4-f4e903756e2f",
                        "target_lang_word": "overwork",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overwork",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85ae295a-29ae-3592-ba46-31024472cb77",
                                        "entry_id": "01907f6b-c17f-35c8-a4bf-30c13e798c64",
                                        "glosses": [
                                            "To make (someone or something) work too hard."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1570dce1-59b7-40ad-b049-b3ef9e582d4b",
                                                "sense_id": "85ae295a-29ae-3592-ba46-31024472cb77",
                                                "text": "to overwork a horse"
                                            },
                                            {
                                                "example_id": "188732e2-d17d-453e-bac5-20c8f833712c",
                                                "sense_id": "85ae295a-29ae-3592-ba46-31024472cb77",
                                                "text": "For some years locomotives and coaches have been overworked and undermaintained to a degree without precedent in British railway history, and the leeway in maintenance now to be made up is very great."
                                            },
                                            {
                                                "example_id": "6835ceaa-473e-42e1-b4a4-99ec7573bdf0",
                                                "sense_id": "85ae295a-29ae-3592-ba46-31024472cb77",
                                                "text": "The cracking sound, he explained, as far as I, a non-plumber, could understand, was the sound of the overworked, undermaintained and weirdly installed heating unit’s core rupturing and spilling water into the basement."
                                            },
                                            {
                                                "example_id": "88120dec-cd84-442d-8313-a90c723f8dff",
                                                "sense_id": "85ae295a-29ae-3592-ba46-31024472cb77",
                                                "text": "If you live in Washington D.C., Houston or Atlanta, it might be time to take a vacation.\nThose three cities, followed by Seattle and Chicago, are the most overworked cities in the United States, according to a study released by the mobile technology company Kisi this past week."
                                            },
                                            {
                                                "example_id": "bbe12dd3-6fb5-496b-8ea3-8385a64808ce",
                                                "sense_id": "85ae295a-29ae-3592-ba46-31024472cb77",
                                                "text": "It turns out that overworking your brain with either physical or mental exercise may lower your ability to delay self-gratification."
                                            },
                                            {
                                                "example_id": "38ec8d5a-2dfd-4bca-ab12-ec04fa507b17",
                                                "sense_id": "85ae295a-29ae-3592-ba46-31024472cb77",
                                                "text": "One of China’s most prominent e-commerce companies is facing intense public backlash over allegations that it overworks its employees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae9a955f-b578-382b-8658-020160146f55",
                                        "entry_id": "01907f6b-c17f-35c8-a4bf-30c13e798c64",
                                        "glosses": [
                                            "To work too hard."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b90a5204-c028-34b2-9d8e-783e892d7043",
                                        "entry_id": "01907f6b-c17f-35c8-a4bf-30c13e798c64",
                                        "glosses": [
                                            "To fill too full of work; to crowd with labour."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb5b7e1c-7bd1-4de9-aa21-ff95e622550b",
                                                "sense_id": "b90a5204-c028-34b2-9d8e-783e892d7043",
                                                "text": "My days with toil are overwrought."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85e3bd78-03a3-3cf1-a8dc-deee619f283a",
                                        "entry_id": "01907f6b-c17f-35c8-a4bf-30c13e798c64",
                                        "glosses": [
                                            "To decorate all over."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "overwork",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee267332-90ac-3a9d-a34d-c98d2e3afbd9",
                                        "entry_id": "9303a369-b99d-3c4f-b759-305dc21e1706",
                                        "glosses": [
                                            "A superstructure."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6e3d05d-c68a-3da0-9a18-26e0d6e85002",
                                        "entry_id": "9303a369-b99d-3c4f-b759-305dc21e1706",
                                        "glosses": [
                                            "Excessive work."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60a8ff3f-0321-4f53-8727-5af7959cdbff",
                                                "sense_id": "d6e3d05d-c68a-3da0-9a18-26e0d6e85002",
                                                "text": "Various disordered conditions consequent upon overwork, which are characteristic of modern civilisation."
                                            },
                                            {
                                                "example_id": "5f0425dd-aa04-451a-b463-fa7ae8fa4785",
                                                "sense_id": "d6e3d05d-c68a-3da0-9a18-26e0d6e85002",
                                                "text": "He says that more men are killed by overwork than the importance of this world justifies. He maintains that overwork slew Pansay who died under his hands about three years ago."
                                            },
                                            {
                                                "example_id": "82d5254c-4d34-4162-aa06-4cf651d150ac",
                                                "sense_id": "d6e3d05d-c68a-3da0-9a18-26e0d6e85002",
                                                "text": "[…] it had obtained from its constituents rather antiquated and inefficient equipment, which scarcely stood up to overwork; […]."
                                            },
                                            {
                                                "example_id": "e55f1491-a746-4327-9602-fec052169c8a",
                                                "sense_id": "d6e3d05d-c68a-3da0-9a18-26e0d6e85002",
                                                "text": "When it comes to overwork, denial looms large."
                                            },
                                            {
                                                "example_id": "6c792dee-5876-4869-9b72-114dd17ae876",
                                                "sense_id": "d6e3d05d-c68a-3da0-9a18-26e0d6e85002",
                                                "text": "The Japanese term for sudden death from overwork."
                                            },
                                            {
                                                "example_id": "90ca9e3e-5709-41b2-b27e-d5ae844cae6b",
                                                "sense_id": "d6e3d05d-c68a-3da0-9a18-26e0d6e85002",
                                                "text": "In July, the government legislated to reduce the maximum working hours from a staggering 68 per week to 40, with 12 hours of paid overtime, in what President Moon Jae-in said would be an “important opportunity to move away from a society of overwork and move toward a society of spending time with families.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f059c2b1-81fe-43ec-bc98-ad48156ad2d2",
                        "source_entry_id": "a4268e2b-46e6-3a30-9e0f-5939f8099c52",
                        "source_sense_id": "f5cdc937-09f7-39c3-85d4-f4e903756e2f",
                        "target_lang_word": "Überarbeitung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überarbeitung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f004ea2-95e0-3837-a372-34807dc1566c",
                                        "entry_id": "c68a3679-d4b2-3c1c-8a80-b80d1cc80e7e",
                                        "glosses": [
                                            "Vorgang oder Ergebnis von Kontrolle und gegebenenfalls Verbesserung bereits erarbeiteter Gegenstände oder Werke (Komposition, Plastik, Text und dergleichen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b41af221-994e-47f1-bca6-c1e0ce82dd6c",
                                                "sense_id": "8f004ea2-95e0-3837-a372-34807dc1566c",
                                                "text": "„Ich fürchte, eine solche Überarbeitung könnte die Authentizität und Aussagekraft beeinträchtigen.“"
                                            },
                                            {
                                                "example_id": "7bc90608-eec9-478c-a54c-faeae4a0b087",
                                                "sense_id": "8f004ea2-95e0-3837-a372-34807dc1566c",
                                                "text": "„Aber auch Wieland ließ in seiner Überarbeitung die Zeile nicht stehen – wie Manches nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a80fb017-286e-36f0-bebc-28f76d539b2b",
                                        "entry_id": "c68a3679-d4b2-3c1c-8a80-b80d1cc80e7e",
                                        "glosses": [
                                            "physische und/oder psychische Überanstrengung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56e9d308-ce14-4200-97da-2c7b3c59ee60",
                                                "sense_id": "a80fb017-286e-36f0-bebc-28f76d539b2b",
                                                "text": "Infolge der andauernden Überarbeitung musste sie eine längere Pause einlegen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
