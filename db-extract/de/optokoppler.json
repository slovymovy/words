                "senses": [
                    {
                        "sense_id": "f1b03754-7a93-3d65-8a7d-30a445f186ef",
                        "entry_id": "144383ac-c622-3f2f-a3dd-64c6dc306814",
                        "glosses": [
                            "elektronisches Bauelement, mit dem Signale zwischen zwei galvanisch getrennten Stromkreisen übertragen werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48ed9ff7-de69-4972-91fd-ac948c9fa2ec",
                                "sense_id": "f1b03754-7a93-3d65-8a7d-30a445f186ef",
                                "text": "„Den Ist-Zustand der Ausgangsspannungen erfährt der Controller über Optokoppler galvanisch getrennt von den Sekundärstromkreisen.“"
                            },
                            {
                                "example_id": "f2d43cf3-589e-4c5e-a009-bd6fbf60fef2",
                                "sense_id": "f1b03754-7a93-3d65-8a7d-30a445f186ef",
                                "text": "„Thoralf Gebel, Lars Rebohle und Wolfgang Skorupa vom Forschungszentrum Rossendorf (FZR) in Dresden stellen auf der Hannover Messe den weltweit ersten integrierten Optokoppler auf Siliziumbasis vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
