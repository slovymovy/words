                "senses": [
                    {
                        "sense_id": "8acd6692-7d4a-35e4-ada9-b9b60d9fd213",
                        "entry_id": "a2ae9d0c-1801-387b-83bb-be6590a36d09",
                        "glosses": [
                            "een muts die goed beschermt tegen de kou en dus speciaal geschikt is voor schaatsers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "524ee529-b862-4947-8f71-aeae9d7e73a9",
                                "sense_id": "8acd6692-7d4a-35e4-ada9-b9b60d9fd213",
                                "text": "In zijn werkkamer bleef zijn blik soms hangen aan een foto van Mickey Rourke. Mickey Rourke met een ijsmuts op, in een boksring ergens in Duitsland."
                            },
                            {
                                "example_id": "329d68b7-8b1b-4112-9e4b-26ecf7a63eb2",
                                "sense_id": "8acd6692-7d4a-35e4-ada9-b9b60d9fd213",
                                "text": "Inwendig zichzelf verwensend, ging hij naar buiten, zijn winterjas aan, een ijsmuts op, een dikke sjaal om zijn hals gewikkeld en een zonnebril op zijn neus om het zonlicht zoveel mogelijk buiten te sluiten. Wat hielp, was dat hij zich zelden zo ellendig had gevoeld."
                            }
                        ]
                    }
