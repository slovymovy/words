                "senses": [
                    {
                        "sense_id": "5acac8ba-3e6a-35fb-866d-2e531cb4476d",
                        "entry_id": "1e325af0-54e7-3abd-a59c-140c9be6f999",
                        "glosses": [
                            "op een zekere afstand van de genoemde plaats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c509a9f-be6d-4563-95b2-88e5e3c6aa64",
                                "sense_id": "5acac8ba-3e6a-35fb-866d-2e531cb4476d",
                                "text": "De splitsing is ongeveer twee kilometer verderop."
                            },
                            {
                                "example_id": "16ecfd13-af43-4849-9a42-a699c9c53854",
                                "sense_id": "5acac8ba-3e6a-35fb-866d-2e531cb4476d",
                                "text": "Verderop is een ruime zwier omhoog naar rechts, dit is wat renners een moordenaar noemen. Maar het lijkt er ook op dat zich daar de bevrijding aandient. Een strakblauwe hemel domineert in het blikveld, het is alsof de sparren respectvol uit zicht blijven. De weldaad van een kale vlakte volgt."
                            },
                            {
                                "example_id": "a14026d3-5a20-49d3-a2b0-3eca8092d734",
                                "sense_id": "5acac8ba-3e6a-35fb-866d-2e531cb4476d",
                                "text": "Toen ik de laatste scheerlijn de harde grond in stak, zag ik tot mijn verbazing Goldie verderop onder een struik liggen."
                            }
                        ]
                    }
                ],
