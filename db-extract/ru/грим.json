                                "target_senses": [
                                    {
                                        "sense_id": "f25b6416-ff02-34bb-af39-39b9590d3cda",
                                        "entry_id": "c7c3f9bc-07a5-3c93-a968-2f199bcfbdc4",
                                        "glosses": [
                                            "Enduit qu’on applique sur la peau ou une partie du visage pour la colorer ou pour la protéger."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd2e4281-8a37-45b1-8e25-783e07005863",
                                                "sense_id": "f25b6416-ff02-34bb-af39-39b9590d3cda",
                                                "text": "Une petite boîte de bois rose, qui venait de l’île Dioscoride, contenait des fards de toutes les couleurs."
                                            },
                                            {
                                                "example_id": "56935a23-89d8-4547-bbe5-fa48c0927ae8",
                                                "sense_id": "f25b6416-ff02-34bb-af39-39b9590d3cda",
                                                "text": "Elle achetait les onguents, des pots de fard, des crayons, qui traînaient sur tous les meubles, avec des houppettes de poudre de riz et des flacons d’odeur. Ses journées, elle les passait, devant sa glace, à se maquiller, à se contempler […]"
                                            },
                                            {
                                                "example_id": "327812ed-9b45-422f-9f0c-047a6f41d16b",
                                                "sense_id": "f25b6416-ff02-34bb-af39-39b9590d3cda",
                                                "text": "L’emploi des fards que l’on applique sur la figure pour en modifier l’aspect doit être fait avec la plus extrême prudence […] il serait délicat d’insister sur l’apparence regrettable qu’ont pris certains visages féminins qui ont été trop longtemps exposés aux attaques des fards ; ceux-ci ont pu à un certain moment donner un éclat particulier au visage, mais ils l’ont souvent irrémédiablement flétri."
                                            },
                                            {
                                                "example_id": "3551334a-7892-409f-81f9-dc3e68309a76",
                                                "sense_id": "f25b6416-ff02-34bb-af39-39b9590d3cda",
                                                "text": "Je vis que sa beauté, comme son caractère, était absolument sans fard. Ni rouge aux lèvres, ni fer aux cheveux ; rien aux cils ni aux paupières."
                                            },
                                            {
                                                "example_id": "1e1ccf88-8945-4908-9379-29827004e2c3",
                                                "sense_id": "f25b6416-ff02-34bb-af39-39b9590d3cda",
                                                "text": "Ses airs penchés, sa ravissante et luxueuse pochette de soie, son bracelet-montre en or, le fard étalé sur ses joues le tenaient quitte de manifester son opinion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f765585c-958f-321d-930b-45cc8b670537",
                                        "entry_id": "c7c3f9bc-07a5-3c93-a968-2f199bcfbdc4",
                                        "glosses": [
                                            "Déguisement, feinte, dissimulation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "434cc75b-3732-4c06-b02a-c50479adce89",
                                                "sense_id": "f765585c-958f-321d-930b-45cc8b670537",
                                                "text": "Privé de tout accommodement, de ses fards, de ses sourires et de ses ruses, le vice a peu de chance de séduire la vertu la plus chancelante."
                                            },
                                            {
                                                "example_id": "337a0550-fa1d-4de0-8b7b-cd6f8e79e673",
                                                "sense_id": "f765585c-958f-321d-930b-45cc8b670537",
                                                "text": "Livres, discours, manifestes, la remise en cause de cet esprit qui a irrigué le XVIIIᵉ siècle autour des figures totémiques de Voltaire, de Rousseau, de Kant et de l’Encyclopédie de Diderot et d’Alembert, ce mouvement fondateur de la modernité politique européenne et matrice intellectuelle de la Révolution française, s’affiche aujourd’hui sans fard."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bd0eb99-c3e0-380a-b81c-0f7501851158",
                                        "entry_id": "2ff0ab32-8573-3309-adee-5cba80454192",
                                        "glosses": [
                                            "Fard de l'avant : Ensemble du mât de misaine et du mât de beaupré."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4210af79-9634-36a8-9546-7bb17595e127",
                                        "entry_id": "2ff0ab32-8573-3309-adee-5cba80454192",
                                        "glosses": [
                                            "Fard de l'arrière : Ensemble du mât d'artimon et du grand mât."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
