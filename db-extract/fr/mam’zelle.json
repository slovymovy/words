                ],
                "senses": [
                    {
                        "sense_id": "e96d8adc-738f-3a89-a4b5-d18223492011",
                        "entry_id": "4b039ddf-c5bf-310d-97af-f984b0ffcd45",
                        "glosses": [
                            "Mademoiselle."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "30eaf8ae-19ce-4d15-9117-ea916adc197e",
                                "sense_id": "e96d8adc-738f-3a89-a4b5-d18223492011",
                                "text": "D’un geste auguste, il jetait le chat aux pieds de mam’zelle Geneviève, qui disait : « Oh ! la sale bête » et aussitôt, se mettait à le dépecer […]"
                            },
                            {
                                "example_id": "6e80e854-9a48-4ff5-9be5-fd94dd259b1e",
                                "sense_id": "e96d8adc-738f-3a89-a4b5-d18223492011",
                                "text": "Ils courent, les linh-tap, tout joyeux de se battre sous les yeux du « Grand Coupa », enragés de montrer que les « soldats mam’zelles », comme les appellent ironiquement les turcos, sont dignes de combattre à l’ombre des trois couleurs."
                            },
                            {
                                "example_id": "eae6366c-12d6-4a8b-b09d-3853d6284958",
                                "sense_id": "e96d8adc-738f-3a89-a4b5-d18223492011",
                                "text": "— Voyons, voyons, mam’zelle Rosalie, intervient Ernestine, vous ne pouvez pas vous « astenir »."
                            },
                            {
                                "example_id": "5576c646-36cc-4fba-9daa-691dd3f6134b",
                                "sense_id": "e96d8adc-738f-3a89-a4b5-d18223492011",
                                "text": "C'était un épisode de la jeunesse de Louis XIV. Aux côtés du Roi, le principal rôle féminin était celui d'une « douce mam'zelle », son institutrice, qu'il aimait d'amour."
                            },
                            {
                                "example_id": "c7bf42bf-cb9a-4316-b5eb-ca951655136c",
                                "sense_id": "e96d8adc-738f-3a89-a4b5-d18223492011",
                                "text": "— Si les mam’zelles sont dans le coup, on y conduira les mam’zelles aussi, dit-il en regardant les femmes."
                            }
                        ]
                    }
                ],
