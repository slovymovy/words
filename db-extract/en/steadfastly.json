                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c78c08f3-cd64-47bd-bcce-de4e5984ba3c",
                                "sense_id": "42fb7b9c-17bb-362a-bca2-103497530de2",
                                "text": "He steadfastly refuses to go out with her."
                            },
                            {
                                "example_id": "cfc020d2-1b67-4ce9-b341-42d67f490301",
                                "sense_id": "42fb7b9c-17bb-362a-bca2-103497530de2",
                                "text": "She saw him shake his tall form erect, look at her strangely and steadfastly, and then, noiselessly, stealthily slip away amid the rocks and trees."
                            },
                            {
                                "example_id": "8472f650-475b-4a96-bdd3-ceff3a4e1a8b",
                                "sense_id": "42fb7b9c-17bb-362a-bca2-103497530de2",
                                "text": "Monarch who through her seven decades of public service became a figure of fascination by remaining steadfastly private."
                            },
                            {
                                "example_id": "d947797b-bcc8-49d4-96d2-30db5a295942",
                                "sense_id": "42fb7b9c-17bb-362a-bca2-103497530de2",
                                "text": "Hmm, yes, 'negotiations' is an interesting choice of words given that ministers have steadfastly refused to meet the unions for the past year; a clear case of industrial inaction."
                            }
                        ]
                    }
