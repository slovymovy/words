                    {
                        "translation_id": "179176f5-af34-4f86-a65d-d33fcea8ee5a",
                        "source_entry_id": "b9d9e4d3-bc65-3f50-b732-b04724b68eb7",
                        "source_sense_id": "4f4bba4e-eb14-315a-84e8-e80a7b9ccd06",
