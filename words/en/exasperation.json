    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e43820ec-f959-385d-8636-8debc2c13b7d",
                    "sense_definition": "A feeling of intense annoyance, irritation, or frustration.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She threw her hands up in <w>exasperation</w> when the computer crashed again.",
                            "target_lang_translations": {
                                "ru": "Она в <w>раздражении</w> всплеснула руками, когда компьютер снова завис."
                            }
                        },
                        {
                            "text": "After waiting for hours in line, a collective groan of <w>exasperation</w> echoed through the terminal.",
                            "target_lang_translations": {
                                "ru": "После многочасового ожидания в очереди по всему терминалу разнесся общий стон <w>негодования</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "irritation",
                        "frustration",
                        "annoyance"
                    ],
                    "antonyms": [
                        "pleasure",
                        "delight",
                        "satisfaction"
                    ],
                    "common_phrases": [
                        "sigh of exasperation",
                        "groan of exasperation",
                        "in exasperation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство крайнего раздражения, досады или бессильной злости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражение",
                                "target_lang_sense_clarification": "чувство сильного недовольства или досады"
                            },
                            {
                                "target_lang_word": "озлобление",
                                "target_lang_sense_clarification": "чувство злости и ожесточения"
                            },
                            {
                                "target_lang_word": "негодование",
                                "target_lang_sense_clarification": "крайнее возмущение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "790f625b-5cb5-34fd-91ab-1c15eabd14cb",
                    "sense_definition": "The act of increasing violence, severity, or malignity; worsening or exacerbation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "worsening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harsh winter led to the <w>exasperation</w> of the refugees' already dire suffering.",
                            "target_lang_translations": {
                                "ru": "Суровая зима привела к <w>усугублению</w> и без того ужасных страданий беженцев."
                            }
                        },
                        {
                            "text": "Poor leadership contributed to the rapid <w>exasperation</w> of political tensions across the country.",
                            "target_lang_translations": {
                                "ru": "Слабое руководство способствовало быстрому <w>обострению</w> политической напряженности по всей стране."
                            }
                        }
                    ],
                    "synonyms": [
                        "aggravation",
                        "exacerbation"
                    ],
                    "antonyms": [
                        "alleviation",
                        "mitigation"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English in this sense; exacerbation is preferred."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Усиление жестокости, остроты или тяжести состояния; ухудшение или обострение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обострение",
                                "target_lang_sense_clarification": "усиление конфликта, напряжения или болезни"
                            },
                            {
                                "target_lang_word": "усугубление",
                                "target_lang_sense_clarification": "ухудшение положения или страданий"
                            }
                        ]
                    }
                }
            ]
        }
    ]
