                                "sense_id": "cb5c35db-3609-33ce-a2c3-d116ca320cc7",
                                "text": "Geestelijk in de vernieling raken.",
                                "translation": "Être menacé par la déprime."
                            },
                            {
                                "example_id": "ce00013d-a406-4924-adad-d686eb7341bd",
                                "sense_id": "cb5c35db-3609-33ce-a2c3-d116ca320cc7",
                                "text": "Ze ligt volkomen in de vernieling.",
                                "translation": "Elle est à ramasser à la petite cuiller."
                            },
                            {
                                "example_id": "b871121b-b11b-4eb5-86c1-92106589aa4f",
                                "sense_id": "cb5c35db-3609-33ce-a2c3-d116ca320cc7",
