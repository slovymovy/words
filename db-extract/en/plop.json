                    }
                ],
                "senses": [
                    {
                        "sense_id": "afb9184b-f851-37eb-b9ea-d69cb52c54cf",
                        "entry_id": "1fa27e9a-75b8-3e9d-a7ad-8a872f1e5482",
                        "glosses": [
                            "To make the sound of an object dropping into a body of liquid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73fe697e-85f2-4e77-bcc5-f16b4db43a44",
                                "sense_id": "afb9184b-f851-37eb-b9ea-d69cb52c54cf",
                                "text": "Stooping, she picked up another pebble, sounded out the word again, and tossed it into the shallow water near the path, where it plopped into the water, sending out circles from where it fell."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d2491ba-33e8-3780-83b0-00d113ec573f",
                        "entry_id": "1fa27e9a-75b8-3e9d-a7ad-8a872f1e5482",
                        "glosses": [
                            "To land heavily or loosely."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7d8ba7b2-c596-4150-9c66-1d84d38a25a5",
                                "sense_id": "7d2491ba-33e8-3780-83b0-00d113ec573f",
                                "text": "He plopped down on the sofa to watch TV."
                            },
                            {
                                "example_id": "8ab37f36-e698-46ff-9c33-de6d433bc98a",
                                "sense_id": "7d2491ba-33e8-3780-83b0-00d113ec573f",
                                "text": "There was a world inside that tall grass. You could plop yourself down in the middle of it with the scraggly stems against the back of your neck and the endless grasses rising up and jackknifing against the bigbluesky, and the ranch and all of its players would fade into a distant dream."
                            },
                            {
                                "example_id": "64dc3003-da53-4f7b-bfa3-38d9b8cfd1bf",
                                "sense_id": "7d2491ba-33e8-3780-83b0-00d113ec573f",
                                "text": "The first time I had niku udon was at a Japanese convenience store, now long closed, near Columbia University in the mid-1990s. For about $5, the attendants would plop a handful of freshly boiled udon into a Styrofoam cup and add a ladle of dashi broth seasoned with soy sauce and mirin."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b2c3be3-7c45-346c-a7be-002d0bcba133",
                        "entry_id": "1fa27e9a-75b8-3e9d-a7ad-8a872f1e5482",
                        "glosses": [
                            "To defecate."
                        ],
                        "tags": [
                            "British"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c406c9bc-fc6a-4422-bd36-fc4567b267ed",
                        "source_entry_id": "1fa27e9a-75b8-3e9d-a7ad-8a872f1e5482",
                        "source_sense_description": "Sounding of liquid",
                        "target_lang_word": "faire plouf",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "446810b6-e457-4c29-a619-74d6d5382f70",
                        "source_entry_id": "1fa27e9a-75b8-3e9d-a7ad-8a872f1e5482",
                        "source_sense_description": "Sounding of liquid",
                        "target_lang_word": "ploppen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ploppen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "712a6f10-311b-3e9e-b5c4-993817d883e6",
                                        "entry_id": "ff5b675e-3a1b-3242-bbbc-a064a8fe5c5c",
                                        "glosses": [
                                            "ein kurzes, dunkles Geräusch produzieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "170c6d5e-b587-46d3-b6f5-b83e74daa1bb",
                                                "sense_id": "712a6f10-311b-3e9e-b5c4-993817d883e6",
                                                "text": "Die Bierflasche ploppte beim Öffnen des Bügelverschlusses."
                                            },
                                            {
                                                "example_id": "ee9b5729-5cc2-41be-b1ad-2f8b878181bf",
                                                "sense_id": "712a6f10-311b-3e9e-b5c4-993817d883e6",
                                                "text": "„Muss es bei Ihnen ploppen oder lieber zischen? Bierflaschen mit ploppenden Bügelverschlüssen sind äußerst praktisch.“"
                                            },
                                            {
                                                "example_id": "fdd0c4e2-5261-41b3-8edb-0a03c8996fd8",
                                                "sense_id": "712a6f10-311b-3e9e-b5c4-993817d883e6",
                                                "text": "Er nahm den Korkenzieher und kurz darauf ploppte der Korken leise aus der Weinflasche."
                                            },
                                            {
                                                "example_id": "a403c0fd-5d29-4f7d-8502-dc756833d530",
                                                "sense_id": "712a6f10-311b-3e9e-b5c4-993817d883e6",
                                                "text": "„[…] 40 Stundenkilometer erreichen Silvester-Sektkorken nur selten: \"Wenn die Flasche ungeschüttelt aus dem Kühlschrank kommt, ist eigentlich kein Druck drauf\", so Physikprofessor Friedrich Balk. Der Korken ploppt dann zwar, aber so schnell wie im Labor wird er nicht werden.“"
                                            },
                                            {
                                                "example_id": "dc05b7e0-62bf-4742-9429-4961814f00a7",
                                                "sense_id": "712a6f10-311b-3e9e-b5c4-993817d883e6",
                                                "text": "Die Toasts ploppten aus dem Toaster, wir konnten frühstücken."
                                            },
                                            {
                                                "example_id": "43121bb1-9f22-4093-900f-a15e699a13f8",
                                                "sense_id": "712a6f10-311b-3e9e-b5c4-993817d883e6",
                                                "text": "Der Basketball ploppte beim Dribbeln laut auf dem Boden."
                                            },
                                            {
                                                "example_id": "154559e3-8af7-4437-9340-4eeeafce1b8c",
                                                "sense_id": "712a6f10-311b-3e9e-b5c4-993817d883e6",
                                                "text": "„[…] Ronfeld [ließ] den Ball auf den Schläger ploppen. Plopp - plopp - plopp. Auf einmal war Fischer von dem Geräusch genervt.“"
                                            },
                                            {
                                                "example_id": "47f6a60b-0b0d-497b-87c4-11f1b5cabc68",
                                                "sense_id": "712a6f10-311b-3e9e-b5c4-993817d883e6",
                                                "text": "„Wenn der Sprecher oder die Sprecherin zu nah am Mikro ist und wenn kein Windschutz verwendet wird, \"ploppt\" es auf der Aufnahme ganz heftig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d4a1008-0ef5-4fc5-af71-7a2fb7bbe34d",
                        "source_entry_id": "1fa27e9a-75b8-3e9d-a7ad-8a872f1e5482",
