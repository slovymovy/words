                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15e355a4-b1bd-4d2c-b789-673168098d10",
                                                "sense_id": "1ac0f965-c60e-35f9-9dee-c1c4ebd44e31",
                                                "text": "Use of maximum reverse thrust at low speeds can cause the engine to surge from ingesting its own exhaust."
                                            }
                                        ]
