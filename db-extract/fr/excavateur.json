                "senses": [
                    {
                        "sense_id": "de9e4977-00a0-32e5-85ee-eef7a0aca3de",
                        "entry_id": "cbd5f386-6316-33e1-8fff-730e3da9af2b",
                        "glosses": [
                            "Engin de gros terrassement à haut rendement, présent dans les sablières et les mines à ciel ouvert."
                        ],
                        "tags": [
                            "Travaux publics"
                        ],
                        "examples": [
                            {
                                "example_id": "e4122920-13e1-4bfc-84e6-81b81a5af177",
                                "sense_id": "de9e4977-00a0-32e5-85ee-eef7a0aca3de",
                                "text": "Le succès de l’excavateur à godets rotatifs, tel qu’il est construit actuellement, résulte principalement de ce qu’il réunit le débit élevé de l’excavateur à chaîne à godets à la force d’excavation et à la mobilité de l’excavateur à pelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdeda064-c941-4d44-b575-0837212281f6",
                        "source_entry_id": "cbd5f386-6316-33e1-8fff-730e3da9af2b",
                        "source_sense_id": "de9e4977-00a0-32e5-85ee-eef7a0aca3de",
                        "target_lang_word": "Bagger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bagger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "803c64ac-15c7-309b-8ca5-d39f977ec2fd",
                                        "entry_id": "769a7197-5020-3470-88e1-e86b9a0157f4",
                                        "glosses": [
                                            "eine Maschine zum Abgraben oder Wegschaffen von Erdreich oder Schutt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4c6a404-9ef5-4a45-bf8c-2019f4ed9b3a",
                                                "sense_id": "803c64ac-15c7-309b-8ca5-d39f977ec2fd",
                                                "text": "Man setzte mehrere Bagger in dem verschlammten Hafen ein."
                                            },
                                            {
                                                "example_id": "7d0c45d3-6a9e-419e-962d-4f9ea148f471",
                                                "sense_id": "803c64ac-15c7-309b-8ca5-d39f977ec2fd",
                                                "text": "„Auf Laxnes standen noch in meinen ersten Sommern alte Mauerreste, aber ich befürchte gleichwohl, das Fortschrittsdenken, das wir mitbrachten, habe sich in der Gestalt eines Baggers durchgesetzt.“"
                                            },
                                            {
                                                "example_id": "7d1e50fd-88d1-43c2-bf15-b885761b2005",
                                                "sense_id": "803c64ac-15c7-309b-8ca5-d39f977ec2fd",
                                                "text": "„Schwarz ragten die Bagger an der Kiesgrube in den heißen Himmel, ein junges Paar machte sich auf einer Luftmatratze zu schaffen.“"
                                            },
                                            {
                                                "example_id": "6297eb87-ecd5-47f4-b816-db078849ba45",
                                                "sense_id": "803c64ac-15c7-309b-8ca5-d39f977ec2fd",
                                                "text": "„Am Ende des Strandes ruhten die Bagger mit gesenkten Köpfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5a32c25-0c83-43ef-9465-61ea9553a247",
                        "source_entry_id": "cbd5f386-6316-33e1-8fff-730e3da9af2b",
