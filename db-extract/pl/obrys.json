                "senses": [
                    {
                        "sense_id": "37e0fa58-0f2c-3bcd-915e-a09b8ba1b518",
                        "entry_id": "c4a2d922-78f1-3a59-a119-1ce324441bb8",
                        "glosses": [
                            "shape (appearance or outline)"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "b322be83-149f-4d10-b65c-89bd0be4be16",
                                "sense_id": "37e0fa58-0f2c-3bcd-915e-a09b8ba1b518",
                                "text": "Czaszka trzecia, patrząc z góry, przedstawiała obrys niemal dokładnej elipsoidy...",
                                "translation": "The third skull, looking [at it] from above, presented the shape of a nearly exact ellipsoid...",
                                "english": "The third skull, looking [at it] from above, presented the shape of a nearly exact ellipsoid..."
                            },
                            {
                                "example_id": "3f6b39bd-d9a4-4196-b67e-86c53290f6ac",
                                "sense_id": "37e0fa58-0f2c-3bcd-915e-a09b8ba1b518",
                                "text": "Pawełko wyraził nadzieję, że obrys Ukrainy na koszulce \"da siłę piłkarzom, którzy będą walczyli (na Euro) dla całej Ukrainy\".",
                                "translation": "Pavelko expressed the hope that the outline of Ukraine on their shirts \"will give strength to the ball-players, who will be fighting (in the European soccer championship) for all of Ukraine\".",
                                "english": "Pavelko expressed the hope that the outline of Ukraine on their shirts \"will give strength to the ball-players, who will be fighting (in the European soccer championship) for all of Ukraine\"."
                            }
                        ]
                    },
