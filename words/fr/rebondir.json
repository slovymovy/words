                },
                {
                    "sense_id": "70ccc3e4-1428-323e-b7e3-b74fe4444ace",
                    "sense_definition": "Repartir d'un nouvel élan ou trouver une situation meilleure après une épreuve ou un échec.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la perte de son emploi, il a su <w>rebondir</w> en créant sa propre entreprise."
                        },
                        {
                            "text": "L'enquête semblait bloquée, mais elle vient tout à coup de <w>rebondir</w> grâce à un nouveau témoin."
                        }
                    ],
                    "synonyms": [
                        "se relever",
                        "repartir"
                    ],
                    "antonyms": [
                        "sombrer"
                    ],
                    "common_phrases": [
