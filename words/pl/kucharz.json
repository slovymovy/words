                    "sense_id": "36c52148-06dd-3b78-be7a-040679e36658",
                    "sense_definition": "osoba, która zawodowo zajmuje się gotowaniem potraw",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten <w>kucharz</w> przygotowuje wyśmienite dania z ryb.",
                            "target_lang_translations": {
                                "ru": "Этот <w>повар</w> готовит восхитительные рыбные блюда.",
                                "en": "This <w>cook</w> prepares delicious fish dishes.",
                                "nl": "Deze <w>kok</w> bereidt heerlijke visgerechten.",
                                "de": "Dieser <w>Koch</w> bereitet hervorragende Fischgerichte zu.",
                                "fr": "Ce <w>cuisinier</w> prépare de délicieux plats de poisson.",
                                "it": "Questo <w>cuoco</w> prepara deliziosi piatti a base di pesce.",
                                "cs": "Tento <w>kuchař</w> připravuje vynikající rybí pokrmy.",
                                "tr": "Bu <w>aşçı</w> nefis balık yemekleri hazırlıyor.",
                                "es": "Este <w>cocinero</w> prepara exquisitos platos de pescado.",
                                "zh": "这位<w>厨师</w>做的鱼非常美味。"
                            }
                        },
                        {
                            "text": "Mój brat chce zostać <w>kucharzem</w> i pracować w dużej restauracji.",
                            "target_lang_translations": {
                                "ru": "Мой брат хочет стать <w>поваром</w> и работать в большом ресторане.",
                                "en": "My brother wants to become a <w>chef</w> and work in a large restaurant.",
                                "nl": "Mijn broer wil <w>kok</w> worden en in een groot restaurant werken.",
                                "de": "Mein Bruder möchte <w>Koch</w> werden und in einem großen Restaurant arbeiten.",
                                "fr": "Mon frère veut devenir <w>cuisinier</w> et travailler dans un grand restaurant.",
                                "it": "Mio fratello vuole diventare un <w>cuoco</w> e lavorare in un grande ristorante.",
                                "cs": "Můj bratr se chce stát <w>kuchařem</w> a pracovat ve velké restauraci.",
                                "tr": "Erkek kardeşim <w>aşçı</w> olmak ve büyük bir restoranda çalışmak istiyor.",
                                "es": "Mi hermano quiere ser <w>cocinero</w> y trabajar en un gran restaurante.",
                                "zh": "我哥哥想成为一名<w>厨师</w>，在大餐厅工作。"
                            }
                        }
                    ],
                    "synonyms": [
