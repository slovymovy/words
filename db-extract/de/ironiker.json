                                "target_senses": [
                                    {
                                        "sense_id": "b662bbcf-104e-3c03-ae42-98d3b4680db7",
                                        "entry_id": "94de7819-10ca-3ce2-9f4e-518de6d9bed1",
                                        "glosses": [
                                            "Someone who uses irony in humor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d0f306e-8e44-4199-977a-b556495a9f37",
                                                "sense_id": "b662bbcf-104e-3c03-ae42-98d3b4680db7",
                                                "text": "The great ironists do not merely use irony: they live ironically."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d025f179-0460-3761-940d-30821f26ddcd",
                                        "entry_id": "94de7819-10ca-3ce2-9f4e-518de6d9bed1",
                                        "glosses": [
                                            "A supporter of ironism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2063815b-4556-440d-b913-56dc86c8824b",
                        "source_entry_id": "a50b3e7c-5d87-3a87-b07e-fe87d3a78da3",
                        "source_sense_id": "246975e8-6f49-3a18-b852-5ac478987fc4",
                        "source_sense_description": "Person, die Ironie versteht und verwendet",
                        "target_lang_word": "ironiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ironiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e0741f9-8b0b-3c9c-a6d5-01aa38302553",
                                        "entry_id": "068c08fb-fb68-3678-aff3-0767709040c4",
                                        "glosses": [
                                            "Celui ou celle qui affecte l’ironie, soit en écrivant, soit en parlant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c67480b-e16a-42a9-a886-47b4b8ffcfb7",
                                                "sense_id": "1e0741f9-8b0b-3c9c-a6d5-01aa38302553",
                                                "text": "J’ai rêvé d’un ironiste qui, un beau jour, tout à coup, perdait son ironie."
                                            },
                                            {
                                                "example_id": "168ee686-d875-47ef-a41f-f96e0a45e8e7",
                                                "sense_id": "1e0741f9-8b0b-3c9c-a6d5-01aa38302553",
                                                "text": "Si j’avais le manque de cœur d’un ironiste, je découvrirais la source de réflexions d’une amère irrévérence dans le projet qu’a fait un de mes amis de créer une association de penseurs, pour mettre fin au malaise de l’Europe."
                                            },
                                            {
                                                "example_id": "22a8eaf1-4312-462e-abb5-cf0f90e78f2c",
                                                "sense_id": "1e0741f9-8b0b-3c9c-a6d5-01aa38302553",
                                                "text": "La Plume est cousine de l’ironiste, qui, le temps du propos ironique, fait un bout de chemin avec ce qu’il ne pense pas, afin de faire penser ce qu’il pense vraiment, là où le menteur accompagne de bout en bout ce qu’il ne pense pas, afin de le faire penser."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ironiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f7ac907-f10b-33ba-8565-fcc9ec38bba7",
                                        "entry_id": "522b308e-1781-3a9e-9875-d2bb32eec344",
                                        "glosses": [
                                            "Qui est porté à l’ironie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b66f548-d1a3-48e2-8ebc-de7166a376d6",
                                                "sense_id": "6f7ac907-f10b-33ba-8565-fcc9ec38bba7",
                                                "text": "M. Filleul était un juge de l’école ironiste, comme il le disait lui-même."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
