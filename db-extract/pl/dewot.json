                "senses": [
                    {
                        "sense_id": "c59d7e04-c7e5-3f5c-ab44-fbb3ee70acb7",
                        "entry_id": "c899c087-1ecb-32ae-ac67-fa618c506c75",
                        "glosses": [
                            "osoba manifestacyjnie pobożna"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3d11fc58-2967-441b-8398-720906fd6338",
                                "sense_id": "c59d7e04-c7e5-3f5c-ab44-fbb3ee70acb7",
                                "text": "Sąsiad jest dewotem, ma w przedpokoju aż cztery święte obrazy."
                            },
                            {
                                "example_id": "d97aa14f-caa4-4a22-aeb1-47935e891876",
                                "sense_id": "c59d7e04-c7e5-3f5c-ab44-fbb3ee70acb7",
                                "text": "Niech herosi pobożności cię poganiają, niech kumple się śmieją, żeś dewot, a ty spaceruj po swojej Krynicy z kubkiem w ręku, to znacznie skuteczniejsze niż sinusoida: szczytowanie – zawał – szczytowanie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b2f6344-6c03-4dfa-8d51-6958b338e138",
                        "source_entry_id": "c899c087-1ecb-32ae-ac67-fa618c506c75",
                        "source_sense_id": "c59d7e04-c7e5-3f5c-ab44-fbb3ee70acb7",
                        "target_lang_word": "богомол",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "богомол",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e31734e0-82a0-3109-ac03-4248ac435824",
                                        "entry_id": "6c7d4a50-1202-34b3-9be8-2a621d02fb71",
                                        "glosses": [
                                            "устар. то же, что богомолец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5adc2cc-4898-4dbb-b6da-3c7eacea8076",
                                                "sense_id": "e31734e0-82a0-3109-ac03-4248ac435824",
                                                "text": "Христарадники — это богомолы, просящие милостыню на церковной паперти."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f90fa5af-535a-3ba4-86d4-49adb8ae0657",
                                        "entry_id": "6c7d4a50-1202-34b3-9be8-2a621d02fb71",
                                        "glosses": [
                                            "зоол. хищное насекомое, живущее в тропиках и субтропиках, питающееся насекомыми (название дано по характерной для них позе: наклонённое вперёд туловище, опущенная голова и сложенные передние ноги)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5de3a3a4-ec31-4f5a-95ff-640d223472e1",
                                                "sense_id": "f90fa5af-535a-3ba4-86d4-49adb8ae0657",
                                                "text": "Обыкновенный богомол — типичный хищник-засадчик, мимикрирующий под окружающие растения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7d81452-e60d-4938-81c5-8c21cbdbe4a5",
                        "source_entry_id": "c899c087-1ecb-32ae-ac67-fa618c506c75",
                        "source_sense_id": "c59d7e04-c7e5-3f5c-ab44-fbb3ee70acb7",
                        "target_lang_word": "богомолец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "богомолец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ef6df2f7-1df7-33cf-9d62-acd53f785a6f",
                                        "entry_id": "f6be6944-fd3f-3c4c-b67b-40d678866f6d",
                                        "glosses": [
                                            "религ. тот, кто верит в Бога, молится Богу, регулярно посещает церковные службы, поклоняется церковным святыням"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3bdb610-7919-4627-bbd2-6ef5c36ddcb9",
                                                "sense_id": "ef6df2f7-1df7-33cf-9d62-acd53f785a6f",
                                                "text": "Деревни наши бедные, // А в них крестьяне хворые // Да женщины печальницы, // Кормилицы, поилицы, // Рабыни, богомолицы // И труженицы вечные, // Господь прибавь им сил!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ccdcc21-e632-3b68-8260-9568f0bbfbfc",
                                        "entry_id": "f6be6944-fd3f-3c4c-b67b-40d678866f6d",
                                        "glosses": [
                                            "устар. тот, кто ходит на богомолье; паломник"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "243ba284-ffe5-4bba-bc2e-f6898690f8e1",
                                                "sense_id": "6ccdcc21-e632-3b68-8260-9568f0bbfbfc",
                                                "text": "Лара шла вдоль полотна по тропинке, протоптанной странниками и богомольцами, и сворачивала на луговую стёжку, ведшую к лесу."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6639317d-2ae8-4009-ae43-63d049cc6ab7",
                        "source_entry_id": "c899c087-1ecb-32ae-ac67-fa618c506c75",
                        "source_sense_id": "c59d7e04-c7e5-3f5c-ab44-fbb3ee70acb7",
                        "target_lang_word": "bigotto",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bigotto",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "72796e3f-863f-31e2-a088-cd2699c13bc8",
                                        "entry_id": "1af37353-da58-3514-b05d-759e3a6b7e74",
                                        "glosses": [
                                            "di chi segue in modo assiduo e scrupoloso le pratiche di una religione, ma senza capirne il significato intimo"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "884dd366-3450-3a01-900d-f791ff255f13",
                                        "entry_id": "1af37353-da58-3514-b05d-759e3a6b7e74",
                                        "glosses": [
                                            "di persona che ha una religiosità solo esteriore, non riscontrabile nei fatti; di persona o pensiero che mostra una grande religiosità unita ad altrettanta intolleranza e mancanza di flessibilità"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aed4609b-b464-437a-9e76-37eb53eec816",
                                                "sense_id": "884dd366-3450-3a01-900d-f791ff255f13",
                                                "text": "occhio a quello bigotto ché diviene capo se non fa fagotto"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0ae6123-6304-3f38-ae6f-39b5fa5c4625",
                                        "entry_id": "1af37353-da58-3514-b05d-759e3a6b7e74",
                                        "glosses": [
                                            "di persona ipocrita e \\\"maliziosa\\\", che vorrebbe mostrare [uno] zelo in modo plateale però con un'ostile \\\"gelosia\\\" per chi pare abbia posizioni di rilievo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f915866-398e-4c23-84f0-55555f3c8229",
                                                "sense_id": "d0ae6123-6304-3f38-ae6f-39b5fa5c4625",
                                                "text": "da una vita ha assunto un comportamento bigotto per scalzare coloro che dovrebbero guidare le comunità"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d21d40d6-c4cd-3da9-902b-df5ac88bb5d4",
                                        "entry_id": "1af37353-da58-3514-b05d-759e3a6b7e74",
                                        "glosses": [
                                            "è termine utilizzato comunemente soprattutto tra alcuni cattolici per definire altri correligionari che \\\"nascondono\\\" gravi \\\"mancanze\\"
                                        ],
