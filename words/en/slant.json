{
    "word_family": [
        "slanted",
        "slanting",
        "slantwise"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "99df78e9-a152-36ea-a3e9-bb8a7b159b90",
                    "sense_definition": "A slope or an inclined surface.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "slope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The house was built on a bit of a <w>slant</w> and was never quite level.",
                            "target_lang_translations": {
                                "fr": "La maison a été construite avec une légère <w>pente</w> et n'a jamais été tout à fait de niveau."
                            }
                        },
                        {
                            "text": "The roof has a steep <w>slant</w> to help snow slide off easily.",
                            "target_lang_translations": {
                                "fr": "Le toit a une <w>inclinaison</w> raide pour aider la neige à glisser facilement."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on a slant"
                    ],
                    "target_lang_definitions": {
                        "fr": "Une pente ou une surface inclinée."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "pente",
                                "target_lang_sense_clarification": "Surface inclinée ou déclivité."
                            },
                            {
                                "target_lang_word": "inclinaison",
                                "target_lang_sense_clarification": "État de ce qui est incliné."
                            },
                            {
                                "target_lang_word": "biais",
                                "target_lang_sense_clarification": "Ligne ou sens oblique."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8210c767-775f-3fa9-a7f8-039ecc1920c0",
                    "sense_definition": "A particular point of view or angle of approach.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perspective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a well written article, but it had a bit of a leftist <w>slant</w>.",
                            "target_lang_translations": {
                                "fr": "C'était un article bien écrit, mais il avait un léger <w>parti pris</w> de gauche."
                            }
                        },
                        {
                            "text": "The news report gave a biased <w>slant</w> to the political event.",
                            "target_lang_translations": {
                                "fr": "Le reportage a donné un <w>angle</w> biaisé à l'événement politique."
                            }
                        }
                    ],
                    "synonyms": [
                        "bias"
                    ],
                    "common_phrases": [
                        "political slant",
                        "news slant"
                    ],
                    "target_lang_definitions": {
                        "fr": "Un point de vue particulier ou un angle d'approche."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "parti pris",
                                "target_lang_sense_clarification": "Opinion préconçue ou manque d'objectivité."
                            },
                            {
                                "target_lang_word": "angle",
                                "target_lang_sense_clarification": "Perspective ou manière d'aborder un sujet."
                            },
                            {
                                "target_lang_word": "biais",
                                "target_lang_sense_clarification": "Inclinaison ou orientation d'une pensée."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42b64d6c-4c2f-3c2b-85fc-040d130d352e",
                    "sense_definition": "The punctuation mark / used to separate items or indicate alternatives.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "punctuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use a <w>slant</w> to indicate the end of a line in poetry.",
                            "target_lang_translations": {
                                "fr": "Utilisez une <w>barre oblique</w> pour indiquer la fin d'un vers en poésie."
                            }
                        },
                        {
                            "text": "The <w>slant</w> is often used in web addresses.",
                            "target_lang_translations": {
                                "fr": "La <w>barre oblique</w> est souvent utilisée dans les adresses web."
                            }
                        }
                    ],
                    "synonyms": [
                        "slash"
                    ],
                    "target_lang_definitions": {
                        "fr": "Le signe de ponctuation / utilisé pour séparer des éléments ou indiquer des alternatives."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "barre oblique",
                                "target_lang_sense_clarification": "Terme technique pour le signe /."
                            },
                            {
                                "target_lang_word": "slash",
                                "target_lang_sense_clarification": "Terme courant, souvent utilisé dans le contexte informatique."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5a5aed10-8cdc-3876-b530-36a6156a3e05",
                    "sense_definition": "To lean, tilt, or be positioned at an angle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "slope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you <w>slant</w> the track a little more, the marble will roll down it faster.",
                            "target_lang_translations": {
                                "fr": "Si vous <w>inclinez</w> un peu plus la piste, la bille roulera plus vite."
                            }
                        },
                        {
                            "text": "The sun began to <w>slant</w> across the field as evening approached.",
                            "target_lang_translations": {
                                "fr": "Le soleil a commencé à <w>pencher</w> sur le champ à l'approche du soir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slant down",
                        "slant across"
                    ],
                    "target_lang_definitions": {
                        "fr": "Pencher, incliner ou être positionné selon un angle."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "incliner",
                                "target_lang_sense_clarification": "Mettre dans une position oblique."
                            },
                            {
                                "target_lang_word": "pencher",
                                "target_lang_sense_clarification": "Être hors d'aplomb ou incliner quelque chose."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "feebdd4f-aac4-3ef2-af52-80445e5fff96",
                    "sense_definition": "To present information in a way that favors one side or opinion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perspective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The group tends to <w>slant</w> its policies in favor of the big businesses it serves.",
                            "target_lang_translations": {
                                "fr": "Le groupe a tendance à <w>orienter</w> ses politiques en faveur des grandes entreprises qu'il sert."
                            }
                        },
                        {
                            "text": "Do not <w>slant</w> the facts just to support your own argument.",
                            "target_lang_translations": {
                                "fr": "Ne <w>biaisez</w> pas les faits juste pour soutenir votre propre argument."
                            }
                        }
                    ],
                    "synonyms": [
                        "bias"
                    ],
                    "common_phrases": [
                        "slant the truth"
                    ],
                    "target_lang_definitions": {
                        "fr": "Présenter des informations de manière à favoriser un côté ou une opinion."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "biaiser",
                                "target_lang_sense_clarification": "Agir de manière détournée ou fausser un résultat."
                            },
                            {
                                "target_lang_word": "orienter",
                                "target_lang_sense_clarification": "Donner une direction particulière à une information."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6f23ee29-0cbf-36dd-8454-39a02a20e843",
                    "sense_definition": "Positioned at an angle; sloping or oblique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "slope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>slant</w> ray of golden sunshine entered the chamber.",
                            "target_lang_translations": {
                                "fr": "Un rayon de soleil doré et <w>incliné</w> est entré dans la chambre."
                            }
                        },
                        {
                            "text": "The workers built a small hut with a <w>slant</w> roof.",
                            "target_lang_translations": {
                                "fr": "Les ouvriers ont construit une petite cabane avec un toit <w>incliné</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slant roof",
                        "slant beam"
                    ],
                    "target_lang_definitions": {
                        "fr": "Positionné selon un angle ; incliné ou oblique."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "incliné",
                                "target_lang_sense_clarification": "Qui n'est pas horizontal ou vertical."
                            },
                            {
                                "target_lang_word": "oblique",
                                "target_lang_sense_clarification": "Qui est de biais."
                            },
                            {
                                "target_lang_word": "biais",
                                "target_lang_sense_clarification": "Qui est de travers."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}