                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rehabilitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91fe30be-aa3f-3dcb-a4e4-2c691e3e595a",
                                        "entry_id": "4c4ab615-5db1-317d-80c8-81affd5e9f95",
                                        "glosses": [
                                            "The process of rehabilitating somebody or something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4879eb0c-88ae-43be-9920-452e7a131230",
                                                "sense_id": "91fe30be-aa3f-3dcb-a4e4-2c691e3e595a",
                                                "text": "The working life span of a passenger carriage, on average, is between 30 and 35 years, so a steady replacement takes place quite naturally. The life span of a station, however, cannot be so easily reckoned, for it depends largely on the rehabilitation and upkeep of the existing structures."
                                            },
                                            {
                                                "example_id": "4217cbd4-d42c-4a75-ba7e-feefa8a7e79d",
                                                "sense_id": "91fe30be-aa3f-3dcb-a4e4-2c691e3e595a",
                                                "text": "Maybe now it should be clearer why Louis van Gaal has been telling anyone who cares to listen they should not be surprised if Manchester United’s rehabilitation takes longer than they would ideally like."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f90d4037-ac78-4a26-ba84-bb0cad507065",
                        "source_entry_id": "5a8714c4-3c57-3cf2-bd2b-0d4a0e0cff30",
                        "source_sense_id": "48816734-36f3-359e-9572-6bc18fe7130f",
                        "target_lang_word": "réhabilitation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réhabilitation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "767e21ba-e42a-385c-aaa6-570be4285573",
                                        "entry_id": "8dec911d-cd9b-37ad-b433-518ac2db6e6f",
                                        "glosses": [
                                            "Action de réhabiliter ; rétablissement dans le premier état."
                                        ],
                                        "tags": [
                                            "Jurisprudence"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29db97f6-41e1-4b55-b024-6a4e9e55eb84",
                                                "sense_id": "767e21ba-e42a-385c-aaa6-570be4285573",
                                                "text": "Lettres de réhabilitation."
                                            },
                                            {
                                                "example_id": "3ee4decd-1c5b-4b1f-9820-d8040d71c6a4",
                                                "sense_id": "767e21ba-e42a-385c-aaa6-570be4285573",
                                                "text": "Réhabilitation de noblesse."
                                            },
                                            {
                                                "example_id": "245d018e-4db6-408d-923c-1a2fa27a6bbd",
                                                "sense_id": "767e21ba-e42a-385c-aaa6-570be4285573",
                                                "text": "La réhabilitation d’un failli, d’un condamné. Obtenir un jugement de réhabilitation."
                                            },
                                            {
                                                "example_id": "84859f8c-7d81-49a8-960f-61ee03a700bb",
                                                "sense_id": "767e21ba-e42a-385c-aaa6-570be4285573",
                                                "text": "Cela dit, dans une histoire comme la mienne, sans vouloir intenter un procès en réhabilitation, il faut bien admettre que celui qui reste a autant de torts que celui qui s’en va."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aec92b0a-6050-3bfc-81cc-e7d6ffff95ec",
                                        "entry_id": "8dec911d-cd9b-37ad-b433-518ac2db6e6f",
                                        "glosses": [
                                            "Rétablissement dans l’estime publique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8397146a-3a41-44cc-8852-f8cd89829615",
                                                "sense_id": "aec92b0a-6050-3bfc-81cc-e7d6ffff95ec",
                                                "text": "Être bon, quand on ne peut pas être fort, c’est déjà méritoire. Et, d’ailleurs, madame, cette réhabilitation qui aurait dû être immédiate, pour la juste gloire du pays lui-même, votre mari peut l’attendre, le front haut, car il n’est pas d’innocent qui soit plus innocent, devant tous les peuples de la terre."
                                            },
                                            {
                                                "example_id": "87126eb0-b82e-499b-9576-5c0edadeb315",
                                                "sense_id": "aec92b0a-6050-3bfc-81cc-e7d6ffff95ec",
                                                "text": "Les romans écrits par des femmes sont pleins des désillusions de la dévirginisation, de la légitimité de l’adultère, de la réhabilitation du lesbianisme comme remplacement, etc. Nos mères n’auraient jamais osé étaler de pareilles choses, chacune gardait pour elle ses rancœurs, cherchant au besoin des consolations dans la religion."
                                            },
                                            {
                                                "example_id": "8a74b4d3-f0b2-4050-bc46-7e215e37bd12",
                                                "sense_id": "aec92b0a-6050-3bfc-81cc-e7d6ffff95ec",
                                                "text": "La réhabilitation mémorielle concerne en premier lieu les victimes d’une politique coloniale de peuplement, par laquelle des condamnés de droit commun ont été transportés en Nouvelle-Calédonie pour des faits parfois mineurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a74d017-236b-3996-a1e2-55ea82b664de",
                                        "entry_id": "8dec911d-cd9b-37ad-b433-518ac2db6e6f",
                                        "glosses": [
                                            "Rétablissement dans un état antérieur, avant une dégradation ou un blocage ; ré-acceptation, restauration d’une relation endommagée ou interrompue."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afe8b477-ac08-447f-81cf-0f109a432bc4",
                                                "sense_id": "7a74d017-236b-3996-a1e2-55ea82b664de",
                                                "text": "La reconstitution des enveloppes psychiques nécessite une réhabilitation du contact et du toucher comme un appel à une sensorialité non effractive."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "réhabilitation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6975ec1e-5cc9-32db-b8ba-c36324de64d8",
                                        "entry_id": "680a455f-3cc2-358f-8213-cfc49ee9b3a9",
                                        "glosses": [
                                            "Rénovation dans la sauvegarde du bâtiment original."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c29bd28c-83ea-41c5-b033-e0910ba310e1",
                                                "sense_id": "6975ec1e-5cc9-32db-b8ba-c36324de64d8",
                                                "text": "La réhabilitation de l'office de tourisme au Corbier (Savoie) […], respecte l'esprit du tripode conçu par Jean-Paul Bouillon en 1968."
                                            },
                                            {
                                                "example_id": "97d465ab-26ee-4bb4-acae-7239f4c89bcd",
                                                "sense_id": "6975ec1e-5cc9-32db-b8ba-c36324de64d8",
                                                "text": "En 2019, ces deux hommes, âgés de 29 et 34 ans, sans papiers ni formation, avaient chuté d’une dizaine de mètres pendant des travaux de réhabilitation d’une cité d’Épinay-sur-Seine (Seine-Saint-Denis)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
