        "fr-extract.jsonl": [
            {
                "entry_id": "d1ef6f79-95f8-3a70-b069-331512dafa4f",
                "word": "victuaille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5d3961e2-2b1a-472f-8f44-4c4aba3db1c6",
                        "entry_id": "d1ef6f79-95f8-3a70-b069-331512dafa4f",
                        "tags": [
                            "plural"
                        ],
                        "form": "victuailles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce6de1dd-7dec-385a-99a1-681065ea9873",
                        "entry_id": "d1ef6f79-95f8-3a70-b069-331512dafa4f",
                        "glosses": [
                            "Nourriture, provision de bouche. — Note d’usage : Il n’est guère usité qu’au pluriel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d749f26-c3a4-4ffc-bb62-941d783ef1df",
                                "sense_id": "ce6de1dd-7dec-385a-99a1-681065ea9873",
                                "text": "Elle et lui causaient auprès du poêle, pendant que les invités allaient et venaient de la table des victuailles à la table des rafraîchissements."
                            },
                            {
                                "example_id": "057322ac-7aae-48c8-a1d1-48fbfe325332",
                                "sense_id": "ce6de1dd-7dec-385a-99a1-681065ea9873",
                                "text": "Les grenouilles sont un mets exquis quant aux cuisses, on le dit toutefois, car pour ma part je n'en ai jamais gouté ; ce batracien ne m'a jamais tenté en tant que victuailles, […]."
                            },
                            {
                                "example_id": "b9938d76-badb-449d-800a-2e3e03394b68",
                                "sense_id": "ce6de1dd-7dec-385a-99a1-681065ea9873",
                                "text": "C’est pas tout ça, mais où avez-vous fourré les victuailles qui étaient dans le kiosque ?"
                            },
                            {
                                "example_id": "ae309e39-e26f-44b6-a963-ce6ff7bd2ccc",
                                "sense_id": "ce6de1dd-7dec-385a-99a1-681065ea9873",
                                "text": "L'autobus était bourré de paysans chargés de lourds paniers, de sacs de victuailles et accompagnés d'une marmaille d'enfant."
                            },
                            {
                                "example_id": "56c75568-a0f6-47a9-99df-ef4e6dfdfecc",
                                "sense_id": "ce6de1dd-7dec-385a-99a1-681065ea9873",
                                "text": "Autour de moi, des groupes animés se pressent devant les boutiques de victuailles, et je flotte comme une épave au gré de ces flots vivants qui, quand ils submergent, caressent encore."
                            },
                            {
                                "example_id": "cf321df9-d730-47f6-826d-7c1cd89e5214",
                                "sense_id": "ce6de1dd-7dec-385a-99a1-681065ea9873",
                                "text": "Voilà, à côté de nous, quatre ou cinq dauphins roses et gris sortant la tête de l'eau pour happer la victuaille."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3725cb2f-efc1-46f9-9330-f3f72be17108",
                        "source_entry_id": "d1ef6f79-95f8-3a70-b069-331512dafa4f",
                        "source_sense_id": "ce6de1dd-7dec-385a-99a1-681065ea9873",
                        "source_sense_description": "Provision de bouche",
                        "target_lang_word": "Wegzehrung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wegzehrung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "378ae050-8313-33b5-ab70-801c587c948d",
                                        "entry_id": "8c20c567-4bd9-3c3c-a637-9e8cdcfd4b5d",
                                        "glosses": [
                                            "Nahrungsmittel, die man zur Verpflegung mit auf eine Reise nimmt"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5123b43e-e4e0-4c98-adc1-7ddddce4d4a2",
                                                "sense_id": "378ae050-8313-33b5-ab70-801c587c948d",
                                                "text": "„Mit dieser Wegzehrung zog ich von dannen und wägte die drei Horizonte gegeneinander ab.“"
                                            },
                                            {
                                                "example_id": "af67ba90-edf9-4fb0-a830-cd6619806e68",
                                                "sense_id": "378ae050-8313-33b5-ab70-801c587c948d",
                                                "text": "„Sogar eine gebratene Rehkeule hatten sie ihm als Wegzehrung mit ins Grab gelegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2fd26317-01d2-34d5-acb8-9ab344fe5603",
                                        "entry_id": "8c20c567-4bd9-3c3c-a637-9e8cdcfd4b5d",
                                        "glosses": [
                                            "Empfang der Kommunion kurz vor dem Ableben"
                                        ],
                                        "tags": [
                                            "christlicher Glaube"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ac7a199-6824-44f7-a0c4-17209b4ff874",
                                                "sense_id": "2fd26317-01d2-34d5-acb8-9ab344fe5603",
                                                "text": "„Viele Pfarrer machen sich gar kein Bedenken daraus, dieselben ohne die heilige Wegzehrung sterben zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8afd5fe5-a6c1-31f1-876e-cd6b49ff97ba",
                                        "entry_id": "8c20c567-4bd9-3c3c-a637-9e8cdcfd4b5d",
                                        "glosses": [
                                            "Reisegeld von Soldaten"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a980eb2-cda4-434c-a2ee-e03f8078b0d5",
                                                "sense_id": "8afd5fe5-a6c1-31f1-876e-cd6b49ff97ba",
                                                "text": "„War der Entlassene nun gar Unteroffizier mit höherer Löhnung, so konnte diese niedliche Wegzehrung für einen Weg, der niemals marschiert wurde, weit über 1000 Dollars betragen!“"
                                            },
                                            {
                                                "example_id": "aad5f086-5475-41fb-9232-e76a90edecdf",
                                                "sense_id": "8afd5fe5-a6c1-31f1-876e-cd6b49ff97ba",
                                                "text": "„Der Großkanzler wies Di Djän an, beide im westlichen Seitengbäude mit Wein und Speisen zu bewirten und ihnen zehn Unzen Silber als Wegzehrung zu behändigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
