                        "examples": [
                            {
                                "example_id": "11fa3cf4-306c-4670-aef3-06ce34d0bdb9",
                                "sense_id": "a1357c4b-062e-326c-8e20-3d166f3b36ff",
                                "text": "Voor de vertaling van Bunyans gedichten heeft ds. Den Boer de versies van drs. Van ’t Veld gebruikt, die zelfs bij de meeste gedichten een melodie heeft gezocht. Wel aardig, maar het blijkt dat het vertalen van dichtregels veel moeilijker is dan van prozatekst."
                            },
                            {
                                "example_id": "823def2f-f5b7-4f29-8bc5-138d8718f3a6",
                                "sense_id": "a1357c4b-062e-326c-8e20-3d166f3b36ff",
                                "text": "In een prozatekst betekent ook, afgezien van de uitdrukking ”te dien dage”, het Hebreeuwse woord ”joom” altijd een letterlijke dag."
                            }
                        ]
