                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made several <w>additionals</w> to the manuscript before publishing it.",
                            "target_lang_translations": {
                                "ru": "Он внес несколько <w>дополнений</w> в рукопись перед ее публикацией.",
                                "zh": "他在出版手稿前做了几处<w>增补</w>。",
                                "pl": "Przed publikacją wprowadził do rękopisu kilka <w>dodatków</w>."
                            }
                        },
                        {
                            "text": "The bill included various <w>additionals</w> that were not discussed previously.",
                            "target_lang_translations": {
                                "ru": "В счет были включены различные <w>дополнения</w>, которые ранее не обсуждались.",
                                "zh": "账单中包含了一些之前未讨论过的<w>附加</w>项目。",
                                "pl": "Rachunek zawierał różne <w>dodatkowe</w> pozycje, które nie były wcześniej omawiane."
                            }
                        }
