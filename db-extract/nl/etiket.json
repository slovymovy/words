                                "target_senses": [
                                    {
                                        "sense_id": "2da41d80-4787-3619-97eb-b25c79a184d4",
                                        "entry_id": "1f345952-c6a1-3191-82d7-2ea790d703db",
                                        "glosses": [
                                            "Hinweisschild auf Markenartikeln, das vor allem über die Marke oder das gekennzeichnete Produkt selbst informiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "054672a1-3928-4007-8296-ede731e7235d",
                                                "sense_id": "2da41d80-4787-3619-97eb-b25c79a184d4",
                                                "text": "Fast jede Weinflasche hat ein Etikett."
                                            },
                                            {
                                                "example_id": "b76fb6a3-ce94-4222-82eb-2ca890dd89fe",
                                                "sense_id": "2da41d80-4787-3619-97eb-b25c79a184d4",
                                                "text": "„Das Etikett ist gleichsam der Geburtsschein des Weines.“"
                                            },
                                            {
                                                "example_id": "ee609829-2b15-4d9f-b8ea-4326b4106dd0",
                                                "sense_id": "2da41d80-4787-3619-97eb-b25c79a184d4",
                                                "text": "„Er tastete nach dem Jogginganzug, orientierte sich am Etikett im Halsausschnitt des Oberteils und streifte das Oberteil über.“"
                                            },
                                            {
                                                "example_id": "e976002d-6f91-4d88-9984-62b77b857e1b",
                                                "sense_id": "2da41d80-4787-3619-97eb-b25c79a184d4",
                                                "text": "„Er betrachtet das Etikett einen Augenblick, ehe er mir eingießt – ein viertel Glas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ce5629f-bd86-46b7-8b03-fe652bdb5706",
                        "source_entry_id": "7177ca38-9125-3f66-8ced-a8fc9b2ea959",
