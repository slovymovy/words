                        "translation_id": "0a6ac403-af82-4a26-9a19-69586fc397bf",
                        "source_entry_id": "8a43e9c6-cae6-3477-8560-3ae664e1265e",
                        "source_sense_id": "ecae4ffa-5f63-3e92-b3bb-8442e4d794bf",
                        "source_sense_description": "deutschsprachiger Familienname",
                        "target_lang_word": "Smith",
                        "target_lang_code": "en",
