                "senses": [
                    {
                        "sense_id": "a6946f48-6c86-3a38-9863-c64e6eacdc71",
                        "entry_id": "418c94d8-139a-3ff3-bc75-73266daca5fb",
                        "glosses": [
                            "Qui est moins aimé que tous les autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abdab0ea-e709-467e-8d3f-5d519efb91a2",
                                "sense_id": "a6946f48-6c86-3a38-9863-c64e6eacdc71",
                                "text": "C’est son fils mal-aimé."
                            },
                            {
                                "example_id": "831b03d3-04e4-4814-96af-9c36442eeea3",
                                "sense_id": "a6946f48-6c86-3a38-9863-c64e6eacdc71",
                                "text": "C’est sa fille mal-aimée."
                            },
                            {
                                "example_id": "53fa1a9f-9ccc-4e25-ad86-459d4b5e37e2",
                                "sense_id": "a6946f48-6c86-3a38-9863-c64e6eacdc71",
                                "text": "Marthe n’aime pas les enfants. Les enfants gâtés. Mais elle a toujours été émue par les autres : les mal-aimés, les enfants tristes, les enfants en larmes, les enfants enragés de chagrin;."
                            },
                            {
                                "example_id": "90f1ab92-0bb7-4ddf-a895-74a6d8471d25",
                                "sense_id": "a6946f48-6c86-3a38-9863-c64e6eacdc71",
                                "text": "L’appui à Trump des mal-aimés, des illuminés religieux, des fascisants et des racistes peut se comprendre."
                            }
                        ]
                    }
                ],
