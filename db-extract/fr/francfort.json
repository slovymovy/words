        "fr-extract.jsonl": [
            {
                "entry_id": "9cde32dd-bd82-3d1e-8fa9-5e11269bb799",
                "word": "Francfort",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "99fcbf2e-3dc0-3ef1-948a-c30a36e92db9",
                        "entry_id": "9cde32dd-bd82-3d1e-8fa9-5e11269bb799",
                        "glosses": [
                            "Francfort-sur-le-Main."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "425c2a49-dbf4-41f3-8f0d-f66491c29db3",
                                "sense_id": "99fcbf2e-3dc0-3ef1-948a-c30a36e92db9",
                                "text": "Il s'est mis en frais pour la nouvelle édition du Siècle de Louis XIV; il n'a épargné aucun soin; et voilà que, pour fruit de ses peines, M. de La Beaumelle fait imprimer sous main une édition subreptice à Francfort, ville impériale, malgré le privilège de l'empereur, dont Walther est en possession."
                            },
                            {
                                "example_id": "a06b20fb-ea76-495f-9a23-a9f7e7b59fc4",
                                "sense_id": "99fcbf2e-3dc0-3ef1-948a-c30a36e92db9",
                                "text": "Dans mon dernier passage à Francfort, j’avais trouvé mon oncle en possession de la maison et du jardin ; en sage fils, semblable à son père, il s’éleva aux plus hautes dignités de la république."
                            },
                            {
                                "example_id": "ed387a23-2c5a-41f9-bac4-722bd7627a17",
                                "sense_id": "99fcbf2e-3dc0-3ef1-948a-c30a36e92db9",
                                "text": "Et le maréchal-ferrant Knabe, un Alsacien immigré après le traité de Francfort, on le surnomme le Prusco."
                            }
                        ]
                    },
                    {
                        "sense_id": "d01f2d20-3e48-33be-b9d3-c6ceb8c33cd1",
                        "entry_id": "9cde32dd-bd82-3d1e-8fa9-5e11269bb799",
                        "glosses": [
                            "Francfort-sur-l’Oder."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39bf73dd-4c1f-43e6-b088-20dbb57cd726",
                        "source_entry_id": "9cde32dd-bd82-3d1e-8fa9-5e11269bb799",
                        "source_sense_description": "Nom court de Francfort-sur-le-Main ou Francfort-sur-l’Oder",
                        "target_lang_word": "Frankfurt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frankfurt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3276d928-bf1a-3bd6-9951-c71af26af4d4",
                                        "entry_id": "ca2c26f9-7d87-3a46-9688-e1d224cf7237",
                                        "glosses": [
                                            "Stadt in Hessen, Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec0963de-9821-4ada-83f6-e23bd340817f",
                                                "sense_id": "3276d928-bf1a-3bd6-9951-c71af26af4d4",
                                                "text": "Frankfurt ist die Metropole im Rhein-Main-Gebiet."
                                            },
                                            {
                                                "example_id": "03066818-99d8-452e-8e78-fc22f96030c8",
                                                "sense_id": "3276d928-bf1a-3bd6-9951-c71af26af4d4",
                                                "text": "„Noch am gleichen Abend ging eine Postkutsche nach Frankfurt ab.“"
                                            },
                                            {
                                                "example_id": "7080256f-49d5-4c0d-b2e4-efa5b52260ce",
                                                "sense_id": "3276d928-bf1a-3bd6-9951-c71af26af4d4",
                                                "text": "„Deutsche Städte wie Mainz, Frankfurt, Augsburg und Nürnberg waren Vorreiter des Buchdrucks.“"
                                            },
                                            {
                                                "example_id": "9a5dfc25-42b4-4bdf-8ca9-5337b7603e56",
                                                "sense_id": "3276d928-bf1a-3bd6-9951-c71af26af4d4",
                                                "text": "Das mittelalterliche Frankfurt war bedeutend."
                                            },
                                            {
                                                "example_id": "ed9df359-5929-4ed0-9066-8fdd8f96944a",
                                                "sense_id": "3276d928-bf1a-3bd6-9951-c71af26af4d4",
                                                "text": "Die beiden Frankfurt werden des Öfteren verwechselt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5dc326c0-c455-37df-ac76-2a1be1c007e3",
                                        "entry_id": "ca2c26f9-7d87-3a46-9688-e1d224cf7237",
                                        "glosses": [
                                            "Stadt in Brandenburg, Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "371c930c-58d1-4501-969f-10700d21380e",
                                                "sense_id": "5dc326c0-c455-37df-ac76-2a1be1c007e3",
                                                "text": "Das mittelalterliche Frankfurt war bedeutend."
                                            },
                                            {
                                                "example_id": "0ecee154-582e-4b4a-aa6f-a2a21153bf5a",
