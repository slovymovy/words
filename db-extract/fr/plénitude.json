        "fr-extract.jsonl": [
            {
                "entry_id": "d9b05f74-b2d3-3de8-9412-cdf5b8f73d55",
                "word": "plénitude",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6c4cea80-7cb4-4c23-aa7a-b9cb848e9881",
                        "entry_id": "d9b05f74-b2d3-3de8-9412-cdf5b8f73d55",
                        "tags": [
                            "plural"
                        ],
                        "form": "plénitudes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ec8008a-3acd-3bfc-b45b-e1a82cf3cc98",
                        "entry_id": "d9b05f74-b2d3-3de8-9412-cdf5b8f73d55",
                        "glosses": [
                            "État de ce qui est plein."
                        ],
                        "tags": [],
                        "note": "Il n’est guère d’usage, au propre, que comme terme de médecine",
                        "examples": [
                            {
                                "example_id": "2711df20-b950-42b6-bc11-180bdf02cf7b",
                                "sense_id": "2ec8008a-3acd-3bfc-b45b-e1a82cf3cc98",
                                "text": "Le vidage effectué, les assistants ont pu s'assurer que le réservoir vide ne répandait pas plus d'odeur que dans l'état de plénitude; et que si quelques traces d'odeur apparaissaient, dans le cabinet, en niveau seulement de la cuvette, — […] — elles disparaissent immédiatement et complétement par le remplissage, à nouveau, de ce dernier."
                            },
                            {
                                "example_id": "8d7bfaeb-dcf7-4849-a499-926fb1930994",
                                "sense_id": "2ec8008a-3acd-3bfc-b45b-e1a82cf3cc98",
                                "text": "La plénitude de l’estomac. — La plénitude des vaisseaux par surabondance du sang, des humeurs."
                            },
                            {
                                "example_id": "83c03a83-741b-4ed5-84af-4f7584ac8bed",
                                "sense_id": "2ec8008a-3acd-3bfc-b45b-e1a82cf3cc98",
                                "text": "Le petit corps robuste fait penser à celui des jeunes chiens qui semblent contenir dans leur plénitude potelée tous les éléments qui leur serviront à grandir."
                            }
                        ]
                    },
                    {
                        "sense_id": "a77ddead-a464-3ae6-aa1b-27242d6b29e3",
                        "entry_id": "d9b05f74-b2d3-3de8-9412-cdf5b8f73d55",
                        "glosses": [
                            "Qualité d'une chose qui est absolue, entière, complète."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c42013d7-b8ac-4874-b597-e8b3a15064f7",
                                "sense_id": "a77ddead-a464-3ae6-aa1b-27242d6b29e3",
                                "text": "Le droit de justice des seigneurs hauts justiciers était absolu. Il emportait la plénitude de la juridiction civile et criminelle, limitée seulement par les cas royaux."
                            },
                            {
                                "example_id": "bbfc8ade-8f5e-4941-a156-0e1aa3b0d0ee",
                                "sense_id": "a77ddead-a464-3ae6-aa1b-27242d6b29e3",
                                "text": "C’est par plénitude de puissance que les rois accordaient certaines grâces, certaines rémissions qui n’étaient point fondées en droit."
                            },
                            {
                                "example_id": "804af63d-6673-441b-b3fd-2a6e1328fcac",
                                "sense_id": "a77ddead-a464-3ae6-aa1b-27242d6b29e3",
                                "text": "Il a recouvré la plénitude de ses facultés, de ses forces, de sa santé, de sa raison."
                            }
                        ]
                    },
                    {
                        "sense_id": "be8cfb0d-a29f-38b5-bb4d-0d35dde86e36",
                        "entry_id": "d9b05f74-b2d3-3de8-9412-cdf5b8f73d55",
                        "glosses": [
                            "La totalité des sentiments dont le cœur est rempli."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a91bf2ac-6f9a-4689-8f65-61d08c66d2fe",
                                "sense_id": "be8cfb0d-a29f-38b5-bb4d-0d35dde86e36",
                                "text": "Je vous parle dans la plénitude de mon cœur."
                            }
                        ]
                    },
                    {
                        "sense_id": "658c638d-4f2a-384c-8e72-23ecec54d97b",
                        "entry_id": "d9b05f74-b2d3-3de8-9412-cdf5b8f73d55",
                        "glosses": [
                            "Sentiment de pleine satisfaction physique et morale."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "cc9678fe-0dfa-4971-897b-c3d5d0c538d2",
                                "sense_id": "658c638d-4f2a-384c-8e72-23ecec54d97b",
                                "text": "Non seulement ça, mais l’acte de s’accoupler lui procurera une formidable jouissance !\nQui le plongera dans un état de totale plénitude !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3ffcff9-54b0-4a60-8295-0ea73f1a1b8a",
                        "source_entry_id": "d9b05f74-b2d3-3de8-9412-cdf5b8f73d55",
                        "target_lang_word": "volheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "161068ab-52ca-3144-8fb8-f276c243e671",
                                        "entry_id": "8252614e-292c-3ccc-b83d-6efa4b272889",
                                        "glosses": [
                                            "het helemaal gevuld zijn zonder dat er iets ontbreekt; het helemaal perfect zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3012c9d-02eb-4db3-adc0-e3d5067ec945",
                                                "sense_id": "161068ab-52ca-3144-8fb8-f276c243e671",
                                                "text": "Donker, somber. Zo zag de kerk van Zwillbrock eruit toen Edgar Jetter haar in 1958 voor het eerst betrad. Maar onder de lagen bruine verf vond hij de kleurrijke barokke kerk terug, die in 1748 was ingewijd. „Inmiddels spiegelt hier de volheid van de hemel weer op aarde neer.\""
                                            },
                                            {
                                                "example_id": "67ed0225-61ca-4a27-a165-3ede8f5d74cc",
                                                "sense_id": "161068ab-52ca-3144-8fb8-f276c243e671",
                                                "text": "Die volheid van het leven is mooi. Tegelijk merk ik dat het goed is om soms met een boeddhistische bril naar het leven te kijken. Wat Boeddha 2500 jaar geleden zei, kan nu nog een enorme inspiratiebron zijn.\""
                                            },
                                            {
                                                "example_id": "7bf9eb14-d4f8-4adf-8e4c-4ab572d84dab",
                                                "sense_id": "161068ab-52ca-3144-8fb8-f276c243e671",
                                                "text": "‘Al wie heeft geleefd, weet dat de volheid van het leven niet alleen uit feest maar ook uit kwetsuren bestaat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4be8967-43c7-4bad-9eb9-38adae38875c",
                        "source_entry_id": "d9b05f74-b2d3-3de8-9412-cdf5b8f73d55",
                        "target_lang_word": "plenitude",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plenitude",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "7c9486bf-0bcf-3783-924a-da59c5b26ec2",
                                        "entry_id": "bb6e6acb-3b95-3c4b-bceb-73de28e88932",
                                        "glosses": [
                                            "qualidade do que é pleno"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04dc5258-2ddf-49ea-9ded-a1ea48d75939",
                                                "sense_id": "7c9486bf-0bcf-3783-924a-da59c5b26ec2",
                                                "text": "Marx imaginou o socialismo como uma transição para o comunismo, o “reino de abundância” no qual trabalho e prazer se tornariam faces inextricáveis da plenitude da experiência humana."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
