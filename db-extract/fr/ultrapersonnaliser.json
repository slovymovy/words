                                "example_id": "f989118e-41d2-490d-8f98-31d7ed151cd7",
                                "sense_id": "5a8bc62a-b02b-36d2-a279-aaa99f387f07",
                                "text": "L’amour a le pouvoir d’unir sans dépersonnaliser, il ultrapersonnalise en unissant."
                            },
                            {
                                "example_id": "d2f87857-0c51-4a5d-9965-a4f3837b22b5",
                                "sense_id": "5a8bc62a-b02b-36d2-a279-aaa99f387f07",
                                "text": "Elle les différencie au contraire plus outre c’est-à-dire, quand il s’agit de particules réfléchies, elle les ultrapersonnalise."
                            },
                            {
                                "example_id": "331b4394-34ac-41be-8bed-0bb35de02905",
                                "sense_id": "5a8bc62a-b02b-36d2-a279-aaa99f387f07",
                                "text": "Créez du customer centrism, ultrapersonnalisez votre message, répondez aux désirs du client sans douleur : votre histoire, tout le monde va la retenir, tout le monde va y revenir."
                            }
                        ]
