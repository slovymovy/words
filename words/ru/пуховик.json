    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "435c020a-2e0d-32d7-b7b3-939eb794e2e1",
                    "sense_definition": "куртка или пальто, утепленные пухом",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "одежда",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Зимой я всегда ношу теплый <w>пуховик</w>.",
                            "target_lang_translations": {
                                "en": "In winter, I always wear a warm <w>down jacket</w>."
                            }
                        },
                        {
                            "text": "Этот <w>пуховик</w> очень легкий, но отлично защищает от мороза.",
                            "target_lang_translations": {
                                "en": "This <w>puffer jacket</w> is very light, but it protects perfectly against the frost."
                            }
                        }
                    ],
                    "common_phrases": [
                        "теплый пуховик",
                        "купить пуховик"
                    ],
                    "target_lang_definitions": {
                        "en": "A jacket or coat insulated with down feathers."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "down jacket",
                                "target_lang_sense_clarification": "The most common term for a winter jacket filled with down."
                            },
                            {
                                "target_lang_word": "puffer jacket",
                                "target_lang_sense_clarification": "A popular, modern term for a quilted jacket with down or synthetic insulation."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b11f0062-2fa9-3fba-b9df-ef024c42158e",
                    "sense_definition": "мягкая подстилка для сна, набитая пухом или пером",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "постель",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На кровати лежали два пышно взбитых <w>пуховика</w>.",
                            "target_lang_translations": {
                                "en": "There were two fluffily plumped <w>feather beds</w> lying on the bed."
                            }
                        },
                        {
                            "text": "После обеда хозяин любил отдохнуть на мягком <w>пуховике</w>.",
                            "target_lang_translations": {
                                "en": "After lunch, the owner liked to rest on a soft <w>feather bed</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "перина"
                    ],
                    "target_lang_definitions": {
                        "en": "A soft bedding item for sleeping, stuffed with down or feathers."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "feather bed",
                                "target_lang_sense_clarification": "A thick mattress topper or pad filled with feathers or down."
                            },
                            {
                                "target_lang_word": "down duvet",
                                "target_lang_sense_clarification": "A thick, soft quilt filled with down, used as a bed covering."
                            }
                        ]
                    }
                }
            ]
        }
    ]
