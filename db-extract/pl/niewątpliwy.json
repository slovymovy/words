                ],
                "senses": [
                    {
                        "sense_id": "edf81b74-db2d-3b87-be43-92eb7dceb5ed",
                        "entry_id": "1b968b56-6c35-3370-be6f-456649adcca4",
                        "glosses": [
                            "taki, który nie wzbudza żadnych wątpliwości"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3391ea45-326b-469c-b45c-9f42d84b789f",
                                "sense_id": "edf81b74-db2d-3b87-be43-92eb7dceb5ed",
                                "text": "Jego książka odniosła niewątpliwy sukces."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9512225-fa49-491a-a591-974d197d566d",
                        "source_entry_id": "1b968b56-6c35-3370-be6f-456649adcca4",
                        "source_sense_id": "edf81b74-db2d-3b87-be43-92eb7dceb5ed",
                        "target_lang_word": "undoubted",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undoubted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e595e905-e195-3ca9-9176-897599eb184e",
                                        "entry_id": "64ec72f7-d15f-31c5-b6e3-1a702b5c3dbd",
                                        "glosses": [
                                            "Without doubt; without question; certain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "860b26e9-932b-455e-b2b2-a29eb9063fe1",
                                                "sense_id": "e595e905-e195-3ca9-9176-897599eb184e",
                                                "text": "His undoubted skill meant that he was in much demand."
                                            },
                                            {
                                                "example_id": "57a1193b-45a2-404a-9940-07c49e1e90a5",
                                                "sense_id": "e595e905-e195-3ca9-9176-897599eb184e",
                                                "text": "More should I question thee, and more I must,\nThough more to know could not be more to trust,\nFrom whence thou camest, how tended on: but rest\nUnquestion’d welcome and undoubted blest."
                                            },
                                            {
                                                "example_id": "c70d615f-39de-43c5-b951-476ddd1db81f",
                                                "sense_id": "e595e905-e195-3ca9-9176-897599eb184e",
                                                "text": "Thou Spirit who ledſt this glorious Eremite\nInto the Deſert, his Victorious Field\nAgainſt the Spiritual Foe, and broughtſt him thence\nBy proof the undoubted Son of God, […]"
                                            },
                                            {
                                                "example_id": "6bc5939d-c6da-4c4c-af97-16c492ec4a13",
                                                "sense_id": "e595e905-e195-3ca9-9176-897599eb184e",
                                                "text": "Of what he has particularly accused me I am ignorant; but of the truth of what I shall relate, I can summon more than one witness of undoubted veracity."
                                            },
                                            {
                                                "example_id": "6c6bad98-f453-4a16-ac79-fe441b141225",
                                                "sense_id": "e595e905-e195-3ca9-9176-897599eb184e",
                                                "text": "The place of psychology in business is undoubted; whether it can prevail against more concrete and material facts, and if so, how long, remain debatable propositions."
                                            },
                                            {
                                                "example_id": "60ee1453-e7f6-4ced-8f63-4e894fdf8302",
                                                "sense_id": "e595e905-e195-3ca9-9176-897599eb184e",
                                                "text": "Netherlands, one of the pre-tournament favourites, combined their undoubted guile, creativity, pace and attacking quality with midfield grit and organisation."
                                            },
                                            {
                                                "example_id": "dea0fc23-719f-450c-b88a-ff31ca15dd18",
                                                "sense_id": "e595e905-e195-3ca9-9176-897599eb184e",
                                                "text": "The “recognition” before a 2,300-strong congregation of foreign royals, heads of state, former prime ministers, and charity and community representatives, saw him presented four times as “your undoubted king” to the compass points of the raised coronation theatre with no murmur of dissent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b540b15-a554-4443-89dd-f30bed01998a",
                        "source_entry_id": "1b968b56-6c35-3370-be6f-456649adcca4",
                        "source_sense_id": "edf81b74-db2d-3b87-be43-92eb7dceb5ed",
                        "target_lang_word": "indubitable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indubitable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5367b75a-2e7c-3e7b-be31-013c161fd414",
                                        "entry_id": "1687e6c8-3047-3bea-af86-107a121403da",
                                        "glosses": [
                                            "Clearly true; providing no possibility of doubt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e13099f-1127-4a8a-8419-8a08f7308406",
                                                "sense_id": "5367b75a-2e7c-3e7b-be31-013c161fd414",
                                                "text": "The indubitable effect of the potion convinced many nonbelievers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "indubitable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95434f1b-4504-37eb-82ae-554215c5b5b2",
                                        "entry_id": "4c3d331f-8e2e-34a2-828e-4e17552eb5ea",
                                        "glosses": [
                                            "That which is indubitable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3b3c250-2e1f-4f40-9f92-c6dcb79e7c99",
                                                "sense_id": "95434f1b-4504-37eb-82ae-554215c5b5b2",
                                                "text": "If we build logically upwards from a few indubitables, the whole system must remain correct."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cc65a08-83b5-4a4f-a03a-27103a3f5771",
                        "source_entry_id": "1b968b56-6c35-3370-be6f-456649adcca4",
                        "source_sense_id": "edf81b74-db2d-3b87-be43-92eb7dceb5ed",
                        "target_lang_word": "zweifellos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zweifellos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90954dde-5a18-3a91-9050-ca763fcf97e5",
                                        "entry_id": "64877e40-9de6-3d32-bee2-7cb83e99e2ac",
                                        "glosses": [
                                            "ohne Zweifel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e16bf4f-34b6-4778-8df1-a04845049a17",
                                                "sense_id": "90954dde-5a18-3a91-9050-ca763fcf97e5",
                                                "text": "Die Zugspitze ist zweifellos ein hoher Berg, wenn auch nicht der höchste der Welt."
                                            },
                                            {
                                                "example_id": "4d1a9fd6-8468-4376-b7df-40a6528eedf7",
                                                "sense_id": "90954dde-5a18-3a91-9050-ca763fcf97e5",
                                                "text": "„Mithilfe völlig zufälliger Reaktionen entstanden einige der auf Kohlenstoff basierenden chemischen Stoffe, die in Lebewesen vorzufinden sind. Später fand man auf Kohlenstoff basierende chemische Stoffe in Meteoriten und Kometen und sogar im »leeren« Raum. Diese Stoffe sind viel einfacher als jedes Gen und zweifellos nicht lebendig.“"
                                            },
                                            {
                                                "example_id": "4fa286db-614c-4f0e-a67b-c64ff3d81c75",
                                                "sense_id": "90954dde-5a18-3a91-9050-ca763fcf97e5",
                                                "text": "„Das eigenartigste Glied der Elbtalzone ist zweifellos das Elbsandsteingebirge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6dfa137b-782c-48a2-ac15-b3fa34955ef1",
                        "source_entry_id": "1b968b56-6c35-3370-be6f-456649adcca4",
