                "senses": [
                    {
                        "sense_id": "88b8200c-b87d-3222-8ad1-a15ab802fa16",
                        "entry_id": "dd00dc71-44e5-3cd5-a007-11fe45199d2d",
                        "glosses": [
                            "Gesamtheit aller (organisatorischen) Regelungen, Bestimmungen und Vorgänge im Rahmen der Bildung an Gemeinschaftsschulen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3a045e1-aa7f-49c4-8479-ce7e0b654e54",
                                "sense_id": "88b8200c-b87d-3222-8ad1-a15ab802fa16",
                                "text": "„Warum aber soll ein Vater aus Wilhelmsburg, der sich intensiv um die Ausbildung seiner Kinder kümmert, diese in einem Gemeinschaftsschulsystem nicht mehr in einem anderen Stadtteil zur Schule schicken?“"
                            },
                            {
                                "example_id": "c70f75cd-6602-4438-a0f6-d99e2c2ebd10",
                                "sense_id": "88b8200c-b87d-3222-8ad1-a15ab802fa16",
                                "text": "„Es ist keineswegs so, dass es generell in Ländern mit einem Gemeinschaftsschulsystem ein ausgeprägteres Privatschulsystem gibt als in Deutschland.“"
                            },
                            {
                                "example_id": "1e1c4039-2e00-4341-85dc-ae31e4e1c649",
                                "sense_id": "88b8200c-b87d-3222-8ad1-a15ab802fa16",
                                "text": "„In den meisten europäischen Ländern existieren schon ähnliche Gemeinschaftsschulsysteme.“"
                            },
                            {
                                "example_id": "5ab549e0-eee7-4fa1-b74c-884b78aaf596",
                                "sense_id": "88b8200c-b87d-3222-8ad1-a15ab802fa16",
                                "text": "„Im Gegensatz zu den Gemeinschaftsschulsystemen der bislang in diesem Kapitel behandelten Staaten weist die österreichische Bildungslandschaft eine Vielzahl an unterschiedlichen Schulformen auf.“"
                            },
                            {
                                "example_id": "ab03ebad-9246-4a46-8165-e00dda00a63f",
                                "sense_id": "88b8200c-b87d-3222-8ad1-a15ab802fa16",
                                "text": "„Das Bildungsministerium forderte zwar in den 1960er und 1970er Jahren die LEAs auf, die dreigliedrige Struktur zugunsten eines Gemeinschaftsschulsystems wieder abzuschaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
