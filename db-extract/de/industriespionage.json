                                        "entry_id": "3e0f969d-2864-3824-88f3-0df322e92ec9",
                                        "glosses": [
                                            "The use of clandestine methods to acquire secret information for commercial advantage."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "664b7162-6f64-4c9f-8f1a-6dceb20ec8c6",
                                                "sense_id": "81094741-f36c-38e1-9458-edfd90f73da0",
                                                "text": "The American Consul at Leipzig requested the Chamber of Commerce of that city to furnish him with certain information concerning the preparation of rabbit’s skin for the hat trade. The Chamber replied that, although it was desirous of promoting the trade of Germany with foreign countries, it must, as a matter of principle, decline to furnish technical reports on German manufactures that would be likely to assist foreign competitors. The Leipziger Faerber Zeitung published the following, headed “Unfair Competition & Industrial Espionage\" by the Consuls of the United States.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0b2f1f2-2643-340a-87ce-85bf0ba3cedc",
                                        "entry_id": "3e0f969d-2864-3824-88f3-0df322e92ec9",
                                        "glosses": [
                                            "Spying by an employer on labor union activities of employees and on labor unions."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26e9eea7-7771-3b62-b858-4111ec38c65e",
                                        "entry_id": "3e0f969d-2864-3824-88f3-0df322e92ec9",
                                        "glosses": [
                                            "Spying on industrial activities for military advantage."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
