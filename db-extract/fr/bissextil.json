                                            "Synonym of leap year: a year with an intercalary day."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce97e9cc-fd2b-4829-96ea-9fb34706a43a",
                        "source_entry_id": "05b56397-82fb-3ffa-851e-f01d9072a8cb",
                        "source_sense_id": "bfe41889-1ebb-3be2-826e-9ac6b402b9cc",
