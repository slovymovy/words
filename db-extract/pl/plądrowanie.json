                                        "glosses": [
                                            "The act of one who plunders; pillaging or looting; plunder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "287aa786-ce59-4ce6-92ad-403e36ffe185",
                                                "sense_id": "f1b243df-da1e-313f-bd87-224aa9b5207d",
                                                "text": "Not all military exercises by human beings are forbidden. Rather, only disordered and dangerous military exercises that give rise to slayings and plunderings are forbidden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08c3f569-0ff7-4808-86ca-b8437f609023",
                        "source_entry_id": "95e6ea57-ba26-3565-a135-2e99438606ec",
