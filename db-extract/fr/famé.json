                "senses": [
                    {
                        "sense_id": "35be0094-795d-3f39-a9fa-c21da40ebc9d",
                        "entry_id": "901b8186-7028-355c-bf9e-3a6fdd10787f",
                        "glosses": [
                            "Réputé, reconnu. Ne se dit que joint aux adverbes bien, mal : bien famé, mal famé, qui a une bonne, une mauvaise réputation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbe4c86c-d752-48b3-ba53-c5d2027dcd5c",
                                "sense_id": "35be0094-795d-3f39-a9fa-c21da40ebc9d",
                                "text": "Si ma résolution d'habiter seul rencontre le soutien de mon entourage, celui-ci se montre plus réservé quant au choix du quartier, trop proche de la zone mal famée de Montmartre. Pour moi, le lieu est idéal."
                            },
                            {
                                "example_id": "7c00f422-3f5a-42a9-b4a6-98920fda6d8e",
                                "sense_id": "35be0094-795d-3f39-a9fa-c21da40ebc9d",
                                "text": "Tout est perdu, tant que vos agents ne seront que des protégés ou des hommes mal famés."
                            },
                            {
                                "example_id": "b70b8578-a530-47b1-999d-07a315cd1f92",
                                "sense_id": "35be0094-795d-3f39-a9fa-c21da40ebc9d",
                                "text": "Quand un fou s’attaque aux noms les mieux famés."
                            },
                            {
                                "example_id": "a4e27d99-8e3f-478d-9c61-b6bd89f55c27",
                                "sense_id": "35be0094-795d-3f39-a9fa-c21da40ebc9d",
                                "text": "Au fond de ma cour, j'suis renommé … pour avoir le cœur mal famé."
                            }
                        ]
                    }
                ],
