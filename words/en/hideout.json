    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a7eb45e4-c5be-34cc-a08d-9835cd0d0b8c",
                    "sense_definition": "A secret place used for concealment or refuge.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shelter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police finally discovered the robbers' <w>hideout</w> in an abandoned warehouse.",
                            "target_lang_translations": {
                                "es": "La policía finalmente descubrió la <w>guarida</w> de los ladrones en un almacén abandonado."
                            }
                        },
                        {
                            "text": "They'll never find us in this makeshift <w>hideout</w> we've got in the woods.",
                            "target_lang_translations": {
                                "es": "Nunca nos encontrarán en este <w>escondite</w> improvisado que tenemos en el bosque."
                            }
                        }
                    ],
                    "synonyms": [
                        "hideaway",
                        "hiding place"
                    ],
                    "common_phrases": [
                        "secret hideout"
                    ],
                    "target_lang_definitions": {
                        "es": "Lugar secreto utilizado para ocultarse o refugiarse."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "escondite",
                                "target_lang_sense_clarification": "lugar para esconderse"
                            },
                            {
                                "target_lang_word": "guarida",
                                "target_lang_sense_clarification": "refugio, especialmente de delincuentes"
                            },
                            {
                                "target_lang_word": "escondrijo",
                                "target_lang_sense_clarification": "rincón o lugar apartado para ocultarse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af0a97a3-b740-3274-a5b6-cb7304e888ae",
                    "sense_definition": "A hidden headquarters, base of operations, or regular retreat.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "shelter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rebel group operated out of a mountain <w>hideout</w> near the border.",
                            "target_lang_translations": {
                                "es": "El grupo rebelde operaba desde una <w>guarida</w> en la montaña cerca de la frontera."
                            }
                        },
                        {
                            "text": "Detectives believed the syndicate used the isolated cabin as their main <w>hideout</w>.",
                            "target_lang_translations": {
                                "es": "Los detectives creían que el sindicato utilizaba la cabaña aislada como su <w>refugio</w> principal."
                            }
                        }
                    ],
                    "synonyms": [
                        "safe house",
                        "lair"
                    ],
                    "common_phrases": [
                        "mountain hideout"
                    ],
                    "target_lang_definitions": {
                        "es": "Cuartel general secreto, base de operaciones o refugio habitual."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "guarida",
                                "target_lang_sense_clarification": "base o refugio clandestino"
                            },
                            {
                                "target_lang_word": "refugio",
                                "target_lang_sense_clarification": "lugar seguro o base de operaciones"
                            }
                        ]
                    }
                }
            ]
        }
    ]
