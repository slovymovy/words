                                "target_senses": [
                                    {
                                        "sense_id": "798a59bf-454b-3f33-bd16-a16df0ebe0c8",
                                        "entry_id": "b106019b-3e8f-38d2-8914-706ee5b84e61",
                                        "glosses": [
                                            "Just sufficient to return to base (or, alternatively, to divert to an alternative airfield). (also written Bingo or BINGO)"
                                        ],
                                        "tags": [
                                            "US",
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
