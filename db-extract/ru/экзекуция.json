                                                "example_id": "9656322c-e4a4-44ce-a414-01e515ed3c0d",
                                                "sense_id": "b29792e8-e2ee-307c-8839-c3f02e2d4cff",
                                                "text": "„Jeder derartige Versuch werde unnachgiebig mit der Hinrichtung bestraft.“"
                                            },
                                            {
                                                "example_id": "5850f316-1b71-4a6d-ba37-70ab2f7fa537",
                                                "sense_id": "b29792e8-e2ee-307c-8839-c3f02e2d4cff",
                                                "text": "Die Menschenrechtsorganisation Amnesty International registrierte [im Jahr 2017 weltweit] 993 Hinrichtungen und damit vier Prozent weniger als im Vorjahr."
                                            },
                                            {
                                                "example_id": "d53f5b53-9c79-4209-8d08-8ca4621b69c2",
                                                "sense_id": "b29792e8-e2ee-307c-8839-c3f02e2d4cff",
                                                "text": "Amnesty geht davon aus, dass es dort [in China] Jahr für Jahr Tausende Todesurteile und Hinrichtungen gibt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hinrichtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "203f238b-dfbd-3dd8-84b5-6a0dbc4f8c79",
                                        "entry_id": "20bcaffa-c215-3830-b130-49ce61c75210",
                                        "glosses": [
                                            "vorwärts, hinzu verlaufende Richtung; Bewegung oder Übergang zu etwas hin im Gegensatz zum umgekehrten, rückwärtigen Verlauf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff0c7d11-ba3d-4c97-b959-2b9c8f14c9c0",
                                                "sense_id": "203f238b-dfbd-3dd8-84b5-6a0dbc4f8c79",
                                                "text": "Bei diesem Äquivalenzbeweis lässt sich die Hinrichtung leichter beweisen als die Rückrichtung."
                                            },
                                            {
                                                "example_id": "db4b1721-ece4-4b0f-a372-a8a808eb95e0",
                                                "sense_id": "203f238b-dfbd-3dd8-84b5-6a0dbc4f8c79",
                                                "text": "„Die Anzahl der Fahrten auf diesem Weg, in dieser Richtung, sei dann xᵢ (z.B. gerader Index für die Hinrichtung und ungerader Index für die Rückrichtung).“"
                                            },
                                            {
                                                "example_id": "d541be29-0d1c-4989-ae1a-4711a0d5dd9e",
                                                "sense_id": "203f238b-dfbd-3dd8-84b5-6a0dbc4f8c79",
                                                "text": "„Hinrichtung und Rückrichtung einer Strecke sind im Netzmodell zwei eigenständige Objekte, denen die gleiche Streckennummer zugeordnet ist und deren Von-Knoten-Nummer und Nach-Knoten-Nummer gerade vertauscht sind.“"
                                            },
                                            {
                                                "example_id": "1ab81a2d-b580-4586-ad41-e5b313958d1f",
                                                "sense_id": "203f238b-dfbd-3dd8-84b5-6a0dbc4f8c79",
                                                "text": "„Der Wert der Signalgeschwindigkeit in Rückrichtung BA ergibt sich als Folgerung aus der Festlegung des Wertes der Signalgeschwindigkeit in Hinrichtung AB.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0e4da4a-c2fb-461f-bdca-ed70e6ecd08b",
                        "source_entry_id": "886a5d71-2cdf-37de-baec-2ec20235f53f",
                        "target_lang_word": "Exekution",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Exekution",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a86b79ff-05fb-38d9-9157-4a44105571c2",
                                        "entry_id": "ae96e4c0-15d6-3eea-9afd-b65aa7553bfd",
                                        "glosses": [
                                            "Vollstreckung der Todesstrafe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22c975ca-3491-4d06-bca2-2d8daa67dadd",
                                                "sense_id": "a86b79ff-05fb-38d9-9157-4a44105571c2",
                                                "text": "Die Exekution fand am Donnerstag statt."
                                            },
                                            {
                                                "example_id": "3bb604b3-37f2-4397-93f6-2dcb1d363875",
                                                "sense_id": "a86b79ff-05fb-38d9-9157-4a44105571c2",
                                                "text": "„Gemeinsam beteten sie für meine Exekution.“"
                                            },
                                            {
                                                "example_id": "749a2578-d1c5-4b28-a4cc-6704b63daa62",
                                                "sense_id": "a86b79ff-05fb-38d9-9157-4a44105571c2",
                                                "text": "993 Menschen sind im vergangenen Jahr hingerichtet worden, meldet Amnesty International. Die meisten Exekutionen gab es demnach im Iran, Saudi-Arabien und Irak."
                                            },
                                            {
                                                "example_id": "bf92e131-d0db-49ee-b991-a84077091311",
                                                "sense_id": "a86b79ff-05fb-38d9-9157-4a44105571c2",
                                                "text": "„Exekutionen kamen darin nicht vor.“"
                                            },
                                            {
                                                "example_id": "9bd1a8d7-48a4-4303-8537-2c4f06e7c40b",
                                                "sense_id": "a86b79ff-05fb-38d9-9157-4a44105571c2",
                                                "text": "„Viele andere Widerstandskämpfer, die mit dem Fallschirm über dem Protektorat absprangen, endeten durch sofortige Exekution, durch Selbstmord oder im Konzentrationslager.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4e622381-774c-39df-aac7-ab13a7cbbbe7",
                                        "entry_id": "ae96e4c0-15d6-3eea-9afd-b65aa7553bfd",
                                        "glosses": [
                                            "Vollstreckung einer Strafe"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c062f4d0-0195-4391-b8fb-94ee9d8a13fc",
                                                "sense_id": "4e622381-774c-39df-aac7-ab13a7cbbbe7",
                                                "text": "„An der Stelle, wo die Exekutionen vollzogen wurden, gewahrte er eine Menschenansammlung, liess halten und stieg aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fca82b12-15e0-300e-8529-3589ecf52c30",
                                        "entry_id": "ae96e4c0-15d6-3eea-9afd-b65aa7553bfd",
                                        "glosses": [
                                            "Durchführung einer besonderen Sache"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2f4d58fd-182e-3d0f-ad89-e840892c836c",
                                        "entry_id": "ae96e4c0-15d6-3eea-9afd-b65aa7553bfd",
                                        "glosses": [
                                            "Pfändung"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de4f981d-e8b6-4ac6-89ad-dc8cc83825ef",
                                                "sense_id": "2f4d58fd-182e-3d0f-ad89-e840892c836c",
                                                "text": "„Der Bund hat dem Beschwerdeführer Aufwendungen in der Höhe von S 15.000,-- binnen zwei Wochen bei sonstiger Exekution zu ersetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
