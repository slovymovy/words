                ],
                "senses": [
                    {
                        "sense_id": "946bce69-842a-3c3f-a4cb-180d65cd8512",
                        "entry_id": "6524fbd3-7310-3968-80f1-5bcf0d93a395",
                        "glosses": [
                            "Sortir d’une crise."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a9a3c1b2-7732-455c-b230-1cb80b0ba796",
                                "sense_id": "946bce69-842a-3c3f-a4cb-180d65cd8512",
                                "text": "Je ne sais pas, moi, mais n’est-on pas en train d’oublier que la peur, ça reste une émotion parmi d’autres ? Qu’une crise, c’est fait pour décriser ?"
                            },
                            {
                                "example_id": "0221b878-507f-4323-9a09-bcfd465cf38f",
                                "sense_id": "946bce69-842a-3c3f-a4cb-180d65cd8512",
                                "text": "Ça décrise !"
                            },
                            {
                                "example_id": "f3075304-343f-4d9d-b4dd-91be9fb35ac9",
                                "sense_id": "946bce69-842a-3c3f-a4cb-180d65cd8512",
                                "text": "Comment décriser ? Décidément nos politiques portent des lunettes noires car s'ils s'intéressaient aux modes de fonctionnement de nos administrations, ils ne pouvaient pas ignorer les rapports censurés, les comptes-rendus truqués, les positions troubles des uns et des autres..."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b6c2c54-8ff4-30d3-9ee9-7df28e536e47",
                        "entry_id": "6524fbd3-7310-3968-80f1-5bcf0d93a395",
                        "glosses": [
                            "Faire sortir d’une crise."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "30da0210-cebe-4466-8e9a-30d175186c44",
                                "sense_id": "4b6c2c54-8ff4-30d3-9ee9-7df28e536e47",
                                "text": "Le blu est en crise, voilà qui va le décriser !!!"
                            }
                        ]
                    }
                ],
