                                                "example_id": "1ef3cdae-3d5c-41f4-9fdb-5aeeab1135c3",
                                                "sense_id": "c17c1476-2d15-35fe-a857-cec5bd67e427",
                                                "text": "Sudden, the ditches ſwell; the meadows ſwim."
                                            }
