                                    },
                                    {
                                        "sense_id": "6df619b0-d168-3b97-82c1-9fde6e65b98a",
                                        "entry_id": "6687dc69-81b5-3d12-a080-dca6bd4704b0",
                                        "glosses": [
                                            "A judge whose law clerks are often selected to become clerks for the Supreme Court."
                                        ],
