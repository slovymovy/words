{
    "word_family": [
        "wat"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9a44b07c-2d10-35dd-8648-e15425605156",
                    "sense_definition": "Een klein stukje ongesponnen katoen of synthetisch materiaal, vaak gebruikt voor verzorging of reiniging.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "cotton_wool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij deed wat reinigingsmelk op een <w>watje</w> om haar make-up te verwijderen.",
                            "target_lang_translations": {
                                "en": "She put some cleansing milk on a <w>cotton pad</w> to remove her makeup."
                            }
                        },
                        {
                            "text": "Heb je een <w>watje</w> voor me om deze wond schoon te maken?",
                            "target_lang_translations": {
                                "en": "Do you have a <w>cotton ball</w> for me to clean this wound?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "een zacht watje"
                    ],
                    "target_lang_definitions": {
                        "en": "A small piece of unspun cotton or synthetic material, often used for personal care or cleaning."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cotton pad",
                                "target_lang_sense_clarification": "for cosmetic or cleaning use"
                            },
                            {
                                "target_lang_word": "cotton ball",
                                "target_lang_sense_clarification": "small round piece of cotton"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11fe0806-ed73-3a3a-a3b7-82de28937e70",
                    "sense_definition": "Een persoon die weinig moed of doorzettingsvermogen toont; een bangerik of zwakkeling.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wimp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wees geen <w>watje</w> en durf eindelijk eens voor jezelf op te komen.",
                            "target_lang_translations": {
                                "en": "Don't be a <w>wimp</w> and finally dare to stand up for yourself."
                            }
                        },
                        {
                            "text": "Wat een <w>watje</w> is dat, zeg, hij durft niet eens in de achtbaan!",
                            "target_lang_translations": {
                                "en": "What a <w>wimp</w> he is, seriously, he doesn't even dare to go on the roller coaster!"
                            }
                        }
                    ],
                    "synonyms": [
                        "bangerik",
                        "zwakkeling",
                        "schijterd"
                    ],
                    "antonyms": [
                        "durfal",
                        "held"
                    ],
                    "common_phrases": [
                        "een groot watje"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe someone who lacks courage."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person who shows little courage or perseverance; a coward or weakling."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wimp",
                                "target_lang_sense_clarification": "informal term for a weak or cowardly person"
                            },
                            {
                                "target_lang_word": "sissy",
                                "target_lang_sense_clarification": "informal term for someone perceived as weak or cowardly"
                            },
                            {
                                "target_lang_word": "softie",
                                "target_lang_sense_clarification": "someone who is soft or lacks toughness"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}