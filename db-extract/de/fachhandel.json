                "senses": [
                    {
                        "sense_id": "5f9412b8-0912-3718-8f10-0c565305dd81",
                        "entry_id": "f9a08d18-315e-329e-94f1-21bf76e6b0ba",
                        "glosses": [
                            "der sich auf bestimmte Geschäftszweige spezialisierte Handel"
                        ],
                        "tags": [
                            "Einzelhandel"
                        ],
                        "examples": [
                            {
                                "example_id": "6fe814fd-1219-4668-9335-1341fff97871",
                                "sense_id": "5f9412b8-0912-3718-8f10-0c565305dd81",
                                "text": "„Besonders betroffen dürfte die Bundesrepublik sein, ist sie doch viel stärker als beispielsweise Frankreich und Italien vom eigenständigen Fachhandel geprägt.“"
                            },
                            {
                                "example_id": "145de2d0-075c-4547-a802-cc6c0ed053ff",
                                "sense_id": "5f9412b8-0912-3718-8f10-0c565305dd81",
                                "text": "„Aufgrund der Größe von Schiffen und weiterer technischer Fortschritte sind die Kosten für den Transport per Schiff heutzutage verschwindend klein. So kostet der Transport einer Getränkedose lediglich 1 Cent. Mit 8 Euro ist der Schifftransport für Fernseher am teuersten. Doch im Verhältnis zu den Erlösen, die Fernseher im Fachhandel bringen, ist auch hier der Preis für das Überqueren der Ozeane verschwindend klein.“"
                            },
                            {
                                "example_id": "6da10e5d-18a0-4ecc-afb7-15ab7ec44fe7",
                                "sense_id": "5f9412b8-0912-3718-8f10-0c565305dd81",
                                "text": "„Die SIHH ist nur für die Medien und den Fachhandel bestimmt, darum könne man dort sehr zielgerichtet arbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
