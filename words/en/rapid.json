    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "22e5bf17-0f61-35e0-8909-c20c57e2e9f9",
                    "sense_definition": "Moving, acting, or occurring with great speed; very swift or quick.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city has seen <w>rapid</w> growth in its population over the last decade.",
                            "target_lang_translations": {
                                "ru": "За последнее десятилетие в городе наблюдался <w>быстрый</w> рост населения."
                            }
                        },
                        {
                            "text": "The patient showed <w>rapid</w> improvement after starting the new medication.",
                            "target_lang_translations": {
                                "ru": "После начала приема нового лекарства у пациента наступило <w>скорое</w> улучшение."
                            }
                        }
                    ],
                    "synonyms": [
                        "fast",
                        "quick",
                        "swift",
                        "speedy"
                    ],
                    "antonyms": [
                        "slow",
                        "leisurely"
                    ],
                    "common_phrases": [
                        "rapid growth",
                        "rapid improvement",
                        "rapid change",
                        "rapid response"
                    ],
                    "target_lang_definitions": {
