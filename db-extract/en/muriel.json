                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1fd81b83-d39e-3aa6-a2a3-246f4012c3db",
                        "entry_id": "474fa6c2-d8aa-3145-bb87-41b9287d88df",
                        "glosses": [
                            "Muriel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7187ea7e-bd93-4e16-ad87-4e3191246198",
                                "sense_id": "1fd81b83-d39e-3aa6-a2a3-246f4012c3db",
                                "text": "Guy Halifax, gentleman, married Muriel Joyce, spinster, May 17, in the year of our Lord 1779."
                            },
                            {
                                "example_id": "93638f76-bf8c-4d15-b68b-39a3c5a27958",
                                "sense_id": "1fd81b83-d39e-3aa6-a2a3-246f4012c3db",
                                "text": "Lady Muriel accompanied us to the door. \"You couldn't have given my father a more acceptable present!\" she said, warmly."
                            },
                            {
                                "example_id": "68da0b99-ef56-4989-ae51-f56b70c5160d",
                                "sense_id": "1fd81b83-d39e-3aa6-a2a3-246f4012c3db",
                                "text": "Muriel Stuart."
                            },
                            {
                                "example_id": "ae83ddb1-808b-4225-bf35-7f90fa012a5f",
                                "sense_id": "1fd81b83-d39e-3aa6-a2a3-246f4012c3db",
                                "text": "Muriel’s Wedding.",
                                "translation": "Le mariage de Muriel."
                            }
                        ]
                    }
                ],
