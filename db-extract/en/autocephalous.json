                "senses": [
                    {
                        "sense_id": "41486148-68ed-3d4c-a01c-57c3b13c0956",
                        "entry_id": "a311da1a-6496-32b3-9bd1-29c3dba67f87",
                        "glosses": [
                            "Fully independent of the authority of any other church."
                        ],
                        "tags": [
                            "not-comparable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "2ba8fc75-e9c0-4306-a711-e7c15a781854",
                                "sense_id": "41486148-68ed-3d4c-a01c-57c3b13c0956",
                                "text": "The defenders of Anglican independence maintain that there were anciently Churches autocephalous, dependent on no patriarch, and refer to the Churches of Cyprus as thus constituted, and allege that the British Churches enjoyed the same right of self-government and ordained their own prelates."
                            },
                            {
                                "example_id": "305e7495-f07d-4680-8526-a5301638849a",
                                "sense_id": "41486148-68ed-3d4c-a01c-57c3b13c0956",
                                "text": "Poroshenko's speech was viscerally anti-Russian, and his loudest applause line came when he vowed to establish an autocephalous (independent from Moscow) Ukrainian Orthodox Church patriarchate."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a34cd9e-8029-338a-a2f6-990887a38dca",
                        "entry_id": "a311da1a-6496-32b3-9bd1-29c3dba67f87",
                        "glosses": [
                            "Presiding over an autocephalous church."
                        ],
                        "tags": [
                            "not-comparable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a3715ee1-6d40-3d56-ae95-15335d810bb1",
                        "entry_id": "a311da1a-6496-32b3-9bd1-29c3dba67f87",
                        "glosses": [
                            "Independent; not governed by others."
                        ],
                        "tags": [
                            "comparable",
                            "not-comparable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "acd15b31-eb3e-4d1b-be0b-f5c0575e44db",
                                "sense_id": "a3715ee1-6d40-3d56-ae95-15335d810bb1",
                                "text": "This is the Weberian continuum which stretches between the poles of “autocephalous” (self-organized and managing) and “heterocephalous” (organized and managed by others) occupations. […]In the more autocephalous occupations—the professions; the arts; independent accountants, draftsmen, and the like; independent small and medium businessmen in merchandising, manufacturing, artisanry, and the service trades—effective organization is less feasible."
                            }
                        ]
                    }
                ],
