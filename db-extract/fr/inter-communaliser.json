                ],
                "senses": [
                    {
                        "sense_id": "49bf53af-ca9e-39a5-850f-f09245986f05",
                        "entry_id": "c652b43c-09a9-3b5c-94e8-fbea5a932e54",
                        "glosses": [
                            "Donner un caractère inter-communal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3a64658-889f-40d0-87eb-1695a63aaa79",
                                "sense_id": "49bf53af-ca9e-39a5-850f-f09245986f05",
                                "text": "Inter-communaliser l'eau pour faire baisser les factures sera une forme de solidarité avec notre population."
                            },
                            {
                                "example_id": "df3a6c76-04f0-4bcc-ade7-22443b9d30a9",
                                "sense_id": "49bf53af-ca9e-39a5-850f-f09245986f05",
                                "text": "Il faut cesser de développer des activités confidentielles et inter-communaliser en profitant des domaines d'excellence de Montesson, Croissy et Chatou pour réduire les coûts et démocratiser."
                            },
                            {
                                "example_id": "a7d610b0-20cc-46af-b270-d71d5f65e01b",
                                "sense_id": "49bf53af-ca9e-39a5-850f-f09245986f05",
                                "text": "Saint-Louis, Rufisque, Gorée et Dakar se retrouvent du 05 au 09 Novembre 2015 à Rufisque pour revisiter leur passé aux fins d'inter-communaliser leurs actions de développement."
                            }
                        ]
                    }
