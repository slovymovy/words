                    ]
                },
                {
                    "sense_id": "17e5317f-afe7-3cc1-80fe-566e5644ad15",
                    "sense_definition": "Se raccourcir, se resserrer ou diminuer de volume, notamment en parlant d'un tissu, d'un muscle ou d'une matière.",
