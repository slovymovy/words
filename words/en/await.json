{
    "word_family": [
        "wait",
        "waiter",
        "waiting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ccdc699e-d869-3580-bd2d-8a21817f8738",
                    "sense_definition": "To stay in a place or remain in a state of expectation until something happens or someone arrives.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "waiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>await</w> your reply to my letter regarding the new project.",
                            "target_lang_translations": {
                                "ru": "Я <w>ожидаю</w> вашего ответа на мое письмо касательно нового проекта."
                            }
                        },
                        {
                            "text": "The passengers <w>await</w> the arrival of the next train on the platform.",
                            "target_lang_translations": {
                                "ru": "Пассажиры <w>ждут</w> прибытия следующего поезда на платформе."
                            }
                        }
                    ],
                    "synonyms": [
                        "wait for"
                    ],
                    "common_phrases": [
                        "await the arrival",
                        "await a response",
                        "await further instructions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находиться в определенном месте или состоянии ожидания до тех пор, пока что-то не произойдет или кто-то не придет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ожидать",
                                "target_lang_sense_clarification": "официальный или книжный стиль"
                            },
                            {
                                "target_lang_word": "ждать",
                                "target_lang_sense_clarification": "наступления события или прибытия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "848b0122-6e9e-36f2-9e64-43d102276ed8",
                    "sense_definition": "To be in store for someone; to be ready or waiting to happen to someone in the future.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destiny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A warm welcome <w>awaits</w> you when you finally return home.",
                            "target_lang_translations": {
                                "ru": "Теплый прием <w>ожидает</w> вас, когда вы наконец вернетесь домой."
                            }
                        },
                        {
                            "text": "Many challenges <w>await</w> the new team as they start this difficult task.",
                            "target_lang_translations": {
                                "ru": "Множество трудностей <w>предстоит</w> новой команде, когда они приступят к этой сложной задаче."
                            }
                        }
                    ],
                    "common_phrases": [
                        "surprises await",
                        "fate awaits",
                        "challenges await"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предстоять кому-либо; быть уготованным или готовым случиться с кем-либо в будущем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ожидать",
                                "target_lang_sense_clarification": "о будущих событиях или судьбе"
                            },
                            {
                                "target_lang_word": "предстоять",
                                "target_lang_sense_clarification": "быть неизбежным в будущем"
                            },
                            {
                                "target_lang_word": "ждать",
                                "target_lang_sense_clarification": "быть уготованным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "496825e3-d4ad-3c4c-91f0-ff36409f7550",
                    "sense_definition": "To look forward to something occurring; to expect or anticipate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expectation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists <w>await</w> the results of the experiment with great excitement.",
                            "target_lang_translations": {
                                "ru": "Ученые с большим волнением <w>ожидают</w> результатов эксперимента."
                            }
                        },
                        {
                            "text": "We eagerly <w>await</w> the outcome of the election tonight.",
                            "target_lang_translations": {
                                "ru": "Мы с нетерпением <w>ждем</w> итогов выборов сегодня вечером."
                            }
                        }
                    ],
                    "synonyms": [
                        "anticipate"
                    ],
                    "common_phrases": [
                        "eagerly await",
                        "await the outcome",
                        "await results"
                    ],
                    "target_lang_definitions": {
                        "ru": "С нетерпением ждать наступления чего-либо; предвидеть или предвкушать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ожидать",
                                "target_lang_sense_clarification": "предполагать наступление чего-либо"
                            },
                            {
                                "target_lang_word": "предвкушать",
                                "target_lang_sense_clarification": "ждать с приятным волнением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc5916f3-3219-3e3c-ba00-838144cfcbcd",
                    "sense_definition": "To serve or attend to someone; to wait upon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "service",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loyal servants <w>awaited</w> the king during the royal banquet.",
                            "target_lang_translations": {
                                "ru": "Верные слуги <w>прислуживали</w> королю во время королевского банкета."
                            }
                        },
                        {
                            "text": "In the old stories, knights would <w>await</w> their lords with total devotion.",
                            "target_lang_translations": {
                                "ru": "В старинных преданиях рыцари <w>служили</w> своим господам с полной преданностью."
                            }
                        }
                    ],
                    "synonyms": [
                        "attend to"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Служить кому-либо или прислуживать; находиться в распоряжении господина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прислуживать",
                                "target_lang_sense_clarification": "выполнять обязанности слуги"
                            },
                            {
                                "target_lang_word": "обслуживать",
                                "target_lang_sense_clarification": "удовлетворять потребности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "56a485d5-33f8-34ca-9cd6-58c5a09a153e",
                    "sense_definition": "The act of watching closely or keeping someone under suspicious observation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "observation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guards kept the prisoner in close <w>await</w> throughout the night.",
                            "target_lang_translations": {
                                "ru": "Стражники держали заключенного под строгим <w>наблюдением</w> всю ночь."
                            }
                        },
                        {
                            "text": "He watched in close <w>await</w> with his weapons ready for any movement.",
                            "target_lang_translations": {
                                "ru": "Он вел пристальное <w>наблюдение</w>, держа оружие наготове на случай любого движения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in close await"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт пристального наблюдения или содержание кого-либо под подозрительным надзором."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "засада",
                                "target_lang_sense_clarification": "состояние подстерегания"
                            },
                            {
                                "target_lang_word": "ожидание",
                                "target_lang_sense_clarification": "в контексте наблюдения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}