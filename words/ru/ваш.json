                    "sense_id": "1faae1d7-1ef5-35c8-8f9d-72a5c82d22d2",
                    "sense_definition": "Принадлежащий вам или имеющий отношение к вам (используется при обращении к нескольким лицам или как вежливая форма обращения к одному лицу).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Где сейчас находится <ваш> брат?",
                            "target_lang_translations": {
                                "en": "Where is <your> brother right now?"
                            }
                        },
                        {
                            "text": "Назовите, пожалуйста, <ваше> имя.",
                            "target_lang_translations": {
                                "en": "Please state <your> name."
                            }
                        },
                        {
                            "text": "Это <ваше> место или оно свободно?",
                            "target_lang_translations": {
                                "en": "Is this <your> seat or is it free?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ваше имя",
                        "на ваш взгляд",
                        "ваше мнение",
                        "ваш выбор",
                        "ваше здоровье"
                    ],
                    "target_lang_definitions": {
                        "en": "Belonging to you or related to you (used when addressing multiple people or as a polite form of address to one person)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "your",
                                "target_lang_sense_clarification": "Possessive determiner used before a noun to indicate ownership or relation."
