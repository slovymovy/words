                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het mooie <w>weder</w> nodigt uit tot een lange wandeling in het park.",
                            "target_lang_translations": {
                                "en": "The beautiful <w>weather</w> invites one to take a long walk in the park."
                            }
                        },
                        {
                            "text": "Wat een onstuimig <w>weder</w> hebben we toch deze herfst.",
                            "target_lang_translations": {
