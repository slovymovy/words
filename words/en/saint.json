{
    "word_family": [
        "sainthood",
        "saintly",
        "saintliness",
        "unsaintly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2648c4f6-16c1-3570-9825-f6a73a62d9e9",
                    "sense_definition": "A title given to a formally recognized holy person, usually placed before their name.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We visited the cathedral of <w>Saint</w> Paul during our trip to London.",
                            "target_lang_translations": {
                                "ru": "Мы посетили собор <w>Святого</w> Павла во время нашей поездки в Лондон.",
                                "zh": "我们在伦敦旅行期间参观了<w>圣</w>保罗大教堂。"
                            }
                        },
                        {
                            "text": "<w>Saint</w> Patrick is the most famous patron saint of Ireland.",
                            "target_lang_translations": {
                                "ru": "<w>Святой</w> Патрик — самый известный покровитель Ирландии.",
                                "zh": "<w>圣</w>帕特里克是爱尔兰最著名的守护圣人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "St",
                        "St."
                    ],
                    "common_phrases": [
                        "Saint Nicholas",
                        "Saint Valentine",
                        "Saint Patrick"
                    ],
                    "target_lang_definitions": {
                        "ru": "Титул, присваиваемый официально признанному святому, обычно ставится перед именем.",
                        "zh": "一种给予正式认可的圣人的头衔，通常置于名字之前。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "святой",
                                "target_lang_sense_clarification": "титул"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圣",
                                "target_lang_sense_clarification": "用于人名前的头衔"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "577b98d2-fd73-306e-a529-89dfde95d749",
                    "sense_definition": "A deceased person officially recognized by a church as having an exalted status due to their holiness.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "religious_figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The church declared him a <w>saint</w> because of his life of service and prayer.",
                            "target_lang_translations": {
                                "ru": "Церковь провозгласила его <w>святым</w> за его жизнь, полную служения и молитв.",
                                "zh": "教会因他一生致力于服务和祈祷而宣布他为<w>圣人</w>。"
                            }
                        },
                        {
                            "text": "Every village in the region has its own patron <w>saint</w> who is celebrated annually.",
                            "target_lang_translations": {
                                "ru": "У каждой деревни в этом регионе есть свой <w>святой</w> покровитель, которого чествуют ежегодно.",
                                "zh": "该地区的每个村庄都有自己的守护<w>圣人</w>，每年都会举行庆祝活动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "patron saint",
                        "living saint",
                        "saint's day"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умерший человек, официально признанный церковью святым за свою праведность и благочестие.",
                        "zh": "指已故之人，因其圣洁而被教会正式认可为具有崇高地位的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "святой",
                                "target_lang_sense_clarification": "религиозная фигура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圣人",
                                "target_lang_sense_clarification": "宗教意义上的圣徒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5dad9a1-45e0-309c-9de9-40207f27d05d",
                    "sense_definition": "A very virtuous, kind, or patient person.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You are a <w>saint</w> for helping me finish this difficult project on time.",
                            "target_lang_translations": {
                                "ru": "Ты просто <w>святой</w>, раз помог мне закончить этот сложный проект вовремя.",
                                "zh": "你真是个<w>圣人</w>，帮我按时完成了这个困难的项目。"
                            }
                        },
                        {
                            "text": "She must be a <w>saint</w> to deal with those noisy neighbors without complaining.",
                            "target_lang_translations": {
                                "ru": "Она, должно быть, <w>святая</w>, раз терпит этих шумных соседей без жалоб.",
                                "zh": "她一定是个<w>圣人</w>，才能在不抱怨的情况下应付那些吵闹的邻居。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "patience of a saint",
                        "absolute saint",
                        "look like a saint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень добродетельный, добрый или терпеливый человек.",
                        "zh": "指非常善良、仁慈或有耐心的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "святой",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "ангел",
                                "target_lang_sense_clarification": "очень добрый человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圣人",
                                "target_lang_sense_clarification": "比喻极其善良的人"
                            },
                            {
                                "target_lang_word": "活菩萨",
                                "target_lang_sense_clarification": "比喻极其仁慈的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78f2c5d0-8fa2-35ae-8156-0cb4d00d48ab",
                    "sense_definition": "A member of the Church of Jesus Christ of Latter-day Saints; a Mormon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The early <w>Saints</w> traveled west across the plains to find a new home.",
                            "target_lang_translations": {
                                "ru": "Первые <w>святые</w> отправились на запад через равнины в поисках нового дома.",
                                "zh": "早期的<w>圣徒</w>们穿越平原向西迁徙，寻找新的家园。"
                            }
                        },
                        {
                            "text": "He has been a faithful <w>Saint</w> in his local ward for many years.",
                            "target_lang_translations": {
                                "ru": "Он был верным <w>святым</w> в своем местном приходе на протяжении многих лет.",
                                "zh": "多年来，他一直是当地教会中一位忠诚的<w>圣徒</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Latter-day Saint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Член Церкви Иисуса Христа Святых последних дней; мормон.",
                        "zh": "耶稣基督后期圣徒教会的成员；摩门教徒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "святой",
                                "target_lang_sense_clarification": "член религиозной группы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圣徒",
                                "target_lang_sense_clarification": "宗教团体成员"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ebd3c2ae-2e09-3e7d-afcf-078422a21535",
                    "sense_definition": "To officially recognize a deceased person as a saint.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Pope <w>sainted</w> the humble monk hundreds of years after his death.",
                            "target_lang_translations": {
                                "ru": "Папа <w>канонизировал</w> скромного монаха спустя сотни лет после его смерти.",
                                "zh": "教皇在那位谦卑的僧侣去世几百年后将其<w>封圣</w>。"
                            }
                        },
                        {
                            "text": "Many people believed she should be <w>sainted</w> for her miraculous work with the poor.",
                            "target_lang_translations": {
                                "ru": "Многие люди считали, что ее следует <w>причислить к лику святых</w> за ее чудесную работу с бедными.",
                                "zh": "许多人认为，鉴于她为穷人所做的奇迹般的工作，她应该被<w>封圣</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "canonize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально признавать умершего человека святым; канонизировать.",
                        "zh": "正式承认已故之人为圣人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канонизировать",
                                "target_lang_sense_clarification": "причислять к лику святых"
                            },
                            {
                                "target_lang_word": "причислять к лику святых",
                                "target_lang_sense_clarification": "фраза"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "封圣",
                                "target_lang_sense_clarification": "宗教仪式上的认可"
                            },
                            {
                                "target_lang_word": "列入圣品",
                                "target_lang_sense_clarification": "正式程序"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7daf1136-6892-3f75-beb3-b1153acc12a5",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "I have an appointment with Mr. <w>Saint</w> at three o'clock.",
                            "target_lang_translations": {
                                "ru": "У меня назначена встреча с мистером <w>Сентом</w> в три часа.",
                                "zh": "我三点钟和<w>圣</w>先生有个约会。"
                            }
                        },
                        {
                            "text": "The <w>Saint</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Сент</w> живет в этом городе уже несколько поколений.",
                                "zh": "<w>圣</w>氏家族在这个镇上已经住了好几代人了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "used as a family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сент",
                                "target_lang_sense_clarification": "транслитерация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圣",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}