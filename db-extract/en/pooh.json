                "senses": [
                    {
                        "sense_id": "d354d618-df8a-3bf3-8d51-68cc0b45e853",
                        "entry_id": "c9b70449-1af5-3f00-9180-e39ad98c7e7c",
                        "glosses": [
                            "An instance of saying \\\"pooh\\\"."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "82e93cef-7edf-47b2-8ad5-2a8b93478fa1",
                                "sense_id": "d354d618-df8a-3bf3-8d51-68cc0b45e853",
                                "text": "She […] hath ſtiled him with an immortall penne, the bawewawe of ſchollars, the tutt of gentlemen, the tee-heegh of gentlewomen, the phy of citizens, the blurt of Courtiers, the poogh of good letters, the faph of good manners, and the whoop-hooe of good boyes in London ſtreetes."
                            },
                            {
                                "example_id": "b487536c-d231-437a-9d11-77999dc70d8d",
                                "sense_id": "d354d618-df8a-3bf3-8d51-68cc0b45e853",
                                "text": "A thing which causes many ‘poohs’ and ‘pishes’."
                            }
                        ]
                    },
                    {
                        "sense_id": "3fa7e8d9-e4ec-320e-9936-88f7ca4af84c",
                        "entry_id": "c9b70449-1af5-3f00-9180-e39ad98c7e7c",
                        "glosses": [
                            "Alternative form of poo: feces."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "childish",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "80d912e9-bf13-4222-817f-2aa4a4479073",
                                "sense_id": "3fa7e8d9-e4ec-320e-9936-88f7ca4af84c",
                                "text": "‘You're rather in the pooh with the Adelaide police.’ ‘How much do I stink with them?’"
                            }
                        ]
                    },
