                ],
                "senses": [
                    {
                        "sense_id": "4240d70b-763c-3506-8fdb-ffe6e5120ffb",
                        "entry_id": "07ccd546-ce9b-3d4c-885e-8aaf2d4d629e",
                        "glosses": [
                            "To give great joy, delight or pleasure to."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b23d605a-357c-43e9-a38d-8d33361ed639",
                                "sense_id": "4240d70b-763c-3506-8fdb-ffe6e5120ffb",
                                "text": "The prospect of writing three exams in a row without a break does not overjoy me."
                            },
                            {
                                "example_id": "47d31934-c4f9-4dbf-a1ed-40346a105949",
                                "sense_id": "4240d70b-763c-3506-8fdb-ffe6e5120ffb",
                                "text": "This salutation ouerioyes my heart."
                            },
                            {
                                "example_id": "a0a12ac1-b7c0-46f6-9d57-c31e3ff4ed12",
                                "sense_id": "4240d70b-763c-3506-8fdb-ffe6e5120ffb",
                                "text": "In overjoying me, you are grown sad;"
                            },
                            {
                                "example_id": "442e8f68-b958-4aad-9baa-3d94b4541699",
                                "sense_id": "4240d70b-763c-3506-8fdb-ffe6e5120ffb",
                                "text": "If my Letter pleas'd you, your's overjoy'd me; and I expect impatiently your kind Viſit: […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "29b97c27-1ced-30a9-aa14-7d062d36ac09",
                        "entry_id": "07ccd546-ce9b-3d4c-885e-8aaf2d4d629e",
                        "glosses": [
                            "To give too much joy to."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "79e93184-71a6-45da-a824-1ab30d9e2864",
                                "sense_id": "29b97c27-1ced-30a9-aa14-7d062d36ac09",
                                "text": "Ah, child, thou art but half thy darling mother’s; / Hers couldst thou wholly be, / My light in thee would outglow all in others; / She would relive to me. / But niggard Nature’s trick of birth / Bars, lest she overjoy, / Renewal of the loved on earth / Save with alloy."
                            }
                        ]
                    },
                    {
                        "sense_id": "3cbdb493-d586-3b6e-be7c-7f42c658491d",
                        "entry_id": "07ccd546-ce9b-3d4c-885e-8aaf2d4d629e",
                        "glosses": [
                            "To take too much pleasure (in something)."
                        ],
                        "tags": [
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0f160f68-06d5-4f4c-a35f-e48f68453147",
                                "sense_id": "3cbdb493-d586-3b6e-be7c-7f42c658491d",
                                "text": "1598, John Wilbye, The First Set of English Madrigals, London: Thomas Este, Madrigal ,\nYour deeds my hart surchargd with ouerioying:"
                            },
                            {
                                "example_id": "6c508362-3c57-44e7-ab96-6657377c22ce",
                                "sense_id": "3cbdb493-d586-3b6e-be7c-7f42c658491d",
                                "text": "it is hard not to ouer-ioy in a sudden prosperitie, and, to vse happinesse is no lesse difficult, then to forbeare it"
                            },
                            {
                                "example_id": "e61c5643-07b8-445c-aaa0-7bdd503efab7",
                                "sense_id": "3cbdb493-d586-3b6e-be7c-7f42c658491d",
                                "text": "1685, Thomas Manton, “A Description of the True Circumcision” in Several Discourses Tending to Promote Peace and Holiness among Christians, London: Jonathan Robinson, p. 113,\nThat he doth not over-joy in worldly Comforts, nor over-grieve for worldly Losses."
                            }
                        ]
                    }
                ],
