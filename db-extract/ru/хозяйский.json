                            {
                                "example_id": "35a0ec95-0bdd-4487-a4fe-5032f2314756",
                                "sense_id": "b5a83417-f4fb-3e73-9166-42391bf3133b",
                                "text": "хозя́йским гла́зом",
                                "translation": "with a thrifty master's eye",
