                                        "sense_id": "285a8f64-55ed-32f2-8084-5017b9e7ffa9",
                                        "entry_id": "f55fe595-909d-3413-a71a-e025e86aa72f",
                                        "glosses": [
                                            "A rite or ceremony."
                                        ],
                                        "tags": [
                                            "countable",
