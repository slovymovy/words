                                    {
                                        "sense_id": "69e66129-e97c-33e3-b4e7-c5563b468d19",
                                        "entry_id": "3c8887c1-390f-340e-84d2-bee04c1cd974",
                                        "glosses": [
                                            "An object consisting of two metals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5598a9c-bcfa-4b1b-8a66-d6daa338824f",
                                                "sense_id": "69e66129-e97c-33e3-b4e7-c5563b468d19",
                                                "text": "Thermostatic Bimetals: Thermostatic bimetals are laminated composites using materials with a pronounced difference in thermal expansion'. Therefore, thermostatic bimetals change their shape whenever ambient temperature changes."
                                            },
                                            {
                                                "example_id": "d53ed36f-aef6-411e-b1f8-c3e28edbd0cc",
                                                "sense_id": "69e66129-e97c-33e3-b4e7-c5563b468d19",
                                                "text": "The application of bimetals synthesized with the combination of another secondary metal such as Ni, Pd, or Pt [comprise of a high reduction potential than ZVI; ZVI, −0.44 V; Ni,−0.257 V; Pd, 0.915 V; or Pt, 1.188 V; Arning and Minteer[…]"
                                            },
                                            {
                                                "example_id": "14ca984e-bec7-4452-9601-bf3706efc6e5",
                                                "sense_id": "69e66129-e97c-33e3-b4e7-c5563b468d19",
                                                "text": "The bimetals can be used in forms such as the deflection of a straight strip, the rotation of spirals or helices and the snap action of dished discs. Applications include temperature indicators, thermostatic controls, energy regulators,[…]"
                                            }
                                        ]
                                    }
