{
    "word_family": [
        "tease",
        "teasingly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a853541c-023a-3827-a46c-33510d0122a5",
                    "sense_definition": "A short preview or sample of an upcoming product, film, or show released to generate public interest.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "media_preview",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The studio released a thirty-second <w>teaser</w> for the upcoming superhero movie.",
                            "target_lang_translations": {
                                "zh": "制片厂为即将上映的超级英雄电影发布了一支30秒的<w>预告片</w>。"
                            }
                        },
                        {
                            "text": "Fans analysed every frame of the <w>teaser</w> trailer to find hidden clues about the plot.",
                            "target_lang_translations": {
                                "zh": "粉丝们逐帧分析了这支<w>先导预告</w>片，以寻找有关剧情的隐藏线索。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "teaser trailer"
                    ],
                    "target_lang_definitions": {
                        "zh": "为激发公众兴趣而发布的即将推出的产品、电影或节目的简短预告或预览片段。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "预告片",
                                "target_lang_sense_clarification": "影视作品的先导宣传片"
                            },
                            {
                                "target_lang_word": "先导预告",
                                "target_lang_sense_clarification": "简短的抢先预告"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf9b44bd-c92c-316c-b619-2d176c80d92a",
                    "sense_definition": "A person who teases, mocks, or pokes fun at others, often playfully.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_who_teases",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not take his comments to heart; he has always been a terrible <w>teaser</w>.",
                            "target_lang_translations": {
                                "zh": "别把他的话往心里去，他一向是个很爱恶作剧的<w>爱戏弄人的人</w>。"
                            }
                        },
                        {
                            "text": "Her older brother was an unrelenting <w>teaser</w> whenever her friends visited.",
                            "target_lang_translations": {
                                "zh": "每当她的朋友来访时，她的哥哥总是无休止地做一个<w>爱开玩笑的人</w>戏弄她们。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tease"
                    ],
                    "target_lang_definitions": {
                        "zh": "喜欢戏弄、嘲讽或开别人玩笑的人（通常带有打趣性质）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "爱开玩笑的人",
                                "target_lang_sense_clarification": "爱逗弄戏谑他人的人"
                            },
                            {
                                "target_lang_word": "爱戏弄人的人",
                                "target_lang_sense_clarification": "常逗弄别人的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5416656-237f-35ba-8f92-336392192476",
                    "sense_definition": "A brief introductory scene shown at the start of a television episode before the opening credits to hook viewers.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "media_preview",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dramatic <w>teaser</w> ended on a cliffhanger just before the theme music started playing.",
                            "target_lang_translations": {
                                "zh": "在主题曲响起之前，戏剧性的<w>冷开场</w>在一个悬念处戛然而止。"
                            }
                        },
                        {
                            "text": "Writers crafted an intense <w>teaser</w> to keep audiences from changing the channel.",
                            "target_lang_translations": {
                                "zh": "编剧们精心设计了一段紧张刺激的<w>片头序幕</w>，以吸引观众不要换台。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "电视剧一集开场片头曲之前播放的引人入胜的简短先导片段。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "片头序幕",
                                "target_lang_sense_clarification": "片头曲前勾起观众兴趣的序幕"
                            },
                            {
                                "target_lang_word": "冷开场",
                                "target_lang_sense_clarification": "片头曲前的剧情开篇"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ac09c1a-2a97-30e4-8e5a-270dcd4a2d99",
                    "sense_definition": "A person who acts flirtatiously or arouses sexual desire without intending to fulfill it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_who_teases",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He accused her of being a <w>teaser</w> because she led him on and then walked away.",
                            "target_lang_translations": {
                                "zh": "他指责她是个<w>挑逗者</w>，因为她先是吊他胃口，然后又一走了之。"
                            }
                        },
                        {
                            "text": "Nobody enjoyed spending time with someone who acted like an intentional <w>teaser</w>.",
                            "target_lang_translations": {
                                "zh": "没有人喜欢和一个故意充当<w>卖弄风情者</w>的人呆在一起。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tease"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "喜欢挑逗或撩拨他人性欲却无意满足对方的人；卖弄风情者。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挑逗者",
                                "target_lang_sense_clarification": "故意挑逗撩拨的人"
                            },
                            {
                                "target_lang_word": "卖弄风情者",
                                "target_lang_sense_clarification": "轻浮撩拨他人的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92d88d90-ffa8-346a-a62f-7f3f6e726b7e",
                    "sense_definition": "A lure, typically without hooks, used in fishing to attract fish towards other bait.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angler deployed a colorful <w>teaser</w> behind the boat to bring marlin to the surface.",
                            "target_lang_translations": {
                                "zh": "钓客在船后放下一个色彩艳丽的<w>引诱饵</w>，将旗鱼引到水面上来。"
                            }
                        },
                        {
                            "text": "Once the predator approached the <w>teaser</w>, the crew quickly pitched a baited hook.",
                            "target_lang_translations": {
                                "zh": "掠食性大鱼一旦靠近<w>诱鱼器</w>，船员便迅速抛出装有诱饵的鱼钩。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "钓鱼时用于吸引鱼类靠近其他钓饵的引诱物（通常不带钩）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "引诱饵",
                                "target_lang_sense_clarification": "用于引鱼的无钩诱饵"
                            },
                            {
                                "target_lang_word": "诱鱼器",
                                "target_lang_sense_clarification": "吸引鱼游向钓饵的装置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3745ee74-f92b-37bd-b334-3b155976a2c8",
                    "sense_definition": "A short horizontal curtain hung above a theater stage to hide overhead lights and equipment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theater",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stage crew adjusted the <w>teaser</w> to ensure the lighting rigs remained hidden from the audience.",
                            "target_lang_translations": {
                                "zh": "舞台工作人员调整了<w>沿幕</w>，以确保灯光架对观众保持隐蔽。"
                            }
                        },
                        {
                            "text": "A heavy velvet <w>teaser</w> framed the top edge of the proscenium opening.",
                            "target_lang_translations": {
                                "zh": "一条厚重的天鹅绒<w>檐幕</w>点缀在镜框舞台开口的上缘。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "舞台上方悬挂以遮挡灯光和吊装设备的短横幕。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "沿幕",
                                "target_lang_sense_clarification": "剧场舞台上方的横向遮光幕"
                            },
                            {
                                "target_lang_word": "檐幕",
                                "target_lang_sense_clarification": "舞台横檐遮挡幕"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fedf102-aed0-37c7-be94-6424dc616677",
                    "sense_definition": "A predatory seabird of the skua family, specifically a jaeger.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "zoology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The birdwatcher spotted a <w>teaser</w> harassing smaller gulls along the rocky shoreline.",
                            "target_lang_translations": {
                                "zh": "观鸟者在岩石海岸线上发现了一只骚扰体型较小鸥类的<w>贼鸥</w>。"
                            }
                        },
                        {
                            "text": "Known locally as a <w>teaser</w>, the agile bird stole freshly caught fish directly in midair.",
                            "target_lang_translations": {
                                "zh": "这种敏捷的鸟在当地被称为<w>贼鸥</w>，能在半空中直接掠夺刚捕到的鱼。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional bird name"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "贼鸥科的一种掠食性海鸟，特指贼鸥（方言俗称）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "贼鸥",
                                "target_lang_sense_clarification": "一种掠食性海鸟"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ca19458-126c-38a3-968f-8dae1714b2ca",
                    "sense_definition": "A worker who tends and feeds the fire of a glassworks furnace.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "industry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>teaser</w> endured intense heat while shoveling coal into the roaring glassworks furnace.",
                            "target_lang_translations": {
                                "zh": "<w>司炉工</w>顶着酷热往轰鸣的玻璃熔炉里铲煤。"
                            }
                        },
                        {
                            "text": "Maintaining an even temperature required the constant vigilance of an experienced <w>teaser</w>.",
                            "target_lang_translations": {
                                "zh": "维持恒定的温度需要经验丰富的<w>添火工</w>时刻保持警惕。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical industrial occupation"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "玻璃制造厂中照看并向熔炉加煤添柴的添煤工或司炉工。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "司炉工",
                                "target_lang_sense_clarification": "玻璃厂中添煤守炉的工人"
                            },
                            {
                                "target_lang_word": "添火工",
                                "target_lang_sense_clarification": "负责向熔炉添火的工人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f1d7d16-7cd3-354c-b8c8-de1ece89fc29",
                    "sense_definition": "An attendant who dances with and guides the hobby horse during traditional May Day festivities in Padstow, England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "folklore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Holding a decorated club, the <w>teaser</w> led the spirited procession through the crowded streets.",
                            "target_lang_translations": {
                                "zh": "<w>引舞者</w>手持装饰华丽的短棍，带领充满活力的游行队伍穿过拥挤的街道。"
                            }
                        },
                        {
                            "text": "The energetic <w>teaser</w> danced before the horse to traditional drumming and singing.",
                            "target_lang_translations": {
                                "zh": "精力充沛的<w>逗马者</w>在传统的鼓声与歌声中于玩具马前起舞。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Cornwall folklore"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在英国帕德斯托传统五朔节庆祝活动中，手持器具与玩具马共舞并引路的伴舞引导者。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "逗马者",
                                "target_lang_sense_clarification": "英国民俗活动中引逗伴舞者"
                            },
                            {
                                "target_lang_word": "引舞者",
                                "target_lang_sense_clarification": "节庆游行中的伴舞引领人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03d0be20-1e19-397f-b467-527d640c9c54",
                    "sense_definition": "A shunt winding on field magnets designed to preserve magnetism when the main circuit is disconnected.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "electrical_engineering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The generator design included a special <w>teaser</w> to preserve the core magnetic field.",
                            "target_lang_translations": {
                                "zh": "发电机设计包含了一个特殊的<w>保持励磁绕组</w>以维持铁芯磁场。"
                            }
                        },
                        {
                            "text": "Current flowing through the <w>teaser</w> prevented the machine from losing excitation during disconnections.",
                            "target_lang_translations": {
                                "zh": "流经<w>保持励磁绕组</w>的电流防止了电机在断路期间失去励磁。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "early electrical technology"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "励磁磁铁上的分励绕组，用于在主电路断开时保持磁性。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "保持励磁绕组",
                                "target_lang_sense_clarification": "早期电机维持磁性的分励绕组"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c05ec2b6-aced-3272-b3d6-c292f4aa01d6",
                    "sense_definition": "An auxiliary lure rigged alongside a bucktail, especially used when fishing for fluke.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He attached a bright pink <w>teaser</w> a foot above the bucktail to tempt cautious fluke.",
                            "target_lang_translations": {
                                "zh": "他在鹿毛钩上方一英尺处挂了一个亮粉色的<w>副饵</w>，以诱引谨慎的比目鱼。"
                            }
                        },
                        {
                            "text": "Most fluke caught that morning struck the fluttery <w>teaser</w> instead of the heavier main jig.",
                            "target_lang_translations": {
                                "zh": "那天早晨捕获的大多数比目鱼都是咬住了飘动的<w>副饵</w>，而不是较沉重的主铅头钩。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "钓比目鱼等时配合主铅头钩一起使用的副诱饵。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "副饵",
                                "target_lang_sense_clarification": "钓组中搭配主钩的辅助诱饵"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}