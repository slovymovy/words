                    {
                        "sense_id": "b801ae3a-358a-3e5d-9607-5e904cf7c1e4",
                        "entry_id": "11c5755a-d7ac-32f4-b7be-f93b8ee784b7",
                        "glosses": [
                            "Leine zum Führen von Hunden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6aad4df-a6da-4989-905e-2738a033e162",
                                "sense_id": "b801ae3a-358a-3e5d-9607-5e904cf7c1e4",
                                "text": "Die Hundeleine wird am Geschirr oder Halsband des Hundes befestigt."
                            },
                            {
                                "example_id": "51d28083-4c60-4e8e-bba0-1e400b864a74",
                                "sense_id": "b801ae3a-358a-3e5d-9607-5e904cf7c1e4",
                                "text": "„In den Händen hält es eine Hundeleine, aber weit und breit ist kein Hund zu erkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
