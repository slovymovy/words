            "senses": [
                {
                    "sense_id": "dd6a76aa-b303-3f81-b994-dc4d0f4aa072",
                    "sense_definition": "Chauffer de nouveau un aliment ou un plat préparé qui a refroidi.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "chaleur_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu peux <w>réchauffer</w> la soupe au micro-ondes avant de manger."
                        },
                        {
                            "text": "Elle fait <w>réchauffer</w> le reste du dîner pour les enfants."
                        }
                    ],
                    "common_phrases": [
                        "faire réchauffer",
                        "réchauffer un plat"
                    ]
                },
                {
                    "sense_id": "fbae32a1-71bb-3da7-ab09-5344ef9cca63",
                    "sense_definition": "Rendre chaud ou redonner de la chaleur au corps ou à un espace froid.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "chaleur_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il boit une tasse de thé pour se <w>réchauffer</w> après cette longue marche."
                        },
                        {
                            "text": "Ce gros pull en laine va bien te <w>réchauffer</w> pendant l'hiver."
                        }
                    ],
                    "antonyms": [
                        "refroidir"
                    ],
                    "common_phrases": [
                        "se réchauffer les mains",
                        "se réchauffer auprès du feu"
                    ]
                },
                {
                    "sense_id": "e59b7cd0-1ff4-36dd-903b-a7cdfdd6cb60",
                    "sense_definition": "Augmenter la température globale d'un milieu, en particulier de la Terre ou de l'atmosphère.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chaleur_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les émissions de gaz à effet de serre contribuent à <w>réchauffer</w> la planète."
                        },
                        {
                            "text": "La hausse des températures risque de <w>réchauffer</w> les océans de façon durable."
                        }
                    ],
                    "common_phrases": [
                        "réchauffer la planète",
                        "réchauffer le climat"
                    ]
                },
                {
                    "sense_id": "3efc427e-551d-37cf-822d-9068c8f35c7f",
                    "sense_definition": "Apporter du réconfort moral, consoler ou faire naître un sentiment doux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sens_figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses paroles chaleureuses ont suffi à lui <w>réchauffer</w> le cœur."
                        },
                        {
                            "text": "Ce message d'amitié m'a fait du bien et a <w>réchauffé</w> mes pensées tristes."
                        }
                    ],
                    "synonyms": [
                        "réconforter"
                    ],
                    "common_phrases": [
                        "réchauffer le cœur"
                    ]
                },
                {
                    "sense_id": "13bd1e31-fad0-3541-8dfb-160d982023a7",
                    "sense_definition": "Redonner de la vigueur, de la vivacité ou de l'enthousiasme à quelque chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sens_figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le discours inspirant du capitaine est venu <w>réchauffer</w> l'ardeur des troupes fatiguées."
                        },
                        {
                            "text": "Cette belle victoire est venue <w>réchauffer</w> un enthousiasme qui faiblissait peu à peu."
                        }
                    ],
                    "synonyms": [
                        "ranimer"
                    ],
                    "common_phrases": [
