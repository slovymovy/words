            {
                "entry_id": "3b0c9286-782a-3ace-9c78-c29593e7a468",
                "word": "onagre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a8e2f3f2-7f2b-4c71-b3c1-4b2c5a6c370b",
                        "entry_id": "3b0c9286-782a-3ace-9c78-c29593e7a468",
                        "tags": [
                            "plural"
                        ],
                        "form": "onagres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "08d0b5f4-2d48-3206-8a73-4462ba8b9b3e",
                        "entry_id": "3b0c9286-782a-3ace-9c78-c29593e7a468",
                        "glosses": [
                            "Synonyme de œnothère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0f46192-ac18-4f9b-87a7-975c2909ca7c",
                                "sense_id": "08d0b5f4-2d48-3206-8a73-4462ba8b9b3e",
                                "text": "Regardez là-bas le ciel de ce beau vert diapré de malachite. Bientôt le soleil passera, et lorsqu’il s’enfoncera dans les montagnes, l’horizon prendra la couleur des pétales d’onagre. Avant peu, les nuances terniront et céderont la place au reflet argenté du crépuscule."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc94489f-a2d8-4160-b1ce-890185ade635",
                        "source_entry_id": "3b0c9286-782a-3ace-9c78-c29593e7a468",
                        "source_sense_id": "08d0b5f4-2d48-3206-8a73-4462ba8b9b3e",
                        "target_lang_word": "Nachtkerze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachtkerze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05c29f30-62c8-3be7-a572-700de5091620",
                                        "entry_id": "2a258a97-1141-3e3d-a731-1ef10bcd2ffa",
                                        "glosses": [
                                            "Pflanze mit verzweigtem Stängel, ovalen bis lanzettförmigen Blättern und oft in Trauben oder Ähren wachsenden, großen, gelben Blüten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a89e186-702b-4579-97e3-2d337bd5f01b",
                                                "sense_id": "05c29f30-62c8-3be7-a572-700de5091620",
                                                "text": "Die Nachtkerze gedeiht vor allem auf mageren, sandigen Böden."
                                            }
                                        ],
