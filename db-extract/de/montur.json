                    },
                    {
                        "translation_id": "2ed6d788-a968-455f-b6ee-6281bbbb3b36",
                        "source_entry_id": "37876bc1-d82b-33d7-acbe-e7cefcfbd458",
                        "source_sense_id": "6cd7fadb-4301-3c73-a9ca-09cddf7688f3",
