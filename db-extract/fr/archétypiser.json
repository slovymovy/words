                "senses": [
                    {
                        "sense_id": "2b416545-efa6-3783-8807-7ba6016fdb1b",
                        "entry_id": "7aea53a0-314d-31eb-8b5c-77789495eb12",
                        "glosses": [
                            "Donner un caractère archétypique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1b3e559-1123-4471-8653-cec283f93133",
                                "sense_id": "2b416545-efa6-3783-8807-7ba6016fdb1b",
                                "text": "Le tourisme « archétypise » le territoire, le fige."
                            },
                            {
                                "example_id": "07a13ff2-4843-4c28-aee4-ebd91b96b383",
                                "sense_id": "2b416545-efa6-3783-8807-7ba6016fdb1b",
                                "text": "Ça archétypise à mort là!"
                            },
                            {
                                "example_id": "3d5900c8-f23a-47e9-a119-f35bc785baf4",
                                "sense_id": "2b416545-efa6-3783-8807-7ba6016fdb1b",
                                "text": "Loin d'assumer des puissances de singularisation de l'inconscient collectif, Jung les uniformise, les « archétypise », leur fait subir une détotalisation qui les rend neutres et passives plutôt qu’une déterritorialisation qui les rende activement processuelles : (…)"
                            }
                        ]
                    }
