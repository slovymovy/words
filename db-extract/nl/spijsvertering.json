                                "target_senses": [
                                    {
                                        "sense_id": "2ffcf6c5-815a-336c-80ce-b8cd431bdd3d",
                                        "entry_id": "a73812ac-667a-3d9a-a5e0-2fc906d57de6",
                                        "glosses": [
                                            "The process, in the gastrointestinal tract, by which food is converted into substances that can be used by the body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6ca9726-b217-469b-a0ab-06d2fb884fca",
                                                "sense_id": "2ffcf6c5-815a-336c-80ce-b8cd431bdd3d",
                                                "text": "In the dead state all is apparently without motion. No agent within indicates design, intelligence, or foresight: there is no respiration; no digestion, circulation, or nutrition; […]"
                                            },
                                            {
                                                "example_id": "cd2e1045-3679-498f-8235-72dd8954e5d9",
                                                "sense_id": "2ffcf6c5-815a-336c-80ce-b8cd431bdd3d",
                                                "text": "As for Grierson, he poured liquor into himself as if it were so much soothing syrup, demonstrating that a good digestion is the highest form of good conscience."
                                            },
                                            {
                                                "example_id": "a4ecf268-b5a2-4621-8719-a2d316519f5d",
                                                "sense_id": "2ffcf6c5-815a-336c-80ce-b8cd431bdd3d",
                                                "text": "Mostly, the microbiome is beneficial. It helps with digestion and enables people to extract a lot more calories from their food than would otherwise be possible. Research over the past few years, however, has implicated it in diseases from atherosclerosis to asthma to autism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "544f2a99-8393-3c5f-a543-f39ae13be263",
                                        "entry_id": "a73812ac-667a-3d9a-a5e0-2fc906d57de6",
                                        "glosses": [
                                            "The result of this process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
