                ],
                "senses": [
                    {
                        "sense_id": "1ba257a1-af5c-3671-8ea4-8bc7609b3e34",
                        "entry_id": "b16ea6a3-e828-3c06-b758-cb3a783a221d",
                        "glosses": [
                            "A repining."
                        ],
                        "tags": [
                            "archaic",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3d0b3185-2c1c-4cf5-b93e-036f1093c088",
                                "sense_id": "1ba257a1-af5c-3671-8ea4-8bc7609b3e34",
                                "text": "Whose beams upon his hairless face are fix’d / As if from thence they borrowed all their shine. / Were never four such lamps together mix’d, / Had not his clouded with his brow’s repine; […]"
                            },
                            {
                                "example_id": "8c0ae6d4-ee3e-4d44-9366-cd823ecfcc44",
                                "sense_id": "1ba257a1-af5c-3671-8ea4-8bc7609b3e34",
                                "text": "And ye, fair heaps, the Muses’ sacred shrines, / (In spite of time and envious repines) / Stand still and flourish till the world’s last day, / Upbraiding it with former love’s decay."
                            },
                            {
                                "example_id": "b3afe9b3-81ad-48c9-8f08-e8bf86519192",
                                "sense_id": "1ba257a1-af5c-3671-8ea4-8bc7609b3e34",
                                "text": "It would, therefore, be criminal negligence did we not embrace this chance to proclaim broadcast, through such men as by their learning, their repines of judgment, their character and their works, will command general recognition and attention"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
