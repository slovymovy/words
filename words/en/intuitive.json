    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "abf6aa49-868b-3a8a-9d08-94265644e6a9",
                    "sense_definition": "Easy to understand or use without special instruction or conscious reasoning.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The app features an <w>intuitive</w> interface that requires no user training.",
                            "target_lang_translations": {
                                "de": "Die App bietet eine <w>intuitive</w> Benutzeroberfläche, die keine Einarbeitung erfordert."
                            }
                        },
                        {
                            "text": "Good design should provide an <w>intuitive</w> user experience right out of the box.",
                            "target_lang_translations": {
                                "de": "Gutes Design sollte von Beginn an ein <w>intuitives</w> Nutzungserlebnis bieten."
                            }
                        }
                    ],
                    "synonyms": [
                        "user-friendly",
                        "easy-to-use"
                    ],
                    "antonyms": [
                        "unintuitive"
                    ],
                    "common_phrases": [
                        "intuitive interface",
                        "intuitive design",
                        "intuitive user experience"
                    ],
                    "target_lang_definitions": {
                        "de": "Leicht verständlich oder ohne Anleitung beziehungsweise bewusstes Nachdenken zu bedienen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "intuitiv",
                                "target_lang_sense_clarification": "selbsterklärend und einfach bedienbar"
                            },
                            {
                                "target_lang_word": "selbsterklärend",
                                "target_lang_sense_clarification": "ohne Erklärung verständlich"
                            },
                            {
                                "target_lang_word": "benutzerfreundlich",
                                "target_lang_sense_clarification": "einfach zu handhaben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4b9a044-c039-3fc5-9100-865e6d4236ea",
                    "sense_definition": "Having or showing the ability to understand things instinctively.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is an <w>intuitive</w> person who can easily read other people's feelings.",
                            "target_lang_translations": {
                                "de": "Sie ist eine <w>intuitive</w> Person, die die Gefühle anderer Menschen leicht deuten kann."
                            }
                        },
                        {
                            "text": "An <w>intuitive</w> thinker can often solve complex problems without knowing the exact steps.",
                            "target_lang_translations": {
                                "de": "Ein <w>intuitiver</w> Denker kann oft komplexe Probleme lösen, ohne die genauen Schritte zu kennen."
                            }
                        }
                    ],
                    "synonyms": [
                        "insightful",
                        "perceptive"
                    ],
                    "common_phrases": [
                        "intuitive thinker",
                        "intuitive understanding",
                        "intuitive feel"
                    ],
                    "target_lang_definitions": {
                        "de": "Die Fähigkeit besitzend oder zeigend, Dinge instinktiv oder gefühlsmäßig zu verstehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "intuitiv",
                                "target_lang_sense_clarification": "aus dem Bauchgefühl heraus handelnd oder denkend"
                            },
                            {
                                "target_lang_word": "einfühlsam",
                                "target_lang_sense_clarification": "stark wahrnehmend oder empathisch"
                            },
                            {
                                "target_lang_word": "feinfühlig",
                                "target_lang_sense_clarification": "mit gutem Gespür ausgestattet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03c75e1a-9d0e-34ce-9c86-9468cb89ddd7",
                    "sense_definition": "Obtained through or based on feelings rather than careful thought or facts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>intuitive</w> response turned out to be completely correct.",
                            "target_lang_translations": {
                                "de": "Seine <w>intuitive</w> Reaktion stellte sich als vollkommen richtig heraus."
                            }
                        },
                        {
                            "text": "I had an <w>intuitive</w> sense that something was wrong with the plan.",
                            "target_lang_translations": {
                                "de": "Ich hatte das <w>intuitive</w> Gefühl, dass mit dem Plan etwas nicht stimmte."
                            }
                        }
                    ],
                    "synonyms": [
                        "instinctive",
                        "gut"
                    ],
                    "antonyms": [
                        "counterintuitive",
                        "unintuitive"
                    ],
                    "common_phrases": [
                        "intuitive sense",
                        "intuitive feeling",
                        "intuitive response"
                    ],
                    "target_lang_definitions": {
                        "de": "Auf einem Gefühl oder einer Eingebung beruhend statt auf bewusster Überlegung oder Fakten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "intuitiv",
                                "target_lang_sense_clarification": "auf einer Eingebung oder Ahnung beruhend"
                            },
                            {
                                "target_lang_word": "instinktiv",
                                "target_lang_sense_clarification": "einem natürlichen Impuls folgend"
                            },
                            {
                                "target_lang_word": "gefühlsmäßig",
                                "target_lang_sense_clarification": "aus dem Bauch heraus"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cdeadfbb-8d2b-3df6-b158-a3abdeba2862",
                    "sense_definition": "A person who relies on or possesses strong instinctive or perceptive insight.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As an <w>intuitive</w>, she often picks up on details that others completely miss.",
                            "target_lang_translations": {
                                "de": "Als <w>Gefühlsmensch</w> bemerkt sie oft Details, die anderen völlig entgehen."
                            }
                        },
                        {
                            "text": "The panel included both analytical thinkers and natural <w>intuitives</w>.",
                            "target_lang_translations": {
                                "de": "Das Gremium umfasste sowohl analytische Denker als auch geborene <w>Intuitionsmenschen</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, die sich auf ein starkes instinktives Gespür oder Ahnungsvermögen verlässt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gefühlsmensch",
                                "target_lang_sense_clarification": "Person, die nach Intuition und Gefühl handelt"
                            },
                            {
                                "target_lang_word": "Intuitionsmensch",
                                "target_lang_sense_clarification": "intuitiv veranlagte Person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
