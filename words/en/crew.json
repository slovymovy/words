        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3dd52814-67c6-3c00-8948-68e0e6ef59f3",
                    "sense_definition": "To serve as a member of a crew on a boat or ship.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "serve_crew",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>crewed</w> together on a fishing boat last summer.",
                            "target_lang_translations": {
                                "ru": "Мы <w>работали в одной команде</w> на рыбацкой лодке прошлым летом.",
                                "tr": "Geçen yaz bir balıkçı teknesinde birlikte <w>mürettebatlık yaptık</w>.",
                                "zh": "去年夏天，我们在一艘渔船上一起<w>担任船员</w>。"
                            }
                        },
                        {
                            "text": "She has <w>crewed</w> on several yachts crossing the Atlantic.",
                            "target_lang_translations": {
                                "ru": "Она <w>была членом экипажа</w> на нескольких яхтах, пересекающих Атлантику.",
                                "tr": "Atlantik'i geçen birkaç yatta <w>mürettebat olarak çalıştı</w>.",
                                "zh": "她曾在几艘横渡大西洋的游艇上<w>担任船员</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Служить членом экипажа на лодке или корабле.",
                        "tr": "Bir teknede veya gemide mürettebat olarak görev yapmak.",
                        "zh": "指在船只上担任船员工作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть членом экипажа",
                                "target_lang_sense_clarification": "служить на судне"
                            },
                            {
                                "target_lang_word": "работать в команде",
                                "target_lang_sense_clarification": "на судне"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mürettebatlık yapmak",
                                "target_lang_sense_clarification": "gemide/teknede çalışmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "担任船员",
                                "target_lang_sense_clarification": "在船上工作"
                            }
                        ]
                    }
