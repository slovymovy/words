                ],
                "senses": [
                    {
                        "sense_id": "9f2375bc-1b4a-31a4-84e3-007355352ccb",
                        "entry_id": "1a913869-08d4-3628-91bc-f2201489c15e",
                        "glosses": [
                            "verformte Stelle an oder in Etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b42dbfb2-6200-48ea-9f67-e9f7148fc823",
                                "sense_id": "9f2375bc-1b4a-31a4-84e3-007355352ccb",
                                "text": "Die Stoßstange am Auto kann nur begrenzt Kunststoffverformungen durch Krafteinwirkung aufnehmen!"
                            },
                            {
                                "example_id": "c69a9eb0-8775-4fef-96ae-2c68e0e1e2b5",
                                "sense_id": "9f2375bc-1b4a-31a4-84e3-007355352ccb",
                                "text": "Zu viel Hitze fürt zu Kunststoffverformungen die später auch bei Kälte nicht mehr weggehen."
                            },
                            {
                                "example_id": "388c5886-ee21-4c77-8129-e37f68d09897",
                                "sense_id": "9f2375bc-1b4a-31a4-84e3-007355352ccb",
                                "text": "„Beim Entwerfen einer Automobilleuchte ist die genaue Vorhersage des thermischen Verhaltens entscheidend: Starke Wärmebelastungen können schwere Kunststoffverformungen sowohl des Gehäuses als auch der externen Linsen verursachen, was zu generellen Schäden an den optischen Komponenten insgesamt führen kann.“"
                            },
                            {
                                "example_id": "79b0a940-ed01-4553-b3c5-a22b91474f3d",
                                "sense_id": "9f2375bc-1b4a-31a4-84e3-007355352ccb",
                                "text": "Ohne Kunststoffverformungen, wie sie bei anderen 38999 Steckverbinderdesigns auftreten, liefert der MXL38999 eine stabile optische Leistung über einen großen Temperaturbereich."
                            },
                            {
                                "example_id": "2a87b0a5-b909-40c9-972b-3c2de0e3ebd4",
                                "sense_id": "9f2375bc-1b4a-31a4-84e3-007355352ccb",
                                "text": "„Bei einer Kassette ohne die Führungen für die Biegung 35 wäre die Widerstandskraft vor der Kunststoffverformung viel höher, aber die gesamte Energieaufnahme viel niedriger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "410534c3-3045-385c-b162-79488697316e",
                        "entry_id": "1a913869-08d4-3628-91bc-f2201489c15e",
                        "glosses": [
                            "Vorgang, durch den Kunststoffe in eine andere oder bestimmte Form verändert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc8e8be3-67c8-4c4f-a6ac-160ec6466486",
                                "sense_id": "410534c3-3045-385c-b162-79488697316e",
                                "text": "„Bei einer Kassette ohne die Führungen für die Biegung 35 wäre die Widerstandskraft vor der Kunststoffverformung viel höher, aber die gesamte Energieaufnahme viel niedriger.“"
                            },
                            {
                                "example_id": "f79204bf-7d42-4e75-b958-5cf673a0b36c",
                                "sense_id": "410534c3-3045-385c-b162-79488697316e",
                                "text": "„Im Vergleich zu herkömmlichen Verfahren der Kunststoffverformung, welche derzeit sämtlich in Billiglohnländer ausgelagert sind, läuft das neue Verfahren nun Prozesstakt-gesteuert automatisiert ab, ist sauber und vor allem energiesparend.“"
                            },
                            {
                                "example_id": "d1fea495-b8d9-4c39-b448-691e43bedf0e",
                                "sense_id": "410534c3-3045-385c-b162-79488697316e",
                                "text": "„Diese Art der Kunststoffverformung ermöglicht es, zum Beispiel Blister für Münzen oder Elektronikelemente, aber auch beflockte Kunststoffeinsätze für Besteck-Kästen, herzustellen.“"
                            },
                            {
                                "example_id": "373a9ed1-a240-4289-ad65-a1498b06cf87",
                                "sense_id": "410534c3-3045-385c-b162-79488697316e",
                                "text": "„Seit vielen Jahren wird die Infrarotwärme schon als technisches Hilsmittel erfolgreich in der Industrie eingesetzt, z.B. zur Erwärmung, Trocknung, Sterilisation oder Kunststoffverformung.“"
                            },
                            {
                                "example_id": "a4976539-d8d3-44e5-a857-127b4b1f16a1",
                                "sense_id": "410534c3-3045-385c-b162-79488697316e",
                                "text": "„Oswald Firnbach zeigte den Besuchern alle Arbeitsschritte von der Kunststoffverformung, über die Fertigmontage bis hin zum Verpacken der Dachboxen.“"
                            },
                            {
                                "example_id": "b7a47ec6-d449-4a2f-965f-9bb0d170a428",
                                "sense_id": "410534c3-3045-385c-b162-79488697316e",
                                "text": "„Hier finden Sie eine kleine Auswahl an Kunststoffprodukten aus unseren Fertigungsbereichen thermoplastische Kunststoffverformung und Kunststoffbearbeitung […]“"
                            },
                            {
                                "example_id": "065857df-c9c3-4b5f-a7bf-70cd3a4de223",
                                "sense_id": "410534c3-3045-385c-b162-79488697316e",
                                "text": "„Im Bereich Werkzeugbau beschäftigen wir uns mit der Herstellung von Werkzeugen für die Blechumformung, Innenhochdruckverformung und Kunststoffverformung und deren Beschneidung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
