                ],
                "senses": [
                    {
                        "sense_id": "f9337d38-b75d-3e9b-80b7-8c885033cfbe",
                        "entry_id": "2c600af3-80ce-317b-8430-0f01884cd119",
                        "glosses": [
                            "to build"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8fa201eb-9234-4a8e-b6e4-3614245ba4be",
                                "sense_id": "f9337d38-b75d-3e9b-80b7-8c885033cfbe",
                                "text": "Октябрьский дождь снова полил на нас, ― мы спешили состроить себе шалаши и рассчитывали, что обсушимся и отогреемся у костров.",
                                "translation": "The October rain poured on us again – we were in a hurry to build huts for ourselves and hoping to dry ourselves and warm up by the fires.",
                                "english": "The October rain poured on us again – we were in a hurry to build huts for ourselves and hoping to dry ourselves and warm up by the fires."
                            }
                        ]
                    },
                    {
                        "sense_id": "7cfd02ef-b757-3002-91df-1b29a460eb2f",
                        "entry_id": "2c600af3-80ce-317b-8430-0f01884cd119",
                        "glosses": [
                            "to arrange, to organise"
                        ],
                        "tags": [
                            "colloquial",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9e522a18-c641-4a50-b930-37a43cd4296d",
                                "sense_id": "7cfd02ef-b757-3002-91df-1b29a460eb2f",
                                "text": "Вскоре отец приметил к Агате страсть его и спешил состроить план для её разрушения.",
                                "translation": "Before long, the father had noticed his passion for Agatha and hurried to make a plan for her destruction.",
                                "english": "Before long, the father had noticed his passion for Agatha and hurried to make a plan for her destruction."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d3f64ba-d58c-3498-b66e-47320d696dd5",
                        "entry_id": "2c600af3-80ce-317b-8430-0f01884cd119",
                        "glosses": [
                            "to pull a facial expression, to grimace"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "979f3030-5bae-41f4-bbec-b07fab9a140d",
                                "sense_id": "0d3f64ba-d58c-3498-b66e-47320d696dd5",
                                "text": "Поликарп состроил недовольное лицо и, не отрывая глаз от книги, слегка приподнялся.",
                                "translation": "Polycarp pulled a displeased face and, without taking his eyes off the book, raised himself slightly.",
                                "english": "Polycarp pulled a displeased face and, without taking his eyes off the book, raised himself slightly."
                            }
                        ]
                    }
                ],
