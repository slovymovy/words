                        "glosses": [
                            "Fahrt mit einem Schiff auf dem Rhein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e45242a0-6dd5-4764-8f71-f321abfeda12",
                                "sense_id": "28d43e6f-bccc-3abf-a8bd-d0b08cd5c88b",
                                "text": "„Es finden zwar keine Rheinschifffahrten und Rheinrundfahrten als Linienfahrten wie während der Saison statt, wohl aber Tagesschifffahrten und Schiffrundfahrten als Sonderfahrten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
