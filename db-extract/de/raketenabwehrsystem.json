                        "examples": [
                            {
                                "example_id": "e8250092-30af-4773-bef0-91cdbd0e125b",
                                "sense_id": "29bdbba5-5803-3cfe-82ed-2ce2320c7271",
                                "text": "Die Armeeführung verlangte die Beschaffung eines modernen Raketenabwehrsystems."
                            },
                            {
                                "example_id": "f358d3dd-4014-4135-8522-bcff91a5d356",
                                "sense_id": "29bdbba5-5803-3cfe-82ed-2ce2320c7271",
                                "text": "„Japans Militärexperten stellen das bestehende Raketenabwehrsystem infrage und denken über die Möglichkeit von Gegenschlägen nach.“"
                            },
                            {
                                "example_id": "ecd76ccb-a393-4ec6-a059-12fe9a84596a",
                                "sense_id": "29bdbba5-5803-3cfe-82ed-2ce2320c7271",
                                "text": "„Ankara hat sich das Ziel gesetzt, bis 2025 mit zugekaufter Technologie ein eigenes Raketenabwehrsystem zu entwickeln.“"
                            }
