                            {
                                "example_id": "940689bb-0f6e-45e7-8c29-2fe9a5163ecf",
                                "sense_id": "54d57984-4cb9-3072-8e86-2d8ae0fde87f",
                                "text": "Eens per jaar kregen we een aanvulling op de encyclopedie om die compleet te houden."
                            },
                            {
                                "example_id": "55122b1e-23e2-49d6-aa37-9a019d8302bc",
                                "sense_id": "54d57984-4cb9-3072-8e86-2d8ae0fde87f",
                                "text": "Met drie flessen aanmaakvloeistof, een paar doosjes lucifers, een puzzelboekje en een pond schepsnoep als aanvulling op hun bepakking waren ze voldoende uitgerust om zich geruime tijd af te kunnen zonderen in het kerspel Rute."
                            }
                        ]
                    },
                    {
                        "sense_id": "113f4efe-3213-3d56-b3cf-c78b96ecd6e1",
                        "entry_id": "b7d93d2c-5886-3806-b7df-c6b6feb94d1f",
                        "glosses": [
                            "het bijgevoegde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86d32919-8012-494f-b148-ac5be9223cb9",
                                "sense_id": "113f4efe-3213-3d56-b3cf-c78b96ecd6e1",
                                "text": "Het gastcollege was een waarde volle aanvulling op het lesprogramma."
                            },
                            {
                                "example_id": "e57c6fe3-d280-4f4e-aa58-fddf20c761fa",
                                "sense_id": "113f4efe-3213-3d56-b3cf-c78b96ecd6e1",
                                "text": "Zorgen voor toegangsbewijzen was nu een nieuwe aanvulling van zijn taak geworden."
                            }
                        ]
                    }
