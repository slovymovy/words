                                        "sense_id": "193b78fd-e894-3e8e-b1a5-193511acb89d",
                                        "entry_id": "4626e2dc-66a5-3b9e-82dd-0cce71da4f97",
                                        "glosses": [
                                            "organisches Molekül mit mindestens einer Carboxygruppe und Aminogruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a6800e2-66d5-41e3-8309-6d43096c2c14",
                                                "sense_id": "193b78fd-e894-3e8e-b1a5-193511acb89d",
                                                "text": "Es gibt essentielle, semiessentielle und nicht-essentielle Aminosäuren."
                                            },
                                            {
                                                "example_id": "8e310048-9081-49e4-8e8f-a9a2b30c3da4",
                                                "sense_id": "193b78fd-e894-3e8e-b1a5-193511acb89d",
                                                "text": "Bisher sind 22 proteinogene Aminosäuren bekannt, das Spektrum der Klasse der Aminosäuren geht aber weit über diese hinaus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19a6748e-c65f-4113-a174-9e7e3699ff90",
                        "source_entry_id": "0971e501-4c33-3ed0-a029-e3e3d20a8c56",
