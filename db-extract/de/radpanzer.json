                        "glosses": [
                            "leichter Panzer, mit gummibereiften Rädern statt Ketten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "764a0d0b-899f-4ca7-8c88-66b87fe17470",
                                "sense_id": "a6091a54-62c7-3114-865f-893c93b7e6cb",
                                "text": "Radpanzer verfügen meist nur über eine schwache Panzerung."
                            },
                            {
                                "example_id": "647d237e-1f1a-4497-9a98-da7826ce379f",
                                "sense_id": "a6091a54-62c7-3114-865f-893c93b7e6cb",
                                "text": "„Der rund zwölf Tonnen schwere Radpanzer lag quer vor der Einfahrt in den Tunnel Kreuzenstein.“"
                            },
                            {
                                "example_id": "dbf2c0d6-6def-45b3-9243-315b875c5397",
                                "sense_id": "a6091a54-62c7-3114-865f-893c93b7e6cb",
                                "text": "„Dutzende Radpanzer vom Typ Stryker rollten durch die Städte Turi und Parnu und machten Halt auf Marktplätzen.“"
                            }
                        ],
