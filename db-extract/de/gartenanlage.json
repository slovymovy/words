                ],
                "senses": [
                    {
                        "sense_id": "af239da6-5677-3699-af19-847d53b23c66",
                        "entry_id": "fd276bb9-ed0d-30a1-a04d-6e5f9f6c511f",
                        "glosses": [
                            "Grünfläche, die gärtnerisch gestaltet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "615bf40e-1a60-4cd6-8e54-02273392144f",
                                "sense_id": "af239da6-5677-3699-af19-847d53b23c66",
                                "text": "„Im Süden und Südwesten schließt sich eine weitläufige Gartenanlage im französischen und englischen Stil an.“"
                            },
                            {
                                "example_id": "f405b23f-59c8-4942-b98b-01210a415d00",
                                "sense_id": "af239da6-5677-3699-af19-847d53b23c66",
                                "text": "„Das Turmhaus, aus rotem Sandstein erbaut, mit der wunderschönen Gartenanlage zählt zu den schönsten spätmittelalterlichen Bauwerken in Schottland.“"
                            },
                            {
                                "example_id": "85cff186-69ea-451c-8a31-a6097e791f30",
                                "sense_id": "af239da6-5677-3699-af19-847d53b23c66",
                                "text": "„Und abermals wurde ab 1715 Josef Effner die bauliche Leitung und Dominique Girard die Gestaltung der Gartenanlage übergeben.“"
                            },
                            {
                                "example_id": "b886a4fc-f338-4ae6-b7d8-478d750cba00",
                                "sense_id": "af239da6-5677-3699-af19-847d53b23c66",
                                "text": "„Und unter solchem Selbstgespräche trat er noch einmal ans offene Fenster und sah über die zunächst gelegene kleine Gartenanlage fort in das Flachland hinaus, an dessen äußerstem Rande die Türme von Quedlinburg aufragten.“"
                            },
                            {
                                "example_id": "ea89be10-85d1-4b4f-b2c9-0371649fa4fc",
                                "sense_id": "af239da6-5677-3699-af19-847d53b23c66",
                                "text": "„Er überquerte den breiten Boulevard und ging durch die Gartenanlagen zum Hotel Splendide.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
