                                "target_senses": [
                                    {
                                        "sense_id": "9fcdb03d-27d8-3101-bb1e-641cfdb24176",
                                        "entry_id": "049e2527-6f2d-3127-ae7a-c97f0c318c2f",
                                        "glosses": [
                                            "Qui porte un seul nom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "860bee96-8f68-4c96-ab4a-b1aa3eb652e7",
                                                "sense_id": "9fcdb03d-27d8-3101-bb1e-641cfdb24176",
                                                "text": "Comment donc est-il possible d’obtenir que chaque espèce végétale soit mononyme, sinon en fait, du moins en droit ?"
                                            }
                                        ]
                                    }
