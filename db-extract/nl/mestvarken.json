                        "examples": [
                            {
                                "example_id": "8162b5ce-6418-4e9c-86d7-94cc804c2c77",
                                "sense_id": "f1befe04-0d72-3586-8484-494c77282cc2",
                                "text": "Minister Veerman (Landbouw) heeft de Tweede Kamer beloofd niet meer te zullen spreken van mestvarkens en mestkippen, maar de dieren in het vervolg aan te duiden als vleesvarkens en vleeskippen."
                            },
                            {
                                "example_id": "f0aea7e3-d80e-45a6-9b10-60c3fb63a466",
                                "sense_id": "f1befe04-0d72-3586-8484-494c77282cc2",
                                "text": "Op 3 juni startte de tweede inschrijfperiode. De dossiers van 2001 die niet meer konden behandeld of uitbetaald worden, kwamen het eerst in aanmerking. Zij vertegenwoordigen een budget van circa 10 miljoen euro. Per zeug is er een vergoeding van 389,7 euro voorzien, per mestvarken 117,5 euro."
                            }
