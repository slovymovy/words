        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "51598839-2cf2-3a9e-b7db-8a32e5a64441",
                    "sense_definition": "A person from the country of Mexico or of Mexican descent.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_mexico_country",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>Mexicans</w> celebrate Independence Day in September.",
