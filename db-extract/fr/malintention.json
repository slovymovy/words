                        "glosses": [
                            "Mauvaise intention ; intention d'une personne malintentionnée."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a3370e0d-7576-4f93-9dd3-f035180ade1f",
                                "sense_id": "b05d50d1-a08c-33ec-b672-f6b2973f48cd",
                                "text": "Il a aussi été question de Drieu la Rochelle. Je ne sais plus très exactement en quels termes, en tout cas moqueurs, avec malintentions."
                            },
                            {
                                "example_id": "8ea3ee77-59ad-433a-ae4c-061b5d7b1fa8",
                                "sense_id": "b05d50d1-a08c-33ec-b672-f6b2973f48cd",
                                "text": "Mon fils l'a pris en malintention à cause de sa bêtise et de sa gourmandise."
                            },
                            {
                                "example_id": "d2bcef48-b03d-4f9c-9639-88eff254c72c",
                                "sense_id": "b05d50d1-a08c-33ec-b672-f6b2973f48cd",
                                "text": "Or, La liberté, qui ne saurait être soupçonnée de malintention à l'égard de l'ex-commandant de place de Paris, écrit ceci : […]."
                            },
                            {
                                "example_id": "a901724f-96b7-43f8-b23d-265b806b2457",
                                "sense_id": "b05d50d1-a08c-33ec-b672-f6b2973f48cd",
                                "text": "Père, dit-il d'une voix ferme, il n'y a pas de malintention dans ce que vous avez sous les yeux."
                            }
                        ]
                    }
