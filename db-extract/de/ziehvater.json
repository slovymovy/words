                    },
                    {
                        "translation_id": "9310fe88-40d3-4713-8bbc-ae821d467ed8",
                        "source_entry_id": "c9aef758-70db-3e8b-9436-77f0c58c5225",
                        "source_sense_id": "baae8768-9349-3f08-ac06-b10a96e11639",
                        "source_sense_description": "Mentor, unterstützender Begleiter",
                        "target_lang_word": "mentor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mentor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c28a9890-5611-34df-a1b2-28969a2c5b61",
                                        "entry_id": "7407f606-6b8f-3293-a894-a6ddc71620f1",
                                        "glosses": [
                                            "A wise and trusted counselor or teacher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05f6a2c9-8f61-450e-a1da-45f5747c13c0",
                                                "sense_id": "c28a9890-5611-34df-a1b2-28969a2c5b61",
                                                "text": "Many mentors claim that they would work with the vocationers for free because of the sense of satisfaction the interaction provides."
                                            },
                                            {
                                                "example_id": "d3825793-5c55-4f9a-b8b5-427d2d84ca4a",
                                                "sense_id": "c28a9890-5611-34df-a1b2-28969a2c5b61",
                                                "text": "I thought he was supposed to be my mentor. But, in actuality, what did I know about the often beguiling world of adults?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mentor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dff8143-6bbf-342b-9fee-f306af98e61a",
                                        "entry_id": "69a8f1b5-aaae-319d-aeec-212ae3a4b70d",
                                        "glosses": [
                                            "To act as someone's mentor."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f644dff9-f5c7-4dce-9910-e1f18c05b7c3",
                                                "sense_id": "6dff8143-6bbf-342b-9fee-f306af98e61a",
                                                "text": "After him came several deshi, or followers he had mentored."
                                            },
                                            {
                                                "example_id": "2784b34a-907e-41fb-aee2-b465fb850ec9",
                                                "sense_id": "6dff8143-6bbf-342b-9fee-f306af98e61a",
                                                "text": "I want to get people motivated about mentoring students, to help them get excited about staying in school, finding their passion, and starting a career."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3008564e-3a4d-4f0d-ba8f-f7fa9060215a",
                        "source_entry_id": "c9aef758-70db-3e8b-9436-77f0c58c5225",
                        "source_sense_id": "baae8768-9349-3f08-ac06-b10a96e11639",
                        "source_sense_description": "Mentor, unterstützender Begleiter",
                        "target_lang_word": "mentor",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mentor",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e344761e-35d1-37e1-ba9f-b176076630ba",
                                        "entry_id": "03abeaf0-f075-317a-bdf8-b2dbfecab12b",
                                        "glosses": [
                                            "Celui qui sert de guide ou de conseiller à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa245c52-fca2-4570-82e8-66e5a4d2e8d8",
                                                "sense_id": "e344761e-35d1-37e1-ba9f-b176076630ba",
                                                "text": "Certainement, Jeanne, sous l’aile d’un tel mentor, ne sera plus en butte aux séductions des jeunes gens de votre village."
                                            },
                                            {
                                                "example_id": "d4769902-8ec5-4835-87be-b30dfaaedf43",
                                                "sense_id": "e344761e-35d1-37e1-ba9f-b176076630ba",
                                                "text": "Élève de mathématiques spéciales, il devenait ainsi, aux heures d’études, le mentor de ses camarades de classe. On lui obéissait sans effort ; son caractère simple et sérieux, le sentiment qu’il avait de la dignité individuelle lui rendaient facile l’autorité."
                                            },
                                            {
                                                "example_id": "e9f2bc45-3291-4346-a280-7f7678ec42d0",
                                                "sense_id": "e344761e-35d1-37e1-ba9f-b176076630ba",
                                                "text": "Ce soir-là, Joseph ne dîna pas, et, dès huit heures et demie, sonnait à la porte du professeur de mathématiques qui lui servait de mentor."
                                            },
                                            {
                                                "example_id": "f64d3d2d-b3c8-4a0b-a51d-915058d5bcbb",
                                                "sense_id": "e344761e-35d1-37e1-ba9f-b176076630ba",
                                                "text": "Le rêve de Bouteflika n’a jamais été d’être Boumedienne, son mentor des années 1970. Non, sa fascination va vers Hassan II."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97c8d00f-b516-3d8d-98f3-05a5fd7910f4",
                                        "entry_id": "03abeaf0-f075-317a-bdf8-b2dbfecab12b",
                                        "glosses": [
                                            "Cadre chargé d’améliorer les compétences et la réussite professionnelle d’un individu ou d’une équipe."
                                        ],
                                        "tags": [
                                            "Économie",
                                            "Gestion d’entreprise"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c572e18-6eb7-3a02-9a74-26a93aba3cb9",
                                        "entry_id": "03abeaf0-f075-317a-bdf8-b2dbfecab12b",
                                        "glosses": [
                                            "Personne chargée de conseiller sur le plan artistique et commercial un artiste ou un groupe pour lui permettre d’atteindre une plus grande notoriété."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
