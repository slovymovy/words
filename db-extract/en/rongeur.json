                "translations": [
                    {
                        "translation_id": "88d9cabb-3677-448f-9d11-0ee24e29d63a",
                        "source_entry_id": "60d0d17d-2ec8-3f7b-a8c6-641fdcf63a47",
                        "source_sense_id": "31db8185-aa85-3ac1-b1da-a0381a285ab6",
