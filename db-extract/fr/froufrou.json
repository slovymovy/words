                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3af2985-6d28-31e3-8e1a-9aa781e86e08",
                        "entry_id": "30e680c9-28de-3027-9bf4-f3ea2eedeeb0",
                        "glosses": [
                            "Bruit léger produit par le frôlement ou le froissement de quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2dc1880-bde3-4ab1-aebe-75d8c6afba9b",
                                "sense_id": "e3af2985-6d28-31e3-8e1a-9aa781e86e08",
                                "text": "Elle volta dans un froufrou de jupe, se dirigea vers un petit meuble à destination mal définie, ouvrit un tiroir, farfouilla dedans et en tira une photo format carte-postale qu’elle me tendit."
                            },
                            {
                                "example_id": "017f61cd-b5d0-44b9-b384-181b2d48f962",
                                "sense_id": "e3af2985-6d28-31e3-8e1a-9aa781e86e08",
                                "text": "Les feuilles de platane qui s’engouffrèrent sur ses pas toupinèrent sur le carrelage avec des froufrous moribonds."
                            },
                            {
                                "example_id": "f1a7bc9c-8d91-4288-bbeb-ca56b48dd749",
                                "sense_id": "e3af2985-6d28-31e3-8e1a-9aa781e86e08",
                                "text": "Il se regardait dans la glace, par-dessus une vieille pendule-Empire, en se passant lui-même en revue, quand le froufrou de la robe de soie lui annonça la baronne. Et il se remit aussitôt en position."
                            },
                            {
                                "example_id": "1ba9bd21-f663-4d3a-8ec2-1e07d1347743",
                                "sense_id": "e3af2985-6d28-31e3-8e1a-9aa781e86e08",
                                "text": "Les robes de soie faisaient froufrou à travers les chaises…"
                            },
                            {
                                "example_id": "654247d3-097c-4c35-ba33-3a3404bc5939",
                                "sense_id": "e3af2985-6d28-31e3-8e1a-9aa781e86e08",
                                "text": "Une caille surprise se levait du creux d’un sillon et partait dans un froufrou d’ailes."
                            }
                        ]
                    },
                    {
                        "sense_id": "801cf9d6-2ade-36da-9964-eb36651c35d2",
                        "entry_id": "30e680c9-28de-3027-9bf4-f3ea2eedeeb0",
                        "glosses": [
                            "Ornement de tissu d’un vêtement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3786291e-6652-4890-b8aa-c178f38143e7",
                                "sense_id": "801cf9d6-2ade-36da-9964-eb36651c35d2",
                                "text": "La demeur’ que je préfère,\nC'est votre robe à froufrous,\nTout le restant m'indiffère,\nJ'ai rendez-vous avec vous !"
                            },
                            {
                                "example_id": "5e26da1e-ff90-4d07-80d6-a005d6099836",
                                "sense_id": "801cf9d6-2ade-36da-9964-eb36651c35d2",
                                "text": "Les froufrous d’une robe."
                            },
                            {
                                "example_id": "305e4382-500e-4958-9157-a230c686c2fe",
                                "sense_id": "801cf9d6-2ade-36da-9964-eb36651c35d2",
                                "text": "Si quelque chaland surgissait ! La parfumeuse, la notairesse, les demoiselles du lycée ! Si, comme il arrivait trop rarement, un homme venait lui demander, pour faire un cadeau une paire de bas, une culotte à froufrous !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "952e6c09-8812-4233-b485-c2429d7db9eb",
                        "source_entry_id": "30e680c9-28de-3027-9bf4-f3ea2eedeeb0",
                        "source_sense_id": "e3af2985-6d28-31e3-8e1a-9aa781e86e08",
                        "source_sense_description": "Léger bruit produit par le frôlement ou le froissement de quelque chose",
                        "target_lang_word": "rustle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rustle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f65910b-92f2-3c4e-9d27-2da44a013505",
                                        "entry_id": "1be8a3ea-6018-3138-a654-6c581f929481",
                                        "glosses": [
                                            "A soft crackling sound similar to the movement of dry leaves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4af3ee78-5880-4a76-a3d1-e7b51f4ef070",
                                                "sense_id": "2f65910b-92f2-3c4e-9d27-2da44a013505",
                                                "text": "He heard the silken rustle of a dressing-gown being drawn on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eeeac5c-9345-320e-9f70-819a801bb7bb",
                                        "entry_id": "1be8a3ea-6018-3138-a654-6c581f929481",
                                        "glosses": [
                                            "A movement producing such a sound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rustle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3aff0598-2450-3b38-8563-fd6fb5f7f225",
                                        "entry_id": "0a3ab49d-07b0-3bd2-9dd7-21500fbd7038",
                                        "glosses": [
                                            "To move (something) with a soft crackling sound."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd03a0fb-4128-4447-8a6f-9488e2ff46f5",
                                                "sense_id": "3aff0598-2450-3b38-8563-fd6fb5f7f225",
                                                "text": "The next day at three o'clock we were again at the door, and the footmen as before; we heard the silk dress rustle, and the lady came down the steps and in an imperious voice, she said, \"York, you must put those horses' heads higher, they are not fit to be seen.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3d5be6e-daf2-3f3f-978e-215ab7d7a817",
                                        "entry_id": "0a3ab49d-07b0-3bd2-9dd7-21500fbd7038",
                                        "glosses": [
                                            "To make or obtain in a lively, energetic way."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "982d36d9-73ef-4d3e-9abb-6dd2ce90d938",
                                                "sense_id": "c3d5be6e-daf2-3f3f-978e-215ab7d7a817",
                                                "text": "When at last the lumber was piled again in its rightful place, and the boxes of food had been returned to the shelter from which they had been stolen, the two friends rustled a meal, and then set off on horseback […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eb0de50-dfb9-3308-9d43-ff3a9af9c952",
                                        "entry_id": "0a3ab49d-07b0-3bd2-9dd7-21500fbd7038",
                                        "glosses": [
                                            "To steal (cattle or other livestock)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1f708b5-adb3-46ff-9549-60a88124138c",
                        "source_entry_id": "30e680c9-28de-3027-9bf4-f3ea2eedeeb0",
                        "source_sense_id": "e3af2985-6d28-31e3-8e1a-9aa781e86e08",
                        "source_sense_description": "Léger bruit produit par le frôlement ou le froissement de quelque chose",
                        "target_lang_word": "φρουφρού",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "40ce0e65-dfc3-43e8-91e5-71be1dd15950",
                        "source_entry_id": "30e680c9-28de-3027-9bf4-f3ea2eedeeb0",
                        "source_sense_id": "801cf9d6-2ade-36da-9964-eb36651c35d2",
                        "source_sense_description": "Ornement de tissu d’un vêtement féminin",
                        "target_lang_word": "frill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4432d3f-9420-3128-90f0-642614e4e745",
                                        "entry_id": "392ab3a2-466f-3e80-9484-e237c94c6747",
                                        "glosses": [
                                            "A strip of pleated fabric or paper used as decoration or trim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "287474ef-1150-484f-8635-092d49237f50",
                                                "sense_id": "e4432d3f-9420-3128-90f0-642614e4e745",
                                                "text": "1777, Samuel Jackson Pratt (as Courtney Melmoth), Liberal Opinions, upon Animals, Man, and Providence, London: G. Robinson and J. Bew, Volume 5, Chapter 114, p. 163,\n[…] one of her husband Jeffery’s shirts (with frills to the bosom) […]"
                                            },
                                            {
                                                "example_id": "0f26bad8-832a-41ea-b897-d24964c0f5b1",
                                                "sense_id": "e4432d3f-9420-3128-90f0-642614e4e745",
                                                "text": "His face had fallen in, and was unshorn; his frill and neckcloth hung limp under his bagging waistcoat."
                                            },
                                            {
                                                "example_id": "f0230d41-5e1b-4b01-b6ba-08c9e5bbfe8b",
                                                "sense_id": "e4432d3f-9420-3128-90f0-642614e4e745",
                                                "text": "Mind you, clothes were clothes in those days. […] Frills, ruffles, flounces, lace, complicated seams and gores: not only did they sweep the ground and have to be held up in one hand elegantly as you walked along, but they had little capes or coats or feather boas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a37a7a84-7920-313e-9c11-f003a656039d",
                                        "entry_id": "392ab3a2-466f-3e80-9484-e237c94c6747",
                                        "glosses": [
                                            "A substance or material on the edge of something, resembling such a strip of fabric."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a10d5e8e-b1c9-45e2-8345-2404221d130b",
                                                "sense_id": "a37a7a84-7920-313e-9c11-f003a656039d",
                                                "text": "[T]he bright frills of the winter fungi on the blotched trunks of the trees;"
                                            },
                                            {
                                                "example_id": "9712842b-33e6-48ea-a79f-e0c4e99c218a",
                                                "sense_id": "a37a7a84-7920-313e-9c11-f003a656039d",
                                                "text": "‘Isn’t it a shame!’ Mrs Ayres said softly, now and then pausing to brush aside a frill of snow and examine the plant beneath […]"
                                            },
                                            {
                                                "example_id": "233f29f0-e496-48ac-a44b-52d12dddd284",
                                                "sense_id": "a37a7a84-7920-313e-9c11-f003a656039d",
                                                "text": "Nothing moved in sky, land, or sea, except a frill of milkwhite foam along the nearer angles of the shore, shreds of which licked the contiguous stones like tongues."
                                            },
                                            {
                                                "example_id": "58ffa91b-cfe8-4962-9d13-b867a7e95a1f",
                                                "sense_id": "a37a7a84-7920-313e-9c11-f003a656039d",
                                                "text": "She had noticed yesterday that a few tiny corkscrew tendrils had come right through some cracks in the scullery ceiling and all the windows of the lean-to had a thick frill of ruffled green."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d57e385-a316-3a14-9965-e91e4c3c87e1",
                                        "entry_id": "392ab3a2-466f-3e80-9484-e237c94c6747",
                                        "glosses": [
                                            "A wrinkled edge to a film."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9db135a9-2679-3c9b-9f07-20509eef0fb1",
                                        "entry_id": "392ab3a2-466f-3e80-9484-e237c94c6747",
                                        "glosses": [
                                            "Something extraneous or not essential; something purely for show or effect; a luxury."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ff1b837-d302-4a52-aad1-f120f123e372",
                                                "sense_id": "9db135a9-2679-3c9b-9f07-20509eef0fb1",
                                                "text": "My name is Sammy Carleton. Not ‘Mr.’ Carleton, but just plain Sammy. I’m a regular no-nonsense man with no fancy frills about me. I want you to call me Sammy."
                                            },
                                            {
                                                "example_id": "b30fb3be-f97b-42d2-8afe-1841050e2866",
                                                "sense_id": "9db135a9-2679-3c9b-9f07-20509eef0fb1",
                                                "text": "Every possible economy was carefully investigated and unnecessary expense, however small, eliminated. The company had no money to spare on \"frills.\""
                                            },
                                            {
                                                "example_id": "48e43c28-6d8e-4b45-b27b-16cdde41bcdb",
                                                "sense_id": "9db135a9-2679-3c9b-9f07-20509eef0fb1",
                                                "text": "Falling in love, I said. Falling into it, we all did then, one way or another. How could he have made such light of it? Sneered even. As if it was trivial for us, a frill, a whim."
                                            },
                                            {
                                                "example_id": "4a854f2e-2a4d-4b2d-9873-8c75bc430a40",
                                                "sense_id": "9db135a9-2679-3c9b-9f07-20509eef0fb1",
                                                "text": "Torontonians clutter their brick and stone houses with too much trim, or with window trim and shutters—and they also carve their shutters with hearts or maple leaves—but the snow conceals these frills;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94f24855-6cf9-36ea-94b4-0a88c5791bf7",
                                        "entry_id": "392ab3a2-466f-3e80-9484-e237c94c6747",
                                        "glosses": [
                                            "The relatively extensive margin seen on the back of the heads of reptiles, with either a bony support or a cartilaginous one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8f15c4d-d070-426d-ba80-c1be7a306bf9",
                                                "sense_id": "94f24855-6cf9-36ea-94b4-0a88c5791bf7",
                                                "text": "A large admiral lizard leapt up on a rail, stood on hind legs with fore legs raised like hands and watched for a moment […], then loped down the cess-path with arms swinging and iridescent frill flying out like a cape […]"
                                            },
                                            {
                                                "example_id": "95739ad2-8fd6-4d79-a575-d2e2c2fbf422",
                                                "sense_id": "94f24855-6cf9-36ea-94b4-0a88c5791bf7",
                                                "text": "She reminded Bojan of a desert lizard throwing up its frill to frighten predators."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb605095-6f5b-36d4-bd53-9a7ffaba44f0",
                                        "entry_id": "392ab3a2-466f-3e80-9484-e237c94c6747",
                                        "glosses": [
                                            "Synonym of armilla."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "frill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8788ec99-901c-3b9d-84b2-234a8838bc82",
                                        "entry_id": "64b8e785-1a39-30b5-8db9-1f4d4f9e62ad",
                                        "glosses": [
                                            "To make into a frill."
                                        ],
