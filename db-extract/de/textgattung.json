                "senses": [
                    {
                        "sense_id": "f7900154-18fe-3ff6-be37-e22b3daab71c",
                        "entry_id": "0efd8a52-cc65-3d73-8347-8e3b64fcdf6d",
                        "glosses": [
                            "Klasse von Texten literarischer oder sonstiger Art"
                        ],
                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "50743b48-1db8-40da-aa3b-52cc3e7e1a08",
                                "sense_id": "f7900154-18fe-3ff6-be37-e22b3daab71c",
                                "text": "Wenigstens drei Textgattungen werden unterschieden: Drama, Lyrik und Epik."
                            },
                            {
                                "example_id": "32c67050-8b3a-4afb-ab8f-e2c6100fe709",
                                "sense_id": "f7900154-18fe-3ff6-be37-e22b3daab71c",
                                "text": "Der Begriff Textgattung wird aber z.T. auch auf die einzelnen literarischen Kategorien wie Ode angewendet, aber auch auf nichtliterarische Textklassen."
                            },
                            {
                                "example_id": "acd03328-f5fd-4ce5-9efc-8a0fd359c7a4",
                                "sense_id": "f7900154-18fe-3ff6-be37-e22b3daab71c",
                                "text": "„Von der Ideenentwicklung bis zur Realisierung eines Auftrages muss der Texter stets bestens organisiert, versiert in den unterschiedlichen Textgattungen und flexibel die Wünsche des Auftraggebers als Teamplayer meistern.“"
                            },
                            {
                                "example_id": "097f611e-0ad9-40b6-98a7-830db556de28",
                                "sense_id": "f7900154-18fe-3ff6-be37-e22b3daab71c",
                                "text": "„Bei bestimmten Textgattungen bildeten sich in dieser Hinsicht zum Teil feste Schreibkonventionen heraus."
                            },
                            {
                                "example_id": "0a20b4dc-0726-48a0-a95f-2aff1caf10ce",
                                "sense_id": "f7900154-18fe-3ff6-be37-e22b3daab71c",
                                "text": "„Betrachtet man andere Textgattungen wie Romane oder Sach- und Fachtexte, verändert sich die Rangfolge und es erscheinen neue Wörter in der Liste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
