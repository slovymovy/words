                    {
                        "sense_id": "eed57dd1-06c8-3be9-873a-35a5c03f481f",
                        "entry_id": "35172133-439b-3c0d-bf0a-273f56de0b0d",
                        "glosses": [
                            "Réduction des dépenses nécessitée par telle ou telle cause."
