                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le magistrat <w>attrait</w> le suspect devant le tribunal pour répondre de ses infractions."
                        },
                        {
