                    },
                    {
                        "translation_id": "89260ff2-16ca-4e1d-9c19-ecf3ed9bc6e2",
                        "source_entry_id": "c9f53a9f-2e32-3d87-bbcf-ed5f314b2989",
                        "source_sense_id": "6ff80b47-72af-38b7-a2f9-26e15c637ccc",
                        "target_lang_word": "homme de Néandertal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homme de Néandertal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86fc8488-57f3-3bd7-93a6-9a77947e3085",
                                        "entry_id": "4e7cc625-4b87-30dc-849c-b24fef235579",
                                        "glosses": [
                                            "Espèce humaine, de nom scientifique Homo neanderthalensis, cousine des humains contemporains (Homo sapiens) et disparue de la surface de la terre il y a apparemment 30,000 ans environ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34fb9525-68c0-4cd1-bbb3-44f9e175d3a4",
                                                "sense_id": "86fc8488-57f3-3bd7-93a6-9a77947e3085",
                                                "text": "La disparition de l’homme de Néandertal demeure encore inexpliquée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aa596c7-b03a-3af2-9a6c-af6da893d5b5",
                                        "entry_id": "4e7cc625-4b87-30dc-849c-b24fef235579",
                                        "glosses": [
                                            "Personnage primitif, rustre."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70193f18-059f-450c-9a35-7b705a56b5a5",
                                                "sense_id": "5aa596c7-b03a-3af2-9a6c-af6da893d5b5",
                                                "text": "Je crois, docteur, que l’homme de Néandertal est en train de nous le mettre dans l’os. Deux intellectuels assis vont moins loin qu’une brute qui marche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
