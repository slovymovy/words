                    },
                    {
                        "sense_id": "fabda828-b990-38e9-b7c7-6583898e3c2b",
                        "entry_id": "666d4bd8-b8a1-3073-80c9-1dc95fb0b729",
                        "glosses": [
                            "środek zawierający składniki odżywcze mający stanowić uzupełnienie diety, zob. suplement diety"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bb42dba-6e8b-46fd-a5e8-aca75c3cb878",
                                "sense_id": "fabda828-b990-38e9-b7c7-6583898e3c2b",
                                "text": "(…) mówiąc o superżywności, nie chodzi nam o suplementy wielowitaminowe czy wyciągi z egzotycznych roślin. Te nadzwyczajne produkty to warzywa i owoce oraz kilka innych popularnych składników diety."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3823546-3997-4127-8b36-2ac00e3b4586",
                        "source_entry_id": "666d4bd8-b8a1-3073-80c9-1dc95fb0b729",
                        "source_sense_id": "25aa25a5-aa27-3509-97fa-baada65959c6",
                        "target_lang_word": "supplement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supplement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a6db4c6-5ac8-3398-87b5-8a7576ef17b5",
                                        "entry_id": "9611b9c8-ea05-315b-bbcd-cddfae69756b",
                                        "glosses": [
                                            "Something added; especially, such an addition added to make up for a deficiency."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fe961f1-a82e-4871-9fc6-2edf09104616",
                                                "sense_id": "2a6db4c6-5ac8-3398-87b5-8a7576ef17b5",
                                                "text": "Near-synonyms: see Thesaurus:adjunct"
                                            },
                                            {
                                                "example_id": "9cd2676d-6e15-4f1d-8e5e-30dab34787c5",
                                                "sense_id": "2a6db4c6-5ac8-3398-87b5-8a7576ef17b5",
                                                "text": "Athletes' use of herbal supplements has skyrocketed in the past two decades. At the top of the list of popular herbs are echinacea and ginseng, whereas garlic, St. John's wort, soybean, ephedra and others are also surging in popularity or have been historically prevalent."
                                            },
                                            {
                                                "example_id": "48ccd9f1-7cf3-431d-9d73-bf4d1363f5a8",
                                                "sense_id": "2a6db4c6-5ac8-3398-87b5-8a7576ef17b5",
                                                "text": "AI models will not completely replace the humans, she said, but will serve as a “supplement” intended to aid in the brand’s representation of various sizes, skin tones and ages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60daae5b-6ca5-31e2-832c-5f0b63836bf3",
                                        "entry_id": "9611b9c8-ea05-315b-bbcd-cddfae69756b",
                                        "glosses": [
                                            "An extension to a document or publication that adds information, corrects errors, or brings up to date."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e031790-2b87-3133-8572-4dfa0844d196",
                                        "entry_id": "9611b9c8-ea05-315b-bbcd-cddfae69756b",
                                        "glosses": [
                                            "An additional section of a newspaper devoted to a specific subject; an additional section of a journal issue, or an additional issue, for a similar purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "197e5b0c-526a-4121-8937-22b6c4268e2b",
                                                "sense_id": "7e031790-2b87-3133-8572-4dfa0844d196",
                                                "text": "the literary supplement"
                                            },
                                            {
                                                "example_id": "75b96754-2bb7-41a1-b645-b4446a47b1f6",
                                                "sense_id": "7e031790-2b87-3133-8572-4dfa0844d196",
                                                "text": "\"Mid-Lent, and the Enemy grins,\" remarked Selwyn as he started for church with Nina and the children. Austin, knee-deep in a dozen Sunday supplements, refused to stir; poor little Eileen was now convalescent from grippe, but still unsteady on her legs; her maid had taken the grippe, and now moaned all day: \"Mon dieu! Mon dieu! Che fais mourir!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6576990c-aaa0-36fb-ad40-53498025410f",
                                        "entry_id": "9611b9c8-ea05-315b-bbcd-cddfae69756b",
                                        "glosses": [
                                            "An angle that, when added to a given angle, makes 180°; a supplementary angle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a33f81d-2947-36ae-8776-1f936a38dfa2",
                                        "entry_id": "9611b9c8-ea05-315b-bbcd-cddfae69756b",
                                        "glosses": [
                                            "A vitamin, herbal extract, or chemical compound ingested to meet dietary deficiencies or enhance muscular development; the dosage form that conveys or embodies it (e.g., tablet, capsule, pill, powder, beverage)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "815d6735-84d8-4b92-ad72-646bfe8beaf6",
                                                "sense_id": "9a33f81d-2947-36ae-8776-1f936a38dfa2",
                                                "text": "Vitamins, minerals, and essential fatty acids must come from either the diet or supplements."
                                            },
                                            {
                                                "example_id": "75da0ce1-24c8-403d-8dff-f1c629f2e99b",
                                                "sense_id": "9a33f81d-2947-36ae-8776-1f936a38dfa2",
                                                "text": "Menstruators are likelier to need an iron supplement than non-menstruators, whose diet alone is usually sufficient."
                                            },
                                            {
                                                "example_id": "c1e2b8e0-b6ce-4f11-966b-97b1d51650a5",
                                                "sense_id": "9a33f81d-2947-36ae-8776-1f936a38dfa2",
                                                "text": "She wasn't getting enough iron, so they prescribed a supplement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f3e3233-a0ad-374f-a141-c10638c4b941",
                                        "entry_id": "9611b9c8-ea05-315b-bbcd-cddfae69756b",
                                        "glosses": [
                                            "A surcharge, additional cost, especially for food in a restaurant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ea20d37-58e4-4913-b3cf-0e464a4322bb",
                                                "sense_id": "5f3e3233-a0ad-374f-a141-c10638c4b941",
                                                "text": "There is a £2 supplement if you choose the steak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d266ba6-bf65-3797-ae58-1782927647ac",
                                        "entry_id": "9611b9c8-ea05-315b-bbcd-cddfae69756b",
                                        "glosses": [
                                            "An adjunct that is nonessential, especially a supplementary relative clause."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "supplement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ec53792-27a4-3cb0-b541-b521c08b0ba8",
                                        "entry_id": "120ac748-8cb9-3ec9-aef0-a7c9ee0f1f4f",
                                        "glosses": [
                                            "To provide or make a supplement to something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7759f56a-eb33-4b84-8ead-acd12d251a54",
                                                "sense_id": "1ec53792-27a4-3cb0-b541-b521c08b0ba8",
                                                "text": "I supplement my income by working as a model."
                                            },
                                            {
                                                "example_id": "e063e4ef-4826-4dda-a0a1-6c631e5edf40",
                                                "sense_id": "1ec53792-27a4-3cb0-b541-b521c08b0ba8",
                                                "text": "Using the countless tons of rock from the cliff-face, supplemented by much more from inland, they threw out a huge breakwater, 2,000 ft. long and 80 ft. high, roughly at right angles to the quay, so forming an almost completely sheltered corner. Fifty years later, this massive mole is still standing up to the worst that the Irish Sea can do."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
