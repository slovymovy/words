                "senses": [
                    {
                        "sense_id": "f352aad0-cdc2-3670-a65b-f1aa97d09c34",
                        "entry_id": "7ceeca81-f9b6-3078-9338-4d45eb7420db",
                        "glosses": [
                            "Donner un caractère floral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee4f9ccd-9c71-49fc-99ed-a0eb829b3e4a",
                                "sense_id": "f352aad0-cdc2-3670-a65b-f1aa97d09c34",
                                "text": "Pour « floraliser » une glace : faites infuser 30 g de fleurs de sureau séchées dans 25 cl de crème liquide + 37,5 cl de lait chaud."
                            },
                            {
                                "example_id": "df73c112-4c56-4975-b67b-4f5370099772",
                                "sense_id": "f352aad0-cdc2-3670-a65b-f1aa97d09c34",
                                "text": "On envisage ensuite de floraliser l'école qui ne tardera plus à ressembler à un petit parc, offrant à ses locataires un cadre agréable pour les études et une source de revenu (fruits, produits du potager) non négligeable."
                            },
                            {
                                "example_id": "65115901-825a-4388-8ca5-915ca98900cb",
                                "sense_id": "f352aad0-cdc2-3670-a65b-f1aa97d09c34",
                                "text": "En raison de son odeur fraîche de muguet, il est utilisé pour « floraliser » les fragrances, les aérosols, les désinfectants et les savons."
                            }
                        ]
                    }
