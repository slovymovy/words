                    },
                    {
                        "sense_id": "30f8f9c6-3b3c-3dd9-842c-b6993589113c",
                        "entry_id": "19963ed7-60ac-3285-8080-f793438006f4",
                        "glosses": [
                            "gatunek występujący dawniej powszechnie na danym terenie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2377789-44dd-46ff-aea4-9f16f0585733",
                                "sense_id": "30f8f9c6-3b3c-3dd9-842c-b6993589113c",
                                "text": "Zając bielak jest reliktem glacjalnym w faunie Polski."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca453d7e-6523-4fd1-9f6a-00edd86a93d9",
                        "source_entry_id": "19963ed7-60ac-3285-8080-f793438006f4",
                        "source_sense_id": "1f8d0b8f-3967-3a9b-b559-1dc554e16b99",
                        "target_lang_word": "relict",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relict",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b810f308-b658-3f1a-b9ee-c6791d051277",
                                        "entry_id": "cd3ef3c2-192e-3aa7-82c3-7dbf9aedda2c",
                                        "glosses": [
                                            "Something that, or someone who, survives or remains or is left over after the loss of others; a relic.",
                                            "The surviving member of a married couple after one or the other has died; a widow or widower."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00205b96-77b5-4f26-8ddc-7842d76f4f41",
                                                "sense_id": "b810f308-b658-3f1a-b9ee-c6791d051277",
                                                "text": "But I am not the penniless nonentity I was when we first met; I can offer an honorable if not a brilliant marriage; and at the very lowest I can provide my wife – my widow, my relict – with a decent competence, an assured future."
                                            },
                                            {
                                                "example_id": "b4ab2050-3d32-4873-b122-10b6b112f2a6",
                                                "sense_id": "b810f308-b658-3f1a-b9ee-c6791d051277",
                                                "text": "Upon which the Chancellor, by way of note said, 'it is suggested, that there is a relict of the deceased, married to another man, who has joined her in a power of attorney to authorize the sale of her interest, […]'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f09c278-76f2-36cd-a77b-ac305161de7b",
                                        "entry_id": "cd3ef3c2-192e-3aa7-82c3-7dbf9aedda2c",
                                        "glosses": [
                                            "Something that, or someone who, survives or remains or is left over after the loss of others; a relic.",
                                            "A species, organism, or ecosystem that has survived from a previous age: one that was once widespread but is now found only in a few areas."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b07e441-8376-4a81-a58b-e7b6614d7199",
                                                "sense_id": "5f09c278-76f2-36cd-a77b-ac305161de7b",
                                                "text": "[…] a continental northern Alaskan element, including a series of endemic species and disjuncts that have survived the Pleistocene glaciation in northern Alaska and thus represent relicts of the much warmer Tertiary […]"
                                            },
                                            {
                                                "example_id": "81a5c48a-cd32-4c4b-bcf4-1afe0e7f91b2",
                                                "sense_id": "5f09c278-76f2-36cd-a77b-ac305161de7b",
                                                "text": "The species may be a relict of former stages of historical vegetation and landscape development resulting from past climate changes (glacial and post- glacial periods)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfa11a47-982e-3be1-af76-769e909c6378",
                                        "entry_id": "cd3ef3c2-192e-3aa7-82c3-7dbf9aedda2c",
                                        "glosses": [
                                            "Something that, or someone who, survives or remains or is left over after the loss of others; a relic.",
                                            "A structure or other feature that has survived from a previous age."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41cf78ea-ab82-4517-b030-d4e86b4fcf01",
                                                "sense_id": "cfa11a47-982e-3be1-af76-769e909c6378",
                                                "text": "Dark rims around the pillows are caused by glaucophane enrichment, possibly a relict of a primary interaction between basalt and seawater, causing Na- enrichment in the original glass crust of the pillows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01f26783-2230-31c4-be13-82bca2fc3eab",
                                        "entry_id": "cd3ef3c2-192e-3aa7-82c3-7dbf9aedda2c",
                                        "glosses": [
                                            "Something that, or someone who, survives or remains or is left over after the loss of others; a relic.",
                                            "A survival of an archaic word, language or other form."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a2a44fd-71b5-4325-b8c2-9a237fcb3cdf",
                                                "sense_id": "01f26783-2230-31c4-be13-82bca2fc3eab",
                                                "text": "A small number of linguists believe that Cimbrian is not an Austro-Bavarian dialect but a relict of Lombardic."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "relict",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76c61e30-27df-3017-be05-50e0cd485dcf",
                                        "entry_id": "bc0655ac-c820-36fb-93e8-1a0508de9a16",
                                        "glosses": [
                                            "Surviving, remaining."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f61d8a52-aefb-36c0-8df4-77838c2ea5d9",
                                        "entry_id": "bc0655ac-c820-36fb-93e8-1a0508de9a16",
                                        "glosses": [
                                            "That is a relict; pertaining to a relict."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed278562-fcd6-4248-b2e2-fbf4fd84dc59",
                                                "sense_id": "f61d8a52-aefb-36c0-8df4-77838c2ea5d9",
                                                "text": "In the lakes and in the streams were species of fish not known elsewhere on earth and birds and lizards and other forms of life as well all long relict here for the desert stretched away on every side."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03f8e366-14b6-4e1f-8809-c19875118dca",
                        "source_entry_id": "19963ed7-60ac-3285-8080-f793438006f4",
                        "source_sense_id": "1f8d0b8f-3967-3a9b-b559-1dc554e16b99",
                        "target_lang_word": "holdover",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "holdover",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "609fad9c-e22c-3145-a0db-3d643842c600",
                                        "entry_id": "b1b434d7-c2e3-3364-b707-325a61716497",
                                        "glosses": [
                                            "Something left behind, saved or remaining from an earlier time."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "684caeff-dd65-40d8-887e-6596a32ba55f",
                                                "sense_id": "609fad9c-e22c-3145-a0db-3d643842c600",
                                                "text": "That policy is a holdover from days of punch card data entry."
                                            },
                                            {
                                                "example_id": "038c1fac-f712-49a1-95ad-04c2500f6810",
                                                "sense_id": "609fad9c-e22c-3145-a0db-3d643842c600",
                                                "text": "Castle Rock Middle School was a frowning pile of red brick standing between the Post Office and the Library, a holdover from the time when the town elders didn't feel entirely comfortable with a school unless it looked like a reformatory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e8c469d-af70-3575-8378-50f0b28212ca",
                                        "entry_id": "b1b434d7-c2e3-3364-b707-325a61716497",
                                        "glosses": [
                                            "The distance (at target) by which a rifle scope is aimed higher than the intended point of impact in order to compensate for bullet drop over the distance to the target."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7879d88c-489d-4d1e-bf7b-aed82b3f863c",
                                                "sense_id": "6e8c469d-af70-3575-8378-50f0b28212ca",
                                                "text": "This rangefinder not only measures the distance to the target, but also provides a digital readout of the inches of holdover at that distance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f56172c3-3373-415d-ab69-e07873bb71bd",
                        "source_entry_id": "19963ed7-60ac-3285-8080-f793438006f4",
                        "source_sense_id": "1f8d0b8f-3967-3a9b-b559-1dc554e16b99",
                        "target_lang_word": "throwback",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "throwback",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "480fb308-d298-3ef8-9c00-113e9a940eb4",
                                        "entry_id": "e990df43-0f2c-34a9-9371-34401a73fb41",
                                        "glosses": [
                                            "A reversion to an earlier stage of development."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dffff306-c4f7-450e-8be2-77e551a541b0",
                                                "sense_id": "480fb308-d298-3ef8-9c00-113e9a940eb4",
                                                "text": "You see, the House of Representatives recently passed a military budget that is wholly inadequate, a throwback to the seventies, a budget that is a breach of faith with our Armed Forces and our allies and would send exactly the wrong signal to the Soviets and their satellites."
                                            },
                                            {
                                                "example_id": "bc125fa7-a1c7-4102-ba8d-a10681b9e73d",
                                                "sense_id": "480fb308-d298-3ef8-9c00-113e9a940eb4",
                                                "text": "The man from the future where technology makes all things possible is a throwback to our glorious industrial past, before America stagnated and stopped producing anything but rules, restrictions, limits, obstacles and Facebook."
                                            },
                                            {
                                                "example_id": "d3df132f-c71e-4bb1-a95b-fbf29e0d4e1a",
                                                "sense_id": "480fb308-d298-3ef8-9c00-113e9a940eb4",
                                                "text": "My next train is a throwback to earlier times. TfW is now the only operator of the old single-car Class 153s (apart from a handful of ScotRail bike-carrying conversions), and a pair of them have turned up to take me to Carmarthen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6edb0d7b-bc7b-3378-941e-f7c9600005ba",
                                        "entry_id": "e990df43-0f2c-34a9-9371-34401a73fb41",
                                        "glosses": [
                                            "A person considered to be primitive, uncivilized and mentally deficient."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a928ce92-77ad-371b-be82-f7374f161617",
                                        "entry_id": "e990df43-0f2c-34a9-9371-34401a73fb41",
                                        "glosses": [
                                            "An organism that has characteristics of a more primitive form."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e8571cc-a285-37f5-ad1d-e6bc0befe7c7",
                                        "entry_id": "e990df43-0f2c-34a9-9371-34401a73fb41",
                                        "glosses": [
                                            "An atavism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12c84dc3-1e27-3311-96d4-6cc5d598df0a",
                                        "entry_id": "e990df43-0f2c-34a9-9371-34401a73fb41",
                                        "glosses": [
                                            "A person similar to an ancestor, or something new similar to what already existed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "141263bc-b6d4-4db5-bce6-864d66b94b9a",
                                                "sense_id": "12c84dc3-1e27-3311-96d4-6cc5d598df0a",
                                                "text": "\"But this is marvellous. It might be his portrait.\"\n\"Yes, it is an interesting instance of a throw-back, which appears to be both physical and spiritual. A study of family portraits is enough to convert a man to the doctrine of reincarnation. The fellow is a Baskerville—that is evident.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2152191-0190-37cd-8e26-1cd9d3122d97",
                                        "entry_id": "e990df43-0f2c-34a9-9371-34401a73fb41",
                                        "glosses": [
                                            "A person or thing that evokes memories."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "often",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ffc2662-0da8-4005-8734-7578cb777f5e",
                                                "sense_id": "b2152191-0190-37cd-8e26-1cd9d3122d97",
                                                "text": "Céline Dion belted her iconic song \"My Heart Will Go On\" in a show-stopping performance at the 2017 Billboard Music Awards on May 21. The legendary singer gave the throwback performance in honor of the 20th anniversary of the hit song from the Titanic soundtrack."
                                            },
                                            {
                                                "example_id": "5f5743ff-9594-4336-a04c-5fc5ecf83999",
                                                "sense_id": "b2152191-0190-37cd-8e26-1cd9d3122d97",
                                                "text": "It’s tempting to dismiss the 15-person outfit as out of touch. But Mayer may be onto something with Sunshine, and that’s nostalgia. Throwback tech is all the rage these days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "099bc5c3-22b0-3a7b-86e0-9b37144e1fc2",
                                        "entry_id": "e990df43-0f2c-34a9-9371-34401a73fb41",
                                        "glosses": [
                                            "A practice to avoid untaxed nowhere income by instead taxing such income in the originating state for a given transaction."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19d65cdd-20f2-4409-ace1-1804bf425797",
                                                "sense_id": "099bc5c3-22b0-3a7b-86e0-9b37144e1fc2",
                                                "text": "Under the throwback rule, sales into a state where the taxpayer is not taxable are “thrown back” from the destination state to the origin state by adding the nontaxable sales to the numerator in the apportionment factor."
                                            },
                                            {
                                                "example_id": "c6086fa8-9d9d-4f8b-9045-7003f3774ff0",
                                                "sense_id": "099bc5c3-22b0-3a7b-86e0-9b37144e1fc2",
                                                "text": "The effect of the throwback rule is to distribute income according to sales in the origin state. The effect of the throwout rule is to distribute income according to the taxpayer’s overall activities as measured by the other apportionment factors."
                                            },
                                            {
                                                "example_id": "93db031d-fd47-4bae-9385-5ffa90a445b5",
                                                "sense_id": "099bc5c3-22b0-3a7b-86e0-9b37144e1fc2",
                                                "text": "Attributing the gross receipts to the Member State of origin (i.e. applying a throwback rule) constitutes a benefit for that state that is not justified by the rationale of the gross receipts factor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fac4a52f-ae2c-480d-b588-a2593d410c7e",
                        "source_entry_id": "19963ed7-60ac-3285-8080-f793438006f4",
                        "source_sense_id": "1f8d0b8f-3967-3a9b-b559-1dc554e16b99",
                        "target_lang_word": "Relikt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Relikt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4249c21-bd1d-3818-894e-dbb11dba8d24",
                                        "entry_id": "de39254c-466b-3f21-810c-35ffbb3538c3",
                                        "glosses": [
                                            "Überbleibsel aus einer vergangenen Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a815b13-6fd6-4bca-937a-6a0dcfb4e848",
                                                "sense_id": "a4249c21-bd1d-3818-894e-dbb11dba8d24",
                                                "text": "„Initiationsriten scheinen in unserer modernen Gesellschaft zu den Relikten vergangener Epochen zu gehören. Und doch begegnen sie uns auch in der Moderne in vielen gesellschaftlichen Bereichen.“"
                                            },
                                            {
                                                "example_id": "22b927d7-c772-492a-a4d1-b9d37c504d48",
                                                "sense_id": "a4249c21-bd1d-3818-894e-dbb11dba8d24",
                                                "text": "„Die Frage nach Gott, nach dem Sinn des menschlichen Lebens, nach dem Wesen des Menschen oder nach den großen Zusammenhängen erschien den meisten Vertretern der Wissenschaft unwissenschaftlich und wurde als Relikt einer überwundenen Zeit angesehen.“"
                                            },
                                            {
                                                "example_id": "2640a88d-7fd6-45b9-95bf-86e144a4e128",
                                                "sense_id": "a4249c21-bd1d-3818-894e-dbb11dba8d24",
                                                "text": "„Er will vom Rummel um seine Person nichts mehr wissen, die Frau stirbt, er sitzt wieder auf dem Kutschbock, bei jedem Wetter, ein Relikt aus vergangener Zeit.“"
                                            },
                                            {
                                                "example_id": "f917dd77-e4ad-4f79-a581-79ec8408b7d1",
                                                "sense_id": "a4249c21-bd1d-3818-894e-dbb11dba8d24",
                                                "text": "Überall stößt man auf Relikte einer alten Hochkultur."
                                            },
                                            {
                                                "example_id": "a31269f1-ae7a-4bc0-bf78-1c31910788d3",
                                                "sense_id": "a4249c21-bd1d-3818-894e-dbb11dba8d24",
                                                "text": "Das sind doch Relikte aus den frühen 80-ern!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85cfea75-8e0a-37cb-b4e1-94c6700a4cef",
                                        "entry_id": "de39254c-466b-3f21-810c-35ffbb3538c3",
                                        "glosses": [
                                            "Überbleibsel aus einem früheren Zustand einer Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c30dd3ec-f1f1-42fe-8a83-b137b9c166c7",
                                                "sense_id": "85cfea75-8e0a-37cb-b4e1-94c6700a4cef",
                                                "text": "Die Wendung „mit Kind und Kegel“ ist das Relikt einer alten Bedeutung des Wortes „Kegel“."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c8b8264-fc74-4714-9cb7-c881a6a624f8",
                        "source_entry_id": "19963ed7-60ac-3285-8080-f793438006f4",
                        "source_sense_id": "1f8d0b8f-3967-3a9b-b559-1dc554e16b99",
                        "target_lang_word": "Überbleibsel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überbleibsel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd00ac49-c31b-3091-b94b-3a03283c4ae1",
                                        "entry_id": "32626f09-fc90-316d-acea-6bd72c468c1c",
                                        "glosses": [
                                            "etwas, das im Unterschied zu verschwundenen Dingen noch vorhanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cc67ef7-30b3-4650-af59-3eeaf975535f",
                                                "sense_id": "bd00ac49-c31b-3091-b94b-3a03283c4ae1",
                                                "text": "„Er hatte seinen einzigen guten Anzug an, ein altmodisches Überbleibsel aus seiner großen Zeit, und die Narbe an seiner Nase war schneeweiß.“"
                                            },
                                            {
                                                "example_id": "6f7f5a40-bba7-43a1-99a7-39c70340ab5a",
                                                "sense_id": "bd00ac49-c31b-3091-b94b-3a03283c4ae1",
                                                "text": "„Der Rolandsbogen, letztes Überbleibsel der ehemals auf einem Bergsporn oberhalb der Insel Nonnenwerth gelegenen, mittelalterlichen Rolandsburg, war eingestürzt.“"
                                            },
                                            {
                                                "example_id": "afb0fb78-ef49-482f-af3d-f0f76e5904de",
                                                "sense_id": "bd00ac49-c31b-3091-b94b-3a03283c4ae1",
                                                "text": "„Dieses Volk hatte überdauert und konnte von sich behaupten, das lebende Überbleibsel der ersten Menschen zu sein, mit einem uralten Stammbaum, der lückenlos bis in die Gegenwart reichte.“"
                                            },
                                            {
                                                "example_id": "98d5edfc-d8d9-4f52-a87b-3244e4f1b6c2",
                                                "sense_id": "bd00ac49-c31b-3091-b94b-3a03283c4ae1",
                                                "text": "„Am Nachmittag gehen sie in einen Laurel und Hardy-Film, ein Überbleibsel von vor dreißig Jahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
