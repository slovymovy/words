                            {
                                "example_id": "819a6e5e-2e85-4476-9510-b3824e847066",
                                "sense_id": "2e16bab3-c582-36cb-8835-62cd457cbe6f",
                                "text": "1962, Thomas A. Steven, James C. Ratté, Geology and Ore Deposits, Summitville District, San Juan Mountains, Colorado (Geological Survey Professional Paper 343), Geological Survey (U.S.) (publisher), page 41,\nParts of the resistant veins have been strongly leached and consists of vuggy, porous quartz ; elsewhere compact quartz has replaced most of the constituents in the original rock."
                            },
                            {
                                "example_id": "b1b432be-87eb-4cd7-a686-140b7d7f12b2",
                                "sense_id": "2e16bab3-c582-36cb-8835-62cd457cbe6f",
                                "text": "The diachronous layers under the lagoons, when traced seaward, become more and more vuggy, as cement is more patchily developed, and eventually pass into separate lumps (Taylor and Illing, 1969)."
                            },
                            {
                                "example_id": "e9ae5824-0131-4ec7-bb62-159a7749b26e",
                                "sense_id": "2e16bab3-c582-36cb-8835-62cd457cbe6f",
                                "text": "1976, Scripps Institution of Oceanography, Deep Sea Drilling Project, National Ocean Sediment Coring Program, Joint Oceanographic Institutions for Deep Earth Sampling, National Science Foundation (U.S.), Proceedings of the Ocean Drilling Program, Initial Report, page 46,\nThe basalt consists of a dark greenish-gray, aphyric, vesicular to vuggy altered rock that is diabasic and vesicular near the top, but becomes steadily coarser, more vuggy, and trachitic in texture in the lower part of the unit."
                            }
                        ]
