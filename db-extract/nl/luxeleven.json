                "senses": [
                    {
                        "sense_id": "08c6b756-3313-322c-846f-f9096ba4a898",
                        "entry_id": "ee0baf2b-02f1-3d1c-a9eb-2df15bee282a",
                        "glosses": [
                            "een van alle gemakken voorziene manier van leven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c63dd5d4-1caf-47cc-8de7-60a86d5141fe",
                                "sense_id": "08c6b756-3313-322c-846f-f9096ba4a898",
                                "text": "Bartel Van Riet laat 12 bekende Vlamingen opnieuw proeven van de ultieme natuurbeleving en trekt met 6 duo’s en een rugzak naar onontgonnen gebieden. 72 uur overleven in een stukje ongerepte natuur. Luxeleven on hold. Een klein rantsoen, geen slaapplek, geen reiskoffer met luxeproducten. Back to basics dus. Vuur maken. Wassen met ijswater. En je oriënteren in het oneindige landschap."
                            },
                            {
                                "example_id": "f8d945d6-2f48-4740-be0c-050c42f4d7d5",
                                "sense_id": "08c6b756-3313-322c-846f-f9096ba4a898",
                                "text": "Hoewel N. directeur was van een zorgstichting, ’zocht hij mogelijkheden’ als ondernemer. Daarbij beloonde hij zichzelf rijkelijk. Hiervan kon hij een luxeleventje leiden. Zo reed hij onder meer in een Porsche, een Audi én een BMW. De huur van zijn luxe Rotterdamse appartement en de 10.000 euro die hij maandelijks neerlegde voor een villa in aanbouw werden betaald door de zorginstelling."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abe5f6f8-cd1a-4d72-abf6-a2278f0d62b7",
                        "source_entry_id": "ee0baf2b-02f1-3d1c-a9eb-2df15bee282a",
                        "source_sense_id": "08c6b756-3313-322c-846f-f9096ba4a898",
                        "target_lang_word": "life of Riley",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "life of Riley",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00ee7e77-6543-3260-920a-b1aac0d892a2",
                                        "entry_id": "bfb7a22e-0cd8-3492-a897-9da00a858534",
                                        "glosses": [
                                            "An ideal life of carefree prosperity and luxurious contentment."
                                        ],
                                        "tags": [
                                            "dated",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcacf92b-811f-498f-b960-f1aa8f3af3ba",
                                                "sense_id": "00ee7e77-6543-3260-920a-b1aac0d892a2",
                                                "text": "It's the life of Reilly, but we're not stuck on it at that [...] If I stay her^([sic]) doing this sort of work for another week I won't be fit to work all summer, for I'm getting lazier every day"
                                            },
                                            {
                                                "example_id": "23096f30-b6d1-492e-82a9-a4e97d2a128a",
                                                "sense_id": "00ee7e77-6543-3260-920a-b1aac0d892a2",
                                                "text": "Michael, according to his own story, had \"been living the life of Riley\" ever since he bolted."
                                            },
                                            {
                                                "example_id": "5d566111-584d-49f4-8e71-4d79a3b58deb",
                                                "sense_id": "00ee7e77-6543-3260-920a-b1aac0d892a2",
                                                "text": "The famous wild cow of Cromwell is no more. After “living the life of Riley” for over a year, successfully evading the pitchforks and the bullets of the farmers, whose fields she ravaged in all four seasons."
                                            },
                                            {
                                                "example_id": "aca70ae6-ef36-4012-ba8a-10d5617d8af6",
                                                "sense_id": "00ee7e77-6543-3260-920a-b1aac0d892a2",
                                                "text": "This is the story of the softships of the Third American Army. For the Yankee troops who were assigned to take and hold the Coblenz bridgehead are leading the life of Riley on the Rhine."
                                            },
                                            {
                                                "example_id": "58aeb5d1-4479-4dd9-94cb-203d0247cd45",
                                                "sense_id": "00ee7e77-6543-3260-920a-b1aac0d892a2",
                                                "text": "Faith and my name is Kelly, Michael Kelly,\nBut I’m living the life of Reilly just the same."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
