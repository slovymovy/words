                                "target_senses": [
                                    {
                                        "sense_id": "ae263cf5-aab1-3d6a-b1c6-707e2c91d886",
                                        "entry_id": "faec1762-c391-30b6-921e-fa6f41a14034",
                                        "glosses": [
                                            "In the philosophy of science, the view that concepts and theories are merely useful instruments whose worth is measured not by whether the concepts and theories are true or false (or correctly depict reality), but how effective they are in explaining and predicting phenomena."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76ae4558-c0a8-4009-922e-a2794feed6ed",
                                                "sense_id": "ae263cf5-aab1-3d6a-b1c6-707e2c91d886",
                                                "text": "Instrumentalism views truth as simply the value belonging to certain ideas in so far as these ideas are biological functions of our organisms, and psychological functions whereby we direct our choices and attain our successes."
                                            }
                                        ]
                                    }
                                ]
