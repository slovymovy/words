                        "glosses": [
                            "staatliche Maßnahme, Verordnung, Vorschrift, die für den freien Güteraustausch hinderlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42ed9ca7-028b-48ad-b13b-be2091d9c376",
                                "sense_id": "f82882ec-dc2a-3c4c-a45a-f0f36d14fd84",
                                "text": "„In einem noch nicht endgültig abgestimmten Dokument verpflichten sich die G8-Staaten, ihre Märkte zu öffnen und so Handelshemmnisse zu beseitigen.“"
