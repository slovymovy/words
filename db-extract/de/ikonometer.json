                "senses": [
                    {
                        "sense_id": "2d7e8317-d9f6-3982-a135-5997f67c9bfb",
                        "entry_id": "f079736e-ad47-382b-805b-7e2eded1ee6c",
                        "glosses": [
                            "Vorrichtung an Handkameras zur Einteilung des Bildes"
                        ],
                        "tags": [
                            "Fotografie"
                        ],
                        "examples": [
                            {
                                "example_id": "ca1f99ab-f8e6-494d-ba8a-7a759b0bee4c",
                                "sense_id": "2d7e8317-d9f6-3982-a135-5997f67c9bfb",
                                "text": "„Beim Visieren mit dem Ikonometer wird das Bildfeld durch den an der Standarte befestigten Drahtrahmen begrenzt; das Auge befindet sich hierbei unmittelbar vor dem Diopter (Lochblende).“"
                            },
                            {
                                "example_id": "d180be36-71ac-4ed2-ac15-77fe45f50bcd",
                                "sense_id": "2d7e8317-d9f6-3982-a135-5997f67c9bfb",
                                "text": "„Bei den modernen Handkameras hat sich im Laufe der Jahre nachstehend beschriebene, heute fast allgemein angewandte Bauart des Ikonometers herausgebildet: der sogenannte Rahmen besteht aus einem leichten Drahtgestell von rechteckiger Form, die derjenigen des jeweiligen Plattenformats ähnlich sein muß, ohne dessen absolute Größe haben zu müssen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
