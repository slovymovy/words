                                "example_id": "e9acf631-9c76-4992-be29-115fae45adff",
                                "sense_id": "a01c1032-213a-3730-8112-886ae5c9dbae",
                                "text": "Im Dezember wurde Regina zur Heimleiterin des Kinderheimes ernannt."
                            },
                            {
                                "example_id": "b278f386-b8a1-41a5-8049-77a32bf721d4",
                                "sense_id": "a01c1032-213a-3730-8112-886ae5c9dbae",
                                "text": "„Die Stimme der Heimleiterin klingt noch immer in meinen Ohren nach.“"
                            },
                            {
                                "example_id": "d2579fd2-1e66-439e-8968-43cbf90e0207",
                                "sense_id": "a01c1032-213a-3730-8112-886ae5c9dbae",
                                "text": "„Immer wieder hatte er zu Schwester Angelika, der Heimleiterin, gemusst.“"
                            }
