                "senses": [
                    {
                        "sense_id": "d57549d0-aad3-367b-b806-d72b4fe1a1f5",
                        "entry_id": "29cb2ae4-e6ef-3519-9680-3a93c848eed8",
                        "glosses": [
                            "veränderte Formulierung eines Begriffes oder einer Theorie aufgrund neuer Erkenntnisse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d417e9db-708c-434e-ba44-d1c03066d68f",
                                "sense_id": "d57549d0-aad3-367b-b806-d72b4fe1a1f5",
                                "text": "Schließlich folgte die mathematische Reformulierung der Theorie durch Einbeziehung der Zeit als vierte Dimension durch Hermann Minkowski (1907)."
                            },
                            {
                                "example_id": "c768d7a3-a2f4-41ec-a6db-8347122e437f",
                                "sense_id": "d57549d0-aad3-367b-b806-d72b4fe1a1f5",
                                "text": "Die Reformulierung von Körper und Selbst in Begriffen der Information eröffne auch neue Chancen der Kontrolle und Verwertung: „Jedes beliebige Objekt und jede Person kann auf angemessene Weise unter der Perspektive von Zerlegung und Rekombination betrachtet werden, keine ‚natürlichen‘ Architekturen beschränken die mögliche Gestaltung des Systems.“"
                            },
                            {
                                "example_id": "3d60a3b1-6a00-4716-a8a2-719e84064f29",
                                "sense_id": "d57549d0-aad3-367b-b806-d72b4fe1a1f5",
                                "text": "Der Strukturwandel hin zur Netzwerkgesellschaft erfordere daher eine netzwerktheoretische Reformulierung des Managementbegriffs, der auch das Management öffentlicher Belange betreffe."
                            },
                            {
                                "example_id": "73050c1a-d7d7-4067-8401-4afd98db75f2",
                                "sense_id": "d57549d0-aad3-367b-b806-d72b4fe1a1f5",
                                "text": "Man musste nicht von ihm abstrahieren, E.T. war von Anfang an ein hoch formaler Vorschlag einer zeitgemäßeren Reformulierung des Alien-Problems in der Spätphase des Kalten Krieges."
                            },
                            {
                                "example_id": "97ef26c7-e6db-4201-a7ad-a8fcaec08fde",
                                "sense_id": "d57549d0-aad3-367b-b806-d72b4fe1a1f5",
                                "text": "Das Argument der Reformulierung des Raums auf Grundlage medialer Information wird verfolgt, ausgehend von der kartographierten Landvermessung, hin zur mediengeographischen Codierung des Territoriums."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e4e1f759-3429-3b59-9d14-50f58e542a5d",
                        "entry_id": "29cb2ae4-e6ef-3519-9680-3a93c848eed8",
                        "glosses": [
                            "Veränderung der Rezeptur industriell verarbeiteter Lebensmittel durch Reduktion von Fett, Salz und Zucker, um deren Gesundheitswert zu steigern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5de326d8-1781-411e-be73-e6abff70be80",
                                "sense_id": "e4e1f759-3429-3b59-9d14-50f58e542a5d",
                                "text": "Das MRI bewertet die Reduktion des Gehaltes an zugesetzten Zuckern durch Reformulierung von verarbeiteten Lebensmitteln als eine effektive Maßnahme zur Senkung der Zucker- und Energiezufuhr."
                            },
                            {
                                "example_id": "2a485130-4a18-4d69-aa8c-fc5ca0fbb007",
                                "sense_id": "e4e1f759-3429-3b59-9d14-50f58e542a5d",
                                "text": "Die Ergebnisse aus unseren zahlreichen Forschungsprojekten zur Reformulierung von Lebensmitteln fließen in unsere Beratung mit ein."
                            },
                            {
                                "example_id": "5589f33e-a6b9-43c9-8733-3d48a0bdb0ce",
                                "sense_id": "e4e1f759-3429-3b59-9d14-50f58e542a5d",
                                "text": "„Veränderte Rezepturen für Lebensmittel mit weniger Zucker, Salz und Fett sind das Ziel einer nationalen Strategie für die Reformulierung von Lebensmitteln, die das Bundesernährungsministerium derzeit erarbeitet."
                            },
                            {
                                "example_id": "a09f5bd5-c655-444b-bc16-5bd905e334da",
                                "sense_id": "e4e1f759-3429-3b59-9d14-50f58e542a5d",
                                "text": "In Anbetracht der Größe und Differenziertheit des Lebensmittelangebotes in Deutschland ist es jedoch eine offene Forschungsfrage, ob die Strategie der Reformulierung bisher überhaupt bei VerbraucherInnen [sic] ankommt."
                            },
                            {
                                "example_id": "8355a062-1c88-4f1c-8380-cb0f4cebd38b",
                                "sense_id": "e4e1f759-3429-3b59-9d14-50f58e542a5d",
                                "text": "Ein Ansatz innerhalb dieser Strategie, der bereits in vielen EU-Mitgliedsstaaten verfolgt wird, ist die Rezepturänderung, die sog. Reformulierung, von Lebensmitteln mit dem Ziel, den Zucker-, Fett- und Salzkonsum zu reduzieren und somit eine gesündere Ernährungsweise zu fördern."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
