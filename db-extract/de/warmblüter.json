                ],
                "senses": [
                    {
                        "sense_id": "fae33416-acc2-3cbe-b44b-9a99f1e47a6b",
                        "entry_id": "47dd67d3-0d59-31a5-83d4-4ea53af33570",
                        "glosses": [
                            "Lebewesen mit meist konstanter Eigentemperatur, die von der Umgebungstemperatur weitgehend unabhängig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac024f44-9cb7-4ff8-8564-c7140a31af81",
                                "sense_id": "fae33416-acc2-3cbe-b44b-9a99f1e47a6b",
                                "text": "Stattdessen setzte man auf Echsen, sie seien die großen Räuber auf dem nahrungsarmen Kontinent gewesen, sie müssen den Körper nicht wärmen, nicht so viel fressen wie gleich große Warmblüter."
                            },
                            {
                                "example_id": "a7922c4d-3105-4041-a909-011ce24d74f2",
                                "sense_id": "fae33416-acc2-3cbe-b44b-9a99f1e47a6b",
                                "text": "Rein thermoregulatorisch betrachtet, ist es günstiger, als Warmblüter groß und fett zu sein als klein und mager, weil die Kleinen viel mehr fressen müssen, um im Winter warm zu bleiben."
                            },
                            {
                                "example_id": "eb689356-8b90-4d96-a3bf-cb40668debd3",
                                "sense_id": "fae33416-acc2-3cbe-b44b-9a99f1e47a6b",
                                "text": "Er prüft, in Zusammenarbeit mit Pathologen des National Zoological Park in Washington, vireninfizierte Hühnereier auf Guam auszulegen. Darin enthaltene Paramyxoviren gefährden Warmblüter nicht, sollen aber eine Seuche unter den Nattern auslösen."
                            },
                            {
                                "example_id": "eda79989-0e03-456c-85c6-be4fc4fa7ddc",
                                "sense_id": "fae33416-acc2-3cbe-b44b-9a99f1e47a6b",
                                "text": "Entgegen einer weit verbreiteten Annahme waren die Dinosaurier möglicherweise keine Kaltblüter wie ihre entfernten Cousins, die Reptilien, sondern Warmblüter wie die Säugetiere."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
