                    "sense_id": "41261d95-d382-3658-a988-972880277176",
                    "sense_definition": "Intoxicated by alcohol or drugs",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intoxicated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were completely <w>caned</w> after drinking all night at the party.",
                            "target_lang_translations": {
                                "nl": "Ze waren na een hele nacht drinken op het feest compleet <w>bezopen</w>."
                            }
                        },
                        {
                            "text": "He felt far too <w>caned</w> to drive home safely.",
                            "target_lang_translations": {
                                "nl": "Hij voelde zich veel te <w>lam</w> om veilig naar huis te rijden."
                            }
                        }
                    ],
                    "synonyms": [
                        "drunk",
                        "intoxicated",
                        "stoned"
                    ],
                    "antonyms": [
                        "sober"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used informally to describe being under the influence."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Onder invloed van alcohol of drugs; straalbezopen of zwaar onder invloed."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bezopen",
                                "target_lang_sense_clarification": "informeel, zeer dronken"
                            },
                            {
                                "target_lang_word": "stoned",
                                "target_lang_sense_clarification": "onder invloed van drugs"
                            },
                            {
                                "target_lang_word": "lam",
                                "target_lang_sense_clarification": "informeel, erg dronken"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aff31d36-6a04-34c0-bfad-4af4380827f3",
                    "sense_definition": "Simple past and past participle of <w>cane</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher <w>caned</w> the student for misbehaving in class.",
                            "target_lang_translations": {
                                "nl": "De leraar <w>afgeranselde</w> de leerling vanwege wangedrag in de klas."
                            }
                        },
                        {
                            "text": "The naughty boy was <w>caned</w> as a form of punishment.",
                            "target_lang_translations": {
                                "nl": "De stoute jongen werd als straf <w>afgeranseld</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form of the verb."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De verleden tijd en voltooid deelwoord van 'cane', wat betekent iemand slaan met een rieten stok als straf."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afgeranseld",
                                "target_lang_sense_clarification": "met een stok geslagen"
                            },
                            {
                                "target_lang_word": "stokslagen gegeven",
                                "target_lang_sense_clarification": "als lijfstraffen toegediend"
                            }
                        ]
                    }
                }
            ]
