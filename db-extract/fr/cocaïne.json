        "de-extract.jsonl": [
            {
                "entry_id": "fa946dbe-869b-3b78-86b7-3a18dff5bf5b",
                "word": "cocaïne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1d602ce7-56e2-385e-831b-0affc76b41b9",
                        "entry_id": "fa946dbe-869b-3b78-86b7-3a18dff5bf5b",
                        "glosses": [
                            "Kokain"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c700ce11-3382-4fe8-a517-5a23dbd9750e",
                                "sense_id": "1d602ce7-56e2-385e-831b-0affc76b41b9",
                                "text": "» Contemplez les autres — les heureux d’ici-bas, — voyez-les se ruer dans les plaisirs qui tuent, se complaire aux vices et aux poisons, se bourrer de cocaïne, de morphine, de haschich, d’opium, d’éther ou tout simplement de whisky ou de champagne. «",
                                "translation": "Betrachten Sie die anderen – die Glücklichen von hier unten, – sehen Sie, wie sie auf die Freuden stürmen, die sie töten, wie sie sich an den Lastern und Giften erfreuen, sich mit Kokain, Morphin, Haschisch, Opium, Ether oder ganz einfach mit Whisky oder Champagner vollstopfen."
                            },
                            {
                                "example_id": "68907c06-254f-47ad-b897-0b38cd42bf76",
                                "sense_id": "1d602ce7-56e2-385e-831b-0affc76b41b9",
                                "text": "» On s’endort — nonchalamment on rêve\n— éther — laudanum, opium, morphine,\ncocaïne —«",
                                "translation": "Man schläft ein – lässig träumt man\n— Ether — Laudanum, Opium, Morphin,\nKokain —"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
