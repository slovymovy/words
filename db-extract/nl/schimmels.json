                                        "glosses": [
                                            "owocnik grzyba (1.1) kapeluszowego, np. borowik, maślak, kurka, muchomor"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ec3ca5f-118a-4dbe-b4cd-529d6abb82f8",
                                                "sense_id": "40da5f54-c246-3de8-b8f1-d454aadd2b6f",
                                                "text": "Babcia chodziła po lesie z wielkim koszem i kładła do niego zebrane grzyby."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "176e386a-e5b1-3861-9ef2-fb372624448a",
