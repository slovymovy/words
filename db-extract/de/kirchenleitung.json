                ],
                "senses": [
                    {
                        "sense_id": "c7981a98-c37d-3420-a702-008a24b2c238",
                        "entry_id": "1753ba69-913e-3a37-b477-8a6f69d45dc5",
                        "glosses": [
                            "Leitung einer Kirche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "394843a5-14bd-4e19-bd8f-667aa811835f",
                                "sense_id": "c7981a98-c37d-3420-a702-008a24b2c238",
                                "text": "„Statt neue Denkwege zuzulassen, verschanze sich die Kirchenleitung hinter Traditionen.“"
                            },
                            {
                                "example_id": "c4c1e971-89d7-465b-a8e7-766b595aae7f",
                                "sense_id": "c7981a98-c37d-3420-a702-008a24b2c238",
                                "text": "„Dass die Kirchenleitung ein hohes Tempo anschlägt, ist angesichts der Umstände verständlich: Als Folge von Kirchenaustritten und demografischen Entwicklungen hat sich die reformierte Kirche im Kanton Zürich in den vergangenen Jahren stark verändert.“"
                            },
                            {
                                "example_id": "807ae266-c053-4d89-a1a4-912123bbc7ad",
                                "sense_id": "c7981a98-c37d-3420-a702-008a24b2c238",
                                "text": "„Die Staatsanwaltschaften haben die Evangelische Kirchenleitung von der Einleitung gerichtlicher Vorerhebungen und von der Zurücklegung einer Strafanzeige gegen geistliche Amtsträger der Evangelischen Kirche ohne unnötigen Aufschub zu verständigen.“"
                            },
                            {
                                "example_id": "e0a4f9fe-fc58-43d6-b3b2-e6e927fbfd17",
                                "sense_id": "c7981a98-c37d-3420-a702-008a24b2c238",
                                "text": "„Er hatte vorausgesehen, welchen Wirbel die von ihm verkündete Anschauung in den Gemütern der im Traditionellen lebenden und denkenden Kirchenleitung und des Kirchenvolkes hervorrufen würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
