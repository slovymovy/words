{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cf97d36a-2b5d-3762-bff1-60cc8158b3bc",
                    "sense_definition": "A vehicle specially designed or used to carry a coffin or casket in a funeral procession.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "funeral_conveyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A black <w>hearse</w> led the procession slowly toward the cemetery gates.",
                            "target_lang_translations": {
                                "ru": "Чёрный <w>катафалк</w> медленно вёл процессию к воротам кладбища."
                            }
                        },
                        {
                            "text": "The family gathered on the sidewalk as the <w>hearse</w> arrived at the church.",
                            "target_lang_translations": {
                                "ru": "Семья собралась на тротуаре, когда к церкви подъехал <w>катафалк</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "funeral hearse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Транспортное средство, специально предназначенное для перевозки гроба с телом умершего во время похоронной процессии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "катафалк",
                                "target_lang_sense_clarification": "автомобиль или повозка для гроба"
                            },
                            {
                                "target_lang_word": "дроги",
                                "target_lang_sense_clarification": "похоронная повозка, колесница"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16623f29-4791-31f3-9161-0734083c52b4",
                    "sense_definition": "A framework placed over a coffin or tomb to hold candles or a pall during funeral ceremonies.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_canopy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tapers flickered on the ornate <w>hearse</w> erected in the middle of the cathedral choir.",
                            "target_lang_translations": {
                                "ru": "Свечи мерцали на богато украшенном <w>балдахине</w>, установленном посреди хора собора."
                            }
                        },
                        {
                            "text": "The mourners placed ceremonial cloths over the wooden <w>hearse</w> above the tomb.",
                            "target_lang_translations": {
                                "ru": "Скорбящие возложили ритуальные покрывала на деревянный <w>каркас</w> над гробницей."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical ecclesiastical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Каркас или навес, устанавливаемый над гробом или гробницей для свечей или покрова во время заупокойных служб."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "балдахин",
                                "target_lang_sense_clarification": "навес или траурная сень над гробом"
                            },
                            {
                                "target_lang_word": "катафалк",
                                "target_lang_sense_clarification": "траурное возвышение или конструкция над гробом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f01544ff-0706-30ab-aecc-c718b09ee16d",
                    "sense_definition": "A handbarrow or bier used to carry a dead body to the grave.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "funeral_conveyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Four pallbearers carried the simple wooden <w>hearse</w> through the village to the churchyard.",
                            "target_lang_translations": {
                                "ru": "Четверо несущих гроб несли простые деревянные <w>похоронные дроги</w> через деревню к кладбищу."
                            }
                        },
                        {
                            "text": "The ancient chronicler described how the fallen soldier was laid upon a <w>hearse</w>.",
                            "target_lang_translations": {
                                "ru": "Древний летописец описал, как павшего воина положили на <w>погребальные носилки</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bier"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage for bier"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Носилки или подставка для переноски умершего к месту погребения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дроги",
                                "target_lang_sense_clarification": "погребальные носилки или ручная повозка"
                            },
                            {
                                "target_lang_word": "катафалк",
                                "target_lang_sense_clarification": "похоронные носилки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3e980ad-50b5-3ec5-b964-f2915b794aca",
                    "sense_definition": "A grave, tomb, coffin, or sepulchral monument.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tomb_monument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet reflected in melancholy verse on those who rest beneath the quiet <w>hearse</w>.",
                            "target_lang_translations": {
                                "ru": "Поэт размышлял в меланхоличных стихах о тех, кто покоится под тихой <w>могилой</w>."
                            }
                        },
                        {
                            "text": "A sculptured marble <w>hearse</w> was commissioned to honor the deceased nobleman.",
                            "target_lang_translations": {
                                "ru": "В честь усопшего дворянина была заказана скульптурная мраморная <w>гробница</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "grave",
                        "tomb"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "archaic and poetic meaning for tomb or grave"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Могила, гробница или погребальный памятник."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гробница",
                                "target_lang_sense_clarification": "усыпальница, монумент"
                            },
                            {
                                "target_lang_word": "могила",
                                "target_lang_sense_clarification": "место захоронения"
                            },
                            {
                                "target_lang_word": "гроб",
                                "target_lang_sense_clarification": "вместилище для умершего"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa277cb1-4bdd-38ee-93b9-7846f38c51f3",
                    "sense_definition": "Alternative form of <w>hearst</w>: a female red deer in its second or third year.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forester noted a young <w>hearse</w> grazing peacefully along the forest edge.",
                            "target_lang_translations": {
                                "ru": "Лесник заметил молодую <w>олениху</w>, мирно пасущуюся на опушке леса."
                            }
                        },
                        {
                            "text": "Hunters were forbidden from tracking a <w>hearse</w> during that time of the season.",
                            "target_lang_translations": {
                                "ru": "Охотникам запрещалось выслеживать <w>молодую олениху</w> в это время года."
                            }
                        }
                    ],
                    "synonyms": [
                        "hind"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare alternative form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самка благородного оленя на втором или третьем году жизни (вариант написания hearst)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молодая олениха",
                                "target_lang_sense_clarification": "самка оленя двух-трёх лет"
                            },
                            {
                                "target_lang_word": "ланка",
                                "target_lang_sense_clarification": "молодая самка оленя"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3ee807e6-dcb1-353c-b68d-4b488a5bea72",
                    "sense_definition": "To enclose in a hearse or coffin; to entomb.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fallen knight was solemnly <w>hearsed</w> beneath the stone floor of the chapel.",
                            "target_lang_translations": {
                                "ru": "Павший рыцарь был торжественно <w>погребён</w> под каменным полом часовни."
                            }
                        },
                        {
                            "text": "They wished to see their enemy dead and <w>hearsed</w> far away from the kingdom.",
                            "target_lang_translations": {
                                "ru": "Они желали видеть своего врага мёртвым и <w>сошедшим в могилу</w> вдали от королевства."
                            }
                        }
                    ],
                    "synonyms": [
                        "entomb"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "archaic or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещать в гроб или погребать; предавать земле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погребать",
                                "target_lang_sense_clarification": "хоронить, предавать земле"
                            },
                            {
                                "target_lang_word": "укладывать в гроб",
                                "target_lang_sense_clarification": "помещать в саркофаг или гроб"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}