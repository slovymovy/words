                "senses": [
                    {
                        "sense_id": "f180f9b2-8492-39c5-88da-f41705ae4b2b",
                        "entry_id": "041851ca-42ab-3a47-9af5-cd0fa8ab3a2a",
                        "glosses": [
                            "Continuing at full strength or intensity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb2b31d9-3314-4d41-b571-9a9d729cc890",
                                "sense_id": "f180f9b2-8492-39c5-88da-f41705ae4b2b",
                                "text": "In this period, road building continued unabated, but change was in the wind as the UK government recognised it had to make more use of the rail network and increase investment on a scale that it could not afford, and which would require private sector participation."
                            },
                            {
                                "example_id": "c7f18e78-42c5-4fa5-9b85-9abb3965ab5e",
                                "sense_id": "f180f9b2-8492-39c5-88da-f41705ae4b2b",
                                "text": "More than 100 countries already support a phase-out of “unabated” fossil fuels – those where the resultant emissions are not captured – and whether the final Cop28 agreement calls for this or uses weaker language such as “phase-down” is one of the most fiercely fought issues at the summit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec1a9f7f-5784-4fb9-917a-a7923485b0ab",
                        "source_entry_id": "041851ca-42ab-3a47-9af5-cd0fa8ab3a2a",
                        "source_sense_id": "f180f9b2-8492-39c5-88da-f41705ae4b2b",
                        "source_sense_description": "continuing at full strength",
                        "target_lang_word": "onverminderd",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onverminderd",
