                        "sense_id": "29dbc8cb-1829-3eb2-86d5-7b3c49d93d38",
                        "entry_id": "9697b86b-db0f-34f6-ab9b-4330646d17cb",
                        "glosses": [
                            "als bepaling van gesteldheid: in zijn geheel, zonder uitzondering"
