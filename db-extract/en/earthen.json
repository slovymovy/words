                                                "sense_id": "392293ce-f0c0-3a0d-b2aa-f68237cae6f5",
                                                "text": "Volgens haar dossier aardde Josta goed bij haar nieuwe ouders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "963b56d1-78af-3713-8102-ff59a941d0d6",
