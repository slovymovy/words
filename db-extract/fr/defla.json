                        ],
                        "examples": [
                            {
                                "example_id": "f003caa6-8fa9-4dc3-9024-cb06adad8bc2",
                                "sense_id": "a0e86573-c6c7-348a-9034-093665e73733",
                                "text": "Le long des cours d'eau croissent le tarfa (Tamarix africana), le defla (laurier rose : Nerium oleander), le gattilier (Vitex agnus-castus), le ricin (Ricinus communis), le b'toum (Pistacia atlantica), des peupliers (sefsafa), des palmiers (nekhla : Phœnix dactylifera) solitaires ou par groupes; […]."
                            },
                            {
                                "example_id": "dc3e354a-d353-4c9d-9265-cbc15744842e",
                                "sense_id": "a0e86573-c6c7-348a-9034-093665e73733",
                                "text": "Le voyageur rencontre aussi un certain nombre d’arbres communs aux trois étages, tel le defla, ou laurier-rose (Nerium oleander), d’origine méditerranéenne. Il est en abondance partout où l’eau est à peu de profondeur."
                            }
                        ]
                    }
