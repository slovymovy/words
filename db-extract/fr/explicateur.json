                                    {
                                        "sense_id": "20cb8c41-3a79-3104-aeea-4b68741c9332",
                                        "entry_id": "8812912d-0e67-32df-bb27-7b642be82edd",
                                        "glosses": [
                                            "Agent noun of explain; one who explains."
                                        ],
                                        "tags": [
                                            "agent",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6804850-67e4-4bff-ad13-f141f1948641",
                                                "sense_id": "20cb8c41-3a79-3104-aeea-4b68741c9332",
                                                "text": "To be a skilled explainer, one has also to take account of the explainees, and their social and cultural backgrounds, motivations, linguistic ability, and previous knowledge – and plan accordingly before embarking upon the explanation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "458d7c77-af21-3037-ba2d-301610c734ea",
                                        "entry_id": "8812912d-0e67-32df-bb27-7b642be82edd",
                                        "glosses": [
                                            "A guide that explains a topic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b4c8a77-18a8-4f23-a82d-d49109853707",
                                                "sense_id": "458d7c77-af21-3037-ba2d-301610c734ea",
                                                "text": "Confused by the Olympics? Here's a video explainer."
                                            },
                                            {
                                                "example_id": "2b45dc74-961c-41fe-96c5-da900f63665d",
                                                "sense_id": "458d7c77-af21-3037-ba2d-301610c734ea",
                                                "text": "In a series of short explainers, the BBC News Channel’s Outside Source presenter has repeatedly skewered the Boris Johnson administration, while never coming within striking distance of seeming to have an opinion."
                                            },
                                            {
                                                "example_id": "4b0cb573-a41d-4b8c-b2a2-42cbd2dad7c7",
                                                "sense_id": "458d7c77-af21-3037-ba2d-301610c734ea",
                                                "text": "Quick explainers and infographics giving context to what was happening in Palestine were being shared all over Instagram and TikTok."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
