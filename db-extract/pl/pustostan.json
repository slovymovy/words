                "translations": [
                    {
                        "translation_id": "70b39e83-1c1b-4307-bcf3-30142774fea1",
                        "source_entry_id": "e822b864-dce5-3f9b-af6f-bec25b53a317",
                        "source_sense_id": "f695c567-58e6-32bb-acd5-b9c7806586aa",
                        "target_lang_word": "Leerstand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leerstand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4482ce4-d19b-3ccc-baf1-ca68ed083710",
                                        "entry_id": "a36c730b-2881-3abd-8918-27cdc18ab102",
                                        "glosses": [
                                            "leerstehender Mietraum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c67cab8-2e8c-403c-b33d-5670e3041fd6",
                                                "sense_id": "c4482ce4-d19b-3ccc-baf1-ca68ed083710",
                                                "text": "„Der neue, dritte Leerstand wird nun im April Aurachers Spielzeuggeschäft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5a1fe96f-dc76-3764-8e66-1437547f61fa",
                                        "entry_id": "a36c730b-2881-3abd-8918-27cdc18ab102",
                                        "glosses": [
                                            "Leerstehen eines Mietraums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9d76c0e-b04a-4a12-ac32-c39914f4f162",
                                                "sense_id": "5a1fe96f-dc76-3764-8e66-1437547f61fa",
                                                "text": "„Man darf nicht auf formale Vorschriften aus Prinzip bestehen, denn dann droht Leerstand und damit ist niemandem geholfen.“"
                                            },
                                            {
                                                "example_id": "e797e9e1-2c2e-4a8e-adb1-ac004c5bb8a2",
                                                "sense_id": "5a1fe96f-dc76-3764-8e66-1437547f61fa",
                                                "text": "„Allerdings gibt es beim Leerstand regional betrachtet große Unterschiede: So sind die Leerstandsquoten im Osten deutlich höher als im Westen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e6605920-5a9b-37ea-a667-62dc81b12c88",
                                        "entry_id": "a36c730b-2881-3abd-8918-27cdc18ab102",
                                        "glosses": [
                                            "Anteil der leerstehenden Mieträume an allen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1387d8bf-aa06-49b2-8867-9124588791e9",
                                                "sense_id": "e6605920-5a9b-37ea-a667-62dc81b12c88",
                                                "text": "„Sie liegen bei rund zwei Prozent Leerstand oder knapp darüber.“"
                                            },
                                            {
                                                "example_id": "149e2d45-c2cc-4fa7-8ad1-e85d0287d97a",
                                                "sense_id": "e6605920-5a9b-37ea-a667-62dc81b12c88",
                                                "text": "„Bei zehn Prozent der Unternehmen ist der Leerstand seit 2011 sogar um mehr als drei Prozent gestiegen.“"
                                            },
                                            {
                                                "example_id": "8f887d3f-21bc-4551-8171-4563d71abd70",
                                                "sense_id": "e6605920-5a9b-37ea-a667-62dc81b12c88",
                                                "text": "Der Leerstand bei Bürogebäuden liegt nur noch bei 3 %."
                                            },
                                            {
                                                "example_id": "b6abdfed-9ad6-42f6-b3f5-8fe7e4d2296b",
                                                "sense_id": "e6605920-5a9b-37ea-a667-62dc81b12c88",
                                                "text": "„Demnach sank der Leerstand im Jahr 2015 auf 5,9 Prozent und damit auf den niedrigsten Stand seit Jahrzehnten.“"
                                            },
                                            {
                                                "example_id": "be71187f-7e0f-4d42-a154-3f7be8188464",
                                                "sense_id": "e6605920-5a9b-37ea-a667-62dc81b12c88",
                                                "text": "„Der marktaktive Leerstand betrage rund 2,5 Prozent.“"
                                            },
                                            {
                                                "example_id": "ce2dbfd0-5145-448d-98df-418b6b743d6e",
                                                "sense_id": "e6605920-5a9b-37ea-a667-62dc81b12c88",
                                                "text": "„Im gesamten Bundesgebiet ist der Leerstand jedoch laut einer Studie erneut gesunken und liegt nur noch bei drei Prozent.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
