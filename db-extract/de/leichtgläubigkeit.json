                            {
                                "example_id": "7da67a30-17ab-4a3e-ad50-192577be7bd0",
                                "sense_id": "446e4c2a-c288-3238-8b3e-31d39afed1b3",
                                "text": "Die Leichtgläubigkeit der Jünger dieser Sekte ist kaum zu fassen.",
                                "translation": "La crédulité des disciples de cette secte est incroyable."
                            },
                            {
                                "example_id": "ce2e0891-1780-4045-8608-853fec9dbe72",
                                "sense_id": "446e4c2a-c288-3238-8b3e-31d39afed1b3",
                                "text": "Schamlos missbrauchte er die Leichtgläubigkeit seiner alten Nachbarin, um ihr Gelt abzuzocken.",
                                "translation": "Il abusa sans vergogne de la crédulité de sa vieille voisine pour lui soutirer de l'argent."
                            }
