                                "example_id": "67702de9-e027-48ed-8267-30482c74a175",
                                "sense_id": "14d02422-6ddc-39d9-b147-253688b3de7b",
                                "text": "Die höchsten Gipfel des Schwarzwaldes, des Böhmerwaldes sowie der Brocken ragen über die Waldgrenze hinaus, wobei nur der Brocken oberhalb der natürlichen Waldgrenze liegt."
                            },
                            {
                                "example_id": "33ead275-9da2-4732-a3da-96168029d865",
                                "sense_id": "14d02422-6ddc-39d9-b147-253688b3de7b",
                                "text": "„Die Waldgrenze liegt bei 1000 m oder nur wenig darüber.“"
                            }
                        ],
