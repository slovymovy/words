                "senses": [
                    {
                        "sense_id": "798c04d7-fc57-3c13-923d-d0c89e74f643",
                        "entry_id": "f96ff705-b689-3d4e-b133-953fd91b1f59",
                        "glosses": [
                            "Distraire (quelqu’un qui s’embêtait)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19e2f1cc-e5a3-41e4-a9e2-4d039a12d028",
                                "sense_id": "798c04d7-fc57-3c13-923d-d0c89e74f643",
                                "text": "Ô Plumet fils ! qui avez inventé la désinfection de la merde, donnez-moi un acide quelconque pour désembêter l’âme humaine."
                            },
                            {
                                "example_id": "bf19f250-d5fc-4254-ba60-32ad6ef15592",
                                "sense_id": "798c04d7-fc57-3c13-923d-d0c89e74f643",
                                "text": "Détrister, désérieuser, défutiliser, désembêter, décalcifier, délugubriser, déprévibiliser, dérigidifier… se poiler !"
                            },
                            {
                                "example_id": "10bafefa-3bb3-45f1-8b51-4a3254be87ba",
                                "sense_id": "798c04d7-fc57-3c13-923d-d0c89e74f643",
                                "text": "Voilà j'espère que je viens de te désembêter 10 secondes…"
                            }
                        ]
                    }
