                "senses": [
                    {
                        "sense_id": "5781acad-c95c-312e-ad3a-9b4e2dea2451",
                        "entry_id": "80a36474-9e57-3a7c-a7e9-aa658b63edfe",
                        "glosses": [
                            "Celui qui cultive ou emploie le patois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ff69801-b5a6-4baf-bbc5-4422594d4402",
                                "sense_id": "5781acad-c95c-312e-ad3a-9b4e2dea2451",
                                "text": "C’est plus qu’un patoisant ; mais ce n’est pas un romanisant ni par l’inspiration, ni par la forme."
                            },
                            {
                                "example_id": "13822ac3-97a4-4724-9877-cb64f826165b",
                                "sense_id": "5781acad-c95c-312e-ad3a-9b4e2dea2451",
                                "text": "Le « patois de Lille » tient une grande place dans l’œuvre littéraire de Simons, qui a aussi écrit, fort bien, en français. Cette expression figure dans les titres de quatre recueils. Était-il un patoisant comme les autres ?"
                            }
                        ]
                    }
