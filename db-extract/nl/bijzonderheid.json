                "senses": [
                    {
                        "sense_id": "010f2cb4-f3d8-3d28-9f13-35a19c3d075c",
                        "entry_id": "d0f4600e-f3c3-3800-808a-02622cc97cc0",
                        "glosses": [
                            "detail; klein onderdeel van het geheel dat toch de moeite waard is om gekend te worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2db549dc-5985-42d4-ad0a-ebc902176794",
                                "sense_id": "010f2cb4-f3d8-3d28-9f13-35a19c3d075c",
                                "text": "Dank aan de auteurs en uitgevers die overname toestonden (zie voor bijzonderheden 'Bronnen' aan het einde van het boek). De oorspronkelijke spelling hiervan is zoveel mogelijk gehandhaafd. Van enkele stukken bleken, tot onze spijt, auteur en uitgever niet te achterhalen."
                            }
                        ]
                    },
                    {
                        "sense_id": "7199938c-39cb-332e-9ebc-b28d661a91dc",
                        "entry_id": "d0f4600e-f3c3-3800-808a-02622cc97cc0",
                        "glosses": [
                            "uitzondering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18892612-7f58-4ee4-8525-fdbc3ddde287",
                                "sense_id": "7199938c-39cb-332e-9ebc-b28d661a91dc",
                                "text": "Deze man had toch wel een aantal aparte bijzonderheden."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f262705-462a-3364-ab9f-09a7919f06d9",
                        "entry_id": "d0f4600e-f3c3-3800-808a-02622cc97cc0",
                        "glosses": [
                            "kenmerkende eigenschap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c34b97f-c8d4-4821-8ea6-67d251ad68c9",
                                "sense_id": "6f262705-462a-3364-ab9f-09a7919f06d9",
                                "text": "Een geografische bijzonderheid van Litouwen is dat het middelpunt van Europa binnen de Litouwse grenzen ligt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "831b30fb-77bc-465a-a013-2458504bd720",
                        "source_entry_id": "d0f4600e-f3c3-3800-808a-02622cc97cc0",
