                ],
                "senses": [
                    {
                        "sense_id": "5a623fa4-35c5-37e7-a22e-850fcc61b151",
                        "entry_id": "fdddb69d-b115-3e3b-994e-960d1f6b73bb",
                        "glosses": [
                            "Wohnung, die jemandes privates Eigentum ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "414400df-3940-4a90-ad9c-dca1f2a6e910",
                                "sense_id": "5a623fa4-35c5-37e7-a22e-850fcc61b151",
                                "text": "Er wohnt in seiner eigenen Eigentumswohnung."
                            },
                            {
                                "example_id": "9eee7f14-17f7-4897-81f5-469adc1daeaa",
                                "sense_id": "5a623fa4-35c5-37e7-a22e-850fcc61b151",
                                "text": "„Zwar bringen auch neue, teure Eigentumswohnungen Bewegung in den Markt, weil die Käufer ihre alten, meist kleineren und günstigeren Wohnungen frei machen.“"
                            },
                            {
                                "example_id": "8cd733ee-74a9-4cce-a095-55694c1ccf42",
                                "sense_id": "5a623fa4-35c5-37e7-a22e-850fcc61b151",
                                "text": "„Ich habe keine Eigentumswohnung, keine lange Karriere und wenig Lebenserfahrung vorzuweisen.“"
                            },
                            {
                                "example_id": "ec7a52e8-3034-4dfe-be72-ad6b07026fff",
                                "sense_id": "5a623fa4-35c5-37e7-a22e-850fcc61b151",
                                "text": "„Die Quadratmeterpreise der Eigentumswohnungen beginnen hier bei 10000 Euro.“"
                            },
                            {
                                "example_id": "05eb3cc4-f016-4baf-814c-bce58cf86c55",
                                "sense_id": "5a623fa4-35c5-37e7-a22e-850fcc61b151",
                                "text": "„Die ausgebrannte Hülle meiner explodierten Eigentumswohnung ist schwarz wie das Weltall und verwüstet über den nächtlichen Lichtern der Stadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
