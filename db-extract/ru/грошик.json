                        "glosses": [
                            "уменьш. к грош"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6390f301-9d9d-44bc-bb26-d6a6f26a030f",
                                "sense_id": "9fa8894d-9429-3648-98a4-bf083b15f771",
                                "text": "Она входила в незнакомые дома, и никто не выгонял её, напротив, всяк-то приласкает и грошик даст."
                            },
                            {
                                "example_id": "7b7ddedc-bb0b-4eb8-8527-1f7c16dd75a3",
                                "sense_id": "9fa8894d-9429-3648-98a4-bf083b15f771",
                                "text": "Послушай, моя ненаглядная крошечка: деньги, что должна ты хозяину, у меня готовы, — скопил по грошикам да по копеечкам."
                            }
                        ]
                    }
