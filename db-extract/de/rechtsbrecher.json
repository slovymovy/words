                "senses": [
                    {
                        "sense_id": "d3d0b5c3-977f-3378-a997-359cc00830a0",
                        "entry_id": "feff6dd0-7010-305d-802a-e138bfce41e8",
                        "glosses": [
                            "(männliche^☆) Person, die das Recht gebrochen hat, die Rechtsbruch begangen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daa26377-4c93-413f-be1c-978843f11d90",
                                "sense_id": "d3d0b5c3-977f-3378-a997-359cc00830a0",
                                "text": "„Der österreichische Bombenattentäter Franz Fuchs wird vom Landesgericht Graz zu lebenslanger Haft verurteilt und in eine Anstalt für geistig abnorme Rechtsbrecher eingewiesen.“"
                            },
                            {
                                "example_id": "8683f8e7-a4ed-4e9d-86fc-bdb91dd84ea4",
                                "sense_id": "d3d0b5c3-977f-3378-a997-359cc00830a0",
                                "text": "„Aus seiner Naturrechtslehre leitete er das Recht eines jeden Menschen auf Leben, Freiheit und Eigentum ab. Um dieses Naturrecht vor Rechtsbrechern zu sichern, schlossen sich die Menschen auf freiwilliger Basis und vernunftgeleiteten Motiven zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
