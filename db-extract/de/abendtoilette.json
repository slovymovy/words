                        ],
                        "examples": [
                            {
                                "example_id": "03a20faa-3064-4110-91d0-57d9c708ed6e",
                                "sense_id": "2c1b3818-3b32-3507-a7a4-1d38a556d911",
                                "text": "„Während der Abendtoilette strömt das halbe Dorf zusammen und schaut den Fremden beim Waschen, Zähneputzen und Umkleiden zu, als wär’s eine spannende Filmvorführung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4a9ef7cc-4472-3a47-97f1-3bafcee97fda",
                        "entry_id": "2b607fe8-e2bc-33ac-9caf-4a0799dc5a39",
                        "glosses": [
                            "(festliche) Kleidung am Abend (für die Frau)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ff5c8dd-2666-4018-a0ae-058b861df47f",
                                "sense_id": "4a9ef7cc-4472-3a47-97f1-3bafcee97fda",
                                "text": "„Sie hatte wahrscheinlich den Abend in einem Theater verbracht, denn sie war in Abendtoilette, und ihre bloßen Schultern hatte sie in einen Theaterschal gehüllt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
