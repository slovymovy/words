                            },
                            {
                                "target_lang_word": "stimulus",
                                "target_lang_sense_clarification": "something that rouses activity or energy in someone"
                            },
                            {
                                "target_lang_word": "motivation",
                                "target_lang_sense_clarification": "the reason or reasons one has for acting or behaving in a particular way"
                            },
