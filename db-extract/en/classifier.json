                    },
                    {
                        "translation_id": "84146f29-b639-402d-867b-c950ea08feac",
                        "source_entry_id": "a8080813-e7fc-316d-8a8e-0daa1e176bf9",
                        "source_sense_description": "(linguistics) word or morpheme used to indicate a semantic class",
                        "target_lang_word": "Zählwort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zählwort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e23d8180-e642-3d1c-92b3-a2fd9b2e979b",
                                        "entry_id": "e5519721-f3b7-3b4e-a45d-6bd8b10d4f01",
                                        "glosses": [
                                            "Wort als Begriff für eine Zahl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "990e2834-7194-4f13-b71c-705f5f23ad19",
                                                "sense_id": "e23d8180-e642-3d1c-92b3-a2fd9b2e979b",
                                                "text": "„wenige“ ist ein unbestimmtes Zahlwort."
                                            },
                                            {
                                                "example_id": "770a5f7d-feb1-4a1c-bc5a-e559e9259dbb",
                                                "sense_id": "e23d8180-e642-3d1c-92b3-a2fd9b2e979b",
                                                "text": "„Die Merkmale, nach denen Hauptwort (Substantiv), Eigenschaftswort (Adjektiv), Fürwort (Pronomen), Zahlwort (Numerale), Tätigkeits- oder Zeitwort (Verbum), Umstandswort (Adverbium), Verhältniswort (Präposition) und Bindewort (Konjunktion) unterschieden werden, sind teils solche der Form, teils solche der Leistung.“"
                                            },
                                            {
                                                "example_id": "8e25aff3-721d-4e9b-983e-df4dd0278eaa",
                                                "sense_id": "e23d8180-e642-3d1c-92b3-a2fd9b2e979b",
                                                "text": "„Wer die Aussprachehürde genommen hat, wird als Nächstes von der Nachricht schockiert, dass es im Polnischen für Substantive, Adjektive, Pronomina und Zahlwörter ganze sieben Fälle gibt.“"
                                            },
                                            {
                                                "example_id": "6242425d-80ac-430f-ae39-e802f145b620",
                                                "sense_id": "e23d8180-e642-3d1c-92b3-a2fd9b2e979b",
                                                "text": "„Bei den Zahlwörtern spiegelt sich am deutlichsten der intensive Sprachkontakt mit dem Dänischen wider.“"
                                            },
                                            {
                                                "example_id": "3bee7512-76ed-45b7-881c-c93c589260fa",
                                                "sense_id": "e23d8180-e642-3d1c-92b3-a2fd9b2e979b",
                                                "text": "„Ein ganz anderer Problemfall sind Zahlwörter, die sich ja nach Belieben zusammensetzen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c21eab4c-86c7-4dd5-affc-79c74c08bf20",
