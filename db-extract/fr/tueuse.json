                                "target_senses": [
                                    {
                                        "sense_id": "6162137a-49ea-3484-91c0-342dcb74e621",
                                        "entry_id": "494bab4f-f00e-3820-bcd7-a7d61e6797db",
                                        "glosses": [
                                            "One who or that which kills."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaeef47c-98a1-4db9-9430-523d00643b77",
                                                "sense_id": "6162137a-49ea-3484-91c0-342dcb74e621",
                                                "text": "There’s a killer on the loose."
                                            },
                                            {
                                                "example_id": "1b4df9d8-3ce7-415e-952f-c8558e5989b3",
                                                "sense_id": "6162137a-49ea-3484-91c0-342dcb74e621",
                                                "text": "My cat is a habitual bird killer."
                                            },
                                            {
                                                "example_id": "f8d6ea44-276f-4a84-9f69-b45c6762ba80",
                                                "sense_id": "6162137a-49ea-3484-91c0-342dcb74e621",
                                                "text": "Carbon monoxide is a silent killer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a42b2e0b-0228-30ce-bab2-70fdecae9852",
                                        "entry_id": "494bab4f-f00e-3820-bcd7-a7d61e6797db",
                                        "glosses": [
                                            "That which causes stress or is extremely difficult, especially that which may cause failure at a task."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6555b880-a34a-48e3-94fc-91e97045995b",
                                                "sense_id": "a42b2e0b-0228-30ce-bab2-70fdecae9852",
                                                "text": "That test was a killer."
                                            },
                                            {
                                                "example_id": "6f823933-604a-442f-b736-b88da84b145a",
                                                "sense_id": "a42b2e0b-0228-30ce-bab2-70fdecae9852",
                                                "text": "The final hill in the race course was a killer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cccb4dba-9286-3ac4-a72f-9e337fb6f3c9",
                                        "entry_id": "494bab4f-f00e-3820-bcd7-a7d61e6797db",
                                        "glosses": [
                                            "Something that is so far ahead of its competition that it effectively kills off that competition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5c6cde0-913a-40c9-a1dc-ce97153f9f21",
                                                "sense_id": "cccb4dba-9286-3ac4-a72f-9e337fb6f3c9",
                                                "text": "Digital streaming platforms are CD killers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23712848-1304-3bbc-a44b-02c4c17d74b9",
                                        "entry_id": "494bab4f-f00e-3820-bcd7-a7d61e6797db",
                                        "glosses": [
                                            "A remarkably impressive person or thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bf25f14-a3bb-47d2-827a-7957c51b79cc",
                                                "sense_id": "23712848-1304-3bbc-a44b-02c4c17d74b9",
                                                "text": "Picture perfect, you don't need no filter / Gorgeous, make 'em drop dead, you're a killer"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05d159eb-5e54-3617-a5be-dd2f1b949791",
                                        "entry_id": "494bab4f-f00e-3820-bcd7-a7d61e6797db",
                                        "glosses": [
                                            "A knockout form of darts or pool involving several players."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6dcab22b-a5e6-3527-b89c-f6d0008417de",
                                        "entry_id": "494bab4f-f00e-3820-bcd7-a7d61e6797db",
                                        "glosses": [
                                            "Ellipsis of killer whale."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d09f6be-c455-4345-9308-ac766ff31245",
                                                "sense_id": "6dcab22b-a5e6-3527-b89c-f6d0008417de",
                                                "text": "There is, however, one species of whale that habitually preys upon other warm-blooded animals—the killer whale. Really a large dolphin, the killer was classified by Linnaeus as Orcinus orca, and by Cope as Grampus rectipinna."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54105eba-ad51-3c66-8faa-eebb08fabdb7",
                                        "entry_id": "494bab4f-f00e-3820-bcd7-a7d61e6797db",
                                        "glosses": [
                                            "A club used for killing fish."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e851e275-6b88-3fe1-ac00-96464179479a",
                                        "entry_id": "494bab4f-f00e-3820-bcd7-a7d61e6797db",
                                        "glosses": [
                                            "A particularly heavy type of handstamp, or portion of one, often obscuring a large part of the postage stamp."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9db9fdd5-78d4-3319-9762-61313060affe",
                                        "entry_id": "494bab4f-f00e-3820-bcd7-a7d61e6797db",
                                        "glosses": [
                                            "Synonym of virama (“kind of diacritical mark”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76c42185-c336-4919-9b80-8b8bb08f3caa",
                                                "sense_id": "9db9fdd5-78d4-3319-9762-61313060affe",
                                                "text": "In the course of its adaptation to non-Indo-Aryan languages, the Burmese script has acquired some features that distinguish it from other Indic scripts. The killer, or virama, participates in some common constructions that would be clumsy to handle the way they would be in the other Indic scripts, so the control function of the virama is separated from the diacritic function of the killer. The virama, 0F4D is used to form conjunct consonants, while the killer, 0F52, is a simple diacritic and has no effect on character shaping. The killer is also combined with the VOWEL SIGN O (0F4B) to form the low level tone vowel “o.” When used this way, this symbol is known as hyei hto, or “thrust forward.”"
                                            },
                                            {
                                                "example_id": "d4ce83dc-276b-45d5-97bc-6dffb6b15d0e",
                                                "sense_id": "9db9fdd5-78d4-3319-9762-61313060affe",
                                                "text": "For example, although the ‘vowel killer’ diacritic may be called a ‘pulli’ in Tamil, it is still referred to by the Unicode character names as a ‘virama’."
                                            },
                                            {
                                                "example_id": "2156d129-2660-4b27-8304-519155a70340",
                                                "sense_id": "9db9fdd5-78d4-3319-9762-61313060affe",
                                                "text": "Thai words that have been borrowed from Sanskrit, Pali and English usually try to retain as much of the original spelling as possible; as this will often produce pronunciations that are impossible or misleading, a ‘killer’ symbol is placed above the redundant consonant to indicate that it may be ignored"
                                            },
                                            {
                                                "example_id": "b58a4bdc-d4f4-48be-8d03-7573dacda3e3",
                                                "sense_id": "9db9fdd5-78d4-3319-9762-61313060affe",
                                                "text": "Sometimes the ‘killer’ sign, called kaaran in Thai, cancels out not only the consonant above which it appears, but also the one immediately preceding it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "killer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48214482-e0a6-3fd9-822e-96434a519cf2",
                                        "entry_id": "1f0488d3-f330-32f8-9f13-9bf40e8dcdd8",
                                        "glosses": [
                                            "Excellent, very good, cool."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "744f9df2-3e87-4cef-bae4-4531231922b7",
                                                "sense_id": "48214482-e0a6-3fd9-822e-96434a519cf2",
                                                "text": "killer feature"
                                            },
                                            {
                                                "example_id": "55c9ac16-b8fd-4713-8c24-6b2feaa80dff",
                                                "sense_id": "48214482-e0a6-3fd9-822e-96434a519cf2",
                                                "text": "killer view"
                                            },
                                            {
                                                "example_id": "c60c195d-4afb-48fc-b064-1b3f95db875a",
                                                "sense_id": "48214482-e0a6-3fd9-822e-96434a519cf2",
                                                "text": "It all says that Elephant's Memory is a killer band."
                                            },
                                            {
                                                "example_id": "c482e507-bc69-4120-a9dd-ce9dc0a2feb2",
                                                "sense_id": "48214482-e0a6-3fd9-822e-96434a519cf2",
                                                "text": "This is followed by a recipe for that very killer dish: \"Eat and remember this, the greediest of all Popes\" is their merry exhortation."
                                            },
                                            {
                                                "example_id": "6605f24f-4fa4-44d3-b79f-949f17a934c3",
                                                "sense_id": "48214482-e0a6-3fd9-822e-96434a519cf2",
                                                "text": "“Ahhh, Avery,” shouted the Yurtmeister after a full hour of intense volleyball. “That last serve was absolutely killer.”"
                                            },
                                            {
                                                "example_id": "f9a27384-3449-4751-9c3b-7f5e67fc1999",
                                                "sense_id": "48214482-e0a6-3fd9-822e-96434a519cf2",
                                                "text": "However, there is something very killer about drinking whatever battery acid and paint thinner concoction it is that they make malt liquor out of, in broad daylight, slumped down on the pavement"
                                            },
                                            {
                                                "example_id": "d64e9441-952a-4b5b-99b1-d3058bae91fb",
                                                "sense_id": "48214482-e0a6-3fd9-822e-96434a519cf2",
                                                "text": "That girl was dynamite. Dark hair with killer blue eyes, bronze skin, and an exquisite full-figured body."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0df9c342-196a-3b6e-8672-4abef67f7c2a",
                                        "entry_id": "1f0488d3-f330-32f8-9f13-9bf40e8dcdd8",
                                        "glosses": [
                                            "Causing death, destruction, or obliteration."
                                        ],
