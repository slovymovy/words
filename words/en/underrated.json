{
    "word_family": [
        "underrate",
        "underrating"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1ebbc747-267a-3c10-9ccb-6b7439ef9ae5",
                    "sense_definition": "Not given enough recognition or praise for its true quality or value.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is widely considered the most <w>underrated</w> player on the entire team.",
                            "target_lang_translations": {
                                "ru": "Его многие считают самым <w>недооценённым</w> игроком во всей команде."
                            }
                        },
                        {
                            "text": "This small town is an <w>underrated</w> destination for summer vacations.",
                            "target_lang_translations": {
                                "ru": "Этот маленький городок — <w>недооценённое</w> место для летнего отдыха."
                            }
                        }
                    ],
                    "synonyms": [
                        "underappreciated",
                        "undervalued"
                    ],
                    "antonyms": [
                        "overrated"
                    ],
                    "common_phrases": [
                        "highly underrated",
                        "severely underrated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не получивший должного признания или оценки, заслуживающий большего внимания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недооценённый",
                                "target_lang_sense_clarification": "общий термин для того, чья ценность или качество признаны не в полной мере"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c11dca5f-7844-3290-a48c-8238a8f7d270",
                    "sense_definition": "Simple past and past participle of <w>underrate</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critics <w>underrated</w> the film when it was first released.",
                            "target_lang_translations": {
                                "ru": "Критики <w>недооценили</w> фильм, когда он только вышел."
                            }
                        },
                        {
                            "text": "The importance of his contribution was <w>underrated</w> by the management.",
                            "target_lang_translations": {
                                "ru": "Важность его вклада была <w>недооценена</w> руководством."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «недооценивать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недооценил",
                                "target_lang_sense_clarification": "прошедшее время, мужской род"
                            },
                            {
                                "target_lang_word": "недооценённый",
                                "target_lang_sense_clarification": "краткое или полное причастие прошедшего времени"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}