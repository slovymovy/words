                        "sense_id": "cdde96b4-f626-3593-857c-c3fca76c12f6",
                        "entry_id": "9177f4c0-748e-3af5-a6a3-7e30c6f56376",
                        "glosses": [
                            "Crystal Meth"
                        ],
                        "tags": [
                            "colloquial",
