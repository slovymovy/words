                "senses": [
                    {
                        "sense_id": "9cf83110-59a5-37d3-a286-2c1b546cb977",
                        "entry_id": "bd7206c8-4f6f-3687-a565-be3e66e00709",
                        "glosses": [
                            "Being habitually clean, practising good hygiene."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "676533c3-6fe7-4611-a853-88b3b6475254",
                                "sense_id": "9cf83110-59a5-37d3-a286-2c1b546cb977",
                                "text": "I'l now lead you to an honeſt Ale-houſe, where we ſhall find a cleanly room, Lavender in the windowes, and twenty Ballads ſtuck about the wall; […]"
                            },
                            {
                                "example_id": "a571a5c4-a139-483a-bab9-9468b9995cf2",
                                "sense_id": "9cf83110-59a5-37d3-a286-2c1b546cb977",
                                "text": "[H]is lov'd partner boaſtful of her hoard,\nDiſplays the cleanly platter on the board; […]"
                            },
                            {
                                "example_id": "b27b64ff-df82-4853-b8cd-f64b8d5a0dd2",
                                "sense_id": "9cf83110-59a5-37d3-a286-2c1b546cb977",
                                "text": "There were some flat slabs of rock in the centre, with an excellent well close by, and there we sat in cleanly comfort while we made our first plans for the invasion of this new country."
                            }
                        ]
                    },
                    {
                        "sense_id": "afd596e0-0ef2-3a6c-928a-87e47dff7f17",
                        "entry_id": "bd7206c8-4f6f-3687-a565-be3e66e00709",
                        "glosses": [
                            "Cleansing; fitted to remove moisture; dirt, etc."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6e736c74-1afa-4d5a-931a-431bb8480106",
                                "sense_id": "afd596e0-0ef2-3a6c-928a-87e47dff7f17",
                                "text": "In our Fantaſtic Climes the Fair / With cleanly Powder dry their Hair: […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "3cd3cf55-a5aa-33cf-9345-e9bb80eb8fde",
                        "entry_id": "bd7206c8-4f6f-3687-a565-be3e66e00709",
                        "glosses": [
                            "Adroit; dexterous; artful."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "48ee18ab-0eae-489b-97b2-9bc287e5701c",
                                "sense_id": "3cd3cf55-a5aa-33cf-9345-e9bb80eb8fde",
                                "text": "Yet at the laſt (ſo well he him applyde,) / Through his fine handling, and cleanly play, / He all thoſe royall ſignes had ſtolne away, / And with the Foxes helpe them borne aſide, / Into a ſecret corner vneſpide."
                            }
                        ]
                    }
                ],
                "translations": [
