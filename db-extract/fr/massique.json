                        "cross_references": [
                            {
                                "target_word": "mass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea742ee8-9c07-3e45-9e26-b21054e023b8",
                                        "entry_id": "dd79d5ad-4d32-3c72-b4f5-8614a44c4427",
                                        "glosses": [
                                            "Matter, material.",
                                            "A quantity of matter cohering so as to make one body, or an aggregation of particles or things which collectively make one body or quantity, usually of considerable size."
                                        ],
                                        "tags": [
                                            "countable",
                                            "physical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e71db9f5-b263-4afd-b0fe-e9e03fa62ee1",
                                                "sense_id": "ea742ee8-9c07-3e45-9e26-b21054e023b8",
                                                "text": "And if it were not for theſe Principles the Bodies of the Earth, Planets, Comets, Sun, and all things in them would grow cold and freeze, and become inactive Maſſes ; […]."
                                            },
                                            {
                                                "example_id": "f552f432-f4e4-4692-9ab9-fbadfb5ffd4b",
                                                "sense_id": "ea742ee8-9c07-3e45-9e26-b21054e023b8",
                                                "text": "[…] and because a deep mass of continual sea is slower stirred to rage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41228c5a-3304-3c32-99ff-571e69c14a7b",
                                        "entry_id": "dd79d5ad-4d32-3c72-b4f5-8614a44c4427",
                                        "glosses": [
                                            "Matter, material.",
                                            "Precious metal, especially gold or silver."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "physical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c543c93-a267-4e8c-b35e-383de5752278",
                                                "sense_id": "41228c5a-3304-3c32-99ff-571e69c14a7b",
                                                "text": "Right in the midst the Goddesse selfe did stand / Upon an altar of some costly masse […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "421d06ea-68ae-357d-a793-774da21195ab",
                                        "entry_id": "dd79d5ad-4d32-3c72-b4f5-8614a44c4427",
                                        "glosses": [
                                            "Matter, material.",
                                            "A measure of the inertia of a mass of matter, one of four fundamental properties of matter. SI unit of mass: kilogram."
                                        ],
                                        "tags": [
                                            "countable",
                                            "physical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16d98c1b-ad67-3c48-8657-7c564047db88",
                                        "entry_id": "dd79d5ad-4d32-3c72-b4f5-8614a44c4427",
                                        "glosses": [
                                            "Matter, material.",
                                            "A medicinal substance made into a cohesive, homogeneous lump, of consistency suitable for making pills."
                                        ],
                                        "tags": [
                                            "countable",
                                            "physical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "add51b06-ddb3-4fbb-9c5b-f29c3709d799",
                                                "sense_id": "16d98c1b-ad67-3c48-8657-7c564047db88",
                                                "text": "blue mass"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcf19089-105e-37d5-b3fe-5aeb6418e910",
                                        "entry_id": "dd79d5ad-4d32-3c72-b4f5-8614a44c4427",
                                        "glosses": [
                                            "Matter, material.",
                                            "A palpable or visible abnormal globular structure; a tumor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "physical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fd95c89-9f71-3524-ae59-1036481fee6b",
                                        "entry_id": "dd79d5ad-4d32-3c72-b4f5-8614a44c4427",
                                        "glosses": [
                                            "Matter, material.",
                                            "Excess body mass, especially in the form of muscle hypertrophy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "physical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb43d486-5f18-4677-99d9-bcbb2c013d12",
                                                "sense_id": "6fd95c89-9f71-3524-ae59-1036481fee6b",
                                                "text": "After all, muscle maniacs go \"ga ga\" over mass no matter how it's presented."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d062c6f6-9823-3f21-be04-ef81dda189a3",
                                        "entry_id": "dd79d5ad-4d32-3c72-b4f5-8614a44c4427",
                                        "glosses": [
                                            "A large quantity; a sum."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "742df952-3ea6-4504-81a8-cadc630221c8",
                                                "sense_id": "d062c6f6-9823-3f21-be04-ef81dda189a3",
                                                "text": "[…]he hath discovered to me the way to five or six of the richest mines which the Spaniard hath, and whence all the mass of gold that comes into Spain in effect is drawn."
                                            },
                                            {
                                                "example_id": "9fdc72f6-a6a3-48f9-95c5-3472d4b6271d",
                                                "sense_id": "d062c6f6-9823-3f21-be04-ef81dda189a3",
                                                "text": "For though he had spent a huge mass of treasure in transporting his army, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c68f1ff9-da49-3aba-a7f2-e9ede47ffcb0",
                                        "entry_id": "dd79d5ad-4d32-3c72-b4f5-8614a44c4427",
                                        "glosses": [
                                            "A large quantity; a sum.",
                                            "Bulk; magnitude; body; size."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d0be9b2-67c3-454b-a26e-e3eded08df8a",
                                                "sense_id": "c68f1ff9-da49-3aba-a7f2-e9ede47ffcb0",
                                                "text": "Witness this army of such mass and charge / Led by a delicate and tender prince,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3146e9ef-51ff-3f58-a8c6-74f184015d9a",
                                        "entry_id": "dd79d5ad-4d32-3c72-b4f5-8614a44c4427",
                                        "glosses": [
                                            "A large quantity; a sum.",
                                            "The principal part; the main body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3a29104-8905-45a8-a57c-fc7c5926988f",
                                                "sense_id": "3146e9ef-51ff-3f58-a8c6-74f184015d9a",
                                                "text": "Night closed upon the pursuit, and aided the mass of the fugitives in their escape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f201fa5-b6db-3cbb-842b-a1341fffa122",
                                        "entry_id": "dd79d5ad-4d32-3c72-b4f5-8614a44c4427",
                                        "glosses": [
                                            "A large quantity; a sum.",
                                            "A large body of individuals, especially persons."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0580bcc3-bf43-4a1b-b278-daf8c3a41305",
                                                "sense_id": "3f201fa5-b6db-3cbb-842b-a1341fffa122",
                                                "text": "The mass of spectators didn't see the infraction on the field."
                                            },
                                            {
                                                "example_id": "e13a79c5-d39b-4192-af1f-dfe0bff92c83",
                                                "sense_id": "3f201fa5-b6db-3cbb-842b-a1341fffa122",
                                                "text": "A mass of ships converged on the beaches of Dunkirk."
                                            },
                                            {
                                                "example_id": "0faf1266-7c63-48f4-93c7-0a7eb1b44b27",
                                                "sense_id": "3f201fa5-b6db-3cbb-842b-a1341fffa122",
                                                "text": "Generals gathered in their masses / Just like witches at black masses"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbd3fe6e-060a-3def-9e31-08a9d74c58c2",
                                        "entry_id": "dd79d5ad-4d32-3c72-b4f5-8614a44c4427",
                                        "glosses": [
                                            "A large quantity; a sum.",
                                            "The lower classes of persons."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7178d4e4-34bb-457c-8b3e-ceb510c7d7ef",
                                                "sense_id": "fbd3fe6e-060a-3def-9e31-08a9d74c58c2",
                                                "text": "The masses are revolting."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ac46de7-c83a-38c1-b71a-ceccc3c80a3a",
                                        "entry_id": "02d33e0a-6e7d-38b9-a5e6-9e7b97b02155",
                                        "glosses": [
                                            "To form or collect into a mass; to form into a collective body; to assemble."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b19f3a3-f5f3-47f5-b9a9-dad105921f10",
                                                "sense_id": "5ac46de7-c83a-38c1-b71a-ceccc3c80a3a",
                                                "text": "They would unavoidably mix up the whole of these declarations, and mass them together, although the Judge might direct the Jury not to do so."
                                            },
                                            {
                                                "example_id": "f3ad80e5-517f-48ca-8beb-da7bd144f0bc",
                                                "sense_id": "5ac46de7-c83a-38c1-b71a-ceccc3c80a3a",
                                                "text": "Every bend on the hill had acted like a funnel to mass them together in this peculiar way."
                                            },
                                            {
                                                "example_id": "eb99f482-6acc-4795-bbce-8f475e5a7b92",
                                                "sense_id": "5ac46de7-c83a-38c1-b71a-ceccc3c80a3a",
                                                "text": "Where there is too great a repetition of forms, light and shade will break them up or mass them together."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5d8ef33-aede-3667-8155-001a333a14a6",
                                        "entry_id": "a873efda-8c3e-33ed-8c1e-c6912a81e6dc",
                                        "glosses": [
                                            "Involving a mass of things; concerning a large quantity or number."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40df0603-36b8-405b-b402-a0dfbdec13a6",
                                                "sense_id": "d5d8ef33-aede-3667-8155-001a333a14a6",
                                                "text": "There is evidence of mass extinctions in the distant past."
                                            },
                                            {
                                                "example_id": "9a7a77de-176a-451d-b38e-b0e734907103",
                                                "sense_id": "d5d8ef33-aede-3667-8155-001a333a14a6",
                                                "text": "The national liberation movement had not yet developed to a sufficiently mass scale."
                                            },
                                            {
                                                "example_id": "5ed9b10b-b867-4d16-9f46-76ab641349f8",
                                                "sense_id": "d5d8ef33-aede-3667-8155-001a333a14a6",
                                                "text": "With perhaps unprecedented magnitude and clarity, Auschwitz brings theologians and philosophers face to face with the facts of suffering on an incredibly mass scale, with issues poignantly raised concerning the absence of divine intervention or the inadequacies of divine power or benevolence; […]."
                                            },
                                            {
                                                "example_id": "42807b54-43c1-47b8-b0fb-97e4149c7eee",
                                                "sense_id": "d5d8ef33-aede-3667-8155-001a333a14a6",
                                                "text": "The air arms did more than provide the warring nations with individual heroes, for their individual exploits occurred within the context of an increasingly mass aerial effort in a war of the masses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36762d47-f17d-3f10-b2b0-dc4dc2471ff3",
                                        "entry_id": "a873efda-8c3e-33ed-8c1e-c6912a81e6dc",
                                        "glosses": [
                                            "Involving a mass of people; of, for, or by the masses."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "085852cf-4834-4b43-8d59-c86a27412d10",
                                                "sense_id": "36762d47-f17d-3f10-b2b0-dc4dc2471ff3",
                                                "text": "Every agency is sold on use of mass media today — or at least, it thinks it is — and what can be \"masser\" than television?"
                                            },
                                            {
                                                "example_id": "86e5c954-1d76-4d39-b68a-979f11db5d1b",
                                                "sense_id": "36762d47-f17d-3f10-b2b0-dc4dc2471ff3",
                                                "text": "Mass unemployment resulted from the financial collapse."
                                            },
                                            {
                                                "example_id": "b636bab5-d415-436d-987f-4df2e12b346b",
                                                "sense_id": "36762d47-f17d-3f10-b2b0-dc4dc2471ff3",
                                                "text": "While agreeing with Bell on the unlikelihood that any fully mass — in the sense of atomized and alienated — society has ever existed,⁵ I believe that at any point in time, in any social system, some elements may be characterized as \"masses.\""
                                            },
                                            {
                                                "example_id": "2442e449-6ef4-40a6-9e9c-832a27f9ea5e",
                                                "sense_id": "36762d47-f17d-3f10-b2b0-dc4dc2471ff3",
                                                "text": "Undoubtedly this is the case; at least it is \"masser\" than in Pinchot's time."
                                            },
                                            {
                                                "example_id": "6291d60b-31f7-497b-bdd3-757cb456c7fa",
                                                "sense_id": "36762d47-f17d-3f10-b2b0-dc4dc2471ff3",
                                                "text": "But it also highlights the changes that have taken place in gay and AIDS activism, and the way that a formerly mass movement has been recast."
                                            },
                                            {
                                                "example_id": "95e5286e-b153-4b4c-902b-4552e05ca923",
                                                "sense_id": "36762d47-f17d-3f10-b2b0-dc4dc2471ff3",
                                                "text": "The director didn't make the images up; they're there, but in putting that one slice of gay life into the massest of mass media — the amoral promiscuity, the drug and alcohol abuse, the stereotyped flamboyance and campiness, the bitchy queeniness and flimsy values — something very dangerous happens […]"
                                            },
                                            {
                                                "example_id": "d4d4a4d0-4aec-40c3-a8f3-f5663cb77ea9",
                                                "sense_id": "36762d47-f17d-3f10-b2b0-dc4dc2471ff3",
                                                "text": "[…] if only because it promises the ‘massest’ of mass markets."
                                            },
                                            {
                                                "example_id": "28749075-3e33-4e18-a91b-e3626ed60776",
                                                "sense_id": "36762d47-f17d-3f10-b2b0-dc4dc2471ff3",
                                                "text": "Finally, in the past century, secular culture itself has undergone a transition from predominantly folk styles to an overwhelmingly mass culture, […]."
                                            },
                                            {
                                                "example_id": "9a689d20-0104-4733-9b43-64470ef35432",
                                                "sense_id": "36762d47-f17d-3f10-b2b0-dc4dc2471ff3",
                                                "text": "As a right, we come to expect it, and that happens through the mass media, the massest of which, by far, is television."
                                            },
                                            {
                                                "example_id": "0f683f6e-a4da-42d1-b1db-875ac8efb822",
                                                "sense_id": "36762d47-f17d-3f10-b2b0-dc4dc2471ff3",
                                                "text": "The writing has been on the wall that Americans’ support for mass deportation was subject to all kinds of caveats and provisos."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a57783e8-15b5-3135-afc0-1f27e4963a17",
                                        "entry_id": "b3a7f7c2-e857-3a6c-b27f-bb279c54b5b8",
