                },
                {
                    "sense_id": "17324bfc-7aa8-3835-a5b7-890f61d2a4b0",
                    "sense_definition": "odbijający światło wieloma migotliwymi punktami; połyskujący, mieniący się",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "blask",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aktorka założyła na bal suknię z <w>błyskotliwego</w> materiału, który mienił się w blasku reflektorów.",
                            "target_lang_translations": {
                                "en": "The actress wore a ballgown made of a <w>glittering</w> fabric that shimmered under the spotlights.",
                                "ru": "Актриса надела на бал платье из <w>блестящей</w> ткани, которая переливалась в свете софитов."
                            }
                        },
                        {
                            "text": "Świeży śnieg tworzył w porannym słońcu <w>błyskotliwą</w> taflę.",
                            "target_lang_translations": {
                                "en": "In the morning sun, the fresh snow formed a <w>sparkling</w> surface.",
                                "ru": "Свежий снег образовывал в утреннем солнце <w>искрящуюся</w> гладь."
                            }
                        }
