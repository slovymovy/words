                ],
                "senses": [
                    {
                        "sense_id": "e0d2e024-48ab-32aa-a08b-6f0cd6268f15",
                        "entry_id": "1fbceb19-1976-3a60-b070-7de7736d0b14",
                        "glosses": [
                            "Ritus, mit dem die Aufnahme des Menschen in die Welt der Erwachsenen vollzogen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30ff3511-6f3b-4e03-800f-5812204dc083",
                                "sense_id": "e0d2e024-48ab-32aa-a08b-6f0cd6268f15",
                                "text": "„In Hollywood gilt Obdachlosigkeit in der Anfangsphase geradezu als Initiationsritus.“"
                            },
                            {
                                "example_id": "4396a9e2-85b8-4bc6-b584-a8a452748982",
                                "sense_id": "e0d2e024-48ab-32aa-a08b-6f0cd6268f15",
                                "text": "„Bei den Initiationsriten wird auch um die Gnade und den Schutz der Geister gebetet.“"
                            },
                            {
                                "example_id": "7f65146f-edb6-466d-b2a1-29e9e074ce14",
                                "sense_id": "e0d2e024-48ab-32aa-a08b-6f0cd6268f15",
                                "text": "„Da die Firmung ‚kein autarkes und autonomes, also von der Taufe unabhängiges Sakrament ist‘, sondern ‚ein an der Taufe (= mit der Eucharistie zusammen Hauptsakrament) partizipierendes Nebensakrament‘, und da folglich die Firmung nur Sinn haben kann als ‚abschließende Phase des einen Initiationsritus‘, muss sie nach Küng auch vor der Zulassung zur Eucharistie, möglicherweise sogar in derselben Feier gespendet werden.“"
                            },
                            {
                                "example_id": "128ec8da-acc1-4880-9203-d15cc762dc9d",
                                "sense_id": "e0d2e024-48ab-32aa-a08b-6f0cd6268f15",
                                "text": "„Die gesellschaftlich vorgeschriebenen, häufig in einer langen Stammestradition stehenden Initiationsriten werden von den Betroffenen meist nicht nur mit gemischten Gefühlen, sondern mit großen Ängsten erwartet.“"
                            },
                            {
                                "example_id": "4c4fdba0-b31c-4953-8339-6cd0339aee7d",
                                "sense_id": "e0d2e024-48ab-32aa-a08b-6f0cd6268f15",
                                "text": "„Initiationsriten scheinen in unserer modernen Gesellschaft zu den Relikten vergangener Epochen zu gehören. Und doch begegnen sie uns auch in der Moderne in vielen gesellschaftlichen Bereichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
