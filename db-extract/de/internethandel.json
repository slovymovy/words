                "senses": [
                    {
                        "sense_id": "784228b6-b4f3-3739-9090-0f0f41529952",
                        "entry_id": "5a8980c4-a0a5-3b40-b708-f3dc37b86fac",
                        "glosses": [
                            "digitaler Kauf oder Verkauf von Waren und Dienstleistungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e42c0a91-569a-4603-abe1-c86cdac0a756",
                                "sense_id": "784228b6-b4f3-3739-9090-0f0f41529952",
                                "text": "„Mit Fleiß und Sachverstand macht er Wirecard im Boom des Internethandels zu einem international agierenden Technologieunternehmen, dessen Aktien heute im Elitesegment der Deutschen Börse notiert werden.“"
                            },
                            {
                                "example_id": "050a94e7-a9cc-4b36-9995-bec6225ef423",
                                "sense_id": "784228b6-b4f3-3739-9090-0f0f41529952",
                                "text": "„Insgesamt profitiert die Post schon jetzt stark von der durch den Boom des Internethandels ausgelösten Paketflut in Deutschland.“"
                            },
                            {
                                "example_id": "677ad9cd-2f0d-4e9a-a973-798451f1cf71",
                                "sense_id": "784228b6-b4f3-3739-9090-0f0f41529952",
                                "text": "„Nicht zufällig ist der Preiskampf in den Branchen in den vergangenen Jahren besonders stark geworden, in denen der Internethandel schon eine große Rolle spielt.“"
                            },
                            {
                                "example_id": "52bd2b5c-e20b-47ef-b87d-b37e47fa809a",
                                "sense_id": "784228b6-b4f3-3739-9090-0f0f41529952",
                                "text": "„Nach Prognosen des Marktforschers Forrester Research wird der Internethandel im November und Dezember gegenüber dem Vorjahr um acht Prozent zulegen, während die gesamten Einzelhandelsumsätze diversen Schätzungen zufolge im Vorjahresvergleich stagnieren oder sogar rückläufig sein könnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
