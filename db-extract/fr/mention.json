                                            {
                                                "example_id": "0847c45e-7004-4838-bd93-66ba565fad41",
                                                "sense_id": "08c7d9ac-9834-3178-a079-cf12d7b36903",
                                                "text": "Στα Όσκαρ έκαναν ιδιαίτερη μνεία στον συγκεκριμένο ηθοποιό (τον ανέφεραν επαινετικά)"
                                            }
                                        ]
                                    }
