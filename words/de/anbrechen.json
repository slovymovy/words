            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7165036d-b9f1-357f-9591-489b4c148f46",
                    "sense_definition": "von einem Zeitabschnitt oder einer Epoche: seinen Anfang nehmen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zeitlicher_anfang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ein neues Zeitalter voller Möglichkeiten <w>bricht</w> für unser Unternehmen <w>an</w>."
                        },
                        {
                            "text": "Als der Tag langsam <w>anbrach</w>, machten sich die Wanderer auf den Weg."
                        }
                    ],
                    "synonyms": [
                        "anfangen",
                        "beginnen"
                    ],
                    "antonyms": [
                        "enden"
                    ],
                    "common_phrases": [
                        "der Tag bricht an",
                        "eine neue Zeit bricht an"
                    ]
                },
                {
                    "sense_id": "197f4b09-3625-3fbe-a459-b52e91e49f1c",
                    "sense_definition": "eine Verpackung oder einen Vorrat öffnen und anfangen, davon zu verbrauchen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oeffnen_verbrauchen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir sollten zuerst die alte Milch trinken, bevor wir eine neue Packung <w>anbrechen</w>."
                        },
                        {
                            "text": "Er hat gestern Abend für seine Gäste eine teure Flasche Wein <w>angebrochen</w>."
                        }
                    ],
                    "synonyms": [
                        "öffnen"
                    ],
                    "antonyms": [
                        "wiederverschließen"
                    ],
                    "common_phrases": [
                        "eine neue Packung anbrechen",
                        "die letzte Flasche anbrechen"
                    ]
                },
                {
                    "sense_id": "0630fcd7-62ae-336c-bd5f-28d3fe2d26be",
                    "sense_definition": "einen Gegenstand oder Knochen teilweise brechen oder beschädigen, ohne ihn ganz zu trennen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beim Sturz mit dem Fahrrad hat sich die Sportlerin unglücklich das linke Wadenbein <w>angebrochen</w>."
                        },
                        {
                            "text": "Der schwere Ast wurde durch den starken Sturm nur <w>angebrochen</w> und hing herab."
                        }
                    ],
                    "synonyms": [
                        "abknicken",
                        "knicken"
                    ],
                    "common_phrases": [
                        "sich den Knochen anbrechen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7aa3ef9f-ce4b-3f5b-9048-a9c071985988",
                    "sense_definition": "das Beginnen oder Eintreten eines Zeitabschnitts; substantivierter Infinitiv von <w>anbrechen</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zeitlicher_anfang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Erst beim <w>Anbrechen</w> des Tages machte sich die Expedition auf den Weg durchs Gebirge."
                        },
                        {
                            "text": "Vor dem <w>Anbrechen</w> des harten Winters müssen die Tiere noch ausreichend Nahrung finden."
                        }
                    ],
                    "common_phrases": [
                        "bei Anbrechen des Tages",
                        "vor Anbrechen der Dunkelheit"
                    ]
                }
            ]
        }
