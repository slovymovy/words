                        "examples": [
                            {
                                "example_id": "7ba8e76e-9ec1-427e-b9a1-b2b714fbaefc",
                                "sense_id": "7e28a421-8a5d-3f02-b711-14089f7a61b6",
                                "text": "„Aalpuppen werden, mit einem Köder (Fisch oder Regenwürmer) bestückt, gewöhnlich bei leichtem Wind abends so in einem Gewässer ausgesetzt, dass sie auf ein übersichtliches Ufer oder eine Bucht zutreiben, wo sie am nächsten Tag eingesammelt werden. Sie sind daher nicht in Fließgewässern einsetzbar.“"
                            }
