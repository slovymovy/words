{
    "word_family": [
        "couching"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e7a41fe-534a-3373-acf7-c0cc258a6435",
                    "sense_definition": "An item of furniture, often upholstered, for the comfortable seating of more than one person; a sofa.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat on the <w>couch</w> to watch a movie.",
                            "target_lang_translations": {
                                "es": "Ella se sentó en el <w>sofá</w> para ver una película."
                            }
                        },
                        {
                            "text": "They bought a new <w>couch</w> for their living room.",
                            "target_lang_translations": {
                                "es": "Compraron un <w>sofá</w> nuevo para su sala de estar."
                            }
                        }
                    ],
                    "synonyms": [
                        "sofa",
                        "settee",
                        "divan",
                        "davenport"
                    ],
                    "common_phrases": [
                        "sit on couch"
                    ],
                    "target_lang_definitions": {
                        "es": "Mueble, a menudo tapizado, diseñado para que varias personas se sienten cómodamente; un sofá."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "sofá",
                                "target_lang_sense_clarification": "El término más común y general para un mueble de asiento para varias personas."
                            },
                            {
                                "target_lang_word": "sillón",
                                "target_lang_sense_clarification": "Se refiere a un asiento cómodo, a menudo con reposabrazos, aunque a veces se usa para sofás grandes."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c5f590d-ad0a-3992-85e0-160a2f6c9ee8",
                    "sense_definition": "Psychotherapy.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "psychology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent many years on the <w>couch</w> to understand his past.",
                            "target_lang_translations": {
                                "es": "Pasó muchos años en el <w>diván</w> para entender su pasado."
                            }
                        },
                        {
                            "text": "The patient discussed his feelings while lying on the <w>couch</w>.",
                            "target_lang_translations": {
                                "es": "El paciente discutió sus sentimientos mientras estaba tumbado en el <w>diván</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the couch"
                    ],
                    "target_lang_definitions": {
                        "es": "Psicoterapia; el diván donde se tumba el paciente."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "diván",
                                "target_lang_sense_clarification": "El mueble específico utilizado en el contexto del psicoanálisis."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a44dfd93-bf8b-362f-b618-73bf3661a868",
                    "sense_definition": "To lie down; to recline.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tired traveler decided to <w>couch</w> on the soft grass for a while.",
                            "target_lang_translations": {
                                "es": "El viajero cansado decidió <w>recostarse</w> en la hierba suave por un rato."
                            }
                        },
                        {
                            "text": "He likes to <w>couch</w> on the sofa after a long day.",
                            "target_lang_translations": {
                                "es": "Le gusta <w>tumbarse</w> en el sofá después de un largo día."
                            }
                        }
                    ],
                    "synonyms": [
                        "lie down",
                        "recline"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or dated sense."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Tumbarse o recostarse."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "tumbarse",
                                "target_lang_sense_clarification": "Acción de ponerse en posición horizontal."
                            },
                            {
                                "target_lang_word": "recostarse",
                                "target_lang_sense_clarification": "Acción de apoyarse o tumbarse de forma relajada."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a79d9ff7-0f5c-327c-beaa-c2a20d4f397a",
                    "sense_definition": "To phrase in a particular style; to use specific wording for.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criticism was <w>couched</w> in very polite language.",
                            "target_lang_translations": {
                                "es": "La crítica fue <w>expresada</w> en un lenguaje muy educado."
                            }
                        },
                        {
                            "text": "She <w>couched</w> her request as a simple suggestion.",
                            "target_lang_translations": {
                                "es": "Ella <w>formuló</w> su petición como una simple sugerencia."
                            }
                        }
                    ],
                    "synonyms": [
                        "phrase",
                        "express",
                        "explain",
                        "term"
                    ],
                    "common_phrases": [
                        "couched in terms"
                    ],
                    "target_lang_definitions": {
                        "es": "Expresar algo con un estilo o lenguaje particular."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "expresar",
                                "target_lang_sense_clarification": "Decir o manifestar algo con palabras."
                            },
                            {
                                "target_lang_word": "redactar",
                                "target_lang_sense_clarification": "Poner por escrito algo usando una forma o estilo específico."
                            },
                            {
                                "target_lang_word": "formular",
                                "target_lang_sense_clarification": "Expresar algo de manera precisa o técnica."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}