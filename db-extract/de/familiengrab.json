                ],
                "senses": [
                    {
                        "sense_id": "6cad99f4-038e-3d50-a9f7-3805399c4a5f",
                        "entry_id": "89dacdf4-dd91-3a65-873b-408a916a861f",
                        "glosses": [
                            "Grab, in dem mehrere Personen einer Familie bestattet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "505ccb8b-3df2-45fa-bbb2-981cbf491be4",
                                "sense_id": "6cad99f4-038e-3d50-a9f7-3805399c4a5f",
                                "text": "„Benedikt XVI. nutzt den dritten Tag seines Aufenthalts in Regensburg für persönliche Termine: So will er das Familiengrab […] besuchen.“"
                            },
                            {
                                "example_id": "a83b8862-764a-450b-b6fb-f1fc9e2ea685",
                                "sense_id": "6cad99f4-038e-3d50-a9f7-3805399c4a5f",
                                "text": "„Seine Asche sollte in einem Familiengrab neben seinen Eltern und Großeltern beigesetzt werden.“"
                            },
                            {
                                "example_id": "e9b75db7-4c35-4d80-8adc-da452731fa4b",
                                "sense_id": "6cad99f4-038e-3d50-a9f7-3805399c4a5f",
                                "text": "„[…] Brice wird im Familiengrab seiner Frau Hella bestattet.“"
                            },
                            {
                                "example_id": "5a7d9ad6-f342-4924-b59e-f9beafd15264",
                                "sense_id": "6cad99f4-038e-3d50-a9f7-3805399c4a5f",
                                "text": "„Am 30. Oktober 1975 starb Hertz im Alter von 88 Jahren in Berlin. Bestattet wurde er auf dem Friedhof Ohlsdorf in Hamburg im Familiengrab, wo auch sein Onkel Heinrich begraben liegt.“"
                            },
                            {
                                "example_id": "21905941-9144-4a26-b5ce-419b91948ac6",
                                "sense_id": "6cad99f4-038e-3d50-a9f7-3805399c4a5f",
                                "text": "„In Ohlsdorf findet der Altkanzler seine letzte Ruhestätte im Familiengrab neben seiner Frau Loki.“"
                            },
                            {
                                "example_id": "02f84226-75a4-4ed4-8ef5-c4a5a9d8a4c1",
                                "sense_id": "6cad99f4-038e-3d50-a9f7-3805399c4a5f",
                                "text": "„In Zeiten der Globalisierung […] sind die Menschen mobil, oft leben Familienangehörige weit von einander entfernt. Dadurch sind sie häufig nicht in der Lage, das Familiengrab zu pflegen.“"
                            },
                            {
                                "example_id": "d307cfd9-fd82-44a0-bdf1-49a504d243c5",
                                "sense_id": "6cad99f4-038e-3d50-a9f7-3805399c4a5f",
                                "text": "„Walter Keuschnig soll laut der Friedhofsverwaltung in Molzbichl sein Familiengrab verkleinern, um Platz für ein Einzelgrab zu schaffen, sonst droht die Auflösung der Grabstätte.“"
                            },
                            {
                                "example_id": "4ffc5e07-dc88-4c4f-a1c6-1181d2774237",
                                "sense_id": "6cad99f4-038e-3d50-a9f7-3805399c4a5f",
                                "text": "„Heute wurde Anton Esterhazy bereits zum dritten Mal umgebettet. Er wurde nun im Familiengrab in Fertöd in Ungarn neben seiner Frau begraben.“"
                            },
                            {
                                "example_id": "d221a7fc-a584-416a-aec6-41fbc9089b1d",
                                "sense_id": "6cad99f4-038e-3d50-a9f7-3805399c4a5f",
                                "text": "[Schlagzeile:] „Spanien – Gebeine Francos aus dem Mausoleum ins Familiengrab umgebettet“"
                            },
                            {
                                "example_id": "266c5622-3246-44cd-a284-4948c6da0ef7",
                                "sense_id": "6cad99f4-038e-3d50-a9f7-3805399c4a5f",
                                "text": "„Das Grab 19, sicher ein Familiengrab, ist aufwändiger gestaltet.“"
                            },
                            {
                                "example_id": "d69823d6-1a5b-4c2f-a5d9-0faf9929121e",
                                "sense_id": "6cad99f4-038e-3d50-a9f7-3805399c4a5f",
                                "text": "„Bestattungsriten finden meist im Haus des Verstorbenen statt, dabei spielt der buddhistische Hausaltar eine Rolle. Die Urne kommt dann üblicherweise in ein Familiengrab auf dem Gelände eines buddhistischen Tempels.“"
                            },
                            {
                                "example_id": "ce6557ad-9ae8-4698-a161-aa26d0bf0cb0",
                                "sense_id": "6cad99f4-038e-3d50-a9f7-3805399c4a5f",
                                "text": "„Das Mausoleum wurde 1403 bis 1404 auf Befehl von Timur errichtet und war für seinen Lieblingsenkel Muhammad Sultan bestimmt. Später wurde es das Familiengrab der Timuriden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
