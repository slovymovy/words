                ],
                "senses": [
                    {
                        "sense_id": "e77c609a-98a7-3c95-9e36-7e2680cfb0f9",
                        "entry_id": "0058cb04-9d34-30a4-b072-1dd46b710036",
                        "glosses": [
                            "Courbe à la base ou en haut du fût de la colonne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daff2588-be68-4ca3-92b2-61d80baebeed",
                                "sense_id": "e77c609a-98a7-3c95-9e36-7e2680cfb0f9",
                                "text": "La colonne dorique grecque, sans base, est également dépourvue d’apophyge supérieure au raccordement avec son chapiteau."
                            },
                            {
                                "example_id": "2701d8ce-5f6e-461a-8666-9349916e5938",
                                "sense_id": "e77c609a-98a7-3c95-9e36-7e2680cfb0f9",
                                "text": "Gros quart de rond et listel pour l’apophyge."
                            },
                            {
                                "example_id": "4193ebdd-d794-4871-9575-6c8c79df3036",
                                "sense_id": "e77c609a-98a7-3c95-9e36-7e2680cfb0f9",
                                "text": "Les apophyges des colonnes sont terminées par une courbe convexe, et décorées d’espèces de triangles placés les uns dans les autres"
                            }
                        ]
                    },
                    {
                        "sense_id": "1174f50c-30c4-34d8-a074-6e9c43fc73d2",
                        "entry_id": "0058cb04-9d34-30a4-b072-1dd46b710036",
                        "glosses": [
                            "Grande virole fixée à l’extrémité d’une pièce de bois pour l’empêcher de se fendre."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d221f2cb-1ecd-4d1b-9a82-3417b2b0fb30",
                        "source_entry_id": "0058cb04-9d34-30a4-b072-1dd46b710036",
                        "source_sense_description": "Architecture",
                        "target_lang_word": "Ablauf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ablauf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "923c844e-87d0-34bb-85eb-cc6b2d7777bd",
                                        "entry_id": "c86f49bd-f428-3e8c-b3b6-d6a7008400f5",
                                        "glosses": [
                                            "Prozess, Abfolge"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f850df2-9494-4547-a516-603a5655662b",
                                                "sense_id": "923c844e-87d0-34bb-85eb-cc6b2d7777bd",
                                                "text": "Können Sie den vorgesehenen Ablauf noch einmal erklären?"
                                            },
                                            {
                                                "example_id": "69c0d5f7-4fbc-4eb8-8dbb-8aee73e5e686",
                                                "sense_id": "923c844e-87d0-34bb-85eb-cc6b2d7777bd",
                                                "text": "„Im Extremfall, so erläutert ein Schreiben des Stuttgarter Kultusministeriums vom 23. März 1982, könne die Duzerei Anlaß für die verwaltungsgerichtliche Auseinandersetzung über den formal korrekten Ablauf der Prüfung werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "73ed7fa6-0501-3d0a-a870-9c5d4d7a3015",
                                        "entry_id": "c86f49bd-f428-3e8c-b3b6-d6a7008400f5",
                                        "glosses": [
                                            "Wasserablauf, eine Vorrichtung zum Ablaufen von Flüssigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f06b1ac5-1254-4813-a4d8-aff4b52d8e04",
                                                "sense_id": "73ed7fa6-0501-3d0a-a870-9c5d4d7a3015",
                                                "text": "Durch diesen Ablauf kann das Regenwasser entweichen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "43784404-c48b-30ac-853b-f89f4fe9a9c1",
                                        "entry_id": "c86f49bd-f428-3e8c-b3b6-d6a7008400f5",
                                        "glosses": [
                                            "ein Verbindungsbauteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2532009-2d90-4db3-9a19-c6dd78d7de3a",
                                                "sense_id": "43784404-c48b-30ac-853b-f89f4fe9a9c1",
                                                "text": "„Im südlich anstoßenden ehemaligen Klostergebäude befindet sich eine Säule mit Würfelkapitell, dessen konkaver Ablauf ebenfalls auf das frühe 13. Jahrhundert weist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "63648814-1217-3aff-bbcd-23f55c3cf0a4",
                                        "entry_id": "c86f49bd-f428-3e8c-b3b6-d6a7008400f5",
                                        "glosses": [
                                            "Beendigung einer Zeitspanne, zu Ende gehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c1f1440-630c-4b45-9ced-be68c5b5efca",
                                                "sense_id": "63648814-1217-3aff-bbcd-23f55c3cf0a4",
                                                "text": "Nach Ablauf der Frist muss das Geld bezahlt sein."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e67253c3-13ca-4bf8-9472-978698ae3c0b",
                        "source_entry_id": "0058cb04-9d34-30a4-b072-1dd46b710036",
                        "source_sense_description": "Architecture",
                        "target_lang_word": "Anlauf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anlauf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7474f7f9-b0f0-39c4-a8d7-48d96c61a47f",
                                        "entry_id": "7e46836c-5142-3b91-9b17-a5dbce09c936",
                                        "glosses": [
                                            "das Laufen vor einem Sprung oder Stoß, um Schwung zu holen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12e14f83-8237-41bf-bc35-568aba751a55",
                                                "sense_id": "7474f7f9-b0f0-39c4-a8d7-48d96c61a47f",
                                                "text": "Wenn du ein bisschen mehr Anlauf nimmst, kannst du weiter springen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9a01fbe0-f0d5-328b-926d-0a9d3ff7b278",
                                        "entry_id": "7e46836c-5142-3b91-9b17-a5dbce09c936",
                                        "glosses": [
                                            "Versuch"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d46c5b5-eff1-4f10-9af3-f919c8d9b1b4",
                                                "sense_id": "9a01fbe0-f0d5-328b-926d-0a9d3ff7b278",
                                                "text": "Er hat es sofort beim ersten Anlauf geschafft."
                                            },
                                            {
                                                "example_id": "560dba9c-8293-4ef8-abd2-eb564a85bf89",
                                                "sense_id": "9a01fbe0-f0d5-328b-926d-0a9d3ff7b278",
                                                "text": "„Nun hat es doch geklappt: Friedrich Merz ist im zweiten Anlauf zum Bundeskanzler gewählt worden.“"
                                            },
                                            {
                                                "example_id": "9d06c92b-5c43-4149-a29c-75ce89138d02",
                                                "sense_id": "9a01fbe0-f0d5-328b-926d-0a9d3ff7b278",
                                                "text": "„Nachdem in mehreren Anläufen die zweifelsfrei höchste Stelle des Kibo ermittelt werden konnte, kommt es am 6. Oktober 1889 endlich und ohne weitere Umstände zur Erstbesteigung der höchsten Erhebung des Kilimandscharo-Massivs durch Meyer und Putscheller.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "72b7ad03-7c9f-3b7f-901c-172d9f83ae65",
                                        "entry_id": "7e46836c-5142-3b91-9b17-a5dbce09c936",
                                        "glosses": [
                                            "„Verbindungsglied zwischen einer waagerechten Platte und einer Wand in der Architektur“"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0d1b2847-5444-35f0-9480-a5f29484ecc1",
                                        "entry_id": "7e46836c-5142-3b91-9b17-a5dbce09c936",
                                        "glosses": [
                                            "das Anfahren eines Hafens"
                                        ],
                                        "tags": [
                                            "Schifffahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3090537d-1dea-475c-afd6-9eb2c8dc8ecd",
                                                "sense_id": "0d1b2847-5444-35f0-9480-a5f29484ecc1",
                                                "text": "„Neben den reinen Liegeplatzgebühren addieren sich andere Gebühren und Dienstleistungen für einen Anlauf zu einer Gesamtkalkulation.“"
                                            },
                                            {
                                                "example_id": "11c795c4-0c8a-48e0-9bf8-8065935d3ea0",
                                                "sense_id": "0d1b2847-5444-35f0-9480-a5f29484ecc1",
                                                "text": "„Anlässlich des 100. Anlaufs eines MSC-Kreuzfahrtschiffes in Hamburg, kam der Chef selbst nach Hamburg.“"
                                            },
                                            {
                                                "example_id": "b3549b79-2399-4db5-900e-c25f841ef1b4",
                                                "sense_id": "0d1b2847-5444-35f0-9480-a5f29484ecc1",
                                                "text": "„Nach dem ersten Anlauf stach das 293 Meter lange und für 3223 Passagiere sowie 1000 Besatzungsmitglieder ausgelegte Schiff abends zur zwölftägigen Ostsee- und Baltikumreise in See.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "01df44ec-d63c-30c8-aec1-323f03d640bc",
                                        "entry_id": "7e46836c-5142-3b91-9b17-a5dbce09c936",
                                        "glosses": [
                                            "„das langsame Steigern der Betriebsgeschwindigkeit einer Maschine“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d97fbc83-b7bd-4a71-9c1a-307c7877e92c",
                                                "sense_id": "01df44ec-d63c-30c8-aec1-323f03d640bc",
                                                "text": "„Wollte man den laufenden Motor mit dem beim Anlauf benutzten Sättigungsgrad dauernd arbeiten lassen, so verbrauchte die Erregung unverhältnismäßig viel Energie […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
