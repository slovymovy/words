    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "065e2115-f165-3e07-ac76-31c2a7850922",
                "word": "agnathic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e7a9c510-792b-340e-89cc-0205748c3150",
                        "entry_id": "065e2115-f165-3e07-ac76-31c2a7850922",
                        "glosses": [
                            "Jawless."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "111fa712-5a35-485b-96b8-95ec7ef111a8",
                                "sense_id": "e7a9c510-792b-340e-89cc-0205748c3150",
                                "text": "[…] the heads are inverted and agnathic (lacking a lower jaw) […]"
                            },
                            {
                                "example_id": "18587e47-02fc-4045-81a9-cc354d7200d6",
                                "sense_id": "e7a9c510-792b-340e-89cc-0205748c3150",
                                "text": "Mouth is without jaws (agnathic) in lampreys and hagfishes and bounded by jaws (gnathic) in all other vertebrates."
                            },
                            {
                                "example_id": "2f543a46-4306-46bd-8c5f-bc72982cd712",
                                "sense_id": "e7a9c510-792b-340e-89cc-0205748c3150",
                                "text": "Mortal combat and decapitation are suggested by the eight skillfully and gracefully engraved heads depicted here with their serrated necks, the prominent arrowheads, and the agnathic or jawless head regalia."
                            }
                        ]
                    },
                    {
                        "sense_id": "601af841-898c-322b-bf9c-20463ca0213e",
                        "entry_id": "065e2115-f165-3e07-ac76-31c2a7850922",
                        "glosses": [
                            "Afflicted by or characteristic of agnathia."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "45fde3aa-7a35-4c70-b42d-8264e3cbb44d",
                                "sense_id": "601af841-898c-322b-bf9c-20463ca0213e",
                                "text": "[…]an imperforate pharynx which existed in an agnathic lamb."
                            },
                            {
                                "example_id": "82189de6-9055-4b8e-b3ca-1876b9579bbc",
                                "sense_id": "601af841-898c-322b-bf9c-20463ca0213e",
                                "text": "In the mouth: various irregularities, such as wide separation of the teeth; abnormal development of the canines; the prognathic or agnathic jaw; high arching of the palate; cleft palate—all are found more frequently among persons otherwise degenerate than in normal individuals."
                            },
                            {
                                "example_id": "ab9247f7-42f1-40ed-ba73-978fad97ab6a",
                                "sense_id": "601af841-898c-322b-bf9c-20463ca0213e",
                                "text": "Most pregnancies with agnathic fetuses are associated with polyhydramnios, which probably result from fetal inability to swallow because of persistence of the oropharyngeal membrane."
                            }
                        ]
                    }
                ],
