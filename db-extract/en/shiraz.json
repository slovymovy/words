                    },
                    {
                        "sense_id": "e5281b16-b510-3ef6-8137-8ee7a2b1a9f7",
                        "entry_id": "3cf9c81f-7acc-3efe-babf-e49e6103660b",
                        "glosses": [
                            "A wine made from these grapes."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9efbd770-49dd-4673-b183-7139fa694f87",
                                "sense_id": "e5281b16-b510-3ef6-8137-8ee7a2b1a9f7",
                                "text": "Miss Arundel.—\"And drink his health in Shiraz wine.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dbc5aab-7465-482f-b872-465226e649ed",
                        "source_entry_id": "3cf9c81f-7acc-3efe-babf-e49e6103660b",
                        "source_sense_description": "variety of black grape",
                        "target_lang_word": "syrah",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syrah",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "67f22285-9ee3-3ccb-8f95-3ff717689770",
                                        "entry_id": "45574e9b-abc8-347b-b782-3d4fa3271615",
                                        "glosses": [
                                            "soort druif en de daarvan gemaakte wijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a61bd62f-382c-4f12-8c06-671bb31cfdca",
                                                "sense_id": "67f22285-9ee3-3ccb-8f95-3ff717689770",
                                                "text": ",,Proef deze eens, zegt Anne ondertussen, ,,Een l'Oppidum uit 2014, op basis van syrah en cinsault. Die moet je na één jaar drinken, dan ruik en proef je de volle frisheid van fruit."
                                            },
                                            {
                                                "example_id": "49185f36-fba2-455a-ac20-8529a2a305fc",
                                                "sense_id": "67f22285-9ee3-3ccb-8f95-3ff717689770",
                                                "text": "De rode Spaanse wijn komt van de Bodega van stervoetbal André Iniesta (FC Barcelona). De A.I.8 tinto uit Castilla la Mancha is een blend van tempranillo en syrah."
                                            },
                                            {
                                                "example_id": "e3d00646-d214-425d-84c3-17e7dcb8ad12",
                                                "sense_id": "67f22285-9ee3-3ccb-8f95-3ff717689770",
                                                "text": "De lijn bestaat uit twee watertjes zonder bubbels en twee met, in de smaken cabernet, merlot, syrah en petit verdot (de blauwe druiven voor rode wijn) en riesling en gewürztraminer (wit)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a76504a5-0bcd-4337-8282-c7721af6184b",
                        "source_entry_id": "3cf9c81f-7acc-3efe-babf-e49e6103660b",
                        "source_sense_description": "variety of black grape",
                        "target_lang_word": "syrah",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syrah",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62a0b17c-b4ba-326d-bec3-749e00488929",
                                        "entry_id": "e6026a95-690b-31ac-8647-8a8e72c0f52a",
                                        "glosses": [
                                            "Cépage originaire des côtes du Rhône, mais maintenant utilisée dans le monde entier. Il donne un raisin noir à peau fine et à la pruine abondante. Il est issu du croisement entre la mondeuse blanche et le dureza (cépage à raisin noir)."
                                        ],
                                        "tags": [
                                            "Viticulture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb13a545-c733-425e-9668-80275d4bcb24",
                                                "sense_id": "62a0b17c-b4ba-326d-bec3-749e00488929",
                                                "text": "Né d’une âpre syrah,\n D’un peu de carignan\n D’une terre solaire,\n Des mains d’un paysan,\n C’est avec ce vin là\n Qu’on dit qu’Ulysse a mis\n Le cyclope à genoux\n Et Circée dans son lit…"
                                            },
                                            {
                                                "example_id": "2a53c181-3a62-4a88-8a7e-15a2759a5a6b",
                                                "sense_id": "62a0b17c-b4ba-326d-bec3-749e00488929",
                                                "text": "Premier exportateur de denrées alimentaires du pays, l’Etat du Victoria est aussi l’une des principales terres vinicoles d’Australie, particulièrement réputée pour ses syrah, pinot noir et chardonnay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc75d131-9c88-3e93-b399-77d80c8483c7",
                                        "entry_id": "e6026a95-690b-31ac-8647-8a8e72c0f52a",
                                        "glosses": [
                                            "Vin tiré des raisins de ce cépage."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7911c6d8-ac02-4d80-9be0-eae951105fb1",
                                                "sense_id": "fc75d131-9c88-3e93-b399-77d80c8483c7",
                                                "text": "De même, le cahier des charges a été ouvert pour intégrer la syrah, adoptée habituellement dans le sud de la France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8b69c1f-fe9f-4b77-b1eb-a953a74a5c2a",
                        "source_entry_id": "3cf9c81f-7acc-3efe-babf-e49e6103660b",
