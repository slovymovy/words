                ],
                "senses": [
                    {
                        "sense_id": "0a9ce4a9-9ba8-3eda-a8fd-44ee3fc45fc1",
                        "entry_id": "8df94b82-80c6-3069-a091-769049113259",
                        "glosses": [
                            "das Versehen von etwas mit einem zackenartigen Rand"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1fb7c75a-d988-3003-83f2-2044e9977762",
                        "entry_id": "8df94b82-80c6-3069-a091-769049113259",
                        "glosses": [
                            "zackenartiger Rand von etwas; Zahnung"
                        ],
                        "tags": [
                            "vor allem Philatelie"
                        ],
                        "examples": [
                            {
                                "example_id": "f1e610c4-8958-4df2-9819-48e8665b1299",
                                "sense_id": "1fb7c75a-d988-3003-83f2-2044e9977762",
                                "text": "„Die eiförmigen, stumpfen bis leicht zugespitzten, 3–5 cm langen und 2–3 cm breiten Blätter mit keiner oder geringer Zähnung sind gegenständig angeordnet.“"
                            },
                            {
                                "example_id": "89f9be11-3e32-4f83-a02f-300adc3a23ff",
                                "sense_id": "1fb7c75a-d988-3003-83f2-2044e9977762",
                                "text": "„Silvius Magnago saß vornübergebeugt an seinem Schreibtisch und studierte die Zähnung einer Briefmarke.“"
                            },
                            {
                                "example_id": "41206302-ca91-4d0e-bf95-87742b9f1889",
                                "sense_id": "1fb7c75a-d988-3003-83f2-2044e9977762",
                                "text": "„Die jungen Blätter waren drei- bis fünflappig, die Bucht, wo der Stiel ansetzte, war herzförmig und die Zähnung unregelmäßig.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28d388e5-9cdf-4769-a25d-9ac0d9830323",
                        "source_entry_id": "8df94b82-80c6-3069-a091-769049113259",
                        "source_sense_id": "0a9ce4a9-9ba8-3eda-a8fd-44ee3fc45fc1",
                        "source_sense_description": "das Versehen von etwas mit einem zackenartigen Rand",
                        "target_lang_word": "dentelure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dentelure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34f01f28-d342-3500-9f68-145273151832",
                                        "entry_id": "d0dc3e5f-8104-3e0a-8f6d-80e008f883fd",
                                        "glosses": [
                                            "Bord dentelé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a28df47a-0945-4c5e-81b5-fae09d72674d",
                                                "sense_id": "34f01f28-d342-3500-9f68-145273151832",
                                                "text": "D'abord, lorsqu’on regarde en arrière, on aperçoit la dentelure des Alpes Bernoises, couronnées par la neige d’un éternel diadème d’argent."
                                            },
                                            {
                                                "example_id": "b767fe0a-d53c-4de7-8ae8-2875ad6f80f3",
                                                "sense_id": "34f01f28-d342-3500-9f68-145273151832",
                                                "text": "Bientôt après, les flèches de la cathédrale développèrent sur le ciel leurs dentelures de plus en plus distinctes."
                                            },
                                            {
                                                "example_id": "3b640c0a-23e7-44d8-a52a-52dfd5fdbd19",
                                                "sense_id": "34f01f28-d342-3500-9f68-145273151832",
                                                "text": "Je commençai par arracher d’un coup sec, trois pages du cahier : j’obtins ainsi les dentelures irrégulières que je désirais."
                                            },
                                            {
                                                "example_id": "7aa6827b-5464-49da-b78a-ce0dda64fad0",
                                                "sense_id": "34f01f28-d342-3500-9f68-145273151832",
                                                "text": "Faire des dentelures à un morceau de cuir, à une bande de linge."
                                            },
                                            {
                                                "example_id": "47977c9c-17a9-4162-963e-d45c7906fde0",
                                                "sense_id": "34f01f28-d342-3500-9f68-145273151832",
                                                "text": "— Les dentelures d’un muscle, d’un ligament."
                                            },
                                            {
                                                "example_id": "872252a5-6317-4c86-9534-5eef2bc2544d",
                                                "sense_id": "34f01f28-d342-3500-9f68-145273151832",
                                                "text": "— Les dentelures d’une feuille."
                                            },
                                            {
                                                "example_id": "c08aa9f6-ad32-454d-90ff-5e595a9f646d",
                                                "sense_id": "34f01f28-d342-3500-9f68-145273151832",
                                                "text": "Sous le microscope, nous remarquons, à part une diminution des feuilles de la tige qui sont deux fois plus longues chez la forme d’entrée que chez la forme des lampes, une différence très nette dans la dentelure des feuilles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23709409-5c31-49b1-901d-7b37f1ef417f",
                        "source_entry_id": "8df94b82-80c6-3069-a091-769049113259",
                        "source_sense_id": "1fb7c75a-d988-3003-83f2-2044e9977762",
