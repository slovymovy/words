                "word": "Stalinism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6996b5c1-d36f-4349-9163-ffc2ee1b71aa",
                        "entry_id": "8ae40890-c318-3d47-a933-cf12492db3f6",
                        "tags": [
                            "plural"
                        ],
                        "form": "Stalinisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "72a3b87c-b491-3302-96d8-c2630eeccd0d",
                        "entry_id": "8ae40890-c318-3d47-a933-cf12492db3f6",
                        "glosses": [
                            "The Communist philosophies espoused by Soviet leader Joseph Stalin."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9c1d7dfb-2e8a-3b2b-bd9d-0b178f490c7a",
                        "entry_id": "8ae40890-c318-3d47-a933-cf12492db3f6",
                        "glosses": [
                            "The act or state of living in accord with the communist philosophies of Stalin."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ddeb9ae2-91d9-3613-8a59-3645c73fef86",
                        "entry_id": "8ae40890-c318-3d47-a933-cf12492db3f6",
                        "glosses": [
                            "The political system that put into practice - by means of governance, implementing policies, enforcing laws, etc. - the communist philosophical theory of Stalin in the Soviet Union from the 1920s and in the Soviet satellite states from the late 1940s to Stalin's death in 1953."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "14595298-1454-49c9-a818-c011091d4383",
                                "sense_id": "ddeb9ae2-91d9-3613-8a59-3645c73fef86",
                                "text": "There are no crime[s] in history more terrible than the Moscow Trials of Zinoviev-Kamenev, and the- of Pyatakov-Radek. These trials developed not from communism, not from socialism, but from Stalinism: that is from the irresponsible despotism of the bureaucracy over the people."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b806352-9671-40e9-8c15-45d53a5cda46",
                        "source_entry_id": "8ae40890-c318-3d47-a933-cf12492db3f6",
                        "source_sense_description": "Communist philosophies espoused by Josef Stalin",
                        "target_lang_word": "stalinismus",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stalinismus",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "0e09d0c9-5503-3762-a1b9-252d9d51ecb8",
                                        "entry_id": "9aba66b7-3c3c-353f-b6d4-78d3c23d597e",
                                        "glosses": [
                                            "politická teorie a praxe založená Josifem Vissarionovičem Stalinem a uplatňovaná jeho následovníky založená na kontrole občanů, krajních represích včetně kádrových čistek či poprav a na osobní moci v diktátorském režimu s potlačenou demokracií, lidskými a občanskými svobodami"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1be06332-8391-4fa1-9838-62b3c4f305f4",
                        "source_entry_id": "8ae40890-c318-3d47-a933-cf12492db3f6",
                        "source_sense_description": "Communist philosophies espoused by Josef Stalin",
                        "target_lang_word": "stalinisme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stalinisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a2c51383-68fd-37ad-8af7-62f88dd9142f",
                                        "entry_id": "32e9b427-949d-3ccd-b8f2-e59917965df0",
                                        "glosses": [
                                            "variant van het marxisme-leninisme gekenmerkt door een totalitair nationalistisch communisme waarin alle macht geconcentreerd wordt bij een geadoreerde partijleider en meedogenloos geweld wordt gebruikt om iedere weerstand daartegen te breken\\nDe term kan ook worden gebruikt voor soortgelijke regimes als in Noord-Korea of van Pol Pot in Cambodja of in meer figuurlijke betekenis."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a94b960-fbfa-40f5-a919-da02284a9d9d",
                                                "sense_id": "a2c51383-68fd-37ad-8af7-62f88dd9142f",
                                                "text": "Dat komt onder meer omdat in het Rusland van president Vladimir Poetin veiligheidsdiensten en het leger een steeds belangrijkere rol zijn gaan spelen. Aandacht voor de misdaden en executies die deze instanties tijdens het stalinisme begingen, zou hun gezag ondermijnen."
                                            },
                                            {
                                                "example_id": "408d18b8-a97a-4e36-a94b-d049332d18b4",
                                                "sense_id": "a2c51383-68fd-37ad-8af7-62f88dd9142f",
                                                "text": "De Culturele Revolutie was zeker een extreme uiting: zij het niet van cultuurmarxisme maar van stalinisme, waaraan Mao met de Grote Sprong Voorwaarts ook schatplichtig was."
                                            },
                                            {
                                                "example_id": "20cb751c-8e8d-43db-bc0e-095af3e81a32",
                                                "sense_id": "a2c51383-68fd-37ad-8af7-62f88dd9142f",
                                                "text": "⧖ De partijpolitiek heeft in den loop der laatste jaren haar klasse-as verplaatst van de linkerzijde van het proletariaat, naar de rechterzijde — naar de kleine burgerij, van den arbeider naar den \"specialist\", van den strijder van beteekenis naar den partij-bureaucraat, van den boerearbeider [sic!] en den armen boer naar den koelak, van den werkman van Sjanghai naar Tsjang-kai-sjek, van den Chineeschen landman naar de burgerlijke officieren, van het Engelsche proletariaat naar den algemeenen raad der vakvereenigingen. enz. Dat is het wezen van het Stalinisme. Op het eerste gezicht, lijkt de Stalinistische strooming het te winnen. In werkelijkheid wordt de heele politiek van de centrumfractie gemaakt onder de slagen van een dubbelen knoet: van rechts en van links."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20e57b27-034f-430d-89c6-f044c5652a58",
                        "source_entry_id": "8ae40890-c318-3d47-a933-cf12492db3f6",
                        "source_sense_description": "Communist philosophies espoused by Josef Stalin",
                        "target_lang_word": "stalinisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stalinisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d103dbc5-b5d8-3645-911b-fba5db281ec5",
                                        "entry_id": "32fd9ea8-9993-3e75-9cce-69fc808b703c",
                                        "glosses": [
                                            "Politique autoritaire menée par Staline en Union soviétique, puis dans les pays satellites."
                                        ],
                                        "tags": [
                                            "Communisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bc5b6ae-5b85-4c0b-9fa6-6c20c1955873",
                                                "sense_id": "d103dbc5-b5d8-3645-911b-fba5db281ec5",
                                                "text": "En effet, Staline « n’est pas tombé de la Lune ». Staline et le stalinisme ne sont que les conséquences logiques d’une évolution préalable et préparatoire, elle-même résultat d’un terrible égarement, d’une déviation néfaste de la Révolution."
                                            },
                                            {
                                                "example_id": "f724bc69-2964-4c1c-beb3-7132384d3fe3",
                                                "sense_id": "d103dbc5-b5d8-3645-911b-fba5db281ec5",
                                                "text": "De même que Trotsky présentait hier correctement Hitler et Staline comme des « étoiles jumelles », la puissance essentielle du stalinisme et la chance essentielle de survie de l’impérialisme mondial résident précisément dans leur interaction, leurs rapports mutuels dans la conscience des masses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef62c24c-3b36-38fd-85db-4ce36cc48673",
                                        "entry_id": "32fd9ea8-9993-3e75-9cce-69fc808b703c",
                                        "glosses": [
                                            "Doctrine politique s’inspirant de Joseph Staline."
                                        ],
                                        "tags": [
                                            "Communisme"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1f98104-4dee-4298-acb2-77156dfd7c47",
                        "source_entry_id": "8ae40890-c318-3d47-a933-cf12492db3f6",
                        "source_sense_description": "Communist philosophies espoused by Josef Stalin",
                        "target_lang_word": "Stalinismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stalinismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0e7c552-2c60-3c76-95e3-dc3929f54328",
                                        "entry_id": "d3a8d551-afe8-37ed-a72d-56d3541598ad",
                                        "glosses": [
                                            "von Josef Stalin geprägte Ära und Form des Marxismus-Leninismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef1ab5a3-d985-4cf3-8326-7179055aa47f",
                                                "sense_id": "c0e7c552-2c60-3c76-95e3-dc3929f54328",
                                                "text": "„Die Ausreise über die im Stalinismus dicht geschlossene Grenze war zu einem Privileg geworden und sollte es im Wesentlichen bis in die späten achtziger Jahre hinein bleiben.“"
                                            },
                                            {
                                                "example_id": "95710e89-3e90-47f9-96ed-9fee390b8703",
                                                "sense_id": "c0e7c552-2c60-3c76-95e3-dc3929f54328",
                                                "text": "„In der Ersten Republik war er einer der Mitbegründer der Kommunistischen Partei, und er hat lange versucht, das Umkippen dieser Partei in den Stalinismus und die Moskauhörigkeit zu verhindern.“"
                                            },
                                            {
                                                "example_id": "39585fca-2eca-464d-bf2f-77af6ed72bb6",
                                                "sense_id": "c0e7c552-2c60-3c76-95e3-dc3929f54328",
                                                "text": "„Sie benannten früh die Verbrechen des Stalinismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
