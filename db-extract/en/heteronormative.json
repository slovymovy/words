                                        "glosses": [
                                            "einer von Heterosexualität und einem binären Geschlechterverständnis geprägten Norm entsprechend"
                                        ],
                                        "tags": [
                                            "oft abwertend"
                                        ],
                                        "examples": [
                                            {
