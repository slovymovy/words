            {
                "entry_id": "23352324-79be-3d39-8021-5750f72b2516",
                "word": "pantheism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2d518880-1b66-434c-8b7a-23e156c417da",
                        "entry_id": "23352324-79be-3d39-8021-5750f72b2516",
                        "tags": [
                            "plural"
                        ],
                        "form": "pantheisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9990c02a-29b8-3413-ab94-9b77f7b71056",
                        "entry_id": "23352324-79be-3d39-8021-5750f72b2516",
                        "glosses": [
                            "The belief that the Universe is in some sense divine and should be revered. Pantheism identifies the universe with God but denies any personality or transcendence of such a God."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3a4e6bee-3426-3b29-ba11-5e32e64a5fe8",
                        "entry_id": "23352324-79be-3d39-8021-5750f72b2516",
                        "glosses": [
                            "The belief in all gods; omnitheism."
                        ],
                        "tags": [
                            "countable",
                            "rare",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4664d5f-74d9-4d55-8b31-fef5910dba98",
                        "source_entry_id": "23352324-79be-3d39-8021-5750f72b2516",
                        "source_sense_description": "belief that the universe is divine",
                        "target_lang_word": "panteismus",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "panteismus",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "0c031916-ab56-3bd7-af0e-d5af9623ba61",
                                        "entry_id": "30444c23-3154-399e-81c5-225359df42f8",
                                        "glosses": [
                                            "víra nebo přesvědčení, že celý svět je božské povahy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35da37ff-940c-4ead-bfea-500da73c81d9",
                                                "sense_id": "0c031916-ab56-3bd7-af0e-d5af9623ba61",
                                                "text": "Imanence bez transcendence by totiž znamenala pád do panteismu a v posledním důsledku konec prazákladu svobody těch, kdo jsou stvořeni k obrazu vůči světu svrchovaně svobodného Boha Otce, Syna a Ducha Svatého, jak je to patrné v hegelianismu, byť se jeho původce tisíckrát zaklíná, že panteistou není."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42359302-dae5-4584-93c3-9a3a2168c27c",
                        "source_entry_id": "23352324-79be-3d39-8021-5750f72b2516",
                        "source_sense_description": "belief that the universe is divine",
                        "target_lang_word": "pantheïsme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
