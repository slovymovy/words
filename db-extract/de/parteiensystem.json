                "senses": [
                    {
                        "sense_id": "ae225f57-9d9e-32b3-ae76-c8d4e0a67a02",
                        "entry_id": "309d15ad-fa2d-3566-b75f-8bedf8657f1e",
                        "glosses": [
                            "System der politischen Parteien mit ihren Eigenschaften und Beziehungen untereinander in einem Staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef05b086-1c58-44b3-b450-351d20ffafaa",
                                "sense_id": "ae225f57-9d9e-32b3-ae76-c8d4e0a67a02",
                                "text": "„In einem Parteiensystem, in dem fünf oder sechs Parteien in die Parlamente gelangen, sollten möglichst alle beteiligten Demokraten wenigstens prinzipiell bereit sein, miteinander zu koalieren.“"
                            },
                            {
                                "example_id": "aebadc87-9fbc-45a7-979a-f67780292cb6",
                                "sense_id": "ae225f57-9d9e-32b3-ae76-c8d4e0a67a02",
                                "text": "„Als Fazit bleibt auf jeden Fall, dass das deutsche Parteiensystem durch die Zwangsfusion gespalten wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
