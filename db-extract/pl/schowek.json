                                    {
                                        "sense_id": "135451af-6c58-31b0-a2a6-9b004f17d87d",
                                        "entry_id": "7a0f9b85-8d80-3a31-91c4-dd80bbcd10f5",
                                        "glosses": [
                                            "A collection, sometimes hidden; a reserve."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0db20cce-bfb9-4da6-975b-0a52c6b2229c",
                                                "sense_id": "135451af-6c58-31b0-a2a6-9b004f17d87d",
                                                "text": "They had quite a stash of food saved up for emergencies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20574faf-744d-3088-89c7-8b3610d358e3",
                                        "entry_id": "7a0f9b85-8d80-3a31-91c4-dd80bbcd10f5",
                                        "glosses": [
                                            "A place where drugs are stored."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "informal",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d713044f-3333-47f7-9184-24019d361b77",
                                                "sense_id": "20574faf-744d-3088-89c7-8b3610d358e3",
                                                "text": "The dealers managed to store the dope in the stash just in time to avoid being caught by the police."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71c4fd60-c91f-35e7-b1d1-cfa5dfe8f498",
                                        "entry_id": "7a0f9b85-8d80-3a31-91c4-dd80bbcd10f5",
                                        "glosses": [
                                            "Clothing or other items branded with a particular university club or society's logo."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7eda5e6b-43bd-4faf-97e4-0207f0a614f7",
                                                "sense_id": "71c4fd60-c91f-35e7-b1d1-cfa5dfe8f498",
                                                "text": "We've now ordered stash for everyone who said they wanted some."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92cd55c5-15ff-3405-9237-cf0bddd25a0f",
                                        "entry_id": "7a0f9b85-8d80-3a31-91c4-dd80bbcd10f5",
                                        "glosses": [
                                            "A collection of yarn or other materials not yet allocated to any particular craft project."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38cf4c60-65b3-4f33-806b-62ceaf244f47",
                                                "sense_id": "92cd55c5-15ff-3405-9237-cf0bddd25a0f",
                                                "text": "My stash is mostly unfinished objects on the needles. I have one bag of yarn that I bought to make a coat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35107e4a-6a6a-3fa7-a66e-62a3cfbb4573",
                                        "entry_id": "eabf982a-33c0-3e68-a2f3-5a81d38ff328",
                                        "glosses": [
                                            "To hide or store away for later use."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83fa6c9c-806d-4030-9eec-78ddc4016aeb",
                                                "sense_id": "35107e4a-6a6a-3fa7-a66e-62a3cfbb4573",
                                                "text": "He stashed his liquor in the cabinet under the bar."
                                            },
                                            {
                                                "example_id": "b2a66d29-3a36-4b41-b923-4896a595f153",
                                                "sense_id": "35107e4a-6a6a-3fa7-a66e-62a3cfbb4573",
                                                "text": "“Landlord,” said I, “tell him to stash his tomahawk there, or pipe, or whatever you call it; tell him to stop smoking, in short, and I will turn in with him."
                                            },
                                            {
                                                "example_id": "f6cc467b-b69a-482d-b7be-22810c73fdc1",
                                                "sense_id": "35107e4a-6a6a-3fa7-a66e-62a3cfbb4573",
                                                "text": "All of the Do The Right Thing characters who are caught up in the quagmire of racial politics are male, while the women in the movie […] are all safely stashed away in their domestic spaces."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a61023e7-7601-3370-b40e-e77c6fd960ca",
                                        "entry_id": "9b770ac1-5480-3507-83ce-fdfcfc0ccb68",
                                        "glosses": [
                                            "A mustache."
                                        ],
                                        "tags": [
                                            "informal",
                                            "nonstandard",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fb0b42a-510b-4633-8a4e-960a9bf69862",
                        "source_entry_id": "9ad8e1fa-da31-3dc0-9c42-f8c0731ad48e",
                        "source_sense_id": "b4a6b797-fd77-363a-9af1-0272563ce764",
                        "target_lang_word": "Versteck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Versteck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "170c6082-3570-3dbc-9a31-c0db9eb2f3ff",
                                        "entry_id": "6f1b8dc4-300f-3eeb-87cc-ae81bbf8715f",
                                        "glosses": [
                                            "Ort, Stelle, wo man sich oder etwas vor anderen verbergen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deddf6a6-c5d1-4340-b930-95395619cedb",
                                                "sense_id": "170c6082-3570-3dbc-9a31-c0db9eb2f3ff",
                                                "text": "Die Kinder haben im Gebüsch ein Versteck."
                                            },
                                            {
                                                "example_id": "2e128d79-b079-4c31-9234-25b96edba5df",
                                                "sense_id": "170c6082-3570-3dbc-9a31-c0db9eb2f3ff",
                                                "text": "„Der einzige Mensch, der mich in meinem Versteck besucht, ist Berut.“"
                                            },
                                            {
                                                "example_id": "11609448-1964-48dc-8469-0d1330a74492",
                                                "sense_id": "170c6082-3570-3dbc-9a31-c0db9eb2f3ff",
                                                "text": "„Er kam die Stufen herunter und betrat den Gartenweg, der direkt zu meinem Versteck führte.“"
                                            },
                                            {
                                                "example_id": "47f9f8f5-7b7a-4833-b8f3-6601d06ec8ac",
                                                "sense_id": "170c6082-3570-3dbc-9a31-c0db9eb2f3ff",
                                                "text": "„Dann trat er aus seinem Versteck hervor und schritt rasch und geräuschlos die Treppe hinunter.“"
                                            },
                                            {
                                                "example_id": "fbcb197a-7044-41dc-9f25-f1c6f9eac396",
                                                "sense_id": "170c6082-3570-3dbc-9a31-c0db9eb2f3ff",
                                                "text": "„Aus seinen Fragen entnahm ich, daß er der Mann war, den ich in Handschellen hatte abführen sehen von meinem Versteck auf dem Dach aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f88e833e-c3ba-4ce4-95e1-4a07ae9d58b2",
                        "source_entry_id": "9ad8e1fa-da31-3dc0-9c42-f8c0731ad48e",
