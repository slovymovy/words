                    {
                        "translation_id": "42aa81fc-61d3-42cb-8f32-436541fe98bc",
                        "source_entry_id": "13d3c86e-de7c-3d9a-a35d-c32bcb2b50b3",
                        "source_sense_description": "Personne préposée à un bureau",
                        "target_lang_word": "estanquero",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "estanquero",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "cd0c0c10-ace2-3cab-9394-aa6e0802b6ab",
                                        "entry_id": "bc1e9cfa-ba64-3d44-8ef5-6c97bfe3938a",
                                        "glosses": [
                                            "Persona que tiene por oficio o profesión la atención de un estanco."
                                        ],
                                        "tags": [
                                            "adjective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0eb9590-849a-40c6-8f45-b324530f38ee",
                                                "sense_id": "cd0c0c10-ace2-3cab-9394-aa6e0802b6ab",
                                                "text": "Gastaba las horas de el día en esta forma: desde el alba hasta las nueve ejercitaba el oficio de distilador de aguas, que este título le había dado por que no llamasen aguardentero a quien tenía entrada y amistad con todos los oficiales mayores de el ejército; de las nueve a las once hacía mis empanadas y las vendía; y de las once a la una era visitador general de las cocinas ajenas, sobrestante de las ollas, reconocedor de las cazuelas, superintendente de los asadores y pesquisidor de los vinos; de la una a las tres era veedor de las dos mesas referidas, gracejo de sus dueños y ejecutor de sus despojos; y de las tres hasta ponerse el sol, merchante de quesos y estanquero de naipes."
                                            },
                                            {
                                                "example_id": "59df5b25-5f4a-4765-b773-7d0aaf51bde5",
                                                "sense_id": "cd0c0c10-ace2-3cab-9394-aa6e0802b6ab",
                                                "text": "Me imaginaba yo a la infeliz niña conformándose con aquel género de vida grosera, sin deseos ya de otra mejor; me la figuraba en trato familiar con la estanquera y la mujer del ambulante, comiendo con ellas y con toda aquella turba de gorrones de baja estofa que invadía la casa."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8e2addff-76bc-3be9-874e-8d0135902ae4",
                                        "entry_id": "bc1e9cfa-ba64-3d44-8ef5-6c97bfe3938a",
                                        "glosses": [
                                            "Partidario del monopolio real sobre el tabaco durante la colonia española."
                                        ],
                                        "tags": [
                                            "Cuba",
                                            "adjective",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36ce334f-f2c7-4cba-bdd5-b27629770b13",
                                                "sense_id": "8e2addff-76bc-3be9-874e-8d0135902ae4",
                                                "text": "800 a 900 vegueros habaneros destruyeron las estancias, vegas y fincas de los estanqueros —aquellos que accedían a vender de acuerdo con los precios fijados por la factoría."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "estanquero",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "cb447038-7e46-3726-8928-bd6c9e770ff6",
                                        "entry_id": "165799d0-25f1-3630-a16a-ffb6833ba225",
                                        "glosses": [
                                            "Persona que tiene por oficio o profesión cuidar de un estanque."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b88044ea-c6c1-4475-b36c-e4d4bddfbbcf",
                                                "sense_id": "cb447038-7e46-3726-8928-bd6c9e770ff6",
                                                "text": "Cristóbal Hernandez sirve de estanquero en el estanque grande que dizen de la mar de hontigola el qual tiene a su cargo la guarda y conservación."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
