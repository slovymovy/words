                "senses": [
                    {
                        "sense_id": "a693525c-5159-3414-9b5d-68b3009a5cce",
                        "entry_id": "ed0d59ff-576d-3bdf-9a49-91dc6d88b93f",
                        "glosses": [
                            "Arbeitsgruppe, die Filmaufnahmen macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39fff068-5220-489f-aaef-b32b6e545e3d",
                                "sense_id": "a693525c-5159-3414-9b5d-68b3009a5cce",
                                "text": "„Eine junge Kellnerin erzählte beispielsweise, wie sie kurz nach der Maueröffnung von einem Filmteam interviewt wurde.“"
                            },
                            {
                                "example_id": "bf8e5f6f-e68c-4e3e-ab8e-d18710d23d1d",
                                "sense_id": "a693525c-5159-3414-9b5d-68b3009a5cce",
                                "text": "„Mit ihr kam ihr Filmteam, und die Aufnahmen nutzte sie für einen Dokumentarfilm über Rinas Kindheit.“"
                            },
                            {
                                "example_id": "2cc56470-feeb-424a-9f9d-98f01ae1660a",
                                "sense_id": "a693525c-5159-3414-9b5d-68b3009a5cce",
                                "text": "„Filmteams geistern durch den Archipel, man filmt und fotografiert (mir genügt ein Fernglas).“"
                            },
                            {
                                "example_id": "3d884bc4-f1f0-4272-8a41-d9915c589ab7",
                                "sense_id": "a693525c-5159-3414-9b5d-68b3009a5cce",
                                "text": "„Fallada nimmt es hin, hat sich schon vorher mit dem Filmteam zerstritten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
