                ],
                "senses": [
                    {
                        "sense_id": "4f5919ec-0d2f-3e22-8fcc-6d1d88589bb5",
                        "entry_id": "092b37fb-9fe1-3246-88fd-300c45c95d1a",
                        "glosses": [
                            "Person, die in einem definierten Bereich die Verantwortung für den Brandschutz trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46588078-ceae-4fd1-8e40-eb8ffdbc6747",
                                "sense_id": "4f5919ec-0d2f-3e22-8fcc-6d1d88589bb5",
                                "text": "„Die Seminare richten sich an Brandschutzverantwortliche, Ingenieure und Architekten, Sicherheitsbeauftragte sowie Mitarbeiter von Behörden.“"
                            },
                            {
                                "example_id": "d929b1ed-2ef0-4fd0-8c1b-ab492dfb5c55",
                                "sense_id": "4f5919ec-0d2f-3e22-8fcc-6d1d88589bb5",
                                "text": "„Der Brandschutzverantwortliche kann seine Ziele am besten erreichen, wenn er die anerkannten Methoden des betrieblichen Managements für seinen Bereich anwendet.“"
                            },
                            {
                                "example_id": "4f15e64f-53f6-48dd-9d90-bde7e69d2147",
                                "sense_id": "4f5919ec-0d2f-3e22-8fcc-6d1d88589bb5",
                                "text": "„Grundsätzlich bietet sich für jeden Betrieb an, einen Brandschutzbeauftragten zu benennen, da nur selten davon ausgegangen werden kann, dass der Brandschutzverantwortliche eine entsprechende Fachkunde hat. Die Bestellung eines betrieblichen Brandschutzbeauftragten kann aber auch durch Dritte vorgegeben werden.“"
                            },
                            {
                                "example_id": "f51bd677-c79a-4019-9f79-01adb9d3aba2",
                                "sense_id": "4f5919ec-0d2f-3e22-8fcc-6d1d88589bb5",
                                "text": "„Die hier skizzierte Zielsetzung der Brandrisikominimierung richtet sich im Kern vor allem an Brandschutzverantwortliche in öffentlichen Einrichtungen wie etwa Krankenhäusern, Altenpflegeheimen, Schulen oder Kindertagesstätten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
