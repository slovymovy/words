                    {
                        "translation_id": "72f6ee5f-6c11-4862-98a1-720a99652e23",
                        "source_entry_id": "7f0550b6-456f-36ae-86f7-1a66c0eaee22",
                        "source_sense_description": "the Romani people",
                        "target_lang_word": "Roma",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Roma",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0c0715ee-427b-3180-b9fc-4253d70fcbd3",
                                        "entry_id": "2c9bf81d-9d9a-34cd-8b75-6cff30d1fa86",
                                        "glosses": [
                                            "de hoofdstad van het Romeinse Rijk, soms ook gepersonifieerd als godin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45e670e1-d23f-4253-817a-a598bb3f4300",
                                                "sense_id": "0c0715ee-427b-3180-b9fc-4253d70fcbd3",
                                                "text": "Hierop gebaseerd ontstond in Rome een ander type beeld, dat tijdens de Revolutie grote bekendheid kreeg: de triomferende Roma. De stad Rome werd weergegeven als een vrouw, net als Zeus in majestueuze houding gezeten op een troon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "575fa4b6-e591-3a64-9e12-d9e0f2eea01e",
                                        "entry_id": "2c9bf81d-9d9a-34cd-8b75-6cff30d1fa86",
                                        "glosses": [
                                            "de leiding van de rooms-katholieke kerk, de paus"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Roma",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6b96fcdd-73b3-380e-8427-2a5a08c8f6e4",
                                        "entry_id": "dc035d42-1719-37a3-be24-982a657f25dc",
                                        "glosses": [
                                            "meervoud van het zelfstandig naamwoord Rom"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72e5de66-f43c-3305-a620-e58502e364ce",
                                        "entry_id": "dc035d42-1719-37a3-be24-982a657f25dc",
                                        "glosses": [
                                            "volk in Europa en Azië dat traditioneel een zwervend bestaan leidt"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5ef2424-3e48-46dd-9a04-396276a95aee",
                                                "sense_id": "72e5de66-f43c-3305-a620-e58502e364ce",
                                                "text": "De Roma zijn in de meeste landen van Europa, maar ook in Amerika te vinden."
                                            },
                                            {
                                                "example_id": "d5ec15b9-4b3f-4b4c-919d-6646810f572e",
                                                "sense_id": "72e5de66-f43c-3305-a620-e58502e364ce",
                                                "text": "Volgens de aanklacht zijn Thaçi en de anderen verantwoordelijk voor de dood van bijna honderd mensen, onder wie Kosovaren, Albanezen, Serviërs en Roma."
                                            },
                                            {
                                                "example_id": "06cfba85-3f0c-4005-bb7a-d4489bd6b6e1",
                                                "sense_id": "72e5de66-f43c-3305-a620-e58502e364ce",
                                                "text": "Van de bijna 250 Sinti en Roma op het transport overleven dertig de concentratiekampen. Zoni Weisz ziet zijn familie nooit meer terug. Herinneringscentrum kamp Westerbork herdenkt zondag dat het zogenoemde zigeunertransport 75 jaar geleden vertrok."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Roma",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8c1591d0-df6b-3ea7-bfbd-c95e48cf814f",
                                        "entry_id": "d8e3a8a0-f06d-31a9-88a8-c30ef5acf65c",
                                        "glosses": [
                                            "behorend tot of betrekking hebbend op de Roma, een volk in Europa en Azië dat traditioneel een zwervend bestaan leidt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "708a0ac2-b002-4956-bfe3-644b5d115170",
                                                "sense_id": "8c1591d0-df6b-3ea7-bfbd-c95e48cf814f",
                                                "text": "De overige Roma en Sinti organisaties begeven zich vooral op lokaal terrein. De enige landelijke organisatie die wij nog noemen, is de Landelijke Stichting “Roma Emancipatie” te Oss. Deze stichting is in 1998 opgericht door een Roma vluchteling uit Macedonië."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2346a9b-5510-407b-b6a5-d870e13d11a1",
                        "source_entry_id": "7f0550b6-456f-36ae-86f7-1a66c0eaee22",
                        "source_sense_description": "the Romani people",
                        "target_lang_word": "Roma",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Roma",
