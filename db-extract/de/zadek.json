                "senses": [
                    {
                        "sense_id": "c4df75be-fc3a-3218-b69c-de8e526c9b24",
                        "entry_id": "532f7974-78d5-36b0-ac55-5bad8be74a5e",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c04e278-aa81-42a7-a273-62e70b3bd599",
                                "sense_id": "c4df75be-fc3a-3218-b69c-de8e526c9b24",
                                "text": "Frau Zadek ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "34318c8f-f4a0-432d-95ef-22df8b094247",
                                "sense_id": "c4df75be-fc3a-3218-b69c-de8e526c9b24",
                                "text": "Herr Zadek wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e79d3e25-2746-43a9-8866-08a38139bd76",
                                "sense_id": "c4df75be-fc3a-3218-b69c-de8e526c9b24",
                                "text": "Die Zadeks fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "c471e677-28e6-4f85-9b2f-641b1364fa15",
                                "sense_id": "c4df75be-fc3a-3218-b69c-de8e526c9b24",
                                "text": "Der Zadek trägt nie die Pullover, die die Zadek ihm strickt."
                            },
                            {
                                "example_id": "bdbc06f7-2cc9-4497-9946-a3ac2ce4dc43",
                                "sense_id": "c4df75be-fc3a-3218-b69c-de8e526c9b24",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zadek kommt, geht der Herr Zadek.“"
                            },
                            {
                                "example_id": "f51b9839-98e9-4d61-a712-309cc9b061b4",
                                "sense_id": "c4df75be-fc3a-3218-b69c-de8e526c9b24",
                                "text": "Zadek kommt und geht."
                            },
                            {
                                "example_id": "a37825d7-c5f0-4919-8e8d-a25ea9f11aa9",
                                "sense_id": "c4df75be-fc3a-3218-b69c-de8e526c9b24",
                                "text": "Zadeks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
