                    },
                    {
                        "sense_id": "4a610d81-1aea-3790-8ca2-85d7270cbb99",
                        "entry_id": "fe659032-f8f4-3e59-a874-fc07711ba8d5",
                        "glosses": [
                            "сделать больше чего-либо существующего или предполагаемого"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4f7949f1-db00-3bd9-8222-a05f68567ae9",
                        "entry_id": "fe659032-f8f4-3e59-a874-fc07711ba8d5",
                        "glosses": [
                            "неперех., разг. изучить, постичь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82bb1cae-dbe1-45f0-994d-c82d46861363",
                                "sense_id": "4f7949f1-db00-3bd9-8222-a05f68567ae9",
                                "text": "Надо будет написать дочери, вот она у меня превзошла все науки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63ca7945-d71f-4dbc-a042-20c146ca33b4",
                        "source_entry_id": "fe659032-f8f4-3e59-a874-fc07711ba8d5",
                        "source_sense_description": "обнаружить превосходство",
                        "target_lang_word": "surpasser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surpasser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6967c821-be4c-383e-a4da-65f07b9e5c60",
                                        "entry_id": "924adace-4a1d-3d09-bc5d-6763381c0190",
                                        "glosses": [
                                            "Excéder ; être plus haut, plus élevé ou plus gros."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83348098-1713-4d7f-a080-5951a359a330",
                                                "sense_id": "6967c821-be4c-383e-a4da-65f07b9e5c60",
                                                "text": "Les Emeraudes Occidentales sont ordinairement beaucoup plus grosses que les Orientales : on en trouve qui surpassent en largeur la paume de la main. On doit choisir les plus dures, les plus belles, & les plus resplendissantes."
                                            },
                                            {
                                                "example_id": "82e06359-0857-433d-9f4c-b0f61bf63e24",
                                                "sense_id": "6967c821-be4c-383e-a4da-65f07b9e5c60",
                                                "text": "Avec 2359 nouveaux cas de COVID-19 recensés samedi, l'Ontario surpasse pour une première fois le Québec en matière du nombre de cas déclarés depuis les débuts de la pandémie."
                                            },
                                            {
                                                "example_id": "353ecb2c-790a-4f35-9e0c-3a7f0d3fdebb",
                                                "sense_id": "6967c821-be4c-383e-a4da-65f07b9e5c60",
                                                "text": "Il est beaucoup plus grand que lui, il le surpasse de toute la tête. — Cet arbre surpassait en grosseur les plus vieux chênes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc2f27c1-7fe8-3da0-992e-2c9d4d6ca390",
                                        "entry_id": "924adace-4a1d-3d09-bc5d-6763381c0190",
                                        "glosses": [
                                            "être au-dessus de, surmonter en quelque chose ; il se dit en bien et en mal."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd4b1566-974b-4829-a8aa-8baa90e3cba4",
                                                "sense_id": "bc2f27c1-7fe8-3da0-992e-2c9d4d6ca390",
                                                "text": "Il les surpasse tous en science."
                                            },
                                            {
                                                "example_id": "08c8dba6-f5ae-4de3-8247-671b7388ef7f",
                                                "sense_id": "bc2f27c1-7fe8-3da0-992e-2c9d4d6ca390",
                                                "text": "Surpasser tous les autres en richesse, en vertu."
                                            },
                                            {
                                                "example_id": "45028556-6dbf-48e7-b355-19053568773e",
                                                "sense_id": "bc2f27c1-7fe8-3da0-992e-2c9d4d6ca390",
                                                "text": "Il surpasse ses camarades dans tous les sports."
                                            },
                                            {
                                                "example_id": "22436be5-2dc8-46a0-9ca7-fe7e515aa177",
                                                "sense_id": "bc2f27c1-7fe8-3da0-992e-2c9d4d6ca390",
                                                "text": "Il le surpasse en méchanceté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7414fb0-77b1-356c-adbf-0ddce729d752",
                                        "entry_id": "924adace-4a1d-3d09-bc5d-6763381c0190",
                                        "glosses": [
                                            "Excéder les forces, l’intelligence, les ressources."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "468dfbdb-99dd-4502-b55a-c7f4ef62e0e4",
                                                "sense_id": "a7414fb0-77b1-356c-adbf-0ddce729d752",
                                                "text": "Cet effort surpasse mon courage."
                                            },
                                            {
                                                "example_id": "7c9ce000-b410-4978-acd9-a36d551ee682",
                                                "sense_id": "a7414fb0-77b1-356c-adbf-0ddce729d752",
                                                "text": "Cette science surpasse mon esprit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7685307a-5451-358b-8243-dc4682d98c6c",
                                        "entry_id": "924adace-4a1d-3d09-bc5d-6763381c0190",
                                        "glosses": [
                                            "Causer un étonnement qui confond les idées."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef59a4bb-88f0-4432-9af7-1abf75611e9d",
                                                "sense_id": "7685307a-5451-358b-8243-dc4682d98c6c",
                                                "text": "Cela me surpasse. — On dit plutôt aujourd’hui, cela me dépasse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4214de88-09ad-32c4-a40f-4583216fc6dc",
                                        "entry_id": "924adace-4a1d-3d09-bc5d-6763381c0190",
                                        "glosses": [
                                            "Faire encore mieux qu’on ne fait à son ordinaire, ou qu’on n’a fait jusqu’à présent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cff8568-1a1b-4352-83d1-7e0ae7ca7dc6",
                                                "sense_id": "4214de88-09ad-32c4-a40f-4583216fc6dc",
                                                "text": "Cet acteur a joué tel rôle d’une manière admirable, il s’est surpassé lui-même, il s’est surpassé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f7b4ca1-a3fd-414b-ad55-75e41a43bb77",
