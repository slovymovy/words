                        "cross_references": [
                            {
                                "target_word": "Babylon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3618e44-e0e9-3cec-ba67-c005afe9896b",
                                        "entry_id": "5f8172f5-3d89-34ea-99ea-495a79ace5b6",
                                        "glosses": [
                                            "An ancient city, the ancient capital of Babylonia in modern Iraq, built on the banks of the Euphrates."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6793d67f-b0e8-4012-8628-0f11117abc13",
                                                "sense_id": "d3618e44-e0e9-3cec-ba67-c005afe9896b",
                                                "text": "Standing afarre off for the feare of her torment, saying, Alas, alas, that great citie Babylon, that mighty citie: for in one houre is thy iudgement come."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07d6ce2d-9424-3471-a7be-e7ce921f9533",
                                        "entry_id": "5f8172f5-3d89-34ea-99ea-495a79ace5b6",
                                        "glosses": [
                                            "A governate in Iraq."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5033133e-35d8-3e4a-81bc-6a6b2352d1db",
                                        "entry_id": "5f8172f5-3d89-34ea-99ea-495a79ace5b6",
                                        "glosses": [
                                            "Any city of great wealth, luxury and vice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb43436e-4538-4649-ace6-efe013da4aba",
                                                "sense_id": "5033133e-35d8-3e4a-81bc-6a6b2352d1db",
                                                "text": "Mother[…]considered that the exclusiveness of Peter's circle was due not to its distinction, but to the fact that it was an inner Babylon of prodigality and whoredom, from which every Kensingtonian held aloof, except on the conventional tip-and-run excursions in pursuit of shopping, tea and theatres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80cbc85e-70e4-3ca0-bcad-2d06f424884f",
                                        "entry_id": "5f8172f5-3d89-34ea-99ea-495a79ace5b6",
                                        "glosses": [
                                            "Western civilization, seen as corrupt and materialistic, and contrasted with Zion."
                                        ],
                                        "tags": [
                                            "Rastafari"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eeef6bd3-23a6-3d5c-9850-92006aedd6df",
                                        "entry_id": "5f8172f5-3d89-34ea-99ea-495a79ace5b6",
                                        "glosses": [
                                            "The police."
                                        ],
                                        "tags": [
                                            "Jamaica",
                                            "Multicultural-London-English"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "530a2c27-669a-46cc-a89a-5a1887d86f13",
                                                "sense_id": "eeef6bd3-23a6-3d5c-9850-92006aedd6df",
                                                "text": "When I was the first officer on the scene at a nightclub brawl, I was picked up by the throat and strangled by a huge Rastafarian who was trying to kill me. I was losing consciousness when Marlon told him to let me go.\nI remember him saying, ‘She’s alright for Babylon. Put her down.’ He dropped me and I ran to the station with massive bruises around my neck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08099f15-9ed7-3d20-b2b2-76f41fb379e6",
                                        "entry_id": "5f8172f5-3d89-34ea-99ea-495a79ace5b6",
                                        "glosses": [
                                            "An unincorporated community in Fulton County, Illinois, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "575f739f-dcdc-399b-a013-18a598da8f76",
                                        "entry_id": "5f8172f5-3d89-34ea-99ea-495a79ace5b6",
                                        "glosses": [
                                            "A town and village therein, in Suffolk County, Long Island, New York, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
