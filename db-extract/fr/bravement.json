        "fr-extract.jsonl": [
            {
                "entry_id": "53a4abd7-a1e5-3c66-978d-7cc108f0977a",
                "word": "bravement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e4634dfe-6cfb-3370-a225-fa0979897727",
                        "entry_id": "53a4abd7-a1e5-3c66-978d-7cc108f0977a",
                        "glosses": [
                            "D’une manière brave."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22d0792a-9327-49f3-82ec-48c8741dfd8a",
                                "sense_id": "e4634dfe-6cfb-3370-a225-fa0979897727",
                                "text": "Il entra donc bravement dans cette allée où on n'y voyait goutte et, en poussant jusqu'au bout, il finit par mettre le pied sur une marche déjetée et la main sur une rampe branlante."
                            }
                        ]
                    },
                    {
                        "sense_id": "d57e1bda-bc27-3553-9ad3-f6e72d926b0d",
                        "entry_id": "53a4abd7-a1e5-3c66-978d-7cc108f0977a",
                        "glosses": [
                            "D’une manière habile, adroite."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4dc3df20-1da3-4b18-8b6c-0f3f29cd2d05",
                                "sense_id": "d57e1bda-bc27-3553-9ad3-f6e72d926b0d",
                                "text": "Il joua bravement son personnage."
                            },
                            {
                                "example_id": "6d735588-f599-4edd-a0f2-446d4fcf021b",
                                "sense_id": "d57e1bda-bc27-3553-9ad3-f6e72d926b0d",
                                "text": "Il s’est acquitté bravement de sa commission."
                            },
                            {
                                "example_id": "10acbd8a-f1f5-4643-960f-45806c51f28f",
                                "sense_id": "d57e1bda-bc27-3553-9ad3-f6e72d926b0d",
                                "text": "Il s’est bravement tiré de cet embarras."
                            }
                        ]
                    },
                    {
                        "sense_id": "500a1910-477b-3588-9049-09b5657718ae",
                        "entry_id": "53a4abd7-a1e5-3c66-978d-7cc108f0977a",
                        "glosses": [
                            "Beaucoup."
                        ],
                        "tags": [
                            "Occitanie"
                        ],
                        "examples": [
                            {
                                "example_id": "61a9c39e-7cb7-45eb-ae49-1fa1ef659f1a",
                                "sense_id": "500a1910-477b-3588-9049-09b5657718ae",
                                "text": "Il fait bravement chaud."
                            },
                            {
                                "example_id": "2ca20e51-4e41-4454-908e-e09c90f7174b",
                                "sense_id": "500a1910-477b-3588-9049-09b5657718ae",
                                "text": "Il a bravement raison.",
                                "translation": "Il a bien raison."
                            }
                        ]
