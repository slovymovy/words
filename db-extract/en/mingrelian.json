            {
                "entry_id": "05f8402b-2235-325a-b809-c25ef598b8e2",
                "word": "Mingrelian",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0313ebd2-42e4-38d7-92d8-0125775f1a03",
                        "entry_id": "05f8402b-2235-325a-b809-c25ef598b8e2",
                        "glosses": [
                            "A Kartvelian language spoken in parts of Georgia (mainly Samegrelo and Abkhazia)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efc97f21-0014-455e-8a93-a24de3f0cdc7",
                                "sense_id": "0313ebd2-42e4-38d7-92d8-0125775f1a03",
                                "text": "I’m told, Minister Beria did, on occasion, like to perform Mingrelian peasant songs on the balalaika."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30574e74-2ec2-4fd8-966a-4a74c1452397",
                        "source_entry_id": "05f8402b-2235-325a-b809-c25ef598b8e2",
                        "source_sense_id": "0313ebd2-42e4-38d7-92d8-0125775f1a03",
                        "source_sense_description": "language",
                        "target_lang_word": "mingrélien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mingrélien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f8f477e-7af0-31c8-a2d5-6631e34a87c8",
                                        "entry_id": "b47ec016-4d26-3370-80b0-a3de50da03bf",
                                        "glosses": [
                                            "Langue kartvélienne, proche du géorgien, dont elle s’est séparée, avec le laze, un millénaire avant l’ère chrétienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7187f4e8-d605-4a69-9e98-3ea3452ba83e",
                                                "sense_id": "0f8f477e-7af0-31c8-a2d5-6631e34a87c8",
                                                "text": "L’homme harangue ses troupes en mingrélien, un dialecte Géorgien…."
                                            },
                                            {
                                                "example_id": "668b4cf0-50d3-42bc-a295-7163da83a6d9",
                                                "sense_id": "0f8f477e-7af0-31c8-a2d5-6631e34a87c8",
                                                "text": "Dès la haute Antiquité, les ancêtres des Géorgiens forment sur le versant sud du Grand Caucase différentes tribus unies par une même famille linguistique, celle des langues kartvéliennes dont est issu le géorgien moderne ainsi que trois langues régionales : le mingrélien, le svane et le laze, parlé essentiellement en Turquie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mingrélien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dab7ddb7-6f1d-3583-b48b-9889f97e5457",
                                        "entry_id": "1f2015e0-39ac-34e9-b0cd-6b2222bcc5ce",
                                        "glosses": [
                                            "Qui se rapporte au mingrélien, la langue mingrélienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad31eff2-4a74-4a43-877d-f9c94960e72b",
                                                "sense_id": "dab7ddb7-6f1d-3583-b48b-9889f97e5457",
                                                "text": "Ma résolution était désormais prise : c’était dans l’étude de la langue mingrélienne que j’allais me spécialiser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c96db20-712b-3005-8203-06d3372cae17",
                                        "entry_id": "1f2015e0-39ac-34e9-b0cd-6b2222bcc5ce",
                                        "glosses": [
                                            "Qui se rapporte à la Mingrélie ou à ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
