                "senses": [
                    {
                        "sense_id": "d8e9007f-37b7-3536-b4bd-f6afb07567be",
                        "entry_id": "162abc4c-7536-3eca-9740-afb724d24801",
                        "glosses": [
                            "Donner un caractère punique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8f694fb-f642-42ce-af65-0fe9c01063c3",
                                "sense_id": "d8e9007f-37b7-3536-b4bd-f6afb07567be",
                                "text": "En effet, on ne reconnaît pas toujours si les noms relèvent d’une tradition punique, libyque, ou s’il s’agit de noms étrangers qui ont été transcrits, traduits, punicisés ou libycisés."
                            },
                            {
                                "example_id": "9a026e09-90bc-4b33-b3f8-e88f8b069f5f",
                                "sense_id": "d8e9007f-37b7-3536-b4bd-f6afb07567be",
                                "text": "Ensuite Carthage, dès avant la première guerre punique, semble avoir réussi à « puniciser » son monnayage."
                            }
                        ]
                    }
                ],
