                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c44670b-c779-4d1b-ab01-db1a0896743b",
                                "sense_id": "aafd6e77-ac6c-32e1-b26d-410cc1e86b9c",
                                "text": "Die meisten Forsythien sind in China verbreitet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d502f5ab-aa86-312f-ab60-87918fed20ce",
                        "entry_id": "aeb7cc16-170d-3318-b55d-e84830fe8a84",
                        "glosses": [
                            "der Hybridstrauch Forsythia x intermedia, ein weit verbreiteter, gelb blühender Zierstrauch"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "732dd2bf-0dc6-4a55-bba7-fbacb1b4260a",
                                "sense_id": "d502f5ab-aa86-312f-ab60-87918fed20ce",
                                "text": "Die Forsythien leuchten schon aus den Vorgärten, es wird Frühling."
                            },
                            {
                                "example_id": "632fde75-d4a6-4695-869b-b4b91471a64c",
                                "sense_id": "d502f5ab-aa86-312f-ab60-87918fed20ce",
                                "text": "Sobald die Forsythie blüht, können die Rosen geschnitten werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "963c09b4-465c-42ed-bcd6-feb6778a96e0",
                        "source_entry_id": "aeb7cc16-170d-3318-b55d-e84830fe8a84",
                        "source_sense_id": "aafd6e77-ac6c-32e1-b26d-410cc1e86b9c",
                        "source_sense_description": "Botanik: Vertreter der Pflanzengattung Forsythia",
                        "target_lang_word": "forsythia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forsythia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abf205be-be47-3797-803a-7dac156f3638",
                                        "entry_id": "5fb33808-33b2-3beb-bf59-c00850056efb",
                                        "glosses": [
                                            "Any of several shrubs, of the genus Forsythia, native to Asia and Eastern Europe, that are cultivated for their yellow flowers, which bloom in early spring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad29557f-07ed-400a-ae0a-9247e29659ad",
                                                "sense_id": "abf205be-be47-3797-803a-7dac156f3638",
                                                "text": "They heard laughing then, and looked up to see Ann and Bell coming down the street toward them. Ann had plucked a twig of forsythia, and was trying to arrange it in her hair. \"Take that off!\" Bell was saying. \"It's got bugs crawling on it!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57e8ce07-fbae-4737-8fbe-dd7e0b7b9f7c",
                        "source_entry_id": "aeb7cc16-170d-3318-b55d-e84830fe8a84",
                        "source_sense_id": "aafd6e77-ac6c-32e1-b26d-410cc1e86b9c",
                        "source_sense_description": "Botanik: Vertreter der Pflanzengattung Forsythia",
                        "target_lang_word": "forsythia",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forsythia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fee6a379-a14e-3aed-9c27-2e4b5b8bf032",
                                        "entry_id": "f38ac925-7a14-3ea6-973f-db8b1d85661b",
                                        "glosses": [
                                            "Arbuste rustique à floraison jaune d’or abondante et ornementale, précoce, venant avant les feuilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ae0c2e5-0722-4160-a513-50d43ebfff6d",
                                                "sense_id": "fee6a379-a14e-3aed-9c27-2e4b5b8bf032",
                                                "text": "Le forsythia est un arbuste ornemental dont la couleur jaune des fleurs et la floribondité sont très appréciées au début du printemps."
                                            },
                                            {
                                                "example_id": "600b4cb3-5e94-4c99-9c37-165022c42ee7",
                                                "sense_id": "fee6a379-a14e-3aed-9c27-2e4b5b8bf032",
                                                "text": "Dieu merci, tout ce que j’éprouve, je l’ai déjà éprouvé. Heur et malheur, Noëls tièdes et Noëls bastionnés de neige, Pâques revêches et jaune lumière de Pâques qui appelle hors de terre l’exubérance jaune des coucous, des jonquilles, des forsythias sans feuilles, des primevères et des mahonias — ayant tout possédé, je peux choisir sans que je sois tentée de rien dédaigner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
