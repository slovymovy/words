{
    "word_family": [
        "begrijpen",
        "begrijpelijk",
        "begrip",
        "onbegrip"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1aa28dd9-66d0-3d40-9845-fec83e97fdfb",
                    "sense_definition": "niet of zeer moeilijk te begrijpen of rationeel te volgen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "onbegrijpelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De plannen van de overheid zijn voor de meeste burgers volkomen <w>onbegrijpelijk</w>.",
                            "target_lang_translations": {
                                "en": "The government's plans are completely <w>incomprehensible</w> to most citizens."
                            }
                        },
                        {
                            "text": "Het is een <w>onbegrijpelijk</w> besluit om de school midden in het jaar te sluiten.",
                            "target_lang_translations": {
                                "en": "It is an <w>unfathomable</w> decision to close the school in the middle of the year."
                            }
                        }
                    ],
                    "synonyms": [
                        "impenetrabel"
                    ],
                    "antonyms": [
                        "begrijpelijk",
                        "logisch",
                        "helder"
                    ],
                    "common_phrases": [
                        "onbegrijpelijk besluit",
                        "volkomen onbegrijpelijk"
                    ],
                    "target_lang_definitions": {
                        "en": "not or very difficult to understand or to follow rationally"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "incomprehensible",
                                "target_lang_sense_clarification": "impossible to understand"
                            },
                            {
                                "target_lang_word": "unfathomable",
                                "target_lang_sense_clarification": "incapable of being fully explored or understood"
                            },
                            {
                                "target_lang_word": "unintelligible",
                                "target_lang_sense_clarification": "impossible to understand, often referring to speech or writing"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "31e3f0b1-e688-3f1e-88fc-77fe5527484c",
                    "sense_definition": "op een wijze die niet of zeer moeilijk te vatten is",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "onbegrijpelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij vindt het <w>onbegrijpelijk</w> dat de rechters zich niet uitspreken over de fouten in het rapport.",
                            "target_lang_translations": {
                                "en": "He finds it <w>incomprehensible</w> that the judges do not speak out about the errors in the report."
                            }
                        },
                        {
                            "text": "De situatie werd <w>onbegrijpelijk</w> ingewikkeld na de nieuwe regels.",
                            "target_lang_translations": {
                                "en": "The situation became <w>incomprehensibly</w> complicated after the new rules."
                            }
                        }
                    ],
                    "antonyms": [
                        "begrijpelijk"
                    ],
                    "common_phrases": [
                        "onbegrijpelijk vinden"
                    ],
                    "target_lang_definitions": {
                        "en": "in a manner that is not or very difficult to grasp"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "incomprehensibly",
                                "target_lang_sense_clarification": "in a way that is impossible to understand"
                            },
                            {
                                "target_lang_word": "unfathomably",
                                "target_lang_sense_clarification": "to an extent that cannot be understood"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}