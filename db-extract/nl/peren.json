                        "entry_id": "994a23c9-81c6-3b7b-b32a-187239a708d2",
                        "glosses": [
                            "To leave abruptly, to bail (out)."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "9890806c-4208-4507-a320-4fee57701441",
                                "sense_id": "de0e9652-091c-342a-ae08-72e38951c6d2",
                                "text": "Toen er op het feest een vechtpartij uitbrak, ben ik hem toch maar gepeerd.",
                                "translation": "When a fight broke out at the party, I decided to bail.",
                                "english": "When a fight broke out at the party, I decided to bail."
                            }
                        ]
