            {
                "entry_id": "d242b6d7-f671-38df-9dfb-0831417220ac",
                "word": "Nobby",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "69689929-bceb-36a5-9fc4-c168157ee8ea",
                        "entry_id": "d242b6d7-f671-38df-9dfb-0831417220ac",
                        "glosses": [
                            "A diminutive of the male given name Norbert."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e91d16f3-b214-4aac-acaf-a55963e0e163",
                                "sense_id": "69689929-bceb-36a5-9fc4-c168157ee8ea",
                                "text": "Nobby Stiles\nNorbert is a moniker one normally doesn't associate with one of the game's most intimidating midfielders, but \"Nobby\" provided the steel for the England side that prevailed in the 1966 World Cup, and his gap-toothed visage would have earned him a guest spot in the movie Halloween."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0797caf-7dc5-31c0-b694-c4f1e6cc23f4",
                        "entry_id": "d242b6d7-f671-38df-9dfb-0831417220ac",
                        "glosses": [
                            "A diminutive of the female given name Zenobia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc879000-9142-45a8-a2d2-15d762578f8a",
                                "sense_id": "d0797caf-7dc5-31c0-b694-c4f1e6cc23f4",
                                "text": "There's Nobby, now―here he indicates Zenobia with his pipe―\"as has 'ad a whole cartload o' troubles, besides me a riding on the shafts, an' that's bad enough, an't it, Nobby?\""
                            }
                        ]
                    }
                ],
