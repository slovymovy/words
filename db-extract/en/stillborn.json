                                "example_id": "291ccd3d-2c3c-4efa-90a0-9db7242fbc16",
                                "sense_id": "d3f8376f-064b-3b57-92c4-b409943ac18d",
                                "text": "Queen Anne, before Elizabeth, bore a still-born son."
                            },
                            {
                                "example_id": "8d47c2fb-8cd3-4382-af5a-e8fa4324c8fd",
                                "sense_id": "d3f8376f-064b-3b57-92c4-b409943ac18d",
                                "text": "Or why was I not hidden in the ground like a stillborn child, like an infant who never saw the light of day?"
