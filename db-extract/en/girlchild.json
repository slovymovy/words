    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5f8f8558-2f67-3e06-9a3f-a5d7241c755c",
                "word": "girlchild",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e4ebd156-73c6-41c7-a711-636680920fca",
                        "entry_id": "5f8f8558-2f67-3e06-9a3f-a5d7241c755c",
                        "tags": [
                            "plural"
                        ],
                        "form": "girlchildren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae9dc828-396f-33b8-94f7-727e41e138fa",
                        "entry_id": "5f8f8558-2f67-3e06-9a3f-a5d7241c755c",
                        "glosses": [
                            "A female child."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f2466f9-2213-4d52-ae75-19ac17f0f6c5",
                                "sense_id": "ae9dc828-396f-33b8-94f7-727e41e138fa",
                                "text": "The male is esteemed \"the head of the family;\" it belongs to him; he maintains it; and the rest of the world is a wide hunting ground and battlefield wherein he competes with other males as of old. ¶ The girl-child, peering out, sees this forbidden field as belonging wholly to men-kind; and her relation to it is to secure one for herself—not only that she may love, but that she may live."
                            },
                            {
                                "example_id": "bb1b2554-7e5a-4e95-b3d3-d599731773f4",
                                "sense_id": "ae9dc828-396f-33b8-94f7-727e41e138fa",
                                "text": "She had a baby slung on her back in a shawl, a girl child clinging to her skirts, and a heavy-faced boy plodding behind her."
                            },
                            {
                                "example_id": "e272eba1-4fb0-485d-9968-dabbb8bc17eb",
                                "sense_id": "ae9dc828-396f-33b8-94f7-727e41e138fa",
                                "text": "\"Patróklos,\nwhy all the weeping? Like a small girlchild\nwho runs beside her mother and cried and cries\nto be taken up, and catches at her gown,\nand will not let her go, looking up in tears\nuntil she has her wish: that's how you seem,\nPatróklos, winking out your glimmering tears."
                            },
                            {
                                "example_id": "378c8324-0c95-48b9-bc31-fa41e88e3ea5",
                                "sense_id": "ae9dc828-396f-33b8-94f7-727e41e138fa",
                                "text": "In the final, affirming piece, \"They Tell Me...Now I Know,\" the girlchild narrator begins menstruation, thus undergoing her rite of passage into womanhood."
                            }
                        ]
                    }
                ],
