                        "sense_id": "4dfeb532-d797-3eaa-9655-e70493f6f74a",
                        "entry_id": "527c2913-4e64-370b-bf76-3f5bb1a19980",
                        "glosses": [
                            "An unspecified large number (of)."
                        ],
                        "tags": [
                            "excessive",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f1dc9c70-0dc6-4576-ab89-8340318eea6a",
                                "sense_id": "4dfeb532-d797-3eaa-9655-e70493f6f74a",
                                "text": "At Guy's school there had been an outdoor pool, in use from April to October, a watery grave for a billion insects, or quite possibly a gillion or a squillion. The bright turquoise lining had wrinkled under the children's feet."
                            },
                            {
                                "example_id": "785d5fb9-3d13-438b-acb4-b63e624d8dd3",
                                "sense_id": "4dfeb532-d797-3eaa-9655-e70493f6f74a",
                                "text": "I looked down to see my dog, Roof, short for Rufus, curled in sleep below the window, unworried by the wings of hummingbirds whirring at speeds of a gillion miles an hour as they flitted in and out of the trumpets of honeysuckle growing on the side of the house."
                            }
                        ]
                    }
