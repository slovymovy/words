                            "prepositional"
                        ],
                        "form": "ара́пе"
                    },
                    {
                        "form_id": "4818599e-454f-4059-94fa-0a55d77bdaa1",
                        "entry_id": "ed86f89b-ccad-355a-8c1c-14c915c71b57",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "ара́пах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa2ffdeb-7e19-31c3-928e-01a74fd59815",
                        "entry_id": "ed86f89b-ccad-355a-8c1c-14c915c71b57",
                        "glosses": [
                            "устар. негр"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c441874e-5de1-44d3-98d9-13a04af825bf",
                                "sense_id": "fa2ffdeb-7e19-31c3-928e-01a74fd59815",
                                "text": "Тотчасъ трое, чёрные как арапы, выпрыгнули из печи и явились перед нами."
                            },
                            {
                                "example_id": "fc3c47c3-c5e7-4d68-b35e-2577cd7d694d",
                                "sense_id": "fa2ffdeb-7e19-31c3-928e-01a74fd59815",
                                "text": "Оспа налепила на один глаз бельмо и всё лицо испестрила разноцветными сшивками; вдобавок красные волоса его съежились и переплелись, как у арапа."
                            }
                        ]
                    },
                    {
                        "sense_id": "05179b8b-ed85-360b-a7ad-787b23794e93",
                        "entry_id": "ed86f89b-ccad-355a-8c1c-14c915c71b57",
                        "glosses": [
                            "истор. в домах знати в XVIII — первой половине XIX века: слуга (обычно темнокожий)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87b65554-028d-40f4-bb5d-2918878c4f14",
                                "sense_id": "05179b8b-ed85-360b-a7ad-787b23794e93",
                                "text": "Куда же, думаю, турку определить? Кроме как куда арапом, никуда его не определить — и нашла я ему арапскую должность."
                            }
                        ]
                    },
                    {
                        "sense_id": "b224da7f-bec4-3e8a-a662-22ebcd800c7f",
                        "entry_id": "ed86f89b-ccad-355a-8c1c-14c915c71b57",
                        "glosses": [
                            "прост., игр. мошенник, карточный жулик"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a908ea6-5c9d-44ab-91e1-70033162f71a",
                                "sense_id": "b224da7f-bec4-3e8a-a662-22ebcd800c7f",
                                "text": "Бичем всякого клуба являются: шулера, арапы, свои люди и составители."
                            },
                            {
                                "example_id": "b65cd962-ae8d-4a11-bd3d-39fd54a54faf",
                                "sense_id": "b224da7f-bec4-3e8a-a662-22ebcd800c7f",
                                "text": "Трест очень простой. Жоржика знаешь? Ну, как же, конферансье, известный арап. Он этот трест и устроил. Завел там, в особняке, буфет с напитками, тапера, оркестр, фокстрот, посадил у входа в лавочку кассиршу, сообразил девятку, пульку, чуть ли не рулетку и возит туда дураков-иностранцев — весь царизм показывает им по пятьдесят рублей в долларах с рыла."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
