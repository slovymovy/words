                "senses": [
                    {
                        "sense_id": "1fb8ba50-4b09-3036-898d-819bef9e5dc2",
                        "entry_id": "8ac3b112-960a-39f0-a4c9-fbf94d413b9b",
                        "glosses": [
                            "Person (meist älterer Schüler), die mit den Verkehrsregeln vertraut ist und das sichere Überqueren einer Fahrbahn für Schüler gewährleisten soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0467336-7c8a-4317-affb-493ff7371052",
                                "sense_id": "1fb8ba50-4b09-3036-898d-819bef9e5dc2",
                                "text": "Der Schülerlotse bedeutete dem Autofahrer anzuhalten, damit die Schüler die Straße überqueren können."
                            },
                            {
                                "example_id": "97f42d3d-9d27-4082-8a29-00065fea0539",
                                "sense_id": "1fb8ba50-4b09-3036-898d-819bef9e5dc2",
                                "text": "„Der älteste und bekannteste Begriff ist Schülerlotse; er wird bereits seit 1953 benutzt, als der Schülerlotsendienst in Deutschland eingerichtet wurde.“"
                            },
                            {
                                "example_id": "bb1c1dfd-8131-475a-81aa-a60745dc7579",
                                "sense_id": "1fb8ba50-4b09-3036-898d-819bef9e5dc2",
                                "text": "„Ältere Kinder, die Schülerlotse sein dürfen, werden bewundert.“"
                            },
                            {
                                "example_id": "9a66a3fe-e834-4902-8ca0-363ec0c61df4",
                                "sense_id": "1fb8ba50-4b09-3036-898d-819bef9e5dc2",
                                "text": "„Der Schülerlotse übt seine Tätigkeit hoheitlich aus, um das Lehrpersonal zu entlasten.“"
                            },
                            {
                                "example_id": "c33234e1-f68d-48bc-b48d-e65e74e25995",
                                "sense_id": "1fb8ba50-4b09-3036-898d-819bef9e5dc2",
                                "text": "„Als Schülerlotsen aktiv werden Schülerinnen und Schüler vom 13. Lebensjahr an. In einigen Bundesländern kann man auch bereits ab elf Jahren bzw. ab der 5. Klasse Schülerlotse werden.“"
                            },
                            {
                                "example_id": "56a4019d-e83b-4f48-ba82-1490dd4f3645",
                                "sense_id": "1fb8ba50-4b09-3036-898d-819bef9e5dc2",
                                "text": "„Schülerlotsen und Schulweghelfer verstärken die Sicherheit der Kinder auf dem Schulweg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
