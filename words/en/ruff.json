{
    "word_family": [
        "ruffle",
        "rough"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a5c2ab2-48c7-319b-9893-a9930bde38a7",
                    "sense_definition": "A circular frill or ruffle on a garment, especially a starched, fluted frill at the neck in Elizabethan and Jacobean England.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor wore an elaborate <w>ruff</w> around his neck for the historical play.",
                            "target_lang_translations": {
                                "zh": "为了这部历史剧，演员在脖子上戴了一个精致的<w>褶皱领</w>。"
                            }
                        },
                        {
                            "text": "She looked like a queen in her stiff, white <w>ruff</w>.",
                            "target_lang_translations": {
                                "zh": "她戴着浆硬的白色<w>褶皱领</w>，看起来像位女王。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Elizabethan ruff"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical fashion."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种旧式服装的环状褶皱领，尤指伊丽莎白时代那种浆硬的褶皱领。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "褶皱领",
                                "target_lang_sense_clarification": "指历史服饰中颈部的环状装饰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72219870-f4ad-34ee-916a-0f923b77cb6d",
                    "sense_definition": "A medium-sized wading bird of Eurasia, specifically the male which develops a distinctive neck frill during mating season.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The male <w>ruff</w> displays his feathers to attract a mate.",
                            "target_lang_translations": {
                                "zh": "雄性<w>流苏鹬</w>会展示羽毛来吸引配偶。"
                            }
                        },
                        {
                            "text": "Birdwatchers gathered at the marsh to spot a rare <w>ruff</w>.",
                            "target_lang_translations": {
                                "zh": "观鸟者们聚集在沼泽地，希望能看到稀有的<w>流苏鹬</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种欧亚大陆的涉禽，雄鸟在繁殖季节颈部会长出独特的羽毛。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "流苏鹬",
                                "target_lang_sense_clarification": "一种鸟类名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55fc0ee3-e91f-335b-892f-4c47ca700f46",
                    "sense_definition": "A set of lengthened or modified feathers on or around the neck of a bird.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "animal_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird puffed out its <w>ruff</w> to appear larger to predators.",
                            "target_lang_translations": {
                                "zh": "这只鸟蓬松起它的<w>颈羽</w>，好让捕食者觉得它体型更大。"
                            }
                        },
                        {
                            "text": "The grouse has a distinct <w>ruff</w> of feathers around its neck.",
                            "target_lang_translations": {
                                "zh": "松鸡的脖子周围有一圈明显的<w>颈羽</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "鸟类颈部周围长出或特化的羽毛。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "颈羽",
                                "target_lang_sense_clarification": "鸟类颈部特有的羽毛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19944688-3f5e-391f-bdce-635c4652110c",
                    "sense_definition": "A collar of lengthened or distinctively coloured fur on or around the neck of an animal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "animal_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lion has a thick <w>ruff</w> of fur around its head.",
                            "target_lang_translations": {
                                "zh": "狮子头部周围有一圈浓密的<w>鬃毛</w>。"
                            }
                        },
                        {
                            "text": "The animal popped its <w>ruff</w> when it felt threatened.",
                            "target_lang_translations": {
                                "zh": "当感到受威胁时，这只动物竖起了它的<w>鬃毛</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动物颈部周围长出的一圈较长或颜色独特的毛。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鬃毛",
                                "target_lang_sense_clarification": "动物颈部周围的毛发"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6e9431d-0264-3ece-86ab-9c68c11738cc",
                    "sense_definition": "A small freshwater fish of the genus Gymnocephalus, known for having spiny fins.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ruff</w> is a common fish found in many European rivers.",
                            "target_lang_translations": {
                                "zh": "<w>河鲈</w>是许多欧洲河流中常见的鱼类。"
                            }
                        },
                        {
                            "text": "Anglers often catch the spiny <w>ruff</w> while fishing for perch.",
                            "target_lang_translations": {
                                "zh": "垂钓者在钓鲈鱼时经常会捕到多刺的<w>河鲈</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种属于河鲈科的淡水鱼，以鳍上有刺而闻名。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "河鲈",
                                "target_lang_sense_clarification": "一种淡水鱼类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82f0633f-3adf-33ee-9494-935a4b788d6a",
                    "sense_definition": "A fish of species Arripis georgianus, found in cool waters off the southern coast of Australia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ruff</w> is a popular food fish in southern Australia.",
                            "target_lang_translations": {
                                "zh": "<w>澳洲鲱</w>是澳大利亚南部一种受欢迎的食用鱼。"
                            }
                        },
                        {
                            "text": "Local fishermen often refer to the Australian herring as a <w>ruff</w>.",
                            "target_lang_translations": {
                                "zh": "当地渔民常把澳洲鲱称为<w>澳洲鲱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Australian herring",
                        "tommy ruff"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in Australia."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种产于澳大利亚南部沿海冷水域的鱼类。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "澳洲鲱",
                                "target_lang_sense_clarification": "澳大利亚的一种食用鱼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "93707ed3-a800-306b-aaf4-e94af7d5b796",
                    "sense_definition": "To play a trump card to a trick when unable to follow suit in a card game.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "card_games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>ruff</w> the lead to win the trick.",
                            "target_lang_translations": {
                                "zh": "他决定用<w>王牌吃牌</w>以赢得这一轮。"
                            }
                        },
                        {
                            "text": "You should <w>ruff</w> if you have no cards of the current suit.",
                            "target_lang_translations": {
                                "zh": "如果你手里没有当前花色的牌，就应该<w>王牌吃牌</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trump"
                    ],
                    "common_phrases": [
                        "ruff the trick"
                    ],
                    "target_lang_definitions": {
                        "zh": "在纸牌游戏中，当无法跟出同花色牌时，打出一张王牌。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "王牌吃牌",
                                "target_lang_sense_clarification": "纸牌游戏术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e96209b8-f724-3f84-a58a-bc4bc66e7025",
                    "sense_definition": "Of a bird, to ruffle its feathers.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "animal_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The owl began to <w>ruff</w> its feathers against the cold wind.",
                            "target_lang_translations": {
                                "zh": "猫头鹰开始<w>竖起</w>羽毛以抵御寒风。"
                            }
                        },
                        {
                            "text": "The bird will <w>ruff</w> up when it is angry or cold.",
                            "target_lang_translations": {
                                "zh": "当鸟儿生气或感到寒冷时，它会把羽毛<w>竖起</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ruff up"
                    ],
                    "target_lang_definitions": {
                        "zh": "指鸟类竖起羽毛。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "竖起",
                                "target_lang_sense_clarification": "指鸟类因寒冷或愤怒而使羽毛蓬松"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "69fb30cc-b53a-3cfa-9f33-13d69e36d0e7",
                    "sense_definition": "The sound of a dog barking.",
                    "learner_level": "A1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog gave a loud <w>ruff</w> when the mailman arrived.",
                            "target_lang_translations": {
                                "zh": "邮递员到达时，狗大叫了一声“<w>汪</w>”。"
                            }
                        },
                        {
                            "text": "I heard a small <w>ruff</w> coming from the backyard.",
                            "target_lang_translations": {
                                "zh": "我听到后院传来一声小小的“<w>汪</w>”声。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Onomatopoeic representation of a bark."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "狗叫声的拟声词。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "汪",
                                "target_lang_sense_clarification": "狗叫声的拟声词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}