                "senses": [
                    {
                        "sense_id": "8aea6ab7-05cc-3aa0-83d6-a1224a88554d",
                        "entry_id": "c086c076-5042-3e58-af11-8d4ddd4f1677",
                        "glosses": [
                            "Veranstaltung, deren Erlös zur Verbesserung der Situation von Bedürftigen oder Organisationen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "048dadf5-16b9-4eb9-b08a-8960554cdc63",
                                "sense_id": "8aea6ab7-05cc-3aa0-83d6-a1224a88554d",
                                "text": "„Fergie, die Mutter, entrüstete sich ebenfalls; die Yorks würden von den Medien belästigt, sagte sie an einer vorweihnachtlichen Wohltätigkeitsveranstaltung.“"
                            },
                            {
                                "example_id": "2c28a1e9-68e2-4255-aee4-b673438a2a83",
                                "sense_id": "8aea6ab7-05cc-3aa0-83d6-a1224a88554d",
                                "text": "„Gottschalk hielt sich demnach bei einer Wohltätigkeitsveranstaltung in München auf, als die Flammen auf sein Haus übergriffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
