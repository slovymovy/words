                "senses": [
                    {
                        "sense_id": "35854c98-0064-3d0c-8253-c1989b3b6ede",
                        "entry_id": "ae4c610b-ec0f-3c14-8d43-4f7c5a1abc25",
                        "glosses": [
                            "Bewegung/Zug mit dem Ziel kriegerischer Auseinandersetzungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d136266c-e849-483e-bd24-7105d08d5a47",
                                "sense_id": "35854c98-0064-3d0c-8253-c1989b3b6ede",
                                "text": "„Unstet zog er vor den Einwanderern her; neue Geschlechter, neue Zeiten folgten seinem einsamen Kriegspfad durch die Wildnis.“"
                            },
                            {
                                "example_id": "83361897-30e9-4bf6-b30e-69c8be8ecbf3",
                                "sense_id": "35854c98-0064-3d0c-8253-c1989b3b6ede",
                                "text": "„Er ging auf den Kriegspfad und brachte zwei der Häuptlinge, Männer des Mexiko, mit ihm, und er wurde der Sohn des großen El Sol und lebte in seines Vaters großem Wigwam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "844816c6-7e81-451d-a2ae-d20f61aba3fb",
                        "source_entry_id": "ae4c610b-ec0f-3c14-8d43-4f7c5a1abc25",
                        "source_sense_id": "35854c98-0064-3d0c-8253-c1989b3b6ede",
