                "senses": [
                    {
                        "sense_id": "9de5e7ee-76b0-3dab-81d9-b26fb8dfada3",
                        "entry_id": "bb475be0-3d98-3e74-b022-997df611328f",
                        "glosses": [
                            "Qui possède un nombre impair de nervures qui se détachent au point de contact entre le pétiole et le limbe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46b59790-bd9a-4926-bbc5-be49802af482",
                                "sense_id": "9de5e7ee-76b0-3dab-81d9-b26fb8dfada3",
                                "text": "[…], et dans ce cas, elles offrent tellement toutes les particularités propres aux feuilles, qu'on peut dire qu'elles ne sont que de petites feuilles accessoires, tantôt pétiolées, plus souvent sessiles, tantôt entières, tantôt dentées ou lobées, à nervures pennées ou palmées, etc.; mais on n'en trouve aucune qui soit ni composée, ni peltinerve, ni pédalinerve."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c47daa1-ad13-38b5-8923-d7c18b2c96f7",
                        "entry_id": "bb475be0-3d98-3e74-b022-997df611328f",
                        "glosses": [
                            "Se dit des pieds des animaux, principalement les oiseaux, dont les doigts sont unis par une membrane."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56d8d0b0-91db-4dd2-b766-40c459a9555c",
                                "sense_id": "7c47daa1-ad13-38b5-8923-d7c18b2c96f7",
                                "text": "S’il est battu, ce ne sera pas sa défaite, mais la victoire des forces maléfiques aux pieds palmés."
                            }
                        ]
                    }
                ],
