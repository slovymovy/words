                        "cross_references": [
                            {
                                "target_word": "jihadist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e113602-6f8d-398d-a289-0afafa6cfdc1",
                                        "entry_id": "8c35d4e1-8e69-3a3e-a976-9bfc69867011",
                                        "glosses": [
                                            "One who participates in a jihad, an Islamic holy war or conflict; a mujahid."
                                        ],
                                        "tags": [],
