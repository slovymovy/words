                    {
                        "sense_id": "d5314dd4-e0aa-3b30-bdb6-779d2270b35c",
                        "entry_id": "cac5a608-9a2e-389e-88ae-d77dff03279e",
                        "glosses": [
                            "The lack of a capacity; an inability."
                        ],
                        "tags": [
