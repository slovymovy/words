                                        "entry_id": "f376a346-1237-344d-a25b-2d64126ed7d7",
                                        "glosses": [
                                            "Having a less than fully functional limb, or injuries which prevent full mobility."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "393ff1be-c8a6-40bc-ba54-be4c87bc20ae",
                                                "sense_id": "e1b99845-d584-3f3e-af43-43561e7f6bc0",
                                                "text": "A crippled man, twenty years older than you, whom you will have to wait on?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68213273-137b-301c-bff3-c0eea1f33192",
                                        "entry_id": "f376a346-1237-344d-a25b-2d64126ed7d7",
                                        "glosses": [
                                            "Having any difficulty or impediment which can be likened to a crippling injury."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf277d07-bdc5-4b74-a795-6329739fa5eb",
                                                "sense_id": "68213273-137b-301c-bff3-c0eea1f33192",
                                                "text": "a crippled version of the software, lacking many features"
                                            }
                                        ]
                                    }
