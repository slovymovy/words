                        "glosses": [
                            "Orné magnifiquement, à la manière d’un Alhambra."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a495ea19-daf1-49a6-9dab-a1f18533d251",
                                "sense_id": "21c0c86e-b349-3393-b72b-4f1a1020f655",
                                "text": "Coriolis se lança derrière elle, et, au bout de quelques pas, il se trouva dans un petit préau bizarre, un patio de maison d’Orient, une espèce de cloître alhambresque : Manette n'était plus là."
                            }
                        ]
                    },
                    {
                        "sense_id": "5159c674-aaed-3a35-87fe-24c00e55808a",
                        "entry_id": "614d5415-036b-3531-9514-f3f4c3d671d5",
                        "glosses": [
                            "Dont le style évoque l’art oriental."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "7f1a2a14-27ca-4519-a3b1-16c5cfde1b48",
                                "sense_id": "5159c674-aaed-3a35-87fe-24c00e55808a",
                                "text": "Le fameux vase alhambresque, je l’avoue à ma honte, me fait l’effet d’un vase en carton peint, pour un drame littéraire et assyrien de l’Odéon."
                            }
                        ]
                    }
                ],
