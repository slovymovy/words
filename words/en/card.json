{
    "word_family": [
        "cardboard",
        "carding",
        "carder",
        "postcard",
        "scorecard",
        "wildcard"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c788acb-e5ee-3ebc-b83d-2c262a136614",
                    "sense_definition": "A folded piece of stiff paper with a picture on the front and a message inside, sent to express good wishes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "paper_items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sent her parents a lovely <w>card</w> for their wedding anniversary.",
                            "target_lang_translations": {
                                "ru": "Она отправила родителям чудесную <w>открытку</w> на годовщину их свадьбы."
                            }
                        },
                        {
                            "text": "I need to buy a birthday <w>card</w> for my brother before the party.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить <w>открытку</w> на день рождения брату до начала вечеринки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "birthday card",
                        "greeting card",
                        "send a card"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сложенный лист плотной бумаги с рисунком на лицевой стороне и сообщением внутри, отправляемый для выражения добрых пожеланий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "открытка",
                                "target_lang_sense_clarification": "поздравительная"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8547ace-b5db-3881-9526-4a8b45ff44fb",
                    "sense_definition": "One of a set of small pieces of stiff paper or plastic with numbers and symbols on them, used for playing games.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He dealt each player a <w>card</w> from the top of the deck.",
                            "target_lang_translations": {
                                "ru": "Он раздал каждому игроку по <w>карте</w> сверху колоды."
                            }
                        },
                        {
                            "text": "As each <w>card</w> is played in blackjack, it changes the possibilities for both player and dealer.",
                            "target_lang_translations": {
                                "ru": "Когда в блэкджеке разыгрывается каждая <w>карта</w>, это меняет шансы как для игрока, так и для дилера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deck of cards",
                        "play a card",
                        "shuffle the cards"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из набора небольших листов плотной бумаги или пластика с числами и символами, используемый для игр."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карта",
                                "target_lang_sense_clarification": "игральная"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c531ec14-6268-301e-9b79-5dfb5cd379e2",
                    "sense_definition": "Any flat, normally rectangular piece of stiff paper or plastic used for various purposes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "paper_items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please write your name and address on this small white <w>card</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, напишите свое имя и адрес на этой маленькой белой <w>карточке</w>."
                            }
                        },
                        {
                            "text": "The library issued me a new membership <w>card</w> yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера библиотека выдала мне новый читательский <w>билет</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "index card",
                        "plastic card",
                        "membership card"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой плоский, обычно прямоугольный кусок плотной бумаги или пластика, используемый для различных целей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карточка",
                                "target_lang_sense_clarification": "небольшой прямоугольник из бумаги или пластика"
                            },
                            {
                                "target_lang_word": "карта",
                                "target_lang_sense_clarification": "пластиковая или идентификационная"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a57d380-64ef-3a74-86fb-6a8decd528f2",
                    "sense_definition": "A small card printed with a person's name and professional details, given to clients or contacts.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "paper_items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The realtor gave me her <w>card</w> so I could call if I had any questions.",
                            "target_lang_translations": {
                                "ru": "Риелтор дала мне свою <w>визитку</w>, чтобы я мог позвонить, если возникнут вопросы."
                            }
                        },
                        {
                            "text": "He handed over his <w>card</w> at the end of the meeting.",
                            "target_lang_translations": {
                                "ru": "В конце встречи он протянул свою <w>визитную карточку</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "business card",
                        "hand someone a card"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая карточка с напечатанным именем человека и профессиональными данными, выдаваемая клиентам или контактам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "визитка",
                                "target_lang_sense_clarification": "визитная карточка"
                            },
                            {
                                "target_lang_word": "визитная карточка",
                                "target_lang_sense_clarification": "полное название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9965feb-ba92-3c03-9a9b-5473a83328c6",
                    "sense_definition": "Any game played using a deck of playing cards.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the rainy afternoon playing <w>cards</w> with his friends.",
                            "target_lang_translations": {
                                "ru": "Дождливый день он провел, играя в <w>карты</w> с друзьями."
                            }
                        },
                        {
                            "text": "Do you want to play a game of <w>cards</w> after dinner?",
                            "target_lang_translations": {
                                "ru": "Хочешь сыграть в <w>карты</w> после ужина?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "play cards",
                        "game of cards"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая игра, в которой используется колода игральных карт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карты",
                                "target_lang_sense_clarification": "игра в карты"
                            },
                            {
                                "target_lang_word": "карточная игра",
                                "target_lang_sense_clarification": "вид игры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31ed8a86-9071-3eb8-a2a2-0045a62030bf",
                    "sense_definition": "A short form of report <w>card</w>, showing a student's grades.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "paper_items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Where is your <w>card</w>? I want to see your grades for this term.",
                            "target_lang_translations": {
                                "ru": "Где твой <w>табель</w>? Я хочу посмотреть твои оценки за этот семестр."
                            }
                        },
                        {
                            "text": "The teacher handed out every student's <w>card</w> on the last day of school.",
                            "target_lang_translations": {
                                "ru": "В последний учебный день учитель раздал <w>табели</w> всем ученикам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "report card"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткая форма табеля успеваемости, показывающая оценки учащегося."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "табель",
                                "target_lang_sense_clarification": "с оценками"
                            },
                            {
                                "target_lang_word": "карточка успеваемости",
                                "target_lang_sense_clarification": "документ с оценками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcbb0355-312b-32e6-9222-07271335cc3e",
                    "sense_definition": "A removable electronic device inserted into a computer or phone to provide extra memory or functions.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He needed to replace the <w>card</w> his computer used to connect to the internet.",
                            "target_lang_translations": {
                                "ru": "Ему нужно было заменить <w>плату</w>, которую его компьютер использовал для подключения к интернету."
                            }
                        },
                        {
                            "text": "I bought a new memory <w>card</w> for my digital camera.",
                            "target_lang_translations": {
                                "ru": "Я купил новую <w>карту</w> памяти для своего цифрового фотоаппарата."
                            }
                        }
                    ],
                    "synonyms": [
                        "expansion card"
                    ],
                    "common_phrases": [
                        "memory card",
                        "graphics card",
                        "sound card",
                        "sim card"
                    ],
                    "target_lang_definitions": {
                        "ru": "Съемное электронное устройство, вставляемое в компьютер или телефон для обеспечения дополнительной памяти или функций."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карта",
                                "target_lang_sense_clarification": "электронная плата или модуль"
                            },
                            {
                                "target_lang_word": "плата",
                                "target_lang_sense_clarification": "компьютерная"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74c63dfb-554d-36ee-a14c-ae5e16a34145",
                    "sense_definition": "Paper that is thicker and more durable than normal paper but thinner than cardboard.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "paper_items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do you have any <w>card</w>? I want to make a sturdy poster for the event.",
                            "target_lang_translations": {
                                "ru": "У тебя есть <w>плотная бумага</w>? Я хочу сделать прочный плакат для мероприятия."
                            }
                        },
                        {
                            "text": "The invitations were printed on high-quality white <w>card</w>.",
                            "target_lang_translations": {
                                "ru": "Приглашения были напечатаны на высококачественном белом <w>картоне</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "card stock",
                        "thick card"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бумага, которая толще и прочнее обычной бумаги, но тоньше картона."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плотная бумага",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "картон",
                                "target_lang_sense_clarification": "тонкий картон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae5164f9-13d5-30b9-b539-7a80a562f022",
                    "sense_definition": "A resource, argument, or strategy used to gain an advantage or achieve a purpose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strategy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician decided to play the nationalist <w>card</w> to win more votes.",
                            "target_lang_translations": {
                                "ru": "Политик решил разыграть националистическую <w>карту</w>, чтобы получить больше голосов."
                            }
                        },
                        {
                            "text": "He accused his opponent of playing the race <w>card</w> during the debate.",
                            "target_lang_translations": {
                                "ru": "Он обвинил своего оппонента в использовании расового <w>вопроса</w> в качестве козыря во время дебатов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "play the card",
                        "trump card"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ресурс, аргумент или стратегия, используемые для получения преимущества или достижения цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карта",
                                "target_lang_sense_clarification": "в переносном смысле"
                            },
                            {
                                "target_lang_word": "козырь",
                                "target_lang_sense_clarification": "решающий аргумент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0077833d-b1df-3937-bc22-e45cd46b9d01",
                    "sense_definition": "An amusing, entertaining, or slightly eccentric person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man was quite a <w>card</w>, always telling jokes to the children.",
                            "target_lang_translations": {
                                "ru": "Старик был тем еще <w>оригиналом</w>, вечно рассказывал детям анекдоты."
                            }
                        },
                        {
                            "text": "Oh, you <w>card</w>! You always know how to make everyone laugh.",
                            "target_lang_translations": {
                                "ru": "Ну ты и <w>чудак</w>! Всегда знаешь, как всех рассмешить."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a bit of a card"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to describe a funny person"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Забавный, занимательный или слегка эксцентричный человек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оригинал",
                                "target_lang_sense_clarification": "чудак, забавный человек"
                            },
                            {
                                "target_lang_word": "типаж",
                                "target_lang_sense_clarification": "своеобразный человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "846ad712-1aa9-365a-b6ab-41122aaa9ce1",
                    "sense_definition": "A list of scheduled events, performers, or contestants at a sporting event.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "events",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "What is on the <w>card</w> for the wrestling match tonight?",
                            "target_lang_translations": {
                                "ru": "Кто сегодня в <w>программе</w> борцовского поединка?"
                            }
                        },
                        {
                            "text": "There are several exciting fights on the <w>card</w> this weekend.",
                            "target_lang_translations": {
                                "ru": "В эти выходные в <w>карде</w> заявлено несколько захватывающих боев."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the card"
                    ],
                    "target_lang_definitions": {
                        "ru": "Список запланированных событий, исполнителей или участников спортивного мероприятия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "программа",
                                "target_lang_sense_clarification": "мероприятия"
                            },
                            {
                                "target_lang_word": "кард",
                                "target_lang_sense_clarification": "в единоборствах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "881026fb-6c88-3463-93fe-78da6ab1e177",
                    "sense_definition": "A hand-held tool with wire bristles used to untangle and clean raw fibers like wool before spinning.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a wooden <w>card</w> to prepare the raw wool for the spinning wheel.",
                            "target_lang_translations": {
                                "ru": "Она использовала деревянную <w>чесалку</w>, чтобы подготовить необработанную шерсть для прялки."
                            }
                        },
                        {
                            "text": "The museum displayed an ancient <w>card</w> used by weavers centuries ago.",
                            "target_lang_translations": {
                                "ru": "В музее была выставлена древняя <w>карда</w>, которой ткачи пользовались много веков назад."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wool card"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ручной инструмент с проволочной щетиной, используемый для распутывания и очистки необработанных волокон, таких как шерсть, перед прядением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чесалка",
                                "target_lang_sense_clarification": "для шерсти"
                            },
                            {
                                "target_lang_word": "карда",
                                "target_lang_sense_clarification": "инструмент для чесания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a9ed0b0-c1d6-3cd8-899a-813a8aacfcc3",
                    "sense_definition": "To check someone's identification to verify their age, especially before selling alcohol.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bouncer will <w>card</w> anyone who looks under the age of twenty-five.",
                            "target_lang_translations": {
                                "ru": "Вышибала будет <w>проверять документы</w> у всех, кто выглядит моложе двадцати пяти лет."
                            }
                        },
                        {
                            "text": "I forgot my license, so I hope they don't <w>card</w> me at the bar.",
                            "target_lang_translations": {
                                "ru": "Я забыл права, так что надеюсь, что в баре у меня не <w>спросят документы</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "card someone"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common in North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проверять чье-либо удостоверение личности для подтверждения возраста, особенно перед продажей алкоголя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проверять документы",
                                "target_lang_sense_clarification": "удостоверение личности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3f89933-e93d-3e93-b86f-8396890eb227",
                    "sense_definition": "To achieve or record a specific score in a game, especially golf.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professional golfer <w>carded</w> a brilliant sixty-five in the final round.",
                            "target_lang_translations": {
                                "ru": "Профессиональный гольфист <w>записал на свой счет</w> блестящие шестьдесят пять очков в финальном раунде."
                            }
                        },
                        {
                            "text": "He managed to <w>card</w> a birdie on the very last hole.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>сделать</w> «берди» на самой последней лунке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "card a score"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достичь или зафиксировать определенный результат в игре, особенно в гольфе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "записать",
                                "target_lang_sense_clarification": "результат в карточку"
                            },
                            {
                                "target_lang_word": "показать результат",
                                "target_lang_sense_clarification": "в спорте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e914a3b-ca55-3ac2-a3ce-092e5eace10b",
                    "sense_definition": "To comb or clean fibers like wool with a special tool before spinning.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "textile_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers would <w>card</w> the wool by hand before the machines were invented.",
                            "target_lang_translations": {
                                "ru": "До изобретения машин рабочие <w>чесали</w> шерсть вручную."
                            }
