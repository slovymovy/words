                "senses": [
                    {
                        "sense_id": "fdd41d61-86e0-3eff-901b-9cca6e0c024a",
                        "entry_id": "cafd5cf2-16fa-3f65-bced-198a33b608ac",
                        "glosses": [
                            "Canner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "966e50a4-4c7a-4c26-b2d2-da0a20c5fc11",
                                "sense_id": "fdd41d61-86e0-3eff-901b-9cca6e0c024a",
                                "text": "Donc, Norma Thurlow avait traîné sa petite Edwina vers la classe et la petite Edwina avait hurlé si fort que Ralph l'avait entendue du fond de la cave où il recannait des chaises."
                            },
                            {
                                "example_id": "744d8875-3788-499a-91ee-be9dd05c21c7",
                                "sense_id": "fdd41d61-86e0-3eff-901b-9cca6e0c024a",
                                "text": "Cette technique peut être utilisée pour recanner un siège ancien. Il faut, dans ce cas, creuser une gorge périphérique à l’emplacement des trous de passage de l'ancien cannage."
                            },
                            {
                                "example_id": "fd5dc61d-2b92-4ff8-b2c3-67de21b69465",
                                "sense_id": "fdd41d61-86e0-3eff-901b-9cca6e0c024a",
                                "text": "On peut recanner soi-même un siège, à condition d'être particulièrement minutieux... et de posséder l'outillage adapté, le rotin filé."
                            }
                        ]
                    }
                ],
