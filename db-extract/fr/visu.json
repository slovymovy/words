                    {
                        "translation_id": "963c38cd-066b-43ef-b6b9-1d7a50a16fff",
                        "source_entry_id": "44f2d0fe-811f-334c-820c-54b07d6bba20",
                        "source_sense_id": "f3515ba1-567c-3723-a5c3-d73df21fd245",
                        "source_sense_description": "Technik: Bildschirmkonsole, Display",
                        "target_lang_word": "Display",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Display",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1033f641-5486-3b7e-8566-6baeae87205d",
                                        "entry_id": "01d13186-a28b-306a-9937-919b3bc0b8eb",
                                        "glosses": [
                                            "Bildschirm, Monitor"
                                        ],
                                        "tags": [
                                            "anderes Wort für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d50ab9c-3904-4c1a-8cb9-0e235b5fff92",
                                                "sense_id": "1033f641-5486-3b7e-8566-6baeae87205d",
                                                "text": "„Ich habe Schilder, Fahrpläne und Displays fotographiert, um zu beweisen, dass ich hier war, nicht den anderen, sondern mir selbst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "37b41b00-ae90-3fb8-8916-bde5249afb42",
                                        "entry_id": "01d13186-a28b-306a-9937-919b3bc0b8eb",
                                        "glosses": [
                                            "aus (Quarz-)Kristallen hergestellte Anzeige an Geräten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d42f1b9-5cb4-4fc6-8b51-d688b93ff585",
                                                "sense_id": "37b41b00-ae90-3fb8-8916-bde5249afb42",
                                                "text": "Die digitale Uhr hatte als eines der ersten Geräte ein Display."
                                            },
                                            {
                                                "example_id": "1b66dd4f-a5bc-4204-b0c9-c8f9a50f8e11",
                                                "sense_id": "37b41b00-ae90-3fb8-8916-bde5249afb42",
                                                "text": "Das Display an deinem Handy ist aber mickrig."
                                            },
                                            {
                                                "example_id": "9d4f9464-0f81-40e8-884a-3cf7d8e784fb",
                                                "sense_id": "37b41b00-ae90-3fb8-8916-bde5249afb42",
                                                "text": "„Sie beugen sich geschäftig über das Display.“"
                                            },
                                            {
                                                "example_id": "4912c9a7-63f8-436a-86f8-653c1d685355",
                                                "sense_id": "37b41b00-ae90-3fb8-8916-bde5249afb42",
                                                "text": "„Das Display war noch erleuchtet.“"
                                            },
                                            {
                                                "example_id": "aca49a07-ad78-4f3a-9430-59d2e2eb2fd6",
                                                "sense_id": "37b41b00-ae90-3fb8-8916-bde5249afb42",
                                                "text": "„Der Mann tippte auf dem blauschimmernden Display seines Mobiltelefons herum.“"
                                            },
                                            {
                                                "example_id": "e5315a58-9532-456e-a4c3-7ebd8e6c0b7e",
                                                "sense_id": "37b41b00-ae90-3fb8-8916-bde5249afb42",
                                                "text": "„Daniel fingerte an einer Fernbedienung herum, ein leises Motorgeräusch setzte ein, und ein riesiger Flachbildschirm mit gebogenem Display fuhr auf geheimnisvolle Weise langsam aus einem Sideboard empor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8b53da09-f0d8-3ea9-853a-fead9e7aa67c",
                                        "entry_id": "01d13186-a28b-306a-9937-919b3bc0b8eb",
                                        "glosses": [
                                            "marketingorientierte Großverpackung zur optischen Darstellung zur Verkaufsförderung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b563fa1c-9a80-4a01-9403-687c7e3a8544",
                                                "sense_id": "8b53da09-f0d8-3ea9-853a-fead9e7aa67c",
                                                "text": "Mein Großhändler kommt immer wieder mit neuen Wünschen, dass wir hier Displays aufstellen sollen. Aber wir sind doch nur ein Tante Emma Laden mit Kunden aus der Nachbarschaft, da stören diese Teile nur."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
