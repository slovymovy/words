                ],
                "senses": [
                    {
                        "sense_id": "abf7df8c-87b6-3251-ac26-fa7877ea3302",
                        "entry_id": "8db3a600-82a2-305f-9b19-5363bb75690c",
                        "glosses": [
                            "einer Ziege ähnelnd, an eine Ziege erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e713fd71-c737-4373-b91e-8a3dc0e37b7d",
                                "sense_id": "abf7df8c-87b6-3251-ac26-fa7877ea3302",
                                "text": "„Wilburs ziegenartiges Gesicht nahm einen Ausdruck von Verzweiflung an.“"
                            },
                            {
                                "example_id": "846b65ce-c44e-4204-a2db-6c06b5a33a4b",
                                "sense_id": "abf7df8c-87b6-3251-ac26-fa7877ea3302",
                                "text": "„Dieser eigentümliche ziegenartige Geruch ist Hexamethonium.“"
                            },
                            {
                                "example_id": "7f3e5337-550c-463e-aa50-d332da83f119",
                                "sense_id": "abf7df8c-87b6-3251-ac26-fa7877ea3302",
                                "text": "„Der ziegenartige Geruch war jetzt stärker und mit einem Duft vermischt, so kotzig-süßlich, dass er in ein türkisches Bordell gepasst hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
