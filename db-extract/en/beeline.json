                    },
                    {
                        "translation_id": "5996e6a0-1bba-4e7c-9659-77c7a718cfa5",
                        "source_entry_id": "cf663b4b-3915-3c91-8b61-f015c0a9c6e1",
                        "source_sense_description": "straight course, ignoring established paths of travel",
                        "target_lang_word": "Luftlinie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luftlinie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84a1bc87-bf97-35f3-b8ee-290f1443491a",
                                        "entry_id": "d6139321-7eff-34a0-bf60-9372b6657ce6",
                                        "glosses": [
                                            "gedachte Linie; kürzeste Entfernung zwischen zwei Orten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc96a662-0b41-42a9-b07a-90bdc62cac80",
                                                "sense_id": "84a1bc87-bf97-35f3-b8ee-290f1443491a",
                                                "text": "Die Entfernung beträgt nur 300 m Luftlinie."
                                            },
                                            {
                                                "example_id": "26782eb7-bc1c-4895-9b96-51653848b127",
                                                "sense_id": "84a1bc87-bf97-35f3-b8ee-290f1443491a",
                                                "text": "„750 Kilometer Luftlinie trennen die beiden Orte, die Reise birgt viele Gefahren, und so engagiert Tobit, der Vater des Tobias, den Mann Asarja als Reisebegleiter.“"
                                            },
                                            {
                                                "example_id": "73d1daeb-60e8-4de2-b8d5-e760fa665725",
                                                "sense_id": "84a1bc87-bf97-35f3-b8ee-290f1443491a",
                                                "text": "„Vom Kallisaw-Sund zum Rainbow-Fishing-Camp sind's bloß anderthalb Meilen, das heißt, in der Luftlinie.“"
                                            },
                                            {
                                                "example_id": "fdf1f0be-cb10-4641-ac79-0131caa6f8eb",
                                                "sense_id": "84a1bc87-bf97-35f3-b8ee-290f1443491a",
                                                "text": "„Die ganze Grenze war abgeriegelt, selbst hier im Nirgendwo, 15 Kilometer Luftlinie vom offiziellen Grenzübergang entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb19b3b7-049b-368d-9e62-3ce7d6c5161b",
                                        "entry_id": "d6139321-7eff-34a0-bf60-9372b6657ce6",
                                        "glosses": [
                                            "Unternehmen, das Flugverkehr betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21d4f3b1-5ab3-45b4-a7c5-7f14ac1451f0",
                                                "sense_id": "cb19b3b7-049b-368d-9e62-3ce7d6c5161b",
                                                "text": "„Der Aufsichtsrat der Luftlinie hat das neue Konzept für Eurowings genehmigt.“"
                                            },
                                            {
                                                "example_id": "3783b45e-1eae-412e-9291-ad8c304a7b55",
                                                "sense_id": "cb19b3b7-049b-368d-9e62-3ce7d6c5161b",
                                                "text": "„Am Flughafen Düsseldorf sind am Dienstag mehr als zwei Dutzend Flüge der Luftlinie Eurowings am Boden geblieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09ef8e9f-611a-4762-a841-a721a0c1d8d3",
                        "source_entry_id": "cf663b4b-3915-3c91-8b61-f015c0a9c6e1",
                        "source_sense_description": "straight course, ignoring established paths of travel",
                        "target_lang_word": "najprostsza droga",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "30da07a8-ce50-47ce-be80-514350af4900",
                        "source_entry_id": "cf663b4b-3915-3c91-8b61-f015c0a9c6e1",
                        "source_sense_description": "straight course, ignoring established paths of travel",
                        "target_lang_word": "прямиком",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "прямиком",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a5bbb19c-69a2-3600-96d2-232ae6dae3a6",
                                        "entry_id": "9c86be33-6563-3daf-ae22-c551cc359596",
                                        "glosses": [
                                            "разг. не сворачивая в сторону, напрямик"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be505fba-dd0a-4c67-a95b-4228c5c2730c",
                                                "sense_id": "a5bbb19c-69a2-3600-96d2-232ae6dae3a6",
                                                "text": "Легко плылось и мне прямиком вперёд — в сторону лиловой красоты заоблачного заката."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dfea9fb-4ad5-3d81-b9c6-980cc753a906",
                                        "entry_id": "9c86be33-6563-3daf-ae22-c551cc359596",
                                        "glosses": [
                                            "разг. кратчайшим путём"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a7404db-be1d-41a2-b222-7f5347d4518a",
                                                "sense_id": "1dfea9fb-4ad5-3d81-b9c6-980cc753a906",
                                                "text": "Перекрестился Жилин, подхватил рукой замок на колодке, чтобы не бренчал, пошел по дороге, — ногу волочит, а сам всё на зарево поглядывает, где месяц встаёт. Дорогу он узнал. Прямиком идти вёрст восемь. Только бы до лесу дойти прежде, чем месяц совсем выйдет. Перешёл он речку, — побелел уже свет за горой. Пошёл лощиной, идёт, сам поглядывает: не видать ещё месяца. Уж зарево посветлело и с одной стороны лощины всё светлее, светлее становится. Ползёт под гору тень, всё к нему приближается."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9125e12-7a04-3860-a4a5-df03a1b76b73",
                                        "entry_id": "9c86be33-6563-3daf-ae22-c551cc359596",
                                        "glosses": [
                                            "разг. открыто, явно, не скрывая"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faaaf564-3569-43ee-a744-8bde043dcad4",
                                                "sense_id": "a9125e12-7a04-3860-a4a5-df03a1b76b73",
                                                "text": "— А ты лишнего-то не мели, нечего нам с тобой канителиться. Не сказывай обиняком, режь правду прямиком, — смело глядя в глаза Самоквасову, с задором промолвила Фленушка."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f40d7c5e-f2f5-479a-808b-5b8f0080cc4c",
                        "source_entry_id": "cf663b4b-3915-3c91-8b61-f015c0a9c6e1",
                        "source_sense_description": "straight course, ignoring established paths of travel",
                        "target_lang_word": "напряму́ю",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "напряму́ю",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f76bbe7c-8215-3b6d-b6b0-9b298e24514d",
                                        "entry_id": "4e2f3519-16c6-37f5-9acc-17fadad36736",
                                        "glosses": [
                                            "то же, что напрямик, кратчайшим путём"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86f13fc2-b6e5-4890-a418-d1584b7d4d3d",
                                                "sense_id": "f76bbe7c-8215-3b6d-b6b0-9b298e24514d",
                                                "text": "— Напрямую до развилки, — сказал водитель, — а оттуда минут двадцать ходу…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b12dfe1-25e7-3998-a27f-a00fadec7630",
                                        "entry_id": "4e2f3519-16c6-37f5-9acc-17fadad36736",
                                        "glosses": [
                                            "без посредников, непосредственно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ca3e686-cdb3-437d-9c9b-079877aff609",
                                                "sense_id": "7b12dfe1-25e7-3998-a27f-a00fadec7630",
                                                "text": "Космический закон причины и следствия запрещает напрямую вмешиваться в человеческую судьбу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82cae847-3fa2-328e-a1a5-e627b9ebee8c",
                                        "entry_id": "4e2f3519-16c6-37f5-9acc-17fadad36736",
                                        "glosses": [
                                            "перен. не стесняясь, прямо, откровенно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c528877a-22dc-4212-8f27-6bf512edd312",
                                                "sense_id": "82cae847-3fa2-328e-a1a5-e627b9ebee8c",
                                                "text": "— Почему он мстит за тебя? — напрямую спросила мама."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
