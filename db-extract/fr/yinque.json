                        "examples": [
                            {
                                "example_id": "f0a2755e-e88a-4aeb-a3e9-5bf00ddf1d1b",
                                "sense_id": "d6c2ec29-aaf7-33d7-a3ec-72280d750daa",
                                "text": "Y’a yinque toé pis moé icitte."
                            },
                            {
                                "example_id": "eb189867-2f46-4c82-a4e8-862575c4dbb7",
                                "sense_id": "d6c2ec29-aaf7-33d7-a3ec-72280d750daa",
                                "text": "Il m’a yinque donné trois heures de travail."
                            },
                            {
                                "example_id": "e7565ee1-5737-4e3f-a92a-90a544f29ebe",
                                "sense_id": "d6c2ec29-aaf7-33d7-a3ec-72280d750daa",
                                "text": "Suggérée par des auditeurs d’Acadie, de Gaspésie et de Beauce, « Rien qu’à voir, on voit bien », qui doit être prononcé « yinque à ’ouère, on ’oué ben », est utilisé pour souligner une évidence."
                            }
                        ]
                    }
