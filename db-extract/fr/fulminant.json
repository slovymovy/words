                        "entry_id": "bd0ba815-0ed9-3db7-b64a-d2e1bde7eb85",
                        "glosses": [
                            "Qui lance la foudre, qui est armé de la foudre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3863e7f-6cc5-413f-a24d-1c2fe8b826fd",
                                "sense_id": "50d11206-789e-3a09-9636-9f70cf7fa604",
                                "text": "Jupiter fulminant."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e7afd6d-2d54-363b-abac-23d92d7052b4",
                        "entry_id": "bd0ba815-0ed9-3db7-b64a-d2e1bde7eb85",
                        "glosses": [
                            "Certaines compositions qui détonent ou éclatent quand on les chauffe ou qu’on les comprime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf461b92-a417-403d-95fe-86215ac5ec73",
                                "sense_id": "0e7afd6d-2d54-363b-abac-23d92d7052b4",
                                "text": "Le malencontreux Paganel s’était rattrapé à la corde de la pièce encore chargée, et le chien venait de s’abattre sur l’amorce fulminante."
                            },
                            {
                                "example_id": "36f73045-83f5-4612-a2d1-5e0c5174441f",
                                "sense_id": "0e7afd6d-2d54-363b-abac-23d92d7052b4",
                                "text": "tout ce qui lui parut obscur devint clair comme le jour : c’était le diable qui avait fait avancer l’aiguille, qui avait mis des moustaches à son portrait, changé le crin de ses brosses en fil d’archal et rempli ses vessies de poudre fulminante."
                            }
                        ]
                    },
                    {
                        "sense_id": "9160986c-0367-3d35-8a57-4b9fb4bb4742",
                        "entry_id": "bd0ba815-0ed9-3db7-b64a-d2e1bde7eb85",
                        "glosses": [
                            "Qui est chargé de menaces ou qui dénote une violente colère."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0038c0d9-40e3-4e59-9519-10201109bd16",
                                "sense_id": "9160986c-0367-3d35-8a57-4b9fb4bb4742",
                                "text": "Lancer un regard fulminant. Écrit fulminant."
                            },
                            {
                                "example_id": "35e9d5b6-d5b3-4422-ac69-5b58012659f0",
                                "sense_id": "9160986c-0367-3d35-8a57-4b9fb4bb4742",
                                "text": "J’ai fui la haine des pharisiens, j’ai fui l’arrestation qui se rapprochait, j’ai fui la mort qui me reniflait de sa grosse truffe fulminante."
                            }
                        ]
                    }
