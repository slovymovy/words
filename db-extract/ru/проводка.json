                    {
                        "translation_id": "73d55669-1e22-41e8-baa5-ea6b50af91cc",
                        "source_entry_id": "d9fb7f1d-b2b1-370e-bdab-747976cb8241",
                        "source_sense_description": "совокупность электрических проводов",
                        "target_lang_word": "Leitung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leitung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b32aa7be-632c-382f-b533-a3c5077eb592",
                                        "entry_id": "c9564963-9c57-3d69-890a-7d0bab2a0a3f",
                                        "glosses": [
                                            "Beaufsichtigung, Betreuung, Führung, Verwaltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d4c5a7d-595f-49f3-9f98-4ae991badaaf",
                                                "sense_id": "b32aa7be-632c-382f-b533-a3c5077eb592",
                                                "text": "Ich übernahm die Leitung über die Theater-AG."
                                            },
                                            {
                                                "example_id": "f4564ed6-62ad-48aa-9e31-0756d4e70b3d",
                                                "sense_id": "b32aa7be-632c-382f-b533-a3c5077eb592",
                                                "text": "„Er war ein eleganter Bonvivant geworden und schien eine echte Begabung für die Leitung eines Hotels zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "16758a4c-b382-3685-9e71-232f70b848c6",
                                        "entry_id": "c9564963-9c57-3d69-890a-7d0bab2a0a3f",
                                        "glosses": [
                                            "längliche Röhre zum Hindurchleiten von Flüssigkeiten oder Gasen"
                                        ],
                                        "tags": [
                                            "Beförderungstechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "907d35ad-9d5e-4d7a-a671-8314a9330f8b",
                                                "sense_id": "16758a4c-b382-3685-9e71-232f70b848c6",
                                                "text": "Die Leitung hat ein Leck."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d9a4c449-dd5c-30ae-b571-b8668ad8701e",
                                        "entry_id": "c9564963-9c57-3d69-890a-7d0bab2a0a3f",
                                        "glosses": [
                                            "Elektrizität leitendes Material, meist in Form eins Drahts oder Kabels"
                                        ],
                                        "tags": [
                                            "Elektrizität"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7314a868-9da6-4fe6-8b99-12b66394266e",
                                                "sense_id": "d9a4c449-dd5c-30ae-b571-b8668ad8701e",
                                                "text": "Die Leitung muss ausgewechselt werden."
                                            },
                                            {
                                                "example_id": "c86e4d44-51f0-4ddf-815a-9a1dcb63a902",
                                                "sense_id": "d9a4c449-dd5c-30ae-b571-b8668ad8701e",
                                                "text": "Ist noch jemand in der Leitung?"
                                            },
                                            {
                                                "example_id": "a3416b9b-ce80-40ad-8535-96e041388da6",
                                                "sense_id": "d9a4c449-dd5c-30ae-b571-b8668ad8701e",
                                                "text": "Man sollte beim Bohren darauf achten, keine Leitungen anzubohren."
                                            },
                                            {
                                                "example_id": "0854a23d-739a-48b1-9242-4234c6c6e4ba",
                                                "sense_id": "d9a4c449-dd5c-30ae-b571-b8668ad8701e",
                                                "text": "„Die Leitung war tot.“"
                                            },
                                            {
                                                "example_id": "a690a313-64f9-47c5-be68-928ac6287c6c",
                                                "sense_id": "d9a4c449-dd5c-30ae-b571-b8668ad8701e",
                                                "text": "„Am anderen Ende der Leitung, auf der anderen Seite des Meeres, auf dem Festland, in Köln, schnappte meine Schwester sehr hörbar nach Luft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
