                "senses": [
                    {
                        "sense_id": "fb9d268b-e4c8-353c-a6c8-6088ae92da3f",
                        "entry_id": "e47d2586-0076-3458-9033-34b4134f5533",
                        "glosses": [
                            "Soulever un peu le tapis de selle au niveau du garrot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb7689ba-2798-4dcb-b3b0-9767b232ba5f",
                                "sense_id": "fb9d268b-e4c8-353c-a6c8-6088ae92da3f",
                                "text": "Placer la selle sur le tapis, soulever le tapis au niveau du pommeau de selle (cela s’appelle dégarroter), pour éviter toute blessure par frottement."
                            },
                            {
                                "example_id": "83f98e66-de1b-4044-89cb-e5306388bef8",
                                "sense_id": "fb9d268b-e4c8-353c-a6c8-6088ae92da3f",
                                "text": "N’oubliez pas de dégarroter, ne serrez pas trop, encore un trou, attention calez-vous bien au passage de sangle, c’est juste derrière."
                            }
                        ]
                    }
