    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9a43a361-bc84-36a6-8318-4fde4d9664e1",
                    "sense_definition": "Point, quantité ou degré le plus bas qu'une chose puisse atteindre, ou qui est strictement nécessaire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "valeur_limite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour ce voyage, il a décidé d'emporter le strict <w>minimum</w> dans sa valise."
                        },
                        {
                            "text": "L'entreprise cherche à réduire au <w>minimum</w> ses dépenses quotidiennes d'énergie."
                        }
                    ],
                    "antonyms": [
                        "maximum"
                    ],
                    "common_phrases": [
                        "strict minimum",
                        "au minimum",
                        "réduire au minimum"
                    ]
                },
                {
                    "sense_id": "c076d4fb-9f92-3dcc-9fd3-b6f38ed2c406",
                    "sense_definition": "Plus petite somme d'argent légalement ou conventionnellement admise, notamment comme rémunération ou aide sociale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "finances",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il perçoit chaque mois le <w>minimum</w> légal pour subvenir à ses besoins vitaux."
                        },
                        {
                            "text": "Ce montant accordé aux retraités correspond au <w>minimum</w> garanti par l'État."
                        }
                    ],
                    "common_phrases": [
                        "minimum légal",
                        "minimum vital",
                        "minimum garanti"
                    ]
                },
                {
                    "sense_id": "4fc4fd4c-cda9-3e26-955d-95089e9c9873",
                    "sense_definition": "Plus petite valeur prise par une fonction ou une grandeur mathématique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sciences",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette fonction mathématique atteint son <w>minimum</w> lorsque la variable est égale à zéro."
                        },
                        {
                            "text": "La courbe thermique de la région enregistre un <w>minimum</w> juste avant l'aube."
                        }
                    ],
                    "antonyms": [
                        "maximum"
                    ],
                    "common_phrases": [
                        "minimum local",
                        "minimum global"
