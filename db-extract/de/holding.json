                "senses": [
                    {
                        "sense_id": "907c6ea9-6e63-3de5-87f4-fe4a430b3d3a",
                        "entry_id": "962696ea-e1ac-3650-90a6-b4a7327efc70",
                        "glosses": [
                            "Unternehmen, das Kapitalbeteiligungen (Anteile) an verschiedenen Tochterunternehmen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59850965-0f91-4017-a82c-a6cf8efa7afc",
                                "sense_id": "907c6ea9-6e63-3de5-87f4-fe4a430b3d3a",
                                "text": "Die Nachteile einer Holding liegen in der allgemeinen Abhängigkeit, Anonymisierung und der Ähnlichkeit wie bei der Geschäftsbereichorganisation."
                            },
                            {
                                "example_id": "6339fee6-952b-4114-ad8f-0377ac7335b5",
                                "sense_id": "907c6ea9-6e63-3de5-87f4-fe4a430b3d3a",
                                "text": "„Wäre es ein Geschäft gewesen mit Währung und Preisen, meine Großmutter hätte über eine milliardenschwere Holding mit Briefkastenfirmen auf den Cayman Islands verfügt.“"
                            },
                            {
                                "example_id": "50f58dbd-da95-4f6b-9cf1-d4f33bed8d19",
                                "sense_id": "907c6ea9-6e63-3de5-87f4-fe4a430b3d3a",
                                "text": "„Auf eine Order von Premierminister Masimow wird die staatliche Holding Samruk den internationalen Flughafen von Almaty wegen seiner strategischen Bedeutung kaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
