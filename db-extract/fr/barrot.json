                ],
                "senses": [
                    {
                        "sense_id": "0d861ece-d557-361a-99c3-bc1912f6136d",
                        "entry_id": "7383e079-ce72-3f7f-855c-233c8c6a2ae8",
                        "glosses": [
                            "Pièce transversale de la charpente d'un bateau allant d'un bord à l'autre et soutenant un pont."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80c69ccf-7dcb-44e6-845e-bee5d58464e4",
                                "sense_id": "0d861ece-d557-361a-99c3-bc1912f6136d",
                                "text": "Les navires en fer devraient être formés d'un tube clos à chaque extrémité, avec un barrot et couple d'une seule et même pièce formant un anneau, le bordé du navire suivrait la ligne de chaque couple, et serait rivé à même."
                            },
                            {
                                "example_id": "a3d58a15-593a-48de-9fcf-22b0a8fb1ad5",
                                "sense_id": "0d861ece-d557-361a-99c3-bc1912f6136d",
                                "text": "C’'était une épave, le fragment de la coque d’un navire, un barrot, une de ces poutres transversales sur lesquelles repose le pont."
                            },
                            {
                                "example_id": "8cc96fb1-7d72-4076-9545-bfe03fbbfbac",
                                "sense_id": "0d861ece-d557-361a-99c3-bc1912f6136d",
                                "text": "Il est incliné vers l’avant et repose sur le bau supérieur (barrot) parallèle au bau situé juste devant le milieu du bateau."
                            }
                        ]
                    }
                ],
                "translations": [
