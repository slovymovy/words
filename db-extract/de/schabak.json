                                "example_id": "d190f273-fdaf-4076-97da-a53de809440f",
                                "sense_id": "5f5d825d-bdbb-3f47-b458-5683a943747d",
                                "text": "„Allon schlug daher vor, eine spezielle Arbeitsgruppe aus Mitgliedern des Schabak, der Armee und des Außenministeriums mit der Planung und Umsetzung des Vorhabens zu beauftragen.“"
                            },
                            {
                                "example_id": "f5e8a750-c831-4b40-999b-d7414a2519b0",
                                "sense_id": "5f5d825d-bdbb-3f47-b458-5683a943747d",
                                "text": "„Von zahlreichen Polizisten und Agenten des Inlandsgeheimdienstes Schabak eskortiert, stiegen Scharon und seine Parteifreunde am Morgen des 28. September 2000 auf den Berg, wo sie sogleich von aufgebrachten Palästinensern aufgehalten wurden.“"
                            }
