                                                "sense_id": "848373d1-d6aa-3846-9a5d-bb17d095f5e5",
                                                "text": "i virus sono visibili solo con il microscopio elettronico"
                                            },
                                            {
                                                "example_id": "41322d13-fcfa-45bd-8cc6-7477bc77bf5c",
