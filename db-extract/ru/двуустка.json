                    },
                    {
                        "translation_id": "09dea5f9-5126-4dd0-ba7c-c787fa2edd64",
                        "source_entry_id": "50590551-bd73-349f-8977-90f8c7225e36",
                        "source_sense_id": "0a3f0395-157c-36b3-975b-5da564e087b4",
                        "target_lang_word": "douve",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "douve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd52f4bd-8a3a-31a0-a2a0-209b9a930276",
                                        "entry_id": "4d90f53c-8635-3ec3-ba9e-de38c22a1300",
                                        "glosses": [
                                            "Nom de planches disposées en rond qui forment le corps du tonneau et qu’on fait tenir ensemble avec des cercles."
                                        ],
                                        "tags": [
                                            "Tonnellerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abecaa3c-3a1e-4279-bf4b-4a1517b1ab34",
                                                "sense_id": "cd52f4bd-8a3a-31a0-a2a0-209b9a930276",
                                                "text": "La tonnellerie est l’industrie qui emploie la plus grande quantité de bois de fente, et l’on appelle merrain le bois plus particulièrement destiné à la fabrication des douves de tonneaux."
                                            },
                                            {
                                                "example_id": "1b0a158d-d56a-4cfc-941b-36903199df7d",
                                                "sense_id": "cd52f4bd-8a3a-31a0-a2a0-209b9a930276",
                                                "text": "En termes de tonnellerie, on appelle […] jable, la rainure pratiquée vers les extrémités des douves pour arrêter les fonds."
                                            },
                                            {
                                                "example_id": "57d658f5-921e-486e-ab05-3acdbb8cec6a",
                                                "sense_id": "cd52f4bd-8a3a-31a0-a2a0-209b9a930276",
                                                "text": "Six douves de poinçon servaient d’ais et de barre."
                                            },
                                            {
                                                "example_id": "43813811-a6d9-4ae6-b0a4-ab99777cb933",
                                                "sense_id": "cd52f4bd-8a3a-31a0-a2a0-209b9a930276",
                                                "text": "Petar fut le premier sur ses jambes dans le coin en dessous de la lampe où, au milieu d’un tas de copeaux, il maniait la plane, polissant des douves de sapin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab82cc7b-314b-36bd-9632-20380f390410",
                                        "entry_id": "4d90f53c-8635-3ec3-ba9e-de38c22a1300",
                                        "glosses": [
                                            "Fossé servant de limite aux champs et d’écoulement aux eaux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7964d02-e726-3854-bf89-c81571338b28",
                                        "entry_id": "4d90f53c-8635-3ec3-ba9e-de38c22a1300",
                                        "glosses": [
                                            "Paroi des fossés de la fortification ancienne ou, par extension, le fossé lui-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a809c921-8f60-4765-947f-36f4ef87870d",
                                                "sense_id": "d7964d02-e726-3854-bf89-c81571338b28",
