                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03cfe753-15b8-4acb-bb08-616b156d2b4a",
                                "sense_id": "ab9433c4-9899-3f7d-977e-fd1e1a152b42",
                                "text": "„Die Lodge erweist sich dann als wunderbar, aber auch ohne Tierbestand, bis auf ein paar Feldratten, eine Hyäne und eine alte Löwin, die nachts fauchend oder hustend um unseren Bungalow schleicht.“"
                            },
                            {
                                "example_id": "21191960-63f2-4521-bdb9-913f1bcf3bc7",
                                "sense_id": "ab9433c4-9899-3f7d-977e-fd1e1a152b42",
                                "text": "„Die Lodge selbst lag in einem Uferwald aus afrikanischen Ebenholzbäumen und Sykamor-Feigen.“"
                            }
                        ],
