                    }
                ],
                "senses": [
                    {
                        "sense_id": "343eccd5-f399-3cad-a539-f4cd86058fe2",
                        "entry_id": "55ac1c64-d9ff-3132-90cd-f56f7340f627",
                        "glosses": [
                            "Maison d’habitation de mineurs dans le nord de la France et en Wallonie datant de la fin du XIXᵉ siècle."
                        ],
                        "tags": [
                            "Industrie minière",
                            "Urbanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "63f9c9f1-0f0b-4367-97e8-bea884221be0",
                                "sense_id": "343eccd5-f399-3cad-a539-f4cd86058fe2",
                                "text": "Sortant éreinté de la mine,\nRegagnant son noir coron,\nLe mineur que l’on croise et qui lève le poing\nDit : le monde va changer de base."
                            }
                        ]
                    },
                    {
                        "sense_id": "9627fe0b-dbfb-3961-8c6d-e4e76299dc55",
                        "entry_id": "55ac1c64-d9ff-3132-90cd-f56f7340f627",
                        "glosses": [
                            "Groupe formé par un certain nombre de ces habitations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7d5438b-a069-4859-8b55-337fe124b185",
                                "sense_id": "9627fe0b-dbfb-3961-8c6d-e4e76299dc55",
                                "text": "Au Nord, c'étaient les corons\nLa terre, c'était le charbon\nLe ciel, c'était l'horizon\nLes hommes, des mineurs de fond."
                            }
                        ]
                    }
                ],
