                "senses": [
                    {
                        "sense_id": "34692c35-8c2e-338d-9bc7-d4cb77f72817",
                        "entry_id": "6fc6058f-6fbd-3442-a0bd-678373f305d0",
                        "glosses": [
                            "van iemand dat hij bezig is een geschreven tekst tot zich te nemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bef1a28f-b0e3-4468-b836-f3853591296c",
                                "sense_id": "34692c35-8c2e-338d-9bc7-d4cb77f72817",
                                "text": "Wie tijdens het autorijden met een berichtje bezig is, rijdt gemiddeld 26 keer over de strepen op de weg. Dat gebeurt nooit bij besturen zonder telefoon in de hand. Brits onderzoek heeft volgens het ministerie aangetoond dat een lezende en typende bestuurder 40 tot 60 procent van de rijtijd op zijn scherm kijkt in plaats van op de weg."
                            },
                            {
                                "example_id": "559141b6-20e2-4a29-8661-c2b91113f497",
                                "sense_id": "34692c35-8c2e-338d-9bc7-d4cb77f72817",
                                "text": "'Over het algemeen ben ik als Dichter bij Overijssel niet fel of direct reagerend. Eerder wat bescheiden en voorzichtig... Maar uw artikel lezende over de bewust neergelegde varkenskoppen deed mijn pen over het papier razen."
                            }
                        ]
                    }
