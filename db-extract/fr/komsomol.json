                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "0ffbb5bd-f82f-3365-a6e9-d256c7d589b6",
                                        "entry_id": "90136635-6561-378a-8351-43050e3225d5",
                                        "glosses": [
                                            "člen Komunistického svazu mládeže (Komsomolu) v Sovětském svazu"
                                        ],
                                        "tags": [
                                            "dříve"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02d7360f-ff9f-4139-94c6-26e173466873",
                                                "sense_id": "0ffbb5bd-f82f-3365-a6e9-d256c7d589b6",
                                                "text": "Sovětský daňový zákon je velmi jednoduchý. Komsomolci se mu naučí, a potom se rozejdou po vesnicích a na rolnických schůzích s ním obeznámí rolníky „po našem“, rolnickým jazykem, zvláště když oni sami jsou mladými rolníky."
                                            },
                                            {
                                                "example_id": "46d4ea3f-5ad7-4c58-8893-bd699f447092",
                                                "sense_id": "0ffbb5bd-f82f-3365-a6e9-d256c7d589b6",
                                                "text": "Úplně maličké děti jsou v organisacích „okťjabrjat“. Ty potom dorůstají do „pionýrů“. – Pionýři dorůstají v „komsomolce“. Komsomolci dorůstají v členy komunistické strany."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
