                "senses": [
                    {
                        "sense_id": "4e2003ce-2640-3b2c-9512-bb275f19ae28",
                        "entry_id": "c02f4f3d-2c16-3a04-a705-809a949b1665",
                        "glosses": [
                            "страд. прич. прош. вр. от унавозить; удобренный навозом"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "b0f1bae9-5770-4f8a-b26b-4f9cde8d6b88",
                                "sense_id": "4e2003ce-2640-3b2c-9512-bb275f19ae28",
                                "text": "Поля были порядочно размежеваны и унавожены; луга очищены от кочек и бесполезных кустарников."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e5e51aa-2a7e-3571-9cda-eaa50108ef4a",
                        "entry_id": "c02f4f3d-2c16-3a04-a705-809a949b1665",
                        "glosses": [
                            "статив., разг. загрязнённый, испачканный навозом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac40102b-4f53-4fe6-8131-88eae0decdd0",
                                "sense_id": "7e5e51aa-2a7e-3571-9cda-eaa50108ef4a",
                                "text": "Около трактира, на унавоженной земле, под которой был ещё снег, стояли подводы: везли большие бутыли с купоросным маслом."
                            }
                        ]
                    }
