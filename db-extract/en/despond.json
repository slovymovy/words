                        ],
                        "form": "desponding"
                    },
                    {
                        "form_id": "abc298c8-30f2-4aa1-bd02-7a98e8b14990",
                        "entry_id": "be03de36-24e5-3a9e-8be6-3d643a408d7f",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "desponded"
                    },
                    {
                        "form_id": "a490ced6-f24d-4e2f-b3f9-305d1b12df95",
                        "entry_id": "be03de36-24e5-3a9e-8be6-3d643a408d7f",
                        "tags": [
                            "past"
                        ],
                        "form": "desponded"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "79f22881-bee9-3472-8ba7-d6e0067c7239",
                        "entry_id": "be03de36-24e5-3a9e-8be6-3d643a408d7f",
                        "glosses": [
                            "To give up the will, courage, or spirit; to become dejected, lose heart."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "14d02ae6-23fd-4381-8943-7f8728ec6665",
                                "sense_id": "79f22881-bee9-3472-8ba7-d6e0067c7239",
                                "text": "Yet still despond not, but proceed\nAlong the path where fate may lead."
                            },
                            {
                                "example_id": "14e62619-6832-4ed9-9653-9524af818165",
                                "sense_id": "79f22881-bee9-3472-8ba7-d6e0067c7239",
                                "text": "October 16, 1820, Thomas Scott, letter to the Rev. G. Knight, Harwell\nI should despair, or at least despond."
                            },
                            {
                                "example_id": "d196ba13-83e1-4932-a1c9-6d35f33fe0ee",
                                "sense_id": "79f22881-bee9-3472-8ba7-d6e0067c7239",
                                "text": "Others depress their own minds, [and] despond at the first difficulty."
                            },
                            {
                                "example_id": "1a7acb79-c07c-437c-be1e-8ad63851e5be",
                                "sense_id": "79f22881-bee9-3472-8ba7-d6e0067c7239",
                                "text": "June 17, 1825, Daniel Webster, Speech on the laying of the Corner Stone of the Bunker Hill Monument\nWe wish that […] desponding patriotism may turn its eyes hitherward, and be assured that foundations of our national power still stand strong."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c223bd0e-1e49-4a81-8a6b-0605b4ab702e",
                        "source_entry_id": "be03de36-24e5-3a9e-8be6-3d643a408d7f",
                        "source_sense_id": "79f22881-bee9-3472-8ba7-d6e0067c7239",
                        "source_sense_description": "to give up the will, courage, or spirit",
