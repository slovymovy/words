                                                "sense_id": "f70724c7-f92b-3698-871b-807fde0c7beb",
                                                "text": "άκαρπο ζευγάρι"
                                            },
                                            {
                                                "example_id": "fc3a3d91-ec6f-40d6-8952-4d58ecc2c4f2",
                                                "sense_id": "f70724c7-f92b-3698-871b-807fde0c7beb",
                                                "text": "≈ συνώνυμα: άτεκνος, στείρος"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b01db10a-a7c2-300d-bfa0-7a7c6a10a55d",
                                        "entry_id": "62bea11b-b9e9-3268-ae3c-13b49dab9ac7",
                                        "glosses": [
                                            "που δεν φέρνει τα επιθυμητά αποτελέσματα"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49eaf857-f79d-42cb-a07a-d376c28a45ec",
                                                "sense_id": "b01db10a-a7c2-300d-bfa0-7a7c6a10a55d",
                                                "text": "Οι διαπραγματεύσεις απέβησαν άκαρπες."
                                            },
                                            {
                                                "example_id": "6b7bae18-24eb-4c9e-96c8-a9eede23b762",
                                                "sense_id": "b01db10a-a7c2-300d-bfa0-7a7c6a10a55d",
                                                "text": "Οι προσπάθειές τους παρέμειναν άκαρπες."
                                            },
                                            {
                                                "example_id": "7a357641-92ed-434b-8209-4706f08a0eba",
                                                "sense_id": "b01db10a-a7c2-300d-bfa0-7a7c6a10a55d",
                                                "text": "≈ συνώνυμα: άγονος, ανεπιτυχής, αναποτελεσματικός, ατελέσφορος, στείρος"
                                            },
                                            {
                                                "example_id": "46f1b1c7-c05d-4a3c-a41d-38d3d15042b8",
                                                "sense_id": "b01db10a-a7c2-300d-bfa0-7a7c6a10a55d",
