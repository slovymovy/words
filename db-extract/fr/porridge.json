                                        "glosses": [
                                            "papa de farinha de trigo ou de mandioca caracterizado por ser uma comida mole ou aguada"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d46e4ea8-1edf-4027-a535-da1ee313a644",
                                                "sense_id": "1e9ad686-8054-3038-984f-4deaa73b70b2",
                                                "text": "A velha trouxe-lhes logo um grande pedaço de cuscuz, e um mingau saboroso, espécie de papa mole, feita de milho azedo."
                                            }
