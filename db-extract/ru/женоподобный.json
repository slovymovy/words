                "translations": [
                    {
                        "translation_id": "aae26841-2fb2-4b56-9cf3-e831ac547f2f",
                        "source_entry_id": "155a3f8e-e8e2-31a9-9dc3-b5656b9f913b",
                        "source_sense_id": "440468f0-bbc6-385d-b888-61e6c26c7876",
                        "target_lang_word": "effeminate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effeminate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f694dc2-68e8-3928-8fb0-767dd6eed028",
                                        "entry_id": "2e07a427-7f74-3d7a-9c85-f544139dfbcf",
                                        "glosses": [
                                            "Exhibiting behaviour or mannerisms considered typical of a woman; unmasculine."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a47376d-db5a-40e0-b44a-86fa92c82bb2",
                                                "sense_id": "0f694dc2-68e8-3928-8fb0-767dd6eed028",
                                                "text": "An effeminate and unmanly foppery."
                                            },
                                            {
                                                "example_id": "269105ad-aa21-46cb-8268-92a67c798025",
                                                "sense_id": "0f694dc2-68e8-3928-8fb0-767dd6eed028",
                                                "text": "The Comte d'Artois had neither the dignified nor the manly air of his brother—he rather appeared like a pretty-looking girl, so effeminate was he and fair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "372ff352-7701-3185-9c35-6559bf3ca493",
                                        "entry_id": "2e07a427-7f74-3d7a-9c85-f544139dfbcf",
                                        "glosses": [
                                            "Womanly; tender, affectionate, caring."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cfdd507-2ed9-4b35-af9c-b27aaa76dbb5",
                                                "sense_id": "372ff352-7701-3185-9c35-6559bf3ca493",
                                                "text": "Gentle, kind, effeminate remorse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "effeminate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a168b5ac-246c-39c0-a365-2f5e0405acee",
                                        "entry_id": "4c4e581c-73b1-374b-9bea-989e153bd3d8",
                                        "glosses": [
                                            "To make womanly; to unman."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "nonstandard",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "687552f6-121a-4076-a21e-0e62c0a08e39",
                                                "sense_id": "a168b5ac-246c-39c0-a365-2f5e0405acee",
                                                "text": "the studie of sciences doth more weaken and effeminate mens minds, than corroborate and adapt them to warre."
                                            },
                                            {
                                                "example_id": "6e116f76-a626-4418-a6ab-93e5a9057c65",
                                                "sense_id": "a168b5ac-246c-39c0-a365-2f5e0405acee",
                                                "text": "It will not corrupt or effeminate their [children's] minds."
                                            },
                                            {
                                                "example_id": "4831513c-d6ce-4768-a3f9-e1c07629c01c",
                                                "sense_id": "a168b5ac-246c-39c0-a365-2f5e0405acee",
                                                "text": "I mean the represenstation of gay men on The Simpsons is getting more one-dimensional. For several years Smithers was quite masculine, yet the writers have effeminated him gradually (collecting Barbies, for instance), now he's rollerblading down the street with rainbow hotpants on?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "576af856-4502-3ac3-ab84-805d5fca5c55",
                                        "entry_id": "4c4e581c-73b1-374b-9bea-989e153bd3d8",
                                        "glosses": [
                                            "To become womanly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "effeminate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecb87f80-41ef-3dce-bdd8-f0a2de714bc3",
                                        "entry_id": "cb7b6316-d305-3f13-b5c0-76ebe5f3e456",
                                        "glosses": [
                                            "An effeminate person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc845203-fa91-4a38-a9ea-bf5bed6e196d",
                                                "sense_id": "ecb87f80-41ef-3dce-bdd8-f0a2de714bc3",
                                                "text": "The effeminates are males with obviously recognizable traits and mannerisms; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
