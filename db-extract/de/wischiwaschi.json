                "senses": [
                    {
                        "sense_id": "d969385e-c006-37f9-a8f2-558d2d5e0fd9",
                        "entry_id": "9878c5ce-47d5-3e55-affb-36095d7de72a",
                        "glosses": [
                            "wishy-washiness; drivel"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
