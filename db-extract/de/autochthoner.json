                        "target_lang_word": "autochthone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autochthone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21cf51fb-c427-3788-883c-2b0a02b35bf4",
                                        "entry_id": "524b9838-cc09-3fd6-8dd6-a264a1cb4427",
                                        "glosses": [
                                            "Variante de autochtone."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "666cdaa1-4156-4753-aee2-1530dc207208",
                                                "sense_id": "21cf51fb-c427-3788-883c-2b0a02b35bf4",
                                                "text": "Plusieurs historiens pensent que les Américains ne sont pas autochthones et qu'ils sont venus d'Asie en Amérique."
                                            }
                                        ]
                                    }
                                ]
                            },
