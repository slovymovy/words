                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wagon's <w>bolster</w> was worn down after years of heavy use on the farm.",
                            "target_lang_translations": {
                                "zh": "在农场多年高强度使用后，马车的<w>车轴垫木</w>已经磨损了。"
                            }
                        },
                        {
                            "text": "The front wheels turned smoothly thanks to the well-greased <w>bolster</w>.",
                            "target_lang_translations": {
                                "zh": "多亏了润滑良好的<w>车轴垫木</w>，前轮转动得很顺畅。"
                            }
                        }
