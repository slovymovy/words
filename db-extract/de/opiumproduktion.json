                            {
                                "example_id": "82a74373-b91a-408b-b5e4-89efb640dff5",
                                "sense_id": "12b368d4-8766-3a68-a410-816550f63d9a",
                                "text": "„Auf diese Weise könnten sie drei Monate lang im Tiefflug über den Mohnfeldern kreisen und die Opiumproduktion um die Hälfte reduzieren.“"
                            },
                            {
                                "example_id": "7918a05a-856e-40e4-91e8-94fcd310be72",
                                "sense_id": "12b368d4-8766-3a68-a410-816550f63d9a",
                                "text": "„Als sich die Kontrolle der Taliban 1997 über Kabul hinaus nordwärts erweiterte, stieg Afghanistans Opiumproduktion um weitere beeindruckende 25 Prozent auf 2800 Tonnen.“"
                            },
                            {
                                "example_id": "bcdd456e-6f81-405f-83c5-f4c24e96f39c",
                                "sense_id": "12b368d4-8766-3a68-a410-816550f63d9a",
                                "text": "„Die USA brauchten also Morphin für den Krieg und forderten daher Mexiko auf, die Opiumproduktion zu erhöhen.“"
                            }
                        ],
