                        "entry_id": "4429e3c1-92bb-3bd3-a1c3-582a9a91a691",
                        "glosses": [
                            "knapp 30 Zentimeter großer, in Nordeuropa vorkommender Zwergfalke mit spitzen Flügeln und schwarzer Bartbinde am Kopf, graublauem (Männchen) oder braunem (Weibchen) Gefieder auf der Oberseite"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0512f0ae-3c10-4302-af6b-c09bb9430d74",
                                "sense_id": "cbadec6e-44c7-34a8-815d-17dea66fc456",
                                "text": "Der Merlin täuscht seine Beutevögel häufig, indem er ihre Flugweise imitiert, um unbemerkt nah heranzukommen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
