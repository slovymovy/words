                                "target_senses": [
                                    {
                                        "sense_id": "0e6e8ed1-2faa-3df6-99ad-eaa2c2e570e2",
                                        "entry_id": "d723e9cf-673f-309e-8988-06b8f84650af",
                                        "glosses": [
                                            "achter Tag der Dekade des französischen Revolutionskalenders"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7665ad31-261d-4c34-9c2a-c14a784c529d",
                                                "sense_id": "0e6e8ed1-2faa-3df6-99ad-eaa2c2e570e2",
                                                "text": "„Vorgestern… glaubst Du… es war am Nonidi, oder am Octidi… nein, ich glaube, es war am Decadi… Bin ich am Decadi hier gewesen, Bürgerin?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea534925-bed5-4782-9657-d05c701fe038",
                        "source_entry_id": "8877c1eb-a543-3c0c-be02-a0269c77eadc",
                        "source_sense_id": "8c220a6e-06a7-34b2-b586-e3a4885d8fed",
                        "target_lang_word": "Oktidi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oktidi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec701c8f-04a0-3a10-844b-60ff70ea4686",
                                        "entry_id": "552f369b-c93f-39bf-8358-9b1c2e45b0a7",
                                        "glosses": [
                                            "achter Tag der Dekade des französischen Revolutionskalenders"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "487f37e6-f04e-4775-8ffb-f84770afdd70",
                                                "sense_id": "ec701c8f-04a0-3a10-844b-60ff70ea4686",
                                                "text": "„Die militairische Hygiene soll am Quartidi und am Oktidi von 11 bis 12 von einem der Aerzte gegeben werden.“"
                                            },
                                            {
                                                "example_id": "21f5bd0c-61d9-4e42-9caa-757f257248f4",
                                                "sense_id": "ec701c8f-04a0-3a10-844b-60ff70ea4686",
                                                "text": "„An jedem Oktidi fanden Exkursionen statt.“"
                                            },
                                            {
                                                "example_id": "4e57f5a2-9a61-4edf-a9f5-6bc9b253624e",
                                                "sense_id": "ec701c8f-04a0-3a10-844b-60ff70ea4686",
                                                "text": "„Jede Klasse des Instituts versammelt sich zweimal in jeder Dekade: die erste Klasse, Primidi und Sextidi; die zweite, Duodi und Septidi; und die dritte, Tridi und Oktidi.“"
                                            },
                                            {
                                                "example_id": "e4d5b92f-0668-42e3-ac95-1b16802a65bf",
                                                "sense_id": "ec701c8f-04a0-3a10-844b-60ff70ea4686",
                                                "text": "„Man kann in Gazette nationale ou Moniteur universal, No 8, An 2, Oktidi 8. Vendemiaire (≙ 29. Sept. 1793), den Vorschlag lesen zur Gründung der École des Travaux Publics, der späteren École Polytechnique, vorgetragen in der Konvention vom Abgeordneten und berühmten Chemiker Fourcroy: […]“"
                                            },
                                            {
                                                "example_id": "8b0c13a0-42ef-4330-bc4a-386f0cb01b2c",
                                                "sense_id": "ec701c8f-04a0-3a10-844b-60ff70ea4686",
                                                "text": "„Die 30 Tage der Monate werden in 3 Decaden, jede zu 10 Tagen getheilt und heissen: Primidi, Duodi, Tridi, Quartidi, Quintidi, Sextidi, Septidi, Oktidi, Nonidi, Decadi.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
