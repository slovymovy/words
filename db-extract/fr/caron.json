                            {
                                "example_id": "1c2f3299-14eb-414a-98ed-97781acfcbd7",
                                "sense_id": "038fb9b5-2c91-3597-9f98-a0c2a862f5ed",
                                "text": "\"Malheureusement, j’aimerais dire l’inverse, mais [la situation] s’est dégradée\", concède d’emblée Catherine Caron, analyste des politiques et des campagnes chez Oxfam-Québec, lors d’un entretien téléphonique."
                            },
                            {
                                "example_id": "46be1f77-5213-4731-b6df-e1d8e1e23b1a",
                                "sense_id": "038fb9b5-2c91-3597-9f98-a0c2a862f5ed",
                                "text": "je vais envoyer Caron, le chauffeur, avec Étienne Fourassol."
                            }
                        ]
