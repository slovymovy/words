                    }
                ],
                "translations": [
                    {
                        "translation_id": "de1f06d2-4223-40b7-9778-abbfec2dc04c",
                        "source_entry_id": "401831e4-162d-3c76-9851-add99f466467",
                        "source_sense_id": "092e2a28-7637-3816-9a6e-9b1419c91939",
                        "target_lang_word": "shade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71edcdc2-962b-39ce-b897-dd1ef4695f65",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "Darkness where light, particularly sunlight, is blocked."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "031f92f5-88f2-4ba1-9cf3-88b8310dfb40",
                                                "sense_id": "71edcdc2-962b-39ce-b897-dd1ef4695f65",
                                                "text": "The old oak tree gave shade in the heat of the day."
                                            },
                                            {
                                                "example_id": "70f31b5f-f925-4133-9ed5-1815c97e752a",
                                                "sense_id": "71edcdc2-962b-39ce-b897-dd1ef4695f65",
                                                "text": "Temps rose to a sweltering 40 degrees Celsius in the shade."
                                            },
                                            {
                                                "example_id": "ac24d5ad-e6ef-484d-b847-10ea0237212d",
                                                "sense_id": "71edcdc2-962b-39ce-b897-dd1ef4695f65",
                                                "text": "Now we plunged into a deep shade with the boughs lacing each other overhead, and crossed dainty, rustic bridges over the cold trout-streams, the boards giving back the clatter of our horses' feet:[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1c999ad-4bb7-35a2-8993-ecda66de1753",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "Something that blocks light, particularly in a window."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ac55076-e523-4e0b-ad74-5ae7cbc5fe0e",
                                                "sense_id": "e1c999ad-4bb7-35a2-8993-ecda66de1753",
                                                "text": "Close the shade, please: it's too bright in here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a29c6bc8-c78f-37f9-8549-ceb0347d5934",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "A variety of a color, in particular one obtained by adding black (compare tint)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e8e866d-522c-46ed-9239-06fd411ca8c9",
                                                "sense_id": "a29c6bc8-c78f-37f9-8549-ceb0347d5934",
                                                "text": "I've painted my room in five lovely shades of pink and chartreuse."
                                            },
                                            {
                                                "example_id": "ce435374-cff9-4adb-a832-1ff0d95c4ed1",
                                                "sense_id": "a29c6bc8-c78f-37f9-8549-ceb0347d5934",
                                                "text": "Thus light and colours, as white, red, yellow, blue, with their several degrees or shades, and mixtures, as green, scarlet, purple, sea-green, and the rest, come in only by the eyes[…]"
                                            },
                                            {
                                                "example_id": "deb1f7b1-48f6-4152-bdb2-7c9fccf0e8bc",
                                                "sense_id": "a29c6bc8-c78f-37f9-8549-ceb0347d5934",
                                                "text": "Speaking of round sunglasses, these lightweight polarized ones and come in two shades of tortoiseshell as well as black and bronze."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cef2214f-1e56-3283-b11a-6251e05487d8",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "A subtle variation in a concept."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7443f505-efc6-4baf-8d5b-de5a52927e71",
                                                "sense_id": "cef2214f-1e56-3283-b11a-6251e05487d8",
                                                "text": "shades of meaning"
                                            },
                                            {
                                                "example_id": "f4651c05-f8de-4ca2-9323-6bbc3e8cd54e",
                                                "sense_id": "cef2214f-1e56-3283-b11a-6251e05487d8",
                                                "text": "new shades and combinations of thought"
                                            },
                                            {
                                                "example_id": "f29fd327-b867-42f4-b0fb-9734a9a8fbb0",
                                                "sense_id": "cef2214f-1e56-3283-b11a-6251e05487d8",
                                                "text": "Every shade of religious and political opinion had its own headquarters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc678a51-ebfd-3e9c-b120-8958d10e0dff",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "An aspect that is reminiscent of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "123f6497-bb40-4707-b245-cb6dc238adce",
                                                "sense_id": "dc678a51-ebfd-3e9c-b120-8958d10e0dff",
                                                "text": "shades of Groucho Marx"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16fbc8f7-6c54-379e-a888-df092b2ebf45",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "A very small degree of a quantity, or variety of meaning"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8009be6d-629b-472a-985e-b39cb370e7ce",
                                                "sense_id": "16fbc8f7-6c54-379e-a888-df092b2ebf45",
                                                "text": "That is a shade too close."
                                            },
                                            {
                                                "example_id": "93c253bc-94d1-4eb6-89af-d9b35f6542b4",
                                                "sense_id": "16fbc8f7-6c54-379e-a888-df092b2ebf45",
                                                "text": "Mrs. Rhodes who (so I gathered from Mr. Petherick's careful language) was perhaps just a shade of a hypochondriac, had retired to bed immediately after dinner."
                                            },
                                            {
                                                "example_id": "6c958494-9a84-494c-ba0b-efd3eac8022a",
                                                "sense_id": "16fbc8f7-6c54-379e-a888-df092b2ebf45",
                                                "text": "Five feet in diameter and a shade above knee high, the center of the fragile white canvass structure is filled with […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aca9e622-efa5-3edb-a707-a619c69ed1f4",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "A ghost or specter; a spirit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "literary",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19ce0958-1810-4ea5-af55-362c5ba84ff1",
                                                "sense_id": "aca9e622-efa5-3edb-a707-a619c69ed1f4",
                                                "text": "Too long have I been haunted by that shade."
                                            },
                                            {
                                                "example_id": "9723a3f5-9ffa-4ae8-abaf-f82ddf0b5082",
                                                "sense_id": "aca9e622-efa5-3edb-a707-a619c69ed1f4",
                                                "text": "The adventurer was attacked by a shade."
                                            },
                                            {
                                                "example_id": "92877aef-8fcb-43ac-88af-1f2b06257d3a",
                                                "sense_id": "aca9e622-efa5-3edb-a707-a619c69ed1f4",
                                                "text": "Swift as thought the flitting shade / Thro' air his momentary journey made."
                                            },
                                            {
                                                "example_id": "8f1c1c40-c8c7-4fe8-99f6-5dc76655dace",
                                                "sense_id": "aca9e622-efa5-3edb-a707-a619c69ed1f4",
                                                "text": "Still, Birch House (a sop to the shade of the murdered Perak Resident) had no more than its normal share of flagellation[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f973344-5b07-320b-8fb1-6025c3541438",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "A postage stamp showing an obvious difference in colour/color to the original printing and needing a separate catalogue/catalog entry."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f0b1711-6ce2-3a1a-96a8-f88eb9db6ea3",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "Subtle insults."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9786b2c5-f6d7-457a-b1fc-d2611e1717e1",
                                                "sense_id": "2f0b1711-6ce2-3a1a-96a8-f88eb9db6ea3",
                                                "text": "throw shade"
                                            },
                                            {
                                                "example_id": "db9ebb5d-5320-4cde-a388-18061761aa6d",
                                                "sense_id": "2f0b1711-6ce2-3a1a-96a8-f88eb9db6ea3",
                                                "text": "Why did you paint your room chartreuse? No shade; I'm genuinely curious."
                                            },
                                            {
                                                "example_id": "c6ab0da7-a0f5-4a5e-830f-ca7fa6637334",
                                                "sense_id": "2f0b1711-6ce2-3a1a-96a8-f88eb9db6ea3",
                                                "text": "Shade is: \"I don't tell you you're ugly, but I don't have to tell you because you know you're ugly.\" And that's shade."
                                            },
                                            {
                                                "example_id": "0413caa2-2862-44a8-b8dc-be3ba2ce5d78",
                                                "sense_id": "2f0b1711-6ce2-3a1a-96a8-f88eb9db6ea3",
                                                "text": "In a recent interview with Pitchfork, Carey offered her explanation for how the moment of shade came about."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3593da2-9e71-375c-8609-8c64dec48ad5",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "A cover around or above a light bulb, a lampshade."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8adc8260-062b-4611-a04e-0f15ee4dbc6a",
                                                "sense_id": "a3593da2-9e71-375c-8609-8c64dec48ad5",
                                                "text": "Lighting was unimaginative for the standard stock with naked tungsten filament bulbs and metal reflectors. However, all compartments had individual reading lights above the seats with attractive glass shades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8e343e4-db91-3679-8510-e386b9f41362",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "A candle-shade."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50898fb9-7aea-4959-bf88-9830847363cf",
                                                "sense_id": "d8e343e4-db91-3679-8510-e386b9f41362",
                                                "text": "I am now finishing this letter by candle-light, with the help of a handkerchief tied over the shade."
                                            },
                                            {
                                                "example_id": "d2f64e03-e2df-4585-8b2e-39e6864c619e",
                                                "sense_id": "d8e343e4-db91-3679-8510-e386b9f41362",
                                                "text": "His tent is furnished with a good large bed, mattress, pillow, &c., a few camp-stools or chairs, a folding table, a pair of shades for his candles, six or seven trunks with table equipage, his stock of linen (at least 24 shirts); some dozens of wine, brandy, and gin; tea, sugar, and biscuit; and a hamper of live poultry and his milch-goat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0cc0e27-f792-3ecd-a438-a6018f073596",
                                        "entry_id": "36ee13c3-4956-39b8-bc02-20f35e2eada4",
                                        "glosses": [
                                            "To shield (someone or something) from light."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26daac34-b9ed-4393-8c19-cafa3cd5bb44",
                                                "sense_id": "f0cc0e27-f792-3ecd-a438-a6018f073596",
                                                "text": "The old oak tree shaded the lawn in the heat of the day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf9799a7-18a5-36fe-b6b4-0e87d2de7dea",
                                        "entry_id": "36ee13c3-4956-39b8-bc02-20f35e2eada4",
                                        "glosses": [
                                            "To shield oneself from light."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88451f9a-7085-4c9f-870f-46a22dbee22f",
                                                "sense_id": "bf9799a7-18a5-36fe-b6b4-0e87d2de7dea",
                                                "text": "We shaded under a huge oak tree."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2aa2b2d-34d9-3ae6-b90e-d9d7de9f9db5",
                                        "entry_id": "36ee13c3-4956-39b8-bc02-20f35e2eada4",
                                        "glosses": [
                                            "To alter slightly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36a36eb1-31be-4230-a8e2-d3a283f82ddb",
                                                "sense_id": "a2aa2b2d-34d9-3ae6-b90e-d9d7de9f9db5",
                                                "text": "You'll need to shade your shot slightly to the left."
                                            },
                                            {
                                                "example_id": "edf8b86e-da02-415b-bd7f-5847ea275650",
                                                "sense_id": "a2aa2b2d-34d9-3ae6-b90e-d9d7de9f9db5",
                                                "text": "Most politicians will shade the truth if it helps them."
                                            }
                                        ]
                                    },
