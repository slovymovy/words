                        "glosses": [
                            "Aphasie, impossibilité de parler."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "585e2f4d-9cb6-4523-99a7-f8518f589116",
                                "sense_id": "fe9b0281-267f-3287-b977-426896f659d5",
                                "text": "Lordat parlait d’ailleurs d’alalie, comme Broca parla d’aphémie, avant que Trousseau eût imposé le terme d’aphasie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "144d02c1-5dfe-4546-b005-8d2e1bc6dac0",
