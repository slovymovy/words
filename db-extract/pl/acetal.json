                                "sense_id": "d7860a7f-afd4-3a5b-9a18-80dfb88c69cf",
                                "text": "Acetale otrzymywane z ketonów nazywane są ketalami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3bd6ba44-c209-3592-b020-4239ec2c78c3",
