    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b1e25af7-a445-3428-8559-d18d12561f1b",
                "word": "Shirley",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c2c98aed-ae50-3793-8559-80bd244543c3",
                        "entry_id": "b1e25af7-a445-3428-8559-d18d12561f1b",
                        "glosses": [
                            "surely"
                        ],
                        "tags": [
                            "humorous",
                            "informal",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "0fc6311a-9604-4226-846e-8c80b76658b9",
                                "sense_id": "c2c98aed-ae50-3793-8559-80bd244543c3",
                                "text": "Shirley the pepper mills are whipped away by the peppier after use, so no danger there. But what about the candles?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e2841f17-617a-35dc-9293-e7248716cb0d",
                "word": "Shirley",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3c83eeea-9e00-32fe-be3d-4f65e580e1fa",
                        "entry_id": "e2841f17-617a-35dc-9293-e7248716cb0d",
                        "glosses": [
                            "An English habitational surname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ea09047-83f2-4440-8827-ac3510e51abd",
                                "sense_id": "3c83eeea-9e00-32fe-be3d-4f65e580e1fa",
                                "text": "Hold vp they head, vile Scot, or thou art like / Neuer to hold it vp againe! the spirits / Of valiant Sherley, Stafford, Blunt, are in my Armes;"
                            }
                        ]
                    },
                    {
                        "sense_id": "54976a46-85fe-3a2b-8932-8e2be8fdbe13",
                        "entry_id": "e2841f17-617a-35dc-9293-e7248716cb0d",
                        "glosses": [
                            "A male given name transferred from the surname."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d58273b8-32cf-4d69-80d2-ca7a4c9afe78",
                                "sense_id": "54976a46-85fe-3a2b-8932-8e2be8fdbe13",
                                "text": "Shirley Blythe was with Una Meredith and both were rather silent because such was their nature. Shirley was a lad of sixteen, sedate, sensible, thoughtful, full of a quiet humour."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ec6176a-4b06-31a9-9fcb-8c2858bf371a",
                        "entry_id": "e2841f17-617a-35dc-9293-e7248716cb0d",
                        "glosses": [
                            "A female given name transferred from the surname, popular from the 1920s to the 1950s."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28abc5ab-7d5e-439c-aac1-7b80ee3534ba",
                                "sense_id": "3ec6176a-4b06-31a9-9fcb-8c2858bf371a",
                                "text": "Shirley Keeldar (she had no christian name but Shirley: her parents, who had wished to have a son, finding that, after eight years of marriage, Providence had granted them only a daughter, bestowed on her the same masculine family cognomen they would have bestowed on a boy, if with a boy they had been blessed)—[…]"
                            },
                            {
                                "example_id": "5d1f3e01-4092-4bb0-9caa-928e4d9541b2",
                                "sense_id": "3ec6176a-4b06-31a9-9fcb-8c2858bf371a",
                                "text": "\"Why a girl like you should be named Shirley is beyond me. You haven't a ruffle or a furbelow anywhere in your nature.\" \"Is that meant for an insult?\" she asked, flushing angrily. \"No, it's just that it's incongruous. You are the 'give us this day our daily bread' sort of person. Shirley is party stuff.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "490ab407-a117-378c-ba35-75bbaa979447",
