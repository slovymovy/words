                ],
                "senses": [
                    {
                        "sense_id": "10406250-4801-3b33-89c7-64b7fd1cf45c",
                        "entry_id": "a4fd2338-cb2b-3789-9417-85830f999dd9",
                        "glosses": [
                            "Boucher (un conduit du corps)."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "da20552f-0a5c-4736-8ab7-f048da9b2b7c",
                                "sense_id": "10406250-4801-3b33-89c7-64b7fd1cf45c",
                                "text": "Car le medicament suppuratif doit oppiler & boucher les pores, afin de tenir enclose & renfermée la chaleur naturelle."
                            },
                            {
                                "example_id": "d9179c97-7d7c-4307-95f7-1f87418f32dd",
                                "sense_id": "10406250-4801-3b33-89c7-64b7fd1cf45c",
                                "text": "Or les mauuvais humeurs, comme aussi les copieux, oppilent les conduits en les farsissant, parquoy ils les disposent à la peste."
                            },
                            {
                                "example_id": "03fe21c4-71e8-48fc-ae86-0d6266d24345",
                                "sense_id": "10406250-4801-3b33-89c7-64b7fd1cf45c",
                                "text": "Je n’avais plus qu’une envie, m’oppiler pour me faire défoncer le crâne ensuite, gentiment."
                            }
                        ]
                    }
                ],
