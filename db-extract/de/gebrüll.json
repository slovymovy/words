                        "entry_id": "9889ceb1-93c7-3773-a342-83a5989873f0",
                        "glosses": [
                            "the act of roaring, shouting, the sound of roars, shouts"
                        ],
                        "tags": [
                            "neuter",
                            "no-plural",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "a6a0357c-7ead-492b-ab04-522086f4f7d5",
                                "sense_id": "9a8c9a0c-10dd-3d68-93cd-097ffe66405a",
                                "text": "Ich konnte das Gebrüll bis nach draußen hören.",
                                "translation": "I could hear the shouts even from outside.",
                                "english": "I could hear the shouts even from outside."
                            },
                            {
                                "example_id": "19a0e05f-8d13-4b86-9115-624a29652f96",
                                "sense_id": "9a8c9a0c-10dd-3d68-93cd-097ffe66405a",
                                "text": "Mit Gebrüll erreichst du bei mir nichts.",
                                "translation": "You won’t achieve anything with me by shouting.",
                                "english": "You won’t achieve anything with me by shouting."
                            }
                        ]
                    }
