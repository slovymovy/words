                    {
                        "sense_id": "fa7a7701-3d35-370d-8101-bf53e34e9929",
                        "entry_id": "618f4abd-c233-3ad3-8dac-b5520e9c9b34",
                        "glosses": [
                            "Kept out; not permitted to enter or be a part; shunned."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee6f5ad4-d158-4a0c-9011-49b6eb569a9b",
                                "sense_id": "fa7a7701-3d35-370d-8101-bf53e34e9929",
                                "text": "For community development, the racism resulting from the global economic system is all too frequently played out in those communities that are most excluded – inner-city neighbourhoods and public housing estates."
                            },
                            {
                                "example_id": "0becc1f0-45f2-4969-8cb3-5ef3a74c8517",
                                "sense_id": "fa7a7701-3d35-370d-8101-bf53e34e9929",
                                "text": "I was feeling very excluded from the group of people I had been mixing with for the past two years ."
                            },
                            {
                                "example_id": "49840a2c-90c0-4320-b1e7-b9123a9d4c40",
                                "sense_id": "fa7a7701-3d35-370d-8101-bf53e34e9929",
                                "text": "The figures also show a persistent pattern; black pupils are three and a half times more likely than their white peers to be excluded and boys are more likely to be ''excluded than girls; children with special needs are likely to be more excluded than others."
                            }
                        ]
                    }
