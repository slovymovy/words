                    },
                    {
                        "sense_id": "d8b281c6-827b-3c7e-8dfd-9f4cd20b76c2",
                        "entry_id": "b04f8e3e-60fe-3775-a025-e2c38d3615d5",
                        "glosses": [
                            "een plaats waar goederen bij opbod of afslag verkocht worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0631923-809d-49d4-a2f2-e97243b0122a",
                                "sense_id": "d8b281c6-827b-3c7e-8dfd-9f4cd20b76c2",
                                "text": "Het is 81 dagen nadat hij de duurste levende kunstenaar van het heelal werd met de veiling van een van zijn zwembadschilderijen, en hij zet zijn ronde, gele bril recht op de neus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61a0efda-c5ea-4996-8f20-1c9fac7cc97c",
                        "source_entry_id": "b04f8e3e-60fe-3775-a025-e2c38d3615d5",
                        "source_sense_id": "ed83f868-23f6-3565-a1d9-bb7b51f0ac22",
                        "source_sense_description": "een plaats waar goederen bij opbod of afslag verkocht worden",
                        "target_lang_word": "Auktion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auktion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcde30e2-983b-3f76-be62-135ba1d9a5da",
                                        "entry_id": "ea4bcd57-a47e-356f-b220-7572ec431fd3",
                                        "glosses": [
                                            "Veranstaltung, bei der Gegenstände versteigert werden, das heißt an die meistbietende Person verkauft werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f88ad5a-b531-467c-9482-06397d0790dc",
                                                "sense_id": "bcde30e2-983b-3f76-be62-135ba1d9a5da",
                                                "text": "Die kostbaren Ölgemälde werden auf einer Auktion versteigert."
                                            },
                                            {
                                                "example_id": "48808579-6cce-4859-9768-9e06189985db",
                                                "sense_id": "bcde30e2-983b-3f76-be62-135ba1d9a5da",
                                                "text": "„Die Neuankömmlinge waren nicht wählerisch, sondern ersteigerten auf den monatlichen Auktionen das erstbeste erhältliche Land.“"
                                            },
                                            {
                                                "example_id": "8374787a-9b75-4a69-8c75-6ffbc806c613",
                                                "sense_id": "bcde30e2-983b-3f76-be62-135ba1d9a5da",
                                                "text": "„Denn Ketterer erhielt den Auftrag, die Auktion abhalten zu dürfen.“"
                                            },
                                            {
                                                "example_id": "86ed3a4b-1d3b-4000-92b8-006d39745707",
                                                "sense_id": "bcde30e2-983b-3f76-be62-135ba1d9a5da",
                                                "text": "„Die Auktionen sind Plattformen für Käufer aus Deutschland und der gesamten Europäischen Union.“"
                                            },
                                            {
                                                "example_id": "93bf41d7-b6da-4402-9b55-e1b7d763e11c",
                                                "sense_id": "bcde30e2-983b-3f76-be62-135ba1d9a5da",
                                                "text": "„Diesmal wechselten Jean und ich einen Blick – wir, die wir von genau solchen Auktionen lebten, hatten hier nicht den Luxus der moralischen Überlegenheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "492afe70-0a5c-4edb-bd91-07c2665c2dee",
                        "source_entry_id": "b04f8e3e-60fe-3775-a025-e2c38d3615d5",
                        "source_sense_id": "ed83f868-23f6-3565-a1d9-bb7b51f0ac22",
                        "source_sense_description": "een plaats waar goederen bij opbod of afslag verkocht worden",
                        "target_lang_word": "Versteigerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Versteigerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ed8c31e-750a-3f8c-8578-92fe16030d8b",
                                        "entry_id": "874f3c04-f7f0-32aa-801f-88ed293929a9",
                                        "glosses": [
                                            "Veranstaltung, wo mehrere Personen (Bieter) ihr Gebot zu einer Sache abgeben können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8722eba5-0fbe-4624-aec8-753416759d36",
                                                "sense_id": "7ed8c31e-750a-3f8c-8578-92fe16030d8b",
                                                "text": "Zur Versteigerung der Hinterlassenschaften des Millionärs kamen sehr viele Leute."
                                            },
                                            {
                                                "example_id": "001111da-5293-4ccc-a0a9-461ec4516ca9",
                                                "sense_id": "7ed8c31e-750a-3f8c-8578-92fe16030d8b",
                                                "text": "„Die Versteigerung wird genauso ablaufen, wie Efe sich eine solche vorgestellt hatte: ein Haus in Brüssel, Drinks gratis, sanfte Musik.“"
                                            },
                                            {
                                                "example_id": "bd9f64f0-5894-47aa-93b0-5a8b6f0e0d2f",
                                                "sense_id": "7ed8c31e-750a-3f8c-8578-92fe16030d8b",
                                                "text": "„Er arbeitete bei Carlota in ihrem Antiquitätengeschäft, und er hatte die fraglichen Stunden damit zugebracht, Rechnungen durchzusehen und eine Reise nach London vorzubereiten, wo er bei einer Versteigerung englische Antiquitäten erstehen wollte.“"
                                            },
                                            {
                                                "example_id": "c04e6d9d-0e35-4af4-9834-e5c404029210",
                                                "sense_id": "7ed8c31e-750a-3f8c-8578-92fe16030d8b",
                                                "text": "„Amalia und ich hatten zahlreiche Bestandsauflösungen und Versteigerungen besucht, ich wusste also, wie das ablief.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7b83d355-211d-31e9-85b8-6784c0d35f63",
                                        "entry_id": "874f3c04-f7f0-32aa-801f-88ed293929a9",
                                        "glosses": [
                                            "Vorgang, in dem etwas zum höchst gebotenen Preis verkauft wird"
                                        ],
                                        "tags": [
                                            "nur Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e31e048-34a9-4900-b9e2-c6e279002a0b",
                                                "sense_id": "7b83d355-211d-31e9-85b8-6784c0d35f63",
                                                "text": "Mehrere Perserteppiche wurden zur Versteigerung angeboten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5162a10-690f-4d71-a805-d7637ac0a953",
                        "source_entry_id": "b04f8e3e-60fe-3775-a025-e2c38d3615d5",
                        "source_sense_id": "ed83f868-23f6-3565-a1d9-bb7b51f0ac22",
                        "source_sense_description": "een plaats waar goederen bij opbod of afslag verkocht worden",
                        "target_lang_word": "auction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1995c324-b5b8-33cd-9d68-2e3c88947bc4",
                                        "entry_id": "226b4757-fc63-3586-b8e7-97f1c8a038c1",
                                        "glosses": [
                                            "A public event where goods or property are sold to the highest bidder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8a82994-69f1-4c90-8b04-29b98fef03ff",
                                                "sense_id": "1995c324-b5b8-33cd-9d68-2e3c88947bc4",
                                                "text": "Auctions come in a wide variety. In a “Dutch auction”, often used to sell flowers and fruit, prices start high and gradually drop until a bidder is willing to pay up. A “Japanese auction” is a bit like poker: bids rise with each round and anyone who wants to win must bid every time. Vendors using auctions rid themselves of the headache of choosing prices and instead just pick the rules bidders must follow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cfd6ed8-2dce-3e53-944f-05b1ccf67d50",
                                        "entry_id": "226b4757-fc63-3586-b8e7-97f1c8a038c1",
                                        "glosses": [
                                            "The first stage of a deal, in which players bid to determine the final contract."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "auction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41c7d082-3624-3114-8079-97fa29233f7c",
                                        "entry_id": "1d2c805d-11ac-303a-bf57-c4d24c42baa0",
                                        "glosses": [
                                            "To sell at an auction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "859e097a-b600-4f47-a835-0fd614aa948b",
                        "source_entry_id": "b04f8e3e-60fe-3775-a025-e2c38d3615d5",
                        "source_sense_id": "ed83f868-23f6-3565-a1d9-bb7b51f0ac22",
                        "source_sense_description": "een plaats waar goederen bij opbod of afslag verkocht worden",
                        "target_lang_word": "enchère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enchère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0178ca27-918c-3d00-ba24-e266256e252c",
                                        "entry_id": "87adfdff-3365-34a3-958b-5cd4d58052b8",
                                        "glosses": [
                                            "Offre d’un prix supérieur à la mise à prix, ou au prix qu’un autre a déjà offert, en parlant des choses qui se vendent ou s’afferment au plus offrant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eb8483b-eb6d-45d0-877b-b28609b715e2",
                                                "sense_id": "0178ca27-918c-3d00-ba24-e266256e252c",
                                                "text": "De là, instance; puis jugement du tribunal de première instance de Châtelleraut, du 24 mai 1811, qui déclare la vente valable, et condamne Grosset à en payer le prix, - « Attendu que, s'agissant d'une adjudication aux enchères, le contrat est formé, dans ce cas, par la seule position de l’enchère de la part de l'enchérisseur, qui ne peut être dégagé que par une enchère supérieure; […]. »"
                                            },
                                            {
                                                "example_id": "a7dcefcc-a05d-4f64-b475-fe297752474c",
                                                "sense_id": "0178ca27-918c-3d00-ba24-e266256e252c",
                                                "text": "Cette procédure consiste à remettre en vente l’objet aux risques de l’adjudicataire défaillant, qui se voit ainsi tenu de la différence entre son enchère et le prix payé par l’acheteur final."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77c31caa-44cc-3645-acc4-2cca553243d1",
                                        "entry_id": "87adfdff-3365-34a3-958b-5cd4d58052b8",
                                        "glosses": [
                                            "Vente aux enchères."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f3a449a-4882-4106-b405-4f5bf6afdef5",
                                                "sense_id": "77c31caa-44cc-3645-acc4-2cca553243d1",
                                                "text": "En 1552, un édit d'Henri II vient renforcer la notoriété des enchères. Cet édit institue les offices de « maîtres priseurs vendeurs de biens meubles » et leur confère le monopole des estimations et des ventes aux enchères de bien meules de seconde main."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdc24192-fe7b-3ee9-b167-90eeecaa07e7",
                                        "entry_id": "87adfdff-3365-34a3-958b-5cd4d58052b8",
                                        "glosses": [
                                            "Engagement de réaliser un contrat supérieur à celui de l'adversaire."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a64defd6-b0bd-43e9-9e4f-b1932d8b577e",
                                                "sense_id": "fdc24192-fe7b-3ee9-b167-90eeecaa07e7",
                                                "text": "Mais un joueur lance une enchère s'il estime que son jeu lui permet de jouer seul contre ses trois adversaires réunis. Il dit alors « Je prends », « Je garde », « Je garde sans le Chien » ou « Je garde contre le Chien ». Les autres joueurs, placés à sa droite peuvent éventuellement couvrir cette première enchère par une enchère supérieure."
                                            },
                                            {
                                                "example_id": "3911b29e-611f-409f-a84d-6df9a345e43d",
                                                "sense_id": "fdc24192-fe7b-3ee9-b167-90eeecaa07e7",
                                                "text": "Le bridge tel qu'il se pratique aujourd'hui est le bridge-contrat, inventé en 1926, par l'Américain Harold Vanderbilt, qui supplanta progressivement le bridge-plafond, lui-même dérivé de l'ancien et très célèbre whist. Le bridge-plafond avait fait son apparition vers la fin du XIXᵉ s. Ces trois jeux, pratiquement identiques dans le déroulement du jeu de la carte, ne diffèrent que par la manière dont se font les enchères, ainsi que par le décompte des points."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6b5accd-9a23-31e3-9b1d-e53d108f5e20",
                                        "entry_id": "87adfdff-3365-34a3-958b-5cd4d58052b8",
                                        "glosses": [
                                            "Bassin qui recueillait le jus de raisin avant son transfert en tonneau."
                                        ],
                                        "tags": [
                                            "Viticulture",
                                            "Anjou"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9857f687-7c20-427e-8489-39c6f695c022",
                                                "sense_id": "c6b5accd-9a23-31e3-9b1d-e53d108f5e20",
                                                "text": "L’enchère est le bassin qui recueillait le liquide avant qu'il ne soit transféré dans des tonneaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
