            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b44a0db2-b6a1-3893-bf24-2329425e1534",
                    "sense_definition": "Rondom met een laag bedekken",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bedekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij moest zijn schouders en benen <w>omhullen</w> met een lap stof voordat hij de tempel mocht betreden.",
                            "target_lang_translations": {
                                "en": "He had to <w>wrap</w> his shoulders and legs with a piece of cloth before he was allowed to enter the temple."
                            }
                        },
                        {
                            "text": "De dikke mist <w>omhult</w> het hele landschap in de vroege ochtend.",
                            "target_lang_translations": {
                                "en": "The thick fog <w>envelops</w> the entire landscape in the early morning."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedekken",
                        "inpakken",
                        "omsluiten"
                    ],
                    "target_lang_definitions": {
                        "en": "To cover something completely with a layer of material or substance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "envelop",
                                "target_lang_sense_clarification": "To wrap up, cover, or surround completely."
                            },
                            {
                                "target_lang_word": "shroud",
                                "target_lang_sense_clarification": "To cover or conceal, often used for mist, fog, or darkness."
                            },
                            {
                                "target_lang_word": "wrap",
                                "target_lang_sense_clarification": "To cover by folding or winding something around."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d33c88f-4374-35d2-a5eb-b984a1112260",
                    "sense_definition": "Zichzelf rondom bedekken",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bedekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rups <w>omhulde</w> <w>zich</w> met een cocon van gesponnen zijde.",
                            "target_lang_translations": {
                                "en": "The caterpillar <w>enveloped itself</w> in a cocoon of spun silk."
                            }
                        },
                        {
                            "text": "Zij <w>omhulde</w> <w>zich</w> met een warme sjaal tegen de kou.",
                            "target_lang_translations": {
                                "en": "She <w>wrapped herself</w> in a warm scarf against the cold."
                            }
                        }
                    ],
                    "synonyms": [
                        "inwikkelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To cover oneself completely with something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wrap oneself",
                                "target_lang_sense_clarification": "To cover one's body with a garment or material."
                            },
                            {
                                "target_lang_word": "envelop oneself",
                                "target_lang_sense_clarification": "To surround or cover oneself completely."
                            }
                        ]
                    }
                }
            ]
        }
