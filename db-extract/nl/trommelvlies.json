                "senses": [
                    {
                        "sense_id": "d0ab40f5-e805-3e29-9d76-f6350a898bab",
                        "entry_id": "51f143c6-1819-396f-a0c6-7c52461a581d",
                        "glosses": [
                            "een membraan in het oor van zoogdieren, waaronder de mens, waarmee het oor geluid, in de vorm van luchttrillingen, opvangt"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7b99382-10c9-400d-9029-ea14dceea6d8",
                        "source_entry_id": "51f143c6-1819-396f-a0c6-7c52461a581d",
                        "source_sense_id": "d0ab40f5-e805-3e29-9d76-f6350a898bab",
                        "target_lang_word": "Trommelfell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trommelfell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9031e6e9-446b-3884-836b-b50a8c5f5453",
                                        "entry_id": "c329319b-162e-37ca-a5a3-6ad2b98c1cc5",
                                        "glosses": [
                                            "Membran, mit der eine Trommel oder ein anderes Membranophon bespannt ist"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db927750-d85f-4a1f-b0ed-7e879fd9e0ae",
                                                "sense_id": "9031e6e9-446b-3884-836b-b50a8c5f5453",
                                                "text": "Bei dieser Trommel muss das Trommelfell ersetzt werden."
                                            },
                                            {
                                                "example_id": "9a77c03e-d982-4073-ad1b-10e2f25e415c",
                                                "sense_id": "9031e6e9-446b-3884-836b-b50a8c5f5453",
                                                "text": "„Als er aufhörte zu trommeln, ließ er die Hände auf dem Trommelfell liegen, als wollte er sie nicht von ihrem Körper nehmen, und sie blickten einander weiter an – und dann zur Seite, als fürchteten sie, jeder hätte das Begehren zwischen ihnen hin- und herfließen sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aa30d97a-19bf-3669-a0c3-dc8c2676e9fe",
                                        "entry_id": "c329319b-162e-37ca-a5a3-6ad2b98c1cc5",
                                        "glosses": [
                                            "Membran, die Außenohr und Mittelohr trennt und die akustische Schwingungen aufnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a513359c-30fc-473d-9240-d4251cfcfc12",
                                                "sense_id": "aa30d97a-19bf-3669-a0c3-dc8c2676e9fe",
                                                "text": "Das Trommelfell ist beim Menschen etwa 0,1 mm dick."
                                            },
                                            {
                                                "example_id": "9269cd3c-efff-44b1-82ad-209c1f0eef76",
                                                "sense_id": "aa30d97a-19bf-3669-a0c3-dc8c2676e9fe",
                                                "text": "„Der Doktor konstatierte, dass das linke Trommelfell zerrissen, das rechte anscheinend beschädigt sei.“"
                                            },
                                            {
                                                "example_id": "31e82829-c339-42b2-be62-bbdd5380ffa7",
                                                "sense_id": "aa30d97a-19bf-3669-a0c3-dc8c2676e9fe",
                                                "text": "„Ich kramte die Ohrenstöpsel aus meinem Nachtbeutel und stopfte sie so tief in die Gehörgänge, bis sie ans Trommelfell stießen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc3ffb7d-9d15-4c46-a464-a90e1ca89aa5",
                        "source_entry_id": "51f143c6-1819-396f-a0c6-7c52461a581d",
                        "source_sense_id": "d0ab40f5-e805-3e29-9d76-f6350a898bab",
                        "target_lang_word": "eardrum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eardrum",
