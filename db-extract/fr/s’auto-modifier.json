                ],
                "senses": [
                    {
                        "sense_id": "2413d343-067f-34d4-ad98-e53313323670",
                        "entry_id": "b2d462ab-eac6-3cb1-bf59-8deec9bf30aa",
                        "glosses": [
                            "Se modifier soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d305502-b074-4897-9ecd-3e62fcde1bb0",
                                "sense_id": "2413d343-067f-34d4-ad98-e53313323670",
                                "text": "Et plus généralement, je m'intéresse aux différents moyens permettant à un programme de s'auto-modifier lui-même."
                            },
                            {
                                "example_id": "e4eefddb-4ad5-4fb5-a741-8a99c7a2f87d",
                                "sense_id": "2413d343-067f-34d4-ad98-e53313323670",
                                "text": "D'où l'idée de faire en sorte que les données soient contenues dans le module et que celui-ci puisse s'auto-modifier quand on ajoute de nouvelles définitions."
                            },
                            {
                                "example_id": "96a76a16-46f3-41e2-9265-971b9cc2ac27",
                                "sense_id": "2413d343-067f-34d4-ad98-e53313323670",
                                "text": "L'esprit risque de s'auto-modifier."
                            }
                        ]
                    }
