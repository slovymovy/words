                "senses": [
                    {
                        "sense_id": "399980bf-11d2-34c6-a7cd-eaa523c3bb96",
                        "entry_id": "608b7e33-8504-383c-9a8a-90ad82c0ff03",
                        "glosses": [
                            "Déroulement de la maladie, évolution de la maladie, forme de la maladie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cc8483b-2679-43dd-8046-070b726b4751",
                                "sense_id": "399980bf-11d2-34c6-a7cd-eaa523c3bb96",
                                "text": "Bestätigt wurden in China bislang 571 Erkrankte, davon haben laut WHO 95 einen schweren Krankheitsverlauf, 17 sind gestorben.",
                                "translation": "Jusqu'à présent, 571 cas ont été confirmés en Chine, dont 95 ont développé une forme grave de la maladie et 17 sont décédés, selon l'OMS."
                            },
                            {
                                "example_id": "bec795eb-7145-4371-9d41-fc3a71e89fb0",
                                "sense_id": "399980bf-11d2-34c6-a7cd-eaa523c3bb96",
                                "text": "Wir lernen gerade einiges über die Eigenschaften des Virus und den Krankheitsverlauf, das wir vor ein oder zwei Wochen noch nicht wussten."
                            }
                        ]
                    }
