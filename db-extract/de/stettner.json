                ],
                "senses": [
                    {
                        "sense_id": "84a90a5a-8784-3f56-a590-4b89e9ffeae5",
                        "entry_id": "1c96be10-67cc-31bc-b692-f4c49e357d5a",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a87cb034-bbab-4872-b030-3bae83001a73",
                                "sense_id": "84a90a5a-8784-3f56-a590-4b89e9ffeae5",
                                "text": "Frau Stettner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cee3fd7d-60d7-4089-bfe8-f547e86dc6f3",
                                "sense_id": "84a90a5a-8784-3f56-a590-4b89e9ffeae5",
                                "text": "Herr Stettner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "40a62021-1f33-4abf-b7d8-c0cd06f4653f",
                                "sense_id": "84a90a5a-8784-3f56-a590-4b89e9ffeae5",
                                "text": "Die Stettners fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "43f8b15d-c77d-4fdd-963a-7717b7371214",
                                "sense_id": "84a90a5a-8784-3f56-a590-4b89e9ffeae5",
                                "text": "Der Stettner trägt nie die Pullover, die die Stettner ihm strickt."
                            },
                            {
                                "example_id": "edf62116-1766-468e-80e2-080ec09be1d3",
                                "sense_id": "84a90a5a-8784-3f56-a590-4b89e9ffeae5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stettner kommt, geht der Herr Stettner.“"
                            },
                            {
                                "example_id": "1de4633a-5878-4928-b92c-a6d6332fe203",
                                "sense_id": "84a90a5a-8784-3f56-a590-4b89e9ffeae5",
                                "text": "Stettner kommt und geht."
                            },
                            {
                                "example_id": "1c2c89e8-60c0-4e1b-a0b1-2d831171c3a8",
                                "sense_id": "84a90a5a-8784-3f56-a590-4b89e9ffeae5",
                                "text": "Stettners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
