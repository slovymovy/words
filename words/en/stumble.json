{
    "word_family": [
        "stumbling",
        "stumbled",
        "stumbler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b2b70d0-5a19-3248-9da8-6862309e099c",
                    "sense_definition": "To trip or lose one's balance while walking or running; to move with unsteady steps.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>stumbled</w> over a rock while hiking up the steep mountain trail.",
                            "target_lang_translations": {
                                "ru": "Он <w>споткнулся</w> о камень, когда поднимался по крутой горной тропе.",
                                "zh": "他在攀登陡峭山路时被一块石头<w>绊倒</w>了。"
                            }
                        },
                        {
                            "text": "The tired traveler began to <w>stumble</w> along the path as the sun went down.",
                            "target_lang_translations": {
                                "ru": "Уставший путешественник начал <w>плестись</w> по тропе, когда солнце зашло.",
                                "zh": "日落时分，疲惫的旅行者开始在小路上<w>踉跄</w>前行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stumble along",
                        "stumble over",
                        "stumble blindly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Споткнуться или потерять равновесие при ходьбе или беге; идти нетвердой походкой.",
                        "zh": "走路或跑步时绊倒或失去平衡；步履蹒跚地走。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спотыкаться",
                                "target_lang_sense_clarification": "терять равновесие"
                            },
                            {
                                "target_lang_word": "оступаться",
                                "target_lang_sense_clarification": "неудачно ступить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绊倒",
                                "target_lang_sense_clarification": "失去平衡"
                            },
                            {
                                "target_lang_word": "踉跄",
                                "target_lang_sense_clarification": "步履不稳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7bf0d85-d2ef-30fb-8f98-e89b75074ee3",
                    "sense_definition": "To find or encounter something by chance or unexpectedly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "discovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I managed to <w>stumble</w> upon a rare book while browsing the old shop.",
                            "target_lang_translations": {
                                "ru": "Мне удалось случайно <w>наткнуться</w> на редкую книгу, пока я осматривал старую лавку.",
                                "zh": "我在逛那家旧书店时，<w>偶然发现</w>了一本珍稀书籍。"
                            }
                        },
                        {
                            "text": "Scientists often <w>stumble</w> across important discoveries while looking for something else entirely.",
                            "target_lang_translations": {
                                "ru": "Ученые часто случайно <w>совершают</w> важные открытия, когда ищут совсем другое.",
                                "zh": "科学家在寻找其他东西时，往往会<w>偶然发现</w>重要的科学发现。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stumble upon",
                        "stumble across"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случайно или неожиданно найти что-либо или наткнуться на что-либо.",
                        "zh": "偶然或意外地发现某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "натыкаться",
                                "target_lang_sense_clarification": "случайно находить"
                            },
                            {
                                "target_lang_word": "случайно обнаружить",
                                "target_lang_sense_clarification": "неожиданная находка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偶然发现",
                                "target_lang_sense_clarification": "意外找到"
                            },
                            {
                                "target_lang_word": "撞见",
                                "target_lang_sense_clarification": "无意中遇到"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1678fc7c-7625-30b9-bdc1-2da3738b6220",
                    "sense_definition": "To make a mistake or experience difficulty, especially when speaking or performing a task.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I always <w>stumble</w> over verbs in Spanish when I try to speak quickly.",
                            "target_lang_translations": {
                                "ru": "Я всегда <w>запинаюсь</w> на испанских глаголах, когда пытаюсь говорить быстро.",
                                "zh": "当我试图快速说话时，总会在西班牙语动词上<w>结巴</w>。"
                            }
                        },
                        {
                            "text": "The politician began to <w>stumble</w> through his speech after the difficult question.",
                            "target_lang_translations": {
                                "ru": "Политик начал <w>запинаться</w> во время своей речи после трудного вопроса.",
                                "zh": "面对那个棘手的问题后，这位政客的演讲开始变得<w>结巴</w>起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blunder"
                    ],
                    "common_phrases": [
                        "stumble over words",
                        "stumble through"
                    ],
                    "target_lang_definitions": {
                        "ru": "Допускать ошибки или испытывать трудности, особенно при разговоре или выполнении задания.",
                        "zh": "犯错或遇到困难，特别是在说话或执行任务时。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запинаться",
                                "target_lang_sense_clarification": "в речи"
                            },
                            {
                                "target_lang_word": "сбиваться",
                                "target_lang_sense_clarification": "терять нить или ошибаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结巴",
                                "target_lang_sense_clarification": "说话不流利"
                            },
                            {
                                "target_lang_word": "出错",
                                "target_lang_sense_clarification": "犯错"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fc18a6c-91a4-3dba-acd3-19cd28a11fb5",
                    "sense_definition": "To cause someone to trip or lose their balance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden shock of the news <w>stumbled</w> me back a few steps.",
                            "target_lang_translations": {
                                "ru": "Внезапный шок от новостей заставил меня <w>пошатнуться</w> на несколько шагов назад.",
                                "zh": "突如其来的消息令我震惊，使我向后<w>踉跄</w>了几步。"
                            }
                        },
                        {
                            "text": "The uneven pavement <w>stumbled</w> the runner during the final lap.",
                            "target_lang_translations": {
                                "ru": "Неровный тротуар заставил бегуна <w>споткнуться</w> на последнем круге.",
                                "zh": "不平坦的人行道使跑步者在最后一圈时<w>绊倒</w>了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-либо споткнуться или потерять равновесие.",
                        "zh": "使某人绊倒或失去平衡。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подновить",
                                "target_lang_sense_clarification": "заставить споткнуться"
                            },
                            {
                                "target_lang_word": "сбить с ног",
                                "target_lang_sense_clarification": "лишить равновесия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绊倒",
                                "target_lang_sense_clarification": "使人失去平衡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52c0cc83-2183-3f8e-9156-b63e2a2af7a8",
                    "sense_definition": "To mislead or cause someone to fall into error or confusion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex logic of the hypothesis <w>stumbles</w> me at the very foundation.",
                            "target_lang_translations": {
                                "ru": "Сложная логика гипотезы <w>сбивает</w> меня с толку в самом основании.",
                                "zh": "这个假设复杂的逻辑从根本上就让我感到<w>困惑</w>。"
                            }
                        },
                        {
                            "text": "False promises were designed to <w>stumble</w> men into making the wrong choice.",
                            "target_lang_translations": {
                                "ru": "Ложные обещания были созданы для того, чтобы <w>подтолкнуть</w> людей к неверному выбору.",
                                "zh": "虚假的承诺旨在<w>误导</w>人们做出错误的选择。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вводить в заблуждение или заставлять кого-либо совершить ошибку или прийти в замешательство.",
                        "zh": "误导某人或使其陷入错误或困惑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вводить в заблуждение",
                                "target_lang_sense_clarification": "сбивать с толку"
                            },
                            {
                                "target_lang_word": "сбивать",
                                "target_lang_sense_clarification": "заставлять ошибиться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "误导",
                                "target_lang_sense_clarification": "使人犯错"
                            },
                            {
                                "target_lang_word": "使困惑",
                                "target_lang_sense_clarification": "让人迷茫"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ab25bbb-a59b-3083-9557-d5fc39f776ec",
                    "sense_definition": "An act of tripping or a physical misstep that causes a loss of balance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A loose board in the floor caused his sudden <w>stumble</w> in the hallway.",
                            "target_lang_translations": {
                                "ru": "Шатающаяся доска в полу стала причиной его внезапного <w>спотыкания</w> в коридоре.",
                                "zh": "地板上一块松动的木板导致他在走廊里突然<w>绊倒</w>。"
                            }
                        },
                        {
                            "text": "He recovered quickly from a slight <w>stumble</w> and continued running the race.",
                            "target_lang_translations": {
                                "ru": "Он быстро оправился после легкой <w>оплошности</w> и продолжил забег.",
                                "zh": "他从轻微的<w>失足</w>中迅速恢复过来，继续参加比赛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slip",
                        "trip"
                    ],
                    "common_phrases": [
                        "slight stumble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт спотыкания или физическая оплошность, вызывающая потерю равновесия.",
                        "zh": "绊倒的行为或导致失去平衡的失足。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спотыкание",
                                "target_lang_sense_clarification": "физический акт"
                            },
                            {
                                "target_lang_word": "ложный шаг",
                                "target_lang_sense_clarification": "потеря равновесия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绊倒",
                                "target_lang_sense_clarification": "身体动作"
                            },
                            {
                                "target_lang_word": "失足",
                                "target_lang_sense_clarification": "失去平衡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f13fcbb2-3a47-316a-a455-169173bf2562",
                    "sense_definition": "A mistake, error, or blunder, especially in a professional or public context.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company owns up to early <w>stumbles</w> such as mislabeled products.",
                            "target_lang_translations": {
                                "ru": "Компания признает свои ранние <w>промахи</w>, такие как неправильная маркировка товаров.",
                                "zh": "公司承认了早期的<w>失误</w>，例如产品标签贴错。"
                            }
                        },
                        {
                            "text": "Despite a minor <w>stumble</w> during the interview, she got the job.",
                            "target_lang_translations": {
                                "ru": "Несмотря на небольшую <w>заминку</w> во время интервью, она получила работу.",
                                "zh": "尽管面试中出现了一点小<w>失误</w>，她还是得到了这份工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blunder",
                        "error",
                        "mistake",
                        "gaffe",
                        "lapse"
                    ],
                    "common_phrases": [
                        "early stumbles",
                        "minor stumble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ошибка, оплошность или промах, особенно в профессиональном или общественном контексте.",
                        "zh": "错误、失误或过失，特别是在职业或公共场合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промах",
                                "target_lang_sense_clarification": "ошибка"
                            },
                            {
                                "target_lang_word": "оплошность",
                                "target_lang_sense_clarification": "незначительная ошибка"
                            },
                            {
                                "target_lang_word": "заминка",
                                "target_lang_sense_clarification": "небольшая неудача"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失误",
                                "target_lang_sense_clarification": "犯错"
                            },
                            {
                                "target_lang_word": "过失",
                                "target_lang_sense_clarification": "疏忽"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3781e590-5219-37b5-9f70-86408745e5c2",
                    "sense_definition": "A clumsy or unsteady way of walking.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pub was just a short <w>stumble</w> away from the harbor gates.",
                            "target_lang_translations": {
                                "ru": "Паб находился всего в паре <w>шагов</w> от ворот гавани.",
                                "zh": "酒吧离港口大门只有几步之遥，走过去摇摇晃晃的。"
                            }
                        },
                        {
                            "text": "His walk had turned into a weary <w>stumble</w> after hours of hiking.",
                            "target_lang_translations": {
                                "ru": "Его походка превратилась в усталое <w>ковыляние</w> после многочасового похода.",
                                "zh": "徒步数小时后，他的步伐变成了疲惫的<w>蹒跚</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "a stumble away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неуклюжая или неуверенная походка.",
                        "zh": "笨拙或不稳的走路方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шатание",
                                "target_lang_sense_clarification": "неуверенная походка"
                            },
                            {
                                "target_lang_word": "ковыляние",
                                "target_lang_sense_clarification": "неуклюжий шаг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "踉跄",
                                "target_lang_sense_clarification": "步态不稳"
                            },
                            {
                                "target_lang_word": "蹒跚",
                                "target_lang_sense_clarification": "走路摇晃"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}