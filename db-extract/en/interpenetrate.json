                "translations": [
                    {
                        "translation_id": "82e0d928-8382-45eb-bc08-e544806401b6",
                        "source_entry_id": "15d16df5-c787-3424-b951-b2cd39dfde1c",
                        "source_sense_id": "2dd07f5c-722d-3be2-91b4-9f1fc6770c4b",
                        "source_sense_description": "transitiv: durchdringen",
                        "target_lang_word": "durchdringen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "durchdringen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54f3a29c-6a0e-36b6-94f5-4c46dc03a38b",
                                        "entry_id": "92f84d90-334f-3274-8070-f9c9ada107f7",
                                        "glosses": [
                                            "durch etwas hindurch dringen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a24ec89-006e-4288-b269-996ee3b027d2",
                                                "sense_id": "54f3a29c-6a0e-36b6-94f5-4c46dc03a38b",
                                                "text": "Sonnenstrahlen durchdrangen die Wolken."
                                            },
                                            {
                                                "example_id": "fcd92657-778b-42e3-b105-50cea97e0c71",
                                                "sense_id": "54f3a29c-6a0e-36b6-94f5-4c46dc03a38b",
                                                "text": "Nanoemulsionen durchdringen nicht die Hautbarriere."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7d88e30a-ef54-3fe1-a067-40e879e13fc7",
                                        "entry_id": "92f84d90-334f-3274-8070-f9c9ada107f7",
                                        "glosses": [
                                            "etwas oder jemanden (innerlich) erfüllen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ef396fc-a84b-4fb5-bf26-0e2e19441d11",
                                                "sense_id": "7d88e30a-ef54-3fe1-a067-40e879e13fc7",
                                                "text": "Ein starkes Wohlgefühl durchdrang ihn."
                                            },
                                            {
                                                "example_id": "21834f03-5bd9-44fb-b3bc-ea7578300876",
                                                "sense_id": "7d88e30a-ef54-3fe1-a067-40e879e13fc7",
                                                "text": "Nun aber hat er die Probe bestanden, und es bestätigt sich, daß er von der wichtigen Angelegenheit völlig durchdrungen ist und sich von allem andern ab- und allein dorthin gezogen fühlt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "415a47e9-bd00-3304-84d2-07059bc488c7",
                                        "entry_id": "92f84d90-334f-3274-8070-f9c9ada107f7",
                                        "glosses": [
                                            "eine komplexe Materie gründlich durcharbeiten und dadurch verstehen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "545e3c87-6e6c-4a20-bd1e-4234d04edfae",
                                                "sense_id": "415a47e9-bd00-3304-84d2-07059bc488c7",
                                                "text": "Heute sind wir der Überzeugung, dass wir die entscheidenden ProtagonistInnen [sic] auf der Erde gefunden haben, die das Thema in ihrer ganzen Tiefe durchdrungen haben."
                                            },
                                            {
                                                "example_id": "49f575d2-a0ee-4f95-b721-7029a2f9645c",
                                                "sense_id": "415a47e9-bd00-3304-84d2-07059bc488c7",
                                                "text": "Wer das nicht versteht, weiß und durchdringt, mag zwei Staatsexamen verstanden haben, sonst aber nicht sehr viel."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "durchdringen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a425c8a4-d782-328d-bdba-0993a2de7cf8",
                                        "entry_id": "509eea13-60d6-3c7b-89fc-fe865d7f26ba",
                                        "glosses": [
                                            "jemand oder etwas dringt durch etwas durch"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcbcb73c-e56f-4497-879d-edb04d8b9f96",
                                                "sense_id": "a425c8a4-d782-328d-bdba-0993a2de7cf8",
                                                "text": "Sonnenstrahlen drangen durch die Wolken durch."
                                            },
                                            {
                                                "example_id": "e19d48fd-bfe0-43b8-8b63-75d6635d578d",
                                                "sense_id": "a425c8a4-d782-328d-bdba-0993a2de7cf8",
                                                "text": "Aber das Wasser drang nicht durch, die Decke war und ist dicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb14b708-f3ce-3bee-96f0-3e294abfa26b",
                                        "entry_id": "509eea13-60d6-3c7b-89fc-fe865d7f26ba",
                                        "glosses": [
                                            "zur Kenntnis gelangen"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9382285-9d1b-410d-9dd9-cad738a96917",
                                                "sense_id": "cb14b708-f3ce-3bee-96f0-3e294abfa26b",
                                                "text": "Ist dieses Gerücht nicht auch zu euch durchgedrungen?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4f82aaed-cac3-3c1f-a42c-7340ef7bd93b",
                                        "entry_id": "509eea13-60d6-3c7b-89fc-fe865d7f26ba",
                                        "glosses": [
                                            "vehement in einen Körper oder Raum dringen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "130b86fd-c13c-43c4-af4e-f5f7f2b0918e",
                                                "sense_id": "4f82aaed-cac3-3c1f-a42c-7340ef7bd93b",
                                                "text": "Ihre Stimmen drangen nicht durch, soviel sie sich auch bemühten."
                                            },
                                            {
                                                "example_id": "e5d8ad24-98a9-4da8-982f-077b13d4f472",
                                                "sense_id": "4f82aaed-cac3-3c1f-a42c-7340ef7bd93b",
                                                "text": "Kälte drang in der ganzen Wohnung durch."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "be217074-4875-377f-beba-bd64b5a1bd1c",
                                        "entry_id": "509eea13-60d6-3c7b-89fc-fe865d7f26ba",
                                        "glosses": [
                                            "mit einem Anliegen Erfolg haben; sich mit etwas durchsetzen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97753254-304c-46fb-8189-ae892a165bba",
                                                "sense_id": "be217074-4875-377f-beba-bd64b5a1bd1c",
                                                "text": "Mit diesen Argumenten vermag der Kläger nicht durchzudringen, denn das angefochtene Urteil beschreibt die Rechtslage zutreffend."
                                            },
                                            {
                                                "example_id": "560c60b6-97e7-4057-8cc6-e857f7e85ebb",
                                                "sense_id": "be217074-4875-377f-beba-bd64b5a1bd1c",
                                                "text": "„Engelke hatte vor kurzem einen roten Streifen annähen wollen, war aber mit seinem Vorschlag nicht durchgedrungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
