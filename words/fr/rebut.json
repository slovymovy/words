    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "be7429cd-0b96-3815-abab-771000a7a450",
                    "sense_definition": "Ce qui est rejeté ou abandonné comme inutile, sans valeur ou inutilisable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dechet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après le grand nettoyage de printemps, nous avons mis de vieux meubles au <w>rebut</w>."
                        },
                        {
                            "text": "Cet appareil électronique est tombé en panne et a fini directement au <w>rebut</w>."
                        }
                    ],
                    "synonyms": [
                        "déchet",
                        "rejet"
                    ],
                    "common_phrases": [
                        "mettre au rebut",
                        "jeter au rebut"
                    ]
                },
                {
                    "sense_id": "dc84e4d4-defd-3233-9e0d-18cf39b2905a",
                    "sense_definition": "Produit ou pièce industrielle défectueuse retirée de la production car non conforme.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "industrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'usine cherche constamment à réduire son taux de <w>rebut</w> afin d'augmenter sa rentabilité."
                        },
                        {
                            "text": "Toute pièce présentant une fissure visible est immédiatement classée comme un <w>rebut</w>."
                        }
                    ],
                    "common_phrases": [
                        "taux de rebut"
                    ]
                },
                {
                    "sense_id": "ef8c3ce1-ec1e-3c73-a898-4e1ffca16060",
                    "sense_definition": "Rejet dédaigneux ou refus brutal essuyé par quelqu'un.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "refus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune poète a essuyé plusieurs <w>rebuts</w> avant de trouver enfin un éditeur bienveillant."
                        },
                        {
                            "text": "Malgré les <w>rebuts</w> constants de son supérieur, il n'a jamais abandonné ses propositions."
                        }
                    ],
                    "synonyms": [
                        "rebuffade",
                        "refus"
                    ],
                    "common_phrases": [
                        "essuyer des rebuts"
