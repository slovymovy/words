                        "examples": [
                            {
                                "example_id": "8191614e-994d-4d10-b53c-818e40060964",
                                "sense_id": "77815615-d99c-3305-81f9-4d9415f89d9a",
                                "text": "Incendiarism is a major fire problem in many cities; Mr. Fairtrace here recommends needed changes in insurance and fire protection methods."
                            },
                            {
                                "example_id": "9945bc8a-2564-489e-bc08-3dddea84012e",
                                "sense_id": "77815615-d99c-3305-81f9-4d9415f89d9a",
                                "text": "In the surrounding black slums incendiarism shoots up in the summer, an index, soem say, of psychopathology. Although the love of flames it's also religious."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b6af016-3b23-3ada-8f42-43d701b78195",
