                                "target_senses": [
                                    {
                                        "sense_id": "78192f85-bb68-3dbe-9be5-b595945ce0ae",
                                        "entry_id": "ea897f85-f602-3555-9d47-c5341fbd6bd0",
                                        "glosses": [
                                            "zonder te weten waartoe iets dient of waar men heen wil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41ce15bb-4ce8-4b58-a906-f8bddf123061",
                                                "sense_id": "78192f85-bb68-3dbe-9be5-b595945ce0ae",
                                                "text": "En zo begon zijn doelloze zwerftocht, die hem uiteindelijk naar de westkust zou voeren."
                                            },
                                            {
                                                "example_id": "b28f443c-01b8-40f5-8d8c-ff4a2908be60",
                                                "sense_id": "78192f85-bb68-3dbe-9be5-b595945ce0ae",
                                                "text": "Ook, of misschien wel juist, met doelloos rondzwerven kun je ergens komen."
                                            },
                                            {
                                                "example_id": "092940a9-d8f4-4779-8550-2e7fd71b3867",
                                                "sense_id": "78192f85-bb68-3dbe-9be5-b595945ce0ae",
                                                "text": "’s Middags dwaalde ik doelloos door de straten van de oude stad en kwam een winkel tegen waar allerlei verfspullen werden verkocht."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "659342f6-3030-4bcd-8633-cc253bce3cae",
                        "source_entry_id": "aa1d2adb-b5e1-399d-a280-3734a9dfb0ee",
                        "source_sense_id": "933e97cf-c3fd-322a-96fa-ad852141852c",
                        "source_sense_description": "without aim",
                        "target_lang_word": "planlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "planlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b81bf00d-c9df-3e88-ad10-7a63b3cd537e",
                                        "entry_id": "ba507b28-b750-3f1f-8c0a-fc208857a6c3",
                                        "glosses": [
                                            "ziellos, aufs Geratewohl, unüberlegt, ohne Struktur, ohne System, ohne Plan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28641c47-b00e-44bd-8f58-16003af584e0",
                                                "sense_id": "b81bf00d-c9df-3e88-ad10-7a63b3cd537e",
                                                "text": "Sein planloses Herangehen an dieses Projekt ließ es dann auch scheitern."
                                            },
                                            {
                                                "example_id": "906c5bbe-44d9-4213-97c5-efae5dcfb82d",
                                                "sense_id": "b81bf00d-c9df-3e88-ad10-7a63b3cd537e",
                                                "text": "„Wie kann man nur so planlos sein, sich so überhaupt keine Gedanken machen? Du bist mir ein Rätsel!“"
                                            },
                                            {
                                                "example_id": "ca43e1cd-330a-4a06-861d-928be380a77d",
                                                "sense_id": "b81bf00d-c9df-3e88-ad10-7a63b3cd537e",
                                                "text": "Über eine Milliarde US-Dollar sind nach Angaben des neuen Finanzministers Hoshiar Zebari seit Juni an schiitische Milizen geflossen. Das Geld sei planlos verteilt worden, die Vorgängerregierung von Nuri Al-Maliki habe darüber nicht Buch geführt."
                                            },
                                            {
                                                "example_id": "105dd2b7-05fd-4c69-a72a-05b8201c663f",
                                                "sense_id": "b81bf00d-c9df-3e88-ad10-7a63b3cd537e",
                                                "text": "Von dem Tor erholte sich Kamerun lange nicht. Noch planloser wurde der Ball nach vorne gedroschen und in Trauben aus Abwehrspielern hineingedribbelt."
                                            },
                                            {
                                                "example_id": "45039e7e-ec2f-4007-b1af-b8a9e19f9195",
                                                "sense_id": "b81bf00d-c9df-3e88-ad10-7a63b3cd537e",
                                                "text": "Marschbefehle erreichen die Truppe, sie muss Stellungen ausheben, die sie gleich wieder verlässt, um weiter – planlos – durch menschenleere und doch unter Artilleriebeschuss liegende Wasserlandschaften zu ziehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "071d8671-391d-439c-b46e-b758a3291768",
                        "source_entry_id": "aa1d2adb-b5e1-399d-a280-3734a9dfb0ee",
                        "source_sense_id": "933e97cf-c3fd-322a-96fa-ad852141852c",
                        "source_sense_description": "without aim",
                        "target_lang_word": "ziellos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ziellos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f79c0bc5-2b99-3886-a8fd-ffdf1aa36dd6",
                                        "entry_id": "99d279f1-1c34-35b2-85b1-b26cb94d1c6f",
                                        "glosses": [
                                            "ohne festes, erkennbares Ziel; ohne (genau) zu wissen, wohin es gehen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "088b0a21-1fdd-4095-b31b-54d6f59270db",
                                                "sense_id": "f79c0bc5-2b99-3886-a8fd-ffdf1aa36dd6",
                                                "text": "„Sie schien sich immerfort in einer ungeheuren, aber völlig ziellosen Eile zu befinden, und immerzu suchte sie Gefährten für ihre Hetzjagden, die ewig nur im Kreise herumführten.“"
                                            },
                                            {
                                                "example_id": "bbc0dffd-e72d-4c91-b6c4-3808f16b72f3",
                                                "sense_id": "f79c0bc5-2b99-3886-a8fd-ffdf1aa36dd6",
                                                "text": "„Nachdem Lenz während des ›Kunstgesprächs‹ noch von erzählfreudiger Lebendigkeit war, findet er nach Kaufmanns Intervention ([…]), nach einer Phase depressiver Verstimmtheit ([…]) und großer Angst zu immer zielloserer Aktivität.“"
                                            },
                                            {
                                                "example_id": "02699ec1-d28d-479a-88d1-bc7a7271d962",
                                                "sense_id": "f79c0bc5-2b99-3886-a8fd-ffdf1aa36dd6",
                                                "text": "„Die Zettelkästen und Bücher für den Erwerb eines Lehramtes standen unberührt und unbedacht im Regal, er trieb sich ziellos umher in den beiden Städten Berlin an vielen Abenden mit seinem sicheren herrenhaften Benehmen und suchte nach er wusste nicht was.“"
                                            },
                                            {
                                                "example_id": "93b2f48f-1737-40b1-bf58-fc94f38375dc",
                                                "sense_id": "f79c0bc5-2b99-3886-a8fd-ffdf1aa36dd6",
                                                "text": "„All dies geschieht in einem zunehmend wilderen, zielloseren Kreisen um sich selbst, mit immer zwanghafteren Selbstbestätigungsstrategien, in denen der neuzeitliche Anthropozentrismus offensichtlich Kapriolen schlägt.“"
                                            },
                                            {
                                                "example_id": "1497588f-db1b-4003-b211-2b97a9c5619b",
                                                "sense_id": "f79c0bc5-2b99-3886-a8fd-ffdf1aa36dd6",
                                                "text": "„Über den Aufsatz als Ganzes kann ich mich kaum äußern, er erschien mir bei einmaliger Lektüre reichlich ziellos und verworren.“"
                                            },
                                            {
                                                "example_id": "902e472d-59ab-436c-ab64-cc21b25d70c7",
                                                "sense_id": "f79c0bc5-2b99-3886-a8fd-ffdf1aa36dd6",
                                                "text": "„Nach einer derartigen Einstimmung geht der mehr oder weniger füllige Fern-Seher sehr schlechtgelaunt in den Rest des Abends, und das wiederum führt zu noch zielloserem Zappen.“"
                                            },
                                            {
                                                "example_id": "84c3d458-1a0f-47f4-8400-6656e7baae9a",
                                                "sense_id": "f79c0bc5-2b99-3886-a8fd-ffdf1aa36dd6",
                                                "text": "„Ich lausche seelenruhig dieser fernen Melodie, ich sehe, von oben, all diese Seelen, die noch um uns herumspazieren: Wer war Liszt, wer war Berlioz, wer war Wagner und wer waren all diejenigen, die sie kannten, Musset, Lamartine, Nerval, ein riesiges Netz von Texten, Noten und Bildern, deutlich, klar, ein Pfad, den ich allein sehe, weil ich den alten Hammer-Purgstall mit einer ganzen Welt von Reisenden, Musikern und Dichtern verbinde, Beethoven mit Balzac, mit James Morier, Hofmannsthal, Strauss, Mahler und den süßen Rauchschwaden von Istanbul und Teheran, ist es möglich, dass mich das Opium nach all den Jahren noch immer begleitet, dass man seine Wirkungen heraufbeschwören kann wie Gott im Gebet – ich träumte im Mohn ausgiebig von Sarah wie heute Abend, voll langer und tiefer Sehnsucht, mit einem vollkommenen Begehren, weil es keine Befriedigung, keine Vollendung braucht; einer ewigen Lust, einer unendlichen, ziellosen Erektion, genau das bewirkt Opium.“"
                                            },
                                            {
                                                "example_id": "9c29a1ff-58c2-4508-9666-0ed1f50359ee",
                                                "sense_id": "f79c0bc5-2b99-3886-a8fd-ffdf1aa36dd6",
                                                "text": "„Ziellos irrte sie durch die Gassen, die dunkel waren und leer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
