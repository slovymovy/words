                    {
                        "translation_id": "4c563499-c7ca-426d-a062-44620dd08754",
                        "source_entry_id": "f6c01182-0c92-337b-bbe4-78a3a06a2374",
                        "source_sense_id": "47b9dd5e-c46a-37ab-9b37-55609fd23439",
