                ],
                "senses": [
                    {
                        "sense_id": "442d755a-3e56-305d-a7fb-5f37a1e16813",
                        "entry_id": "94eda86a-2739-3072-acdf-896c4d98051b",
                        "glosses": [
                            "räumlich abgetrennter Bereich, in dem Personen ionisierender Strahlung ausgesetzt sein können, die oberhalb des jeweilig zulässigen oberen Grenzwerts liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55e733c6-740e-4b56-8fef-91ff891b5f69",
                                "sense_id": "442d755a-3e56-305d-a7fb-5f37a1e16813",
                                "text": "Der Strahlenschutzverantwortliche hat dafür zu sorgen, dass bei den nachfolgenden Tätigkeiten Strahlenschutzbereiche nach Absatz 2 Satz 1 eingerichtet werden."
                            },
                            {
                                "example_id": "44a9106a-7537-49e3-95da-127939c7306c",
                                "sense_id": "442d755a-3e56-305d-a7fb-5f37a1e16813",
                                "text": "Die Bereiche nach den Absätzen 1 und 4 gelten als Strahlenschutzbereiche nur während der Einschaltzeit des Strahlers."
                            },
                            {
                                "example_id": "d18c27fd-99cc-46d9-b082-51be028bb4a2",
                                "sense_id": "442d755a-3e56-305d-a7fb-5f37a1e16813",
                                "text": "Für Menschen, die außerhalb der Strahlenschutzbereiche leben oder arbeiten, darf die effektive Körperdosis den Wert von 0,3 mSv/a nicht überschreiten."
                            },
                            {
                                "example_id": "f532781e-a427-4fae-b290-b4bce55bae88",
                                "sense_id": "442d755a-3e56-305d-a7fb-5f37a1e16813",
                                "text": "Die zuständige Behörde kann gestatten, dass der fachkundige Strahlenschutzverantwortliche oder der zuständige Strahlenschutzbeauftragte auch anderen Personen den Zutritt zu Strahlenschutzbereichen erlaubt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
