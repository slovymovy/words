                                        "examples": [
                                            {
                                                "example_id": "0dcec9c7-ad37-4d43-aacd-9fabdf8f1d9b",
                                                "sense_id": "beff233e-cd75-38bb-a520-2ae0bb4062c7",
                                                "text": "The Kentja race of Dravido-Australian origin is slender of body and has a long face with a protruding profil, the hair is cymatotrichous, the colour of the skin grows darker towards the feet, the piliation of the body is stronger than in the Malella race; the Kentja race is well represented in Madura."
                                            },
                                            {
                                                "example_id": "f4e30896-f2a6-4ee1-b64a-c922f53c05b2",
                                                "sense_id": "beff233e-cd75-38bb-a520-2ae0bb4062c7",
                                                "text": "The Antarides are brown, cymatotrichous, dolicho-mesocephalic, with rather high heads, leptomesoprosopic, mesoleptorrhinous, and medium statured in comparison to the other populations of the Sunda Arch, so mostly taller than the Palae Mongolids."
                                            },
                                            {
                                                "example_id": "28f19d0f-e2b0-41fc-8b34-846f57590f82",
                                                "sense_id": "beff233e-cd75-38bb-a520-2ae0bb4062c7",
                                                "text": "Wavy — (Cymatotrichous). Flat Waved or Broad Waved or Narrow Waved or Curly."
                                            }
                                        ]
                                    }
