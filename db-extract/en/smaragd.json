                        "sense_id": "dd9601fb-ae2b-3e71-8805-db0a3e1a5760",
                        "entry_id": "b549df15-0fa1-381f-b80c-229c3a995905",
                        "glosses": [
                            "An emerald."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c153de8d-5c9e-4586-b6ab-4e18333dd4cf",
                                "sense_id": "dd9601fb-ae2b-3e71-8805-db0a3e1a5760",
                                "text": "These following bodies do not draw: smaragd, achates, corneolus, pearl, jaspis, chalcedonius, alabaster, porphyry, coral, marble, touchstone, haematites, or bloodstone […]"
                            },
                            {
                                "example_id": "6423c558-ae8e-47b7-96a0-4699d1f2a5b9",
                                "sense_id": "dd9601fb-ae2b-3e71-8805-db0a3e1a5760",
                                "text": "Nor far they steppèd when on culm'inant height / where stretcht a gem-enamel'd mead they stood; / Smaragd and Ruby-strewn, so rich the sight / presumed 'twas Paradisial floor they trod."
                            }
                        ]
                    }
                ],
