                        "form": "die Geschmacksstoffe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b4dd29cf-ffea-36d3-bc5d-9f1e96881e52",
                        "entry_id": "7cd7efbc-9caa-3235-bede-1ab3065bb2e1",
                        "glosses": [
                            "Stoff oder ein ausgeprägter angenehmer, kräftiger intensiver würziger Duft, der den Geschmackssinn anspricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c9c1804-c9da-49d4-8f7a-5c1ba8e967cd",
                                "sense_id": "b4dd29cf-ffea-36d3-bc5d-9f1e96881e52",
                                "text": "„Die Kombination der wasserlöslichen Geschmacksstoffe und der fettlöslichen Aromen ergeben den typischen Charakter einer Bouillon.“"
                            },
                            {
                                "example_id": "f74a2898-3b3b-466c-9f30-f4868e84fcda",
                                "sense_id": "b4dd29cf-ffea-36d3-bc5d-9f1e96881e52",
                                "text": "„Speichel besteht vor allem aus Wasser; die Geschmacksstoffe lösen sich darin gut.“"
                            },
                            {
                                "example_id": "0ee2a995-fd67-483a-9ca9-b8644a642aa4",
                                "sense_id": "b4dd29cf-ffea-36d3-bc5d-9f1e96881e52",
                                "text": "„Die Geschmacksstoffe können nur über die Oberfläche des Kaffeepulvers in das Wasser übergehen.“"
                            },
                            {
                                "example_id": "d36ab598-8a53-4abf-91ea-62eb3c36d7cd",
                                "sense_id": "b4dd29cf-ffea-36d3-bc5d-9f1e96881e52",
                                "text": "„Portulak wird frisch in Salaten verwendet, kann in Ragouts aber auch kurz mitgekocht werden, denn die Geschmacksstoffe sind nicht sehr flüchtig.“"
                            },
                            {
                                "example_id": "aee34043-8999-4d1b-8a7b-74e694c5f5c6",
                                "sense_id": "b4dd29cf-ffea-36d3-bc5d-9f1e96881e52",
                                "text": "„Da alle Geschmacksstoffe wasserlöslich sind, können sie sich während des Köchelns (im Gegensatz zu den Aromen) nicht verflüchtigen und verbleiben im Wasser.“"
                            },
                            {
                                "example_id": "09e31544-0033-485f-a5cc-ce334365805d",
                                "sense_id": "b4dd29cf-ffea-36d3-bc5d-9f1e96881e52",
                                "text": "„Jüngere Studien zeigen, dass auch Geschmacksstoffe in der Nahrung die Immunabwehr über die Zusammensetzung des Speichels beeinflussen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
