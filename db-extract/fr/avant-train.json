                        "target_lang_word": "limber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf517ddb-a956-3b21-bcfd-0ff7af539095",
                                        "entry_id": "d3b2992b-62c6-35a8-a22f-636d7303c634",
                                        "glosses": [
                                            "Flexible, pliant, bendable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e5099b3-29bf-4b8c-9d80-d4d6577ca6d0",
                                                "sense_id": "cf517ddb-a956-3b21-bcfd-0ff7af539095",
                                                "text": "He's so limber that he can kiss his knee without bending it."
                                            },
                                            {
                                                "example_id": "868b7ec5-733e-4098-abfe-f4e554beeddf",
                                                "sense_id": "cf517ddb-a956-3b21-bcfd-0ff7af539095",
                                                "text": "Not yet the bargeman that doth rowe / with long and limber oare"
                                            },
                                            {
                                                "example_id": "2091e855-898d-4be8-bca6-64872b181156",
                                                "sense_id": "cf517ddb-a956-3b21-bcfd-0ff7af539095",
                                                "text": "This is a very complicated case, Maude. A lot of ins, a lot of outs. Fortunately, I'm adhering to a pretty strict drug regimen to keep my mind limber."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "limber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8547cd1e-09d2-367f-bf34-3f0a23c7b581",
                                        "entry_id": "06f573ea-0a4a-3bd2-b615-ddaad421c2c2",
                                        "glosses": [
                                            "To cause to become limber; to make flexible or pliant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aa072c2-aeb9-4088-a23b-5ec6f73d84e2",
                                                "sense_id": "8547cd1e-09d2-367f-bf34-3f0a23c7b581",
                                                "text": "Her stiff hams, that have not been bent to a civility for ten years past, are now limbered into courtesies three deep at every word"
                                            },
                                            {
                                                "example_id": "bb5c4c70-153e-4859-ab6c-06b7c37bcc59",
                                                "sense_id": "8547cd1e-09d2-367f-bf34-3f0a23c7b581",
                                                "text": "Go back to the Island and limber up with a few drafts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "limber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca520087-3235-3fbf-9d89-75eb396e460d",
                                        "entry_id": "2d4f7802-8f7c-3e5f-9a8f-63907c3e355c",
                                        "glosses": [
                                            "A two-wheeled vehicle to which a wheeled artillery piece or caisson may be attached for transport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b047bcb-6383-4976-bdf0-8d3be817c9f3",
                                                "sense_id": "ca520087-3235-3fbf-9d89-75eb396e460d",
                                                "text": "An' when the smoke 'ad cleared away, before the limber wheels, / There lay the Driver's Brother with 'is 'ead between 'is 'eels."
                                            },
                                            {
                                                "example_id": "696c3c7a-d589-4962-8cfd-825df3dbe172",
                                                "sense_id": "ca520087-3235-3fbf-9d89-75eb396e460d",
                                                "text": "As the limber gunners went to the rear, his horse trod in a rabbit-hole and came down, throwing him into a depression of the ground."
                                            },
                                            {
                                                "example_id": "1273d6ae-bdf1-437b-b513-b68297c2c1df",
                                                "sense_id": "ca520087-3235-3fbf-9d89-75eb396e460d",
                                                "text": "we covered the rutted, rattling, dusty pot-holed roads of coastal Victoria, six big Walers in front, the cannon at the rear, and that unsprung cart they called a ‘limber’ in the middle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38697794-b9d6-39b4-82a2-53571b8d8a6b",
                                        "entry_id": "2d4f7802-8f7c-3e5f-9a8f-63907c3e355c",
                                        "glosses": [
                                            "The shafts or thills of a wagon or carriage."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe2e5661-ece3-3a92-9ef6-1d9bdb2a8f12",
                                        "entry_id": "2d4f7802-8f7c-3e5f-9a8f-63907c3e355c",
                                        "glosses": [
                                            "Gutters or conduits on each side of the keelson to allow water to pass to the pump well."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
