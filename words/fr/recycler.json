    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e72d59e1-568e-35e8-83d1-df1840a0b242",
                    "sense_definition": "Traiter des déchets ou des objets usagés afin de récupérer leurs matériaux pour un nouvel usage.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette ville, les habitants trient soigneusement leurs ordures ménagères pour <w>recycler</w> le plastique."
                        },
                        {
                            "text": "Cette usine moderne a été conçue pour <w>recycler</w> les déchets électroniques de la région."
                        }
                    ],
                    "synonyms": [
                        "récupérer",
                        "revaloriser"
                    ],
                    "antonyms": [
                        "jeter",
                        "gaspiller"
                    ],
                    "common_phrases": [
                        "recycler le plastique",
                        "recycler les déchets",
                        "recycler le verre"
                    ]
                },
                {
                    "sense_id": "f11732e5-a3ba-3531-84e2-c6af219add81",
                    "sense_definition": "Donner une nouvelle formation professionnelle à quelqu'un ou se réorienter vers une autre activité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs années dans l'enseignement, il a choisi de se <w>recycler</w> dans le développement web."
                        },
                        {
                            "text": "L'entreprise propose un plan d'accompagnement complet pour <w>recycler</w> le personnel vers de nouveaux métiers."
                        }
                    ],
                    "synonyms": [
                        "reconvertir",
                        "réorienter"
                    ],
                    "common_phrases": [
                        "se recycler dans",
                        "recycler le personnel"
                    ]
                },
                {
                    "sense_id": "32bce7f6-f046-31c6-b982-5554ccc078c9",
                    "sense_definition": "Réutiliser d'anciennes formules, des idées passées ou des éléments culturels en les remettant au goût du jour.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette série télévisée ne fait que <w>recycler</w> de vieilles idées sans apporter aucune nouveauté."
                        },
                        {
                            "text": "Le couturier aime <w>recycler</w> des motifs des années soixante pour sa nouvelle collection."
                        }
                    ],
                    "synonyms": [
                        "réactualiser",
                        "reprendre",
                        "réutiliser"
                    ],
                    "antonyms": [
                        "innover",
                        "inventer"
                    ],
                    "common_phrases": [
                        "recycler de vieilles idées",
                        "recycler des concepts"
                    ]
                }
            ]
        }
    ]
