                                    {
                                        "sense_id": "305c3582-5875-3146-990a-24f81850c592",
                                        "entry_id": "c92b0766-f07a-3048-bc8d-72552b1b34bf",
                                        "glosses": [
                                            "A surname."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "235b720e-a892-3548-8f56-9b48d59f7ede",
                                        "entry_id": "c92b0766-f07a-3048-bc8d-72552b1b34bf",
                                        "glosses": [
                                            "A specific church (Christian religious denomination), such as the Church of England or the Catholic Church."
                                        ],
                                        "tags": [
                                            "used with \\\"the\\"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17695382-41ad-4761-834e-d9d9292de249",
                                                "sense_id": "235b720e-a892-3548-8f56-9b48d59f7ede",
                                                "text": "Priest: Look, matey, this is a church, not a dealing room. I am not interested in your creepy theories about enterprise and initiative. This place is founded on ideas a bit more permanent than the Dow Jones Index... The Church will be here long after your little brat has grown up, ripped a few people off and died unloved in his Spanish retirement villa.\nMother: Portuguese, actually, and there's no need to be so beastly.\nPriest: Well, I'm sorry, but people like you really piss me off."
                                            },
                                            {
                                                "example_id": "b5a1381c-81a2-4076-9ca1-9f75352abc47",
                                                "sense_id": "235b720e-a892-3548-8f56-9b48d59f7ede",
                                                "text": "John was a convert to the Church who left his home in England and traveled to the Salt Lake Valley as part of a handcart company."
                                            },
                                            {
                                                "example_id": "469e296f-ff58-4c66-a63f-1f5b6928015b",
                                                "sense_id": "235b720e-a892-3548-8f56-9b48d59f7ede",
                                                "text": "Thus, the Church considers all goodness and truth found in these religions as \"a preparation for the Gospel and given by him who enlightens all men that they may at length have life.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "081df161-f152-3571-adb7-9a505c8f2cff",
                                        "entry_id": "c92b0766-f07a-3048-bc8d-72552b1b34bf",
                                        "glosses": [
                                            "Christianity conceptualized as a single church, irrespective of its various denominations; Christendom."
                                        ],
                                        "tags": [
                                            "used with \\\"the\\"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59ac849a-f38c-4cd4-9e5b-05e98df72d49",
                                                "sense_id": "081df161-f152-3571-adb7-9a505c8f2cff",
                                                "text": "the Son in Heaven and the Church on Earth"
                                            }
                                        ]
                                    },
                                    {
