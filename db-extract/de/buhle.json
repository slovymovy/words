                                        "glosses": [
                                            "Femme aimée d’amour, pleinement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4596e545-8696-41f9-920e-7b9f48f7d65f",
                                                "sense_id": "fd58411e-c1dd-389d-a6fb-69dcafdb8963",
