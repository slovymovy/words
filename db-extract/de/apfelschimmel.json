                "senses": [
                    {
                        "sense_id": "0d141e52-d9cd-3b3e-bc45-056c818bfd5e",
                        "entry_id": "954629ef-58ee-36aa-a9c7-4cf1855475ea",
                        "glosses": [
                            "weißes Pferd mit dunkleren, kreisförmigen Flecken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36816c9f-405b-4707-9208-d4472b60ffb3",
                                "sense_id": "0d141e52-d9cd-3b3e-bc45-056c818bfd5e",
                                "text": "„Plötzlich hört er galoppirende Pferde hinter sich, und kaum hat er sich umgewendet, so sieht er den großen Apfelschimmel dicht an seiner Schulter, und über dem Apfelschimmel den erhobenen Krückstock und das schneidige Antlitz des »Einzigen«, …“"
                            },
                            {
                                "example_id": "743954bb-f745-4561-8818-21a0fcbfe8f3",
                                "sense_id": "0d141e52-d9cd-3b3e-bc45-056c818bfd5e",
                                "text": "„Er saß auf einem dicken Apfelschimmel und versuchte, ihn vor die Mitte seiner Kompanie zu bringen.“"
                            },
                            {
                                "example_id": "062790cb-fbc1-4657-b990-d7c231fbaffe",
                                "sense_id": "0d141e52-d9cd-3b3e-bc45-056c818bfd5e",
                                "text": "„Das Pferd, ein Apfelschimmel, kostete vierzig piemontesische Pistolen; das entsprach ungefähr hundert Zechinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
