                                        "sense_id": "32caa17a-4b6b-3a23-b79f-e7dbbb0e02d9",
                                        "entry_id": "2d538344-0dd6-32ec-8caf-ec187b3c5f9b",
                                        "glosses": [
                                            "Fraction obtenue en divisant un milliard de fois."
                                        ],
                                        "tags": [
                                            "Au masculin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95ecdc56-5893-42cc-b600-e1278d8a08f4",
                                                "sense_id": "32caa17a-4b6b-3a23-b79f-e7dbbb0e02d9",
                                                "text": "« L’eau est filtrée à travers des rouleaux composés de 28 membranes, dont les pores ont un diamètre inférieur à un milliardième de mètre, c’est jusqu’à 100 000 fois plus fin qu’un cheveu », explique Sylvie Thibert, ingénieure qualité de l’eau et gestion des risques sanitaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
