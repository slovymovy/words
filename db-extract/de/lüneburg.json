                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6464f26-0740-4cd3-8b80-8f35054e3a9a",
                                "sense_id": "0bad5a71-b675-3309-850c-d5c037683633",
                                "text": "„Als traditionelle Orte der Namenforschung im deutschsprachigen Raum sind Lüneburg, Heidelberg, Mainz und Wiesbaden sowie mit Statistiken auch Zentren in Österreich und der Schweiz zu nennen.“"
                            },
                            {
                                "example_id": "5e9ce43f-f3fa-4be6-b7b1-f9ba24cfa15a",
                                "sense_id": "0bad5a71-b675-3309-850c-d5c037683633",
                                "text": "Der Sprachwissenschaftler Hermann Jacobsohn wurde in Lüneburg geboren."
                            },
                            {
                                "example_id": "b6902707-f2f5-4daf-93af-3d461634c4db",
                                "sense_id": "0bad5a71-b675-3309-850c-d5c037683633",
                                "text": "„Die erste urkundliche Erwähnung Lüneburgs im Mittelalter findet sich in einer Urkunde vom 13. August 956 […]“"
                            }
