                "senses": [
                    {
                        "sense_id": "8c73db6a-5e29-376e-98d2-a9cb0af95f62",
                        "entry_id": "6c33ada8-8723-3a3a-a617-147a055669db",
                        "glosses": [
                            "pseudoniem van de Surinaamse schrijver en verzetsman Anton de Kom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bd59d31-292e-4e24-a8e9-fa1a93628d3d",
                                "sense_id": "8c73db6a-5e29-376e-98d2-a9cb0af95f62",
                                "text": "Cornelis Gerard Anton de Kom - in Suriname bekend als Adek - werd in 1898 te Paramaribo geboren."
                            },
                            {
                                "example_id": "cb62baaa-f1f9-4c2a-b475-e3a0d5d68495",
                                "sense_id": "8c73db6a-5e29-376e-98d2-a9cb0af95f62",
                                "text": "Hij slaagt erin om het bredere historische verband aan te geven, maar tekent ook, als iemand die De Kom van zeer nabij heeft meegemaakt, een indringend portret van Adek."
                            }
                        ]
                    },
                    {
                        "sense_id": "06e97a52-53db-3fb8-8ff9-be6278b45bb7",
                        "entry_id": "6c33ada8-8723-3a3a-a617-147a055669db",
                        "glosses": [
                            "nationale universiteit van Suriname, gevestigd in Paramaribo"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f78ad94f-b58a-4d26-8703-3bc291d9de0e",
                                "sense_id": "06e97a52-53db-3fb8-8ff9-be6278b45bb7",
                                "text": "Eerst naar het VWO; AMS of Lyco, want dat ze naar de Adek zal gaan, dat staat voor haar, Tiffany, wel vast."
                            },
                            {
                                "example_id": "ac2bdbe4-3f2c-4ef6-aaae-23bf95c63937",
                                "sense_id": "06e97a52-53db-3fb8-8ff9-be6278b45bb7",
                                "text": "Naast veel waardering voor dit proefschrift, dat zeker verplichte literatuur zal moeten worden bij de rechtenstudie aan de Adek Universiteit van Suriname, zijn er ook enkele kritische kanttekeningen of opmerkingen te plaatsen."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe776a0f-9aa5-305e-9c06-d87be49280c7",
                        "entry_id": "6c33ada8-8723-3a3a-a617-147a055669db",
                        "glosses": [
                            "tijdschrift over welzijn met een Surinaamse invalshoek"
                        ],
                        "tags": [
                            "media"
                        ],
                        "examples": [
                            {
                                "example_id": "0bc30ffb-0ad1-4ee1-8a6f-dfc3cf479d86",
                                "sense_id": "fe776a0f-9aa5-305e-9c06-d87be49280c7",
                                "text": "Hij trad toe tot het Suriname Comité en schreef voor het Suriname Bulletin en het welzijnsblad Adek."
                            }
                        ]
                    }
