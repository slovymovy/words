                        "examples": [
                            {
                                "example_id": "4a1e64b3-08f3-45e8-9cf1-4c662e2f6aa4",
                                "sense_id": "f18785a6-1be8-3a99-88b8-23ebdda3dc7c",
                                "text": "Het gaat vooral om bestuurs-, staf- en ondersteunende functies. Een FNV-woordvoerder noemt de reorganisatie een efficiencyslag."
                            },
                            {
                                "example_id": "b9f72114-6a60-401e-8d3a-832dd3091efb",
                                "sense_id": "f18785a6-1be8-3a99-88b8-23ebdda3dc7c",
                                "text": "De bestuurders die meededen aan de peiling, worden alleen anoniem geciteerd. Een van de bestuurders zegt dat meer mensen tussen wal en schip vallen, en dat schrijnende situaties niet of te laat worden opgemerkt, met als gevolg hogere kosten en calamiteiten. Een ander zegt het zo: \"Onze inwoners gaan dit merken en worden daar de dupe van. Wij geloven echt in het behalen van effectiviteit en daarmee ook een efficiencyslag. Maar daar zit wel een grens aan.\""
                            }
                        ]
                    }
