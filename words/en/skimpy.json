    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b45d99eb-bb11-3a17-99fa-2a38b4724b7d",
                    "sense_definition": "Small or inadequate in amount or size.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inadequate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They served a very <w>skimpy</w> portion of food for such a high price.",
                            "target_lang_translations": {
                                "cs": "Za tak vysokou cenu podali velmi <w>sporou</w> porci jídla."
                            }
                        },
                        {
                            "text": "The company provided only <w>skimpy</w> details about the new project.",
                            "target_lang_translations": {
                                "cs": "Společnost poskytla o novém projektu jen <w>nedostatečné</w> podrobnosti."
                            }
                        }
                    ],
                    "synonyms": [
                        "meager",
                        "scanty",
                        "insufficient"
                    ],
                    "antonyms": [
                        "generous",
                        "ample"
                    ],
                    "common_phrases": [
                        "skimpy portion",
                        "skimpy details"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malý nebo nedostatečný v množství či velikosti."
