                "senses": [
                    {
                        "sense_id": "cc33f85f-e39b-347e-9536-50bb1a5fd60a",
                        "entry_id": "dddfeea4-3dc7-3e54-a15c-87ffb94264dc",
                        "glosses": [
                            "ein quaderförmiges Stück Stahl; aus Stahl bestehender Block"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55d31a4b-e05d-4e98-87c8-4d08940fd886",
                                "sense_id": "cc33f85f-e39b-347e-9536-50bb1a5fd60a",
                                "text": "„Ein in Kapfenberg gegossener Stahlblock wird vielleicht in der Nachbarschaft geschmiedet, dann aber in China gefräst und in den USA fertiggestellt.“"
                            },
                            {
                                "example_id": "1a11c3e3-3136-4b1a-bec9-9768688813f5",
                                "sense_id": "cc33f85f-e39b-347e-9536-50bb1a5fd60a",
                                "text": "„Statisch gehalten wird die Skulptur von einem Stahlblock, dessen Gewicht exakt dem der Plastik entspricht.“"
                            },
                            {
                                "example_id": "c774675f-fb9f-4c0e-bdc3-fa6f6d0b3939",
                                "sense_id": "cc33f85f-e39b-347e-9536-50bb1a5fd60a",
                                "text": "„Aus dem rechteckigen Stahlblock wird erstaunlich schnell etwas, das an ein Messer erinnert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
