                    },
                    {
                        "translation_id": "938b028d-a96b-4ef5-8bd5-76c922ebb02e",
                        "source_entry_id": "5a2a5b93-d044-3a3b-a8fc-096a80adff16",
                        "source_sense_id": "948a4651-79ec-3741-bc60-6bb2b045dd26",
                        "source_sense_description": "ein Blatt Papier, auf dem man seine Wünsche auflistet",
                        "target_lang_word": "wish list",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wish list",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b72977ab-34ed-3d28-a30f-a39ed25b180b",
                                        "entry_id": "8bd11b86-4717-378e-af93-2cad8aad8478",
                                        "glosses": [
                                            "A list of desired things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7635f39-87a4-4797-b5bc-82a31a36ab38",
                                                "sense_id": "b72977ab-34ed-3d28-a30f-a39ed25b180b",
                                                "text": "Also on the wish list is completion of the Borders Railway, electrification to Stirling/Perth/Inverness and Dundee/Aberdeen, as well as upgrades to the Cumbrian Coast Line and electrification of Barrow-Carnforth and Windermere-Oxenholme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7cf599e-1159-4853-806d-4264ab8707d1",
                        "source_entry_id": "5a2a5b93-d044-3a3b-a8fc-096a80adff16",
                        "source_sense_id": "948a4651-79ec-3741-bc60-6bb2b045dd26",
                        "source_sense_description": "ein Blatt Papier, auf dem man seine Wünsche auflistet",
                        "target_lang_word": "Christmas list",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Christmas list",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41ef6f92-ef92-34e8-83ac-d1fc040e0223",
                                        "entry_id": "b3c41959-5a1a-36e7-8556-e871fd13fa1e",
                                        "glosses": [
                                            "A written list of items one wants to receive as presents for Christmas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fe40618-af46-43e3-b333-9006beaa6244",
                                                "sense_id": "41ef6f92-ef92-34e8-83ac-d1fc040e0223",
                                                "text": "The number one item on my Christmas list was a way out of my marriage. The way I looked at it, this wasn't quite the same thing as a divorce."
                                            },
                                            {
                                                "example_id": "7ba82bb9-863a-4275-a11b-d58b27a5add7",
                                                "sense_id": "41ef6f92-ef92-34e8-83ac-d1fc040e0223",
                                                "text": "A handbag was way out of my league and so was a silver necklace that I wouldn't even put on my Christmas list, since no one in my family could afford it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2de7fc56-ea06-31f8-a25d-6a1a9405f6eb",
                                        "entry_id": "b3c41959-5a1a-36e7-8556-e871fd13fa1e",
                                        "glosses": [
                                            "A written list of people one is going to send Christmas cards, round robin letters, or presents to at Christmastime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3beccce-7880-4e95-9d32-9632d4701a2b",
                                                "sense_id": "2de7fc56-ea06-31f8-a25d-6a1a9405f6eb",
                                                "text": "If you have been on my Christmas list for a while, you are aware that both Momma and Daddy have not been well for the past three years."
                                            },
                                            {
                                                "example_id": "2b555e00-41f6-450f-bfdf-bdef7f6185f0",
                                                "sense_id": "2de7fc56-ea06-31f8-a25d-6a1a9405f6eb",
                                                "text": "What a great idea for the many friends and neighbors on your Christmas list!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae172011-33cd-44fd-a774-29d0abcaa826",
                        "source_entry_id": "5a2a5b93-d044-3a3b-a8fc-096a80adff16",
