                "senses": [
                    {
                        "sense_id": "ecc24fbc-09e9-3249-be51-79072cf71923",
                        "entry_id": "611a55ed-cbd9-3df9-b18b-31350940fb6c",
                        "glosses": [
                            "Donner un caractère socialiste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1d7792d-1e56-4cc9-8859-5d85225fcccc",
                                "sense_id": "ecc24fbc-09e9-3249-be51-79072cf71923",
                                "text": "Deux voies s’offraient. Ou bien intégrer le néo-capitalisme au socialisme et chercher à dominer les rouages de l’Etat, « socialistiser » plutôt que socialiser : c’était la solution proposée plus ou moins clairement par MM. Simonet, Leburton et Falize."
                            },
                            {
                                "example_id": "102608f4-a8c6-4fbf-b138-ec8774695def",
                                "sense_id": "ecc24fbc-09e9-3249-be51-79072cf71923",
                                "text": "Au final, le citoyen « socialistisé » sans l’avoir nettement choisi, ne trouve pas son compte dans ce type de Contrat Social."
                            }
                        ]
                    }
