                "senses": [
                    {
                        "sense_id": "335c65f7-2b85-32c2-aa7e-39869f033133",
                        "entry_id": "057e4fa4-cdb7-3424-b366-d22fda6f73e9",
                        "glosses": [
                            "een steen of kei die door een gletsjer of ijskap is meegevoerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13732197-1e3e-40a7-a67d-5c5238cacc05",
                                "sense_id": "335c65f7-2b85-32c2-aa7e-39869f033133",
                                "text": "Een veldkei werd zaterdagmiddag in een korte carnavalsoptocht door het centrum van Vroomshoop vervoerd op een wagen van loonbedrijf Wardenier."
                            },
                            {
                                "example_id": "d067b6e5-bac9-4cfe-8626-6fd6bff06ce7",
                                "sense_id": "335c65f7-2b85-32c2-aa7e-39869f033133",
                                "text": "Wethouder Marijke van Hees heeft maandagmorgen de eerste steen - beter gezegd een veldkei - gelegd voor een kunstwerk op het Wilminkplein, het plein naast het NS-station in Enschede."
                            },
                            {
                                "example_id": "e18e4a8b-df8f-4ae7-94dd-9791dd593a87",
                                "sense_id": "335c65f7-2b85-32c2-aa7e-39869f033133",
                                "text": "Cultuurmakelaar Eleon de Haas is aangewezen als projectleider voor een deel van Overijssel en wel voor de gemeenten Deventer, Olst-Wijhe, Raalte, Rijssen-Holten, Hellendoorn, Wierden en Twenterand. De route is gemarkeerd met luisterplekken in de vorm van een veldkei met plaquette met daarop een tekst. Deze tekst geeft in het kort weer wat er gebeurd is in de nabije omgeving."
                            }
                        ]
                    }
