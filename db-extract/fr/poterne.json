                    {
                        "translation_id": "13704d4b-b1cf-4f2d-854a-d2cf572eef1d",
                        "source_entry_id": "1f65658d-24e4-3a13-995f-3b4cc6bc5dff",
                        "source_sense_description": "(Fortification)",
                        "target_lang_word": "postern",
                        "target_lang_code": "en",
