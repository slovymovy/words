                        "sense_id": "3c3ce064-1332-335f-98d7-d0366c658dbf",
                        "entry_id": "2c433fe4-d1d3-3ac8-8ff0-5d0c32684be2",
                        "glosses": [
                            "To raise (someone) up from under something that has overwhelmed them."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "11aced34-5c99-4a87-9d72-dd7e894bd412",
                                "sense_id": "3c3ce064-1332-335f-98d7-d0366c658dbf",
                                "text": "And it is all through him\nWho as a guest came pledged into this house.\nCame with the chivalry and manly show\nOf reverence and grace, that he too well\nHas learnt in cunning lands and used to lure.\nAh, and he seeks us now! unwhelmed of it!\nReady of step, impassive, cold!"
                            },
                            {
                                "example_id": "7951144f-089b-4988-bce7-83aef966b403",
                                "sense_id": "3c3ce064-1332-335f-98d7-d0366c658dbf",
                                "text": "‘Well,’ said Caroline, unwhelming herself of a sudden access of confidence in the Baron’s disinterestedness"
                            }
                        ]
                    }
