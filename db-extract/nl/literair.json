                "senses": [
                    {
                        "sense_id": "5dbb16d1-9859-3a1b-89b9-0076dba87e3f",
                        "entry_id": "b1f99b2f-ba37-35ae-8926-dacfcceb392e",
                        "glosses": [
                            "behorend tot, betrekking hebbend op de literatuur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43fddb91-dde5-4350-97f4-a32506c9d638",
                                "sense_id": "5dbb16d1-9859-3a1b-89b9-0076dba87e3f",
                                "text": "Mijn werk is al gepubliceerd in een aantal literaire tijdschriften."
                            },
                            {
                                "example_id": "7dae4fce-3d31-4ced-895b-367036e34e4e",
                                "sense_id": "5dbb16d1-9859-3a1b-89b9-0076dba87e3f",
                                "text": "Dramatisch en literair gezien heeft het boek niet veel om zijn lijf."
                            },
                            {
                                "example_id": "9a1b1e23-dc61-491e-b2a1-c051aa6052b0",
                                "sense_id": "5dbb16d1-9859-3a1b-89b9-0076dba87e3f",
                                "text": "In die jaren schreef hij ook zijn bekendste kinderboeken. Hij deed dat er zo'n beetje bij, in vakanties. Geen literaire meesterwerken, maar sommige worden nog steeds gelezen. De verfilming van Oorlogswinter uit 2008 trok bijna een miljoen bioscoopbezoekers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77a50559-c487-44f0-8b31-ec0a9cb0bda0",
                        "source_entry_id": "b1f99b2f-ba37-35ae-8926-dacfcceb392e",
                        "source_sense_id": "5dbb16d1-9859-3a1b-89b9-0076dba87e3f",
                        "target_lang_word": "literary",
