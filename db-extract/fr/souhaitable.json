                        "entry_id": "e7ae7450-0d41-3b9e-9d34-f0cdcc11c4cd",
                        "glosses": [
                            "Qui est désirable, qu’on peut souhaiter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db0b46a5-e666-4ae0-95d5-fbef5566b309",
                                "sense_id": "76ffb970-c800-392f-bc5a-449edf47456c",
                                "text": "Il a toutes les qualités souhaitables."
                            },
                            {
                                "example_id": "75615dd1-e0bf-4de7-8e55-34c0ec4844f3",
                                "sense_id": "76ffb970-c800-392f-bc5a-449edf47456c",
                                "text": "Il serait fort souhaitable qu'un petit accident arrive à Jean Charest."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9525a768-aedc-4abd-9b4c-7467c95daa03",
                        "source_entry_id": "e7ae7450-0d41-3b9e-9d34-f0cdcc11c4cd",
                        "source_sense_id": "76ffb970-c800-392f-bc5a-449edf47456c",
                        "target_lang_word": "wünschenswert",
