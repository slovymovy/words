{
    "word_family": [
        "testify",
        "testimony"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b8f1723d-fdfa-3965-bc4b-123ed3aa7fb9",
                    "sense_definition": "A formal statement or recommendation testifying to someone's character, qualifications, or the value of a product or service.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "endorsement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company website features a glowing customer <w>testimonial</w> on its front page.",
                            "target_lang_translations": {
                                "ru": "На главной странице сайта компании опубликован восторженный <w>отзыв</w> клиента."
                            }
                        },
                        {
                            "text": "She included a personal <w>testimonial</w> from her previous employer in the application.",
                            "target_lang_translations": {
                                "ru": "Она приложила к заявлению личную <w>рекомендацию</w> от предыдущего работодателя."
                            }
                        }
                    ],
                    "synonyms": [
                        "recommendation",
                        "endorsement"
                    ],
                    "common_phrases": [
                        "customer testimonial",
                        "written testimonial"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное заявление или рекомендация, подтверждающая качества, квалификацию человека либо достоинства товара или услуги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отзыв",
                                "target_lang_sense_clarification": "о товаре, услуге или работе"
                            },
                            {
                                "target_lang_word": "рекомендация",
                                "target_lang_sense_clarification": "о человеке или специалисте"
                            },
                            {
                                "target_lang_word": "характеристика",
                                "target_lang_sense_clarification": "официальный документ о качествах работника"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5fb628c-9a1f-3af5-8ff4-e757a82763ed",
                    "sense_definition": "Something given or done as an expression of appreciation or tribute for someone's service or achievements.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tribute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave a moving <w>testimonial</w> to his mentor at the retirement dinner.",
                            "target_lang_translations": {
                                "ru": "На торжественном ужине по случаю выхода на пенсию он произнёс трогательную речь как <w>дань уважения</w> своему наставнику."
                            }
                        },
                        {
                            "text": "The community organized a <w>testimonial</w> banquet in honor of the retiring doctor.",
                            "target_lang_translations": {
                                "ru": "Община организовала <w>в знак признательности</w> банкет в честь уходящего на пенсию доктора."
                            }
                        }
                    ],
                    "synonyms": [
                        "tribute",
                        "homage"
                    ],
                    "common_phrases": [
                        "testimonial dinner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или подарок в знак признательности и дань уважения за чьи-либо заслуги или достижения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дань уважения",
                                "target_lang_sense_clarification": "выражение признательности"
                            },
                            {
                                "target_lang_word": "знак признательности",
                                "target_lang_sense_clarification": "жест благодарности"
                            },
                            {
                                "target_lang_word": "свидетельство",
                                "target_lang_sense_clarification": "проявление или подтверждение почёта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89bdd902-ca59-37ff-a597-31a20cf18ab2",
                    "sense_definition": "A formal statement presented as evidence, especially one made under oath.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness provided a detailed <w>testimonial</w> to the court during the trial.",
                            "target_lang_translations": {
                                "ru": "Во время судебного процесса свидетель дал суду подробные <w>показания</w>."
                            }
                        },
                        {
                            "text": "Her written <w>testimonial</w> helped substantiate the allegations against the firm.",
                            "target_lang_translations": {
                                "ru": "Её письменное <w>показание</w> помогло подтвердить обвинения против фирмы."
                            }
                        }
                    ],
                    "synonyms": [
                        "testimony"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное заявление, представляемое в качестве доказательства, особенно сделанное под присягой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свидетельские показания",
                                "target_lang_sense_clarification": "в суде"
                            },
                            {
                                "target_lang_word": "показание",
                                "target_lang_sense_clarification": "официальное свидетельство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c59a8cf0-8c33-3120-9247-2daa0f813ce7",
                    "sense_definition": "A sporting match played in honour of a long-serving player, often with proceeds awarded to them.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thousands of fans gathered at the stadium for the veteran defender's <w>testimonial</w>.",
                            "target_lang_translations": {
                                "ru": "Тысячи болельщиков собрались на стадионе на <w>бенефис</w> защитника-ветерана."
                            }
                        },
                        {
                            "text": "He decided to donate the gate receipts from his <w>testimonial</w> to local charities.",
                            "target_lang_translations": {
                                "ru": "Он решил пожертвовать билетную выручку со своего <w>прощального матча</w> местным благотворительным организациям."
                            }
                        }
                    ],
                    "common_phrases": [
                        "testimonial match"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Матч, проводимый в честь игрока, долго выступавшего за клуб, часто со сбором средств в его пользу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бенефис",
                                "target_lang_sense_clarification": "матч в честь спортсмена"
                            },
                            {
                                "target_lang_word": "прощальный матч",
                                "target_lang_sense_clarification": "матч в честь завершения карьеры или долгой службы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "80002555-5f82-3d61-807d-4e5d5ba12b6e",
                    "sense_definition": "Serving as or relating to testimony or tribute.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "testimony_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee reviewed several <w>testimonial</w> letters submitted by the applicant's colleagues.",
                            "target_lang_translations": {
                                "ru": "Комитет рассмотрел несколько <w>рекомендательных</w> писем, представленных коллегами соискателя."
                            }
                        },
                        {
                            "text": "They organized a special <w>testimonial</w> banquet to celebrate his decades of service.",
                            "target_lang_translations": {
                                "ru": "Они устроили специальный <w>чествующий</w> банкет, чтобы отметить десятилетия его безупречной службы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Служащий свидетельством, рекомендацией или выражением признания и уважения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рекомендательный",
                                "target_lang_sense_clarification": "содержащий рекомендацию или отзыв"
                            },
                            {
                                "target_lang_word": "похвальный",
                                "target_lang_sense_clarification": "содержащий похвалу и признание"
                            },
                            {
                                "target_lang_word": "юбилейный",
                                "target_lang_sense_clarification": "в честь заслуг или круглой даты"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}