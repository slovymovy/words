                "senses": [
                    {
                        "sense_id": "5a947731-fc38-303d-bde0-78f8849c6e0d",
                        "entry_id": "4b8d2ad2-f2d0-3c3e-9489-49f07885e618",
                        "glosses": [
                            "Gattin eines Reichskanzlers"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "8c7937f1-6724-4f02-af6c-b592a281e9c8",
                                "sense_id": "5a947731-fc38-303d-bde0-78f8849c6e0d",
                                "text": "„Die dolchdegen-gemeuchelte Reichskanzlerin fällt eben so wie ihr fuselirter Gemal mit dem Obertheil des Leibes hinter die Scene.“"
                            },
                            {
                                "example_id": "f71293ec-3fec-4f1c-a34c-24ffbb5ccc31",
                                "sense_id": "5a947731-fc38-303d-bde0-78f8849c6e0d",
                                "text": "„Groß und schlank, trotz ihres weißen Haares von frischem, jugendlichen Aussehen, ist sie [Martha Cuno] wohl die schönste deutsche Reichskanzlerin gewesen.“"
                            },
                            {
                                "example_id": "e02ff084-ff57-426b-958e-2e93fecc38b4",
                                "sense_id": "5a947731-fc38-303d-bde0-78f8849c6e0d",
                                "text": "„Frau Martha von Papen ist die zwölfte Reichskanzlerin, die in der Wilhelmstraße 77 residiert.“"
                            },
                            {
                                "example_id": "712b9f01-1e4e-467c-bead-f3e627a2059a",
                                "sense_id": "5a947731-fc38-303d-bde0-78f8849c6e0d",
                                "text": "„Im Gefolge befanden sich der schwedische Reichskanzler Oxenstiern, der sich damals in Elbing aufhielt, die Offiziere der schwedischen Garnison, der Rath, die Bürgerschaft, die schwedische und elbingsche Priesterschaft, die Reichskanzlerin, die Wittwe des Grafen und viel vornehmes schwedisches und elbingsches ‚Frauenzimmer‘.“"
                            },
                            {
                                "example_id": "f04d2436-912d-4dc1-9862-92db35d6d2db",
                                "sense_id": "5a947731-fc38-303d-bde0-78f8849c6e0d",
                                "text": "„Durch das Fenster sehe ich, daß unten im Garten die neue Reichskanzlerin am Kaffetisch präsidirt und Besuch hat: steif dasitzende Damen und respektvolle Herren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "76492e5d-8959-3aae-9bbc-1ebd176a8599",
                        "entry_id": "4b8d2ad2-f2d0-3c3e-9489-49f07885e618",
                        "glosses": [
                            "Titel einer hypothetischen Inhaberin des Amtes des Reichskanzlers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d305443-ed75-4fc8-824f-db613b9a8be3",
                                "sense_id": "76492e5d-8959-3aae-9bbc-1ebd176a8599",
                                "text": "„Wer weiß, vielleicht begrüßt du ja eines Tages in diesem Haus eine Reichskanzlerin?“"
                            },
                            {
                                "example_id": "b3fccec5-2bd8-43ba-923a-6f1aeb6d959a",
                                "sense_id": "76492e5d-8959-3aae-9bbc-1ebd176a8599",
                                "text": "„Und was würden gleiche Bildungschancen für Frauen für die Welt bedeuten? Ärztinnen, Chemikerinnen, Physikerinnen, Anwältinnen, Richterinnen, am Ende gar eine Reichskanzlerin? Unvorstellbar. Wahnwitzig. Absurd. Oder die Zukunft?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
