            "senses": [
                {
                    "sense_id": "188d8923-62e4-3cac-a0c7-773a096f7e4d",
                    "sense_definition": "Небольшой <w>сад</w> или участок с растениями.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "garden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы посадили розы в наш маленький <w>садик</w> перед домом.",
                            "target_lang_translations": {
                                "de": "Wir haben Rosen in unser kleines <w>Gärtchen</w> vor dem Haus gepflanzt."
                            }
                        },
                        {
                            "text": "Вечером вся семья отдыхала в уютном <w>садике</w>.",
                            "target_lang_translations": {
                                "de": "Am Abend entspannte sich die ganze Familie im gemütlichen <w>Gärtchen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "садок"
                    ],
                    "common_phrases": [
                        "маленький садик",
                        "цветочный садик"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kleiner Garten oder ein Bereich mit Pflanzen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gärtchen",
                                "target_lang_sense_clarification": "Verkleinerungsform von Garten, betont die geringe Größe."
                            },
                            {
                                "target_lang_word": "kleiner Garten",
                                "target_lang_sense_clarification": "Beschreibende Bezeichnung für einen Garten von kleiner Fläche."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "679bbff9-bd1b-347c-b9eb-0b2b428e62c6",
                    "sense_definition": "Дошкольное образовательное учреждение для детей.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждое утро мама отводит сына в <w>садик</w>.",
                            "target_lang_translations": {
                                "de": "Jeden Morgen bringt Mama ihren Sohn in den <w>Kindergarten</w>."
                            }
                        },
                        {
                            "text": "Ребенок очень любит ходить в <w>садик</w> и играть с друзьями.",
                            "target_lang_translations": {
                                "de": "Das Kind geht sehr gerne in den <w>Kindergarten</w> und spielt mit Freunden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ходить в садик",
                        "отвести в садик"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное название детского сада"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Vorschulische Bildungseinrichtung für Kinder."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kindergarten",
                                "target_lang_sense_clarification": "Die Standardbezeichnung für die Betreuungseinrichtung für Kinder im Vorschulalter."
                            },
                            {
                                "target_lang_word": "Kita",
                                "target_lang_sense_clarification": "Kurzform für Kindertagesstätte, ein sehr gebräuchlicher umgangssprachlicher Begriff."
                            }
                        ]
                    }
                }
            ]
        },
        {
