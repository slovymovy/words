    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e6fc0b94-e44d-3cc3-8fae-39c8e598c8da",
                    "sense_definition": "The act of sending large quantities of unwanted electronic messages.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "internet_abuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company implemented new filters to prevent the <w>spamming</w> of their customer support email accounts.",
                            "target_lang_translations": {
                                "ru": "Компания внедрила новые фильтры, чтобы предотвратить <w>спам-рассылки</w> на адреса службы поддержки."
                            }
                        },
                        {
                            "text": "He was banned from the forum for the constant <w>spamming</w> of irrelevant advertisements.",
                            "target_lang_translations": {
                                "ru": "Его заблокировали на форуме за постоянный <w>спам</w> неуместной рекламой."
                            }
                        }
                    ],
                    "synonyms": [
                        "junking"
                    ],
                    "common_phrases": [
                        "email spamming",
                        "forum spamming"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс массовой рассылки нежелательных электронных сообщений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спам",
                                "target_lang_sense_clarification": "массовая рассылка нежелательной информации"
                            },
                            {
                                "target_lang_word": "рассылка спама",
                                "target_lang_sense_clarification": "действие по отправке нежелательных сообщений"
                            }
                        ]
                    }
                }
            ]
        },
        {
