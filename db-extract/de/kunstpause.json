                ],
                "senses": [
                    {
                        "sense_id": "f86c1ff0-c899-3ade-bbd7-76d45dbfb37d",
                        "entry_id": "29d74f86-6d38-3c8b-b3ca-8fa222c9286e",
                        "glosses": [
                            "bewusst eingelegte Sprechpause, um das Gesagte wirken zu lassen, eine Pointe zu setzen oder Ähnliches"
                        ],
                        "tags": [
                            "Rhetorik"
                        ],
                        "examples": [
                            {
                                "example_id": "f5224004-5334-4594-879b-2c8938f1df53",
                                "sense_id": "f86c1ff0-c899-3ade-bbd7-76d45dbfb37d",
                                "text": "Sie dehnte die Kunstpause noch ein wenig länger aus, indem sie einen Schluck Wasser nahm und erst danach fortsetzte."
                            },
                            {
                                "example_id": "dc97c9a5-fab0-45d2-9ab5-bf9b91426377",
                                "sense_id": "f86c1ff0-c899-3ade-bbd7-76d45dbfb37d",
                                "text": "„Amalia machte eine weitere Kunstpause, während Milena sich vorbeugte, ihre Augen geweitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "26244c4a-582d-3803-892b-e592dbfbfb6a",
                        "entry_id": "29d74f86-6d38-3c8b-b3ca-8fa222c9286e",
                        "glosses": [
                            "ungewolltes Stocken bei einer Rede, einem Vortrag oder Ähnlichem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "380bc1b2-7474-494a-aee0-b1707f3ec979",
                                "sense_id": "26244c4a-582d-3803-892b-e592dbfbfb6a",
                                "text": "„Peinlich war nur die Kunstpause, welche der Kandidat nach wiederholten Versuchen, den Rest der Stunde auszufüllen, eintreten ließ.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
