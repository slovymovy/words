                "senses": [
                    {
                        "sense_id": "b272349e-c6d0-3665-91a0-09792a24f236",
                        "entry_id": "f7d31a01-133f-3ff3-a025-25ef301644ca",
                        "glosses": [
                            "refutation; disproof"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19cfcb22-d4d8-466d-b854-55f5a2e83acf",
                                "sense_id": "b272349e-c6d0-3665-91a0-09792a24f236",
                                "text": "Он переноси́л вопро́с на метафизи́ческие высо́ты, переходи́л в определе́ния простра́нства, вре́мени, мы́сли и, вынося́ отту́да опроверже́ния, опя́ть спуска́лся на по́чву спо́ра.",
                                "translation": "He would transfer a question to metaphysical heights, pass on to definitions of space, time, and thought, and, having deduced the refutation he needed, would again descend to the level of the original discussion.",
                                "english": "He would transfer a question to metaphysical heights, pass on to definitions of space, time, and thought, and, having deduced the refutation he needed, would again descend to the level of the original discussion."
                            }
                        ]
                    }
