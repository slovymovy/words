                    }
                ],
                "translations": [
                    {
                        "translation_id": "9775eb95-5491-4040-bc4b-6c137e6d1f3f",
                        "source_entry_id": "27bca67d-69dc-3132-8158-9bc4d6571ef5",
                        "source_sense_id": "cc8848a7-26af-3cb9-ad8b-9337a5d1e568",
                        "source_sense_description": "veraltet: übertriebene Vertrautheit",
                        "target_lang_word": "Vertrautheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vertrautheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc3d1fc2-4702-3669-9157-83e63e4f2cc0",
                                        "entry_id": "b6c6d0f0-95ef-324c-b443-d6ae09b205b6",
                                        "glosses": [
                                            "Befindlichkeit, die sich daraus ergibt, dass man sich mit etwas auskennt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41fbc921-7990-4003-a3e2-9cf18a8fc518",
                                                "sense_id": "bc3d1fc2-4702-3669-9157-83e63e4f2cc0",
                                                "text": "„Über Nacht wurde ich aus der Vertrautheit des Dorfes in die Anonymität des Molochs entlassen.“"
                                            },
                                            {
                                                "example_id": "9da684a3-a339-4619-913e-b64bb67d209d",
                                                "sense_id": "bc3d1fc2-4702-3669-9157-83e63e4f2cc0",
                                                "text": "„Meine Kriterien für die Aufnahme von Texten resultierten aus meiner Eigenschaft als Erzählforscher und einer durch Lehre und Forschung erzielten langen Vertrautheit mit den humoristischen Gattungen der Volksliteratur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c6da753-1f04-36a1-b735-316563fa920e",
                                        "entry_id": "b6c6d0f0-95ef-324c-b443-d6ae09b205b6",
                                        "glosses": [
                                            "enge persönliche Beziehung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4df783f-00f6-4dc0-b7e1-b4661c8a2ede",
                                                "sense_id": "3c6da753-1f04-36a1-b735-316563fa920e",
                                                "text": "Ihre Vertrautheit ging so weit, dass sie sich ohne Worte verständigen konnten."
                                            },
                                            {
                                                "example_id": "c19d4c30-abf1-44a4-8ed0-1c906c974e2c",
                                                "sense_id": "3c6da753-1f04-36a1-b735-316563fa920e",
                                                "text": "„Schon bald bestand ein großes Gefühl der Vertrautheit zwischen Lothar und Geneviève.“"
                                            },
                                            {
                                                "example_id": "05376f4b-9bc3-4d3b-92cc-16f40f2565d7",
                                                "sense_id": "3c6da753-1f04-36a1-b735-316563fa920e",
                                                "text": "„Für mich persönlich war bislang das Knie einer Dame Gegenstand zarter Vertrautheit, und ich sehe allen modernen Umwälzungen auf diesem Gebiet mit größter Besorgnis entgegen.“"
                                            },
                                            {
                                                "example_id": "c956eb8b-d906-405f-b948-0b6526a4153f",
                                                "sense_id": "3c6da753-1f04-36a1-b735-316563fa920e",
                                                "text": "„Das wiederum setzt eigentlich nach alter Regel Vertrautheit voraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
