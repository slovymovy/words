                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a8435b6-0c66-4dd4-83c8-a9049ad106ca",
                                "sense_id": "fd583159-2121-3d33-96c8-26086b2f96cd",
                                "text": "Samsung en Microsoft zijn al langere tijd bezig op het gebied van gezondheidszorg. Nieuwere Samsung-apparaten beschikken over een hartslagmeter die is gekoppeld aan de app S Health. Ook die kan informatie van andere gezondheidsproducten en -diensten verzamelen."
                            },
                            {
                                "example_id": "e18d7fde-ec73-4bdd-bdda-1fdbbe42fde8",
                                "sense_id": "fd583159-2121-3d33-96c8-26086b2f96cd",
                                "text": "Erben Wennemars maakte zijn 'rentree' op de NK afstanden. Hij droeg tijdens zijn race op de 1.500 meter een hartslagmeter, waarvan de gegevens live te volgen waren."
                            }
                        ]
