                        ]
                    },
                    {
                        "translation_id": "783ec299-baf2-4e41-a431-340205a7b468",
                        "source_entry_id": "3b976d69-504b-3bbe-8edc-48ab6f18abc5",
                        "source_sense_description": "действие по значению гл. «лишать», «лишить»",
                        "target_lang_word": "privation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "privation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63373b21-31cf-3a45-9ea4-8b919c003bd4",
                                        "entry_id": "e796350d-4176-33ac-96d6-39b3aacadff8",
                                        "glosses": [
                                            "Perte, absence, manque d’un bien ou d’un avantage qu’on avait, ou qu’on devait ou qu’on pouvait avoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b086f6-9748-434b-a0ef-523eb0a82f58",
                                                "sense_id": "63373b21-31cf-3a45-9ea4-8b919c003bd4",
                                                "text": "La privation de la vue, de l’ouïe."
                                            },
                                            {
                                                "example_id": "81896c40-7e91-4a93-9e2b-30e51d5b90da",
                                                "sense_id": "63373b21-31cf-3a45-9ea4-8b919c003bd4",
                                                "text": "C’est un homme qui est dans la privation de toutes choses."
                                            },
                                            {
                                                "example_id": "e4ad263f-289c-4538-b4ad-4728f1a3678a",
                                                "sense_id": "63373b21-31cf-3a45-9ea4-8b919c003bd4",
                                                "text": "On châtia cette ville par la privation de ses privilèges."
                                            },
                                            {
                                                "example_id": "ff04b705-79d0-41c1-9164-bc1d7ce056e7",
                                                "sense_id": "63373b21-31cf-3a45-9ea4-8b919c003bd4",
                                                "text": "La privation des droits civils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d89d3720-12f8-39e4-a7a4-18a8bbe5333b",
                                        "entry_id": "e796350d-4176-33ac-96d6-39b3aacadff8",
                                        "glosses": [
                                            "Manque de beaucoup de choses nécessaires à la vie."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7d1dd4a-68cc-4dc8-8c31-bbe5240e177b",
                                                "sense_id": "d89d3720-12f8-39e4-a7a4-18a8bbe5333b",
                                                "text": "Il l'avait saisie avec une sorte de frénésie, doué de l’appétit brutal de l'homme qui a dû accumuler trop de privations."
                                            },
                                            {
                                                "example_id": "6c52e7d3-1360-463a-bfc8-aab79990a42b",
                                                "sense_id": "d89d3720-12f8-39e4-a7a4-18a8bbe5333b",
                                                "text": "Les intempéries et les privations ne sont rien."
                                            },
                                            {
                                                "example_id": "4d306f55-3681-4988-81d9-e3355fd4d224",
                                                "sense_id": "d89d3720-12f8-39e4-a7a4-18a8bbe5333b",
                                                "text": "Ce n'était pas tous les jours que le butin se composait de plusieurs centaines de chrétiennes toutes plus vierges les unes que les autres. De tels moments effaçaient les souvenirs de longs mois de guerre, de privations et de souffrances..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "857dbceb-9a47-3d01-bc39-59e03a0f2143",
                                        "entry_id": "e796350d-4176-33ac-96d6-39b3aacadff8",
                                        "glosses": [
                                            "Action de se priver volontairement, de s’abstenir de quelque chose dont on pourrait jouir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff3d7271-467f-48e4-bfb4-a50cc1a39c36",
                                                "sense_id": "857dbceb-9a47-3d01-bc39-59e03a0f2143",
                                                "text": "S’imposer des privations."
                                            },
                                            {
                                                "example_id": "cd667125-0609-4212-9184-5ea9219c9673",
                                                "sense_id": "857dbceb-9a47-3d01-bc39-59e03a0f2143",
                                                "text": "À force de privations, il a amassé un petit pécule."
                                            },
                                            {
                                                "example_id": "44de1b58-c567-47eb-a39b-352eeb812fb2",
                                                "sense_id": "857dbceb-9a47-3d01-bc39-59e03a0f2143",
                                                "text": "Privation volontaire."
                                            },
                                            {
                                                "example_id": "9ec91cf5-2d5d-4348-b20f-e45a2a682e06",
                                                "sense_id": "857dbceb-9a47-3d01-bc39-59e03a0f2143",
                                                "text": "S’exercer, s’habituer aux privations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
