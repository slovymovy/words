                "senses": [
                    {
                        "sense_id": "c6499442-4a32-3fe5-82c5-806f84ebe36e",
                        "entry_id": "0c9c262c-c5b7-31c4-adf2-d4fa9ddede03",
                        "glosses": [
                            "Se tester soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce4e2368-7ec7-4e54-8d04-585a6e022a35",
                                "sense_id": "c6499442-4a32-3fe5-82c5-806f84ebe36e",
                                "text": "Le dispositif est censé permettre aux automobilistes de s’auto-tester avant de prendre le volant."
                            },
                            {
                                "example_id": "7bd19997-c5c5-4140-b075-b83b6cda22e0",
                                "sense_id": "c6499442-4a32-3fe5-82c5-806f84ebe36e",
                                "text": "Nous avons commencé par des tests musculaires pour qu'elle puisse apprendre à s'auto-tester."
                            },
                            {
                                "example_id": "009b1dc7-83e0-4c8b-a626-c44be346196d",
                                "sense_id": "c6499442-4a32-3fe5-82c5-806f84ebe36e",
                                "text": "Il s'agit de faire de l'auto-contrôle un nouveau réflexe en incitant chacun à s'auto-tester quand il a un doute sur son alcoolémie."
                            }
                        ]
                    }
