                        "glosses": [
                            "Se pénétrer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6af219d0-fea1-41f3-b84e-b57549055289",
                                "sense_id": "06e99299-ecd3-3b09-9d22-ba758d349dc3",
                                "text": "D’autant plus fixe est ce point de vue, d’autant plus est-on sûr qu’il parviendra à s’auto-pénétrer et à éclairer l’évidence factice qui le constitue - en même temps le mouvement catégorial trouvera une autre structure et un autre rythme."
                            },
                            {
                                "example_id": "4fe690df-e825-4f31-94f7-09bd18b65f24",
                                "sense_id": "06e99299-ecd3-3b09-9d22-ba758d349dc3",
                                "text": "Moi-même je suis incapable de m'auto-pénétrer, et ce n'est pourtant pas faute d'avoir essayé."
                            },
                            {
                                "example_id": "79a82b40-c241-4b71-b356-71c645692d7b",
                                "sense_id": "06e99299-ecd3-3b09-9d22-ba758d349dc3",
                                "text": "Son lit lui permet de s'auto-pénétrer."
                            }
                        ]
                    }
