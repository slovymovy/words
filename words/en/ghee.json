            "senses": [
                {
                    "sense_id": "b29d26ee-58b5-3d7f-bee8-6bf222605e33",
                    "sense_definition": "A type of clarified butter originally from India, commonly used in South Asian cooking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking_fat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She heated a spoonful of <w>ghee</w> in the skillet before adding the spices.",
                            "target_lang_translations": {
                                "pl": "Rozgrzała łyżkę <w>ghi</w> na patelni przed dodaniem przypraw."
                            }
                        },
                        {
                            "text": "Many traditional Indian sweets are prepared using pure <w>ghee</w> for richer flavor.",
                            "target_lang_translations": {
                                "pl": "Wiele tradycyjnych indyjskich słodyczy przygotowuje się na bazie czystego <w>ghi</w>, aby uzyskać bogatszy smak."
                            }
                        }
                    ],
                    "synonyms": [
                        "clarified butter"
                    ],
                    "common_phrases": [
                        "pure ghee"
                    ],
                    "target_lang_definitions": {
                        "pl": "Rodzaj masła klarowanego pochodzącego z Indii, powszechnie stosowanego w kuchni południowoazjatyckiej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ghi",
                                "target_lang_sense_clarification": "indyjskie masło klarowane"
                            },
                            {
                                "target_lang_word": "masło klarowane",
                                "target_lang_sense_clarification": "ogólne określenie tłuszczu maślanego"
                            },
                            {
                                "target_lang_word": "ghee",
                                "target_lang_sense_clarification": "pisownia alternatywna/oryginalna"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b11cad52-dc32-3ecc-913a-01e651b719cc",
                    "sense_definition": "A clarified butter substitute made from vegetable oils, used as a cooking fat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cooking_fat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Because dairy can be expensive, many vendors cook their street food with vegetable <w>ghee</w>.",
                            "target_lang_translations": {
                                "pl": "Ponieważ nabiał bywa drogi, wielu sprzedawców przygotowuje uliczne jedzenie na <w>roślinnym ghi</w>."
                            }
                        },
                        {
                            "text": "The recipe calls for either animal fat or hydrogenated vegetable <w>ghee</w>.",
                            "target_lang_translations": {
                                "pl": "Przepis wymaga użycia tłuszczu zwierzęcego lub uwodornionego <w>roślinnego ghi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vegetable ghee",
                        "vanaspati"
                    ],
                    "common_phrases": [
                        "vegetable ghee"
                    ],
                    "target_lang_definitions": {
                        "pl": "Roślinny zamiennik masła klarowanego wytwarzany z olejów roślinnych, używany jako tłuszcz do smażenia i pieczenia."
                    },
                    "translations": {
