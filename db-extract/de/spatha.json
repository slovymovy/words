                        ]
                    },
                    {
                        "translation_id": "14b4b620-54d1-48fc-acf4-a504603a6ac5",
                        "source_entry_id": "af231ccf-20b1-39f1-926b-4172f4d63f0a",
                        "source_sense_id": "3df34840-bcb5-3f6f-8e17-2ad4099e2574",
                        "target_lang_word": "spathe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spathe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a8a4d05-87a1-3344-bcec-962df0b508b6",
                                        "entry_id": "cd12cfeb-3199-38f5-be1d-d3e4778b9123",
                                        "glosses": [
                                            "Nom donné à une lourde et courte épée utilisée par les Gaulois."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5d2fa0e-9849-4802-9d50-574f16e70dc9",
                                                "sense_id": "6a8a4d05-87a1-3344-bcec-962df0b508b6",
                                                "text": "G. Lefevre découvrit dans l’une de ces dernières tombes de très belles armes dont un angon (arme franque à deux crocs) et une spathe, ou grande épée avec inscription sur la garde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e184630-6dba-3d85-822b-d815f0e5a348",
                                        "entry_id": "cd12cfeb-3199-38f5-be1d-d3e4778b9123",
                                        "glosses": [
                                            "Grande bractée généralement membraneuse entourant une inflorescence entière, ordinairement sèche ou coriace, qui, dans certaines plantes, telles que les palmiers, les narcisses, les arums, les posidonies, etc., enveloppe en formant un sac ou un cornet toutes les parties de la fructification et se fend ou se crève lorsqu’elle a acquis un certain développement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62d32200-06a1-40d5-96f8-b9963a979c5c",
                                                "sense_id": "9e184630-6dba-3d85-822b-d815f0e5a348",
                                                "text": "La spathe de l’ail et de l’iris."
                                            },
                                            {
                                                "example_id": "fc9f0394-845a-473f-bdd1-870d31c6dd58",
                                                "sense_id": "9e184630-6dba-3d85-822b-d815f0e5a348",
                                                "text": "Une spathe uniflore, biflore, multiflore."
                                            },
                                            {
                                                "example_id": "78127b1c-e354-49af-89b2-f0ed089f561a",
                                                "sense_id": "9e184630-6dba-3d85-822b-d815f0e5a348",
                                                "text": "Composé d’une spathe (bractée d’un beau rouge foncé et velouté) d’où sort de son centre, le long spadice noir, le dracunculus commun a mis au point une stratégie complexe afin d'assurer la pollinisation croisée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a943b02-773d-32f5-8ea1-b31b418d4c1b",
                                        "entry_id": "cd12cfeb-3199-38f5-be1d-d3e4778b9123",
                                        "glosses": [
                                            "Feuille modifiée enveloppant l’épi de maïs."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35749372-1840-4637-aee1-f8015aae3603",
                                                "sense_id": "5a943b02-773d-32f5-8ea1-b31b418d4c1b",
                                                "text": "Les graines sont versées à l’aide d'une spathe de maïs ou totomoxtle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8acbc1e5-fcec-4352-8e1e-268f703f19dc",
                        "source_entry_id": "af231ccf-20b1-39f1-926b-4172f4d63f0a",
                        "source_sense_id": "3df34840-bcb5-3f6f-8e17-2ad4099e2574",
