                        "examples": [
                            {
                                "example_id": "16de5926-9823-4cf7-b19a-7745d9abae8d",
                                "sense_id": "cda6fafc-5f50-3ca1-9326-c0aea8bbe92e",
                                "text": "Mais, convenablement restaurés, frais, dispos, nous ne nous remettions en route qu’après avoir sablé le Ginglard — Un vin sincère, celui-là ! — un vin qui n’existe plus ! petit vin à quatre sous, ni bleu, ni blanc, ni rouge, mais « rose comme une jeune fille, roide comme un huissier », et que les progrès de la chimie, hélas ! ont remplacé par le vin de vigneron."
                            },
                            {
                                "example_id": "3bb9569a-05ed-4d53-aa0f-c651513c7f3f",
                                "sense_id": "cda6fafc-5f50-3ca1-9326-c0aea8bbe92e",
                                "text": "Robert était d’une constitution plus solide. Malgré une grande quantité de ginglard ingurgité, il se tenait toujours droit comme un « I »."
                            }
                        ]
                    }
