                        "glosses": [
                            "het ingenieurskorps van een leger dat zorgdraagt voor technische werken, zoals bijvoorbeeld bruggen, die nodig zijn voor het functioneren van een leger in oorlogstijd"
                        ],
                        "tags": [],
