                                        "glosses": [
                                            "Religieux, aussi appelé Constantin le Philosophe, qui évangélisa les peuples slaves de l’Europe centrale au IXᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
