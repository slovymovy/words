                    "sense_definition": "stevig bevestigd of niet beweeglijk",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bevestiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zit de knoop goed <w>vast</w> aan je jas?",
