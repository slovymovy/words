                "senses": [
                    {
                        "sense_id": "4aec8543-b3d6-3a9c-9439-dcda356c0c34",
                        "entry_id": "3c758968-f64b-3c23-82fd-227c29532e75",
                        "glosses": [
                            "Qui n'a pas obtenu satisfaction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc77d093-ee07-494f-9615-f647510dd9b2",
                                "sense_id": "4aec8543-b3d6-3a9c-9439-dcda356c0c34",
                                "text": "Pas de revendications, ni d’interpellations ad nominem ^([sic : ad hominem]) : pendant une heure, le successeur de Jean-Michel Blanquer a nagé dans la bienveillance, passant d’un stand à un autre sans avoir à gérer le comportement imprévisible de professeurs insatisfaits, voire mécontents."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27f28d8b-de8d-4dab-bee6-9c97ba14ecec",
                        "source_entry_id": "3c758968-f64b-3c23-82fd-227c29532e75",
                        "source_sense_id": "4aec8543-b3d6-3a9c-9439-dcda356c0c34",
                        "target_lang_word": "unzufrieden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unzufrieden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "680da296-2dd4-3ad2-b331-8180ea79789b",
                                        "entry_id": "6c402579-a811-3d1a-8440-4fec57d1e6c4",
                                        "glosses": [
                                            "nicht zufrieden, von einem Umstand gestört, mit etwas nicht einverstanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2643213d-39c9-4caf-9c9d-5ff1aad373e1",
                                                "sense_id": "680da296-2dd4-3ad2-b331-8180ea79789b",
                                                "text": "Ich bin mit der Situation im höchsten Maße unzufrieden. Es muss sich einiges ändern."
                                            },
                                            {
                                                "example_id": "6faa9902-2bcd-43e8-a997-a2bc67f2fdef",
                                                "sense_id": "680da296-2dd4-3ad2-b331-8180ea79789b",
                                                "text": "„In Kiel verbreitete sich das Gerücht über die Inhaftierung der Meuterer in Windeseile unter den unzufriedenen Marineangehörigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef73fefd-2374-4d0c-b18d-51e94d0dde37",
                        "source_entry_id": "3c758968-f64b-3c23-82fd-227c29532e75",
                        "source_sense_id": "4aec8543-b3d6-3a9c-9439-dcda356c0c34",
                        "target_lang_word": "unsatisfied",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsatisfied",
