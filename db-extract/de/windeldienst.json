                        "entry_id": "a2f96aa8-1276-37c6-919f-e1417ade9859",
                        "glosses": [
                            "Dienstleistungsunternehmen, das waschbare Windeln für Babys (zum Teil auch für unter Inkontinenz leidende Erwachsene) zur Verfügung stellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39360fcb-e5bd-4a2c-a821-1bb80d7c9e8e",
                                "sense_id": "5d189b8d-90b9-3f50-96e4-4437dc26e78a",
                                "text": "„Wer keine Lust hat, die schmutzigen Tücher selbst zu waschen, kann einen Windeldienst beauftragen.“"
                            },
                            {
                                "example_id": "ef1a95e5-2f98-4792-bee8-0a836c1623bb",
                                "sense_id": "5d189b8d-90b9-3f50-96e4-4437dc26e78a",
                                "text": "„Windeldienste werben damit, daß Baumwollwindeln ‚viel besser für Babys Po‘ sein sollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
