                        "glosses": [
                            "Espèce de cithare en usage dans l'Inde depuis l'Antiquité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04a858e2-4c7d-4c09-9660-cc16e4d5ad12",
                                "sense_id": "c0ee0ac3-6a68-396d-8df8-870b37241522",
                                "text": "Il en est souvent fait mention dans les livres indiens, où les dieux eux-mêmes sont représentés jouant du vounei pour se distraire par sa douce mélodie."
                            },
                            {
                                "example_id": "f232e376-3dc9-4f61-bb17-4e4e42d2ec2b",
                                "sense_id": "c0ee0ac3-6a68-396d-8df8-870b37241522",
                                "text": "Il n’en est pas ainsi des instruments à corde, et l’on entend souvent des Brahmes mêmes chanter en s’accompagnant d’une espèce de petite harpe, connue dans le pays sous le nom de vouna ou vounei."
                            }
                        ]
                    }
