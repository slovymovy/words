                "senses": [
                    {
                        "sense_id": "24990e62-07c0-3632-a5b7-59010b908e50",
                        "entry_id": "217aa5b2-ee27-32f0-82b6-c71e959a1692",
                        "glosses": [
                            "Having an undamageable reputation (by analogy with nonstick Teflon surfaces)."
                        ],
                        "tags": [
                            "informal",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e353286e-dabd-4011-9499-c7519216556a",
                                "sense_id": "24990e62-07c0-3632-a5b7-59010b908e50",
                                "text": "a Teflon image"
                            },
                            {
                                "example_id": "19ac15ac-4dc7-4331-8788-b693b2d7f46a",
                                "sense_id": "24990e62-07c0-3632-a5b7-59010b908e50",
                                "text": "But Ronald Reagan, by everybody's definition, was the Teflon president, and it wasn't that the media tried to touch him and failed."
                            },
                            {
                                "example_id": "5f3a74c1-0e7a-4403-9596-c6ab9fe305bc",
                                "sense_id": "24990e62-07c0-3632-a5b7-59010b908e50",
                                "text": "He would have called the man by his first name and said, Not at all, so and so, but though he was very good at remembering names where clients were concerned, there was something very Teflon about these guys and nothing about them was sticking with him."
                            }
                        ]
                    }
