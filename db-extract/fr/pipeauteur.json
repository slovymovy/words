                "senses": [
                    {
                        "sense_id": "dcdaf9bb-e4dd-3cea-9a9c-b63dcdad5d41",
                        "entry_id": "88e61d23-6e78-35bb-9a22-3da94c660993",
                        "glosses": [
                            "Personne qui affabule, qui raconte des mensonges."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "cf804e9f-462a-48ea-ab5c-511023f58481",
                                "sense_id": "dcdaf9bb-e4dd-3cea-9a9c-b63dcdad5d41",
                                "text": "Un pipeauteur. Mais ce n’est pas parce qu’il cherche à les embrouiller, comme l’ensemble de la classe politique, gauche en tête, que le chef de l’État parvient à rassurer les Français."
                            },
                            {
                                "example_id": "8666705b-0548-4949-9e06-2097596fb8f5",
                                "sense_id": "dcdaf9bb-e4dd-3cea-9a9c-b63dcdad5d41",
                                "text": "Aux mouflets qui, petits cons insolents, nous traiteront de pipeauteurs, on rappellera qu’il existe un document flou de cette rencontre au sommet entre americana fragile et rock lunaire …"
                            },
                            {
                                "example_id": "2fc45378-5542-413e-a788-f7c90b63b3ec",
                                "sense_id": "dcdaf9bb-e4dd-3cea-9a9c-b63dcdad5d41",
                                "text": "Fulbert voyait en Béatrice une pipeauteuse sans déontologie et vulgaire, Béatrice en Fulbert un être puant, misogyne et formaté."
                            }
                        ]
                    }
                ],
