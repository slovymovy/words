                {
                    "sense_id": "91495229-420a-3edd-a9a6-4c02418f3d83",
                    "sense_definition": "A short form for New Jersey, a state in the northeastern United States.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "He grew up in <w>Jersey</w> before moving to New York City for work.",
                            "target_lang_translations": {
                                "ru": "Он вырос в <w>Джерси</w> до того, как переехал работать в Нью-Йорк.",
                                "zh": "他在<w>新泽西</w>长大，后来搬到纽约市工作。"
                            }
                        },
                        {
                            "text": "We are driving down to <w>Jersey</w> to visit relatives this weekend.",
                            "target_lang_translations": {
