                        ]
                    },
                    {
                        "translation_id": "479caf3f-bc75-4224-8fa7-ce03509b1135",
                        "source_entry_id": "9492561b-78da-329a-bca9-ba34f383d1d5",
                        "source_sense_id": "d5c2a4e9-67c6-310f-b2da-2f366967023b",
                        "target_lang_word": "accomplissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accomplissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6b1d656-d241-3ad1-92a3-9dec978894b5",
                                        "entry_id": "9e0aefd6-8774-3ea0-a07a-5820548453da",
                                        "glosses": [
                                            "Action d’accomplir ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3959fa0-4da5-486a-9090-67c31177fe7b",
                                                "sense_id": "d6b1d656-d241-3ad1-92a3-9dec978894b5",
                                                "text": "[…], cependant il arrive certaines choses qui laissent une trace, certaines prophéties qui ont un accomplissement."
                                            },
                                            {
                                                "example_id": "acc2c8f1-81f7-4f5c-9cfb-4aef2f415cd2",
                                                "sense_id": "d6b1d656-d241-3ad1-92a3-9dec978894b5",
                                                "text": "[…], tout concourait en même temps pour préparer la chute de la branche aînée des Bourbons; mais, de la probabilité à l’accomplissement du fait, il y avait loin , et l'on ne peut disconvenir que M. Thiers et tous les instigateurs du mouvement ne jouassent gros jeu."
                                            },
                                            {
                                                "example_id": "896d7f77-5eb6-455e-920c-64e27688db85",
                                                "sense_id": "d6b1d656-d241-3ad1-92a3-9dec978894b5",
                                                "text": "Le soldat des guerres de la Liberté attachait une importance presque supersti­tieuse à l’accomplissement des moindres consignes."
                                            },
                                            {
                                                "example_id": "b02cdfe3-d89d-48c0-9427-4da14696ceeb",
                                                "sense_id": "d6b1d656-d241-3ad1-92a3-9dec978894b5",
                                                "text": "Je crois que le sens qu’elle trouvait à son travail, le sentiment de se sentir utile, de pouvoir mesurer les effets de son engagement, sa volonté de sortir de sa propre souffrance pour tenter d’apaiser celle des autres, furent pour elle une source de stabilité voire, pour la première fois de sa vie, d’accomplissement."
                                            }
                                        ]
