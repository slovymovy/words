                ],
                "senses": [
                    {
                        "sense_id": "7f12958e-b84c-3ca2-a0e4-41335bfc50f4",
                        "entry_id": "78416a85-4ac5-37d2-93af-680434b43afc",
                        "glosses": [
                            "производить плеск"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14f1caaa-dfbe-4e02-a3e3-2b0fd73422e8",
                                "sense_id": "7f12958e-b84c-3ca2-a0e4-41335bfc50f4",
                                "text": "По камням струится Терек, // Плещет мутный вал"
                            }
                        ]
                    },
                    {
                        "sense_id": "25d4b664-6c10-302c-bd9e-16f2de91f050",
                        "entry_id": "78416a85-4ac5-37d2-93af-680434b43afc",
                        "glosses": [
                            "обдавать жидкостью, брызгами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c018c939-2096-4570-987d-8178751a6653",
                                "sense_id": "25d4b664-6c10-302c-bd9e-16f2de91f050",
                                "text": "Они нагоняют пар, плещут на печь пивком для запаха, подметают пол за клиентами."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f27c7e8-0457-3347-a259-85e17b33c0f4",
                        "entry_id": "78416a85-4ac5-37d2-93af-680434b43afc",
                        "glosses": [
                            "проливать жидкость"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8fe9d08-dad7-467c-bd36-db4c55667eb3",
                                "sense_id": "0f27c7e8-0457-3347-a259-85e17b33c0f4",
                                "text": "Так семенил ногами, когда нёс на коромысле полные вёдра, так выгибался длинной своей фигурой, чтобы не плескать из ведёр, смех смотреть."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d580798-bfb7-3441-a235-242d86b8fe2b",
                        "entry_id": "78416a85-4ac5-37d2-93af-680434b43afc",
                        "glosses": [
                            "устар., прост. то же, что рукоплескать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41c6ddae-8884-477b-84bd-ab87ec64d5e5",
                                "sense_id": "9d580798-bfb7-3441-a235-242d86b8fe2b",
                                "text": "И Россияне коль громко плещут: // Виват Россия! виват драгая!"
                            },
                            {
                                "example_id": "0c925a1d-dd95-4bed-8a3a-570034396123",
                                "sense_id": "9d580798-bfb7-3441-a235-242d86b8fe2b",
                                "text": "Все — девки, парни, вдовы, деды старые — сядут на завалинке и руками плещут, как на концерте."
                            }
                        ]
                    }
                ],
