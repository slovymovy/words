                        "glosses": [
                            "Tort, dommage causé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87d6f041-760c-4b0d-bbab-197bd0dd2ed7",
                                "sense_id": "cfc253a3-8da2-3f4d-baca-55734f33ba83",
                                "text": "W okresie sprawowania funkcji wymaga się od nich niepodejmowania jakiejkolwiek działalności, która mogłaby narazić na szwank ich niezależność, bezstronność czy utrudnić wykonywanie obowiązków sędziowskich.",
                                "translation": "Pendant la durée de leur mandat, ils sont tenus de ne se livrer à aucune activité susceptible de mettre en péril leur indépendance, leur impartialité ou d'entraver l'exercice de leurs fonctions judiciaires."
                            }
                        ]
                    }
