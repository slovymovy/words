                "senses": [
                    {
                        "sense_id": "4faad345-a5ce-3326-9e03-0d90d5ebcad3",
                        "entry_id": "706b13ed-47ac-3ecd-92d8-dddae9bf47bd",
                        "glosses": [
                            "Élimination complète ou partielle des cornes d’un animal."
                        ],
                        "tags": [
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "92ad2079-d3db-46d6-a1a1-6c46971c840b",
                                "sense_id": "4faad345-a5ce-3326-9e03-0d90d5ebcad3",
                                "text": "L’écornage est l’une des procédures chirurgicales des plus pratiquées chez les caprins d’élevage afin, notamment, d’assurer la sécurité de l’éleveur et des autres animaux."
                            },
                            {
                                "example_id": "80ff4230-83a8-4132-8204-f826e66d154f",
                                "sense_id": "4faad345-a5ce-3326-9e03-0d90d5ebcad3",
                                "text": "L’écornage des vaches, chèvres, taureaux ou boucs est-il douloureux? La question est au cœur du débat sur l’initiative «Pour la dignité des animaux de rente agricoles», soumise au peuple le 25 novembre prochain."
                            }
                        ]
                    },
                    {
                        "sense_id": "33d9db0a-99f9-3752-bbba-5fc140fa8429",
                        "entry_id": "706b13ed-47ac-3ecd-92d8-dddae9bf47bd",
                        "glosses": [
                            "Action qui consiste à plier le coin d'une page d'un livre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e868fd37-2b1e-49f0-a635-45e149693a41",
                                "sense_id": "33d9db0a-99f9-3752-bbba-5fc140fa8429",
                                "text": "On n'a pas le droit de traiter un livre comme ça, lui avais-je reproché. Tu aimerais, toi, que je te torde le pouce ? … Moi, j'assimilais l'écornage d'un livre à un acte criminel."
                            }
                        ]
                    }
