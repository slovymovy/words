                        "source_sense_id": "305ba72a-4a5d-32a2-a4e7-ccf41dcf89cf",
                        "source_sense_description": "oudere vrouw die een jonge ongehuwde vrouw begeleidt",
                        "target_lang_word": "chaperon",
