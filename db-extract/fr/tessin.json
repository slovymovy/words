                                                "sense_id": "5ec17374-1f2e-3f7a-a9a5-1f0107295ead",
                                                "text": "Wir spazierten an den Ufern des Tessins."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
