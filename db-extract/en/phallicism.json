                        "glosses": [
                            "The worship of the penis or phallus, especially connected with fertility."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "49aafb0f-6b22-4791-902d-9893142f4ef5",
                                "sense_id": "00cfe3c0-2e1d-3273-99ff-973b78371c0f",
                                "text": "Phallicism was, therefore, at the root of all religion, and was definitely the opponent of evil and darkness."
                            },
                            {
                                "example_id": "3707eb5b-127d-4ade-929e-4ab18742ca35",
                                "sense_id": "00cfe3c0-2e1d-3273-99ff-973b78371c0f",
                                "text": "The study of phallicism is the study of religion. In this lies its importance. So true is this, it may safely be stated that no one who neglects the study of phallic worship can hope to secure any adequate understanding of the origin of religion."
                            }
                        ]
                    }
