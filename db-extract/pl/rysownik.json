                                        "entry_id": "edfaa9b8-13f5-3b27-8368-3245aa5090aa",
                                        "glosses": [
                                            "Celui dont la profession est de dessiner toute sorte de dessins : plan, BD, …"
                                        ],
                                        "tags": [
                                            "Dessin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3afec506-38cf-4463-a0e1-1a9e85885358",
                                                "sense_id": "95bf5081-e50f-3f53-b3d4-0983c1b1e2a3",
                                                "text": "Les obsèques de Jean-Jacques Sempé, dessinateur d’humour pessacais décédé à 89 ans, ont eu lieu à l’église Saint-Germain-des-Prés à Paris, hier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a92035da-2bcd-3cb6-ade4-c8280750b3a5",
                                        "entry_id": "edfaa9b8-13f5-3b27-8368-3245aa5090aa",
                                        "glosses": [
                                            "Peintre qui sait rendre avec justesse les formes, le contour des figures."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e140752c-c11d-4a1f-8383-6ac8685a1c65",
                                                "sense_id": "a92035da-2bcd-3cb6-ade4-c8280750b3a5",
                                                "text": "Ce peintre est bon coloriste, mais il n’est pas dessinateur."
                                            },
                                            {
                                                "example_id": "7fb18443-4915-4929-87f7-7bb5afdf5dd3",
                                                "sense_id": "a92035da-2bcd-3cb6-ade4-c8280750b3a5",
                                                "text": "Ingres était un grand dessinateur."
                                            },
                                            {
                                                "example_id": "01cabc33-219a-4e88-8fc3-3740be8ec1ba",
                                                "sense_id": "a92035da-2bcd-3cb6-ade4-c8280750b3a5",
                                                "text": "A défaut de passion, on trouvait dans ses toiles un archéologue savant et un dessinateur consommé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
