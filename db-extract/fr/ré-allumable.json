                        "entry_id": "e2a4c5ec-a05d-3e7b-8295-4deaa10359a7",
                        "glosses": [
                            "Qui peut être ré-allumé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bec5e60-d301-400d-aa6d-6613b16de1e2",
                                "sense_id": "095364c8-f4d9-36e5-bb60-881b15c74ae8",
                                "text": "Et nous avons la possibilité d’effectuer de la mise à poste de satellites avec une grande précision, grâce à un étage supérieur équipé d’un moteur ré-allumable."
                            },
                            {
                                "example_id": "1e50f734-b373-4309-8cf8-91ef61719463",
                                "sense_id": "095364c8-f4d9-36e5-bb60-881b15c74ae8",
                                "text": "De plus, l'étage supérieur est ré-allumable, ce qui apportera de la flexibilité aux futures missions."
                            },
                            {
                                "example_id": "0bf79033-76b8-471f-9f49-74e45512aa9c",
                                "sense_id": "095364c8-f4d9-36e5-bb60-881b15c74ae8",
                                "text": "L'étage supérieur est équipé de propulseurs ré-allumables qui permettent d'effectuer les derniers ajustements pour corriger la trajectoire."
                            }
                        ]
                    }
