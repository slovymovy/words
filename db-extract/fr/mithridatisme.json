                    }
                ],
                "senses": [
                    {
                        "sense_id": "f15b972f-9458-32c9-a11a-325e7651ee03",
                        "entry_id": "1136b817-8f9b-36a7-9a22-ef7f900d2107",
                        "glosses": [
                            "Synonyme de mithridatisation, immunité acquise à l'égard d'un poison par ingestion répétée de doses croissantes de ce poison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d32a7a3b-a21d-4466-b2b3-6ffce49e0f23",
                                "sense_id": "f15b972f-9458-32c9-a11a-325e7651ee03",
                                "text": "L'usage de certaines substances actives établit une tolérance, un mithridatisme ; cela se voit même pour les substances alimentaires."
                            },
                            {
                                "example_id": "5a7be8b2-8fe8-4e19-aa64-2b1abf23c8ea",
                                "sense_id": "f15b972f-9458-32c9-a11a-325e7651ee03",
                                "text": "Immunité naturelle ou mithridatisme spontané, notre tante à héritage possédait sans nul doute ce talent inhabituel !"
                            }
                        ]
                    },
                    {
                        "sense_id": "936595ad-590a-3058-89ee-6e56545a12ab",
                        "entry_id": "1136b817-8f9b-36a7-9a22-ef7f900d2107",
                        "glosses": [
                            "Insensibilité, indifférence acquise par l'habitude."
                        ],
                        "tags": [
                            "figuratively",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "0c0f3228-b8c1-4679-947b-59eebc0edaa1",
                                "sense_id": "936595ad-590a-3058-89ee-6e56545a12ab",
                                "text": "En disant « Babal », « Mémé », pour désigner des gens qu'elle ne connaissait pas, l'ambassadrice de Turquie suspendait les effets du « mithridatisme » qui, d'ordinaire, me la rendait tolérable."
                            }
                        ]
                    }
                ],
