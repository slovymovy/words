                    {
                        "translation_id": "36a7f79d-39f6-4ebd-994f-2ca2df816952",
                        "source_entry_id": "e2dc2bfb-d6b3-3d78-849a-50116eefebb4",
                        "source_sense_id": "cfaedd28-a260-32b7-bb6b-662890967426",
                        "target_lang_word": "pedophile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pedophile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d1f48a7-bba3-3921-b35b-2db16a50dcd1",
                                        "entry_id": "f85eb5e4-1c35-3624-b4dc-dd6291c97042",
                                        "glosses": [
                                            "An adult or older adolescent who is sexually attracted to prepubescent children."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "515aa52c-fdae-40d3-941b-99011b432870",
                                                "sense_id": "1d1f48a7-bba3-3921-b35b-2db16a50dcd1",
                                                "text": "Apart from his sexual behavior, the pedophile is typically law abiding."
                                            },
                                            {
                                                "example_id": "81137e7a-b0b0-479f-b8ca-0486ada55a4c",
                                                "sense_id": "1d1f48a7-bba3-3921-b35b-2db16a50dcd1",
                                                "text": "The pedophile, a particular type of child molester, is an adult whose conscious sexual interests and overt sexual behavior are directly either partially or exclusively toward children."
                                            },
                                            {
                                                "example_id": "0b43ccea-56fb-4f18-a764-ff4ae5ecb631",
                                                "sense_id": "1d1f48a7-bba3-3921-b35b-2db16a50dcd1",
                                                "text": "He uses trolling techniques to fight back against trolls that he particularly finds malevolent—specifically pedophiles and RIP trolls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26907f05-e8f2-3fce-9252-f94715b7507f",
                                        "entry_id": "f85eb5e4-1c35-3624-b4dc-dd6291c97042",
                                        "glosses": [
                                            "An adult who is sexually attracted to or engages in sexual acts with a child under the age of consent."
                                        ],
                                        "tags": [
                                            "US",
                                            "broadly",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b245f19d-d440-451b-bc4e-7440e0de7a8b",
                                                "sense_id": "26907f05-e8f2-3fce-9252-f94715b7507f",
                                                "text": "Although the Holy See publicly expressed its rejection of sexual abuse and pedophilia and expressed its commitment to cooperate with civil authorities when cases of pedophile priests were found¹², there are no known cases of bishops or cardinals, being found responsible for abusing children or covering up for pedophilia in their parishes. […] These ecclesiastic norms were the basis of the behaviors displayed by the religious authorities of Mexico and other countries, in order to cover up for pedophiles and their crimes committed against many children for a long time and in many different places."
                                            },
                                            {
                                                "example_id": "cf43ae7c-96ce-46f1-8ac0-7ee2054c531a",
                                                "sense_id": "26907f05-e8f2-3fce-9252-f94715b7507f",
                                                "text": "Multiple users on Truth Social responded to Trump’s post, calling for him to release more information. “You’re losing your most loyal followers and voices Mr President,” said one post. “Why are you protecting pedophiles?” said another post."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ad07bd6-f2b0-4b89-a348-e19fcf5c4e6c",
                        "source_entry_id": "e2dc2bfb-d6b3-3d78-849a-50116eefebb4",
                        "source_sense_id": "cfaedd28-a260-32b7-bb6b-662890967426",
