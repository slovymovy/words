                "senses": [
                    {
                        "sense_id": "7207d6cd-4545-341f-abdd-b6410d1c9fbf",
                        "entry_id": "6284d2d2-bbfc-3e03-802d-b1e5f82121cb",
                        "glosses": [
                            "kleines Glas- oder Kunststoffbehältnis für die Aufbewahrung von Arzneimitteln oder Chemikalien (wie etwa Impfstoffen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34d23a7e-3603-43ef-8fe7-2ff5b4085610",
                                "sense_id": "7207d6cd-4545-341f-abdd-b6410d1c9fbf",
                                "text": "„Die Mainzer Firma Schott konzentriert sich nach eigenen Angaben derzeit ‚voll und ganz‘ auf die Herstellung von Impfstofffläschchen, sogenannte Vials.“"
                            },
                            {
                                "example_id": "584400b0-e95b-4fd4-a770-6cc01b3a6a3c",
                                "sense_id": "7207d6cd-4545-341f-abdd-b6410d1c9fbf",
                                "text": "„Die Vials sollen unmittelbar vor ihrer Verwendung in der Waschmaschine gereinigt werden. Die letzte Spülung erfolgt mit Wasser für Injektionszwecke, und die Vials werden anschließend getrocknet. Dann werden die Vials drei Stunden bei 210–225 °C im Heißluftsterilisator sterilisiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
