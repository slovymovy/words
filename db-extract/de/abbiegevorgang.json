                "senses": [
                    {
                        "sense_id": "21f8751b-d81a-3324-88d9-b1021ab4607f",
                        "entry_id": "8fecbce5-2068-33f0-ad50-9ff146dca5cb",
                        "glosses": [
                            "Vorgang, bei dem ein Verkehrsteilnehmer seine Fahrtrichtung bogenartig ändert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fe6270d-2c1c-44a0-b15c-91e436549f6a",
                                "sense_id": "21f8751b-d81a-3324-88d9-b1021ab4607f",
                                "text": "„Nach der deutschen Einheit wurde das Schild auch in den alten Bundesländern verwendet, um den Abbiegevorgang der Autofahrer zu beschleunigen und Staus zu vermeiden.“"
                            },
                            {
                                "example_id": "27973385-7fc7-4d30-b844-9c8b12c48a59",
                                "sense_id": "21f8751b-d81a-3324-88d9-b1021ab4607f",
                                "text": "„Abbiegevorgänge in der Stadt beispielsweise wären für das heute benutzte Sensor-Netzwerk viel zu komplex.“"
                            }
                        ],
