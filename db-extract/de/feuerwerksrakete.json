                "senses": [
                    {
                        "sense_id": "3314eff5-be21-3d3e-a876-2a99e7df6a2f",
                        "entry_id": "60e5a101-ff47-35d9-8ee7-b699f5827580",
                        "glosses": [
                            "Flugkörper, der als Teil eines Feuerwerks abgeschossen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5153204b-e848-4695-bb27-b8f0cb35d2cc",
                                "sense_id": "3314eff5-be21-3d3e-a876-2a99e7df6a2f",
                                "text": "„Um einen neuen Filter für den Brennofen zu kaufen, musste man bis nach Pitman Mills fahren, während es bei Trackside Feuerwerksraketen in siebzehn verschiedenen Farben und Größen gab.“"
                            },
                            {
                                "example_id": "1349e2a8-2b88-4412-9eae-6b62854e9cbb",
                                "sense_id": "3314eff5-be21-3d3e-a876-2a99e7df6a2f",
                                "text": "„Ein Riesenrad drehte sich durch die Nacht, geschminkte Mädchen tanzten, und Feuerwerksraketen stiegen in die Höhe, platzten und gossen ein buntscheckiges Licht über den Festplatz und die nach oben gewandten Gesichter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
