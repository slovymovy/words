                    {
                        "sense_id": "a9e45e2f-d45f-328f-8b3f-951ac1ba1c78",
                        "entry_id": "fe8b0f49-322e-3057-9c0e-a98dbcd329c1",
                        "glosses": [
                            "To be kindled or ignited again."
