                ],
                "senses": [
                    {
                        "sense_id": "8a5c26cc-65e3-3949-b676-97a906c370dc",
                        "entry_id": "10165861-6721-3b14-af86-69f5e12a00ec",
                        "glosses": [
                            "Gefahr, dass beim Verkehren ein Schadensfall eintritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "845ff629-6a1e-4c73-81e5-19bc1832c882",
                                "sense_id": "8a5c26cc-65e3-3949-b676-97a906c370dc",
                                "text": "„Neulinge im motorisierten Straßenverkehr weisen ein etwa doppelt so hohes Unfallrisiko auf wie Fahrerfahrene;[…].“"
                            },
                            {
                                "example_id": "20db88a3-ffff-4940-8370-8e64fcec78b2",
                                "sense_id": "8a5c26cc-65e3-3949-b676-97a906c370dc",
                                "text": "„Blendermann […] hat eine Reihe gefährlicher Denkhaltungen bei jungen Fußgängern zusammengestellt, die ein hohes Unfallrisiko bergen.“"
                            },
                            {
                                "example_id": "78c09e8d-030c-45ea-8572-358c809cff0f",
                                "sense_id": "8a5c26cc-65e3-3949-b676-97a906c370dc",
                                "text": "„Man neigt nämlich instinktiv dazu, auf besonders gefährdeten Wegen langsamer zu fahren und reduziert dadurch sein Unfallrisiko auf ein normales Maß.“"
                            },
                            {
                                "example_id": "9fcb5c88-51f5-4b7e-9069-3c21917192d1",
                                "sense_id": "8a5c26cc-65e3-3949-b676-97a906c370dc",
                                "text": "„Exakt viermal so hoch ist das Unfallrisiko des telefonierenden Fahrers gegenüber dem, der es bleiben lässt.“"
                            },
                            {
                                "example_id": "498f2387-c627-46a6-a2a5-d6e6a278bef0",
                                "sense_id": "8a5c26cc-65e3-3949-b676-97a906c370dc",
                                "text": "„Das Smartphone, sagen Experten deshalb, ist in den zehn Jahren seiner Existenz zum Unfallrisiko Nummer eins geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
