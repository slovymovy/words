{
    "word_family": [
        "sentiment",
        "sentimentality"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9f4d9d2c-affd-3892-83e5-5d3e9becd712",
                    "sense_definition": "Characterized by or showing excessive emotion or tenderness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He kept the old letters because he was a <w>sentimental</w> person.",
                            "target_lang_translations": {
                                "tr": "Eski mektupları sakladı çünkü o <w>duygusal</w> bir insandı."
                            }
                        },
                        {
                            "text": "It is a <w>sentimental</w> value that makes this old watch so special to me.",
                            "target_lang_translations": {
                                "tr": "Bu eski saati benim için bu kadar özel kılan şey onun <w>duygusal</w> değeridir."
                            }
                        }
                    ],
                    "synonyms": [
                        "emotional",
                        "maudlin"
                    ],
                    "antonyms": [
                        "unsentimental"
                    ],
                    "common_phrases": [
                        "sentimental value",
                        "sentimental person"
                    ],
                    "target_lang_definitions": {
                        "tr": "Aşırı duygusallık gösteren veya duygularına fazla kapılan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "duygusal",
                                "target_lang_sense_clarification": "Duyguların ağır bastığı veya duygusal tepkiler veren kişiler için kullanılır."
                            },
                            {
                                "target_lang_word": "santimantal",
                                "target_lang_sense_clarification": "Duygulu, içli veya hassas anlamında kullanılan daha nadir bir terim."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "258d3fa6-6fc6-30a5-bb2a-c8c91c8ddaab",
                    "sense_definition": "Relating to or expressing romantic feelings.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They shared a <w>sentimental</w> moment under the moonlight.",
                            "target_lang_translations": {
                                "tr": "Ay ışığı altında <w>romantik</w> bir an paylaştılar."
                            }
                        },
                        {
                            "text": "The movie was full of <w>sentimental</w> scenes about young love.",
                            "target_lang_translations": {
                                "tr": "Film, genç aşk üzerine <w>duygusal</w> sahnelerle doluydu."
                            }
                        }
                    ],
                    "synonyms": [
                        "romantic",
                        "tender"
                    ],
                    "common_phrases": [
                        "sentimental moment"
                    ],
                    "target_lang_definitions": {
                        "tr": "Romantik duygularla ilgili veya bunları ifade eden."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "romantik",
                                "target_lang_sense_clarification": "Aşk ve romantizm içeren durumlar için kullanılır."
                            },
                            {
                                "target_lang_word": "duygusal",
                                "target_lang_sense_clarification": "Romantik bir bağlamda duygusallığı ifade eder."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d938b57c-312c-3aae-96c4-dd259052632a",
                    "sense_definition": "Based on feelings rather than logical reasoning.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His decision to keep the failing business was purely <w>sentimental</w>.",
                            "target_lang_translations": {
                                "tr": "İflas eden iş yerini elinde tutma kararı tamamen <w>duygusal</w> bir karardı."
                            }
                        },
                        {
                            "text": "We must avoid making <w>sentimental</w> choices when planning the budget.",
                            "target_lang_translations": {
                                "tr": "Bütçeyi planlarken <w>duygusal</w> seçimler yapmaktan kaçınmalıyız."
                            }
                        }
                    ],
                    "synonyms": [
                        "emotional"
                    ],
                    "target_lang_definitions": {
                        "tr": "Mantıksal akıl yürütmeden ziyade hislere dayanan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "duygusal",
                                "target_lang_sense_clarification": "Mantık yerine duygularla hareket edildiğini belirtir."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}