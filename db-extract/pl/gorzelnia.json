                                "target_senses": [
                                    {
                                        "sense_id": "cc3212bc-4e0b-3030-9b84-3c15095833be",
                                        "entry_id": "82efe258-ad21-3e58-b55e-ef001af5c260",
                                        "glosses": [
                                            "A place where distillation takes place, especially the distillation of alcoholic spirits."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5653b8e-867b-4d1b-a9b2-271281c57b82",
                                                "sense_id": "cc3212bc-4e0b-3030-9b84-3c15095833be",
                                                "text": "It's the water that makes this area famous. […] That water is still being used to supply Blackford's two dominant industries, Tullibardine whisky distillery to the south of the village and, more significantly, Highland Spring Group's bottling plant to the north."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35731e4c-68ee-3afd-937d-f381c58b5512",
                                        "entry_id": "82efe258-ad21-3e58-b55e-ef001af5c260",
                                        "glosses": [
                                            "A company that distills alcohol."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bcd4782c-9d2d-3876-a309-1e09680eea5d",
                                        "entry_id": "82efe258-ad21-3e58-b55e-ef001af5c260",
                                        "glosses": [
                                            "The process of distilling alcohol."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
