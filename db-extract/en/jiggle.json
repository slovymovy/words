                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c82a6c9c-ff80-4407-87b1-e50feb61ba8a",
                                "sense_id": "b7b1bc1c-9886-3bf5-9882-5299b94e9af9",
                                "text": "Jiggle the handle and see if the water stops."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1a9f315-9d84-3902-b719-038eb9b5d49a",
                        "entry_id": "34c5490c-2307-32f4-b64d-3d5731fb784e",
                        "glosses": [
                            "To shake, rattle, or wiggle."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5a7d6322-f0b5-445a-b235-a8c8f5d33e4c",
                                "sense_id": "a1a9f315-9d84-3902-b719-038eb9b5d49a",
                                "text": "The jelly jiggled in the bowl for a few moments after it was set down."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4a6756a-f581-43e3-bb8d-a6511de63b5b",
