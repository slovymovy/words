                ],
                "senses": [
                    {
                        "sense_id": "3ae2e7cc-9393-3fce-a38e-f662b53f00d6",
                        "entry_id": "f5c6701e-e7b4-3969-85d7-37aa64607081",
                        "glosses": [
                            "gemächlich vor einem her strömen/fließen"
                        ],
                        "tags": [
                            "impersonal",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e93401e3-11a6-4345-83b8-403eb2f19e82",
                                "sense_id": "3ae2e7cc-9393-3fce-a38e-f662b53f00d6",
                                "text": "„Nie kann mein Gemüt in schönen Schwingungen sanft einherfließen, wozu diese Schöne in der Tiefe meines geistigen Seins wie in den tiefen Eingeweiden der Erde verzaubert liegt.“"
                            },
                            {
                                "example_id": "0c62b34b-e20a-4396-b11b-2604c7b00144",
                                "sense_id": "3ae2e7cc-9393-3fce-a38e-f662b53f00d6",
                                "text": "„Denn unter normalen Verhältnissen müssten die Flüsse nach Aufschüttung der Mesas oben auf denselben einherfließen und es müsste das ganze Thal in seiner vollen Breite und Länge durch diese Schotterablagerungen bedeckt sein.“"
                            },
                            {
                                "example_id": "1f3099e3-3fd6-41d9-b82d-4ba3bde0dc8e",
                                "sense_id": "3ae2e7cc-9393-3fce-a38e-f662b53f00d6",
                                "text": "„Die dürftigen Wasser, welche auf der Hochebene in flachen Mulden einherfließen, senken fich nun mit beschleunigtem Lauf in tiefe Thäler hinab, zu deren Seiten schroffe Felswände sich in wachsender Höhe erheben.“"
                            },
                            {
                                "example_id": "60a5e360-7ca9-41fa-95c6-912d2e6378c1",
                                "sense_id": "3ae2e7cc-9393-3fce-a38e-f662b53f00d6",
                                "text": "„Große Hechte sind hier nun eine seltene Erscheinung, zumal sämmtliche Bäche und Flüsse ganz verarmt einherfließen und der jevige Teichwirth solche schwere Exemplare, als den Friedfrischen verderblich, zu vermeiden sucht.“"
                            },
                            {
                                "example_id": "464c8683-628a-49d5-a5e6-b75ea1471f70",
                                "sense_id": "3ae2e7cc-9393-3fce-a38e-f662b53f00d6",
                                "text": "[übertragen:] „Alphons von Liguori sagt, in Mitten all der Stürme läßt der Herr für die Gottesstadt einen Strom des Friedens einherfließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
