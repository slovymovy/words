                        "form": "elftalletjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c31fd17e-5531-38b3-a3e1-138f7fa6f2d4",
                        "entry_id": "fed5bbe9-1739-3997-a462-ca450192242e",
                        "glosses": [
                            "sportploeg die uit elf spelers bestaat, in het bijzonder een voetbalploeg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b07e257a-4cc2-4171-8fc2-fe3d1dfd20be",
                                "sense_id": "c31fd17e-5531-38b3-a3e1-138f7fa6f2d4",
                                "text": "Het Nederlands elftal speelt erg goed op het WK."
                            },
                            {
                                "example_id": "f91a52bb-d72a-48dc-bad6-838800659323",
                                "sense_id": "c31fd17e-5531-38b3-a3e1-138f7fa6f2d4",
                                "text": "Burgemeester Ron König zegt \"buitengewoon trots\" te zijn op het team. \"Go Ahead Eagles heeft echt voetbal laten zien zoals het hoort te zijn\", vindt hij. \"Heel Deventer is uitzinnig van blijdschap en terecht! We gaan woensdag het elftal groots onthalen en huldigen.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "46a65de6-4649-3723-9be4-787273ce1b58",
                        "entry_id": "fed5bbe9-1739-3997-a462-ca450192242e",
                        "glosses": [
                            "groep van elf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8709fa7d-d596-4269-99ea-68c5c11a9028",
                                "sense_id": "46a65de6-4649-3723-9be4-787273ce1b58",
                                "text": "March kende zijn type zonder zelfs maar om te kijken: drie aanvragen om overplaatsing naar de Kripo, alle drie afgewezen; een vrouw met plichtsbesef die een elftal kinderen voor de Führer had voortgebracht; een inkomen van tweehonderd rijksmark per maand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a16785e-7e05-41c9-8375-a9d2b97c74bf",
                        "source_entry_id": "fed5bbe9-1739-3997-a462-ca450192242e",
                        "source_sense_id": "c31fd17e-5531-38b3-a3e1-138f7fa6f2d4",
                        "source_sense_description": "sportploeg die uit elf spelers bestaat",
                        "target_lang_word": "Elf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a30ee141-5b8d-311f-9e9f-0525fe25a985",
                                        "entry_id": "f3550ed1-754e-32dd-aeab-fff0a7667c82",
                                        "glosses": [
                                            "keltische und germanische Märchen- und Sagengestalt; Naturgeist mit guter oder schlechter Gesinnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86b10b4f-01df-474c-9036-5a1909e39872",
                                                "sense_id": "a30ee141-5b8d-311f-9e9f-0525fe25a985",
                                                "text": "„Elfen schieben Menschen dem Volksglauben nach auch Wechselbälger unter.“"
                                            },
                                            {
                                                "example_id": "5788c456-ab12-4d81-b29f-2f0e7a1d5152",
                                                "sense_id": "a30ee141-5b8d-311f-9e9f-0525fe25a985",
                                                "text": "„Als Geister, als Huldufólk, als Elfen, treten sie bis heute in Erscheinung, die ungewaschenen Kinder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dcb0db37-41b8-37bc-8bd0-cff8b9be017b",
                                        "entry_id": "f3550ed1-754e-32dd-aeab-fff0a7667c82",
                                        "glosses": [
                                            "menschenähnliches Wesen eher guter Gesinnung"
                                        ],
                                        "tags": [
                                            "Fantasy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bb32271-0aca-4294-911f-02d4abdb5b35",
                                                "sense_id": "dcb0db37-41b8-37bc-8bd0-cff8b9be017b",
                                                "text": "„Gemeinsam ist vielen modernen Fantasywelten, dass die Elfen spitze Ohren besitzen, oft zierlich sind, musikbegabt, in vielen Fällen Magie wirken können, auf Menschen sehr attraktiv wirken und mit Zwergen verfeindet sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Elf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "589f4c27-67d4-3657-ba9d-42c97f2a4244",
                                        "entry_id": "7603b601-b34b-3ddc-a60f-34044c5e8579",
                                        "glosses": [
                                            "die natürliche Zahl Elf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b21d9be-ef9f-4b1d-8130-2a18156879b8",
                                                "sense_id": "589f4c27-67d4-3657-ba9d-42c97f2a4244",
                                                "text": "Auf die Zehn folgt die Elf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a6472add-6aa7-3650-b57e-dc4e375917f0",
                                        "entry_id": "7603b601-b34b-3ddc-a60f-34044c5e8579",
                                        "glosses": [
                                            "Fußballmannschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd75ac77-7a68-41eb-9daf-16ccfbcd9d08",
                                                "sense_id": "a6472add-6aa7-3650-b57e-dc4e375917f0",
                                                "text": "Die Hamburger Elf feierte ein großes Comeback."
                                            },
                                            {
                                                "example_id": "1f30cec7-2247-4c7f-9586-15027e68db72",
                                                "sense_id": "a6472add-6aa7-3650-b57e-dc4e375917f0",
                                                "text": "Auch die Elfen aus der Elfenbeinküste und aus Dänemark sind nun auf dem Rasen im Stadion, um ihr jeweils erstes WM-Spiel zu absolvieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8295233-1da6-4e4e-bd71-41af993fd753",
                        "source_entry_id": "fed5bbe9-1739-3997-a462-ca450192242e",
                        "source_sense_id": "c31fd17e-5531-38b3-a3e1-138f7fa6f2d4",
                        "source_sense_description": "sportploeg die uit elf spelers bestaat",
                        "target_lang_word": "Mannschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mannschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2b58ae1-f360-33a7-8d71-0740dcb443d0",
                                        "entry_id": "14ef0575-170e-359f-bc86-a0209188077e",
                                        "glosses": [
                                            "Besatzung eines Schiffes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfee4cbd-7051-4ab8-958b-542779568b02",
                                                "sense_id": "e2b58ae1-f360-33a7-8d71-0740dcb443d0",
                                                "text": "Einer von der Mannschaft blieb immer an Bord."
                                            },
                                            {
                                                "example_id": "6f78bfb7-b3f3-4a95-8428-f2ce5825e5cd",
                                                "sense_id": "e2b58ae1-f360-33a7-8d71-0740dcb443d0",
                                                "text": "„Sie ließen die Diligent komplett überholen und heuerten eine Mannschaft an, welche die Waren für die erste Fahrt nach Martinique an Bord verstaute; das Ganze nahm beinahe neun Monate in Anspruch.“"
                                            },
                                            {
                                                "example_id": "64181ed7-5e95-4075-9a2c-43a01f6b46f6",
                                                "sense_id": "e2b58ae1-f360-33a7-8d71-0740dcb443d0",
                                                "text": "„Von wankelmütigen Herrschern beauftragt, von einer unzuverlässigen Mannschaft begleitet, begab er sich auf unabsehbare Zeit unter unvorhersehbaren Gefahren auf eine Reise jenseits der Grenzen der bekannten Welt, um auf unsicheren Wegen ein erhofftes Ziel zu erreichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "142b1a5d-00bf-3a18-959a-e6a260424f83",
                                        "entry_id": "14ef0575-170e-359f-bc86-a0209188077e",
                                        "glosses": [
                                            "Soldaten einer militärischen Einheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5b83f50-cd0d-43d8-b69e-11f817152c04",
                                                "sense_id": "142b1a5d-00bf-3a18-959a-e6a260424f83",
                                                "text": "Die beiden Mannschaften hatten Aufstellung genommen."
                                            },
                                            {
                                                "example_id": "a2f40d97-accd-4048-a7df-32b5dc69ca11",
                                                "sense_id": "142b1a5d-00bf-3a18-959a-e6a260424f83",
                                                "text": "Noch gehört er zur Mannschaft, aber eigentlich wäre er gerne Offizier."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c6fc2c7f-b46c-317a-b205-6046c8f2d6fd",
                                        "entry_id": "14ef0575-170e-359f-bc86-a0209188077e",
                                        "glosses": [
                                            "Mitglieder einer ähnlich dem Militär gegliederten Organisation, zum Beispiel der Feuerwehr, Arbeitsteam"
                                        ],
                                        "tags": [
                                            "aber auch weiter gefasst salopp für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1da0380a-10cf-45fe-9a84-15f41c494e5d",
                                                "sense_id": "c6fc2c7f-b46c-317a-b205-6046c8f2d6fd",
                                                "text": "Die Mannschaft war gut eingespielt und so war das Feuer rasch gelöscht."
                                            },
                                            {
                                                "example_id": "0669c616-431d-4e0b-a2eb-e7eb6c061e27",
                                                "sense_id": "c6fc2c7f-b46c-317a-b205-6046c8f2d6fd",
                                                "text": "Die ganze Mannschaft hier hat sich wirklich viel Mühe gegeben, die Räumlichkeiten für den festlichen Anlass zu schmücken."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4e54f3db-3c48-3b7b-bcbe-12a3c735dd88",
                                        "entry_id": "14ef0575-170e-359f-bc86-a0209188077e",
                                        "glosses": [
                                            "Gruppe von Sportlern im gemeinsamen Wettstreit mit einer anderen Gruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ae3a2b6-b20c-49ee-a58d-4013afbb4917",
                                                "sense_id": "4e54f3db-3c48-3b7b-bcbe-12a3c735dd88",
                                                "text": "Der Kapitän versuchte den Schiedsrichter zu überzeugen, dass das Mitglied seiner Mannschaft keinen Regelverstoß begangen hätte – sondern, dass es ein Unfall gewesen sei."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
