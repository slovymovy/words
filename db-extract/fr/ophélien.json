                "senses": [
                    {
                        "sense_id": "6901ceaa-30cc-37f9-8aa6-fb356d0e99aa",
                        "entry_id": "a1c68cdd-93ed-3027-b739-f9fdbe6b092d",
                        "glosses": [
                            "Relatif au personnage de Ophélie de Shakespeare."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e75dba61-9bf3-41fe-9fa2-f2e531ccd881",
                                "sense_id": "6901ceaa-30cc-37f9-8aa6-fb356d0e99aa",
                                "text": "Cette échappée a tantôt la grâce ophélienne d’un glissement dans les langes du sommeil, tantôt le spasme convulsif du martyre, mais jamais elle ne suscite la compassion ou le deuil."
                            },
                            {
                                "example_id": "15f846cf-7fb5-4ae6-8b06-f018a5e3df02",
                                "sense_id": "6901ceaa-30cc-37f9-8aa6-fb356d0e99aa",
                                "text": "Je n'ose appliquer les mots tige ou branche aux mèches ophéliennes, fuyantes, presque volatiles, sur lesquelles gesticulent les fleurs funambules du chèvrefeuille. — (Jacques Laurent, Histoire égoïste, chapitre XXII, éd. de la Table Ronde, 1976, p. 321.)"
                            },
                            {
                                "example_id": "f74993ff-7ca1-4387-80c9-e3c69f61e355",
                                "sense_id": "6901ceaa-30cc-37f9-8aa6-fb356d0e99aa",
                                "text": "… où brillaient parfois des rayons ophéliens. — (Eugène Wenceslas Dick, « Un drame au Labrador », 1897, p. 109)"
                            }
                        ]
                    }
                ],
