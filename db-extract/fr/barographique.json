                        "glosses": [
                            "Relatif à la barographie et aux barographes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "564041cb-311a-42d3-97d7-006c0f7208c8",
                                "sense_id": "eb61c357-3f0b-3ab6-a783-335622fbf9c0",
                                "text": "En comparant la lecture barographique avec la pression exacte, chaque fois que celle-ci était déterminée soit par le baromètre normal, soit surtout par les baromètres de l'observatoire météorologique, soit enfin par les indications, corrigées, , des anéroïdes, on a obtenu pour chacune de ces fois une correction de cette lecture; […]."
                            },
                            {
                                "example_id": "f9abb23e-97ce-42e1-9815-3907f0f8a3e5",
                                "sense_id": "eb61c357-3f0b-3ab6-a783-335622fbf9c0",
                                "text": "Nous emportons d'ici six feuilles barographiques et six feuilles thermographiques , toutes continuent à provoquer les remarques déjà faites à propos des feuilles recueillies pendant les deux premières semaines de notre séjour ici."
                            }
                        ]
                    }
