    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a011ff35-5eea-3dfd-a55f-aed07e2f414e",
                    "sense_definition": "een beweging of proces tot staan brengen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stoppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De doelman wist de aanval te <w>stuiten</w> met een spectaculaire redding.",
                            "target_lang_translations": {
                                "en": "The goalkeeper managed to <w>stop</w> the attack with a spectacular save."
                            }
                        },
                        {
                            "text": "Het was erg lastig om haar enorme woordenvloed te <w>stuiten</w> tijdens het gesprek.",
                            "target_lang_translations": {
                                "en": "It was very difficult to <w>stem</w> her enormous flood of words during the conversation."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoppen",
                        "tegenhouden",
                        "belemmeren",
                        "onderbreken"
                    ],
                    "antonyms": [
                        "voortzetten",
                        "stimuleren"
                    ],
                    "common_phrases": [
                        "woordenvloed te stuiten",
                        "de opmars stuiten"
                    ],
                    "target_lang_definitions": {
                        "en": "to bring a movement or process to a standstill"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "to cause something to cease moving or progressing"
                            },
                            {
                                "target_lang_word": "halt",
                                "target_lang_sense_clarification": "to bring to a sudden or complete stop"
                            },
                            {
                                "target_lang_word": "stem",
                                "target_lang_sense_clarification": "to stop the flow or spread of something"
                            },
                            {
                                "target_lang_word": "check",
                                "target_lang_sense_clarification": "to slow down or stop the progress of something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f79d5087-f459-3c1d-ae53-ff90c918438b",
                    "sense_definition": "onverwacht of plotseling iets of iemand tegenkomen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ontmoeten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens onze wandeling door het bos <w>stuitten</w> we plotseling op een verborgen meertje.",
                            "target_lang_translations": {
                                "en": "During our walk through the forest, we suddenly <w>stumbled upon</w> a hidden lake."
                            }
                        },
                        {
                            "text": "Bij het doen van onderzoek kun je soms op <w>verzet stuiten</w> van de lokale bevolking.",
                            "target_lang_translations": {
                                "en": "When conducting research, you can sometimes <w>encounter</w> resistance from the local population."
                            }
                        }
                    ],
                    "synonyms": [
                        "tegenkomen",
                        "ontdekken",
                        "vinden",
                        "stoten op"
                    ],
                    "common_phrases": [
                        "op verzet stuiten",
                        "op problemen stuiten",
                        "op een hindernis stuiten"
                    ],
                    "target_lang_definitions": {
