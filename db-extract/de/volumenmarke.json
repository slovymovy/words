                "senses": [
                    {
                        "sense_id": "86f4a4e1-71af-31d1-bc56-a356d727d3bc",
                        "entry_id": "596fe00a-c4f5-30b3-b2e9-6fd3fec145b6",
                        "glosses": [
                            "Produktlinie mit hoher Verkaufszahl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b451d82a-432c-4eb6-9501-98861aa42e62",
                                "sense_id": "86f4a4e1-71af-31d1-bc56-a356d727d3bc",
                                "text": "„Mit […] werden die Sponsoringstrategien der Volumenmarken bzw. Randmarken zunächst miteinander verglichen und dann in einem weiteren Schritt bewertet.“"
                            },
                            {
                                "example_id": "e3ecc73b-b55b-46e7-abca-71eae480dc87",
                                "sense_id": "86f4a4e1-71af-31d1-bc56-a356d727d3bc",
                                "text": "„Gerade die Volumenmarken haben meist große Probleme, ihren Kunden eine relativ teure Spartechnik (außer Diesel) zu verkaufen.“"
                            },
                            {
                                "example_id": "b4699026-ddd4-4d82-8b8d-eebe23f935dd",
                                "sense_id": "86f4a4e1-71af-31d1-bc56-a356d727d3bc",
                                "text": "„So wird der Berufseinsteiger, der das Autohaus über die Volumenmarke kennengelernt hat, sich bei einem Karrieresprung dann auch bei der Premiummarke gut aufgehoben fühlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
