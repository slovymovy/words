                        ],
                        "form": "die Polarisierung"
                    },
                    {
                        "form_id": "cf50c702-9aa8-4304-9c98-56f05f42bc06",
                        "entry_id": "4a0080f9-cfba-3038-ba75-bf923c7330e7",
                        "tags": [
                            "accusative",
