                                        "entry_id": "c9772b37-6c79-3aeb-914e-9a4ca4e81aea",
                                        "glosses": [
                                            "je nach Region unterschiedlich zubereitete Wurst; in siedendem Wasser gekochte Wurst (Brühwurst) oder Rohwurst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "375cd957-bf66-4c20-b6b7-f55271b34fe8",
                                                "sense_id": "a7cb5718-7817-3f1f-8d9c-d01ad3620563",
                                                "text": "Ich habe mir an der Bude eine Knackwurst bestellt."
                                            },
                                            {
                                                "example_id": "9546e10a-5fa0-4624-877e-dc9ca2da26e2",
                                                "sense_id": "a7cb5718-7817-3f1f-8d9c-d01ad3620563",
                                                "text": "„Ihr eigenes Mahl, ein Stück Brot, eine Knackwurst und eine Tafel Milchschokolade, trug sie bei sich.“"
                                            },
                                            {
                                                "example_id": "4ade2227-bbe6-41ef-9c7a-3e74969aa20c",
                                                "sense_id": "a7cb5718-7817-3f1f-8d9c-d01ad3620563",
                                                "text": "„Auf dem Wege dahin steckte ihm noch die Köchin eine Knackwurst in die Tasche, die in ein zärtliches Briefchen eingewickelt war […].“"
                                            },
                                            {
                                                "example_id": "aa84428c-511e-470d-8fd8-8be105d8bf35",
                                                "sense_id": "a7cb5718-7817-3f1f-8d9c-d01ad3620563",
                                                "text": "„Specki kramt eine Knackwurst aus seinem Rucksack und zerschneidet sie rasch in sehr kleine Stücke.“"
                                            },
                                            {
                                                "example_id": "b3358d29-e2a5-435a-b709-d52307456038",
                                                "sense_id": "a7cb5718-7817-3f1f-8d9c-d01ad3620563",
                                                "text": "„In billigen Buden trank sie zufrieden Limonade und aß Knackwürste.“"
                                            }
                                        ],
