                                    },
                                    {
                                        "sense_id": "73e4b585-13e3-3d69-9206-871573257ed6",
                                        "entry_id": "8e29ac9c-499a-3042-b7a4-14b5a16c7806",
                                        "glosses": [
                                            "durch sich selbst, die eigene Person, in diese Position der Macht gebracht"
                                        ],
                                        "tags": [],
                                        "examples": [
