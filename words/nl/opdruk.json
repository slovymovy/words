    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ac8f78a2-635f-323a-b8d1-f1ae2129087c",
                    "sense_definition": "Een fitnessoefening waarbij men het lichaam herhaaldelijk met de armen vanaf de grond omhoogduwt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sport_en_beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij doet elke ochtend minstens twintig keer een <w>opdruk</w> om fit te blijven.",
                            "target_lang_translations": {
                                "en": "He does at least twenty <w>push-ups</w> every morning to stay fit."
                            }
                        },
                        {
                            "text": "Tijdens de training moesten we na elke sprint een <w>opdruk</w> maken.",
                            "target_lang_translations": {
                                "en": "During training, we had to do a <w>push-up</w> after every sprint."
                            }
                        }
                    ],
                    "synonyms": [
                        "push-up"
                    ],
                    "common_phrases": [
                        "een opdruk maken"
                    ],
                    "target_lang_definitions": {
                        "en": "A fitness exercise in which one repeatedly pushes the body up from the ground using the arms."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "push-up",
                                "target_lang_sense_clarification": "exercise"
                            },
                            {
                                "target_lang_word": "press-up",
                                "target_lang_sense_clarification": "exercise, British English"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46bee38c-685a-3148-a09f-06087534ca32",
                    "sense_definition": "Een tekst, afbeelding of logo die door middel van druktechniek op een verpakking, kledingstuk of ander object is aangebracht.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drukwerk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het T-shirt heeft een kleurrijke <w>opdruk</w> op de voorkant.",
                            "target_lang_translations": {
                                "en": "The T-shirt has a colorful <w>print</w> on the front."
                            }
                        },
                        {
                            "text": "De fabrikant heeft de ingrediënten met een duidelijke <w>opdruk</w> op de doos gezet.",
                            "target_lang_translations": {
                                "en": "The manufacturer put the ingredients on the box with clear <w>lettering</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "print",
                        "bedrukking"
                    ],
                    "common_phrases": [
                        "kleurrijke opdruk",
                        "opdruk op de verpakking"
                    ],
                    "target_lang_definitions": {
                        "en": "A text, image, or logo applied to packaging, clothing, or another object using printing technology."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "print",
                                "target_lang_sense_clarification": "on clothing or packaging"
                            },
                            {
                                "target_lang_word": "imprint",
                                "target_lang_sense_clarification": "printed mark or logo"
                            },
                            {
                                "target_lang_word": "lettering",
                                "target_lang_sense_clarification": "printed text on an object"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ecb0018-c412-3c48-9499-6606a3ddc163",
                    "sense_definition": "Het verhogen van de toon van een snaarinstrument, met name een elektrische gitaar, door een snaar tijdens het spelen omhoog of omlaag te duwen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "muziektechniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gitarist maakte een indrukwekkende <w>opdruk</w> tijdens zijn solo.",
                            "target_lang_translations": {
                                "en": "The guitarist made an impressive <w>bend</w> during his solo."
                            }
                        },
                        {
                            "text": "Door een subtiele <w>opdruk</w> klinkt de noot net iets scherper en emotioneler.",
                            "target_lang_translations": {
                                "en": "Due to a subtle <w>bend</w>, the note sounds just a bit sharper and more emotional."
                            }
                        }
                    ],
                    "synonyms": [
                        "bend"
                    ],
                    "common_phrases": [
                        "een opdruk maken"
                    ],
                    "target_lang_definitions": {
                        "en": "Raising the pitch of a stringed instrument, especially an electric guitar, by pushing a string up or down while playing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bend",
                                "target_lang_sense_clarification": "guitar technique"
                            },
                            {
                                "target_lang_word": "string bend",
                                "target_lang_sense_clarification": "guitar technique"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8f98509-5f29-37c7-896b-655149a2883c",
                    "sense_definition": "Een zware trein die op een helling of lastig traject door een extra locomotief aan de achterzijde geduwd wordt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spoorwegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de bergen is vaak een extra locomotief nodig om de <w>opdruk</w> te realiseren.",
                            "target_lang_translations": {
                                "en": "In the mountains, an extra locomotive is often needed to provide the <w>push</w>."
                            }
                        },
                        {
                            "text": "De zware goederentrein kreeg een <w>opdruk</w> om de steile helling op te komen.",
                            "target_lang_translations": {
                                "en": "The heavy freight train received <w>rear-end assistance</w> to get up the steep slope."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A heavy train being pushed from behind by an extra locomotive on a slope or difficult stretch of track."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "banking",
                                "target_lang_sense_clarification": "railway assistance from behind"
                            },
                            {
                                "target_lang_word": "rear-end assistance",
                                "target_lang_sense_clarification": "railway push"
                            }
                        ]
                    }
                }
            ]
        },
        {
