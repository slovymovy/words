                        "entry_id": "3a6a65d3-8607-34eb-9f66-dc6ebe1f2a62",
                        "glosses": [
                            "A pleasure trip or excursion."
                        ],
                        "tags": [
                            "UK",
                            "dated",
                            "humorous",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "6c6a0ec3-6ee8-4a20-8bcf-8eda1fbaa756",
                                "sense_id": "768ad8b2-13fb-3ec1-87fc-413c6b759905",
                                "text": "If you know what it means to be a “fidlet” going for a “jolly” in your “doo”, then you are part of an exclusive club that speaks colloquial Antarctic English."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5c019aa-e36f-3114-91da-83c369adb398",
                        "entry_id": "3a6a65d3-8607-34eb-9f66-dc6ebe1f2a62",
                        "glosses": [
                            "A marine in the English navy."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "cdfb7b17-9ce0-471a-af77-d558b18d3a6c",
                                "sense_id": "c5c019aa-e36f-3114-91da-83c369adb398",
                                "text": "I'm a Jolly — 'Er Majesty's Jolly — soldier an' sailor too!"
                            }
                        ]
                    },
                    {
                        "sense_id": "b9bcb6d8-5ebd-3774-85ee-14471f41d384",
                        "entry_id": "3a6a65d3-8607-34eb-9f66-dc6ebe1f2a62",
                        "glosses": [
                            "A word of praise, or favorable notice."
                        ],
                        "tags": [
                            "archaic",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "836d376b-f5d0-4617-9c3d-32179c1e7f16",
                                "sense_id": "b9bcb6d8-5ebd-3774-85ee-14471f41d384",
                                "text": "'We just need to chuck him a jolly.'\n'I beg your pardon?' said Faber.\n'Chuck a jolly... you know! Get people on the street talking about how amazing the show is! Tell them the tickets are sold out for the next two weeks.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "23db0749-397f-309f-a1b2-329f567624f6",
                        "entry_id": "3a6a65d3-8607-34eb-9f66-dc6ebe1f2a62",
                        "glosses": [
                            "Ellipsis of jolly boat."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "8e18b058-0984-404a-b0c1-a9442fc3af05",
                                "sense_id": "23db0749-397f-309f-a1b2-329f567624f6",
                                "text": "Indeed it is nearly impossible to conceive how the small jolly they were in could have escaped destruction for a single instant."
                            }
                        ]
                    }
