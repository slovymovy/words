                        ],
                        "examples": [
                            {
                                "example_id": "3c4680bf-6400-473c-95d6-da732d70411c",
                                "sense_id": "3586ae86-bff6-3260-9f75-86a849c35dca",
                                "text": "‘Pooh! pooh!’ re-echoed his mother, ‘don't pooh me, John.’"
                            }
                        ]
                    },
