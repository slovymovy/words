    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "82ffa01c-99f4-3300-8011-bd540f18c19e",
                    "sense_definition": "A method of adjusting or operating through repeated trials or experiments.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "experimental method",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer used a process of <w>tentation</w> to find the perfect balance for the bridge's suspension.",
                            "target_lang_translations": {
                                "ru": "Инженер использовал метод <w>проб и ошибок</w>, чтобы найти идеальный баланс для подвески моста."
                            }
                        },
                        {
                            "text": "Through careful <w>tentation</w> and repeated trials, the scientist finally achieved the desired chemical reaction.",
                            "target_lang_translations": {
                                "ru": "Благодаря тщательному <w>экспериментированию</w> и повторным испытаниям ученый наконец добился желаемой химической реакции."
                            }
                        }
                    ],
                    "synonyms": [
                        "trial",
                        "experimentation"
                    ],
                    "common_phrases": [
                        "process of tentation",
                        "repeated tentation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Метод настройки или управления путем повторных испытаний или экспериментов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метод проб и ошибок",
                                "target_lang_sense_clarification": "способ достижения результата через эксперименты"
                            },
                            {
                                "target_lang_word": "испытание",
                                "target_lang_sense_clarification": "процесс проверки или тестирования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f3407f9-f654-377e-abde-836cd80825fe",
                    "sense_definition": "An archaic form of <w>temptation</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "temptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient manuscript described the <w>tentation</w> of the hero by the sirens of the sea.",
                            "target_lang_translations": {
                                "ru": "В древней рукописи описывалось <w>искушение</w> героя морскими сиренами."
                            }
                        },
                        {
                            "text": "Whether there were any policie in the devil to tempt them before conjunction, or whether the issue before <w>tentation</w> might in justice have suffered with those after, we leave it unto the Lawyer.",
                            "target_lang_translations": {
                                "ru": "Была ли у дьявола какая-то тактика, чтобы искушать их до союза, или же потомство, появившееся до <w>соблазна</w>, могло по справедливости пострадать вместе с теми, кто после, — мы оставим это на усмотрение юриста."
                            }
                        }
                    ],
                    "synonyms": [
                        "temptation"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical spelling of temptation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Архаичная форма слова «искушение» (temptation)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искушение",
                                "target_lang_sense_clarification": "устаревшая форма слова"
                            },
                            {
                                "target_lang_word": "соблазн",
                                "target_lang_sense_clarification": "в контексте старинных текстов"
                            }
                        ]
                    }
                }
            ]
        }
