                        ],
                        "examples": [
                            {
                                "example_id": "b404529c-37b4-4789-8ca8-16e353bf9857",
                                "sense_id": "1bd25877-a0d6-35a6-ad34-99f68b3653f5",
                                "text": "„Mir sind Ehen genug bekannt, die sich auf einer Lustreise zur gemeinschaftlichen Lebensreise anknüpften.“"
                            },
                            {
                                "example_id": "c463af02-024d-47cd-9890-f1fc6310ecba",
                                "sense_id": "1bd25877-a0d6-35a6-ad34-99f68b3653f5",
                                "text": "„Der Bund der Steuerzahler nahm übrigens Anstoß an dem mit Kohl nach Mexiko reisenden Troß: ‚Selbst wenn man die Anwesenheit des Bundeskanzlers beim Endspiel der deutschen Nationalmannschaft noch begründen kann, ist nicht einzusehen, warum die Steuerzahler für die Lustreise der Bundestagsabgeordneten ebenfalls die Spendierhosen anziehen sollen.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
