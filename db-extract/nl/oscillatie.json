                        "glosses": [
                            "het rond een vast punt heen en weer gaan van massa of energie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39e5eb74-4d5f-4ca7-92f4-563f938711ee",
                                "sense_id": "0a75a33f-4f04-3161-9172-1bfd64123802",
                                "text": "Er is niet veel energie voor nodig om een vrij bewegende slinger in een toestand van oscillatie te houden."
                            }
