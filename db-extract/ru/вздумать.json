                "senses": [
                    {
                        "sense_id": "2574ba96-f3f5-3522-b756-022a9b9a6b62",
                        "entry_id": "6f4dc39c-6e42-363e-91d4-8a7f58137fff",
                        "glosses": [
                            "to think of (doing), to take it into one's head (to), to decide (to)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c484949f-eb74-4d90-9ce1-c38301230a3d",
                                "sense_id": "2574ba96-f3f5-3522-b756-022a9b9a6b62",
                                "text": "не вздумай(те)",
                                "translation": "don't even think (of); don't you dare",
                                "english": "don't even think (of); don't you dare"
                            },
                            {
                                "example_id": "2d7db0d3-5617-4111-a69e-434e288f5b82",
                                "sense_id": "2574ba96-f3f5-3522-b756-022a9b9a6b62",
                                "text": "Что э́то вы взду́мали уходи́ть?",
                                "translation": "What makes you go?",
                                "english": "What makes you go?"
                            },
                            {
                                "example_id": "6bc9ec79-f14c-49f9-bffd-01baae0f59d9",
                                "sense_id": "2574ba96-f3f5-3522-b756-022a9b9a6b62",
                                "text": "Я взду́мал навести́ть дру́га.",
                                "translation": "I just decided to visit a friend.",
                                "english": "I just decided to visit a friend."
                            }
                        ]
                    }
