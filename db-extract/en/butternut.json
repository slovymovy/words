                ],
                "senses": [
                    {
                        "sense_id": "b6186f89-19f2-32a8-aee8-9e67e399734a",
                        "entry_id": "695fa4e1-0cc9-3399-9afa-81ba9b2d6ef9",
                        "glosses": [
                            "Southern settlers of the Ohio river basin, who used dye from the butternut tree to colour their home-made clothing"
                        ],
                        "tags": [
                            "US",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "69badb14-735e-4009-a232-efd923b5d4a9",
                                "sense_id": "b6186f89-19f2-32a8-aee8-9e67e399734a",
                                "text": "Yankees took to calling the Borderlanders “butternuts”—a reference to the color of their crude homespun clothes."
                            }
                        ]
                    },
                    {
                        "sense_id": "66e45de7-5ab6-34f2-a5aa-324a7d64139c",
                        "entry_id": "695fa4e1-0cc9-3399-9afa-81ba9b2d6ef9",
                        "glosses": [
                            "A Confederate Southerner, or somebody who supported southern rights and slavery"
                        ],
                        "tags": [
                            "US",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f3a647cb-f153-4662-871e-6602a8c50439",
                                "sense_id": "66e45de7-5ab6-34f2-a5aa-324a7d64139c",
                                "text": "The Illinois troops delivered a volley that sent the butternuts scampering back across the field."
                            }
                        ]
                    }
                ],
