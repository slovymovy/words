                        "examples": [
                            {
                                "example_id": "71cd6cae-8702-4743-8d21-ba83d485bcfd",
                                "sense_id": "118ae870-74d5-3a27-8484-bf6c29726487",
                                "text": "In der altnordischen Mythologie ist Walhalla die große Halle des Gottes Odin in Asgard.",
                                "translation": "Dans la mythologie nordique, le Valhalla est la grande salle du dieu Odin à Asgard."
                            }
                        ]
                    },
                    {
                        "sense_id": "3253be6d-90ce-33df-b7db-251dfec76656",
                        "entry_id": "acee0c66-4304-3b6a-b1d4-0bff05e0f3fb",
                        "glosses": [
                            "Panthéon consacré aux personnes qui illustrèrent la civilisation allemande, situé à Donaustauf."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81b194ed-dc05-450a-9126-8334a6a4acac",
                                "sense_id": "3253be6d-90ce-33df-b7db-251dfec76656",
                                "text": "Die Walhalla gilt als das Hauptwerk aller Kunstschöpfungen des bayerischen König Ludwig I.",
                                "translation": "Le Walhalla est considéré comme le chef-d'œuvre de toutes les créations artistiques du roi de Bavière Louis Iᵉʳ."
                            }
                        ]
                    }
