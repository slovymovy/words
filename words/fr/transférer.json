                        {
                            "text": "La banque a accepté de <w>transférer</w> les fonds sur votre compte d'épargne.",
                            "target_lang_translations": {
                                "en": "The bank agreed to <w>transfer</w> the funds to your savings account.",
                                "ru": "Банк согласился <w>перевести</w> средства на ваш сберегательный счёт.",
                                "de": "Die Bank hat sich bereit erklärt, das Geld auf Ihr Sparkonto zu <w>überweisen</w>.",
                                "es": "El banco aceptó <w>transferir</w> los fondos a su cuenta de ahorros.",
                                "zh": "银行同意把这笔资金<w>转账</w>到您的储蓄账户。"
                            }
                        },
                        {
                            "text": "L'ancien propriétaire a signé le contrat pour <w>transférer</w> ses droits au repreneur.",
                            "target_lang_translations": {
                                "en": "The former owner signed the contract to <w>transfer</w> his rights to the new owner.",
                                "ru": "Бывший владелец подписал договор, чтобы <w>передать</w> свои права новому владельцу.",
                                "de": "Der frühere Eigentümer hat den Vertrag unterschrieben, um seine Rechte an den Übernehmer zu <w>übertragen</w>.",
                                "es": "El antiguo propietario firmó el contrato para <w>ceder</w> sus derechos al nuevo propietario.",
                                "zh": "原所有人签署了合同，想把自己的权利<w>转让</w>给受让人。"
                            }
