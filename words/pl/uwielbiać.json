{
    "word_family": [
        "uwielbienie",
        "uwielbiony"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bc43730b-24a4-3a39-bd0c-fd12eb30bef0",
                    "sense_definition": "bardzo coś lub kogoś lubić, odczuwać do czegoś lub kogoś dużą sympatię",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lubienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moja siostra <w>uwielbia</w> czytać kryminały w długie jesienne wieczory.",
                            "target_lang_translations": {
                                "ru": "Моя сестра <w>обожает</w> читать детективы долгими осенними вечерами."
                            }
                        },
                        {
                            "text": "Wszyscy w naszej rodzinie <w>uwielbiają</w> spędzać czas nad morzem.",
                            "target_lang_translations": {
                                "ru": "Все в нашей семье <w>обожают</w> проводить время на море."
                            }
                        }
                    ],
                    "synonyms": [
                        "kochać",
                        "przepadać"
                    ],
                    "antonyms": [
                        "nienawidzić"
                    ],
                    "common_phrases": [
                        "uwielbiać czytać",
                        "uwielbiać podróże"
                    ],
                    "target_lang_definitions": {
                        "ru": "очень сильно любить что-либо или кого-либо, испытывать большую симпатию"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обожать",
                                "target_lang_sense_clarification": "иметь сильную склонность или пристрастие к чему-либо"
                            },
                            {
                                "target_lang_word": "очень любить",
                                "target_lang_sense_clarification": "выражение сильной симпатии к кому-то или чему-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2c0f8e7-6f01-3551-a47c-2440bc55f504",
                    "sense_definition": "darzyć kogoś wielkim uczuciem, czcić kogoś lub coś z oddaniem",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "miłość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fani <w>uwielbiają</w> swojego idola i śledzą każdy jego krok w mediach społecznościowych.",
                            "target_lang_translations": {
                                "ru": "Фанаты <w>обожают</w> своего кумира и следят за каждым его шагом в социальных сетях."
                            }
                        },
                        {
                            "text": "Rodzice <w>uwielbiają</w> swoje dzieci bezgraniczną miłością.",
                            "target_lang_translations": {
                                "ru": "Родители <w>обожают</w> своих детей безграничной любовью."
                            }
                        }
                    ],
                    "synonyms": [
                        "ubóstwiać",
                        "adorować"
                    ],
                    "common_phrases": [
                        "uwielbiać idola"
                    ],
                    "target_lang_definitions": {
                        "ru": "питать к кому-либо глубокие чувства, преклоняться перед кем-либо или чем-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обожать",
                                "target_lang_sense_clarification": "восторженно и очень сильно любить кого-либо"
                            },
                            {
                                "target_lang_word": "боготворить",
                                "target_lang_sense_clarification": "относиться к кому-либо с преклонением и обожанием"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}