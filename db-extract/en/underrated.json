                        "glosses": [
                            "Not given enough recognition for its quality."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d108998f-331b-4569-baa6-055cfd61780e",
                                "sense_id": "1ebbc747-267a-3c10-9ccb-6b7439ef9ae5",
                                "text": "Koeman identified Southampton’s third as their finest goal of the game. Jack Cork, the most underrated player at a much-lauded club, swept the ball out wide to Tadic, who waited for Cork to run to the back post before chipping the ball across to him to slam in a deserved goal from close range, despite an attempted block by Vito Mannone."
                            },
                            {
                                "example_id": "468c5313-7d72-4b31-be58-c071832b4a2a",
                                "sense_id": "1ebbc747-267a-3c10-9ccb-6b7439ef9ae5",
                                "text": "The hourly EMU service means that Largs, arguably an underrated seaside destination, is easy enough to reach from Glasgow for a day out."
                            }
                        ]
                    }
