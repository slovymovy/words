                    {
                        "sense_id": "c53ddac4-2d7d-36e4-8f78-325541406b12",
                        "entry_id": "065c85d6-9bee-338a-9c5f-3694f7423261",
                        "glosses": [
                            "Diagramm, bei dem Schwingungen wiedergegeben werden, bei dem der Schalldruck auf der y-Achse und die Zeit auf der x-Achse dargestellt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "203b27a7-fcd0-4bc0-a9d4-cec192a0d3f6",
                                "sense_id": "c53ddac4-2d7d-36e4-8f78-325541406b12",
                                "text": "Wir machten erst einen Test, bevor wir die wirklich interessanten Oszillogramme aufnahmen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3c4cd14-1a1b-45dd-9d82-da87b590dbd4",
                        "source_entry_id": "065c85d6-9bee-338a-9c5f-3694f7423261",
                        "source_sense_id": "c53ddac4-2d7d-36e4-8f78-325541406b12",
                        "target_lang_word": "oscillogram",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oscillogram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fc4a1b9-a47d-36cc-b23b-5dca35db4d5e",
                                        "entry_id": "2e2ef34d-2768-3a48-8c29-aad61a6a653e",
                                        "glosses": [
                                            "A record produced by an oscillograph or oscilloscope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68874416-6f99-4112-a28b-9578a7fe86c7",
                                                "sense_id": "7fc4a1b9-a47d-36cc-b23b-5dca35db4d5e",
                                                "text": "The R.M.S. value of the pressure was taken from the oscillogram by taking the square root of the average value of the squares of a number of equi-distant ordinates; the R.M.S. value of the current was obtained in the same way from the current oscillogram, and the two values multiplied together always gave a value agreeing to within 1 per cent. of that obtained by first multiplying the ordinates taken from the current and voltage oscillograms and then taking the mean."
                                            },
                                            {
                                                "example_id": "c1621a84-e9b0-4ccc-b69d-0d15367342ff",
                                                "sense_id": "7fc4a1b9-a47d-36cc-b23b-5dca35db4d5e",
                                                "text": "The process was controlled through oscillograms that showed the moments of breakage of the graphite rods."
                                            },
                                            {
                                                "example_id": "d34fa413-78bc-4589-8240-df862c5c0dd5",
                                                "sense_id": "7fc4a1b9-a47d-36cc-b23b-5dca35db4d5e",
                                                "text": "From these oscillograms, it is visible that the resonator oscillations are noticeably inharmonic and asymmetric ones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
