                "senses": [
                    {
                        "sense_id": "fa0eb001-0620-3ad1-8081-eba4fbde324c",
                        "entry_id": "a62bec87-f598-39ab-9ff3-25095d294e2b",
                        "glosses": [
                            "US standard spelling of distil."
                        ],
                        "tags": [
                            "US",
                            "alt-of",
                            "standard"
                        ],
                        "examples": [
                            {
                                "example_id": "a3999cb2-1e65-41c6-8463-7ddccfbb518b",
                                "sense_id": "fa0eb001-0620-3ad1-8081-eba4fbde324c",
                                "text": "There is ſome ſoule of goodneſſe in things euill, / VVould men obſeruingly diſtill it out."
                            },
                            {
                                "example_id": "8b2ae11d-a31d-4c42-a660-b7d134a62884",
                                "sense_id": "fa0eb001-0620-3ad1-8081-eba4fbde324c",
                                "text": "My doctrine ſhall drop as the raine: my ſpeach ſhall diſtill as the deaw, as the ſmal raine vpon the tender herbe, and as the ſhowres vpon the graſſe."
                            },
                            {
                                "example_id": "f11d0c11-3fc3-4747-a4e3-072c16776421",
                                "sense_id": "fa0eb001-0620-3ad1-8081-eba4fbde324c",
                                "text": "So vvhen tvvo Boars, in vvild Ytene bred, / Or on VVeſtphalia’s fatt’ning Cheſt-nuts fed, / […] / In the black Flood they vvallovv o’er and o’er, / ’Till their arm’d Javvs diſtill vvith Foam and Gore."
                            },
                            {
                                "example_id": "f8b6bbd9-6176-4624-b1e9-402f281e8e40",
                                "sense_id": "fa0eb001-0620-3ad1-8081-eba4fbde324c",
                                "text": "The wine which from yon wounded palm on high / Fills yonder gourd, as slowly it distills, / Grows sour at once if Lorrinite pass by."
                            },
                            {
                                "example_id": "5be6897e-1359-4cc6-b8df-bdd2cc569298",
                                "sense_id": "fa0eb001-0620-3ad1-8081-eba4fbde324c",
                                "text": "Carbonic acid is a limpid colourless body, extremely fluid, and floating upon the other contents of the tube. It distills readily and rapidly at the difference of temperature between 32° and 0°."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
