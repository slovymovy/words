{
    "word_family": [
        "perseverance",
        "perseverant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3062812e-a32d-3f06-8ef8-8082850148f6",
                    "sense_definition": "To continue working toward a goal despite facing difficulties or obstacles.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "persistence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even when the project became difficult, she decided to <w>persevere</w> until it was finished.",
                            "target_lang_translations": {
                                "tr": "Proje zorlaştığında bile, bitene kadar <w>sebat etmeye</w> karar verdi."
                            }
                        },
                        {
                            "text": "You must <w>persevere</w> in your studies if you want to achieve your academic goals.",
                            "target_lang_translations": {
                                "tr": "Akademik hedeflerine ulaşmak istiyorsan çalışmalarında <w>azimle devam etmelisin</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "persist",
                        "endure",
                        "continue"
                    ],
                    "antonyms": [
                        "cease",
                        "desist",
                        "give up",
                        "quit",
                        "stop",
                        "surrender",
                        "yield"
                    ],
                    "common_phrases": [
                        "persevere in",
                        "persevere with"
                    ],
                    "target_lang_definitions": {
                        "tr": "Zorluklara veya engellere rağmen bir hedefe doğru çalışmaya devam etmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sebat etmek",
                                "target_lang_sense_clarification": "Bir amaç uğrunda kararlılıkla çalışmaya devam etmek."
                            },
                            {
                                "target_lang_word": "direnmek",
                                "target_lang_sense_clarification": "Zorluklar karşısında pes etmeyip mücadeleyi sürdürmek."
                            },
                            {
                                "target_lang_word": "azimle devam etmek",
                                "target_lang_sense_clarification": "Kararlılık göstererek bir işi sonuna kadar götürmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a4ad8f3-d240-3106-94f9-8ad7b3894081",
                    "sense_definition": "To remain in a specific state or condition.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "persistence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old traditions <w>persevere</w> in this remote mountain village despite modern changes.",
                            "target_lang_translations": {
                                "tr": "Modern değişimlere rağmen, eski gelenekler bu uzak dağ köyünde <w>varlığını sürdürüyor</w>."
                            }
                        },
                        {
                            "text": "The cold weather <w>persevered</w> throughout the entire month of January.",
                            "target_lang_translations": {
                                "tr": "Soğuk hava, Ocak ayı boyunca <w>devam etti</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "remain",
                        "stay",
                        "continue"
                    ],
                    "target_lang_definitions": {
                        "tr": "Belirli bir durumda veya koşulda varlığını sürdürmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "varlığını sürdürmek",
                                "target_lang_sense_clarification": "Bir durumun veya geleneğin değişmeden devam etmesi."
                            },
                            {
                                "target_lang_word": "devam etmek",
                                "target_lang_sense_clarification": "Bir durumun kesintiye uğramadan sürmesi."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}