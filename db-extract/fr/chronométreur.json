                "senses": [
                    {
                        "sense_id": "d5b6545a-0dde-322f-9380-3dc3d4cbc3a7",
                        "entry_id": "4bdc1f3d-e271-3c70-af4e-c5d5132930a2",
                        "glosses": [
                            "Personne dont le travail est de mesurer le temps, notamment lors d’une épreuve sportive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad9c0f7a-e57e-4de1-9783-95e471541916",
                                "sense_id": "d5b6545a-0dde-322f-9380-3dc3d4cbc3a7",
                                "text": "Cette certitude illumina l’instant où le chronométreur traça à la craie le nom d’Adele Wolfe sur la première ligne du tableau."
                            },
                            {
                                "example_id": "c6bfcd10-64bb-46c7-9e7a-dd0c50591561",
                                "sense_id": "d5b6545a-0dde-322f-9380-3dc3d4cbc3a7",
                                "text": "Ces variations vont surtout affecter les chronométreurs internationaux, qui utilisent des horloges atomiques ultra-précises pour mesurer le temps universel coordonné (UTC) avec lequel chacun règle ses horloges."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f808e85-9f39-4ea4-8b0c-7a534927e9d5",
                        "source_entry_id": "4bdc1f3d-e271-3c70-af4e-c5d5132930a2",
                        "source_sense_id": "d5b6545a-0dde-322f-9380-3dc3d4cbc3a7",
                        "target_lang_word": "timekeeper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "timekeeper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd54d2da-bafe-3882-b5e5-03a8fc197aec",
                                        "entry_id": "88907592-8bdc-32b8-a71f-fc9061d31443",
                                        "glosses": [
                                            "A device that shows the time; a timepiece."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e14edf0-e27e-48eb-b0cb-ab91cfe984f9",
                                                "sense_id": "dd54d2da-bafe-3882-b5e5-03a8fc197aec",
                                                "text": "The sailors sail by chronometers that do not lose two or three seconds in a year, ever since [Isaac] Newton explained to Parliament that the way to improve navigation was to get good watches, and to offer public premiums for a better time-keeper than any then in use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f037cd64-3c6e-30af-9512-183726a90a02",
                                        "entry_id": "88907592-8bdc-32b8-a71f-fc9061d31443",
                                        "glosses": [
                                            "A person who keeps records of the hours of attendance of employees."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6a694cde-5c3a-330a-a230-fd8fe7597f9b",
                                        "entry_id": "88907592-8bdc-32b8-a71f-fc9061d31443",
                                        "glosses": [
                                            "A person who records the time elapsed in a sporting event."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba87454c-8e65-320a-b0bf-52e2a88994ca",
                                        "entry_id": "88907592-8bdc-32b8-a71f-fc9061d31443",
                                        "glosses": [
                                            "The group member who controls the rhythm of the music when a group of musicians play together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5077325f-515d-44bb-961b-5fc395872329",
                                                "sense_id": "ba87454c-8e65-320a-b0bf-52e2a88994ca",
                                                "text": "There was no consensus among jazz musicians about who was the primary timekeeper in a jazz band; some said the drummers and others said the bassist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "728e39da-8b77-38cc-ab35-581af3f8aac2",
                                        "entry_id": "88907592-8bdc-32b8-a71f-fc9061d31443",
                                        "glosses": [
                                            "A person (or something controlled by a person) that is punctual."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fde370f-8a13-42e4-b09c-4635aec80001",
                                                "sense_id": "728e39da-8b77-38cc-ab35-581af3f8aac2",
                                                "text": "As it happens, the Leicester–Beeston train is quite a good timekeeper—it sometimes runs a few minutes early— […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
