                "senses": [
                    {
                        "sense_id": "57ea3dfe-1661-398e-a2eb-f090bc58954a",
                        "entry_id": "0a22070e-5122-3044-b680-6ab29ea8d114",
                        "glosses": [
                            "остров в Северной Америке, при устье реки Гудзона, на котором находится город Нью-Йорк"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41d86460-3439-4d5e-917e-4e94311e39c1",
                                "sense_id": "57ea3dfe-1661-398e-a2eb-f090bc58954a",
                                "text": "Улицы делятся на два вида: продольные ― авеню и поперечные ― стриты. Так распланирован остров Манхэттен."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80c33596-4301-4d5a-a620-1bb55b84b147",
                        "source_entry_id": "0a22070e-5122-3044-b680-6ab29ea8d114",
                        "source_sense_id": "57ea3dfe-1661-398e-a2eb-f090bc58954a",
                        "target_lang_word": "Manhattan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Manhattan",
