                        "word": "bedaren"
                    },
                    {
                        "linkage_id": "a592aeb5-5109-4953-aade-ba45747ded9e",
                        "source_entry_id": "de38bd0e-4934-3322-8ac2-faf8979947db",
                        "source_sense_ids": [
                            "cb908b01-3fc4-3fcb-8c8e-ac7227f46d1c"
