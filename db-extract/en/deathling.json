    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fc95566c-a963-30f3-9fc5-c15e220bae0a",
                "word": "deathling",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "27f48f03-fd5e-4d7c-b220-89e8e93fc56c",
                        "entry_id": "fc95566c-a963-30f3-9fc5-c15e220bae0a",
                        "tags": [
                            "plural"
                        ],
                        "form": "deathlings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "369e5de2-7d1c-371b-83d7-444850777fb5",
                        "entry_id": "fc95566c-a963-30f3-9fc5-c15e220bae0a",
                        "glosses": [
                            "A mortal; one who will die."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8472799a-a436-4411-95c1-9457d0bbc9fb",
                                "sense_id": "369e5de2-7d1c-371b-83d7-444850777fb5",
                                "text": "God gives and takes away your breath: What more have ye? Breath is your life, and life your soul; Ye have it warm from His kind hands: Then yield it back to the great Whole When He demands. Why, deathling, wilt thou long for Heaven?"
                            },
                            {
                                "example_id": "e611c75a-a4e5-4044-81ca-13172ed9114e",
                                "sense_id": "369e5de2-7d1c-371b-83d7-444850777fb5",
                                "text": "But for us, let us hearken the counsel of Zeus most high, and obey, Who over the deathling race and the deathless beareth sway."
                            },
                            {
                                "example_id": "57541b8c-81d9-4f1b-8957-83330062c934",
                                "sense_id": "369e5de2-7d1c-371b-83d7-444850777fb5",
                                "text": "Vain, helpless deathling! thou that seek'st for fame By hurling filth at an eternal name."
                            },
                            {
                                "example_id": "d671b2e5-40d6-4b73-b6b2-08ebaeb495ca",
                                "sense_id": "369e5de2-7d1c-371b-83d7-444850777fb5",
                                "text": "Unto whom the Seducer, not our romantic Satan but a clever cartesian Archon, coaxingly thus: Not doing very well, are you, poor deathling, no, and unlikely to do any better, thanks to the schemes of We-Know-Whom,"
                            },
                            {
                                "example_id": "6d5602fe-80b6-44d2-9802-e27c7aad00a9",
                                "sense_id": "369e5de2-7d1c-371b-83d7-444850777fb5",
                                "text": "I am a deathling doomed to hell."
                            }
                        ]
                    },
                    {
                        "sense_id": "e01ac7ff-6c61-392d-8843-898800b55dbf",
                        "entry_id": "fc95566c-a963-30f3-9fc5-c15e220bae0a",
                        "glosses": [
                            "A supernatural being associated with death, especially a child of death."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8347bf7d-cffd-4d39-b354-e59d4b3a95ce",
                                "sense_id": "e01ac7ff-6c61-392d-8843-898800b55dbf",
                                "text": "The interest of his realm had need That death should get a numerous breed; Young deathlings, who by practice made Proficient in their father's trade"
                            },
                            {
                                "example_id": "de749e18-7f4e-429a-a018-495b3635e953",
                                "sense_id": "e01ac7ff-6c61-392d-8843-898800b55dbf",
                                "text": "Meanwhile most of the deathling troop had rustled past them and fallen on the Taians."
                            },
                            {
                                "example_id": "2d83d744-d998-45cc-b75d-beab3aaff5af",
                                "sense_id": "e01ac7ff-6c61-392d-8843-898800b55dbf",
                                "text": "Deathlings or even wraiths weren't the deadliest weapons."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d90dfe1-fafa-3492-b27e-0a4065bcdc75",
                        "entry_id": "fc95566c-a963-30f3-9fc5-c15e220bae0a",
                        "glosses": [
                            "A dead child."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f4b97e0f-fee2-49b9-ac8b-f76333675d79",
                                "sense_id": "4d90dfe1-fafa-3492-b27e-0a4065bcdc75",
                                "text": "In my mind's eye I gather the resident who did the tracheotomy, his patient with her collapsible veins, the nurse who said \" Good,\" and, of course, the deathling in the bed."
                            },
                            {
                                "example_id": "c7f076c3-c4e4-42aa-8cf3-884432d7439f",
                                "sense_id": "4d90dfe1-fafa-3492-b27e-0a4065bcdc75",
                                "text": "The old mother grieves her deathling."
                            },
                            {
                                "example_id": "ad41c867-7f08-48be-933b-b096949479a2",
                                "sense_id": "4d90dfe1-fafa-3492-b27e-0a4065bcdc75",
                                "text": "you are all I had in this world beloved deathling alone and cold it is behind my ribs"
                            }
                        ]
                    }
                ],
