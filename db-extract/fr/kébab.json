                        "form": "kébabs"
                    },
                    {
                        "form_id": "eb11c78d-ef7d-4f59-af30-cb70f594066f",
                        "entry_id": "a182dcf9-2378-3476-a80d-9ea8bfdd4c78",
                        "tags": [
                            "orthographe traditionnelle"
                        ],
                        "form": "kebab"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe8ca194-5198-3413-8944-4661e6d44cea",
                        "entry_id": "a182dcf9-2378-3476-a80d-9ea8bfdd4c78",
                        "glosses": [
                            "Divers types de viande rôtie et épicée à l’orientale : döner kébab, chichekébab, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aced970a-3422-443b-b457-a01c68891ce4",
                                "sense_id": "fe8ca194-5198-3413-8944-4661e6d44cea",
                                "text": "Le kébab doit être servi brûlant. Quand la bouche peut le tolérer, il est déjà trop froid."
                            },
                            {
                                "example_id": "f122f43d-d37b-4248-9bc0-fafe1aa11d68",
                                "sense_id": "fe8ca194-5198-3413-8944-4661e6d44cea",
                                "text": "Je me résignai donc à imiter les autres visiteurs en engageant, pour quelques menues pièces, un jeune adolescent qui s’occuperait de m’éventer et d’écarter les insectes. Le plus difficile fut de le convaincre de les éloigner de ma table sans chercher à les écraser sous mes yeux entre dolmas et kébabs."
                            }
                        ]
                    },
                    {
                        "sense_id": "e474b82a-9a74-3cfc-b790-1c8ab8118412",
                        "entry_id": "a182dcf9-2378-3476-a80d-9ea8bfdd4c78",
                        "glosses": [
                            "Sandwich ou roulade à base de viande de kébab cuite sur broche verticale agrémentée de légumes et de sauce."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "865e2ff9-51b9-4495-a0c1-90b6cf4c829e",
                                "sense_id": "e474b82a-9a74-3cfc-b790-1c8ab8118412",
                                "text": "Un mec qui ne s’encombrera pas des convenances et de la séduction à deux balles, qui rentrera, posera le kébab et sans dire un mot, m’embrassera fougueusement en me disant de ne pas m’inquiéter pour toutes les histoires de couple pourries […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "15840d79-2a15-35d7-a7d5-6687df771175",
                        "entry_id": "a182dcf9-2378-3476-a80d-9ea8bfdd4c78",
                        "glosses": [
                            "Établissement servant de tels sandwichs."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "233a0ef6-8c05-4ede-b31a-3f92fe69b80f",
                                "sense_id": "15840d79-2a15-35d7-a7d5-6687df771175",
                                "text": "On les retrouve au kébab du coin, au bout de l’avenue Jean-Jaurès où une pancarte annonce : « Dernier kébab avant le périph », au Café de la musique du parc de la Villette, au café MK2 du quai de Seine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5dfab21d-cd91-4ee5-82be-8be96dcc6e54",
                        "source_entry_id": "a182dcf9-2378-3476-a80d-9ea8bfdd4c78",
                        "target_lang_word": "Döner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Döner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e4cf1c5-4c06-3644-9e16-047ee564f1d8",
                                        "entry_id": "839c39dc-f04e-3638-a840-021971767256",
                                        "glosses": [
                                            "türkisches Gericht, ursprünglich aus Hammel- oder Lammfleisch, in Deutschland oft auch Rind- oder Geflügelfleisch, das in kleine dünne Scheiben geschnitten, an einem senkrechten Drehspieß überlappend aufgespießt, mittels seitlichen Grills gegart, nach und nach in kleinen garen Stücken abgeschnitten und mit unterschiedlichen Beilagen auf dem Teller serviert wird"
                                        ],
                                        "tags": [
                                            "Kurzform"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf2d6448-ff5d-444b-9460-563395a6ae02",
                                                "sense_id": "6e4cf1c5-4c06-3644-9e16-047ee564f1d8",
                                                "text": "Einen Döner, bitte."
                                            },
                                            {
                                                "example_id": "bbd896c6-29ba-4122-8beb-54c42296ac08",
                                                "sense_id": "6e4cf1c5-4c06-3644-9e16-047ee564f1d8",
                                                "text": "„Manchmal plaudere ich mit den Verkäufern, wenn ich mir in Kreuzberg einen Döner kaufe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "690b97bd-07f5-3030-8651-35518f7332e8",
                                        "entry_id": "839c39dc-f04e-3638-a840-021971767256",
                                        "glosses": [
                                            "zu „Döner Kebab im Brot“ (türkisch: „pide arası döner“), einem unter Verwendung von [1] zubereitetem Fast-Food-Gericht, bei dem das Fleisch zusammen mit Gemüse und Soße in einem aufgeschnittenen Fladenbrot („pide“) dargereicht wird"
                                        ],
                                        "tags": [
                                            "Kurzform"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b647e0f0-a7fc-4f73-9096-3e4f627472d8",
                                                "sense_id": "690b97bd-07f5-3030-8651-35518f7332e8",
                                                "text": "Einen Döner, bitte."
                                            },
                                            {
                                                "example_id": "45bf926d-e725-4f7f-b8c1-089485c0472a",
                                                "sense_id": "690b97bd-07f5-3030-8651-35518f7332e8",
                                                "text": "„Manchmal plaudere ich mit den Verkäufern, wenn ich mir in Kreuzberg einen Döner kaufe.“"
                                            },
                                            {
                                                "example_id": "f2108fc7-5936-43f9-91c0-9cb0682b8605",
                                                "sense_id": "690b97bd-07f5-3030-8651-35518f7332e8",
                                                "text": "„Der Hotdog ist in Island das, was in Berlin der Döner ist.“"
                                            },
                                            {
                                                "example_id": "b7f9c3dd-af68-4139-9440-2716248f140a",
                                                "sense_id": "690b97bd-07f5-3030-8651-35518f7332e8",
                                                "text": "„Früher war zwar nicht alles besser, aber zumindest Döner mit scharf deutlich billiger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
