                    "sense_definition": "An onomatopoeic word used to represent the sound of laughter.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "laughter_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Haha</w>, that was the funniest joke I have ever heard.",
                            "target_lang_translations": {
                                "ru": "<w>Ха-ха</w>, это была самая смешная шутка, которую я когда-либо слышал.",
                                "zh": "<w>哈哈</w>，这是我听过最好笑的笑话。"
                            }
                        },
                        {
                            "text": "I looked at the picture and thought, <w>haha</w>, he looks silly.",
                            "target_lang_translations": {
                                "ru": "Я посмотрел на фотографию и подумал: «<w>ха-ха</w>, он выглядит глупо».",
                                "zh": "我看着照片心想，<w>哈哈</w>，他看起来真傻。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lol",
                        "hehe",
                        "hahaha"
                    ],
                    "common_phrases": [
                        "haha very funny"
                    ],
                    "target_lang_definitions": {
