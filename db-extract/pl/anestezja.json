                        "cross_references": [
                            {
                                "target_word": "anesthesia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cca4c16-7edf-3e25-b5fd-a73991b86cf1",
                                        "entry_id": "a705c3ef-848d-30c7-8648-0fb50ef504d6",
                                        "glosses": [
                                            "An artificial method of preventing sensation, used to eliminate pain without causing loss of vital functions, by the administration of one or more agents which block pain impulses before transmitted to the brain."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cdfa0b0-485a-4ac4-8109-485b43963b6e",
                                                "sense_id": "6cca4c16-7edf-3e25-b5fd-a73991b86cf1",
                                                "text": "In addition, 0.5 ml of 1% lidocaine HCl was injected subcutaneously in the postauricular area for local anesthesia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87f8f3e7-ab4d-30c2-b69d-db752c068a5c",
                                        "entry_id": "a705c3ef-848d-30c7-8648-0fb50ef504d6",
                                        "glosses": [
                                            "The loss or prevention of sensation, as caused by anesthesia (in the above sense), or by a lesion in the nervous system, or by another physical abnormality."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee331cba-457b-40b6-b130-9607da3719b3",
                                                "sense_id": "87f8f3e7-ab4d-30c2-b69d-db752c068a5c",
                                                "text": "In some individuals optimism may become quasi-pathological. The capacity for even a transient sadness or a momentary humility seems cut off from them as by a kind of congenital anæsthesia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b5682e9-76a3-3e73-b5be-1ac2a1f0a8a5",
                                        "entry_id": "a705c3ef-848d-30c7-8648-0fb50ef504d6",
                                        "glosses": [
                                            "A medication that provides the service of temporarily blocking sensation."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "metonymically",
                                            "often",
                                            "proscribed",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
