                "senses": [
                    {
                        "sense_id": "4dd7ed4c-fe56-3616-9a9d-03bc03d54fae",
                        "entry_id": "45755781-559f-3d57-85f0-098b37135675",
                        "glosses": [
                            "zielony o odcieniu oliwkowym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e2fd2a6-4731-460d-8f67-dd7e1db020a2",
                                "sense_id": "4dd7ed4c-fe56-3616-9a9d-03bc03d54fae",
                                "text": "Mają znacznie ciemniejszą, oliwkowozieloną barwę, zapach lekko kwaśny, żywiczny i korzenny, lekko gorzkawy smak"
                            },
                            {
                                "example_id": "14d7e9b7-081e-434b-a585-a01b123c888a",
                                "sense_id": "4dd7ed4c-fe56-3616-9a9d-03bc03d54fae",
                                "text": "Nieco ekstrawagancki, oliwkowozielony gabinet pełen regałów z książkami; sprzęt muzyczny w salonie, a obok dwa gustowne stojaki na CD"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
