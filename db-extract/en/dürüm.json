                "senses": [
                    {
                        "sense_id": "271b9494-827e-3859-a423-3380e57c43ca",
                        "entry_id": "64083c8c-604f-358b-a1bc-20610163bb7c",
                        "glosses": [
                            "A traditional Turkish wrap (which is made from lavash or yufka flatbread) that is filled with typical doner kebab ingredients."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a83a5eac-33ce-4321-982e-6806b43055e7",
                                "sense_id": "271b9494-827e-3859-a423-3380e57c43ca",
                                "text": "Lara says she’s going to get something to eat from the Turkish place on the corner; she asks if she should bring me anything. I ask for a dürüm with everything, except onions."
                            },
                            {
                                "example_id": "10889d82-ab03-4b91-9a31-deb192222e20",
                                "sense_id": "271b9494-827e-3859-a423-3380e57c43ca",
                                "text": "They grabbed the tray with a dürüm and ayran from my bedside table and put it on my lap."
                            },
                            {
                                "example_id": "b6d731ec-6c50-432a-895e-a49cd5501a9d",
                                "sense_id": "271b9494-827e-3859-a423-3380e57c43ca",
                                "text": "Just before 2 p.m., we entered Neco Tantuni, a one-room restaurant in Enfield that specializes in tantuni (meat fried in cottonseed oil, garnished with tomatoes, parsley, and onion, and rolled up in a dürüm wrap), a street food from Mersin, in southern Turkey."
                            },
                            {
                                "example_id": "6752776e-2e61-4249-b776-356e7382d281",
                                "sense_id": "271b9494-827e-3859-a423-3380e57c43ca",
                                "text": "If you can't follow a PHP guru's talk, two dürüms might help clear your head and restore your sanity."
                            }
                        ]
                    }
                ],
