                        "glosses": [
                            "Sorte de couche cireuse, légèrement poudreuse, qui recouvre la surface d'un organe végétal ou animal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7641871-de2d-4aff-8d58-0e6f5ccf95d8",
                                "sense_id": "7ac2ba67-7083-3c88-a728-e87652cc3b44",
                                "text": "Aptère: 2,1 à 2,6 mm, globuleux, vert, entièrement recouvert d’une pruinosité cendrée caractéristique. Ailé : Corps 1,6 à 2,8 mm, tête et thorax vert sombre, abdomen jaune verdâtre, recouvert de pruinosité grisâtre."
                            },
                            {
                                "example_id": "d4580266-c3bc-4be2-b278-6f4d3a8bb6fb",
                                "sense_id": "7ac2ba67-7083-3c88-a728-e87652cc3b44",
                                "text": "Les premiers ont les feuilles roulées en long, avant tout développement, le fruit est une drupe pubescente, glabre ou veloutée, avec une « pruinosité » ou efflorescence glauque, enrobant la peau ; […]."
                            }
                        ]
                    }
