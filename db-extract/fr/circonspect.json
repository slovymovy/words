                        ],
                        "form": "circonspects"
                    },
                    {
                        "form_id": "753671b8-9c01-4176-aa02-c4337042f9b2",
                        "entry_id": "c7fc8c2b-d08c-3ae1-9bc4-36d140028104",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "circonspecte"
                    },
                    {
                        "form_id": "d247fcdb-5107-4eea-8db0-53695fe8367a",
                        "entry_id": "c7fc8c2b-d08c-3ae1-9bc4-36d140028104",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "circonspectes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6d39e9f9-a858-3e61-a6e5-2a5a77cf8d93",
                        "entry_id": "c7fc8c2b-d08c-3ae1-9bc4-36d140028104",
                        "glosses": [
                            "Qui prend garde à ce qu’il dit, à ce qu’il fait, en ayant égard aux circonstances, au milieu. Qui ne s’engage qu’après examen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0b2b73e-77c7-4131-81f8-83fdd49bb818",
                                "sense_id": "6d39e9f9-a858-3e61-a6e5-2a5a77cf8d93",
                                "text": "Les vieux, à ce propos, devinrent aussitôt circonspects, et demandèrent des explications."
                            },
                            {
                                "example_id": "37ce2a25-bd7f-4d32-adf7-a62615b624f0",
                                "sense_id": "6d39e9f9-a858-3e61-a6e5-2a5a77cf8d93",
                                "text": "Elle se tut, elle aussi, par une prudence de femme adonnée aux amours coupables, car les fautes comme l’innocence concourent à nous rendre circonspects."
                            },
                            {
                                "example_id": "a9771761-cfc4-4a38-bfe8-7b9894694066",
                                "sense_id": "6d39e9f9-a858-3e61-a6e5-2a5a77cf8d93",
                                "text": "Si je partage, pour une large part, le tableau de notre situation actuelle qui est présentée dans cet essai, je demeure en revanche plus circonspect, voire franchement dubitatif, devant certaines solutions proposées aux problèmes de l'injustice."
                            }
                        ]
                    },
                    {
                        "sense_id": "77d3b181-ca04-30e7-9d5e-66ebc2014867",
                        "entry_id": "c7fc8c2b-d08c-3ae1-9bc4-36d140028104",
                        "glosses": [
                            "Qui marque de la circonspection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09683179-0b2e-410a-aa20-7324d20cebe6",
                                "sense_id": "77d3b181-ca04-30e7-9d5e-66ebc2014867",
                                "text": "Conduite, démarche circonspecte."
                            },
                            {
                                "example_id": "796f951d-190e-481a-b6b7-3d09ab4ad3ef",
                                "sense_id": "77d3b181-ca04-30e7-9d5e-66ebc2014867",
                                "text": "Langage circonspect."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5873a8f-f16e-46da-bcb2-02c8f9610e04",
                        "source_entry_id": "c7fc8c2b-d08c-3ae1-9bc4-36d140028104",
                        "target_lang_word": "umsichtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "umsichtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "69f83710-8454-3455-b922-f84100e32d27",
                                        "entry_id": "426834b6-1988-312a-a767-c50037e821c9",
                                        "glosses": [
                                            "vorausschauend, überlegt, mit Bedacht handelnd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6edcaecf-4ea7-452d-987d-d56e8e31c8aa",
                                                "sense_id": "69f83710-8454-3455-b922-f84100e32d27",
                                                "text": "Der umsichtige Mitarbeiter entdeckte den Fehler, bevor ein Unglück passieren konnte."
                                            },
                                            {
                                                "example_id": "dc64d5be-ffbe-4939-87ac-db54609a95e5",
                                                "sense_id": "69f83710-8454-3455-b922-f84100e32d27",
                                                "text": "„Die gedankliche Auseinandersetzung mit dieser Frage wird vom Reiseleiter in der Weise geschickt eingeleitet, dass er die umsichtige Leistung des Fahrers nochmals hervorhebt und dabei beschreibt, dass es sich in der Türkei gehöre, sich persönlich zu bedanken.“"
                                            },
                                            {
                                                "example_id": "56f29e10-97de-406c-abad-9ee243cbd1af",
                                                "sense_id": "69f83710-8454-3455-b922-f84100e32d27",
                                                "text": "[COVID-19-Pandemie:] „Allein die Empfehlungen an die Politik fielen etwas zurückhaltender aus: Aufgrund der Daten und der bestehenden Unsicherheiten ‚raten wir zur Vorsicht und zur umsichtigen Überwachung‘ der Aufhebung der Corona-Maßnahmen, heißt es in dem Text.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86a7bf4d-ea9f-42ae-8268-866d4bd78d14",
                        "source_entry_id": "c7fc8c2b-d08c-3ae1-9bc4-36d140028104",
                        "target_lang_word": "circumspect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "circumspect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dd23548-ef64-3ae3-93e4-9f04e91e826c",
                                        "entry_id": "cdc350c8-7ca8-352e-a2ec-b5971af71856",
                                        "glosses": [
                                            "Carefully aware of all circumstances; considerate of all that is pertinent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27bdd164-ae4f-48e9-97f2-ff946610aae1",
                                                "sense_id": "3dd23548-ef64-3ae3-93e4-9f04e91e826c",
                                                "text": "Being aware of the danger of upsetting her audience, she was somewhat circumspect in her comments."
                                            },
                                            {
                                                "example_id": "086e614e-8e60-4bc9-b8dd-609c96ac602a",
                                                "sense_id": "3dd23548-ef64-3ae3-93e4-9f04e91e826c",
                                                "text": "Comment must be circumspect until fuller particulars are available, [...]."
                                            }
                                        ]
