                "senses": [
                    {
                        "sense_id": "8cd0fc06-02b8-3d5e-9dd0-8f25a6616666",
                        "entry_id": "a8e0536d-adf1-3110-a618-40b8bce3a6fb",
                        "glosses": [
                            "Demander et recevoir en prêt solidairement avec d'autres co-emprunteurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ef87979-8148-4b8b-9ac8-1096e47fe63f",
                                "sense_id": "8cd0fc06-02b8-3d5e-9dd0-8f25a6616666",
                                "text": "\"Chez BoursedesCrédits, l'écrasante majorité de profils en CDD pour lesquels nous trouvons une solution de financement, co-empruntent en effet avec une personne en CDI\", confirme Arsalain El Kessir, président de BoursedesCrédits."
                            },
                            {
                                "example_id": "70b08592-878c-4e20-bd55-4b72fdf73cc8",
                                "sense_id": "8cd0fc06-02b8-3d5e-9dd0-8f25a6616666",
                                "text": "Est-il plus avantageux, financièrement et juridiquement (j'entend pas^([sic]) là nos devoirs de rembourser le prêt) d'emprunter chacun le même montant de manière indépendante ou de co-emprunter la somme des deux montants. Exemple : emprunter chacun 100K€ ou co-emprunter 200K€ ?"
                            }
                        ]
                    }
