                                "tr": "Kitabı dikkatlice masanın üzerine <w>koyuyorum</w>.",
                                "es": "Con cuidado, <w>pongo</w> el libro sobre la mesa.",
                                "zh": "我小心地把书<w>放</w>在桌子上。"
                            }
                        },
                        {
                            "text": "De moeder <w>legt</w> haar kind elke avond om acht uur in bed.",
                            "target_lang_translations": {
                                "en": "The mother <w>puts</w> her child in bed every evening at eight o'clock.",
                                "ru": "Мать <w>укладывает</w> своего ребенка в кровать каждый вечер в восемь часов.",
                                "fr": "La mère <w>met</w> son enfant au lit tous les soirs à huit heures.",
                                "pl": "Matka codziennie wieczorem o ósmej <w>kładzie</w> swoje dziecko do łóżka.",
                                "de": "Die Mutter <w>legt</w> ihr Kind jeden Abend um acht Uhr ins Bett.",
                                "it": "La madre <w>mette</w> il suo bambino a letto ogni sera alle otto.",
                                "cs": "Matka každý večer v osm hodin <w>ukládá</w> své dítě do postele.",
                                "tr": "Anne, çocuğunu her akşam saat sekizde yatağa <w>yatırıyor</w>.",
                                "es": "La madre <w>acuesta</w> a su hijo todas las noches a las ocho.",
                                "zh": "母亲每天晚上八点都把孩子<w>放</w>到床上睡觉。"
                            }
                        },
                        {
                            "text": "Hij <w>legde</w> zijn hand op mijn schouder om me te troosten.",
                            "target_lang_translations": {
                                "en": "He <w>laid</w> his hand on my shoulder to comfort me.",
                                "ru": "Он <w>положил</w> руку мне на плечо, чтобы утешить меня.",
                                "fr": "Il a <w>posé</w> sa main sur mon épaule pour me consoler.",
                                "pl": "<w>Położył</w> mi rękę na ramieniu, żeby mnie pocieszyć.",
                                "de": "Er <w>legte</w> seine Hand auf meine Schulter, um mich zu trösten.",
                                "it": "Mi ha <w>posato</w> una mano sulla spalla per consolarmi.",
                                "cs": "<w>Položil</w> mi ruku na rameno, aby mě utěšil.",
                                "tr": "Beni teselli etmek için elini omzuma <w>koydu</w>.",
                                "es": "Él <w>puso</w> su mano sobre mi hombro para consolarme.",
                                "zh": "他把手<w>搁</w>在我的肩膀上安慰我。"
                            }
                        }
