{
    "word_family": [
        "vergieten",
        "bloedvergieten"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "23797218-fb24-3150-9c62-89d620671174",
                    "sense_definition": "Een ronde bak met gaatjes in de bodem die wordt gebruikt om vloeistof van voedsel te scheiden.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "keukengerei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nadat de pasta gaar is, moet je deze in een <w>vergiet</w> laten uitlekken.",
                            "target_lang_translations": {
                                "en": "After the pasta is cooked, you should let it drain in a <w>colander</w>."
                            }
                        },
                        {
                            "text": "Zorg dat je een groot <w>vergiet</w> gebruikt voor de gewassen groenten.",
                            "target_lang_translations": {
                                "en": "Make sure you use a large <w>strainer</w> for the washed vegetables."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorslag",
                        "vergiettest"
                    ],
                    "common_phrases": [
                        "groot vergiet",
                        "in een vergiet"
                    ],
                    "target_lang_definitions": {
                        "en": "A round bowl with holes in the bottom used to separate liquid from food."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "colander",
                                "target_lang_sense_clarification": "a bowl-shaped kitchen utensil for draining food"
                            },
                            {
                                "target_lang_word": "strainer",
                                "target_lang_sense_clarification": "a device used to separate solids from liquids"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da41e254-f1ac-3bd1-988b-5798261d5074",
                    "sense_definition": "De enkelvoud tegenwoordige tijd van <w>vergieten</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>vergiet</w> elke dag per ongeluk een beetje water tijdens het koken.",
                            "target_lang_translations": {
                                "en": "I <w>spill</w> a little bit of water by accident every day while cooking."
                            }
                        },
                        {
                            "text": "Hij <w>vergiet</w> geen traan om het verlies van zijn oude auto.",
                            "target_lang_translations": {
                                "en": "He doesn't <w>shed</w> a tear over the loss of his old car."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first-person singular present tense of the verb 'vergieten' (to shed or pour)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shed",
                                "target_lang_sense_clarification": "to let flow, such as tears or blood"
                            },
                            {
                                "target_lang_word": "spill",
                                "target_lang_sense_clarification": "to accidentally pour out a liquid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5837aee0-49c5-3e01-8430-2aca0d1a6399",
                    "sense_definition": "De gebiedende wijs van <w>vergieten</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Vergiet</w> geen onschuldig bloed in deze zinloze strijd.",
                            "target_lang_translations": {
                                "en": "Do not <w>shed</w> innocent blood in this senseless struggle."
                            }
                        },
                        {
                            "text": "<w>Vergiet</w> de vloeistof voorzichtig in de andere kom.",
                            "target_lang_translations": {
                                "en": "<w>Pour</w> the liquid carefully into the other bowl."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative form of the verb 'vergieten' (to shed or pour)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shed",
                                "target_lang_sense_clarification": "command to let flow, often used with blood"
                            },
                            {
                                "target_lang_word": "pour",
                                "target_lang_sense_clarification": "command to transfer liquid from one container to another"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}