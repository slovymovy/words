                        "glosses": [
                            "As much as a trolley will hold."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec6fa515-73de-4065-a356-0def24e73dc7",
                                "sense_id": "3677a637-911f-3193-a3a2-9cee55a78518",
                                "text": "Children row around in rubber dinghies, self-importantly pointing out hero daddies; trolleysful of tinned curry sauce and six-packs of beer are transferred down hatches with a blithe disregard for deadweight."
                            },
                            {
                                "example_id": "99041a4e-90e9-4fd0-abee-d6a9225f80f6",
                                "sense_id": "3677a637-911f-3193-a3a2-9cee55a78518",
                                "text": "Watch the great trolleysful of cat and dog food, cat litter, bird seed and hamster bedding wheeled through the check-outs each weekend if you doubt our animal-mania."
                            },
                            {
                                "example_id": "84325d12-3908-44fd-bb50-1cf0cac4bb7f",
                                "sense_id": "3677a637-911f-3193-a3a2-9cee55a78518",
                                "text": "Ringleader, Sheila Laking (46), who allowed the women to take “trolleysful” of groceries through her checkout at discount prices was jailed."
                            }
                        ]
                    }
