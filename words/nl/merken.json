                    "sense_id": "6bf07586-45d6-3ad5-bc7c-0599dca69ce8",
                    "sense_definition": "iets waarnemen of herkennen met de zintuigen of het verstand",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kon duidelijk <w>merken</w> dat de man het erg moeilijk had na het overlijden van zijn zoon.",
                            "target_lang_translations": {
                                "en": "You could clearly <w>tell</w> that the man was having a very hard time after his son's death.",
                                "ru": "Можно было ясно <w>заметить</w>, что мужчине было очень тяжело после смерти сына."
                            }
                        },
                        {
                            "text": "Ik kon het hoogteverschil tijdens het wandelen direct aan mijn ademhaling <w>merken</w>.",
                            "target_lang_translations": {
                                "en": "I could immediately <w>notice</w> the difference in altitude in my breathing while hiking.",
                                "ru": "Во время прогулки я сразу смог <w>почувствовать</w> перепад высот по своему дыханию."
                            }
                        }
                    ],
                    "synonyms": [
