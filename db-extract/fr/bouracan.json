                "senses": [
                    {
                        "sense_id": "0434202e-afec-3840-99be-d30d5a11b5b1",
                        "entry_id": "7fd1c8d4-e0bc-331e-885d-fb2098a18944",
                        "glosses": [
                            "Sorte de grosse étoffe de laine non croisée proche du camelot."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "574fd979-5b13-4095-a1a9-e1037774ae92",
                                "sense_id": "0434202e-afec-3840-99be-d30d5a11b5b1",
                                "text": "Il y avait le père enfoui dans un grand habit de bouracan qui ne sortait de l’armoire que tous les dimanches."
                            },
                            {
                                "example_id": "fb7d2617-d6ea-4cf6-845d-8588a23c46f9",
                                "sense_id": "0434202e-afec-3840-99be-d30d5a11b5b1",
                                "text": "Il y a des bouracans dont la laine est teinte avant que d'être travaillée sur le métier; ce sont ceux-là que l'on nomme bouracans teints en laine. Il y en a d'autres qui se fabriquent en blanc, et que l'on teint ensuite en rouge, noir, bleu, brun , etc. Ces derniers sont appelés bouracans teints en pièce, […]."
                            },
                            {
                                "example_id": "44bc56da-b8bb-4cd7-980f-96ab1da023f9",
                                "sense_id": "0434202e-afec-3840-99be-d30d5a11b5b1",
                                "text": "Elle avait une courte robe bleu sombre, à petits plis froncés sur les hanches, et une sorte de veste ou brassière en bouracan noir que fermaient, à la naissance de la poitrine, deux ou trois boutons de corne."
                            },
                            {
                                "example_id": "1df21bac-04b8-4641-8048-94d54ba574b8",
                                "sense_id": "0434202e-afec-3840-99be-d30d5a11b5b1",
                                "text": "Elle était assise sur un cachemire, et couverte d’une pèlerine de bouracan. Hors du petit manchon de chinchilla, attaché à son cou par une cordelière verte, sa main péremptoire lançait des feux bleus, avec quelque chose de bénisseur et de prophétique. ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63b91228-faed-40c3-892d-2c0cc73b2f79",
                        "source_entry_id": "7fd1c8d4-e0bc-331e-885d-fb2098a18944",
                        "source_sense_id": "0434202e-afec-3840-99be-d30d5a11b5b1",
                        "target_lang_word": "Barchent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Barchent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "effd9b66-e00a-3f76-8435-714e3c7a2534",
                                        "entry_id": "5faf6cb9-dbdf-3310-a62e-9c99390ec8ee",
                                        "glosses": [
                                            "ein grober Stoff, der ein Mischgewebe aus Baumwolle und Leinen darstellt"
                                        ],
                                        "tags": [
                                            "Textil"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eed61af3-4652-40d2-b3ce-26614743ce3b",
                                                "sense_id": "effd9b66-e00a-3f76-8435-714e3c7a2534",
                                                "text": "„Daneben wurden auch eingeführte Rohstoffe wie Baumwolle, Seide und Barchent, ein Mischgewebe aus Leinen und Baumwolle, verarbeitet.“"
                                            },
                                            {
                                                "example_id": "8a118b9f-2ddf-49a6-b13d-a6a37bbe976b",
                                                "sense_id": "effd9b66-e00a-3f76-8435-714e3c7a2534",
                                                "text": "„Er trug einen Anzug aus geköpertem Barchent, seine Haltung war steif, der Backenbart zu Koteletten gestutzt; so wirkte er wie ein Beamter und Dandy zugleich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
