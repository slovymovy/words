                        "entry_id": "a8329e6a-5a0f-362f-bf42-1e84acce7148",
                        "glosses": [
                            "Action de détricoter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "670a08df-c1e6-4ae2-a01c-34f2199c9c18",
                                "sense_id": "83bc7298-219a-3897-8765-23087c9c4536",
                                "text": "On retrouve comme à Orléans, des machines à tricoter, des fillettes occupées au détricotage à la main."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9c11c98-f8fa-354e-b22b-99e33c194ce3",
                        "entry_id": "a8329e6a-5a0f-362f-bf42-1e84acce7148",
                        "glosses": [
                            "Démanteler un décret ou une loi pour en diminuer son impact."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "847c64d7-5737-464d-a1d0-7ad8f8445b6a",
                                "sense_id": "f9c11c98-f8fa-354e-b22b-99e33c194ce3",
                                "text": "Officiellement, il ne s’agit évidemment pas de revenir sur la très contestée loi….. Mais dans les faits, c’est bien un détricotage en règle qui se profile."
                            },
                            {
                                "example_id": "573a1032-32cb-4cdd-b6ea-a77b52d8b295",
                                "sense_id": "f9c11c98-f8fa-354e-b22b-99e33c194ce3",
                                "text": "L’un veut durcir le revenu de solidarité active, l’autre veut le sauver du détricotage."
                            }
                        ]
                    }
                ],
