                                        "sense_id": "f6dcc2ee-4455-3e97-b828-af6470044803",
                                        "entry_id": "82ca6ed8-4bbc-358d-a405-b1fc14e36cbc",
                                        "glosses": [
                                            "The content of an individual television broadcast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16cbbc2a-553d-4622-be4d-c4f170657812",
                                                "sense_id": "f6dcc2ee-4455-3e97-b828-af6470044803",
                                                "text": "Rosie likes the television program about fairies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e36491a-b7c5-4224-bb73-6d7917f086a5",
                        "source_entry_id": "a1abecae-c602-32da-9cd6-f914d8aadbe1",
                        "target_lang_word": "television show",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "television show",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4f155bd-a441-39ce-aa57-8f2798515347",
                                        "entry_id": "e7facf36-e3ef-3541-b737-9c9689932eda",
                                        "glosses": [
                                            "A live or recorded broadcast or program, or series of broadcasts or programs, meant to be viewed on television."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "957be3d4-4ab3-4cd9-beb5-342bdb3b7918",
                                                "sense_id": "c4f155bd-a441-39ce-aa57-8f2798515347",
                                                "text": "The opening vignette thus functions as a sophisticated postmodern \"show within a show\" rumination on television and its cultural impact within our lives. We know we are watching a television show, and the program is commenting on earlier programs, thereby distinguishing it from other shows that lack this self-consciousness. But instead of inviting us to question television in terms of our hindsight knowledge about earlier shows, this dialogue in effect draws us into the drama by having us identify precisely with the nostalgia of the characters for these earlier programs."
                                            },
                                            {
                                                "example_id": "ba365a57-9cc6-4eaf-b8ad-526d33655809",
                                                "sense_id": "c4f155bd-a441-39ce-aa57-8f2798515347",
                                                "text": "My favorite movie is Grown Ups, and my favorite television show is NCIS. I like that show for some reason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0352215f-d0df-3edb-ab84-c16280ad8c4f",
                                        "entry_id": "e7facf36-e3ef-3541-b737-9c9689932eda",
                                        "glosses": [
                                            "The taping of a television broadcast before a studio audience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c4b3213-db20-4e76-ad46-4b3db0a7df40",
                                                "sense_id": "0352215f-d0df-3edb-ab84-c16280ad8c4f",
                                                "text": "A boy named Joey was proudly announcing his father was going to take him into Newark that afternoon to attend a television show."
                                            },
                                            {
                                                "example_id": "6c2bf8f9-8375-4dfe-97d7-96794014a38b",
                                                "sense_id": "0352215f-d0df-3edb-ab84-c16280ad8c4f",
                                                "text": "Those interested in attending television shows while in New York City should send ticket requests as follows:"
                                            },
                                            {
                                                "example_id": "c470b62c-707f-4228-8c7f-bd0eb7ebbf55",
                                                "sense_id": "0352215f-d0df-3edb-ab84-c16280ad8c4f",
                                                "text": "I have not been back to the prison except when I most recently attended a television show with Representative John Conyers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
