                    "sense_id": "f00ab556-e56c-3c0d-a827-6220ec87c37d",
                    "sense_definition": "Odczuwać niepokój, lęk lub smutek z powodu jakiejś sytuacji lub w trosce o kogoś.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reflexive_worry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie musisz się <w>martwić</w> o pieniądze, bo mamy spore oszczędności.",
                            "target_lang_translations": {
                                "ru": "Тебе не нужно <w>беспокоиться</w> о деньгах, потому что у нас большие сбережения.",
                                "en": "You don't need to <w>worry</w> about money, because we have considerable savings.",
                                "nl": "Je hoeft je geen <w>zorgen te maken</w> over geld, want we hebben flinke spaartegoeden.",
                                "de": "Du musst dir keine <w>Sorgen machen</w> um das Geld, denn wir haben erhebliche Ersparnisse.",
                                "fr": "Tu n'as pas besoin de <w>t'inquiéter</w> pour l'argent, car nous avons de belles économies.",
                                "it": "Non devi <w>preoccuparti</w> per il denaro, perché abbiamo molti risparmi.",
                                "cs": "Nemusíš si <w>dělat starosti</w> o peníze, protože máme slušné úspory.",
                                "tr": "Para konusunda <w>endişelenmene</w> gerek yok, çünkü epey bir birikimimiz var.",
                                "es": "No tienes que <w>preocuparte</w> por el dinero, porque tenemos bastantes ahorros.",
                                "zh": "你不必为钱<w>发愁</w>，因为我们有一大笔积蓄。"
                            }
                        },
                        {
                            "text": "Zacząłem się <w>martwić</w> o zdrowie ojca, gdy przestał wychodzić z domu.",
                            "target_lang_translations": {
                                "ru": "Я начал <w>беспокоиться</w> о здоровье отца, когда он перестал выходить из дома.",
                                "en": "I started to <w>worry</w> about my father's health when he stopped leaving the house.",
                                "nl": "Ik begon me <w>zorgen te maken</w> over de gezondheid van mijn vader toen hij het huis niet meer uitkwam.",
                                "de": "Ich fing an, mir <w>Sorgen zu machen</w> um die Gesundheit meines Vaters, als er aufhörte, das Haus zu verlassen.",
                                "fr": "J'ai commencé à <w>m'inquiéter</w> pour la santé de mon père quand il a cessé de sortir de la maison.",
                                "it": "Ho cominciato a <w>preoccuparmi</w> per la salute di mio padre quando ha smesso di uscire di casa.",
                                "cs": "Začal jsem mít <w>strach</w> o otcovo zdraví, když přestal vycházet z domu.",
                                "tr": "Evden çıkmamaya başladığında babamın sağlığı için <w>endişelenmeye</w> başladım.",
                                "es": "Empecé a <w>preocuparme</w> por la salud de mi padre cuando dejó de salir de casa.",
                                "zh": "当父亲不再出门时，我开始<w>担心</w>他的健康。"
                            }
                        }
                    ],
