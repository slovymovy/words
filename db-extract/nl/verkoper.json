                                        "glosses": [
                                            "A man whose job it is to sell things, either in a shop / store or elsewhere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b19793cc-25fa-4cc9-ab1f-d56d15c9a17b",
                                                "sense_id": "1e77da93-4793-3847-8f1f-8d465a2d6cf3",
                                                "text": "There was an auto salesman in here yesterday that claimed you could always tell a fellow's class by the car he drove, but I says to him, 'Don't be silly,' I says; 'the wisenheimers grab a look at a fellow's nails when they want to tell if he's a tin-horn or a real gent!\"'"
                                            },
                                            {
                                                "example_id": "05a62bb7-e585-4fab-b5a5-18f07890bf0c",
                                                "sense_id": "1e77da93-4793-3847-8f1f-8d465a2d6cf3",
                                                "text": "Would you say it was fair to describe these salesmen that were in your crews as dynamiters, or suede shoe salesmen?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
