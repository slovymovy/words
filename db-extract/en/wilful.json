                "senses": [
                    {
                        "sense_id": "532d4ad7-fd2b-3185-a6fd-47adc1ab10d0",
                        "entry_id": "1b12e26a-dff1-38f5-9152-ee8248c761e9",
                        "glosses": [
                            "Intentional; deliberate."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "b714957d-d21f-4680-9295-77bbc545736f",
                                "sense_id": "532d4ad7-fd2b-3185-a6fd-47adc1ab10d0",
                                "text": "Knowingly or unknowingly, every therapist assumes that each client possesses the capacity to change through willful choice."
                            }
                        ]
                    },
                    {
                        "sense_id": "02444290-6002-346a-89fa-556ba52c6632",
                        "entry_id": "1b12e26a-dff1-38f5-9152-ee8248c761e9",
                        "glosses": [
                            "Stubborn and determined."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "6d65ec80-4a86-42b7-9786-c9ba256409ef",
                                "sense_id": "02444290-6002-346a-89fa-556ba52c6632",
                                "text": "Mary had taken the whim into her willful head, and Jane could not dissuade her."
                            },
                            {
                                "example_id": "24ed328b-ef92-430b-b800-5c925a69bb89",
                                "sense_id": "02444290-6002-346a-89fa-556ba52c6632",
                                "text": "Let you not be taking it bad, Conchubor, but you’ll get little good seeing her this night, for with all my talking it’s wilfuler she’s growing these two months or three."
                            },
                            {
                                "example_id": "9ec270c8-4511-4947-b112-def67d082215",
                                "sense_id": "02444290-6002-346a-89fa-556ba52c6632",
                                "text": "He was a youth to the end of his days, the heart of a boy with the head of a sage; the heart of a good boy, or a bad boy, but always a wilful boy, and wilfulest to show himself out at every time for just the boy he was."
                            },
                            {
                                "example_id": "1e031f7b-9f13-43af-bcb1-c5ed6d690c07",
                                "sense_id": "02444290-6002-346a-89fa-556ba52c6632",
                                "text": "\"He's as willful as you,\" Rizpah said. \"If you let him hurt himself again, so help me, I'll — \""
                            },
                            {
                                "example_id": "4cd0e89b-5739-44a0-80df-846257d5204a",
                                "sense_id": "02444290-6002-346a-89fa-556ba52c6632",
                                "text": "You had a pampered upbringing, and possessed enough of a willful streak that I wanted to slap you at times"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c11cb7a3-b64c-4a6e-b610-e53a232d3fa0",
