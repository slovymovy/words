                },
                {
                    "sense_id": "d5ca02ab-bfff-3737-b13c-d3939099ab21",
                    "sense_definition": "In a crossword, referring to a square that belongs to both a horizontal and a vertical word.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is much easier to solve a puzzle when most letters are <w>checked</w>.",
                            "target_lang_translations": {
                                "ru": "Решить головоломку гораздо проще, когда большинство букв <w>пересекаются</w> с другими словами."
                            }
                        },
                        {
                            "text": "A <w>checked</w> letter provides a helpful hint for the intersecting clue.",
                            "target_lang_translations": {
                                "ru": "<w>Пересекающаяся</w> буква дает полезную подсказку для соседнего слова."
                            }
                        }
                    ],
                    "antonyms": [
                        "carry-on"
                    ],
                    "common_phrases": [
                        "checked square",
                        "checked letter"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in crosswords"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В кроссворде: относящийся к клетке, которая принадлежит одновременно горизонтальному и вертикальному слову."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересекающийся",
                                "target_lang_sense_clarification": "о букве или клетке в кроссворде"
                            }
