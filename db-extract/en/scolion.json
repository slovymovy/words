                "word": "scolion",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3c2e3b09-4101-4c6b-ae2e-254ecc5ebcbf",
                        "entry_id": "a38d11b4-2867-35b8-b065-c19c7c647b9d",
                        "tags": [
                            "plural"
                        ],
                        "form": "scolia"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a5a4bc3-b148-38f4-9ed8-6fd68719ccd3",
                        "entry_id": "a38d11b4-2867-35b8-b065-c19c7c647b9d",
                        "glosses": [
                            "Any of a genre of songs sung in turn by symposiasts to the accompaniment of a lyre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da81cab3-bbe2-4182-8f96-c321399e6441",
                                "sense_id": "9a5a4bc3-b148-38f4-9ed8-6fd68719ccd3",
                                "text": "Terpander was the inventour of those songs called Scolia, which were sung at feasts."
                            },
                            {
                                "example_id": "db7ceb20-37bc-4d5e-a2a7-ae8683d85a22",
                                "sense_id": "9a5a4bc3-b148-38f4-9ed8-6fd68719ccd3",
                                "text": "Which Athenæus, proveth against the Calumniations of Demophilus not to be a sacred hymne or Pæan, but a Scolion or Festivall Song."
                            },
                            {
                                "example_id": "47cc13f3-7335-4bfb-918c-32e7fdac9abd",
                                "sense_id": "9a5a4bc3-b148-38f4-9ed8-6fd68719ccd3",
                                "text": "In the following Scolium, Timocreon gives his opinion of riches."
                            },
                            {
                                "example_id": "13b3adef-12b1-48a5-8b88-52ea115f83b2",
                                "sense_id": "9a5a4bc3-b148-38f4-9ed8-6fd68719ccd3",
                                "text": "The celebrated scolion, or series of scolia, addressed to Harmodius and Aristogiton."
                            },
                            {
                                "example_id": "990059a0-bfef-4dc5-8ce3-4be97237496f",
                                "sense_id": "9a5a4bc3-b148-38f4-9ed8-6fd68719ccd3",
                                "text": "I mean the Scolia, when one guest commenced a sentence in verse, and handed a branch to any other he chose, who was compelled to finish the verse in the cleverest way he could."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9b41c37-5302-4ec1-8ccb-eee18a71aaae",
                        "source_entry_id": "a38d11b4-2867-35b8-b065-c19c7c647b9d",
                        "source_sense_id": "9a5a4bc3-b148-38f4-9ed8-6fd68719ccd3",
                        "source_sense_description": "song sung in turn by symposiasts",
