        "nl-extract.jsonl": [
            {
                "entry_id": "b78ce9e8-7e82-3aeb-806d-26c96480dc97",
                "word": "ingericht",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "01823e62-18aa-31a3-8af7-dfb89fcdf28c",
                        "entry_id": "b78ce9e8-7e82-3aeb-806d-26c96480dc97",
                        "glosses": [
                            "voorzien van meubelen en andere zaken die noodzakelijk zijn om in een ruimte te kunnen wonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "895e15af-ea66-455d-b131-5dc3c445e6af",
                                "sense_id": "01823e62-18aa-31a3-8af7-dfb89fcdf28c",
                                "text": "Wij huurden een volledig ingerichte tent, omdat we in onze kleine auto onmogelijk zelf alle kampeerspullen konden meenemen"
                            },
                            {
                                "example_id": "30fd0dde-a9a5-4542-a53a-fdbb62bdb23b",
                                "sense_id": "01823e62-18aa-31a3-8af7-dfb89fcdf28c",
                                "text": "In zijn kraton Kaspuhan geeft de jonge sultan Natadiningrat een rondleiding door de rijk ingerichte en gestoffeerde koninklijke zalen."
                            },
                            {
                                "example_id": "803dd660-39fe-4cc7-91ff-f4748e8b5975",
                                "sense_id": "01823e62-18aa-31a3-8af7-dfb89fcdf28c",
                                "text": "Achter een deur bleek een keurig ingericht slaapkamertje te zijn met een opgemaakt tweepersoonsbed."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "f3e3b290-1319-3e34-b7f6-c5b123331bfd",
                "word": "ingericht",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "47a7df15-1ef7-340b-bdd7-1f7fd0db5ecf",
                        "entry_id": "f3e3b290-1319-3e34-b7f6-c5b123331bfd",
                        "glosses": [
                            "voltooid deelwoord van inrichten"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "5733e295-1c2e-4661-aec6-93b9cf4ec598",
                                "sense_id": "47a7df15-1ef7-340b-bdd7-1f7fd0db5ecf",
                                "text": "Daarnaast wordt het gebied ingericht als een \"groene oase\": er komen tientallen bakken met planten en bomen te staan."
                            },
                            {
                                "example_id": "1800bfd0-c748-4033-8e9d-f6afa29561df",
                                "sense_id": "47a7df15-1ef7-340b-bdd7-1f7fd0db5ecf",
                                "text": "\"Het winkelcentrum van Winterswijk is helemaal ingericht op toerisme."
                            },
                            {
                                "example_id": "737fa5c5-c3ea-4f09-b115-96f2432636ef",
                                "sense_id": "47a7df15-1ef7-340b-bdd7-1f7fd0db5ecf",
                                "text": "Pas na het passeren van Kearsarge Pass, toen we de uitgestrekte groene vallei van Kings Canyon in liepen, raakten we aan de praat. Het was fascinerend te horen hoe England zijn leven had ingericht."
                            }
                        ]
                    }
