                        "examples": [
                            {
                                "example_id": "3da51898-c795-4c39-bc97-9ef2bdd91e3a",
                                "sense_id": "e0be00d5-465e-35ee-939f-c073e1fa8456",
                                "text": "Amnesty International en een Syrische mensenrechtenorganisatie noemen een video-opname van een executie van enkele Syrische militairen schokkend. Een amateuropname is opgedoken van gewapende mannen die gewonde militairen slaan en schoppen en vervolgens doodschieten."
                            },
                            {
                                "example_id": "066bae14-8aa6-483b-bf5c-2b660b2b71ed",
                                "sense_id": "e0be00d5-465e-35ee-939f-c073e1fa8456",
                                "text": "Hieronder een amateuropname van het liedje. Onderaan vind je een compilatie van 3FM."
                            },
                            {
                                "example_id": "61a49ca1-a08a-4635-b073-adb655bdfc6e",
                                "sense_id": "e0be00d5-465e-35ee-939f-c073e1fa8456",
                                "text": "Voor het boek Bob Dylan compleet ontleedde Guesdon samen met Philippe Margotin alle 492 nummers die Bob Dylan in ruim een halve eeuw opnam: 36 studioalbums plus nog wat losse singles en de fameuze bootlegs. Vanaf een amateuropname bij een vriend thuis uit 1959 (toen Dylan nog gewoon Robert Allen Zimmerman was) tot het laatste studioalbum van vorig jaar, Shadows in the night."
                            }
                        ]
                    }
