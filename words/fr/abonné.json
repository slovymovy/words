                        "liste des abonnés"
                    ]
                },
                {
                    "sense_id": "df35f092-f486-302a-8db3-a8ecd502a051",
                    "sense_definition": "Personne qui suit les publications régulières d'un compte sur un réseau social.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "internet",
                    "name_type": "no",
                    "examples": [
