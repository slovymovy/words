                "senses": [
                    {
                        "sense_id": "ca1fd37c-861b-3e3f-a2c8-bd8f664d11bc",
                        "entry_id": "ea36c3c6-4bf8-3f0e-b974-c748ad75ae20",
                        "glosses": [
                            "mit einer Scheibe aus Bleiglas versehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6170645-b2f1-4d83-883a-18606cee044d",
                                "sense_id": "ca1fd37c-861b-3e3f-a2c8-bd8f664d11bc",
                                "text": "„Was vorhin wie das Studio eines exzentrischen Künstlers ausgesehen hatte, nahm nun die Aura einer bleiverglasten Kathedrale an, die jedoch eine finstere Entweihung erlitten hatte.“"
                            },
                            {
                                "example_id": "1105635b-89e7-4a40-8cb2-182476d042d8",
                                "sense_id": "ca1fd37c-861b-3e3f-a2c8-bd8f664d11bc",
                                "text": "„Draußen hatte es zu regnen begonnen, dicke Tropfen schlugen an die bleiverglasten Fenster.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
