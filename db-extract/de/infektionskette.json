                "senses": [
                    {
                        "sense_id": "a893e846-7770-39e3-b13b-cdd3627901d8",
                        "entry_id": "ee51e959-42d0-3545-a0f2-6d7e9980b78d",
                        "glosses": [
                            "Liste der Individuen, die sich nacheinander/voneinander mit einer Infektionskrankheit angesteckt haben; Stationen, die ein Erreger passiert"
                        ],
                        "tags": [
                            "Epidemiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "e8f2fb3f-d315-4e50-b252-cc5e2a37e0f5",
                                "sense_id": "a893e846-7770-39e3-b13b-cdd3627901d8",
                                "text": "„Die Nachverfolgung von Infektionsketten ist im grenzüberschreitenden Verkehr am Oberrhein oft kompliziert.“"
                            },
                            {
                                "example_id": "014bb867-0bb4-404d-974e-5c63ecc79806",
                                "sense_id": "a893e846-7770-39e3-b13b-cdd3627901d8",
                                "text": "Eine Infektionskette kann zum Beispiel so laufen: Salmonellen können vom Futtermittel auf Tiere übertragen werden, von dort auf tierische Lebensmittel wie Milch oder Eier kommen und dann durch den Verzehr dieser Lebensmittel den Menschen erreichen."
                            }
                        ],
