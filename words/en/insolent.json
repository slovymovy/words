    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "24e61333-aaa4-3f30-a3aa-d6062556351a",
                    "sense_definition": "Rude, disrespectful, or bold in a way that shows a lack of respect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disrespectful_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher would not tolerate such <w>insolent</w> behavior in her classroom.",
                            "target_lang_translations": {
                                "ru": "Учительница не потерпела бы такого <w>дерзкого</w> поведения в своем классе."
                            }
                        },
                        {
                            "text": "He made an <w>insolent</w> remark that shocked everyone at the dinner table.",
                            "target_lang_translations": {
                                "ru": "Он сделал <w>наглое</w> замечание, которое шокировало всех за обеденным столом."
                            }
                        }
                    ],
                    "synonyms": [
                        "disrespectful",
                        "impertinent",
                        "impudent"
                    ],
                    "antonyms": [
                        "respectful",
                        "polite"
                    ],
                    "common_phrases": [
                        "insolent behavior",
                        "insolent remark",
                        "insolent child"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубый, неуважительный или дерзкий, демонстрирующий отсутствие почтения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дерзкий",
                                "target_lang_sense_clarification": "непочтительный, вызывающий"
                            },
                            {
                                "target_lang_word": "наглый",
                                "target_lang_sense_clarification": "бесстыдный, нахальный"
                            },
                            {
                                "target_lang_word": "нахальный",
                                "target_lang_sense_clarification": "бесцеремонный, грубый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92cab72e-321b-304b-92b5-35157d2b34d0",
                    "sense_definition": "Insulting in manner or words, particularly in an arrogant or insubordinate manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disrespectful_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officer was disciplined for his <w>insolent</w> attitude toward his superiors.",
                            "target_lang_translations": {
                                "ru": "Офицер был подвергнут дисциплинарному взысканию за свое <w>высокомерное</w> отношение к начальству."
                            }
                        },
                        {
                            "text": "She gave an <w>insolent</w> shrug when asked to explain her actions.",
                            "target_lang_translations": {
                                "ru": "Она <w>вызывающе</w> пожала плечами, когда ее попросили объяснить свои действия."
                            }
                        }
                    ],
                    "synonyms": [
                        "impertinent",
                        "impudent"
                    ],
                    "antonyms": [
                        "submissive",
                        "deferential"
                    ],
                    "common_phrases": [
                        "insolent attitude",
                        "insolent tone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оскорбительный по манере поведения или словам, особенно высокомерный или непокорный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высокомерный",
                                "target_lang_sense_clarification": "надменный, спесивый"
                            },
                            {
                                "target_lang_word": "вызывающий",
                                "target_lang_sense_clarification": "демонстративно непокорный"
                            },
                            {
                                "target_lang_word": "дерзкий",
                                "target_lang_sense_clarification": "непокорный, непочтительный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "596c9d20-dbeb-32a1-8cba-5ead684efda6",
                    "sense_definition": "A person who behaves in an insolent, rude, or disrespectful manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>insolents</w> laughed and continued to mock the old man.",
                            "target_lang_translations": {
                                "ru": "Молодые <w>наглецы</w> смеялись и продолжали издеваться над стариком."
                            }
                        },
                        {
                            "text": "He was known as a rebel and an <w>insolent</w> who refused to follow any rules.",
                            "target_lang_translations": {
                                "ru": "Он был известен как бунтарь и <w>нахал</w>, отказывающийся следовать любым правилам."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used as a noun in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ведет себя нагло, грубо или неуважительно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наглец",
