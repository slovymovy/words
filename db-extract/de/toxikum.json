                            {
                                "example_id": "7ee92b53-a708-4030-8e8a-858b74064e30",
                                "sense_id": "cf596420-229c-3eb6-bd64-55a93197f760",
                                "text": "Der kritische Zustand des Patienten wurde durch verschiedene Toxika hervorgerufen."
                            },
                            {
                                "example_id": "163edde6-5013-40b1-ab13-b93b22985b48",
                                "sense_id": "cf596420-229c-3eb6-bd64-55a93197f760",
                                "text": "Dieses Toxikum lässt sich nur schwer im Blut nachweisen."
                            },
                            {
                                "example_id": "152a7dd5-24e4-46be-92f4-296876c1223e",
                                "sense_id": "cf596420-229c-3eb6-bd64-55a93197f760",
                                "text": "Das in der Kartoffel enthaltene Solanin wirkt wie ein Toxikum auf den Pilz."
                            }
                        ],
