            {
                "entry_id": "95646e4c-17f2-3f28-87f3-79021b285c9f",
                "word": "denominative",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7fa101b4-8a7c-3eb3-ad6a-6f933af9fc1a",
                        "entry_id": "95646e4c-17f2-3f28-87f3-79021b285c9f",
                        "glosses": [
                            "Being a name."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b5b8726f-40bb-4a31-ac33-1c199531fb59",
                                "sense_id": "7fa101b4-8a7c-3eb3-ad6a-6f933af9fc1a",
                                "text": "From the fact that this was the most noticeable feature in their costume, the name came naturally to be the denominative term of the tribe."
                            }
                        ]
                    },
                    {
                        "sense_id": "47667b35-01b3-399e-aa98-a4d273d3ae2e",
                        "entry_id": "95646e4c-17f2-3f28-87f3-79021b285c9f",
                        "glosses": [
                            "Possessing, or capable of possessing, a distinct denomination or designation; denominable."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7c8194d4-35a7-4ff0-89af-d1bba25aecf0",
                                "sense_id": "47667b35-01b3-399e-aa98-a4d273d3ae2e",
                                "text": "The least denominative part of time is a second."
                            }
                        ]
                    },
                    {
                        "sense_id": "b71cc70c-5893-3948-beeb-45d97a14e83a",
                        "entry_id": "95646e4c-17f2-3f28-87f3-79021b285c9f",
                        "glosses": [
                            "Deriving from a noun, or from an adjective, such as the verb destruct from the noun destruction."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
