                                "example_id": "0a5474fd-c74b-4b57-b035-9b83f29c4fc5",
                                "sense_id": "69b3475e-028b-32ab-b404-bc6e41405c85",
                                "text": "„Val kletterte in die Fahrerkabine, um das Portemonnaie aus ihrer Handtasche zu holen, und als sie zum Tankstellenshop ging, um zu bezahlen, kam Bobby mit.“"
                            },
                            {
                                "example_id": "3fd54553-fa69-4446-ba8a-86cb771bd088",
                                "sense_id": "69b3475e-028b-32ab-b404-bc6e41405c85",
                                "text": "„Völlig außer Atem stoppte ich das Rad und lehnte es an die Mauer des Tankstellenshops.“"
                            }
