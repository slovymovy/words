                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53b3d250-1cf2-3a4c-a638-2f401e983586",
                                        "entry_id": "d0547df3-a4a7-32b9-bb6e-c7bb9263d86b",
                                        "glosses": [
                                            "Person, die eine Defraudation (Betrug, Hinterziehung, Unterschlagung) begeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ac63344-8832-44ed-b009-2b877e1f0621",
                                                "sense_id": "53b3d250-1cf2-3a4c-a638-2f401e983586",
                                                "text": "„Wenn es sich um private Aufträge handelte, hatte sich der Defraudant einfach bei seinem Auftraggeber nicht mehr blicken lassen.“"
                                            },
                                            {
                                                "example_id": "86cef1fb-bc20-4cff-b5a3-54ceee05ab7f",
                                                "sense_id": "53b3d250-1cf2-3a4c-a638-2f401e983586",
                                                "text": "„Seine Mitgefangenen waren ein Dieb, ein kleiner Defraudant und ein russischer Professor aus Kasan, der als Landstreicher eingesperrt worden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
