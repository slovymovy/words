    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a613a91-682e-33e1-8949-fcd0af8a34ad",
                    "sense_definition": "To move forward in position or approach someone or something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers began to <w>advance</w> slowly across the open field.",
                            "target_lang_translations": {
                                "ru": "Солдаты начали медленно <w>продвигаться</w> по открытому полю.",
                                "pl": "Żołnierze zaczęli powoli <w>posuwać się naprzód</w> przez otwarte pole."
                            }
                        },
                        {
                            "text": "We watched the storm clouds <w>advance</w> towards the coast.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как грозовые тучи <w>надвигаются</w> на побережье.",
                                "pl": "Obserwowaliśmy, jak chmury burzowe <w>nadciągają</w> w kierunku wybrzeża."
                            }
                        }
                    ],
                    "antonyms": [
                        "retreat"
                    ],
                    "common_phrases": [
                        "advance towards",
                        "advance slowly",
                        "troops advance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться вперёд или приближаться к кому-либо или чему-либо.",
                        "pl": "Poruszać się naprzód, zbliżać się do kogoś lub czegoś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продвигаться",
                                "target_lang_sense_clarification": "перемещение вперёд"
                            },
                            {
                                "target_lang_word": "наступать",
                                "target_lang_sense_clarification": "военное действие, атака"
                            },
                            {
                                "target_lang_word": "надвигаться",
                                "target_lang_sense_clarification": "о явлениях природы"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "posuwać się naprzód",
                                "target_lang_sense_clarification": "przemieszczać się do przodu"
                            },
                            {
                                "target_lang_word": "zbliżać się",
                                "target_lang_sense_clarification": "podchodzić bliżej"
                            },
                            {
                                "target_lang_word": "nadciągać",
                                "target_lang_sense_clarification": "o chmurach, burzy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "341b006e-d086-3b7b-9c73-78bcbff39ade",
                    "sense_definition": "To make progress or improve in development.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "progress_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Medical science continues to <w>advance</w> at a very rapid pace.",
                            "target_lang_translations": {
                                "ru": "Медицинская наука продолжает <w>развиваться</w> очень быстрыми темпами.",
                                "pl": "Medycyna stale <w>rozwija się</w> w bardzo szybkim tempie."
                            }
                        },
                        {
                            "text": "She worked hard to <w>advance</w> her career in the legal profession.",
                            "target_lang_translations": {
                                "ru": "Она усердно работала, чтобы <w>продвинуть</w> свою карьеру в юридической сфере.",
                                "pl": "Ciężko pracowała, aby <w>pchnąć naprzód</w> swoją karierę w branży prawniczej."
                            }
