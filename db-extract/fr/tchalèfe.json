                        "examples": [
                            {
                                "example_id": "1b4970bc-f1b5-423d-8170-b574f13d155b",
                                "sense_id": "b766a70a-9b2e-3921-a1be-590787364bb9",
                                "text": "— Ah ! Kalla ! aoûsqu'il est la zoizeau ?\n—Il a porté la cage, basta ! A présent, y fait comme ça Bacora, c’est la cage qu’elle vole ; les zoiseaux y restent en bas.\n—Tchalèfe, tchalèfe ! y répond Calcidone : c'est les Bains Matarès, oilà ?"
                            },
                            {
                                "example_id": "2e216cad-3097-4651-a4ef-3922fd34e2aa",
                                "sense_id": "b766a70a-9b2e-3921-a1be-590787364bb9",
                                "text": "Citoyens, nous avons soupé de son kilo à toux ceux qui passent le temps à monter le coup au peuple et à lancer des tchalèfes pour se l’angorer."
                            }
                        ]
