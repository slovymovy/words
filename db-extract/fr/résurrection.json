                "senses": [
                    {
                        "sense_id": "6d8eff5c-faee-38d7-9040-fb7621de79ca",
                        "entry_id": "7fc0d88d-7dea-357f-b982-5c42b8ae28f8",
                        "glosses": [
                            "Retour du Christ à la vie trois jours après sa mort, événement fondateur du christianisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdc4322a-0364-4191-b4ec-89916e24cb92",
                                "sense_id": "6d8eff5c-faee-38d7-9040-fb7621de79ca",
                                "text": "La Résurrection n'est plus seulement vue comme l'événement qui redonne la vie à Jésus le Christ, mais comme l'œuvre de Dieu qui déploie sa puissance au sein de l'humanité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42e79f6d-1002-4998-9a70-a12438c16f9e",
                        "source_entry_id": "7fc0d88d-7dea-357f-b982-5c42b8ae28f8",
                        "source_sense_id": "6d8eff5c-faee-38d7-9040-fb7621de79ca",
                        "source_sense_description": "Retour de la mort à la vie",
