                            {
                                "example_id": "52562458-4ee0-4a1c-842d-6635fc98c31b",
                                "sense_id": "062b32b4-cf1f-388f-a213-1e69cff6b5c5",
                                "text": "Voor het hoofdgerecht wordt u uitgenodigd een kijkje te nemen in de open keuken met de heuse Zuid-Afrikaanse braai waar het hoofdgerecht het runderstaartstuk in zijn geheel geroosterd wordt."
                            },
                            {
                                "example_id": "539b3188-5b67-45a5-9474-4a457bbffe71",
                                "sense_id": "062b32b4-cf1f-388f-a213-1e69cff6b5c5",
                                "text": "Het knettert en het rookt weer. Bbq-chef Jord Althuizen heeft een nieuwe gril-bijbel: Smokey Goodness 3. Dit keer komt hij met tips en recepten uit het land van de braai: Zuid-Afrika."
                            }
                        ]
