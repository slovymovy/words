                        "cross_references": [
                            {
                                "target_word": "huidcel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "57137233-0938-3ddb-9f79-5437939a13f3",
                                        "entry_id": "2e64b7f8-73f0-39a7-9a10-8ffda452ca1a",
                                        "glosses": [
                                            "de verschillende soorten cellen die de verschillende weefsels van de huid vormen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60674c86-bd49-4cbe-8c37-11a0571a21e1",
                                                "sense_id": "57137233-0938-3ddb-9f79-5437939a13f3",
                                                "text": "Door stapsgewijs steeds andere groeibeïnvloedende hormonen aan de kweekvloeistof toe te voegen, zijn voor het eerst menselijke huidcellen tamelijk direct omgezet in levercellen."
                                            },
                                            {
                                                "example_id": "2c4807aa-b68c-4539-93ef-2db480b6e528",
                                                "sense_id": "57137233-0938-3ddb-9f79-5437939a13f3",
                                                "text": "Het aan de lopende band klonen van dieren werd lang voor onmogelijk gehouden. De kans dat het geknutsel met cellen misgaat, is normaal gesproken levensgroot, legt hoogleraar celbiologie Christine Mummery van de Leids Universitair Medisch Centrum uit. 'De eerste stap bij het kloonproces is dat je een volwassen huidcel neemt, in dit geval van de donorhond die je kloont.'"
                                            }
                                        ]
                                    }
                                ]
                            }
