{
    "word_family": [
        "conjugation",
        "conjugational",
        "conjugative",
        "conjugator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "416c27fe-0b57-3922-aa66-9ac162c3478d",
                    "sense_definition": "To give the different inflected forms of a verb according to tense, person, number, or mood.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every morning, our Spanish teacher asks us to <w>conjugate</w> regular verbs.",
                            "target_lang_translations": {
                                "zh": "每天早上，我们的西班牙语老师都会让我们对规则动词进行<w>变位</w>。"
                            }
                        },
                        {
                            "text": "Students often struggle to <w>conjugate</w> irregular forms in the past tense correctly.",
                            "target_lang_translations": {
                                "zh": "学生们常常难以正确完成过去时不规则形式的<w>变位</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inflect"
                    ],
                    "common_phrases": [
                        "conjugate a verb",
                        "conjugate irregular verbs"
                    ],
                    "target_lang_definitions": {
                        "zh": "（动词）根据时态、人称、数或语气等列出或改变动词的词形变化形式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "变位",
                                "target_lang_sense_clarification": "语法中动词根据人称、时态等发生形态变化"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfdf0aed-9c54-30e3-b045-00d233833c06",
                    "sense_definition": "To join together, combine, or unite two or more elements.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "join",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist tried to <w>conjugate</w> modern sculpture with classical architecture.",
                            "target_lang_translations": {
                                "zh": "这位艺术家试图将现代雕塑与古典建筑<w>结合</w>起来。"
                            }
                        },
                        {
                            "text": "In the chemical process, molecules <w>conjugate</w> to form a stable bond.",
                            "target_lang_translations": {
                                "zh": "在该化学过程中，分子相互<w>结合</w>形成稳定的键。"
                            }
                        }
                    ],
                    "synonyms": [
                        "combine",
                        "join",
                        "unite"
                    ],
                    "target_lang_definitions": {
                        "zh": "（使）结合；（使）成对；联合。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "结合",
                                "target_lang_sense_clarification": "使两个或多个事物联合或化合"
                            },
                            {
                                "target_lang_word": "联合",
                                "target_lang_sense_clarification": "结合在一起共同起作用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81d1cd28-00ec-3ce7-93ea-169c4640e5bf",
                    "sense_definition": "Of unicellular organisms, to undergo conjugation by temporarily uniting to exchange or transfer genetic material.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Under nutrient-deficient conditions, bacterial cells <w>conjugate</w> to exchange plasmids.",
                            "target_lang_translations": {
                                "zh": "在缺乏营养的条件下，细菌细胞会发生<w>接合</w>以交换质粒。"
                            }
                        },
                        {
                            "text": "Researchers observed protozoans as they began to <w>conjugate</w> under the microscope.",
                            "target_lang_translations": {
                                "zh": "研究人员在显微镜下观察了原生动物开始<w>接合</w>的过程。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（单细胞生物）接合，通过暂时结合交换或转移遗传物质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "接合",
                                "target_lang_sense_clarification": "生物学中细菌或原虫之间暂时结合交换遗传物质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3a1abb0-6d6c-3e08-a78b-80aace82a983",
                    "sense_definition": "To transform an element by multiplying it on the left by another element and on the right by its inverse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In group theory, we can <w>conjugate</w> an element using any invertible matrix.",
                            "target_lang_translations": {
                                "zh": "在群论中，我们可以利用任意可逆矩阵对一个元素作<w>共轭</w>变换。"
                            }
                        },
                        {
                            "text": "The professor showed how to <w>conjugate</w> a subgroup by an invertible element.",
                            "target_lang_translations": {
                                "zh": "教授展示了如何用一个可逆元素对子群进行<w>共轭</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（数学，群论）作共轭变换；通过左乘一元素及右乘其逆元来变换某元素。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "共轭",
                                "target_lang_sense_clarification": "数学中对群元素或子群施加共轭作用"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "06fbc101-6635-31a4-8676-1790427fd234",
                    "sense_definition": "Joined or coupled together in pairs; operating or acting jointly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "paired",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanical design relies on <w>conjugate</w> levers moving in perfect synchrony.",
                            "target_lang_translations": {
                                "zh": "该机械设计依赖于完美同步运动的<w>成对</w>杠杆。"
                            }
                        },
                        {
                            "text": "Engineers examined the <w>conjugate</w> motion of the two connecting rods.",
                            "target_lang_translations": {
                                "zh": "工程师们检查了两根连杆的<w>共轭</w>运动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coupled",
                        "paired"
                    ],
                    "antonyms": [
                        "dysconjugate"
                    ],
                    "target_lang_definitions": {
                        "zh": "成对的；联合的；协同动作的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "成对的",
                                "target_lang_sense_clarification": "两个一对协同运动或作用的"
                            },
                            {
                                "target_lang_word": "共轭的",
                                "target_lang_sense_clarification": "机械或物理中相互配合、联动的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4aa46ba3-828a-337c-b1a1-f401b695ab91",
                    "sense_definition": "Of lines, axes, or other quantities, having reciprocal or interrelated mathematical properties.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "math_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ellipse has two perpendicular axes, commonly referred to as <w>conjugate</w> diameters.",
                            "target_lang_translations": {
                                "zh": "该椭圆有两条互相垂直的轴，通常被称为<w>共轭</w>直径。"
                            }
                        },
                        {
                            "text": "We calculated the slope of the <w>conjugate</w> axis of the given hyperbola.",
                            "target_lang_translations": {
                                "zh": "我们计算了给定双曲线的<w>共轭</w>轴的斜率。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "conjugate axis",
                        "conjugate diameters"
                    ],
                    "target_lang_definitions": {
                        "zh": "（数学中直线、轴等）共轭的，具有互惠或相互关联的几何/代数性质的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "共轭的",
                                "target_lang_sense_clarification": "数学中具有互相关联性质的线或轴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03d2e891-1266-38b8-b76b-6e9572fa95e6",
                    "sense_definition": "Containing two or more chemical groups that act together as a single functional unit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chem_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The textbook explains how <w>conjugate</w> acids and bases interact in solutions.",
                            "target_lang_translations": {
                                "zh": "教科书解释了溶液中<w>共轭</w>酸碱是如何相互作用的。"
                            }
                        },
                        {
                            "text": "Chemists synthesized a <w>conjugate</w> protein that carries the targeted drug.",
                            "target_lang_translations": {
                                "zh": "化学家合成了一种携带靶向药物的<w>结合</w>蛋白。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "conjugate acid",
                        "conjugate base"
                    ],
                    "target_lang_definitions": {
                        "zh": "（化学/生物化学）共轭的；结合的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "共轭的",
                                "target_lang_sense_clarification": "如共轭酸碱、共轭体系"
                            },
                            {
                                "target_lang_word": "结合的",
                                "target_lang_sense_clarification": "如结合蛋白等由两部分结合而成的化合物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "053a2555-1c2d-3ce9-85e2-d9aaedc8854d",
                    "sense_definition": "Of words, sharing the same origin and derived from the same morphological root.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "etym_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Linguists observed that these two <w>conjugate</w> words descended from a single Latin term.",
                            "target_lang_translations": {
                                "zh": "语言学家观察到这两个<w>同源</w>词源自同一个拉丁词语。"
                            }
                        },
                        {
                            "text": "They studied <w>conjugate</w> vocabulary across several modern Romance languages.",
                            "target_lang_translations": {
                                "zh": "他们研究了几种现代罗曼语族语言中的<w>同源</w>词汇。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cognate"
                    ],
                    "target_lang_definitions": {
                        "zh": "（语言学，词语）同源的；同根派生的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "同源的",
                                "target_lang_sense_clarification": "源自同一个词根或原始形式的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5a37e163-e9db-324b-a7be-3dbb21e4349d",
                    "sense_definition": "A substance or entity created by joining two or more chemical or biological compounds.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vaccine was created as a protein <w>conjugate</w> to elicit a stronger immune response.",
                            "target_lang_translations": {
                                "zh": "该疫苗被制成蛋白质<w>结合物</w>，以引发更强的免疫反应。"
                            }
                        },
                        {
                            "text": "Researchers synthesized an antibody-drug <w>conjugate</w> to deliver medication directly to cancer cells.",
                            "target_lang_translations": {
                                "zh": "研究人员合成了一种抗体-药物<w>偶联物</w>，将药物直接递送到癌细胞中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compound"
                    ],
                    "common_phrases": [
                        "antibody-drug conjugate"
                    ],
                    "target_lang_definitions": {
                        "zh": "（化学/生物学）结合物；共轭物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "结合物",
                                "target_lang_sense_clarification": "由两种或以上物质偶联、结合而成的产物"
                            },
                            {
                                "target_lang_word": "偶联物",
                                "target_lang_sense_clarification": "生物化学中通过化学键偶联而成的复合分子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d0baf93-a582-3f1d-b3f7-75c6ba712799",
                    "sense_definition": "A number formed by changing the sign of the imaginary part of a given complex number.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "math_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To rationalize the denominator, multiply both top and bottom by the complex <w>conjugate</w>.",
                            "target_lang_translations": {
                                "zh": "为了实现分母有理化，分子分母应同时乘以该复数的<w>共轭复数</w>。"
                            }
                        },
                        {
                            "text": "The <w>conjugate</w> of three plus four i is simply three minus four i.",
                            "target_lang_translations": {
                                "zh": "3 + 4i 的<w>共轭复数</w>就是 3 - 4i。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "complex conjugate"
                    ],
                    "target_lang_definitions": {
                        "zh": "（数学）共轭复数；共轭数。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "共轭复数",
                                "target_lang_sense_clarification": "实部相同虚部相反的复数"
                            },
                            {
                                "target_lang_word": "共轭",
                                "target_lang_sense_clarification": "数学中复数的共轭元"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7001226f-57d2-341c-8a08-a8cbd0057954",
                    "sense_definition": "Any of a set of irrational or complex roots of a polynomial with integer coefficients.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "math_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every irrational root of this quadratic equation has an algebraic <w>conjugate</w>.",
                            "target_lang_translations": {
                                "zh": "该二次方程的每一个无理根都有一个代数<w>共轭根</w>。"
                            }
                        },
                        {
                            "text": "The theorem states that complex roots must occur along with their <w>conjugates</w>.",
                            "target_lang_translations": {
                                "zh": "该定理指出复数根必须与其<w>共轭根</w>成对出现。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（代数）共轭根，整系数多项式的成对无理根或复数根。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "共轭根",
                                "target_lang_sense_clarification": "多项式方程对应的共轭形式的根"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4972850d-fd29-3c11-842a-a5dfc3c4fe8c",
                    "sense_definition": "A word derived from the same source as another word and closely related to it in meaning.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ling_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In philosophical logic, terms that share an etymological stem are treated as <w>conjugates</w>.",
                            "target_lang_translations": {
                                "zh": "在哲学逻辑中，共享同一词源词干的术语被视为<w>同根词</w>。"
                            }
                        },
                        {
                            "text": "The grammarian identified each paired <w>conjugate</w> in the classical passage.",
                            "target_lang_translations": {
                                "zh": "这位语法学家指出了这篇古典文章中每一组配对的<w>同根词</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cognate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically in logic and grammar"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古/语言学）同根词；同源词。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "同根词",
                                "target_lang_sense_clarification": "源自同一词根且意义相关的词"
                            },
                            {
                                "target_lang_word": "同源词",
                                "target_lang_sense_clarification": "具有共同词源的词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a74b4bc-8516-313c-8a36-1d4f0b6b0bba",
                    "sense_definition": "An angle that, when added to a given angle, equals 360 degrees.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "math_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>conjugate</w> of an angle measuring sixty degrees is three hundred degrees.",
                            "target_lang_translations": {
                                "zh": "一个六十度角的<w>周角补角</w>是三百度。"
                            }
                        },
                        {
                            "text": "Students learned to find the <w>conjugate</w> by subtracting the given angle from a full turn.",
                            "target_lang_translations": {
                                "zh": "学生们学会了用整周角减去已知角来求出它的<w>周角补角</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "explement"
                    ],
                    "common_phrases": [
                        "conjugate angle"
                    ],
                    "target_lang_definitions": {
                        "zh": "（几何）周角补角，与已知角相加等于360度的角。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "周角补角",
                                "target_lang_sense_clarification": "与给定角之和为360度的角"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}