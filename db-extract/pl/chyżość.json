                "translations": [
                    {
                        "translation_id": "7343d866-38c7-4c24-bf6c-54985017689a",
                        "source_entry_id": "bf5777b9-b074-344d-96d5-acb8d8de15f4",
                        "source_sense_id": "ec9bc2de-80c0-32b0-8cec-8f3b56445d03",
                        "target_lang_word": "celerity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "celerity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "713b7e30-bd4f-306f-bb1a-031bfbf4f09d",
                                        "entry_id": "c002ec79-2acd-3b55-99a8-09030c1122c4",
                                        "glosses": [
                                            "Speed, swiftness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f87ca03-b2dd-4ad1-b189-283dd1819f98",
                                                "sense_id": "713b7e30-bd4f-306f-bb1a-031bfbf4f09d",
                                                "text": "O most kind maid, / It was the swift celerity of his death, / Which I did think with slower foot came on, / That brain'd my purpose."
                                            },
                                            {
                                                "example_id": "cbc1f022-19af-489b-96b6-cc3a5225eccb",
                                                "sense_id": "713b7e30-bd4f-306f-bb1a-031bfbf4f09d",
                                                "text": "...when a new medium for attraction was started in the bazaar to which we have alluded, and her letter was dispatched with all possible celerity, insisting that her daughters \"should work day and night\"—so ran the document—for three weeks,..."
                                            },
                                            {
                                                "example_id": "7f687bbc-88a7-4651-9938-7d4cfc51c9e4",
                                                "sense_id": "713b7e30-bd4f-306f-bb1a-031bfbf4f09d",
                                                "text": "The phantoms, for so they then seemed, were flitting on the other side of the deck, and, with a noiseless celerity, were casting loose the tackles and bands of the boat which swung there."
                                            },
                                            {
                                                "example_id": "d87ac6de-cbaa-494e-9843-efeefff442b9",
                                                "sense_id": "713b7e30-bd4f-306f-bb1a-031bfbf4f09d",
                                                "text": "Warning messages were relayed to the signalmen at Slough East and Dolphin Junction boxes with such celerity that the up main signals were replaced to danger in front of the express before it finally stopped. The signalman at Dolphin Junction just had time to replace the down main signals and pull the emergency lever to lay detonators in front of the fast approaching 7 p.m. Paddington-Reading train."
                                            },
                                            {
                                                "example_id": "668a84f1-e023-45de-96ce-088b5871f3bc",
                                                "sense_id": "713b7e30-bd4f-306f-bb1a-031bfbf4f09d",
                                                "text": "The celerity of executions is a generally neglected issue in the empirical literature on deterrence and capital punishment."
                                            },
                                            {
                                                "example_id": "acb941ec-ac06-45e6-a560-7fdca4629210",
                                                "sense_id": "713b7e30-bd4f-306f-bb1a-031bfbf4f09d",
                                                "text": "As of 2006, celerity has disappeared entirely from the deterrence equation among both high- and low-volume executing jurisdictions."
                                            },
                                            {
                                                "example_id": "95e72dcf-3aba-4607-a084-4a17b7bc98e5",
                                                "sense_id": "713b7e30-bd4f-306f-bb1a-031bfbf4f09d",
                                                "text": "When Churchill and Roosevelt were considering their declaration of the Atlantic Charter, it was Attlee, acting with a celerity and a clarity of purpose that belied his reputation for caution, who insisted on including “freedom from want” as one of its aims, making economic rights and, with them, a decent life for all, one of the official aims of the war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58f5668c-0079-31fb-a525-5c6f60deadcd",
                                        "entry_id": "c002ec79-2acd-3b55-99a8-09030c1122c4",
                                        "glosses": [
                                            "The speed of an individual wave (as opposed to the speed of groups of waves); often denoted c."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04c4c2ab-d766-306a-ba88-b7f95d8a55d4",
                                        "entry_id": "c002ec79-2acd-3b55-99a8-09030c1122c4",
                                        "glosses": [
                                            "The speed of an individual wave (as opposed to the speed of groups of waves); often denoted c.",
                                            "The speed with which a perturbation to the flow propagates through the flow domain."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10387c8e-55d5-3f0e-8905-291bd37fd623",
                                        "entry_id": "c002ec79-2acd-3b55-99a8-09030c1122c4",
                                        "glosses": [
                                            "The speed of symbol transmission, now called baud rate."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9e8bb9e-653c-4acd-96c7-d6cf688547f8",
                                                "sense_id": "10387c8e-55d5-3f0e-8905-291bd37fd623",
                                                "text": "Celerity of dispatching the Chappe telegraph [section title]"
                                            },
                                            {
                                                "example_id": "cc96d52d-504c-455d-b5b5-f3bc77a19736",
                                                "sense_id": "10387c8e-55d5-3f0e-8905-291bd37fd623",
                                                "text": "...and many endeavours have been made, not only to transmit signals with celerity, but also to transmit more than one communication at the same time along the same wire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2fe2f4c-7587-487f-b032-accf3362128d",
                        "source_entry_id": "bf5777b9-b074-344d-96d5-acb8d8de15f4",
