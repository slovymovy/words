{
    "word_family": [
        "odwiedziny",
        "odwiedzający",
        "odwiedzenie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dea3e936-932c-3c9f-a66d-ce333d72bd6d",
                    "sense_definition": "przybyć do kogoś z wizytą",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wizyta",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wczoraj <w>odwiedziłem</w> moich dziadków i zjedliśmy razem obiad.",
                            "target_lang_translations": {
                                "ru": "Вчера я <w>навестил</w> бабушку с дедушкой, и мы пообедали вместе."
                            }
                        },
                        {
                            "text": "Jutro na pewno <w>odwiedzimy</w> chorego kolegę w szpitalu.",
                            "target_lang_translations": {
                                "ru": "Завтра мы обязательно <w>навестим</w> больного коллегу в больнице."
                            }
                        }
                    ],
                    "common_phrases": [
                        "odwiedzić znajomych",
                        "odwiedzić chorego",
                        "odwiedzić rodzinę"
                    ],
                    "target_lang_definitions": {
                        "ru": "прийти или приехать к кому-либо в гости, с визитом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "навестить",
                                "target_lang_sense_clarification": "прийти к кому-либо с визитом, проведать"
                            },
                            {
                                "target_lang_word": "посетить",
                                "target_lang_sense_clarification": "нанести визит человеку"
                            },
                            {
                                "target_lang_word": "проведать",
                                "target_lang_sense_clarification": "навестить, узнать, как дела (часто о больных или пожилых)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1f62ab7-8a12-3375-adb5-cf72f4dcd462",
                    "sense_definition": "udać się w jakieś miejsce w celu zwiedzenia lub załatwienia sprawy",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wizyta",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas wakacji w Krakowie <w>odwiedziliśmy</w> słynne muzeum na rynku.",
                            "target_lang_translations": {
                                "ru": "Во время каникул в Кракове мы <w>посетили</w> знаменитый музей на Рыночной площади."
                            }
                        },
                        {
                            "text": "Zanim kupisz nowe zwierzę, musisz <w>odwiedzić</w> weterynarza.",
                            "target_lang_translations": {
                                "ru": "Прежде чем заводить нового питомца, тебе нужно <w>сходить к</w> ветеринару."
                            }
                        }
                    ],
                    "common_phrases": [
                        "odwiedzić muzeum",
                        "odwiedzić wystawę",
                        "odwiedzić miasto"
                    ],
                    "target_lang_definitions": {
                        "ru": "побывать в каком-либо месте с целью осмотра или по делу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посетить",
                                "target_lang_sense_clarification": "побывать в каком-либо месте, учреждении"
                            },
                            {
                                "target_lang_word": "сходить",
                                "target_lang_sense_clarification": "посетить учреждение или специалиста"
                            },
                            {
                                "target_lang_word": "побывать",
                                "target_lang_sense_clarification": "съездить или сходить в какое-либо место"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41410045-1ef2-30c8-809b-4cabc2d90c8a",
                    "sense_definition": "otworzyć witrynę lub stronę internetową",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "internet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jeśli szukasz więcej informacji, powinieneś <w>odwiedzić</w> naszą oficjalną stronę.",
                            "target_lang_translations": {
                                "ru": "Если вы ищете больше информации, вам стоит <w>посетить</w> наш официальный сайт."
                            }
                        },
                        {
                            "text": "Tę nową witrynę internetową <w>odwiedziło</w> już kilka tysięcy użytkowników.",
                            "target_lang_translations": {
                                "ru": "Этот новый сайт <w>посетили</w> уже несколько тысяч пользователей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "odwiedzić stronę",
                        "odwiedzić witrynę"
                    ],
                    "target_lang_definitions": {
                        "ru": "зайти на веб-сайт или интернет-страницу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посетить",
                                "target_lang_sense_clarification": "зайти на сайт или интернет-страницу"
                            },
                            {
                                "target_lang_word": "зайти",
                                "target_lang_sense_clarification": "открыть веб-страницу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bd279b4-3591-3691-b5cf-7744c7555afa",
                    "sense_definition": "złożyć sobie nawzajem wizytę",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wizyta",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dawno się nie widzieliśmy, więc postanowiliśmy, że w końcu się <w>odwiedzimy</w>.",
                            "target_lang_translations": {
                                "ru": "Мы давно не виделись, поэтому решили, что наконец-то <w>навестим друг друга</w>."
                            }
                        },
                        {
                            "text": "Sąsiedzi po powrocie z długich wakacji wreszcie się <w>odwiedzili</w>.",
                            "target_lang_translations": {
                                "ru": "Соседи после возвращения из долгого отпуска наконец-то <w>сходили друг к другу в гости</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "навестить друг друга, сходить друг к другу в гости"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "навестить друг друга",
                                "target_lang_sense_clarification": "сходить друг к другу в гости"
                            },
                            {
                                "target_lang_word": "повидаться",
                                "target_lang_sense_clarification": "встретиться, навестив друг друга"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}