                                        "glosses": [
                                            "erster Tag des neuen Jahres, Feiertag, 1. Januar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b723de56-5889-48f8-a03c-5b4c26b23cbb",
                                                "sense_id": "8132b1e8-482a-386a-80a1-cd83e28c0047",
                                                "text": "Meist schläft man Neujahr nach einer langen Nacht auch lange aus."
                                            },
                                            {
                                                "example_id": "ea1a68ae-07ec-4b27-988d-9fa681bacf04",
                                                "sense_id": "8132b1e8-482a-386a-80a1-cd83e28c0047",
                                                "text": "„Drei Tage nach Neujahr beraumte Hitler eine große Lagebesprechung mit Feldmarschall Keitel, Reichsleiter Bormann und Reichspropagandaminister Goebbels an.“"
                                            },
                                            {
                                                "example_id": "f7615b77-c60c-422c-888b-68a2627a96b8",
                                                "sense_id": "8132b1e8-482a-386a-80a1-cd83e28c0047",
                                                "text": "„Dafür nahm ich den Schuldschein an mich, in dem sie sich verpflichtete, mir den Betrag zu Neujahr zurückzuzahlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
