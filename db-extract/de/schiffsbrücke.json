                ],
                "senses": [
                    {
                        "sense_id": "7b81a3e5-7029-36b2-adcf-44463a94445d",
                        "entry_id": "a3ade4b6-81c4-3c4e-966b-6e9e5718cc40",
                        "glosses": [
                            "Brücke aus Schwimmkörpern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a285aea-6ee0-4e7c-a17c-8b8d5656b28b",
                                "sense_id": "7b81a3e5-7029-36b2-adcf-44463a94445d",
                                "text": "„Im Ganzen jedoch wurde diese Schiffsbrücke ein gewaltiges Defizitunternehmen."
                            },
                            {
                                "example_id": "f60685ba-4e4e-413f-a6ab-07c32d9a9472",
                                "sense_id": "7b81a3e5-7029-36b2-adcf-44463a94445d",
                                "text": "„1819 wurde die »Schiffsbrücke« als Verbindung zwischen Koblenz und Ehrenbreitstein geschaffen.“"
                            },
                            {
                                "example_id": "251de858-52e3-4b1d-bc7a-2413fd52114c",
                                "sense_id": "7b81a3e5-7029-36b2-adcf-44463a94445d",
                                "text": "„Bei sommerlicher Witterung war der Rhein leicht über eine Schiffsbrücke zu passieren, die etwas südöstlich der heutigen Theodor-Heuss-Brücke von Kastel zum Mainzer Brückentor führte.“"
                            },
                            {
                                "example_id": "a74ba3de-e5e1-4bce-bc85-52f423029218",
                                "sense_id": "7b81a3e5-7029-36b2-adcf-44463a94445d",
                                "text": "„An einer Schiffsbrücke reichte er, in Ermangelung der fälligen Abgabe, dem Wärter ein seidenes Taschentuch, eilte auf die Brücke und sprang in das kalte Wasser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
