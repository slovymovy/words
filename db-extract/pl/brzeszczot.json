                                        "entry_id": "476ed076-412e-3be9-9270-c7b2bc0a640b",
                                        "glosses": [
                                            "To put forth or have a blade."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37770487-d4cc-4227-a72f-b09b6a3281df",
                                                "sense_id": "134018ca-9c9c-358d-8e29-c0dcca20bb64",
                                                "text": "As sweet a plant, as fair a flower, is faded / As ever in the Muses' garden bladed."
                                            }
