        "fr-extract.jsonl": [
            {
                "entry_id": "8468bc78-18cc-3f20-8702-460d4c99f0c5",
                "word": "meeting",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3d9d1322-6945-43ee-961a-4056275f215c",
                        "entry_id": "8468bc78-18cc-3f20-8702-460d4c99f0c5",
                        "tags": [
                            "plural"
                        ],
                        "form": "meetings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9edee5f-4ec8-3a42-878f-01531da0b2e8",
                        "entry_id": "8468bc78-18cc-3f20-8702-460d4c99f0c5",
                        "glosses": [
                            "Réunion ou assemblée publique."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "fdaf4ad9-b6aa-4deb-b7df-bf754fc262bc",
                                "sense_id": "d9edee5f-4ec8-3a42-878f-01531da0b2e8",
                                "text": "Le 22, au point du jour, la cité entière, entassée sur les quais du port et sur les côtes voisines, guettait d'un œil avide et colère le steamer qui amenait à Copenhague la députation du meeting de Rendsbourg."
                            },
                            {
                                "example_id": "b343a91f-dc73-4638-a81d-1c9b335f0b2b",
                                "sense_id": "d9edee5f-4ec8-3a42-878f-01531da0b2e8",
                                "text": "Si les deux milliards d'habitants qui peuplent la Terre se tenaient debout et un peu serrés, comme pour un meeting, ils logeraient aisément sur une place publique de vingt milles de long sur vingt milles de large."
                            },
                            {
                                "example_id": "cea0bbae-8956-42fc-afb3-290caab0bf26",
                                "sense_id": "d9edee5f-4ec8-3a42-878f-01531da0b2e8",
                                "text": "Shinzo Abe, 67 ans, était en train de tenir un discours en fin de matinée lors d’un meeting électoral organisé sur un carrefour près d’une gare à Nara (ouest du Japon) avant des élections sénatoriales demain dans le pays."
                            },
                            {
                                "example_id": "d03d708c-3169-4291-9f50-f08af87d1f63",
                                "sense_id": "d9edee5f-4ec8-3a42-878f-01531da0b2e8",
                                "text": "Dans le climat tendu de la campagne de 2017, les meetings de la candidate FN ne sont pas les seuls visés par ces opérations de contre-meetings : les « casserolades » organisées à l'entrée des rassemblements de François Fillon relèvent de cette même logique de confrontation directe par des obstructions sonores, voire des violences physiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "d04373c4-ee23-354d-b394-0fe6e8bc8e20",
                        "entry_id": "8468bc78-18cc-3f20-8702-460d4c99f0c5",
                        "glosses": [
                            "Ensemble de réunions d'une même discipline organisées sur un hippodrome, se déroulant sur une période de plusieurs semaines."
                        ],
                        "tags": [
                            "Sports hippiques"
                        ],
                        "examples": [
                            {
                                "example_id": "aaf0065d-ae1b-45f2-aa4c-6aa63a24f0cc",
                                "sense_id": "d04373c4-ee23-354d-b394-0fe6e8bc8e20",
                                "text": "le meeting d'hiver de Vincennes"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aac10492-d94a-4237-9e81-54857b4845fd",
                        "source_entry_id": "8468bc78-18cc-3f20-8702-460d4c99f0c5",
                        "target_lang_word": "(political) rally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7543c293-af2a-45e1-a7c7-e4b0bbdf2f41",
                        "source_entry_id": "8468bc78-18cc-3f20-8702-460d4c99f0c5",
                        "target_lang_word": "vergadering",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vergadering",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "31715bd1-213e-3336-b490-f114637e8b76",
                                        "entry_id": "48fb0495-e0b4-32e4-b991-d340a5ba0676",
                                        "glosses": [
                                            "een georganiseerde bijeenkomst voor bespreking en overleg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34f1bbb5-e278-4da1-a07f-fbbe89229212",
                                                "sense_id": "31715bd1-213e-3336-b490-f114637e8b76",
                                                "text": "Door zijn toedoen ging de vergadering een half uur later van start."
                                            },
                                            {
                                                "example_id": "b173cf19-f1e2-4610-8d45-58873a9feba4",
                                                "sense_id": "31715bd1-213e-3336-b490-f114637e8b76",
                                                "text": "‘Ik woon in Maastricht en werk in Den Haag. Gisteren hadden we tot laat een vergadering in Utrecht en daarna heb ik in een hotel overnacht. Nu wil ik naar huis. Dat kan gelukkig gewoon, ondanks de genomen maatregelen, de treinen rijden."
                                            },
                                            {
                                                "example_id": "4aabf5f5-8589-4792-bc84-a3b5220b6e10",
                                                "sense_id": "31715bd1-213e-3336-b490-f114637e8b76",
                                                "text": "Maar na een week in de woestijn en 5.000 dollar lichter, zit je vaak gewoon weer op maandagochtend op kantoor in een vergadering over targets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11c422ed-3beb-425a-bc3f-e4138530f7aa",
                        "source_entry_id": "8468bc78-18cc-3f20-8702-460d4c99f0c5",
                        "target_lang_word": "meeting",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meeting",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c60eab40-3f56-3f82-9403-08174af9a625",
                                        "entry_id": "9f7bce0b-eaed-304c-a32b-e6e64eb02c01",
                                        "glosses": [
                                            "een bijeenkomst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92a79b19-b405-4521-a19e-a6c96c1bb26a",
                                                "sense_id": "c60eab40-3f56-3f82-9403-08174af9a625",
                                                "text": "Er was een meeting gepland om te praten over de fusie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7634e1d2-fdc2-4d27-b564-580c19e9491a",
                        "source_entry_id": "8468bc78-18cc-3f20-8702-460d4c99f0c5",
                        "target_lang_word": "митинг",
