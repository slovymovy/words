    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3c89eb69-36f9-37bd-b5ed-a4e6cf0d536e",
                    "sense_definition": "Unir, raccorder ou mettre en communication des lieux, des choses ou des personnes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "connexion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle ligne de train va <w>relier</w> les deux grandes métropoles en moins d'une heure."
                        },
                        {
                            "text": "Un grand pont suspendu <w>relie</w> les deux rives du fleuve depuis plusieurs décennies."
                        }
                    ],
                    "synonyms": [
                        "connecter",
                        "joindre",
                        "raccorder",
                        "unir"
                    ],
                    "common_phrases": [
                        "relier deux points",
                        "relier les rives",
                        "relier des villes"
                    ]
                },
                {
                    "sense_id": "00283135-00b5-31ea-a8a4-1f1720c29298",
                    "sense_definition": "Assembler et coudre les cahiers d'un livre pour les fixer dans une couverture rigide ou souple.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "livre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan a choisi de <w>relier</w> ce précieux manuscrit du dix-huitième siècle avec du cuir ancien."
                        },
                        {
                            "text": "L'étudiant fait <w>relier</w> sa thèse avant de la soumettre aux membres du jury."
                        }
                    ],
                    "synonyms": [
                        "brocher"
                    ],
                    "antonyms": [
                        "dérelier"
                    ],
                    "common_phrases": [
                        "faire relier",
                        "relier en cuir",
                        "relier un livre"
                    ]
                },
                {
                    "sense_id": "d14e97e9-d171-3506-aeb7-380722d8b047",
                    "sense_definition": "Attacher ou lier de nouveau ce qui a été dénoué ou défait.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "attache",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fermier doit <w>relier</w> chaque botte de paille défaite avant le coucher du soleil."
                        },
                        {
                            "text": "La corde s'étant rompue lors du transport, il a fallu <w>relier</w> le chargement solidement."
                        }
                    ],
                    "synonyms": [
                        "rattacher",
                        "renouer"
                    ],
                    "common_phrases": [
                        "relier une botte"
                    ]
                },
                {
                    "sense_id": "74d61d15-0752-3a41-9390-518bdcf2261e",
                    "sense_definition": "Garnir ou entourer une barrique, une cuve ou un tonneau de nouveaux cercles de bois ou de métal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tonnellerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tonnelier s'active pour <w>relier</w> les barriques neuves avant le début de la récolte."
                        },
                        {
                            "text": "Il est indispensable de <w>relier</w> les tonneaux abîmés pour éviter toute fuite de vin."
                        }
                    ],
                    "synonyms": [
                        "cercler"
                    ],
                    "common_phrases": [
                        "relier un tonneau"
                    ]
                }
            ]
        }
    ]
