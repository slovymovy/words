{
    "word_family": [
        "alphabet",
        "alphabetical",
        "alphanumeric",
        "alphabetize"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c230967f-66c5-3a9b-a8b4-dcadcd51241e",
                    "sense_definition": "A person or animal that is dominant, assertive, and holds the highest rank in a group.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "dominance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>alpha</w> of the wolf pack always eats before the others.",
                            "target_lang_translations": {
                                "ru": "<w>Вожак</w> волчьей стаи всегда ест раньше остальных.",
                                "zh": "狼群的<w>首领</w>总是先于其他成员进食。"
                            }
                        },
                        {
                            "text": "He acts like an <w>alpha</w> in the office to impress his boss.",
                            "target_lang_translations": {
                                "ru": "Он ведет себя как <w>альфа</w> в офисе, чтобы впечатлить начальника.",
                                "zh": "他在办公室表现得像个<w>强者</w>，以给老板留下深刻印象。"
                            }
                        }
                    ],
                    "antonyms": [
                        "beta"
                    ],
                    "common_phrases": [
                        "alpha male",
                        "alpha female"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in social contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Особи или люди, занимающие доминирующее положение и высший ранг в группе.",
                        "zh": "指在群体中占据统治地位、自信且排名最高的人或动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "альфа",
                                "target_lang_sense_clarification": "разговорное, сокращение от альфа-самец/самка"
                            },
                            {
                                "target_lang_word": "вожак",
                                "target_lang_sense_clarification": "о животных"
                            },
                            {
                                "target_lang_word": "альфа-самец",
                                "target_lang_sense_clarification": "о мужчине или самце"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "首领",
                                "target_lang_sense_clarification": "指动物群体中的领袖"
                            },
                            {
                                "target_lang_word": "强势的",
                                "target_lang_sense_clarification": "形容人的性格或行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e5bbd0c-4b78-347d-9354-f8e8923f1944",
                    "sense_definition": "The first letter of the Greek alphabet (Α, α), often used as a symbol in mathematics and science.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students learned the Greek alphabet starting with <w>alpha</w>.",
                            "target_lang_translations": {
                                "ru": "Студенты учили греческий алфавит, начиная с <w>альфы</w>.",
                                "zh": "学生们从<w>阿尔法</w>开始学习希腊字母表。"
                            }
                        },
                        {
                            "text": "The value of <w>alpha</w> in this equation represents the angle.",
                            "target_lang_translations": {
                                "ru": "Значение <w>альфы</w> в этом уравнении обозначает угол.",
                                "zh": "方程中<w>阿尔法</w>的值代表角度。"
                            }
                        }
                    ],
                    "antonyms": [
                        "omega"
                    ],
                    "common_phrases": [
                        "alpha and omega"
                    ],
                    "target_lang_definitions": {
                        "ru": "Первая буква греческого алфавита (Α, α), часто используемая как символ в математике и науке.",
                        "zh": "希腊字母表的第一个字母（Α, α），常用于数学和科学中的符号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "альфа",
                                "target_lang_sense_clarification": "буква"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿尔法",
                                "target_lang_sense_clarification": "希腊字母名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e7fc133-fd95-3cfe-a9fd-2cde9dcefec7",
                    "sense_definition": "An early version of a software program, usually tested internally by developers before being released to external users.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The game is still in <w>alpha</w>, so it has many bugs.",
                            "target_lang_translations": {
                                "ru": "Игра все еще находится в стадии <w>альфы</w>, поэтому в ней много ошибок.",
                                "zh": "这款游戏仍处于<w>阿尔法版本</w>，所以有很多漏洞。"
                            }
                        },
                        {
                            "text": "They released the <w>alpha</w> to a small team for initial testing.",
                            "target_lang_translations": {
                                "ru": "Они выпустили <w>альфу</w> для небольшой команды для начального тестирования.",
                                "zh": "他们将<w>阿尔法版本</w>发布给了一个小团队进行初步测试。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in alpha",
                        "alpha version"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ранняя версия программного обеспечения, обычно тестируемая разработчиками перед выпуском для внешних пользователей.",
                        "zh": "软件程序的早期版本，通常在发布给外部用户之前由开发人员进行内部测试。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "альфа-версия",
                                "target_lang_sense_clarification": "полный термин"
                            },
                            {
                                "target_lang_word": "альфа",
                                "target_lang_sense_clarification": "компьютерный жаргон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿尔法版本",
                                "target_lang_sense_clarification": "软件开发术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5186ce6c-a2b0-31b6-88fa-8c004cc15ede",
                    "sense_definition": "A person belonging to the demographic cohort succeeding Generation Z, typically born from the early 2010s to the mid-2020s.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "generation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marketers are creating new strategies to reach the young <w>Alphas</w>.",
                            "target_lang_translations": {
                                "ru": "Маркетологи создают новые стратегии, чтобы охватить молодых <w>альф</w>.",
                                "zh": "营销人员正在制定新策略以触达年轻的<w>阿尔法世代</w>。"
                            }
                        },
                        {
                            "text": "My nephew is an <w>Alpha</w> who has used tablets since he was a toddler.",
                            "target_lang_translations": {
                                "ru": "Мой племянник — <w>альфа</w>, который пользуется планшетами с тех пор, как научился ходить.",
                                "zh": "我的侄子是<w>阿尔法世代</w>的一员，他从蹒跚学步起就开始使用平板电脑了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Gen Alpha",
                        "Generation Alpha"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, принадлежащий к демографической когорте, следующей за поколением Z, обычно родившийся с начала 2010-х до середины 2020-х годов.",
                        "zh": "指继Z世代之后的人口群体，通常出生于2010年代初至2020年代中期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "альфа",
                                "target_lang_sense_clarification": "представитель поколения"
                            },
                            {
                                "target_lang_word": "поколение альфа",
                                "target_lang_sense_clarification": "название группы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿尔法世代",
                                "target_lang_sense_clarification": "人口统计学代际名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80d8ba4f-e3cd-3249-9fa2-c65625209043",
                    "sense_definition": "A measure of the return on an investment over and above the market return, used to gauge performance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fund manager is famous for generating high <w>alpha</w> for his clients.",
                            "target_lang_translations": {
                                "ru": "Управляющий фондом известен тем, что генерирует высокую <w>альфу</w> для своих клиентов.",
                                "zh": "这位基金经理以能为客户创造高<w>阿尔法系数</w>而闻名。"
                            }
                        },
                        {
                            "text": "Investors are constantly looking for <w>alpha</w> in a volatile market.",
                            "target_lang_translations": {
                                "ru": "Инвесторы постоянно ищут <w>альфу</w> на нестабильном рынке.",
                                "zh": "投资者在动荡的市场中不断寻找<w>阿尔法系数</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Показатель доходности инвестиций, превышающий рыночную доходность, используемый для оценки эффективности.",
                        "zh": "衡量投资回报超过市场回报的指标，用于评估投资表现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "альфа",
                                "target_lang_sense_clarification": "финансовый термин"
                            },
                            {
                                "target_lang_word": "альфа-коэффициент",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿尔法系数",
                                "target_lang_sense_clarification": "金融投资术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3d84bfc4-d36c-35aa-9b44-5f8449e51967",
                    "sense_definition": "Having the characteristics of a dominant leader; confident, assertive, and socially powerful.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "dominance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a very <w>alpha</w> personality and naturally takes charge of the team.",
                            "target_lang_translations": {
                                "ru": "У нее очень <w>доминантный</w> характер, и она естественно берет на себя руководство командой.",
                                "zh": "她有着非常<w>支配性</w>的性格，自然而然地接管了团队。"
                            }
                        },
                        {
                            "text": "His <w>alpha</w> behavior can sometimes be intimidating to new employees.",
                            "target_lang_translations": {
                                "ru": "Его поведение <w>альфы</w> иногда может пугать новых сотрудников.",
                                "zh": "他那种<w>强势</w>的行为有时会让新员工感到畏惧。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "alpha male"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий характеристиками доминирующего лидера; уверенный в себе, напористый и социально влиятельный.",
                        "zh": "具有支配型领导者的特征；自信、果断且具有社会影响力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доминантный",
                                "target_lang_sense_clarification": "о характере"
                            },
                            {
                                "target_lang_word": "альфа-",
                                "target_lang_sense_clarification": "первая часть сложных слов (напр. альфа-личность)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "支配性的",
                                "target_lang_sense_clarification": "形容性格或行为"
                            },
                            {
                                "target_lang_word": "强势的",
                                "target_lang_sense_clarification": "形容人的领导风格"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffafb1d5-2eba-376e-84ec-1929ab9ff345",
                    "sense_definition": "Relating to alphabetical order.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please sort these files in <w>alpha</w> order for easier access.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, отсортируйте эти файлы в <w>алфавитном</w> порядке для облегчения доступа.",
                                "zh": "请按<w>字母顺序</w>排列这些文件，以便于查阅。"
                            }
                        },
                        {
                            "text": "The list was arranged by <w>alpha</w> sequence rather than by date.",
                            "target_lang_translations": {
                                "ru": "Список был составлен в <w>алфавитной</w> последовательности, а не по дате.",
                                "zh": "这份名单是按<w>字母顺序</w>而非日期排列的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "alpha order"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "clipping of alphabetical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к алфавитному порядку.",
                        "zh": "与字母顺序有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "алфавитный",
                                "target_lang_sense_clarification": "о порядке сортировки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "字母顺序的",
                                "target_lang_sense_clarification": "指排序方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
