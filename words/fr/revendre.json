                        "revendre à perte",
                        "acheter pour revendre"
                    ]
                },
                {
                    "sense_id": "a9142b22-0132-394f-b4a6-a578077065e2",
                    "sense_definition": "Vendre de nouveau une chose dont la transaction précédente a échoué ou a été annulée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le premier acquéreur s'étant rétracté au dernier moment, nous devons <w>revendre</w> l'appartement."
                        },
                        {
                            "text": "L'acheteur n'ayant jamais payé la somme due, le tribunal a ordonné de <w>revendre</w> la propriété."
