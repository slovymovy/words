{
    "word_family": [
        "надпись",
        "надстройка",
        "надземный",
        "надзор"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "aff5bcb3-8f87-3584-8dd0-7d75c4eb7e13",
                    "sense_definition": "Обозначает нахождение выше, поверх кого-либо или чего-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "spatial_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Огромная туча нависла прямо <w>над</w> нашим домом.",
                            "target_lang_translations": {
                                "en": "A huge cloud hung right <w>over</w> our house.",
                                "zh": "一大片乌云正悬挂<w>在</w>我们房子<w>上方</w>。"
                            }
                        },
                        {
                            "text": "Самолёт пролетел <w>над</w> городом и скрылся в облаках.",
                            "target_lang_translations": {
                                "en": "The plane flew <w>over</w> the city and disappeared into the clouds.",
                                "zh": "飞机从城市上空飞过，消失在云层中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "выше"
                    ],
                    "antonyms": [
                        "под",
                        "подо"
                    ],
                    "common_phrases": [
                        "над головой",
                        "над уровнем моря",
                        "над землёй"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates a position higher than or directly above someone or something.",
                        "zh": "表示位于某人或某物之上或上方。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "over",
                                "target_lang_sense_clarification": "spatial position or movement above"
                            },
                            {
                                "target_lang_word": "above",
                                "target_lang_sense_clarification": "at a higher level than"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在……上",
                                "target_lang_sense_clarification": "表示空间位置或移动在某物上方"
                            },
                            {
                                "target_lang_word": "高于",
                                "target_lang_sense_clarification": "表示处于比某物更高的水平"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05dc3083-8aaf-3828-8a14-91e6d0321d20",
                    "sense_definition": "Указывает на объект, на который направлено действие (работа, смех, победа, контроль).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студент усердно трудился <w>над</w> сложным докладом.",
                            "target_lang_translations": {
                                "en": "The student worked hard <w>on</w> the complex report.",
                                "zh": "学生正在努力<w>进行</w>一份复杂的报告。"
                            }
                        },
                        {
                            "text": "Не стоит смеяться <w>над</w> чужими неудачами.",
                            "target_lang_translations": {
                                "en": "One shouldn't laugh <w>at</w> others' failures.",
                                "zh": "不应该<w>嘲笑</w>别人的失败。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "работать над собой",
                        "победа над врагом",
                        "смеяться над шуткой"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to indicate the object of specific actions, such as working, laughing, or exercising power.",
                        "zh": "用于指示特定动作的对象，例如工作、嘲笑或行使权力。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "on",
                                "target_lang_sense_clarification": "used with work, labor, or effort"
                            },
                            {
                                "target_lang_word": "at",
                                "target_lang_sense_clarification": "used with laughing, mocking, or scoffing"
                            },
                            {
                                "target_lang_word": "over",
                                "target_lang_sense_clarification": "used with victory, control, or superiority"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "进行",
                                "target_lang_sense_clarification": "用于表示针对某项工作或任务的努力"
                            },
                            {
                                "target_lang_word": "嘲笑",
                                "target_lang_sense_clarification": "用于表示针对某人的嘲笑或讥讽"
                            },
                            {
                                "target_lang_word": "对",
                                "target_lang_sense_clarification": "用于表示胜利、控制或优势的对象"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "481aa393-4b1d-30cc-a101-7314d55286da",
                    "sense_definition": "Биохимическое сокращение от никотинамидадениндинуклеотид.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В процессе гликолиза восстанавливается молекула <w>НАД</w>.",
                            "target_lang_translations": {
                                "en": "A <w>NAD</w> molecule is reduced during the process of glycolysis.",
                                "zh": "在糖酵解过程中，<w>NAD</w>分子被还原。"
                            }
                        },
                        {
                            "text": "Ферменты используют <w>НАД</w> для переноса электронов.",
                            "target_lang_translations": {
                                "en": "Enzymes use <w>NAD</w> for electron transfer.",
                                "zh": "酶利用<w>NAD</w>来传递电子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "никотинамидадениндинуклеотид"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Biochemical abbreviation for nicotinamide adenine dinucleotide.",
                        "zh": "烟酰胺腺嘌呤二核苷酸的生物化学缩写。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "NAD",
                                "target_lang_sense_clarification": "biochemistry abbreviation"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "NAD",
                                "target_lang_sense_clarification": "生物化学缩写"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}