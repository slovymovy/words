                "senses": [
                    {
                        "sense_id": "de46a12d-7e70-3964-b3a0-d3dcabcef93f",
                        "entry_id": "c16cae8d-39db-3d74-9281-c2a6c67848fa",
                        "glosses": [
                            "Person, die sich in einem Hotel eingemietet hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "140d1cae-efff-4030-9b15-1aac646495b5",
                                "sense_id": "de46a12d-7e70-3964-b3a0-d3dcabcef93f",
                                "text": "„Ich schlafe ein, als sich die ersten Hotelgäste auf den Weg zum Frühstücksbuffet machen.“"
                            },
                            {
                                "example_id": "69fc4a64-49c3-41f6-bc6c-961363888a4c",
                                "sense_id": "de46a12d-7e70-3964-b3a0-d3dcabcef93f",
                                "text": "„Was ich von den folgenden Geschehnissen weiß, habe ich von Hotelgästen und dem Personal aus dem Metropole.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
