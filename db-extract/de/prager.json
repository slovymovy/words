                                "target_senses": [
                                    {
                                        "sense_id": "62b7a4cf-6a9b-3955-b111-780a94a9087b",
                                        "entry_id": "250ebf8d-3c2f-3088-bdbd-d3011ceb6724",
                                        "glosses": [
                                            "obyvatel Prahy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32c59b98-e747-4b66-9813-87f9d85709f8",
                                                "sense_id": "62b7a4cf-6a9b-3955-b111-780a94a9087b",
                                                "text": "Kolár byl rodilý Pražan, jeho otec byl usedlý pražský měšťan a obchodník šatstvem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebd147f8-81a3-4f35-8826-34babf4f640b",
                        "source_entry_id": "8e57344e-4fce-3872-86c6-9a38d3ce7dcb",
                        "source_sense_id": "d90b0026-382b-3d6b-a851-5da19fb305e7",
                        "source_sense_description": "Einwohner von Prag (männlich oder unbestimmten Geschlechts)",
                        "target_lang_word": "Pražák",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pražák",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "7cc63d92-4381-3095-b680-27fc50b94797",
                                        "entry_id": "7d8b7f1c-86c7-31a7-9952-cc663cc13315",
                                        "glosses": [
                                            "obyvatel Prahy"
                                        ],
                                        "tags": [
                                            "v obecném jazyce"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "432a58ed-4d29-486e-88a0-fe16ea323272",
                                                "sense_id": "7cc63d92-4381-3095-b680-27fc50b94797",
                                                "text": "Někteří přátelé mě začali oslovovat Pražáku. Jako by to slovo byla nadávka. Ještě dlouho ale nebudu Pražák, alespoň rozhodně ne takový, jaký jsem Brňák."
                                            },
                                            {
                                                "example_id": "5135ca7d-a423-4708-8410-007f29b441cf",
                                                "sense_id": "7cc63d92-4381-3095-b680-27fc50b94797",
                                                "text": "Někteří řidiči, zvláště Pražáci, jezdí bezohledně a ohrožují všechny. Policisté u silnic je mohou aspoň trochu zbrzdit,\" domnívá se řidič Petr Karlík z Klatovska."
                                            },
                                            {
                                                "example_id": "6652ea1e-ee9f-4ec6-b796-8b7f4d20bd1d",
                                                "sense_id": "7cc63d92-4381-3095-b680-27fc50b94797",
                                                "text": "Malí Pražáci začínají kouřit už v devíti letech."
                                            },
                                            {
                                                "example_id": "129c50a6-9b40-407d-b2af-434b73383796",
                                                "sense_id": "7cc63d92-4381-3095-b680-27fc50b94797",
                                                "text": "Nepoužívám hloupé slovo Ípák, jako slečna z článku, my rodilí Pražáci totiž tomu náměstí zásadně říkáme Pavlák."
                                            },
                                            {
                                                "example_id": "266a0850-88bd-4a86-b349-aa47f5003ce4",
                                                "sense_id": "7cc63d92-4381-3095-b680-27fc50b94797",
                                                "text": "Jedu takhle tábořit/ Škodou 100 na Oravu// Spěchám, proto riskuji,/ projíždím přes Moravu// Řádí tam to strašidlo,/ vystupuje z bažin,// žere hlavně Pražáky, jmenuje se Jožin!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Pražák",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "3cfe829f-1fc4-39ae-aef5-2a4e29cc1ece",
                                        "entry_id": "663a68bf-de78-3712-ae22-1f284eac6176",
                                        "glosses": [
                                            "české příjmení"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cd078f5-a2f9-4af7-b956-6562a04b746c",
                                                "sense_id": "3cfe829f-1fc4-39ae-aef5-2a4e29cc1ece",
                                                "text": "Profesor Josef Pražák je spolu s prof. Sedláčkem a prof. Františkem Novotným spoluautorem v současnosti asi nejpoužívanějšího latinsko-českého slovníku (přezdívaného Prase)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Pražák",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "84048d17-26c9-3c06-9090-a95a23715f43",
                                        "entry_id": "408463c2-342c-303e-8a11-4585f90f955f",
                                        "glosses": [
                                            "stanice metra Pražského povstání v Praze"
                                        ],
                                        "tags": [
                                            "v obecném jazyce"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9b474e2-5dc4-407a-bf1c-77fde3aa6edb",
                                                "sense_id": "84048d17-26c9-3c06-9090-a95a23715f43",
                                                "text": "Dávali jsme si spicha na Pražáku. Pod bejvalým Centrotexem."
                                            },
                                            {
                                                "example_id": "8e32d26f-043e-4090-830d-3a9f24d6a678",
                                                "sense_id": "84048d17-26c9-3c06-9090-a95a23715f43",
                                                "text": "Kavky neboli Kavčí hory jsou, jak známo, v dochozí vzdálenosti od Pražáku."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
