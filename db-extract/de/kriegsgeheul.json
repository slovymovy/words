                        "glosses": [
                            "intensive, durchdringende Lautäußerung als Begleitung eines Angriffs, um Gegner in Schrecken zu versetzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98c464f1-25bb-46bf-bfeb-24ecc04d6383",
                                "sense_id": "d2b97a9d-4d01-337c-9a9c-ce9127570219",
                                "text": "„Die Versammlung löste sich gerade auf, als etwa 100 Männer unter lautem Kriegsgeheul losstürmten in Richtung Hafen.“"
                            }
