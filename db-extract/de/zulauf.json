                        ],
                        "form": "den Zuläufen"
                    },
                    {
                        "form_id": "ac736f21-717e-4fc8-b557-d1a8caf0de74",
                        "entry_id": "549815e0-a37a-3961-bb72-523f193965d6",
                        "tags": [
                            "accusative",
