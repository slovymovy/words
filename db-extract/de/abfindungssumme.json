                "senses": [
                    {
                        "sense_id": "0431ca24-b27b-35ef-800b-61c3758abf6a",
                        "entry_id": "79bbb96b-69fa-3177-8d1f-ab4dfec87bf3",
                        "glosses": [
                            "Summe, die als Abfindung zur Abgeltung von Rechtsansprüchen gezahlt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86b2325e-7c9c-49bc-8231-21a56a9d4ced",
                                "sense_id": "0431ca24-b27b-35ef-800b-61c3758abf6a",
                                "text": "„Ernst Ludwig erhält jährlich 440 000 Mark und eine Abfindungssumme von 10,9 Millionen Mark sowie das Jagdschloss Wolfsgarten, Schloss Rumrod und das Dominialgrundstück von Schloss Kranichstein.“"
                            },
                            {
                                "example_id": "8d27fb5c-bb10-4b22-a198-885bf8b4b9f5",
                                "sense_id": "0431ca24-b27b-35ef-800b-61c3758abf6a",
                                "text": "„Die arabischen Staaten befürchten, dass eine Abfindungssumme der Bundesrepublik Deutschland in Milliardenhöhe das materielle Kräfteverhältnis in Nahost einseitig zugunsten Israels verändere.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
