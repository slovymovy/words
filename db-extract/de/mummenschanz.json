                "senses": [
                    {
                        "sense_id": "978d62af-ffe3-3916-9b11-b9cd25c7da10",
                        "entry_id": "4eafc331-903a-393f-ae17-cccbca505cd6",
                        "glosses": [
                            "Maskerade"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6cbb1621-86a0-4fe9-815a-2a5a32e51858",
                                "sense_id": "978d62af-ffe3-3916-9b11-b9cd25c7da10",
                                "text": "Wir scharten uns zu lust'gem Mummenschanz, / Kapuzen über vollem Lockenkranz! (Conrad Ferdinand Meyer, Huttens letzte Tage, z.n. Projekt Gutenberg)"
                            },
                            {
                                "example_id": "80154c77-9f6b-4e15-a809-8fd02dd71bf9",
                                "sense_id": "978d62af-ffe3-3916-9b11-b9cd25c7da10",
                                "text": "Jetzt aber gibt es Winterspiele, / Vermummt erscheinen die Gefühle, / Ergeben sich dem Mummenschanz / Und dem berauschten Maskentanz. (Heinrich Heine, Halleluja, z.n. Projekt Gutenberg)"
                            },
                            {
                                "example_id": "d248e3c2-b4cb-462a-a2ca-b09003698f0f",
                                "sense_id": "978d62af-ffe3-3916-9b11-b9cd25c7da10",
                                "text": "Ist eben hier eine Mummenschanz / Wie überall, ein Sinnentanz. / Ich griff nach holden Maskenzügen / Und faßte Wesen, daß mich's schauerte . . . / Ich möchte gerne mich betrügen, / Wenn es nur länger dauerte. (Johann Wolfgang von Goethe, Faust II, z.n. Projekt Gutenberg)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f9e65a8-ab8f-42fe-9378-6343484fd7ee",
                        "source_entry_id": "4eafc331-903a-393f-ae17-cccbca505cd6",
                        "source_sense_id": "978d62af-ffe3-3916-9b11-b9cd25c7da10",
                        "source_sense_description": "umgangssprachlich: Maskerade",
                        "target_lang_word": "masquerade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "masquerade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10e4a5fa-74a1-3db9-8fe2-2b7ce7dfaad5",
                                        "entry_id": "d3da48f5-160d-398b-bb89-93c5ebe48826",
                                        "glosses": [
                                            "An assembly or party of people wearing (usually elaborate or fanciful) masks and costumes, and amusing themselves with dancing, conversation, or other diversions."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3a2930f-550d-4a75-a828-2df60413571b",
                                                "sense_id": "10e4a5fa-74a1-3db9-8fe2-2b7ce7dfaad5",
                                                "text": "I was invited to the masquerade party at their home."
                                            },
                                            {
                                                "example_id": "84731c1b-0bc1-4af9-8caa-c41e8dccb572",
                                                "sense_id": "10e4a5fa-74a1-3db9-8fe2-2b7ce7dfaad5",
                                                "text": "What guards the purity of melting Maids, / In courtly Balls and midnight Maſquerades, / Safe from the treach'rous friend, and daring ſpark, / The glance by day, the whiſper in the dark; / [...] / 'Tis but their Sylph, the wiſe Celeſtials know, / Tho' Honour is the word with Men below."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3f3100a-b49a-3715-9684-864ee1c0ec7a",
                                        "entry_id": "d3da48f5-160d-398b-bb89-93c5ebe48826",
                                        "glosses": [
                                            "The act of wearing a mask or dressing up in a costume for, or as if for, a masquerade ball."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2aae38e3-dcb2-31df-9003-dd43e7743ecd",
                                        "entry_id": "d3da48f5-160d-398b-bb89-93c5ebe48826",
                                        "glosses": [
                                            "An act of living under false pretenses; a concealment of something by a false or unreal show; a disguise, a pretence; also, a pretentious display."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b1427fd-fe13-4a21-a54e-c6986877a969",
                                                "sense_id": "2aae38e3-dcb2-31df-9003-dd43e7743ecd",
                                                "text": "Verres in the youth of Cicero, Catiline and Clodius in his middle age, Mark Antony in his old age, have all been left to operate on the modern reader's feelings precisely through that masquerade of misrepresentation which invariably accompanied the political eloquence of Rome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dcc1269-6f88-34e6-9f38-404d9ecadacc",
                                        "entry_id": "d3da48f5-160d-398b-bb89-93c5ebe48826",
                                        "glosses": [
                                            "An assembly of varied, often fanciful, things."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02cbe04a-d648-3b05-9cfc-187f5456d94e",
                                        "entry_id": "d3da48f5-160d-398b-bb89-93c5ebe48826",
                                        "glosses": [
                                            "A cosplay event at which costumed attendees perform skits."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fd8e7fa-6fc1-324c-b499-47ee641df99e",
                                        "entry_id": "d3da48f5-160d-398b-bb89-93c5ebe48826",
                                        "glosses": [
                                            "A dramatic performance by actors in masks; a mask or masque."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "415b7044-a3a5-34da-901d-13b90fb8d9b9",
                                        "entry_id": "d3da48f5-160d-398b-bb89-93c5ebe48826",
                                        "glosses": [
                                            "A Spanish entertainment or military exercise in which squadrons of horses charge at each other, the riders fighting with bucklers and canes."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "masquerade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4df86676-1fba-306a-9885-0905fe922077",
                                        "entry_id": "ce334e35-8a25-3482-a31f-178cbeeda206",
                                        "glosses": [
                                            "To take part in a masquerade; to assemble in masks and costumes; (loosely) to wear a disguise."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6737eea-6965-48f6-a3c8-5ee6450d519d",
                                                "sense_id": "4df86676-1fba-306a-9885-0905fe922077",
                                                "text": "I’m going to masquerade as an old-fashioned pilot. What are you going to dress up as?"
                                            },
                                            {
                                                "example_id": "f5ed8e81-dcb1-4c6a-ba6d-c203a1bc4853",
                                                "sense_id": "4df86676-1fba-306a-9885-0905fe922077",
                                                "text": "There was a Freak took an Aſs in the Head, to Scoure abroad on the Ramble; and away he goes into the Woods, Maſquerading up and down in a Lyon's Skin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e2012da-e2fc-3e23-bb5e-1983d8ff77b8",
                                        "entry_id": "ce334e35-8a25-3482-a31f-178cbeeda206",
                                        "glosses": [
                                            "To pass off as a different person or a person with qualities that one does not possess; also, to make a pretentious show of being what one is not."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88d84dbc-95de-45af-b72e-57784dcde03d",
                                                "sense_id": "7e2012da-e2fc-3e23-bb5e-1983d8ff77b8",
                                                "text": "He masqueraded as my friend until the truth finally came out."
                                            },
                                            {
                                                "example_id": "d6000639-8de5-4bb0-9a1e-a7993d948921",
                                                "sense_id": "7e2012da-e2fc-3e23-bb5e-1983d8ff77b8",
                                                "text": "Ethan Hunt, the human missile of American intelligence that Tom Cruise has been popping back in to play for more than 20 years now, is masquerading as a mysterious terrorist, the perfectly named John Lark, to buy back some plutonium he’s lost to a cabal of doomsday extremists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94047854-d521-3cbf-86dd-ec6c574c2e98",
                                        "entry_id": "ce334e35-8a25-3482-a31f-178cbeeda206",
                                        "glosses": [
                                            "To conceal (someone) with, or as if with, a mask; to disguise."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
