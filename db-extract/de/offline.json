                ],
                "senses": [
                    {
                        "sense_id": "424967fd-f990-31ed-8c05-9b10e21c33b4",
                        "entry_id": "9d5fc4ee-cc6d-39cb-a1bd-733e35879631",
                        "glosses": [
                            "sich nicht im Internet befindend, verwendet für"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7060bb91-55db-390a-a872-fefabaa29a30",
                        "entry_id": "9d5fc4ee-cc6d-39cb-a1bd-733e35879631",
                        "glosses": [
                            "sich nicht im Internet befindend, verwendet für",
                            "momentan nicht im Internet surfende, arbeitende oder chattende Benutzer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "723fcfb4-9c53-45fc-9cb6-1ac2be5a2700",
                                "sense_id": "7060bb91-55db-390a-a872-fefabaa29a30",
                                "text": "„Sorry, ich muss offline. Wir schreiben uns morgen wieder!“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "22e71d04-820f-3378-a026-6eb9830e4406",
                        "entry_id": "9d5fc4ee-cc6d-39cb-a1bd-733e35879631",
                        "glosses": [
                            "sich nicht im Internet befindend, verwendet für",
                            "nicht am Internet angeschlossene oder damit verbundene Computer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "806e1889-ea97-43dd-8e1d-474d5deff52f",
                                "sense_id": "22e71d04-820f-3378-a026-6eb9830e4406",
                                "text": "„Die Rechner sind noch offline. Daher ist momentan kein Websurfen mit ihnen möglich.“"
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "4bfd227e-40d4-3b24-be6e-e012cd6874e5",
                        "entry_id": "9d5fc4ee-cc6d-39cb-a1bd-733e35879631",
                        "glosses": [
                            "sich nicht im Internet befindend, verwendet für",
                            "nicht zu erreichende Server (abgeschaltet/getrennt/down)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3997faf4-baca-44ba-b454-cda3dccf0b12",
                                "sense_id": "4bfd227e-40d4-3b24-be6e-e012cd6874e5",
                                "text": "„Der Server ist momentan offline. Bitte versuchen sie es zu einem späteren Zeitpunkt wieder.“"
                            }
                        ],
                        "sense_index_json": "\"1c\""
                    },
                    {
                        "sense_id": "34f5bf91-b020-3675-8c93-2018c1d08961",
                        "entry_id": "9d5fc4ee-cc6d-39cb-a1bd-733e35879631",
                        "glosses": [
                            "sich nicht im Internet befindend, verwendet für",
                            "nicht im Internet abrufbare Medien (Offline-Medien): Print/Radio/TV/Kino/Disc/etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63dbc514-b032-4097-b4d0-62d97fedd3e6",
                                "sense_id": "34f5bf91-b020-3675-8c93-2018c1d08961",
                                "text": "„Die Originalausgabe dieser Sonder-Edition ist nur als Offline-Medium erhältlich.“"
                            }
                        ],
                        "sense_index_json": "\"1d\""
                    },
                    {
                        "sense_id": "7fb88aad-9eee-3e46-8f28-e8a959a84168",
                        "entry_id": "9d5fc4ee-cc6d-39cb-a1bd-733e35879631",
                        "glosses": [
                            "sich nicht im Internet befindend, verwendet für",
                            "nicht im Internet abrufbare Dateien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9904a03d-b71e-4a12-a242-7d4be2c52df3",
                                "sense_id": "7fb88aad-9eee-3e46-8f28-e8a959a84168",
                                "text": "„Die Daten sind noch offline, ich muss sie erst auf einen Webserver hochladen.“"
                            }
                        ],
                        "sense_index_json": "\"1e\""
                    },
                    {
                        "sense_id": "296cc065-6ce6-3301-9b50-edc0aa198947",
                        "entry_id": "9d5fc4ee-cc6d-39cb-a1bd-733e35879631",
                        "glosses": [
                            "nicht angeschlossene Peripheriegeräte in der Informationstechnologie"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "819f6909-a7e2-44f6-8438-fe283679b987",
                        "source_entry_id": "9d5fc4ee-cc6d-39cb-a1bd-733e35879631",
                        "source_sense_id": "424967fd-f990-31ed-8c05-9b10e21c33b4",
                        "target_lang_word": "offline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "offline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a83f1f4f-cf83-38b3-b818-70adfb94760a",
                                        "entry_id": "9d08b945-e0b5-33ee-8240-8cfda62f7d34",
                                        "glosses": [
                                            "Of a system, currently not connected (generally electrically) to a larger network. For example, a power plant which is not connected to the grid, or a computer which is not connected to the Internet or to any other communications service."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb23fdf3-3ca0-4891-855d-28ec87f8ffbe",
                                                "sense_id": "a83f1f4f-cf83-38b3-b818-70adfb94760a",
                                                "text": "I saved the web pages so I could read them later offline."
                                            },
                                            {
                                                "example_id": "0d12676b-16d2-4d5b-aaf6-6a8dafa8178d",
                                                "sense_id": "a83f1f4f-cf83-38b3-b818-70adfb94760a",
                                                "text": "He only had the option to play offline games because there was no Wi-Fi."
                                            },
                                            {
                                                "example_id": "a0d78940-3546-4bfc-a93e-9512868d909d",
                                                "sense_id": "a83f1f4f-cf83-38b3-b818-70adfb94760a",
                                                "text": "That original list of 2,315 solutions was embedded in the game’s code. That means the game was playable offline and could be downloaded onto phones or computers. The solutions to the original Wordle game were predetermined through October 20, 2027. The New York Times (NYT) hasn’t said if it plans to make any more changes or additions to that initial list."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a6d9fbf-55da-3674-8570-1e3fae4102d5",
                                        "entry_id": "9d08b945-e0b5-33ee-8240-8cfda62f7d34",
                                        "glosses": [
                                            "Happening in the physical world (the real world) as opposed to on the internet."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea96056e-a48e-4056-9371-0bfbf2cdfecc",
                                                "sense_id": "6a6d9fbf-55da-3674-8570-1e3fae4102d5",
                                                "text": "offline meetings"
                                            },
                                            {
                                                "example_id": "4686ae80-db45-4589-a91d-90b00feff58d",
                                                "sense_id": "6a6d9fbf-55da-3674-8570-1e3fae4102d5",
                                                "text": "offline dating"
                                            },
                                            {
                                                "example_id": "386a441a-e29f-4cb2-b9bc-8bb875a520b4",
                                                "sense_id": "6a6d9fbf-55da-3674-8570-1e3fae4102d5",
                                                "text": "Thousands of violent videos are still available on the internet, according to Alexander, who claims they lead to an escalation in offline tensions between rival gangs. \"I believe some young people are losing their lives as result of this material on the internet,\" she said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "offline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab31f72a-d4f5-3b66-846e-d44cf42ca497",
                                        "entry_id": "702a1462-1dec-3c77-86a1-c40d3d3f9905",
                                        "glosses": [
                                            "While offline; with an offline system."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd2605e4-009c-4279-87b3-7044567d6f5f",
                                                "sense_id": "ab31f72a-d4f5-3b66-846e-d44cf42ca497",
                                                "text": "The 2000 also emulates Diablo, Qume and NEC letter-quality printers, and has a large enough buffer memory to operate off line from the host computer for an hour."
                                            },
                                            {
                                                "example_id": "ed271aac-dd51-4d4b-bb97-92c4bb8fa557",
                                                "sense_id": "ab31f72a-d4f5-3b66-846e-d44cf42ca497",
                                                "text": "If you want to keep the phone bill down you can set up your Newsreader to operate offline. This means that your Newsreader will fetch new message headers, collect messages you wish to read, and send any responses you may have set up all in one go. You can then read news offline, while you are not running up the phone bill[…]."
                                            },
                                            {
                                                "example_id": "29ce8c4f-a345-4de0-a7b7-ee1b8c269c2b",
                                                "sense_id": "ab31f72a-d4f5-3b66-846e-d44cf42ca497",
                                                "text": "Men like to play games online, and they also like to find out about the games that they play offline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ae053a8-0353-3367-9554-e22194af15b1",
                                        "entry_id": "702a1462-1dec-3c77-86a1-c40d3d3f9905",
                                        "glosses": [
                                            "Outside the current meeting, in a more private setting."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09971643-b24c-46e7-97ac-a15432640b95",
                                                "sense_id": "8ae053a8-0353-3367-9554-e22194af15b1",
                                                "text": "At meetings, people cut off discussion by saying “Let’s continue that conversation offline,” even though they are meeting face to face, not online; “offline” is a new synonym for “in private,” as though everything public were now on the Internet."
                                            },
                                            {
                                                "example_id": "bb970d12-d6b9-41fe-955b-f55194e7d6cc",
                                                "sense_id": "8ae053a8-0353-3367-9554-e22194af15b1",
                                                "text": "The person running the meeting also has the important job of saying “Take it offline.” Whenever two or more people get off on a tangent that doesn’t require everybody’s attention, instruct them to continue the conversation outside the boundaries of the meeting."
                                            },
                                            {
                                                "example_id": "71a98e43-90fb-4c35-ae43-8bfd6fc75636",
                                                "sense_id": "8ae053a8-0353-3367-9554-e22194af15b1",
                                                "text": "Offer to discuss the topic offline or table the discussion until things cool down."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "offline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d1646b4-856a-3823-afdb-83ef26a521a8",
                                        "entry_id": "56b39bd2-0e92-34d4-aab7-2c162274db06",
                                        "glosses": [
                                            "To take (a system, etc.) offline; to demote from an active or online state."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a6106ad-2767-4aa4-88e8-7c58fe198e11",
                                                "sense_id": "3d1646b4-856a-3823-afdb-83ef26a521a8",
                                                "text": "Offlining a memory processor can be accomplished by using the flexible interleaving capability described earlier to interleave segments across subsets of the memory processors, avoiding the faulty one(s)."
                                            },
                                            {
                                                "example_id": "5eb35670-329e-465d-8d6c-6d14f41aa883",
                                                "sense_id": "3d1646b4-856a-3823-afdb-83ef26a521a8",
                                                "text": "Traditionally, you fixed the problem by offlining the disk and re-creating the disk's extents on a different disk using redundant extent copies and then dropping the failed disk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82486eb0-00fd-3813-917c-c8b2175166ad",
                                        "entry_id": "56b39bd2-0e92-34d4-aab7-2c162274db06",
                                        "glosses": [
                                            "To raid another player's base while that player is not currently playing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
