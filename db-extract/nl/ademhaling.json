                    },
                    {
                        "sense_id": "43069db6-17b7-34e9-818e-2a457e50c783",
                        "entry_id": "d9c51f85-c558-3ede-be43-74bf76325750",
                        "glosses": [
                            "het in- en uitademen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b8952e9-28c6-4174-9894-6419d99c39bd",
                                "sense_id": "43069db6-17b7-34e9-818e-2a457e50c783",
                                "text": "Zelfs het hoogteverschil kon ik duidelijk aan mijn ademhaling merken"
                            },
                            {
                                "example_id": "3a1a105f-a714-4908-aace-2cd8aaca0e48",
                                "sense_id": "43069db6-17b7-34e9-818e-2a457e50c783",
                                "text": "Ik voelde mezelf op- en neergaan op het ritme van zijn ademhaling."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a20b59b3-fd1d-4486-a928-df6ace684f65",
                        "source_entry_id": "d9c51f85-c558-3ede-be43-74bf76325750",
                        "source_sense_id": "0f6892f4-267b-3272-99c2-12c1b24f25c8",
                        "source_sense_description": "door levende wezens ingezogen en uitgeblazen lucht",
                        "target_lang_word": "Atmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb82e79e-9ff6-35e3-8d78-a840a62544d4",
                                        "entry_id": "1b27c62d-1d63-3a67-881e-9453b9dae2d0",
                                        "glosses": [
                                            "Vorgang, bei dem ein Lebewesen Luft in die Atmungsorgane einsaugt und verbrauchte Luft ausstößt"
                                        ],
                                        "tags": [
                                            "Physiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f01dd4ad-ee3f-4e84-b858-9a47c69436ed",
                                                "sense_id": "fb82e79e-9ff6-35e3-8d78-a840a62544d4",
                                                "text": "Atmung ist lebensnotwendig."
                                            },
                                            {
                                                "example_id": "56f3b8d5-19bd-4566-bc95-aeb577ae5694",
                                                "sense_id": "fb82e79e-9ff6-35e3-8d78-a840a62544d4",
                                                "text": "Da keine Atmung des Patienten feststellbar war, wurde er beatmet."
                                            },
                                            {
                                                "example_id": "8e9fd821-40f8-4225-a439-145d7cc385bc",
                                                "sense_id": "fb82e79e-9ff6-35e3-8d78-a840a62544d4",
                                                "text": "Die Atmung des Patienten war flach und zu schnell."
                                            },
                                            {
                                                "example_id": "842d0162-c35c-409c-a9db-307e9920917d",
                                                "sense_id": "fb82e79e-9ff6-35e3-8d78-a840a62544d4",
                                                "text": "„Gerät zum Aufzeichnen der Atemtätigkeit der Lunge, der Ausdehnung des Brustkorbs und der Häufigkeit und Tiefe der Atmungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "760852db-18f4-3215-89d5-60839e9d2b5b",
                                        "entry_id": "1b27c62d-1d63-3a67-881e-9453b9dae2d0",
                                        "glosses": [
                                            "chemischer Vorgang, bei dem ein energiehaltiger Stoff mit Hilfe eines zweiten Stoffes (zum Beispiel von Sauerstoff) umgesetzt wird, um Energie im Körper chemisch zu speichern"
                                        ],
                                        "tags": [
                                            "Physiologie",
                                            "im weiteren Sinn"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab91dfca-9755-43e1-bf75-2d464244bf94",
                                                "sense_id": "760852db-18f4-3215-89d5-60839e9d2b5b",
                                                "text": "„Es laufen schrittweise verschiedene Gärungen (Gärung) und anaerobe Atmungen (anaerobe Atmung) ab, wobei das Endprodukt der Gärung einer Bakteriengruppe der anderen als Substrat dienen kann ( vgl. Abb. ).“"
                                            },
                                            {
                                                "example_id": "7194c6e9-5f7e-441f-b995-b4c4fa133b9a",
                                                "sense_id": "760852db-18f4-3215-89d5-60839e9d2b5b",
                                                "text": "… die zelluläre Energieerzeugung durch chemische Atmung in Mitochondrien ist membranständig."
                                            },
                                            {
                                                "example_id": "0e4a55ad-6505-4828-808c-3e10d11550e1",
                                                "sense_id": "760852db-18f4-3215-89d5-60839e9d2b5b",
                                                "text": "„Die verschiedenen anaeroben Atmungen werden anhand des veratmeten Substrates oder der Stoffwechselendprodukte klassifiziert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
