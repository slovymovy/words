                    {
                        "sense_id": "7a041dbf-cb7e-3e48-a6d6-875609420130",
                        "entry_id": "19ae732c-bc97-3c78-96f1-3e907edd2610",
                        "glosses": [
                            "hardwood (The wood from any dicotyledonous tree.)"
                        ],
