                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e78cae4f-f074-3ee5-8821-4ece084ff4d1",
                                        "entry_id": "77bf2191-98f3-316c-93c8-8b07eadf93b8",
                                        "glosses": [
                                            "Hydrogen peroxide, especially when in an aqueous solution used as a bleach."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d69f989a-fadd-36bc-b138-bde651d37c95",
                                        "entry_id": "77bf2191-98f3-316c-93c8-8b07eadf93b8",
                                        "glosses": [
                                            "Any compound containing the functional group R-O-O-R'."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4577edc-b698-4285-a342-91bd5dba1e80",
                                                "sense_id": "d69f989a-fadd-36bc-b138-bde651d37c95",
                                                "text": "Thus far, Dr. Petrakis said, he had found that in women with […] extractable breast fluid, the amount of lipid peroxides in the fluid was on the average seven times higher in Caucasian women than in women of Chinese de[s]cent. In addition, women with cystic breast disease, who face a higher than usual risk of breast cancer, appear to have more peroxides in their breast fluid than women with normal breasts."
                                            },
                                            {
                                                "example_id": "672686a9-33a3-4673-8098-70baa2399243",
                                                "sense_id": "d69f989a-fadd-36bc-b138-bde651d37c95",
                                                "text": "The O–O bond in benzoyl peroxide and the C–N bonds in AIBN homolyze under thermal or photochemical conditions."
                                            }
                                        ]
                                    }
                                ]
                            },
