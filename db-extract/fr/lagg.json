                ],
                "senses": [
                    {
                        "sense_id": "8fd896b6-ea85-304c-bcc7-7e58dc580c95",
                        "entry_id": "4ecb8fa1-1e94-3fa7-b4a2-7d5d9f2bbd48",
                        "glosses": [
                            "Anneau aquatique entourant une tourbière bombée récupérant l'ensemble des eaux de ruissellement des zones adjacentes, l’enrichissant ainsi en minéraux disponible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "239507ee-a5e6-469d-9e21-ec775470b02e",
                                "sense_id": "8fd896b6-ea85-304c-bcc7-7e58dc580c95",
                                "text": "La section de transition entre la portion centrale de la tourbière et le lagg est composée d'une éricaçaie à Carex oligosperme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1636e2f-a824-4f5b-9d5d-92815d0ad8ba",
                        "source_entry_id": "4ecb8fa1-1e94-3fa7-b4a2-7d5d9f2bbd48",
                        "source_sense_id": "8fd896b6-ea85-304c-bcc7-7e58dc580c95",
                        "target_lang_word": "Lagg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lagg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29e9d3fa-42c1-3991-9d23-0e019b57e641",
                                        "entry_id": "c60cc3a3-1b6a-34e0-b456-731692ffec0e",
                                        "glosses": [
                                            "der Entwässerung dienender, natürlicher, sumpfiger, schmaler Gürtel am Rande eines durch Transgression gebildeten Hochmoors"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "735dd1a2-69d8-47b1-92ab-808610872a7b",
                                                "sense_id": "29e9d3fa-42c1-3991-9d23-0e019b57e641",
                                                "text": "„Auf den Hochmooren des Untersuchungsgebietes fehlt im allgemeinen der Lagg; wo sich ein solcher findet, ist er auf einen ganz kleinen Teil des Moorrandes beschränkt.“"
                                            },
                                            {
                                                "example_id": "dedcba2f-f657-4752-b0f2-8d6db4bcb000",
                                                "sense_id": "29e9d3fa-42c1-3991-9d23-0e019b57e641",
                                                "text": "„Der Lagg stellt das wichtigste Glied in dem natürlichen Drainierungssystem der Hochmoore dar. Der Lagg ist durch die Selbstdrainierung sowie charakteristische Wachstumsweise und Topographie des normalen Hochmoores hervorgerufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36513a9d-b51e-4bf9-8c19-c16e90f419a3",
                        "source_entry_id": "4ecb8fa1-1e94-3fa7-b4a2-7d5d9f2bbd48",
                        "source_sense_id": "8fd896b6-ea85-304c-bcc7-7e58dc580c95",
                        "target_lang_word": "lagg",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lagg",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed8710a2-c4a6-3e83-9ad5-28a278b3a7e6",
                                        "entry_id": "a648a15d-f6c6-3e19-8b20-efd1a766fb54",
                                        "glosses": [
                                            "Waterlogged, marshy area around the perimeter of a (raised) bog, where water collects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebb9efea-60f0-4fda-96df-7d5d9ba290d0",
                                                "sense_id": "ed8710a2-c4a6-3e83-9ad5-28a278b3a7e6",
                                                "text": "Whenever one wants to get to a typical raised bog one usually has to wade through the more or less waterlogged lagg. On the bog itself in dry weather one could walk about in light shoes without getting one's feet wet."
                                            },
                                            {
                                                "example_id": "cdf5317f-d9a0-4864-8bdf-b20b12adbe65",
                                                "sense_id": "ed8710a2-c4a6-3e83-9ad5-28a278b3a7e6",
                                                "text": "Surface-water inflow is now largely confined to the lagg, or moat, often surrounding a bog's outer margins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
