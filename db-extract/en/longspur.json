                                    {
                                        "sense_id": "d6338cac-3365-3c9f-bd55-1254a219bb84",
                                        "entry_id": "f534c7ce-1179-3a9b-91dd-896858ab8f11",
                                        "glosses": [
                                            "ботан. дикорастущее луговое травянистое растение семейства подорожниковых, с широкими листьями и мелкими цветками, собранными в колос (Plantago)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0474bc02-3f03-47da-b920-1f8c98755f99",
                                                "sense_id": "d6338cac-3365-3c9f-bd55-1254a219bb84",
                                                "text": "Кругом дикая трава, подорожник растёт прямо среди дороги."
                                            },
                                            {
                                                "example_id": "dd320ea7-54c0-447b-a28b-fbdae6aef9d5",
                                                "sense_id": "d6338cac-3365-3c9f-bd55-1254a219bb84",
                                                "text": "Листки подорожника днём принимают горизонтальное положение, а ночью складываются наподобие зонтика."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29f84f04-d1eb-3acb-ac96-ec52ed953f98",
                                        "entry_id": "f534c7ce-1179-3a9b-91dd-896858ab8f11",
                                        "glosses": [
                                            "разг. универсальное средство"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "подорожник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1195fdd3-86ff-3c9a-b585-cdfeb53e651b",
                                        "entry_id": "c94541fd-d538-3075-b110-1b39ff05601c",
                                        "glosses": [
                                            "зоол. небольшая птица рода подорожников (Calcarius)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ffd7a24-2e3a-44c8-b335-5aefacf06363",
                                                "sense_id": "1195fdd3-86ff-3c9a-b585-cdfeb53e651b",
                                                "text": "Подорожники, когда их вспугает проезжий или прохожий, всегда перелетают на небольшое расстояние вперед и опять садятся на дорогу, что повторяется много раз; наконец, наскучив беспрестанным перелетываньем, подорожники облетают вкруг проезжего или прохожего, возвращаются назад и садятся на ту же дорогу."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "подорожник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6aa4ca4a-734b-3bea-bbbc-67dc8aa9ce87",
                                        "entry_id": "12487aaa-d9ce-3716-9d94-69af7bee1f96",
                                        "glosses": [
                                            "разг., устар. пирожок, лепёшка и т. п., взятые в дорогу в качестве закуски"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7610fa29-8743-48fe-8e3b-ae3541340ed8",
                                                "sense_id": "6aa4ca4a-734b-3bea-bbbc-67dc8aa9ce87",
                                                "text": "Прабабушка снабдила меня, конечно, «подорожниками», то есть разными произведениями своего кулинарного искусства"
                                            },
                                            {
                                                "example_id": "e8779a02-64ae-4d9e-b639-65ff8aa7fe22",
                                                "sense_id": "6aa4ca4a-734b-3bea-bbbc-67dc8aa9ce87",
                                                "text": "Зимою в Сибири, когда едут в дорогу, приготовляют на дорогу подорожники, т. е. разные варенья, щи, печенья и непременно пельмени, и всё это замораживают и складывают в мешки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
