                                        "entry_id": "1e635df0-ca50-3b00-a9cb-ef8360ca25ef",
                                        "glosses": [
                                            "mexikanische Stadt im Bundesstaat Jalisco, die für die gleichnamige Spirituose bekannt ist"
                                        ],
