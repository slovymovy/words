                "senses": [
                    {
                        "sense_id": "66dd4beb-d3a9-3692-a92a-370296d05114",
                        "entry_id": "ce35568c-0367-37ab-9b04-37597cc047cc",
                        "glosses": [
                            "Épaissir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34dd6ad8-8f8d-4aa8-920c-1a768397be77",
                                "sense_id": "66dd4beb-d3a9-3692-a92a-370296d05114",
                                "text": "On travailla à réépaissir les parapets dégradés par le feu continuel de l'ennemi."
                            },
                            {
                                "example_id": "427a6ba6-aa80-4386-9e2f-ba276450fdc8",
                                "sense_id": "66dd4beb-d3a9-3692-a92a-370296d05114",
                                "text": "Même s'il faut en cours de route procéder à des modifications, par exemple réépaissir certains murs, parce que les problèmes de sûreté et de protection ont été réétudiés au cours du chantier."
                            }
                        ]
                    }
