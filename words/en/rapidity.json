                {
                    "sense_id": "bbf691c9-0c3c-3420-8367-25ca37efe334",
                    "sense_definition": "The quality or state of being rapid; speed or swiftness.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The incredible <w>rapidity</w> of technological progress surprised even the most optimistic experts."
                        },
                        {
                            "text": "The disease spread through the crowded population with alarming <w>rapidity</w>."
                        }
                    ],
                    "synonyms": [
