                ],
                "senses": [
                    {
                        "sense_id": "911baf00-0fa4-33ea-a5b6-f8a3d6db4ea8",
                        "entry_id": "2494f1f1-ba77-3e56-a1b0-acf4241ca316",
                        "glosses": [
                            "Moral purity; innocence."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "50e1ff92-de6b-4adb-b86c-bada9218fd66",
                                "sense_id": "911baf00-0fa4-33ea-a5b6-f8a3d6db4ea8",
                                "text": "Certes sayd the good man that is sothe / for he shalle be the best knyghte of the world and the fairest of alle the felauship / But wete yow wel there shall none atteyne it but by clennes that is pure confession"
                            }
                        ]
                    },
                    {
                        "sense_id": "467c687b-0900-3933-85ec-bed0c4ea6820",
                        "entry_id": "2494f1f1-ba77-3e56-a1b0-acf4241ca316",
                        "glosses": [
                            "The state of being physically clean and free of contamination or dirt; cleanliness."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "b1baabbc-e500-40d1-a427-2fb4c5b3aad1",
                                "sense_id": "467c687b-0900-3933-85ec-bed0c4ea6820",
                                "text": "\"But if so, why do you see so many young children on steam trains - apart, that is, from being dragged along by their fathers, or grandfathers?\n\"I think they enjoy them because they are simply so different, so mechanical, so hot, oily and clanky, so dirty, so 'analogue' in a digital world. They are everything modern life tries to extirpate in favour of silence, smoothness and cleanness. Kids love that."
                            }
                        ]
                    }
                ],
