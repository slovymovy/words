                "senses": [
                    {
                        "sense_id": "b14a7d0e-fb89-3155-b73e-1eef34d7da82",
                        "entry_id": "14b26a32-684f-3223-9f2c-a39ab79ceecf",
                        "glosses": [
                            "Ausruhen am Vormittag; Vermeiden ruhestörenden Lärms am Vormittag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd46c82f-5f21-4313-8eb8-07570805f66e",
                                "sense_id": "b14a7d0e-fb89-3155-b73e-1eef34d7da82",
                                "text": "„Nach drei Stunden war eine kurze Vormittagsruhe, und wieder nach drei Stunden kam die Ruhe des Mittages.“"
                            },
                            {
                                "example_id": "c4d45de4-71e2-42fb-a0c0-1ddd3dd0b5f9",
                                "sense_id": "b14a7d0e-fb89-3155-b73e-1eef34d7da82",
                                "text": "„Erst als sie sich kräftig räusperte, blickte die Dame unwillig auf und streckte ihr Kinn nach vorne, um durch sparsame Mimik nach dem Begehr der Person zu forschen, die es wagte, ihre Vormittagsruhe zu stören.“"
                            },
                            {
                                "example_id": "8cec7cb0-bfb7-4d33-b09c-f6921e65713f",
                                "sense_id": "b14a7d0e-fb89-3155-b73e-1eef34d7da82",
                                "text": "„Dieses gemüthlich menschenfreundliche Klingeln war der einzige kräftigere Laut, der in die sonnige Vormittagsruhe nicht störend, sondern milde belebend eindrang.“"
                            },
                            {
                                "example_id": "48fc629d-5f3f-4129-b4bf-8bf7c267eecd",
                                "sense_id": "b14a7d0e-fb89-3155-b73e-1eef34d7da82",
                                "text": "„Auch hatte er merkwürdiger Weise bei der Dame Zutritt, selbst wenn sie noch ihre Vormittagsruhe hielt […].“"
                            },
                            {
                                "example_id": "b20a6ce5-eee8-43d5-883f-932e8b178a20",
                                "sense_id": "b14a7d0e-fb89-3155-b73e-1eef34d7da82",
                                "text": "„Es war die kurze Zeit der Vormittagsruhe, die mir noch oft auf den Schlachtfeldern als einzige Atempause zugute kam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
