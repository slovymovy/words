                "senses": [
                    {
                        "sense_id": "289a65d0-25e9-3ff5-bf68-f0dcd26e54da",
                        "entry_id": "56c59576-37e6-3d2c-9135-c0f1c155cf72",
                        "glosses": [
                            "durch Mutterkorn hervorgerufene Vergiftungskrankheit, manchmal auf weiter gefasst für vielfältige Erkrankungen der Haut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95a5629f-0687-409d-885e-23dac84b47f2",
                                "sense_id": "289a65d0-25e9-3ff5-bf68-f0dcd26e54da",
                                "text": "Im Mittelalter wurden durch das Antoniusfeuer ganze Dörfer dahingerafft."
                            },
                            {
                                "example_id": "be79465e-0f1f-499b-9cf6-55b866712a8f",
                                "sense_id": "289a65d0-25e9-3ff5-bf68-f0dcd26e54da",
                                "text": "Die Ansicht, daß es sich beim Antoniusfeuer um Ergotismus-Epidemien gehandelt hat, vertritt auch R. C r e u t z."
                            },
                            {
                                "example_id": "e805dd8a-b5d4-4555-ac6a-fd1a2648dbb1",
                                "sense_id": "289a65d0-25e9-3ff5-bf68-f0dcd26e54da",
                                "text": "Unter Antoniusfeuer verstand man, um es kurz zu machen, Erysipel (Rose und Rotlauf), fressende Flechte (fortschreitende Hautgeschwüre als Hautbrand, Lupus [Hauttuberkulose] und Hautkrebs), Bindegewebsentzündung und Brand."
                            },
                            {
                                "example_id": "4f550139-1f23-4abc-94da-07cdc05c7b47",
                                "sense_id": "289a65d0-25e9-3ff5-bf68-f0dcd26e54da",
                                "text": "So konnten Wundbrand, diabetische Gangraen und Altersbrand, geschwürige Prozesse, Aussatz, syphilitische Erkrankungen, Pest und Pocken und vielleicht auch Bleivergiftungen als »Antoniusfeuer« angesehen werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
