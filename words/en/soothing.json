                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pochlebianie",
                                "target_lang_sense_clarification": "przypochlebianie się komuś"
                            },
                            {
                                "target_lang_word": "przytakiwanie",
                                "target_lang_sense_clarification": "potwierdzanie czyichś słów"
                            }
                        ]
