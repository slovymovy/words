                                                "example_id": "3278231a-e37e-4ced-9eca-a4d0463cdc85",
                                                "sense_id": "b41dea32-40c2-3226-bfe0-b4713e497379",
                                                "text": "(가슴에) 못이 박히다 - 무엇이 마음에 깊이 자리 잡다."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6847ec0-1048-3fdd-a455-8e0eb242c415",
                                        "entry_id": "d191f40c-1cac-3892-84da-f352c8faa183",
                                        "glosses": [
                                            "손이나 발로 어떤 일을 자주하여 생근 굳은살."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba8cb9ed-e625-4a28-87b8-29ede6129498",
                                                "sense_id": "c6847ec0-1048-3fdd-a455-8e0eb242c415",
                                                "text": "테니스를 자주 쳐 손바닥에 못이 박혔다."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "못",
                                "target_lang_code": "ko",
                                "target_senses": [
                                    {
                                        "sense_id": "ec1d46f1-cc1c-3f21-a2b5-af49f8e6d3fa",
                                        "entry_id": "a2ba1214-12f4-3546-9a6e-eeba11b3b2df",
                                        "glosses": [
                                            "넓고 오목하게 팬 땅에 물이 괴어 있는 곳. 늪보다 작다."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d8a7ddc-1e85-4335-9e09-7cc3d12ab520",
                                                "sense_id": "ec1d46f1-cc1c-3f21-a2b5-af49f8e6d3fa",
                                                "text": "못을 파다."
                                            },
                                            {
                                                "example_id": "ee8b9c2a-6f2d-4fd2-bddf-c177b9b4e40f",
                                                "sense_id": "ec1d46f1-cc1c-3f21-a2b5-af49f8e6d3fa",
                                                "text": "못에 연꽃이 피었다."
                                            },
                                            {
                                                "example_id": "ee44b2e1-bff0-4bb5-82f1-cf8b9e3f7d67",
                                                "sense_id": "ec1d46f1-cc1c-3f21-a2b5-af49f8e6d3fa",
                                                "text": "못에서 떼를 지어 우는 개구리 소리가 야단스러웠다."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "못",
                                "target_lang_code": "ko",
                                "target_senses": [
                                    {
                                        "sense_id": "4b4cd2f4-3bc5-3f78-b109-f4ea21219032",
                                        "entry_id": "4b7b2426-beec-3939-a6e6-44ad0904eac2",
                                        "glosses": [
                                            "(동사 앞에서 쓰여) 그런 일을 할 수 없거나 이룰 수 없다는 뜻을 더하는 말."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a091905c-defc-4839-8d16-deb1749f6bec",
                                                "sense_id": "4b4cd2f4-3bc5-3f78-b109-f4ea21219032",
                                                "text": "오늘 점심을 못 먹었다."
                                            },
                                            {
                                                "example_id": "de7eae42-8db1-4dc1-b2db-c840c28cf1b8",
                                                "sense_id": "4b4cd2f4-3bc5-3f78-b109-f4ea21219032",
                                                "text": "어제 연속극을 못 보았다."
                                            },
                                            {
                                                "example_id": "55e52b19-91ee-49a2-8f11-651cef75861a",
                                                "sense_id": "4b4cd2f4-3bc5-3f78-b109-f4ea21219032",
                                                "text": "못 먹는 감 찔러나 본다 - 무엇을 갖고 싶지만 가질 수 없을 때 다른 이도 못 가지게 만들려는 그릇된 태도를 두고 하는 말."
                                            },
                                            {
                                                "example_id": "e046db76-1332-4a18-a077-8e3d43a785c5",
                                                "sense_id": "4b4cd2f4-3bc5-3f78-b109-f4ea21219032",
                                                "text": "못 먹는 밥에 재 집어 넣기 - \"못 먹는 감 찔러나 본다\"와 같은 뜻."
                                            },
                                            {
                                                "example_id": "b673689a-d30c-4507-bf88-c308293dd1c1",
                                                "sense_id": "4b4cd2f4-3bc5-3f78-b109-f4ea21219032",
                                                "text": "못 오를 나무는 쳐다보지도 마라 - 자신의 처지에 맞지 않는 것을 탐내지 말라는 뜻."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
