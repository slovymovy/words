    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2b41fe6e-d18a-3acf-90df-0d3ce8967672",
                    "sense_definition": "Extremely thorough, complete, or far-reaching in effect.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company underwent a <w>radical</w> transformation to avoid going bankrupt.",
                            "target_lang_translations": {
                                "ru": "Компания претерпела <w>радикальную</w> трансформацию, чтобы избежать банкротства.",
                                "zh": "为了避免破产，这家公司进行了<w>彻底的</w>转型。"
                            }
                        },
                        {
                            "text": "The doctor recommended <w>radical</w> surgery to ensure the entire tumor was removed.",
                            "target_lang_translations": {
                                "ru": "Врач рекомендовал <w>радикальную</w> операцию, чтобы гарантировать полное удаление опухоли.",
                                "zh": "医生建议进行<w>根治性</w>手术，以确保肿瘤被完全切除。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fundamental"
                    ],
                    "antonyms": [
                        "trivial"
                    ],
                    "common_phrases": [
                        "radical change",
                        "radical surgery",
                        "radical transformation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно тщательный, полный или имеющий далеко идущие последствия.",
                        "zh": "指彻底的、完全的或影响深远的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "радикальный",
                                "target_lang_sense_clarification": "решительный, коренной"
                            },
                            {
                                "target_lang_word": "коренной",
                                "target_lang_sense_clarification": "затрагивающий основы"
                            },
                            {
                                "target_lang_word": "фундаментальный",
                                "target_lang_sense_clarification": "основополагающий"
                            }
