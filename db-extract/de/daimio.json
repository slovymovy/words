                            {
                                "target_word": "daïmio",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e36d59f-ee02-3c13-822e-6af38a922d99",
                                        "entry_id": "8f17e344-9e1a-3bab-9590-e8fe840c0c96",
                                        "glosses": [
                                            "Principal gouverneur de province du Japon durant la période féodale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4939422c-6219-4f45-91a1-0d60844b39bc",
                                                "sense_id": "0e36d59f-ee02-3c13-822e-6af38a922d99",
                                                "text": "Nagamasa Asai fut le daïmio de la province d’Ōmi, et le troisième et ultime gouvernant du clan Asai."
                                            },
                                            {
                                                "example_id": "52728c34-36f6-4db9-8915-bc37b64319ea",
                                                "sense_id": "0e36d59f-ee02-3c13-822e-6af38a922d99",
                                                "text": "Devant chacun marchaient fièrement, au milieu de la rue, une vingtaine d’hommes à deux sabres ; puis venait le daïmio, avec son grand chapeau en laque de toute couleur, son costume gris perle, monté sur son cheval de cérémonie."
                                            },
                                            {
                                                "example_id": "5756e0a5-761e-4f13-b070-9bc4a36896d3",
                                                "sense_id": "0e36d59f-ee02-3c13-822e-6af38a922d99",
                                                "text": "Le daïmio d’Arima est arrivé ce matin à l’aube et a confirmé les assertions des messagers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a4b83e7-a330-43c8-98e2-1f23b99bbbf4",
                        "source_entry_id": "5fedb789-f56e-3434-ab46-853bfff0ca88",
                        "source_sense_id": "95db87b0-0afb-3673-9310-c16b1a1b3f7b",
