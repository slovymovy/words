                                            "bestimmte Hafersorte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1e04580-4e50-4a4c-a7c5-ce61c3f522f0",
                                                "sense_id": "327e0ce5-1369-3eb3-ac6e-1b205e37a6a8",
                                                "text": "„Bei einer getreidelastigen Fruchtfolge besteht die Gefahr, dass sich Schadgräser breitmachen wie der Flughafer.“"
                                            },
                                            {
                                                "example_id": "61ab991a-6529-4506-8d32-a4529ef607a6",
                                                "sense_id": "327e0ce5-1369-3eb3-ac6e-1b205e37a6a8",
                                                "text": "„Für Spaziergänger ist dieses Feld zwar ein hübscher Anblick, doch diese Kräuter würden so wie auch die Quecke und der Flughafer dem trockenen Korn bei der Ernte zuviel Feuchtigkeit geben, was zu Ernteverlusten führt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
