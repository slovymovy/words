                        "entry_id": "75d324fd-f5f7-3488-8fc3-e1bafc600816",
                        "glosses": [
                            "S'introduire sans permission dans un endroit."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a49b6bb1-5c47-4fc0-abdd-17c304147433",
                                "sense_id": "ae5d039d-3d3b-35e5-b240-e32a63a47273",
                                "text": "Ca s'intrusionne, ça s'intrusionne, partout, tout partout."
                            },
                            {
                                "example_id": "78eb7f7b-4ee0-41f7-9bdd-dbe05a449265",
                                "sense_id": "ae5d039d-3d3b-35e5-b240-e32a63a47273",
                                "text": "pour alimenter la polémique je me suis fait aussi \"intrusionner\" dans ma messagerie orange..."
                            }
                        ]
                    }
