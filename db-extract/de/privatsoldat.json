                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99e63ad3-5a4a-4074-9354-a8fecd0038f1",
                                "sense_id": "4a6480aa-7d55-3a4f-a514-4db63a4a6f78",
                                "text": "„Die Privatsoldaten Hitlers waren sechs Fuß hoch oder nur drei, Bucklige gingen auch mit.“"
                            },
                            {
                                "example_id": "0559f99a-79e9-4a22-bc16-2da5cb329e27",
                                "sense_id": "4a6480aa-7d55-3a4f-a514-4db63a4a6f78",
                                "text": "„Den Privatsoldaten der Gesellschaft gelang es auch nicht, im Lande die Ordnung aufrechtzuerhalten.“"
                            },
                            {
                                "example_id": "9fe66986-e43a-4bd9-9013-191830a1fb3b",
                                "sense_id": "4a6480aa-7d55-3a4f-a514-4db63a4a6f78",
                                "text": "„Die meisten Waldführer sind Privatsoldaten ohne wissenschaftlichen Sachverstand.“"
                            },
                            {
                                "example_id": "33dd9aa5-f1b3-49bf-9b0e-6d26d7dd893c",
                                "sense_id": "4a6480aa-7d55-3a4f-a514-4db63a4a6f78",
                                "text": "„Es kam auch vor, dass Adelige die Aufstellung der Portalmiliz sabotierten oder einfach ihre Privatsoldaten ins Feld stellten.“"
                            },
                            {
                                "example_id": "6b9fbfdd-a9a9-48ff-afbb-eb486a51c707",
                                "sense_id": "4a6480aa-7d55-3a4f-a514-4db63a4a6f78",
                                "text": "„Nehemia selbst erscheint wie ein Militärfeldherr, dem die Privatsoldaten zur Verfügung stehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
