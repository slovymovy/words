                    },
                    {
                        "form_id": "0fef8249-7268-4a53-9956-75ab7c534e3f",
                        "entry_id": "b047c4f8-94ee-347a-be62-b781b050071e",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most unspoilt"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "46362c6a-ceaf-3666-9754-e54e57d8828a",
                        "entry_id": "b047c4f8-94ee-347a-be62-b781b050071e",
                        "glosses": [
                            "Not spoilt, decayed or corrupted."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8be9dac0-0bb4-46c6-931b-ea3f6618c80a",
                                "sense_id": "46362c6a-ceaf-3666-9754-e54e57d8828a",
                                "text": "Before the motorway was built, this was unspoilt countryside."
                            },
                            {
                                "example_id": "7e0d5f3c-c315-477f-8da5-a23e9bb47546",
                                "sense_id": "46362c6a-ceaf-3666-9754-e54e57d8828a",
                                "text": "Well, during our short staycation at Humberston Fitties, just south of Cleethorpes, we cycled through the very unspoilt Lincolnshire Wolds, which are by no means flat and boring as conventional wisdom about the county suggests."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ebe6798-ebbb-4b0d-9a0a-ddf54f12d0db",
                        "source_entry_id": "b047c4f8-94ee-347a-be62-b781b050071e",
                        "source_sense_id": "46362c6a-ceaf-3666-9754-e54e57d8828a",
                        "source_sense_description": "not spoilt",
                        "target_lang_word": "unberührt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unberührt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b10a64ce-2a59-3ad5-83e6-4e004c7b5ffb",
                                        "entry_id": "9f1afdf5-aa91-3e0a-8492-06b141dd87ec",
                                        "glosses": [
                                            "nicht (mit Händen) angegriffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7d4f496-acc3-46d8-b5de-0e9a7ba78ce7",
                                                "sense_id": "b10a64ce-2a59-3ad5-83e6-4e004c7b5ffb",
                                                "text": "„Des Bundeskanzlers Zigarre blieb unberührt liegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "98cde3f3-6f0d-31b7-a3af-d44ca28e8681",
                                        "entry_id": "9f1afdf5-aa91-3e0a-8492-06b141dd87ec",
                                        "glosses": [
                                            "durch menschliche Einflüsse nicht verändert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3cb2d11-81f5-4c14-8156-3944c57476a2",
                                                "sense_id": "98cde3f3-6f0d-31b7-a3af-d44ca28e8681",
                                                "text": "„Geplant wird also der Ausschluß der potentiell zerstörerischen Menschen, damit das Geschützte unberührte Natur werden kann.“"
                                            },
                                            {
                                                "example_id": "044b2efc-1977-4983-90ab-d6f4ad8a7a3e",
                                                "sense_id": "98cde3f3-6f0d-31b7-a3af-d44ca28e8681",
                                                "text": "„Am Themenweg Almzeit warten packend inszenierte Bergerlebnisse auf der Skigebietsseite und unberührte Naturräume auf der Stillen Seite von Sölden.“"
                                            },
                                            {
                                                "example_id": "45f244a2-6bc8-4dde-bdee-7477c84beb23",
                                                "sense_id": "98cde3f3-6f0d-31b7-a3af-d44ca28e8681",
                                                "text": "„Bis heute besteigt der Vater von Zwillingen so oft es geht auf Tourenski die Gipfel, um über unberührte Hänge wieder abzufahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "12cd70ac-6fdd-3acd-a9bf-064428ec507d",
                                        "entry_id": "9f1afdf5-aa91-3e0a-8492-06b141dd87ec",
                                        "glosses": [
                                            "noch keinen Geschlechtsverkehr gehabt habend"
                                        ],
                                        "tags": [
                                            "von weiblichen Personen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41351c1a-b9b1-4ceb-b84c-a8b3b2ccedb4",
                                                "sense_id": "12cd70ac-6fdd-3acd-a9bf-064428ec507d",
                                                "text": "„Alle vier Rechtstexte, die Strafen für Vergewaltigung festsetzen, nehmen als Opfer ein unberührtes Mädchen an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8b68d896-3c9f-3102-9e3a-6651f2930d3c",
                                        "entry_id": "9f1afdf5-aa91-3e0a-8492-06b141dd87ec",
                                        "glosses": [
                                            "nicht beeinflusst, nicht betroffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d860d65-95ef-4745-b92f-9511165d0ee9",
                                                "sense_id": "8b68d896-3c9f-3102-9e3a-6651f2930d3c",
                                                "text": "„Von den Einflüssen des Jugendstils blieb sie unberührt.“"
                                            },
                                            {
                                                "example_id": "8600b20a-a9d7-418d-b9be-5261b8b4df47",
                                                "sense_id": "8b68d896-3c9f-3102-9e3a-6651f2930d3c",
                                                "text": "„Auch sozialdemokratische Arbeiter ließ die Faszination des Militärischen nicht unberührt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
