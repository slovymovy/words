                "senses": [
                    {
                        "sense_id": "14079f14-03d3-3c0a-9ab8-53683f2e759d",
                        "entry_id": "0da3c11a-aff7-32ac-b292-f6c4fe15fb54",
                        "glosses": [
                            "eine natürliche „Einzelschöpfung“ oder eine schützenswerte Kleinfläche unter fünf Hektar; als Naturdenkmäler können beispielsweise seltene oder sehr alte Bäume, Felsformationen, Höhlen oder auch Vorkommen von Pflanzen und Tieren, die unter besonderem Schutz stehen, angesprochen werden"
                        ],
                        "tags": [
                            "Naturschutz"
                        ],
                        "examples": [
                            {
                                "example_id": "eeb85c6c-ee99-4db6-85a5-043eae6df325",
                                "sense_id": "14079f14-03d3-3c0a-9ab8-53683f2e759d",
                                "text": "„Die Naturdenkmäler sind meistens Felsformationen aus Dolomitfels mit unzähligen Höhlen, Felslöchern und Türmchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
