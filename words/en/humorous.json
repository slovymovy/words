{
    "word_family": [
        "humor",
        "humorist",
        "humorless",
        "humorously",
        "humorousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "da27db8d-9ef6-39b8-80ba-27b7d22982b9",
                    "sense_definition": "Full of humor or arousing laughter; funny.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "funny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian told a <w>humorous</w> story about his childhood that made everyone laugh.",
                            "target_lang_translations": {
                                "ru": "Комик рассказал <w>смешную</w> историю о своем детстве, которая заставила всех смеяться."
                            }
                        },
                        {
                            "text": "She wrote a <w>humorous</w> anecdote in her diary about the clumsy waiter.",
                            "target_lang_translations": {
                                "ru": "Она записала в дневнике <w>забавный</w> анекдот о неуклюжем официанте."
                            }
                        }
                    ],
                    "synonyms": [
                        "amusing",
                        "funny"
                    ],
                    "antonyms": [
                        "serious",
                        "humorless"
                    ],
                    "common_phrases": [
                        "humorous"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполненный юмором или вызывающий смех; смешной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "юмористический",
                                "target_lang_sense_clarification": "относящийся к юмору"
                            },
                            {
                                "target_lang_word": "забавный",
                                "target_lang_sense_clarification": "вызывающий улыбку"
                            },
                            {
                                "target_lang_word": "смешной",
                                "target_lang_sense_clarification": "вызывающий смех"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc718c8c-b2a3-34cc-bfb4-e5f9852b043e",
                    "sense_definition": "Showing humor; witty or jocular in character.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "funny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>humorous</w> remark lightened the mood during the long business meeting.",
                            "target_lang_translations": {
                                "ru": "Его <w>шутливое</w> замечание разрядило обстановку во время долгой деловой встречи."
                            }
                        },
                        {
                            "text": "The author is known for her <w>humorous</w> take on modern social issues.",
                            "target_lang_translations": {
                                "ru": "Автор известна своим <w>юмористическим</w> взглядом на современные социальные проблемы."
                            }
                        }
                    ],
                    "synonyms": [
                        "amusing",
                        "jocular",
                        "witty"
                    ],
                    "antonyms": [
                        "solemn"
                    ],
                    "common_phrases": [
                        "humorous remark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий юмор; остроумный или шутливый по характеру."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остроумный",
                                "target_lang_sense_clarification": "тонкий и находчивый"
                            },
                            {
                                "target_lang_word": "шутливый",
                                "target_lang_sense_clarification": "несерьезный, в форме шутки"
                            },
                            {
                                "target_lang_word": "юмористический",
                                "target_lang_sense_clarification": "содержащий юмор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecd7bd10-a095-328e-82da-09cda06ac003",
                    "sense_definition": "Dependent on or caused by one's mood; capricious or whimsical.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "moody",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old king was known to be <w>humorous</w> and often changed his mind without warning.",
                            "target_lang_translations": {
                                "ru": "Старый король был известен своей <w>капризностью</w> и часто менял свое мнение без предупреждения."
                            }
                        },
                        {
                            "text": "She struggled to understand his <w>humorous</w> inclination to suddenly leave the party.",
                            "target_lang_translations": {
                                "ru": "Ей было трудно понять его <w>причудливую</w> склонность внезапно покидать вечеринку."
                            }
                        }
                    ],
                    "antonyms": [
                        "constant",
                        "steady"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the sense of being moody or temperamental"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Зависящий от настроения или вызванный им; капризный или причудливый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капризный",
                                "target_lang_sense_clarification": "подвластный смене настроения"
                            },
                            {
                                "target_lang_word": "причудливый",
                                "target_lang_sense_clarification": "своевольный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3da7d54-1ec0-3cdb-b8ce-cc8889e0b5c6",
                    "sense_definition": "Damp, watery, or relating to the humors of the body.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "watery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient physician studied the <w>humorous</w> fluids to determine the patient's health.",
                            "target_lang_translations": {
                                "ru": "Древний врач изучал <w>гуморальные</w> жидкости, чтобы определить состояние здоровья пациента."
                            }
                        },
                        {
                            "text": "A <w>humorous</w> discharge from the wound indicated a slow healing process.",
                            "target_lang_translations": {
                                "ru": "<w>Влажные</w> выделения из раны указывали на медленный процесс заживления."
                            }
                        }
                    ],
                    "antonyms": [
                        "dry"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "relating to the four humors of early medicine"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Влажный, водянистый или относящийся к жидкостям (гуморам) тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гуморальный",
                                "target_lang_sense_clarification": "связанный с жидкостями организма"
                            },
                            {
                                "target_lang_word": "влажный",
                                "target_lang_sense_clarification": "содержащий влагу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}