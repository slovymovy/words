        "fr-extract.jsonl": [
            {
                "entry_id": "5fb0d2bc-ec03-3fd4-afb5-c5a6b6ac4812",
                "word": "apitoiement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "76a65cc5-a0e2-445a-a453-b3b6f3c1d74b",
                        "entry_id": "5fb0d2bc-ec03-3fd4-afb5-c5a6b6ac4812",
                        "tags": [
                            "plural"
                        ],
                        "form": "apitoiements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f070a4c-0364-3bb5-83eb-662f971468c4",
                        "entry_id": "5fb0d2bc-ec03-3fd4-afb5-c5a6b6ac4812",
                        "glosses": [
                            "Action de s’apitoyer, de se prendre en pitié, souvent au sens péjoratif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "007d5eb6-84fd-4eee-82ab-cae93209f689",
                                "sense_id": "5f070a4c-0364-3bb5-83eb-662f971468c4",
                                "text": "Camille, riant de son rire aigu, prit un air d’apitoiement railleur."
                            },
                            {
                                "example_id": "34cffb73-828c-4028-9de5-e75bfe917463",
                                "sense_id": "5f070a4c-0364-3bb5-83eb-662f971468c4",
                                "text": "Lʼempathie jure dʼautant plus avec ce terme et les autres (fraternité, équité) quʼelle appartient à une configuration de termes plus neutres axiologiquement: la compassion et le compassionnel, le compatissant, lʼapitoiement (souvent oublié)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d99fa62-178e-40c2-b3e2-ae52b05f22fc",
                        "source_entry_id": "5fb0d2bc-ec03-3fd4-afb5-c5a6b6ac4812",
                        "source_sense_id": "5f070a4c-0364-3bb5-83eb-662f971468c4",
                        "target_lang_word": "self-pity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-pity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3a89a24-e997-3b12-ba80-a62dd3699371",
                                        "entry_id": "7678c2ac-9818-3002-94c7-a6cbabbf4798",
                                        "glosses": [
                                            "A feeling of pity for oneself."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb6a2ed0-8998-4ef3-befa-afe848e5534c",
                                                "sense_id": "d3a89a24-e997-3b12-ba80-a62dd3699371",
                                                "text": "I was sitting in my room, wallowing in self pity, when my favorite TV program came on."
                                            },
                                            {
                                                "example_id": "33a9eec1-2cf2-41b2-91ab-00c2e8cba62d",
                                                "sense_id": "d3a89a24-e997-3b12-ba80-a62dd3699371",
                                                "text": "Things that were implicit and largely unjudged in the book, filtered through layers of stiff-upper-lip irony — Fanny’s self-pity, Linda’s obliviousness — are now foregrounded and, for the most part, rendered banal, with “Beaches”-level platitudes and sentimentality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b01d2be-5665-4f30-a60d-f6485a2af5d9",
                        "source_entry_id": "5fb0d2bc-ec03-3fd4-afb5-c5a6b6ac4812",
                        "source_sense_id": "5f070a4c-0364-3bb5-83eb-662f971468c4",
                        "target_lang_word": "erbarmen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erbarmen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c3623e0f-9431-3bad-8e64-a080e2288335",
                                        "entry_id": "d5c7bd01-09bf-356c-a6ed-84f0c46e80f8",
                                        "glosses": [
                                            "medelijden hebben met iemand"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "020002bf-cdcb-3ca3-bb99-1c21888e068a",
                                        "entry_id": "d5c7bd01-09bf-356c-a6ed-84f0c46e80f8",
                                        "glosses": [
                                            "zich ontfermen over iemand"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92800fd2-f143-4301-a334-663c932fb536",
                                                "sense_id": "020002bf-cdcb-3ca3-bb99-1c21888e068a",
                                                "text": "De geneesheer erbarmde zich over de zieke."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "erbarmen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7bcff9ab-3124-3379-8d11-d11fdc88d106",
                                        "entry_id": "85c314bc-83fb-36a1-9122-1ac9a639f1c6",
                                        "glosses": [
                                            "medeleven met de pijn of het ongeluk van een ander"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8720a711-b8dc-4dc5-ab69-30003bc03b21",
                                                "sense_id": "7bcff9ab-3124-3379-8d11-d11fdc88d106",
                                                "text": "Hebt erbarmen met een oude, zieke man."
                                            },
                                            {
                                                "example_id": "9c5167ac-ead1-4015-8e85-cb43f37d0001",
                                                "sense_id": "7bcff9ab-3124-3379-8d11-d11fdc88d106",
                                                "text": "Dit is het bewijs dat er dingen zijn die meer waard zijn dan alle diamanten op de wereld. Jouw erbarmen heeft het gewonnen, medelijden is meer waard dan diamanten.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40d4abc8-9f04-485c-8d57-15a828c64483",
                        "source_entry_id": "5fb0d2bc-ec03-3fd4-afb5-c5a6b6ac4812",
                        "source_sense_id": "5f070a4c-0364-3bb5-83eb-662f971468c4",
                        "target_lang_word": "mededogen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mededogen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5a9bfe07-b3e3-3114-9c83-1d83cdbb63d7",
                                        "entry_id": "24d7a00d-da32-34a6-9daa-ab06835a8302",
                                        "glosses": [
                                            "welwillend medelijden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41e6b977-be2a-4a82-b46a-88924038da3a",
                                                "sense_id": "5a9bfe07-b3e3-3114-9c83-1d83cdbb63d7",
                                                "text": "Hij kreeg geen mededogen van zijn vrienden."
                                            },
                                            {
                                                "example_id": "f2269054-a593-44c2-ae59-37d4e949c4bd",
                                                "sense_id": "5a9bfe07-b3e3-3114-9c83-1d83cdbb63d7",
                                                "text": "Engeland was ook het probleem niet, er was geen enkele reden voor mededogen met de onmenselijke Engelsen."
                                            },
                                            {
                                                "example_id": "fd97d86f-5ea9-4652-9e2d-3a91b408f136",
                                                "sense_id": "5a9bfe07-b3e3-3114-9c83-1d83cdbb63d7",
                                                "text": "Koning Willem-Alexander en koningin Máxima zeggen \"diep getroffen\" te zijn door zijn dood. \"Vanuit een rotsvast geloof in Gods liefde pleitte hij voor mededogen en menselijkheid. Sober en eenvoudig levend koos hij steeds de kant van de kwetsbaren en behoeftigen.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bb65192-796c-4f2f-962b-b03ab7817f64",
                        "source_entry_id": "5fb0d2bc-ec03-3fd4-afb5-c5a6b6ac4812",
                        "source_sense_id": "5f070a4c-0364-3bb5-83eb-662f971468c4",
                        "target_lang_word": "medelijden",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "medelijden",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8bb3dc66-64fd-3994-8f15-8b10b766756b",
                                        "entry_id": "7b1dd43d-c6c6-3544-b4b5-3a45885f1369",
                                        "glosses": [
                                            "verdriet over het leed van anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e3de2f8-53ef-4209-8103-ef6388a7bf9c",
                                                "sense_id": "8bb3dc66-64fd-3994-8f15-8b10b766756b",
                                                "text": "Ik heb echt medelijden met je."
                                            },
                                            {
                                                "example_id": "69aa8d38-694c-4177-a300-0b1eb1167494",
                                                "sense_id": "8bb3dc66-64fd-3994-8f15-8b10b766756b",
                                                "text": "Ze beschouwde ze niet langer als de problemen van rijke vrouwen, maar begon, in haar eigen ellendige toestand, tot haar eigen verbazing, medelijden met haar te krijgen."
                                            },
                                            {
                                                "example_id": "13db5de0-d833-49e5-906a-221c56c09628",
                                                "sense_id": "8bb3dc66-64fd-3994-8f15-8b10b766756b",
                                                "text": "Een vrouwenstem, dus niet de nukkige eigenaar die me zonder medelijden naar de kerk stuurde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29d483c6-ddd9-4178-a98f-89012adf513e",
                        "source_entry_id": "5fb0d2bc-ec03-3fd4-afb5-c5a6b6ac4812",
                        "source_sense_id": "5f070a4c-0364-3bb5-83eb-662f971468c4",
                        "target_lang_word": "compassie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compassie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2b64339d-c2f3-3365-94a4-8a735bc1ba2d",
                                        "entry_id": "627fc41a-15d2-3eb1-8d05-42eb25ec5629",
                                        "glosses": [
                                            "medelijden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8385ad8-2265-4300-941b-51a05527cd63",
                                                "sense_id": "2b64339d-c2f3-3365-94a4-8a735bc1ba2d",
                                                "text": "Dan regeerde de kille gereserveerdheid. Gecamoufleerd door een verraderlijke cocon van gesuggereerde vriendschap en compassie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
