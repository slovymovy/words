                "translations": [
                    {
                        "translation_id": "36209656-24ea-45cb-abf3-40451bde3dd4",
                        "source_entry_id": "73c4e9a2-efcb-3326-8012-099795e4b262",
                        "source_sense_id": "dfc8d9aa-9a32-30d7-b056-5d6c0a971343",
                        "target_lang_word": "accomplishment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accomplishment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44c1c264-e6b6-3ec7-ae55-2a02cd284726",
                                        "entry_id": "09529955-bc32-3442-8ff1-644a5ba00cdb",
                                        "glosses": [
                                            "The act of accomplishing; completion; fulfilment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c621f557-5275-419a-aeb8-c38089e5269f",
                                                "sense_id": "44c1c264-e6b6-3ec7-ae55-2a02cd284726",
                                                "text": "the accomplishment of an enterprise, of a prophecy, etc"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee70385a-044f-30c1-b90f-444b942bf7fc",
                                        "entry_id": "09529955-bc32-3442-8ff1-644a5ba00cdb",
                                        "glosses": [
                                            "That which completes, perfects, or equips thoroughly; acquirement; attainment; that which constitutes excellence of mind, or elegance of manners, acquired by education or training."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4864e481-118a-4364-95d5-a6bf6332f28b",
                                                "sense_id": "ee70385a-044f-30c1-b90f-444b942bf7fc",
                                                "text": "I’ll make a proof how I advance in / My new accomplishment of dancing."
                                            },
                                            {
                                                "example_id": "547453aa-1949-4466-b698-62d79f6daa39",
                                                "sense_id": "ee70385a-044f-30c1-b90f-444b942bf7fc",
                                                "text": "Accomplishments have taken virtue’s place, / And wisdom falls before exterior grace ;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2151462-37cb-3103-a869-21615015a491",
                                        "entry_id": "09529955-bc32-3442-8ff1-644a5ba00cdb",
                                        "glosses": [
                                            "Something accomplished; an achievement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5627ce5b-4207-4caf-8a5f-dfb42b8db4f5",
                                                "sense_id": "b2151462-37cb-3103-a869-21615015a491",
                                                "text": "Increasing sales by 20% in the last quarter was seen as a major accomplishment for the business."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e865e8f5-515d-39b3-a1ae-b32b47313be7",
                                        "entry_id": "09529955-bc32-3442-8ff1-644a5ba00cdb",
                                        "glosses": [
                                            "The lexical aspect (aktionsart) of verbs or predicates that change over time until a natural end point."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75624f2c-3941-4ba6-a757-750a409d4e8f",
                                                "sense_id": "e865e8f5-515d-39b3-a1ae-b32b47313be7",
                                                "text": "Thus it is attested that some children have taken an accomplishment verb like disappear, which does not have a causative counterpart, and used it as a causative accomplishment in sentences like He disappeared it, i.e. ‘He made it disappear.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63f2b5b5-51a7-45f9-bc97-74d31a38e37f",
                        "source_entry_id": "73c4e9a2-efcb-3326-8012-099795e4b262",
                        "source_sense_id": "dfc8d9aa-9a32-30d7-b056-5d6c0a971343",
                        "target_lang_word": "fulfilment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fulfilment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fdc467c-7b2e-3948-84d3-3f65e4b782a1",
                                        "entry_id": "98414e19-2fd2-3c54-921b-92dd4b0cc34d",
                                        "glosses": [
                                            "The act of fulfilling or the state or quality of being fulfilled; consummation; completion; realization."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60f001a8-18e8-48ff-bc77-a5255df34a1e",
                                                "sense_id": "7fdc467c-7b2e-3948-84d3-3f65e4b782a1",
                                                "text": "To achieve fulfilment of one's hopes."
                                            },
                                            {
                                                "example_id": "99480d37-9ed1-4e70-a86e-9388f538aa6f",
                                                "sense_id": "7fdc467c-7b2e-3948-84d3-3f65e4b782a1",
                                                "text": "Fulfilment of contractual obligations."
                                            },
                                            {
                                                "example_id": "8dfc1842-8f99-44a1-ae57-b010283b81a6",
                                                "sense_id": "7fdc467c-7b2e-3948-84d3-3f65e4b782a1",
                                                "text": "We have yet to see the fulfilment of his potential."
                                            },
                                            {
                                                "example_id": "221e5d57-7b80-4910-aa83-a002121c726c",
                                                "sense_id": "7fdc467c-7b2e-3948-84d3-3f65e4b782a1",
                                                "text": "Civilisation has imbued man's minds with false ideas of the evil of sex and its fulfilment."
                                            },
                                            {
                                                "example_id": "3762a95f-54c2-4d73-977e-070696a304f7",
                                                "sense_id": "7fdc467c-7b2e-3948-84d3-3f65e4b782a1",
                                                "text": "In questi casi, la morte non è dunque una fine, ma un compimento."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69bfe345-e992-3c98-8854-6b7af2d1d8f2",
                                        "entry_id": "98414e19-2fd2-3c54-921b-92dd4b0cc34d",
                                        "glosses": [
                                            "A feeling of satisfaction obtained from one's aspirations or needs being fulfilled."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e620ce3d-513b-4d0a-9763-c89f349af2eb",
                                                "sense_id": "69bfe345-e992-3c98-8854-6b7af2d1d8f2",
                                                "text": "What brings you fulfilment in life?"
                                            },
                                            {
                                                "example_id": "357aff1f-9983-4b78-b604-b2014dd2f352",
                                                "sense_id": "69bfe345-e992-3c98-8854-6b7af2d1d8f2",
                                                "text": "Personal fulfilment comes from having a sense of purpose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a113f36-f94a-37b3-8356-0c79fab4ea3b",
                                        "entry_id": "98414e19-2fd2-3c54-921b-92dd4b0cc34d",
                                        "glosses": [
                                            "The activities performed once an order is received to fulfill the order; packaging, distributing and shipping goods."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47cccba2-5bf0-476c-baff-6b36edee0e2f",
                        "source_entry_id": "73c4e9a2-efcb-3326-8012-099795e4b262",
                        "source_sense_id": "dfc8d9aa-9a32-30d7-b056-5d6c0a971343",
                        "target_lang_word": "accomplissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accomplissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6b1d656-d241-3ad1-92a3-9dec978894b5",
                                        "entry_id": "9e0aefd6-8774-3ea0-a07a-5820548453da",
                                        "glosses": [
                                            "Action d’accomplir ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3959fa0-4da5-486a-9090-67c31177fe7b",
                                                "sense_id": "d6b1d656-d241-3ad1-92a3-9dec978894b5",
                                                "text": "[…], cependant il arrive certaines choses qui laissent une trace, certaines prophéties qui ont un accomplissement."
                                            },
                                            {
                                                "example_id": "acc2c8f1-81f7-4f5c-9cfb-4aef2f415cd2",
                                                "sense_id": "d6b1d656-d241-3ad1-92a3-9dec978894b5",
                                                "text": "[…], tout concourait en même temps pour préparer la chute de la branche aînée des Bourbons; mais, de la probabilité à l’accomplissement du fait, il y avait loin , et l'on ne peut disconvenir que M. Thiers et tous les instigateurs du mouvement ne jouassent gros jeu."
                                            },
                                            {
                                                "example_id": "896d7f77-5eb6-455e-920c-64e27688db85",
                                                "sense_id": "d6b1d656-d241-3ad1-92a3-9dec978894b5",
                                                "text": "Le soldat des guerres de la Liberté attachait une importance presque supersti­tieuse à l’accomplissement des moindres consignes."
                                            },
                                            {
                                                "example_id": "b02cdfe3-d89d-48c0-9427-4da14696ceeb",
                                                "sense_id": "d6b1d656-d241-3ad1-92a3-9dec978894b5",
                                                "text": "Je crois que le sens qu’elle trouvait à son travail, le sentiment de se sentir utile, de pouvoir mesurer les effets de son engagement, sa volonté de sortir de sa propre souffrance pour tenter d’apaiser celle des autres, furent pour elle une source de stabilité voire, pour la première fois de sa vie, d’accomplissement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95c42cd5-002c-4062-928d-601159d08da5",
                        "source_entry_id": "73c4e9a2-efcb-3326-8012-099795e4b262",
