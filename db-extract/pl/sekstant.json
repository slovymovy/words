                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ddb89683-07b6-3b44-8852-f00a9e352b3e",
                                        "entry_id": "db491ae8-8735-3346-b1f6-d4a074d07008",
                                        "glosses": [
                                            "Sexta parte del círculo."
                                        ],
                                        "tags": [
                                            "Matemáticas"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3f00fa3c-286e-3dba-b2a0-d1dc2d384a8e",
                                        "entry_id": "db491ae8-8735-3346-b1f6-d4a074d07008",
                                        "glosses": [
                                            "Moneda de cobre antigua usada por los romanos, que pesaba dos onzas y valía un sexto del as."
                                        ],
                                        "tags": [],
