                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0960d537-245a-40a9-b69c-1b31038c3bc5",
                        "source_entry_id": "e8d34c35-2f4e-3675-9123-cdc89c4bdce2",
                        "source_sense_id": "3cad1043-3121-3521-a898-b2528eac9c0c",
                        "target_lang_word": "asozial",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asozial",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "adb4e3d6-0b16-366e-b355-b7e4e9bf0441",
                                        "entry_id": "b35019a8-1e9f-3162-9706-bd59f2b6e9b1",
                                        "glosses": [
                                            "nicht fähig oder nicht willig, in einer Gemeinschaft beziehungsweise Gesellschaft zu leben und eines solchen Gutes zu tun"
                                        ],
                                        "tags": [
                                            "diskriminierend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eee2a919-76ef-435f-89e8-cb73396b42e7",
                                                "sense_id": "adb4e3d6-0b16-366e-b355-b7e4e9bf0441",
                                                "text": "„Soziale Fragen löst man, indem man asozialen Fragern den Lebensraum entzieht.“"
                                            },
                                            {
                                                "example_id": "ae52a93c-a4ca-46fb-9606-1111e7b5c489",
                                                "sense_id": "adb4e3d6-0b16-366e-b355-b7e4e9bf0441",
                                                "text": "„Sachlich betrachtet ist das Rauchen ungesund und asozial – asozial nicht im Sinne, daß es nicht Menschen auch verbände, sondern in dem der Belästigung.“"
                                            },
                                            {
                                                "example_id": "8c47728c-2e6e-43db-9883-b29ed411575c",
                                                "sense_id": "adb4e3d6-0b16-366e-b355-b7e4e9bf0441",
                                                "text": "„Das war für mich und meine Familie sehr schwer und vom HSV sehr asozial.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ddfe5875-d9f4-3887-a576-c8708cf992ac",
                                        "entry_id": "b35019a8-1e9f-3162-9706-bd59f2b6e9b1",
                                        "glosses": [
                                            "die Gemeinschaft beschädigend"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7861c85f-031a-4f1d-bbd4-6762a3a3c70b",
                                                "sense_id": "ddfe5875-d9f4-3887-a576-c8708cf992ac",
                                                "text": "„Wenn harmlose Passanten von vermummten Halbstarken angegriffen werden, wenn auf Frauen und Alte eingeschlagen wird, das ist dermaßen asozial, das habe ich selten gesehen.“"
                                            },
                                            {
                                                "example_id": "2cd1aaa6-71e5-47a6-8f3f-c5ae1f86907b",
                                                "sense_id": "ddfe5875-d9f4-3887-a576-c8708cf992ac",
                                                "text": "„Das war für mich und meine Familie sehr schwer und vom HSV sehr asozial.“"
                                            },
                                            {
                                                "example_id": "e75c903e-69e2-49fa-9e19-f75fa167e897",
                                                "sense_id": "ddfe5875-d9f4-3887-a576-c8708cf992ac",
                                                "text": "„Man wurde sogar noch deutlicher und verurteilte das Geschehen: ‚Um es ganz deutlich zu sagen: Mit derart asozialen und völlig sinnbefreiten Handlungen werden Grenzen überschritten und man kann sich als Verein für so ein Verhalten nur schämen. […]‘ […]“"
                                            },
                                            {
                                                "example_id": "f82b2181-31b3-4246-ace5-348ae9161289",
                                                "sense_id": "ddfe5875-d9f4-3887-a576-c8708cf992ac",
                                                "text": "„Aus meiner Sicht sind Ratenkredite mit eingebauter Versicherung derzeit das größte Ärgernis am deutschen Finanzmarkt, ein wirklich unanständiges Geschäftsmodell. Das Verhalten vieler Institute kann man nur als asozial bezeichnen.“"
                                            },
                                            {
                                                "example_id": "406a0b41-9106-4315-aab6-e69f1529cece",
                                                "sense_id": "ddfe5875-d9f4-3887-a576-c8708cf992ac",
                                                "text": "Die asoziale Nachbarschaft stiegen unerlaubt aus purer gestörten Neugierde in die Wohnung des menschenscheuen Nachbarn ein, damit zeigte die respektlose Nachbarschaft ihren Charaktermangel auf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "99fcf121-41f6-3269-b02d-38eb0adff4d3",
                                        "entry_id": "b35019a8-1e9f-3162-9706-bd59f2b6e9b1",
                                        "glosses": [
                                            "untiefes geistiges, kulturelles Niveau besitzend; unbedarft und ungesittet"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41c2b792-cab1-4f83-9021-6305aa488e39",
                                                "sense_id": "99fcf121-41f6-3269-b02d-38eb0adff4d3",
                                                "text": "„Wenn harmlose Passanten von vermummten Halbstarken angegriffen werden, wenn auf Frauen und Alte eingeschlagen wird, das ist dermaßen asozial, das habe ich selten gesehen.“"
                                            },
                                            {
                                                "example_id": "8781d2df-4f16-4bb6-ac97-1f7ae6379b91",
                                                "sense_id": "99fcf121-41f6-3269-b02d-38eb0adff4d3",
                                                "text": "Die junge Landpomeranze verhielt sich als Neue gegenüber dem älteren Mitarbeiter asozial, indem sie ihn ungefragt duzte und später unerlaubt seinen Rucksack durchwühlte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1a6dd35a-8806-336c-85f1-0f5eda8c9b9f",
                                        "entry_id": "b35019a8-1e9f-3162-9706-bd59f2b6e9b1",
                                        "glosses": [
                                            "in ärmlichen oder verwahrlosten Verhältnissen lebend"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fae624e0-c3f4-4b62-810e-b4424edfc58e",
                                                "sense_id": "1a6dd35a-8806-336c-85f1-0f5eda8c9b9f",
                                                "text": "„Schon fünf Jahre später fand die Wochenzeitschrift ‚Der Spiegel‘ andere Bezeichnungen für den Stadtteil: ein Slum vom Reißbrett, ein Musterbeispiel für asozialen Wohnungsbau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c2e171b-46d5-4a79-90c0-4e8d7b1d4a0c",
                        "source_entry_id": "e8d34c35-2f4e-3675-9123-cdc89c4bdce2",
                        "source_sense_id": "3cad1043-3121-3521-a898-b2528eac9c0c",
                        "target_lang_word": "antisocial",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antisocial",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ea387f6-18b7-3680-8f21-9bbec59064f6",
                                        "entry_id": "b38d7dc3-343d-3ded-8c9c-00e4afa0afb6",
                                        "glosses": [
                                            "Qui est contraire à la société, qui tend à la dissolution de la société."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac4dbb77-0954-4caa-8d26-ae0268ad6560",
                                                "sense_id": "3ea387f6-18b7-3680-8f21-9bbec59064f6",
                                                "text": "Quelle est la maîtresse de maison qui n’a pas, depuis 1838, éprouvé les funestes résultats des doctrines antisociales répandues dans les classes inférieures par des écrivains incendiaires ?"
                                            },
                                            {
                                                "example_id": "d1808f48-4efb-41e3-ba42-eb9792784792",
                                                "sense_id": "3ea387f6-18b7-3680-8f21-9bbec59064f6",
                                                "text": "La tendance antisociale, ou délinquance, trouve ses racines dans ces carences précoces et est comme des appels au secours de jeunes qui, pendant un temps long et indéterminé, ont connu la douleur du sentiment de solitude."
                                            },
                                            {
                                                "example_id": "38148b41-edc9-42b5-9ce5-ecdcc65960a2",
                                                "sense_id": "3ea387f6-18b7-3680-8f21-9bbec59064f6",
                                                "text": "Les divers savants ont démontré que tous les types de dégénérescence se caractérisent toujours par les qualités antisociales, et plus la dégénérescence s’accentue, plus les qualités antisociales se montrent fortes et développées : jusqu’à ce qu’enfin la dégénérescence de l’homme aboutisse à des types absolument incapables de toute vie sociale, c’est-à-dire à une idiotie complète, où l’être humain dégénéré apparaît incapable de toute vie intellectuelle, de tout langage humain, et même de tout mouvement coordonné."
                                            },
                                            {
                                                "example_id": "e809a876-5c4f-4217-9bcf-db2e188a4a34",
                                                "sense_id": "3ea387f6-18b7-3680-8f21-9bbec59064f6",
                                                "text": "Enfin, c’était une terrible, une vivante image de ces compromis antisociaux que font les trop faibles représentants du pouvoir avec de sauvages émeutiers."
                                            },
                                            {
                                                "example_id": "c41df0c9-dfb1-4a88-8b53-d3693f27c515",
                                                "sense_id": "3ea387f6-18b7-3680-8f21-9bbec59064f6",
                                                "text": "– La télé est un art de foules, dit Daniel. Tu ne peux pas exiger pour toi ce qui ne convient pas aux autres. Ou alors, tu es antisocial !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e8245e6-e075-3b22-a34c-f5f5dc094c8b",
                                        "entry_id": "b38d7dc3-343d-3ded-8c9c-00e4afa0afb6",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ad01c05-b3a8-4f15-8f9b-17b79ea8eff7",
                                                "sense_id": "6e8245e6-e075-3b22-a34c-f5f5dc094c8b",
                                                "text": "Dutton et Kerry (1999) mentionnent que les uxoricides présentent plus souvent un trouble de la personnalité schizoïde, évitante, dépendante, passive-agressive et moins souvent un trouble de la personnalité antisociale comparativement aux hommes qui ont fait de la violence conjugale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
