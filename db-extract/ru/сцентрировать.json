                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bd6248e-03cb-4e85-9ce6-ec4057d73f80",
                                "sense_id": "3df7cac4-17d5-3648-8f69-c64043f69db8",
                                "text": "Все элементы оптической и осветительной систем нужно расположить на одной оси — «сцентрировать»."
                            },
                            {
                                "example_id": "008e6116-761e-4ca2-bd7c-b027a5dd18a1",
                                "sense_id": "3df7cac4-17d5-3648-8f69-c64043f69db8",
                                "text": "Автоматическое управление тут же помогает роботу сцентрировать и правильно собрать детали."
                            }
                        ]
                    }
