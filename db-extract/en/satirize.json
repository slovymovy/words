                                        "sense_id": "e45458dd-dad1-3777-b6ef-9f7e199c97ba",
                                        "entry_id": "b2ea3fb0-9957-3d84-b74b-df76cca0bca9",
                                        "glosses": [
                                            "sich boshaft über jemanden oder etwas lustig machen; über jemanden oder etwas spotten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b19b6989-9f07-4490-8665-55fe8017d67f",
                                                "sense_id": "e45458dd-dad1-3777-b6ef-9f7e199c97ba",
                                                "text": "Die Klassenkameraden verspotten den kleinen Jungen."
                                            },
                                            {
                                                "example_id": "1d8ff0c3-b198-4e74-9991-4cf01ed93018",
                                                "sense_id": "e45458dd-dad1-3777-b6ef-9f7e199c97ba",
                                                "text": "„Drei schwarze Vögel verspotten ihn mit einem Lied auf die Sinnlosigkeit alles menschlichen Tuns.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "492752bb-d8dc-44fa-83eb-77b0d4c2e8aa",
                        "source_entry_id": "a55ef810-45f5-33e7-adf3-5e5f38768f12",
                        "source_sense_id": "83c7a63d-d59e-371e-bb25-40bf5a310daf",
                        "source_sense_description": "make a satire",
                        "target_lang_word": "verhöhnen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verhöhnen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "371aaa36-8317-3530-bcec-2b823d0c2e2f",
                                        "entry_id": "d32a4721-e37c-34e6-aa0f-171f09a46e68",
                                        "glosses": [
                                            "sich über jemanden lustig machen; jemanden verspotten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa70a3ea-7a43-4744-8d3f-44aedca09dc2",
                                                "sense_id": "371aaa36-8317-3530-bcec-2b823d0c2e2f",
                                                "text": "Er wurde von Zeitgenossen wegen seiner kühnen Ideen verhöhnt."
                                            },
                                            {
                                                "example_id": "d0ea74c3-13da-4de8-bac7-53a6feedf527",
                                                "sense_id": "371aaa36-8317-3530-bcec-2b823d0c2e2f",
                                                "text": "„Erst werden die Menschen unters Joch gezwungen und dann als knechtisch verachtet, unterdrückt und dann von oben herab behandelt, verdummt und ihrer Dummheit wegen verhöhnt, versklavt und als Sklaven geschmäht.“"
                                            },
                                            {
                                                "example_id": "48273ce3-beb3-411c-bc2e-d29a0792f145",
                                                "sense_id": "371aaa36-8317-3530-bcec-2b823d0c2e2f",
                                                "text": "„Und er hatte es natürlich in blindem Gehorsam getan, hatte eine trauernde Familie verhöhnt, eingeschüchtert und bedroht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
