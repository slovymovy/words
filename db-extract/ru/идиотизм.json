                        "examples": [
                            {
                                "example_id": "abdec56e-3bb5-42e7-97c7-3dfad29c5ee8",
                                "sense_id": "7b200a51-7fd3-3a67-a336-b60c07271929",
                                "text": "Идиотизм обывательской жизни"
                            }
                        ]
                    },
                    {
                        "sense_id": "b40faa5f-7a6d-3218-b39c-8963a2559032",
                        "entry_id": "581f9d0e-3670-37cf-8a9d-bf87a065ff0a",
                        "glosses": [
                            "разг. глупость, бессмыслица"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "279b9615-6da3-46f1-be67-3b068eacc633",
                                "sense_id": "b40faa5f-7a6d-3218-b39c-8963a2559032",
                                "text": "Может зайти в класс и сказать «Спрашиваю всех, кто пришёл в красном»! Во идиотизм! Учителя чувствуют себя безнаказаными и творят что хотят."
                            }
                        ]
                    },
                    {
                        "sense_id": "827b0f42-7ceb-36fb-98bf-4d15a5ccff2c",
                        "entry_id": "581f9d0e-3670-37cf-8a9d-bf87a065ff0a",
                        "glosses": [
                            "разг. бессмысленный, глупый поступок, поведение и т. п."
                        ],
                        "tags": [],
                        "examples": []
                    }
