                        "sense_id": "8a71a6fa-2a3e-3d01-89d9-7aa0994bdf64",
                        "entry_id": "83b4248c-671c-38da-93d1-178126eac540",
                        "glosses": [
                            "сокр. от городская государственная администрация"
