                "senses": [
                    {
                        "sense_id": "cd464a94-35eb-3ab3-a49d-aecd9fce2774",
                        "entry_id": "81ec4671-d7b3-34b5-b196-7856fd400d32",
                        "glosses": [
                            "физ. обладающий электропроводностью; способный проводить электрический ток"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08e03651-8852-41f5-a5f4-f6265cc9cb56",
                                "sense_id": "cd464a94-35eb-3ab3-a49d-aecd9fce2774",
                                "text": "Ведь при катастрофическом сжатии электропроводной среды должен сохраняться магнитный поток, а это означает, что магнитное поле будет при таком сжатии расти обратно пропорционально квадрату радиуса ядра."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b635e38-5e13-42e4-a7ad-903f1f55965a",
                        "source_entry_id": "81ec4671-d7b3-34b5-b196-7856fd400d32",
                        "source_sense_id": "cd464a94-35eb-3ab3-a49d-aecd9fce2774",
                        "target_lang_word": "electroconductive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "electroconductive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "919bf5c1-038b-3999-bcde-fdc8b7196ad8",
                                        "entry_id": "2f7143d9-7ad9-323b-9cb5-78fd22d504fd",
                                        "glosses": [
                                            "Able to conduct electricity"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b0a92d0-5535-4300-acc5-a185b71f85fb",
                                                "sense_id": "919bf5c1-038b-3999-bcde-fdc8b7196ad8",
                                                "text": "Up to this point, attention has been primarily given to the background information needed to define the intermediate and end-use requirements for the electroconductive-base paper."
                                            },
                                            {
                                                "example_id": "44953089-340b-4eb7-8feb-d04408de0569",
                                                "sense_id": "919bf5c1-038b-3999-bcde-fdc8b7196ad8",
                                                "text": "Potentiometry is the simplest form of sensing that uses electroconductive polymers but may also be the most challenging to control."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
