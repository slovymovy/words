                "senses": [
                    {
                        "sense_id": "16a78933-5c96-3b87-9574-797208bcf75d",
                        "entry_id": "94dc543a-4828-3193-85a5-55a6f52996bc",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным след"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5802b4c-bfd6-4103-a283-6fce0c8c0d5b",
                                "sense_id": "16a78933-5c96-3b87-9574-797208bcf75d",
                                "text": "Лишь через несколько вегетативных делений такой следовой эффект протоплазмы модификанта полностью исчезает."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd41b839-6c0b-3525-9c01-2435c64b9312",
                        "entry_id": "94dc543a-4828-3193-85a5-55a6f52996bc",
                        "glosses": [
                            "связанный с поиском следов, предназначенный для выявления, поиска следов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68b5774c-99ea-4c4c-bd3b-fc4e0af9f3be",
                                "sense_id": "fd41b839-6c0b-3525-9c01-2435c64b9312",
                                "text": "После долгих споров Мухтару выставили за следовую работу пятерку."
                            },
                            {
                                "example_id": "2db049e4-9ebc-4ca6-95e1-ad9feeae565c",
                                "sense_id": "fd41b839-6c0b-3525-9c01-2435c64b9312",
                                "text": "Он попросил у МВД следовых собак."
                            }
                        ]
                    },
                    {
                        "sense_id": "316d2194-4768-388d-b435-65ead9b8a7b4",
                        "entry_id": "94dc543a-4828-3193-85a5-55a6f52996bc",
                        "glosses": [
                            "спец. представляющий собой след присутствия чего-либо (вещества и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11f2c9ba-bb39-4316-b0e4-073552873556",
                                "sense_id": "316d2194-4768-388d-b435-65ead9b8a7b4",
                                "text": "При следовом контактировании объекты подвергаются физическому, химическому или биологическому воздействию."
                            }
                        ]
                    }
                ],
