        "fr-extract.jsonl": [
            {
                "entry_id": "40fa345f-5f72-3d47-9cb2-4549fac1ecbb",
                "word": "enrôlement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a3048f0a-8007-4f28-80fc-a4ae1ec61cc7",
                        "entry_id": "40fa345f-5f72-3d47-9cb2-4549fac1ecbb",
                        "tags": [
                            "plural"
                        ],
                        "form": "enrôlements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "52de1257-558c-3b55-9e89-9c578027f2c5",
                        "entry_id": "40fa345f-5f72-3d47-9cb2-4549fac1ecbb",
                        "glosses": [
                            "Action d’enrôler ou de s’enrôler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "156432eb-c281-4152-b0a4-fce57750b6d8",
                                "sense_id": "52de1257-558c-3b55-9e89-9c578027f2c5",
                                "text": "La Commune décréta le 29 mars l’abolition de la conscription et l’enrôlement dans la garde nationale de tous les citoyens valides."
                            },
                            {
                                "example_id": "4f591d47-6dc3-4132-a677-8ffde4c28f02",
                                "sense_id": "52de1257-558c-3b55-9e89-9c578027f2c5",
                                "text": "En réalité, l’effectif sous les armes n’atteint pas un tiers de ce nombre; […]. Puis, quand l’ordre de mobiliser arrive, on complète rapidement le chiffre par l’enrôlement, de gré ou de force, de mendiants et de vagabonds sans feu ni lieu, de la lie de la population."
                            }
                        ]
                    },
                    {
                        "sense_id": "b03f9296-04ae-342f-ad5b-210f4503a4c6",
                        "entry_id": "40fa345f-5f72-3d47-9cb2-4549fac1ecbb",
                        "glosses": [
                            "Acte, feuille où l’enrôlement est inscrit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8681c262-5a61-4d2d-a9e8-be2519b1f066",
                                "sense_id": "b03f9296-04ae-342f-ad5b-210f4503a4c6",
                                "text": "J’ai son enrôlement dans ma poche. — Signer son enrôlement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22b7fde8-dbf2-4b46-8e98-dc6cb9b2c4ab",
                        "source_entry_id": "40fa345f-5f72-3d47-9cb2-4549fac1ecbb",
                        "source_sense_description": "Action d’enrôler",
                        "target_lang_word": "Werbung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Werbung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3edb185a-4ac0-3710-bcd7-85293a43f7e6",
                                        "entry_id": "797ad6d2-2234-36b9-9766-d9f819fd2fee",
                                        "glosses": [
                                            "in verschiedener Weise verbreitete Informationen zu dem Zweck, Kunden, Käufer, Mitglieder oder Ähnliches zu bekommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae12b678-c738-4544-9b7b-8eb4bd431453",
                                                "sense_id": "3edb185a-4ac0-3710-bcd7-85293a43f7e6",
                                                "text": "Er wirbt seine Kunden mit einer neuen Form der Werbung."
                                            },
                                            {
                                                "example_id": "2f00737c-c229-4553-9d69-a85d153d4f7a",
                                                "sense_id": "3edb185a-4ac0-3710-bcd7-85293a43f7e6",
                                                "text": "„Die grelle Werbung sprang ihn an, und er schaltete sofort aus.“"
                                            },
                                            {
                                                "example_id": "cea8f646-9c15-4815-8b54-3b6a2ea28aac",
                                                "sense_id": "3edb185a-4ac0-3710-bcd7-85293a43f7e6",
                                                "text": "„Am Haus neben dem Bayersturm kann man Brot und Brötchen kaufen, weil laut Werbung »Frisches besser schmeckt«.“"
                                            },
                                            {
                                                "example_id": "fc3714ee-272d-41c0-9fe9-85f5ad1595e9",
                                                "sense_id": "3edb185a-4ac0-3710-bcd7-85293a43f7e6",
                                                "text": "„In der Regel mieteten Firmen, die die jüdischen Einwanderer als Absatzmarkt entdeckt hatten, Sendeplätze bei lokalen amerikanischen Radiostationen und boten zu festen Zeiten ein kommerzielles Programm mit Unterhaltung und Werbung in jiddischer Sprache.“"
                                            },
                                            {
                                                "example_id": "80802938-e282-4eb0-8be2-ea18b37ef3c1",
                                                "sense_id": "3edb185a-4ac0-3710-bcd7-85293a43f7e6",
                                                "text": "„Und dennoch war es gerade seine Durchschlagskraft, die das Ausrufezeichen in den Jahrzehnten nach den freizügigen und verführerischen 1920er Jahren zu einem mächtigen Werkzeug nicht etwa der gottlosen Kunst, sondern von Propaganda und Werbung machte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "019142b9-66c5-3195-8454-91cb550355f7",
                                        "entry_id": "797ad6d2-2234-36b9-9766-d9f819fd2fee",
                                        "glosses": [
                                            "Versuch, eine Frau zu überzeugen, dass sie die Ehe mit einem selbst oder einem Dritten eingeht"
                                        ],
                                        "tags": [
                                            "outdated",
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dce4ec4-f82c-40af-81d2-26883f1dd4d7",
                                                "sense_id": "019142b9-66c5-3195-8454-91cb550355f7",
                                                "text": "Die Werbung löste den Brautkauf ab so wie später der demokratische Betrug die feudale Gewalt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
