                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8e98166-c699-470a-b282-c32cc9585df4",
                                                "sense_id": "585b0cfa-bb72-3c82-88b1-064d154708bf",
                                                "text": "I always keep a tin of sea salt in the pantry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb6dcac6-a31e-3e19-9fda-31266dd43de0",
                                        "entry_id": "6842853f-9f17-3823-9978-1592fcd6e897",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see sea, salt: salt in the sea."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30a6c401-3ec4-4cec-81cb-1d9201b341d3",
                                                "sense_id": "fb6dcac6-a31e-3e19-9fda-31266dd43de0",
                                                "text": "This is a saltwater fish. It needs ambient sea salt to survive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5be24e9-ced9-498d-868e-96d0f0b40d87",
                        "source_entry_id": "ee89713e-1a6a-38c9-9a18-9bd4eaca2b41",
                        "source_sense_id": "8d65d6c9-9c14-3f03-8272-49afba78b6a4",
                        "source_sense_description": "durch Eindampfen von Meerwasser gewonnenes Salz",
                        "target_lang_word": "sel marin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sel marin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a14fafc1-8aed-3d5e-852c-487bf0029e75",
                                        "entry_id": "050a1cba-7b62-3511-aab7-4052e439ce05",
                                        "glosses": [
                                            "Sel obtenu par évaporation de l’eau de mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57f5a4f9-2620-482a-abce-bb7cd55ce59b",
                                                "sense_id": "a14fafc1-8aed-3d5e-852c-487bf0029e75",
                                                "text": "Nous citerons les solutions aqueuses étendues de chlorure de cobalt, d’acétate ou de nitrate de cobalt, mêlées de 1/4 de sel marin; elles donnent une encre sympathique avec laquelle l'écriture, invisible sur le papier, apparaît en bleu par une légère application de la chaleur, puis disparaît ensuite par degrés, à mesure que le chlorure de cobalt reprend de l'eau, et reparaît de nouveau par la chaleur."
                                            },
                                            {
                                                "example_id": "bcd8b790-b6c9-4691-90f2-e90695121baa",
                                                "sense_id": "a14fafc1-8aed-3d5e-852c-487bf0029e75",
                                                "text": "Grâce à une molécule appelée éctoïne, cette bactérie arrive à survivre à la forte pression que le sel marin exerce sur ses membranes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6abda97-a32b-4adc-9799-e951b8940668",
                        "source_entry_id": "ee89713e-1a6a-38c9-9a18-9bd4eaca2b41",
                        "source_sense_id": "8d65d6c9-9c14-3f03-8272-49afba78b6a4",
                        "source_sense_description": "durch Eindampfen von Meerwasser gewonnenes Salz",
                        "target_lang_word": "sel de mer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sel de mer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9224bb89-6582-3d07-b6ff-dccbbef39af7",
                                        "entry_id": "a696a616-8782-3685-8393-c2397e6d301d",
                                        "glosses": [
                                            "Chlorure de sodium quasiment pur obtenu par évaporation de l'eau de mer qui en contient une trentaine de grammes par litre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67eaa6a4-006a-48f2-bc55-9723c0b0831d",
                                                "sense_id": "9224bb89-6582-3d07-b6ff-dccbbef39af7",
                                                "text": "Le sel de mer est produit par l'évaporation d'eau de mer, qui permet d'obtenir du chlorure de sodium (NaCl). L'iode étant volatil, il disparaît avec l'évaporation de l'eau. De nombreuses personnes pensent que le sel de mer est meilleur pour la santé parce qu'il est naturel et «non modifié» - ce qui est doublement fâcheux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1e18cfa-7c03-43a5-af54-1e1f66ecea06",
