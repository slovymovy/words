                                    {
                                        "sense_id": "aab98ce8-7007-36f7-ac0c-dd73ed4960a7",
                                        "entry_id": "bd5d963f-9565-3926-b3f0-57181dda8678",
                                        "glosses": [
                                            "Of or pertaining to monism; characterized by one single principle, being or force."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7564783b-e2a7-48ad-b912-a21e39a40f57",
                                                "sense_id": "aab98ce8-7007-36f7-ac0c-dd73ed4960a7",
                                                "text": "For them too it is a monistic insight, in which the other in its various forms appears absorbed into the One."
                                            }
                                        ]
                                    }
