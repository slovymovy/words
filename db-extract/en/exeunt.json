                "senses": [
                    {
                        "sense_id": "5d65fdd3-7ee1-3f82-9dfe-deef43bd34da",
                        "entry_id": "3c4eaf52-410d-3540-93fd-a63da13e9814",
                        "glosses": [
                            "They leave the stage (a stage direction to two or more actors, the plural counterpart of exit)."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "71a04217-3405-4bd8-8c4b-13c1acbfda67",
                                "sense_id": "5d65fdd3-7ee1-3f82-9dfe-deef43bd34da",
                                "text": "Get thee to bed, and rest; for thou hast need. [Exeunt Lady Capulet and Nurse.]"
                            },
                            {
                                "example_id": "95dc3624-2199-46ad-85f1-67c3511d1d4b",
                                "sense_id": "5d65fdd3-7ee1-3f82-9dfe-deef43bd34da",
                                "text": "Enter two Devils.\n Wagner. How now sir, will you serve me now?\n Robin. Ay, good Wagner, take away the devils then.\n Wagner. Spirits, away! [Exeunt Devils.] Now, sirrah, follow me."
                            },
                            {
                                "example_id": "b988ea93-5439-4ae2-ba9e-d88dcbc5baa2",
                                "sense_id": "5d65fdd3-7ee1-3f82-9dfe-deef43bd34da",
                                "text": "Jane, Ursa, carrying Thomas, and Moss Bud start to exeunt."
                            },
                            {
                                "example_id": "e5baa980-23b5-4176-bd5c-aa0ac4f25a4f",
                                "sense_id": "5d65fdd3-7ee1-3f82-9dfe-deef43bd34da",
                                "text": "On that dixit we exeunted."
                            },
                            {
                                "example_id": "74f383fa-b575-41e9-8039-efcb7d9602ac",
                                "sense_id": "5d65fdd3-7ee1-3f82-9dfe-deef43bd34da",
                                "text": "That let the small problem of getting the van within proximity, running a few yards of cable, spiking the phone line, revving the engine and frying the phones, removing the cable, and exeunting, south"
                            },
                            {
                                "example_id": "7de4d53d-26f7-4d82-a91e-e3fb822d0381",
                                "sense_id": "5d65fdd3-7ee1-3f82-9dfe-deef43bd34da",
                                "text": "The lasses picked up their skirts and exeunted."
                            }
                        ]
                    }
                ],
