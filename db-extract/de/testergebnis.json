                "senses": [
                    {
                        "sense_id": "fb79041e-244a-3944-88a9-517256b1e181",
                        "entry_id": "af3b92d2-5386-38b7-9aeb-a31b46866167",
                        "glosses": [
                            "Resultat einer Überprüfung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb272416-a6cc-4cf2-b4d3-a414d5ee401b",
                                "sense_id": "fb79041e-244a-3944-88a9-517256b1e181",
                                "text": "„Das Warten auf die Testergebnisse war nervenaufreibend.“"
                            },
                            {
                                "example_id": "c250867c-f6de-4b82-9ed0-6e4021788397",
                                "sense_id": "fb79041e-244a-3944-88a9-517256b1e181",
                                "text": "„Diese Testeigenschaft wird für jedes Cut-Off durch die Likelihood-Ratio (LR) beschrieben. Für dichotome Tests gibt es eine LR(+) für das positive Testergebnis und eine LR(–) für das negative Testergebnis.“"
                            },
                            {
                                "example_id": "f3dd7cc1-5431-4fff-8e73-8d866aeca29e",
                                "sense_id": "fb79041e-244a-3944-88a9-517256b1e181",
                                "text": "Die Testergebnisse waren leider nicht überzeugend."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
