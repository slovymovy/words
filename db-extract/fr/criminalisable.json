                        "glosses": [
                            "Qui peut être criminalisé, considéré comme criminel ; qui peut conduire à une incrimination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aec997c-1969-41d6-b054-c1090ef1f8a1",
                                "sense_id": "dffdcb66-03e7-3cbc-9235-df85f221751c",
                                "text": "Est alors considéré comme « comportement criminalisable » ou « comportement punissable » tout comportement défini comme tel par un système pénal donné."
                            },
                            {
                                "example_id": "01d58dce-572a-4432-b6f8-29b74a111bea",
                                "sense_id": "dffdcb66-03e7-3cbc-9235-df85f221751c",
                                "text": "En adoptant une méthodologie située à la croisée de l’histoire et de la criminologie, Josianne Paul a voulu comprendre comment, aux XVIIe et XVIIIe siècles, les habitants de Montréal et l’administration coloniale géraient les situations conflictuelles potentiellement criminalisables."
                            },
                            {
                                "example_id": "82bbb4ba-1348-4afb-a732-e234f6841dc5",
                                "sense_id": "dffdcb66-03e7-3cbc-9235-df85f221751c",
                                "text": "D’abord, sans doute le fait qu’aider une autre personne sur le territoire français ne sera plus criminalisable."
                            }
                        ]
                    }
