                    "frequency": "Low",
                    "semantic_group_id": "tobacco",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler observed the local custom of using a fine <w>snuff</w> during the ceremony."
                        },
                        {
                            "text": "He kept his <w>snuff</w> in a small silver box."
                        }
                    ]
                },
                {
