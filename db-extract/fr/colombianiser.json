                "senses": [
                    {
                        "sense_id": "033e0a8e-eddf-32f8-b4ff-b05d002aafd2",
                        "entry_id": "29b24e9e-636c-321c-afd8-2674a469ba1a",
                        "glosses": [
                            "Donner un caractère colombien, ou plus colombien, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3efe2da-d6d8-4f32-ab04-78efa45ca32a",
                                "sense_id": "033e0a8e-eddf-32f8-b4ff-b05d002aafd2",
                                "text": "Il faut faire de l’Indien un citoyen à part entière, l’arracher au joug de l’Église et des propriétaires terriens ; il faut l’éduquer, l’amener doucement vers la civilisation, le colombianiser en en faisant un paysan."
                            },
                            {
                                "example_id": "aedc6713-4eda-4ec1-88b8-c4f022beff1f",
                                "sense_id": "033e0a8e-eddf-32f8-b4ff-b05d002aafd2",
                                "text": "Mes goûts se sont colombianisés, et désormais, au petit déjeuner, je mange plus souvent un œuf au plat-tartine qu'un bol de Chocapic, comme avant."
                            }
                        ]
                    }
                ],
