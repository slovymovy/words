                ],
                "senses": [
                    {
                        "sense_id": "28c48efc-4d9e-315a-9dfc-5fac4aa29c4b",
                        "entry_id": "31172fff-09a5-3f5d-88e2-75387c8e6ed5",
                        "glosses": [
                            "das Fahren eines Fahrzeugs mit geringem Tempo (vor allem von Rettungsfahrzeugen bei Krankentransporten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5ea6231-9810-485b-a869-246e3c239d30",
                                "sense_id": "28c48efc-4d9e-315a-9dfc-5fac4aa29c4b",
                                "text": "„Mit vereinten Kräften trugen die Einsatzbeamten den Patienten zum Fahrzeug des Hundehalters. Dieser konnte mit seinem PKW in Schonfahrt die medizinische Hilfe bei einem diensthabenden Tierarzt.“"
                            },
                            {
                                "example_id": "83ec9d38-8bc0-4e7c-93e4-a7a767d74da3",
                                "sense_id": "28c48efc-4d9e-315a-9dfc-5fac4aa29c4b",
                                "text": "„Doch der schnelle Haftungsverlust der Reifen verlangt eine Schonfahrt.“"
                            },
                            {
                                "example_id": "da03591f-e870-49c3-ab14-da1d87601a36",
                                "sense_id": "28c48efc-4d9e-315a-9dfc-5fac4aa29c4b",
                                "text": "„Allerdings ist auch denkbar, dass ein Krankentransporter eine Schonfahrt zur Behandlung eines Patienten mit deutlich reduzierter Geschwindigkeit und ohne Martinshorn – lediglich mit eingeschaltetem Blaulicht – ausführt.“"
                            },
                            {
                                "example_id": "7075c352-6e68-4489-89be-f170a5712042",
                                "sense_id": "28c48efc-4d9e-315a-9dfc-5fac4aa29c4b",
                                "text": "„Während unseres Tests zeigte sich, dass auch unter nicht ganz optimalen Bodenverhältnissen mit dem Schwergewicht bei Schonfahrt und 1050er Terra Bereifung noch gute Arbeitsergebnisse zu erzielen sind.“"
                            },
                            {
                                "example_id": "b5610166-a0ff-48a7-a747-cf9452607c42",
                                "sense_id": "28c48efc-4d9e-315a-9dfc-5fac4aa29c4b",
                                "text": "„Wenn möglich Schonfahrt, Kind im Arm der Mutter, O2-Ihalation, Beobachtung, einfaches Monitoring (Pulsoxymetrie), Bereitschaft zur Beatmung, Intubation, Reanimation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
