    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e0da4f4b-34eb-3de0-9831-2404e15530ed",
                "word": "pantile",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2b3356fe-4b43-4e40-a7ad-8a3303c2266a",
                        "entry_id": "e0da4f4b-34eb-3de0-9831-2404e15530ed",
                        "tags": [
                            "plural"
                        ],
                        "form": "pantiles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c11e80af-43a9-32e8-b516-014431a83ff1",
                        "entry_id": "e0da4f4b-34eb-3de0-9831-2404e15530ed",
                        "glosses": [
                            "A type of interlocking roof tile with a rounded under and over, giving it an elongated S-shaped (ogee) cross section."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a65eed0f-5dac-4de5-86a8-61a78362cfa7",
                                "sense_id": "c11e80af-43a9-32e8-b516-014431a83ff1",
                                "text": "The houses of the estancias shrank behind screens of poplar and eucalyptus. Some of the houses had pantile roofs, but most were of metal sheet, painted red."
                            },
                            {
                                "example_id": "ea345fbb-9786-406a-9701-d24523085ca9",
                                "sense_id": "c11e80af-43a9-32e8-b516-014431a83ff1",
                                "text": "All the gneiss roofing slates have vanished, to be replaced by pantiles painting patchworks of all possible orange hues."
                            },
                            {
                                "example_id": "85c873a6-b708-410c-8597-9a2a1e0c0637",
                                "sense_id": "c11e80af-43a9-32e8-b516-014431a83ff1",
                                "text": "Some old, underfired clay pantiles might be damaged by button mosses rooting in cracks and fissures. But most post-war tiles are hard enough to withstand a bit of moss growth."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a3184fb-53ec-312e-96f8-ee9f9058269a",
                        "entry_id": "e0da4f4b-34eb-3de0-9831-2404e15530ed",
                        "glosses": [
                            "A hat."
                        ],
                        "tags": [
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c924090a-0eb6-48e8-9cf1-20b84476df2a",
                                "sense_id": "3a3184fb-53ec-312e-96f8-ee9f9058269a",
                                "text": "\"So you are a Quaker, master, are you?\" he added, \"Well, I thought somehow, by the cut of your pantile, (hat) you was something or other in that way.\""
                            },
                            {
                                "example_id": "f17523c1-0521-4406-86c8-ef6ee7630177",
                                "sense_id": "3a3184fb-53ec-312e-96f8-ee9f9058269a",
                                "text": "Hats or ordinary caps can be worn over them, and they are much used by the drivers of hack-carriages and horse-cars. Those who cannot afford a fur cap, ear-muff, or pantile, tie a handkerchief over their ears, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "69a86139-2bd0-3a7a-994f-2df6410954d4",
                        "entry_id": "e0da4f4b-34eb-3de0-9831-2404e15530ed",
                        "glosses": [
                            "A flat jam-covered cake."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "76b671d7-aff2-4189-9ec6-8e433e43d73f",
                                "sense_id": "69a86139-2bd0-3a7a-994f-2df6410954d4",
                                "text": "Of course unlike the officers we never got fresh bread, we got what came from barrels stored in the lower peak and under the steward's padlock. Pantiles baked brick hard, mouldy oats for skilly, dried peas for soup, embalmed pork and beef more fat and bone than meat."
                            }
                        ]
                    }
                ],
