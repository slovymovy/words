                ],
                "senses": [
                    {
                        "sense_id": "73f8c0da-1ea0-3a0a-919a-8620bd087fcb",
                        "entry_id": "c5937580-c09c-32fc-a8d3-a0a78d3a6811",
                        "glosses": [
                            "Zwergstrauch aus der Gattung Vaccinium, insbesondere die in Europa heimische Gewöhnliche Moosbeere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50adab25-30ce-4603-8419-5dbeaa1e30ee",
                                "sense_id": "73f8c0da-1ea0-3a0a-919a-8620bd087fcb",
                                "text": "Die Früchte von Moosbeeren sind essbar und sehr vitaminreich."
                            },
                            {
                                "example_id": "d52d3b0d-0f90-4369-8713-fb0dc73c7023",
                                "sense_id": "73f8c0da-1ea0-3a0a-919a-8620bd087fcb",
                                "text": "„Selbst mehr als 150 Jahre, nachdem die Bewohner von europäischen Kolonisten zwangsumgesiedelt wurden, lassen sich diese »Waldgärten«, so der Terminus der Forschenden, am Reichtum von Haselnüssen, Moosbeeren, Hagedorn und Holzäpfeln erkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2dbd8d26-cfb9-33b7-8386-630bf9193593",
                        "entry_id": "c5937580-c09c-32fc-a8d3-a0a78d3a6811",
                        "glosses": [
                            "essbare Frucht von [1]"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c2c44aa-2e8b-4d40-bb4f-72ce1f99bc8c",
                        "source_entry_id": "c5937580-c09c-32fc-a8d3-a0a78d3a6811",
                        "source_sense_id": "73f8c0da-1ea0-3a0a-919a-8620bd087fcb",
                        "target_lang_word": "cranberry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cranberry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24c9ab64-3e45-339d-bc18-9c8a09cccfc8",
                                        "entry_id": "2e7b230e-ac5a-3467-9801-5e73c045d419",
                                        "glosses": [
                                            "A shrub belonging to the section Vaccinium sect. Oxycoccus of the genus Vaccinium."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22531779-e6d4-3351-9f98-1fdad8f0cbf7",
                                        "entry_id": "2e7b230e-ac5a-3467-9801-5e73c045d419",
                                        "glosses": [
                                            "The edible red berry of that shrub."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1528a92-9690-491a-aef9-263304fb6eee",
                                                "sense_id": "22531779-e6d4-3351-9f98-1fdad8f0cbf7",
                                                "text": "That concertina was a wonder in its way. The handles that was on it first was wore out long ago, and he'd made new ones of braided rope yarn. And the bellows was patched in more places than a cranberry picker's overalls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a00b8558-07c3-332e-9566-4714bcd338c4",
                                        "entry_id": "2e7b230e-ac5a-3467-9801-5e73c045d419",
                                        "glosses": [
                                            "An intense red colour, like that of a cranberry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cranberry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b77d9f84-b2fe-3cca-a500-86a301f1e719",
                                        "entry_id": "e5f62f74-89e9-37e1-9072-99c19746d7b3",
                                        "glosses": [
                                            "Of the intense red colour of a cranberry."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f870633d-3cf4-4d13-9dec-bf661ef3c26e",
                                                "sense_id": "b77d9f84-b2fe-3cca-a500-86a301f1e719",
                                                "text": "Leon was in his most resplendent, gaudiest, Day-Glo getup, including a purple felt fez with multiple hangy-downs and a cranberry vestment with gold collar, appliquéd with every religious symbol known to man […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a79a9a6-0dbc-4534-913a-16d724a90cfe",
                        "source_entry_id": "c5937580-c09c-32fc-a8d3-a0a78d3a6811",
                        "source_sense_id": "73f8c0da-1ea0-3a0a-919a-8620bd087fcb",
                        "target_lang_word": "canneberge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canneberge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74ad9ba4-e698-3698-9134-24ff278ed035",
                                        "entry_id": "d60e93c2-1982-37bc-b41b-e2b05dca4631",
                                        "glosses": [
                                            "Nom usuel de Vaccinium macrocarpon, arbrisseau rampant originaire des milieux humides de l’est de l’Amérique du Nord et qui porte de petites baies acidulées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86ee5097-6a68-49ae-9fa0-fa72cd738a49",
                                                "sense_id": "74ad9ba4-e698-3698-9134-24ff278ed035",
                                                "text": "Nous devions nous attendre à chasser sur nos ancres, et à être jetés sur les rivages de la Finlande pour y chercher des canneberges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aa86d68-3c84-37a7-be81-f1f32f7f2b1f",
                                        "entry_id": "d60e93c2-1982-37bc-b41b-e2b05dca4631",
                                        "glosses": [
                                            "Nom usuel de Vaccinium oxycoccos, arbrisseau rampant originaire des milieux humides des zones nordiques et qui porte de petites baies acidulées."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22dd9ef7-f07f-34e5-8c8b-8ca4e3bfc7f0",
                                        "entry_id": "d60e93c2-1982-37bc-b41b-e2b05dca4631",
                                        "glosses": [
                                            "Baie de la canneberge."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7afcdc32-cabf-4ea7-a2bb-ad92b1238258",
                                                "sense_id": "22dd9ef7-f07f-34e5-8c8b-8ca4e3bfc7f0",
                                                "text": "Myrtilles, mûres, framboises, airelles, prunelles, canneberges, fraises, pommes sauvages, aubépine, sorbier, arbouses, sureau noir, noisettes… pour ce qui concerne les fruits « en liberté »."
                                            },
                                            {
                                                "example_id": "9e62eab7-3258-4432-a41d-26dcc7e59cb2",
                                                "sense_id": "22dd9ef7-f07f-34e5-8c8b-8ca4e3bfc7f0",
                                                "text": "La canneberge, succulent petit fruit rouge venu tout droit du Canada, est appréciée depuis peu en Europe pour ses vertus nutritives et préventives contre certaines pathologies (infections urinaires, diabète, troubles digestifs, etc.)."
                                            },
                                            {
                                                "example_id": "58a35592-12d9-436c-ab8f-ba0a8a890f12",
                                                "sense_id": "22dd9ef7-f07f-34e5-8c8b-8ca4e3bfc7f0",
                                                "text": "Les villages se firent encore plus rares et plus pauvres. Leur fondation datant de la fin des années trente s’expliquait par les regroupements des petits lieux de peuplement ordonnés par Staline, mais ils étaient maintenant à moitié abandonnés et les habitants migraient vers Krasnoïarsk, sinon plus loin encore. Au fur et à mesure qu’on montait vers le nord et l’hiver, les produits agricoles visibles sur les quais se réduisaient à quelques sacs de pommes de terre et de carottes, ou à des seaux de canneberges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1aa3937-5575-4e41-bc99-16bda4d7b653",
                        "source_entry_id": "c5937580-c09c-32fc-a8d3-a0a78d3a6811",
                        "source_sense_id": "73f8c0da-1ea0-3a0a-919a-8620bd087fcb",
