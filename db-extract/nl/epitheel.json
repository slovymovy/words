                "senses": [
                    {
                        "sense_id": "86b51f8b-35d0-3599-83e3-9ce4df3aaef2",
                        "entry_id": "8a617e7f-b445-306c-8639-2a8f69ff824c",
                        "glosses": [
                            "dekweefsel, bovenste laag van de huid en slijmvliezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00de4ed3-5b63-43ba-bf98-fb36cf1a5bc1",
                                "sense_id": "86b51f8b-35d0-3599-83e3-9ce4df3aaef2",
                                "text": "Het belangrijkste kenmerk van dit epitheel - een soort eenlagig dekweefsel - is dat de cellen uitgerekt zijn, zodat ze dicht in elkaar gepakt kunnen zitten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f5ec6a7-cac4-4259-9da9-73b2603d48f8",
                        "source_entry_id": "8a617e7f-b445-306c-8639-2a8f69ff824c",
