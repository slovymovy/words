                "senses": [
                    {
                        "sense_id": "910405f6-d140-3d8a-8ba0-9fc9b9312e8a",
                        "entry_id": "60d122ae-0fc9-3e97-ad49-bc19e1b4305a",
                        "glosses": [
                            "urzędnik ściśle przestrzegający i wymagający przestrzegania kwestii formalnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31bfc7c0-773a-4c22-97b0-04a9d3db1f94",
                                "sense_id": "910405f6-d140-3d8a-8ba0-9fc9b9312e8a",
                                "text": "Mam nadzieję, że biurokratom i politykom nie uda się zdusić ich entuzjazmu i ducha bojowego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afe9a6b9-3b3d-4f52-8b0e-27c8c105219c",
                        "source_entry_id": "60d122ae-0fc9-3e97-ad49-bc19e1b4305a",
                        "source_sense_id": "910405f6-d140-3d8a-8ba0-9fc9b9312e8a",
                        "target_lang_word": "bureaucrat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bureaucrat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "711e5f9a-3fc7-3e0e-ad9e-ebf4c5783f58",
                                        "entry_id": "86396514-d2a1-32f0-854d-dfb88cf47b48",
                                        "glosses": [
                                            "An official who is part of a bureaucracy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5024023b-74a1-435a-b79a-cc53346d67f8",
                                                "sense_id": "711e5f9a-3fc7-3e0e-ad9e-ebf4c5783f58",
                                                "text": "Coristine, who had signed onto the telemeeting using a non-government email address, gave the bureaucrats swift marching orders, telling them he needed access to the federal department’s contract and payment systems before reportedly making them justify their jobs at the $1 billion-budget administration."
                                            },
                                            {
                                                "example_id": "2e94b6aa-a559-4444-98a7-69a659911ac4",
                                                "sense_id": "711e5f9a-3fc7-3e0e-ad9e-ebf4c5783f58",
                                                "text": "At the Oval Office signing ceremony, Musk responded to critiques that he’s become the very thing he claims to be fighting — an unelected bureaucrat with enormous power — by pointing to the 2024 results: “You couldn’t ask for a stronger mandate from the public.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b4201c4-7878-345e-b2ae-267c672be342",
                                        "entry_id": "86396514-d2a1-32f0-854d-dfb88cf47b48",
                                        "glosses": [
                                            "A user on a wiki with the right to change user access levels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0faf2bc5-4621-49e0-86dc-36c9ec5e361f",
                                                "sense_id": "3b4201c4-7878-345e-b2ae-267c672be342",
                                                "text": "One of three major processes is generally used: a bureaucrat review, a broader community review, or an approvals group review. As only local bureaucrats or Wikimedia stewards can grant the bot flag necessary to operate an authorized bot, the simplest method is to appeal directly to these individuals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
