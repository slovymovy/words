                        "examples": [
                            {
                                "example_id": "aeeda0b9-5233-4b72-9611-31c10675cb2f",
                                "sense_id": "2ca6cd1b-24b5-3313-bbc0-1d3a7e8209eb",
                                "text": "Ook collega's en bijvoorbeeld cliënten of patiënten worden vaak genoemd als bron van ellende. Schoppen of bijten door anderen staan samen met bedreigingen op de tweede plaats. In de top-5 staan verder geraakt worden door een voorwerp, een beknelling of een val van een zekere hoogte. De meeste ongelukken gebeuren in fabrieken of op reparatiewerkplaatsen."
                            },
                            {
                                "example_id": "6997d6b5-d946-4f6a-964a-585c0cb13bf7",
                                "sense_id": "2ca6cd1b-24b5-3313-bbc0-1d3a7e8209eb",
                                "text": "De werknemers lopen risico op ongevallen door onveilige machines en op infectieziekten. Ze kunnen zich bijvoorbeeld verwonden aan messen in machines. Ook komt het voor dat apparatuur niet goed is uitgeschakeld. Dan bestaat volgens de inspectie het gevaar voor beknelling en elektrocutie."
                            }
                        ]
                    }
