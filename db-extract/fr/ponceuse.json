                    },
                    {
                        "translation_id": "635bd600-1d81-49b5-9fd3-3ca9a3c1f4f0",
                        "source_entry_id": "88e129a3-5419-35c8-8b9a-fd96513dc593",
                        "source_sense_id": "e0b7ca14-ca3c-3212-a90c-704085bc33a8",
                        "source_sense_description": "Machine",
                        "target_lang_word": "sander",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4aecbfa-dcfb-3f94-b04b-6054b2f2077b",
                                        "entry_id": "2e4eece7-a787-3208-8739-30bf47fec3a1",
                                        "glosses": [
                                            "A person employed to sand wood."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "efb09e8c-32d0-3d2a-bee1-93f1dce1f9d0",
                                        "entry_id": "2e4eece7-a787-3208-8739-30bf47fec3a1",
                                        "glosses": [
                                            "A machine to mechanize the process of sanding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fa96314-c241-432e-8bd4-339fcafb0b66",
                                                "sense_id": "efb09e8c-32d0-3d2a-bee1-93f1dce1f9d0",
                                                "text": "The autophiles hang around a big, fluorescent-lighted garage with cars on cinder blocks, ostensibly in competition for a job, and they talk to the camera in between sessions at the sander or other machines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5240ebdc-ea70-3442-ba42-5c178d774898",
                                        "entry_id": "2e4eece7-a787-3208-8739-30bf47fec3a1",
                                        "glosses": [
                                            "A device which spreads sand on the rails in wet, snowy, icy, slippery conditions to improve traction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4f5d2c9-8fd3-440e-adac-f55d5d80d7df",
                                                "sense_id": "5240ebdc-ea70-3442-ba42-5c178d774898",
                                                "text": "Grass growing on the track made the running far from easy, and only frequent use of the sanders enabled us to breast the 1 in 50 gradients between Letterkenny and Kilmacrenon [sic]."
                                            },
                                            {
                                                "example_id": "3885839d-6320-45f2-8910-493191b63954",
                                                "sense_id": "5240ebdc-ea70-3442-ba42-5c178d774898",
                                                "text": "Traditionally, sand was used to aid grip, being released onto the track in front of the wheels from a special 'sandbox'. However, the Slough accident led to two trials on the use of train-borne sanders to aid braking: [...] Now, all new stock is fitted with automatic sanders, as have most of the pre-1994 units still running."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41d98a7a-a526-35c5-b011-459c9aa1b8c4",
                                        "entry_id": "2e4eece7-a787-3208-8739-30bf47fec3a1",
                                        "glosses": [
                                            "A small device resembling a salt shaker but containing sand that was shaken over a document to remove excess ink."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
