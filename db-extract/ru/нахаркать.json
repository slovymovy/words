                        "examples": [
                            {
                                "example_id": "6e60b364-e12b-4068-b7ea-710801a3d1e8",
                                "sense_id": "9ef528b0-fab4-3493-8b49-42a2741e3345",
                                "text": "Зашел к нему нынче утром ― он моется в маленьком тазике, ― в одной воде и руки вымыл и лицо и нахаркал туда же…"
                            },
                            {
                                "example_id": "97752735-2518-41d5-9803-af22f96ac2c2",
                                "sense_id": "9ef528b0-fab4-3493-8b49-42a2741e3345",
                                "text": "Как бы нахаркал я им всем в гнусные рыла!"
                            }
                        ]
                    }
