    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d016a656-d177-376d-aade-f3465726f538",
                    "sense_definition": "Relating to Australia or New Zealand.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler enjoyed the warm <w>antipodean</w> sunshine during the winter months.",
                            "target_lang_translations": {
                                "zh": "旅行者在冬季享受着温暖的<w>澳大利亚</w>阳光。"
                            }
                        },
                        {
                            "text": "Many tourists visit the region to experience the unique <w>antipodean</w> culture and landscape.",
                            "target_lang_translations": {
                                "zh": "许多游客来到该地区，体验独特的<w>澳大利亚和新西兰</w>文化与景观。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "antipodean sunshine",
                        "antipodean culture"
                    ],
                    "target_lang_definitions": {
                        "zh": "与澳大利亚或新西兰有关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "澳大利亚和新西兰的",
                                "target_lang_sense_clarification": "指代地理位置或文化特征"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea9fbc73-901f-3e26-aac5-3ce6a08d8e01",
                    "sense_definition": "Situated at opposite sides of the Earth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two cities are <w>antipodean</w> locations on the globe.",
                            "target_lang_translations": {
                                "zh": "这两座城市在地球上处于<w>对跖</w>位置。"
                            }
                        },
                        {
                            "text": "Scientists studied the <w>antipodean</w> points to understand global weather patterns.",
                            "target_lang_translations": {
                                "zh": "科学家研究了<w>对跖</w>点，以了解全球天气模式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "opposite"
                    ],
                    "target_lang_definitions": {
                        "zh": "位于地球两端的；对跖的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "对跖的",
                                "target_lang_sense_clarification": "地理学专业术语，指地球表面直径两端的点"
                            },
                            {
                                "target_lang_word": "地球两端的",
                                "target_lang_sense_clarification": "描述地理位置的相对性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06002881-4969-3bf9-a93d-28cec2a6d832",
                    "sense_definition": "Diametrically opposed in nature or position.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two politicians held <w>antipodean</w> views on the new economic policy.",
                            "target_lang_translations": {
                                "zh": "这两位政治家对新经济政策持有<w>截然相反</w>的观点。"
                            }
                        },
                        {
                            "text": "Their personalities were <w>antipodean</w> yet they remained close friends for years.",
                            "target_lang_translations": {
                                "zh": "他们的性格<w>完全对立</w>，但多年来一直保持着亲密的友谊。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contrary",
                        "opposing"
                    ],
                    "antonyms": [
                        "identical",
                        "similar"
                    ],
                    "target_lang_definitions": {
                        "zh": "在性质或立场上截然相反的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "截然相反的",
                                "target_lang_sense_clarification": "形容观点或性格完全对立"
                            },
                            {
                                "target_lang_word": "完全对立的",
                                "target_lang_sense_clarification": "强调差异巨大"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1cca9da5-3ad4-3835-a35e-7dc421c9954b",
                    "sense_definition": "A person who lives on the opposite side of the Earth.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>antipodeans</w> experience seasons at the opposite time of the year.",
                            "target_lang_translations": {
                                "zh": "这些<w>地球另一端的人</w>所经历的季节与我们正好相反。"
                            }
                        },
                        {
                            "text": "Travelers often find it fascinating to meet <w>antipodeans</w> while abroad.",
                            "target_lang_translations": {
                                "zh": "旅行者在国外遇到<w>地球另一端的人</w>时，常会觉得很有趣。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "居住在地球另一端的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "地球另一端的人",
                                "target_lang_sense_clarification": "指代居住在对跖点的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
