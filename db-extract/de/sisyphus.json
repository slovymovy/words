                ],
                "senses": [
                    {
                        "sense_id": "81e83490-5cfd-3e81-9341-17f8fc72e7a5",
                        "entry_id": "fc690a74-b4a8-3548-8351-d5bd30882783",
                        "glosses": [
                            "jemand, der Sisyphusarbeit verrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b6d2bbb-f4f0-4e9c-84fb-7e0546a1d4fb",
                                "sense_id": "81e83490-5cfd-3e81-9341-17f8fc72e7a5",
                                "text": "„Und daher schreibt sich auch wohl die Hinfälligkeit der philosophischen Systeme seit 2000 Jahren; jeder neue Philosoph mit einem neuen Systeme aus dem Standpunkte des absoluten Vernunftbegriffs erscheint als ein Sisyphus, der mit unendlicher Kraftanstrengung sein künstlich gebautes Werk aufwärts und immer aufwärts drängt, bis es zuletzt doch endlich zerschellt in den Abgrund stürzt, […]“"
                            },
                            {
                                "example_id": "dafbe631-fdbb-40fa-b296-d3d0e0e73d76",
                                "sense_id": "81e83490-5cfd-3e81-9341-17f8fc72e7a5",
                                "text": "„Erneut pendelte der Vogel wie ein Sisyphus hin und her, bis das Mittelfähnchen dran war und sich der oberste und letzte Behälter präsentierte.“"
                            },
                            {
                                "example_id": "d62703c4-1af3-4c99-ba68-86a1a35c83ed",
                                "sense_id": "81e83490-5cfd-3e81-9341-17f8fc72e7a5",
                                "text": "„Nicht jeder kann so ein Sisyphus sein.“"
                            },
                            {
                                "example_id": "870474e1-f616-4487-8797-73ae5c09db3f",
                                "sense_id": "81e83490-5cfd-3e81-9341-17f8fc72e7a5",
                                "text": "„[…], daß sich vor allem auch die Frage stellt, ob nicht die Kunstvermittler, die sich, wie ich, in den letzten Jahren aus Engagement für die Schweizer Kunst im In- und Ausland stark machten für die Szene, nicht eher die Sisyphusse sind, denen immer wieder die Felsbrocken zu schwer werden, da einmal tückische Steine, d. h. die Kunst der einzelnen Künstler, doch dem Anspruch nicht standhielten […]“"
                            },
                            {
                                "example_id": "9752f73c-d6c9-4338-b51c-43b50182c69b",
                                "sense_id": "81e83490-5cfd-3e81-9341-17f8fc72e7a5",
                                "text": "„[…]; in ihm können alle mit der Kunst und insbesondere dem Theater sich Abmühenden sich als Sisyphusse erkennen […]“"
                            },
                            {
                                "example_id": "3686aa9e-4957-4dc4-8a24-a6737a3a7a0e",
                                "sense_id": "81e83490-5cfd-3e81-9341-17f8fc72e7a5",
                                "text": "„Die Philosophen sind die Sisyphusse des menschlichen Gedankens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
