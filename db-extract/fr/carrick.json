                "senses": [
                    {
                        "sense_id": "97e912f8-4255-3a0b-8558-beff74dfe72d",
                        "entry_id": "a06842ef-7b26-35b7-aa2b-7ccba03f7e9f",
                        "glosses": [
                            "Caisse d'un cabriolet hippomobile."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "412f024d-49df-31e3-916d-2f139a649872",
                        "entry_id": "a06842ef-7b26-35b7-aa2b-7ccba03f7e9f",
                        "glosses": [
                            "Caisse de toutes voitures hippomobiles."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "bf588619-ad74-3306-acf5-069522521bce",
                        "entry_id": "a06842ef-7b26-35b7-aa2b-7ccba03f7e9f",
                        "glosses": [
                            "Sorte de redingote fort ample qui a plusieurs collets ou un collet très long."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "635f5f5f-ae45-484f-a247-8ae0a95f9951",
                                "sense_id": "bf588619-ad74-3306-acf5-069522521bce",
                                "text": "La morale de ceci est qu’une jolie femme ne voudra jamais reconnaître son mari, ni même son amant dans un homme en vieux carrick, en perruque de chiendent et en bottes percées."
                            },
                            {
                                "example_id": "4bee2761-4dc7-4b68-94e6-17516a58592f",
                                "sense_id": "bf588619-ad74-3306-acf5-069522521bce",
                                "text": "Le vieux Bosc venait de paraître à son tour, traînant les pieds, toussant, enveloppé d’un ancien carrick jaune."
                            },
                            {
                                "example_id": "441a33c4-734c-44b9-a72b-332fc16f2cb8",
                                "sense_id": "bf588619-ad74-3306-acf5-069522521bce",
                                "text": "Avant la paix d’Amiens, cet Anglais avait résolu le problème de couvrir le buste sans assommer le corps de cet affreux carrick qui finit aujourd’hui sur le dos des vieux cochers de fiacre ; mais comme les fines tailles sont en minorité, la mode du spencer pour homme n’eut en France qu’un succès passager, quoique ce fût une invention anglaise."
                            },
                            {
                                "example_id": "7d95e81c-3a0a-4186-8dcb-482de582711a",
                                "sense_id": "bf588619-ad74-3306-acf5-069522521bce",
                                "text": "Très à son aise, il fit compliment à madame Martin des pèlerines de son carrick carmélite."
                            },
                            {
                                "example_id": "513d8241-ff2f-4649-a257-c018c7d9a1fa",
                                "sense_id": "bf588619-ad74-3306-acf5-069522521bce",
                                "text": "Les corsages, les robes, les guimpes, les coiffes, les gants, les redingotes, les carricks, les hauts-de-forme, les cravaches de trois générations, pendus à des clous, tapissaient les murs."
                            },
                            {
                                "example_id": "7450b68f-ff25-40aa-93e6-de8d51d27abd",
                                "sense_id": "bf588619-ad74-3306-acf5-069522521bce",
                                "text": "Michel-Daniel peut bien avoir été ce petit-maître un peu insolent, pâle sous sa poudre, qui cache aujourd’hui sous un carrick usé le bel habit de velours bleu dans lequel il s’est fait peindre."
                            }
                        ]
                    }
