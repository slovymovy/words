                "senses": [
                    {
                        "sense_id": "f039c616-39e2-3e66-87d8-c6c2b793a359",
                        "entry_id": "707baf97-ad1b-38ba-9775-10eb0d90441b",
                        "glosses": [
                            "хим. смесь этилового спирта с небольшим количеством метанола и керосина, предназначенная для технических целей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef840ebc-1fab-4532-896c-7dcbe942b349",
                                "sense_id": "f039c616-39e2-3e66-87d8-c6c2b793a359",
                                "text": "Пахло противным денатуратом, в тазу таяла снежная гора, от винного стаканчика водки поручик Мышлаевский опьянел мгновенно до мути в глазах."
                            },
                            {
                                "example_id": "b2265b05-3704-4c43-9db6-1254194a8bd8",
                                "sense_id": "f039c616-39e2-3e66-87d8-c6c2b793a359",
                                "text": "Наконец я попробовал смачивать швы одежды денатуратом, использовавшимся для примусов."
                            }
                        ]
                    }
                ],
