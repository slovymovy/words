                ],
                "senses": [
                    {
                        "sense_id": "019b1b9a-c871-3fdb-9a38-359ec48de7e4",
                        "entry_id": "4361830a-c78e-30b1-bb06-b1687f768ee3",
                        "glosses": [
                            "jemand, der an einer spastischen Krankheit leidet"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "7e820357-ca50-4690-bd3d-458e0ab4a4c8",
                                "sense_id": "019b1b9a-c871-3fdb-9a38-359ec48de7e4",
                                "text": "Hier trifft sich gleich die Gruppe der Spastis."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "98ee9545-48a8-3b6e-bff6-7a7eadddd62a",
                        "entry_id": "4361830a-c78e-30b1-bb06-b1687f768ee3",
                        "glosses": [
                            "Person, deren Verhalten und Handeln als unvorstellbar töricht eingestuft wird"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "8401fe9c-35af-41cd-8afc-94afa7ebc549",
                                "sense_id": "98ee9545-48a8-3b6e-bff6-7a7eadddd62a",
                                "text": "Deine Geschwister wussten nicht, dass sie eine veraltete Version der Software gekauft haben? Die sind ja echte Spastis."
                            },
                            {
                                "example_id": "83318afe-280e-4942-bb5c-0b60160461e5",
                                "sense_id": "98ee9545-48a8-3b6e-bff6-7a7eadddd62a",
                                "text": "„Herbert zieht also dort ein, doch er benimmt sich prompt so daneben, dass Heinz bald eine neue Bleibe für ihn suchen muss: Der Spasti rennt mit der brennenden Zigarette durchs Treppenhaus und pinkelt unter den Augen der fassungslosen Hausmeisterin an die Hauswand.“"
                            },
                            {
                                "example_id": "70dc40a1-4c5f-4b41-a5c4-e9e127fd402b",
                                "sense_id": "98ee9545-48a8-3b6e-bff6-7a7eadddd62a",
                                "text": "„Der Anführer der Gang, ein aufgepumpter Spasti, hatte sie begrapscht.“"
                            },
                            {
                                "example_id": "36d4fa32-114b-42fa-a945-7e1ec747fafc",
                                "sense_id": "98ee9545-48a8-3b6e-bff6-7a7eadddd62a",
                                "text": "„Genau … Spastis … richtige Spastis … die das erste Mal von Vati den dicken Schlitten kriegen und rum posen … so lächerlich … aber das gibt's ja überall.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "621a8633-a570-4fe5-ba07-5b2e0c844275",
                        "source_entry_id": "4361830a-c78e-30b1-bb06-b1687f768ee3",
                        "source_sense_id": "019b1b9a-c871-3fdb-9a38-359ec48de7e4",
                        "source_sense_description": "umgangssprachlich: jemand, der an einer spastischen Krankheit leidet",
                        "target_lang_word": "spaz",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spaz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8b77845-4355-3262-a6c7-16a8e1613892",
                                        "entry_id": "68c52608-9395-30b0-9e4b-b586a99d0cfc",
                                        "glosses": [
                                            "An incompetent or physically uncoordinated person; a spazmo."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "offensive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1974d6ca-9e01-4a02-91f5-f13762ad1e96",
                                                "sense_id": "a8b77845-4355-3262-a6c7-16a8e1613892",
                                                "text": "In fact, it was the view of the scientists now in charge […] that the freakier they were, the better; if a mental spaz could go through and come out all right […] then the process was probably safe for the executives, politicians, and fashion models of the world."
                                            },
                                            {
                                                "example_id": "ecf40606-e7f5-4ed2-8480-8d04758c9761",
                                                "sense_id": "a8b77845-4355-3262-a6c7-16a8e1613892",
                                                "text": "“I was so in control from tee to green, the best I’ve played for years… But as soon as I got on the green I was a spaz.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "058ef7d2-89c9-3e83-b19d-bd58ddcad60a",
                                        "entry_id": "68c52608-9395-30b0-9e4b-b586a99d0cfc",
                                        "glosses": [
                                            "A hyperactive, erratically behaving person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "offensive",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e172538-a795-3176-b82a-d6bc2fac058a",
                                        "entry_id": "68c52608-9395-30b0-9e4b-b586a99d0cfc",
                                        "glosses": [
