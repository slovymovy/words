                        "sense_id": "a17572ed-797e-37e6-956d-a30729a9017b",
                        "entry_id": "4ec55a4d-2c37-3cc0-805e-d4857c65a445",
                        "glosses": [
                            "Bestätigung eines gewählten Amts- oder Mandatsträgers durch eine erneute Wahl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ffbb923-4ec6-4cd2-83c8-55ceb5c6f416",
                                "sense_id": "a17572ed-797e-37e6-956d-a30729a9017b",
                                "text": "Nachdem er drei Wiederwahlen geschafft hat, beabsichtigt der Bürgermeister bei der nächsten Wahl nicht mehr anzutreten."
                            },
                            {
                                "example_id": "6b6ce286-1ddb-4888-bc79-3d6eb2a54128",
                                "sense_id": "a17572ed-797e-37e6-956d-a30729a9017b",
                                "text": "Nach einer erfolgreichen Amtszeit stellt sich der Präsident zur Wiederwahl."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
