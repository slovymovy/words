                    {
                        "form_id": "efb2a5c3-0a95-4b8b-8ba6-d5cfc672b594",
                        "entry_id": "38f42f14-ab0e-39dd-b0c8-23b999d6891a",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Neolithikum"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "549583c9-bf45-393b-bf59-682d02db3941",
                        "entry_id": "38f42f14-ab0e-39dd-b0c8-23b999d6891a",
                        "glosses": [
                            "Epoche zwischen Mittelsteinzeit und Kupferzeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8c23f24-2b83-4b0c-834a-bcb5fde0f088",
                                "sense_id": "549583c9-bf45-393b-bf59-682d02db3941",
                                "text": "„Erste, grob-tonige, einfarbige und bei niederen Temperaturen (<650 °C) gebrannte Töpferwaren tauchen zu Beginn des Neolithikums auf.“"
                            },
                            {
                                "example_id": "28e75e82-a652-4793-bd98-8f20f2100a96",
                                "sense_id": "549583c9-bf45-393b-bf59-682d02db3941",
                                "text": "„Man versucht, diese Sprachen mit den dort während des Neolithikums und der frühen Bronzezeit lebenden Völkern zu identifizieren, die man nach ihrer charakteristischen Bestattungsweise in Grabhügeln (Kurgan) als Kurgankultur bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1282d95-16a7-4288-a264-60c642c6c6ec",
                        "source_entry_id": "38f42f14-ab0e-39dd-b0c8-23b999d6891a",
                        "source_sense_id": "549583c9-bf45-393b-bf59-682d02db3941",
                        "source_sense_description": "Epoche zwischen Mittelsteinzeit und Kupferzeit",
                        "target_lang_word": "Neolithic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neolithic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78123630-a495-37c9-93bc-e9f0d6f58cca",
                                        "entry_id": "4df7041f-91cc-309f-aecb-6f8457004d29",
                                        "glosses": [
                                            "The period of prehistory from circa 8500 to 4500 BCE."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fc8994e-a9b7-4e27-b6a0-d9f2ac5964dd",
                                                "sense_id": "78123630-a495-37c9-93bc-e9f0d6f58cca",
                                                "text": "Holonyms: Stone Age < prehistory"
                                            },
                                            {
                                                "example_id": "b54759b4-1a46-4b62-89c3-83cd19372033",
                                                "sense_id": "78123630-a495-37c9-93bc-e9f0d6f58cca",
                                                "text": "Meronyms: Pre-Pottery Neolithic, Pre-Pottery Neolithic A, Pre-Pottery Neolithic B"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Neolithic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "506f9890-f7f2-3e0b-8f7d-f87bd3a99e09",
                                        "entry_id": "89b7dad1-fa5c-3133-b6fa-b0429be7fab9",
                                        "glosses": [
                                            "Of or relating to the New Stone Age."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a76275c7-dd24-4507-9e66-be120fc0eade",
                                                "sense_id": "506f9890-f7f2-3e0b-8f7d-f87bd3a99e09",
                                                "text": "Tokens are first identified at around the same time as the local peoples changed from a life based on hunting and gathering to one based on agriculture. The tokens, as Schmandt-Besserat says, \"were part and parcel of the Neolithic phenomenon; that is, the so-called agricultural revolution.\" (Before Writing 41)."
                                            },
                                            {
                                                "example_id": "3c256d5a-9d38-40ed-870f-79461026426d",
                                                "sense_id": "506f9890-f7f2-3e0b-8f7d-f87bd3a99e09",
                                                "text": "... I was fascinated by a pair of stories about a Neolithic girl who wrote the first letter, and invented the first alphabet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Neolithic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "795fe14c-09b0-38dd-a1ab-759823be052e",
                                        "entry_id": "9cecb260-8003-31ab-8112-1f129c462dec",
                                        "glosses": [
                                            "A person who lived during the New Stone Age."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5040be65-028b-4b86-8d0f-f0d570b4978c",
                                                "sense_id": "795fe14c-09b0-38dd-a1ab-759823be052e",
                                                "text": "For the Neolithics, the stone was flint, and it's still impressive to see what they were able to achieve with it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4f1f822-7b8f-46db-b7dd-05b8494a3032",
                        "source_entry_id": "38f42f14-ab0e-39dd-b0c8-23b999d6891a",
