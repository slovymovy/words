                                "example_id": "8d073c66-4f1d-4ac0-9095-2dbf6b9ef266",
                                "sense_id": "f2756690-4c7c-3310-b439-30f457ec7709",
                                "text": "Sabrina and the three sisters in Charmed have a myriad of witchy powers."
                            }
                        ]
