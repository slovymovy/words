                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e37f688e-b38c-4389-b7b8-62c1440b791c",
                                                "sense_id": "b9cadf50-351a-3cf2-a80c-d5ad90e9fbd5",
                                                "text": "Le couple fit construire une maison à la sortie de la petite route périlleuse qui mène à Rosas et y ajouta un mini-golf pour attirer les touristes ainsi qu'une guinguette de plage. Le mini-golf fut un échec, […]."
                                            },
                                            {
                                                "example_id": "66c2e300-e221-47f8-8710-4d6eb2761a0f",
                                                "sense_id": "b9cadf50-351a-3cf2-a80c-d5ad90e9fbd5",
                                                "text": "Occasion périlleuse."
                                            },
                                            {
                                                "example_id": "4eab69b3-0d99-40b8-9d57-260d47a90028",
                                                "sense_id": "b9cadf50-351a-3cf2-a80c-d5ad90e9fbd5",
                                                "text": "Poste périlleux."
                                            },
                                            {
                                                "example_id": "b2c3894c-25e7-4b46-b2cd-97443781081c",
                                                "sense_id": "b9cadf50-351a-3cf2-a80c-d5ad90e9fbd5",
                                                "text": "Situation périlleuse."
                                            },
                                            {
                                                "example_id": "d8f67da7-ac52-405b-9354-3e37e6567e3a",
                                                "sense_id": "b9cadf50-351a-3cf2-a80c-d5ad90e9fbd5",
                                                "text": "Entreprise périlleuse."
                                            },
                                            {
                                                "example_id": "873ffbab-80b1-4e29-a764-8adebd100066",
                                                "sense_id": "b9cadf50-351a-3cf2-a80c-d5ad90e9fbd5",
                                                "text": "Il est périlleux de décider, de parler d’une manière si tranchante."
                                            },
                                            {
                                                "example_id": "a7d30fc7-900f-4e03-98ed-bc66cb5e53c3",
                                                "sense_id": "b9cadf50-351a-3cf2-a80c-d5ad90e9fbd5",
                                                "text": "L’affaire est périlleuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28225022-fa33-4bd9-8cc5-eae3ecaef2c3",
                        "source_entry_id": "519c1bcd-6c4f-361f-aa6d-b5cd694b890a",
                        "source_sense_id": "d84bb755-de66-3108-b936-32fc9a67b28e",
                        "source_sense_description": "dangerous, full of peril",
                        "target_lang_word": "gefährlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
