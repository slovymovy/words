                {
                    "sense_id": "37e57fb3-b059-3741-8809-9c200fef8b72",
                    "sense_definition": "Ambitious or pretentious by reason of newly-acquired wealth",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old aristocracy looked down upon the <w>shoddy</w> families who had recently made their fortunes in trade.",
                            "target_lang_translations": {
                                "ru": "Старая аристократия свысока смотрела на семьи <w>выскочек</w>, которые недавно сколотили состояние на торговле.",
                                "nl": "De oude adel keek neer op de <w>parvenu-families</w> die onlangs hun fortuin in de handel hadden gemaakt.",
                                "cs": "Stará aristokracie shlížela svrchu na <w>zbohatlické</w> rodiny, které nedávno získaly jmění v obchodu."
                            }
                        },
                        {
                            "text": "Their <w>shoddy</w> display of wealth was seen as tasteless by their more established neighbors.",
                            "target_lang_translations": {
                                "ru": "Их <w>нуворишеская</w> демонстрация богатства была воспринята их более родовитыми соседями как безвкусица.",
                                "nl": "Hun vertoon van rijkdom als <w>parvenu's</w> werd door hun meer gevestigde buren als smakeloos beschouwd.",
                                "cs": "Jejich <w>parvenuské</w> vystavování bohatství na odiv považovali usedlejší sousedé za nevkusné."
                            }
                        }
                    ],
                    "synonyms": [
                        "nouveau riche",
                        "upstart"
                    ],
