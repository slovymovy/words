                "senses": [
                    {
                        "sense_id": "2e315b67-c202-3c1b-9ff0-92090a46f867",
                        "entry_id": "5d4fda93-c73e-320a-b933-6448dfae58e1",
                        "glosses": [
                            "невысокий лес; пространство, поросшее мелким лесом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3ac384c-1cbc-44e1-98b2-34aaa84eb6e2",
                                "sense_id": "2e315b67-c202-3c1b-9ff0-92090a46f867",
                                "text": "Тусклый блеск волнами ходит по мелколесью от каждого, даже самого слабого ветерка."
                            },
                            {
                                "example_id": "ea3983cd-9f27-4461-98a9-717bb73f1ab3",
                                "sense_id": "2e315b67-c202-3c1b-9ff0-92090a46f867",
                                "text": "Мы остановились и смотрели на пробегающий мимо берег, крутой, размытый, квасно-глинистый, прорезанный ложбинками с мелколесьем."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c541a271-8017-49f7-b886-de9e19398195",
                        "source_entry_id": "5d4fda93-c73e-320a-b933-6448dfae58e1",
                        "source_sense_id": "2e315b67-c202-3c1b-9ff0-92090a46f867",
                        "target_lang_word": "undergrowth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undergrowth",
