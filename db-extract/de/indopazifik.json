                    {
                        "sense_id": "51f9955b-ce60-36ce-9369-7eccac73fcbd",
                        "entry_id": "04718296-6190-3bf7-962c-56aabccabb3f",
                        "glosses": [
                            "Gebiet, das aus dem nördlichen Indischen Ozean, dem westlichen Zentralpazifik sowie einigen Nebenmeeren besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e460da89-885c-4417-b06c-a547ca6926a7",
                                "sense_id": "51f9955b-ce60-36ce-9369-7eccac73fcbd",
                                "text": "„Beim Zusammenstoß mit einem unbekannten Objekt im Indopazifik hat es an einem Atom-U-Boot der US-Streitkräfte Schäden gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "556d321d-098e-497e-b87c-d37ba4395fc0",
                        "source_entry_id": "04718296-6190-3bf7-962c-56aabccabb3f",
                        "source_sense_id": "51f9955b-ce60-36ce-9369-7eccac73fcbd",
                        "source_sense_description": "Gebiet, das aus dem nördlichen Indischen Ozean, dem westlichen Zentralpazifik sowie einigen Nebenmeeren besteht",
                        "target_lang_word": "Indo-Pacific",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Indo-Pacific",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11195ae7-4c2e-3fd9-aece-d21cdbacea54",
                                        "entry_id": "626f156a-4dc8-30d2-aa7d-e8410fe23b20",
                                        "glosses": [
                                            "Of or pertaining to the tropical parts of the Indian Ocean and of the western Pacific Ocean."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66781a55-9379-4ab2-830b-2ca4eacf541a",
                                                "sense_id": "11195ae7-4c2e-3fd9-aece-d21cdbacea54",
                                                "text": "There is also, after independence, the problem of military protection. History shows that no Indo-Pacific island has hitherto been able to survive without foreign intervention."
                                            },
                                            {
                                                "example_id": "d3a931c0-d12c-46c4-8cac-64b4c28750c3",
                                                "sense_id": "11195ae7-4c2e-3fd9-aece-d21cdbacea54",
                                                "text": "President Biden affirmed his priorities of protecting the American people’s security, prosperity, health, and way of life, and preserving a free and open Indo-Pacific."
                                            },
                                            {
                                                "example_id": "d6a79b16-8b4d-4d0e-8a19-86d02c916d47",
                                                "sense_id": "11195ae7-4c2e-3fd9-aece-d21cdbacea54",
                                                "text": "Meanwhile, Japan must bolster its own defenses and substantially increase defense spending to meet new threats. Tokyo should swallow some of its suspicions and move more quickly to rebuild frayed ties with South Korea. It should make cooperation with the United States a cornerstone of its engagement throughout the Indo-Pacific and with NATO. It is a full agenda and there is no time to lose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
