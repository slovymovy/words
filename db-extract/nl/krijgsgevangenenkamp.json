                        "examples": [
                            {
                                "example_id": "5f8ee941-a8dc-4800-8f28-3d4c4d0698d9",
                                "sense_id": "f40cb39a-bd40-31df-9158-be1d0f330f20",
                                "text": "Een groep van vijftig officieren van de Britse luchtmacht is te voet op weg van het voormalige krijgsgevangenenkamp Stalag Luft III in Polen naar een oorlogsbegraafplaats, ook in Polen. Daarmee herdenken zij het 70-jarige jubileum van The Great Escape en de vijftig geallieerden die tijdens die ontsnapping werden betrapt en geëxecuteerd."
                            },
                            {
                                "example_id": "682c8504-2820-455e-a2d9-4b1f64e0d46f",
                                "sense_id": "f40cb39a-bd40-31df-9158-be1d0f330f20",
                                "text": "Bergen-Belsen, in Noord-Duitsland, werd in 1940 ingericht om dienst te doen als krijgsgevangenenkamp. Met name Russische krijgsgevangenen leefden hier onder erbarmelijke omstandigheden."
                            }
