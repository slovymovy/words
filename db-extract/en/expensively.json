                                        "sense_id": "428b0eb5-ab13-32bf-94d7-b1680ac369e6",
                                        "entry_id": "f3df11d9-9d47-3dc5-b919-4ea78e60e81f",
                                        "glosses": [
                                            "перен. будучи добытым с большим трудом, ценой больших усилий, потерь, жертв"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c108be7b-2f07-39e9-a06e-1b8882133cf8",
                                        "entry_id": "f3df11d9-9d47-3dc5-b919-4ea78e60e81f",
