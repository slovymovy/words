                        "source_entry_id": "7be9f09b-85af-39a0-bddb-7f190791e7e8",
                        "source_sense_id": "8e3eedfb-db49-34e8-8115-9cd29c76a6a1",
                        "source_sense_description": "Pächter einer sehr kleinen Landwirtschaft",
                        "target_lang_word": "Kleinbauer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleinbauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29dd3923-fdcf-34d1-b08a-1275583744fe",
                                        "entry_id": "81951aaa-ddf0-3931-9aeb-ce6140cff700",
                                        "glosses": [
                                            "Bauer, der einen kleinen (ertragsarmen/umsatzarmen) landwirtschaftlichen Betrieb hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf92c7a7-5c93-4ba2-87ac-c0ccac7c5f0c",
                                                "sense_id": "29dd3923-fdcf-34d1-b08a-1275583744fe",
                                                "text": "Heutzutage gibt kaum noch hauptberufliche Kleinbauern, da es unrentabel ist."
                                            },
                                            {
                                                "example_id": "f5c924b3-5a1a-4ff7-a625-c18c5dfd5193",
                                                "sense_id": "29dd3923-fdcf-34d1-b08a-1275583744fe",
                                                "text": "„Nördlich des Hauses hatten großspurige Kleinbauern auf der Hauswiese Torf gestochen.“"
                                            },
                                            {
                                                "example_id": "0b5ec3d0-54d5-4e6b-99dc-73bfc4bcd940",
                                                "sense_id": "29dd3923-fdcf-34d1-b08a-1275583744fe",
                                                "text": "„Die Kleinbauern, die Ausbauern und Kossäten ringsum auf der Heide backen ihr Brot selber in kleinen Backöfen aus Feldsteinen.“"
                                            },
                                            {
                                                "example_id": "e6866995-82a9-42d6-8457-1d6e04bdfe81",
                                                "sense_id": "29dd3923-fdcf-34d1-b08a-1275583744fe",
                                                "text": "„Südlich der Sahara sind das vor allem die Kleinbauern.“"
                                            },
                                            {
                                                "example_id": "7d98b1e8-4e9c-47fc-a352-4b5deac188da",
                                                "sense_id": "29dd3923-fdcf-34d1-b08a-1275583744fe",
                                                "text": "„Es gab keine richtige Planung, und die Behörden ließen die Kleinbauern im Stich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
