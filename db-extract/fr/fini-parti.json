                "senses": [
                    {
                        "sense_id": "1cb06d88-c847-31a9-9c09-d52096e388c4",
                        "entry_id": "62b39cc8-b109-3e85-8a62-4871912e88e9",
                        "glosses": [
                            "Système permettant à un travailleur de débaucher quelle que soit l'heure, une fois qu’il estime son travail terminé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d53fb11a-c318-4d68-a6a9-e4ec02f81bd0",
                                "sense_id": "1cb06d88-c847-31a9-9c09-d52096e388c4",
                                "text": "Gaston Defferre avait accordé à FO la mise en place d'un système que l'on appelle le «fini-parti». Les salariés font leur tournée de poubelles, et lorsqu'elle est achevée, ils peuvent rentrer chez eux, certains entamant alors une deuxième journée de travail - souvent comme dockers à l'époque."
                            },
                            {
                                "example_id": "af695d3a-132e-446e-9560-321e48656e77",
                                "sense_id": "1cb06d88-c847-31a9-9c09-d52096e388c4",
                                "text": "\"Le fini-parti, c'est un problème de maîtrise\". Autrement dit, la question est surtout de vérifier si le fini est bien fini avant de laisser les agents partir."
                            },
                            {
                                "example_id": "2e8b7411-c7e5-4471-b341-b2bb6a6642cd",
                                "sense_id": "1cb06d88-c847-31a9-9c09-d52096e388c4",
                                "text": "Le fini-parti et l'application stricte des 35 heures ne font pas bon ménage."
                            }
                        ]
                    }
                ],
