                ],
                "senses": [
                    {
                        "sense_id": "b2c2c77d-e337-3f9d-a147-9a376057a860",
                        "entry_id": "7701bc86-6cc3-3f24-ae20-7bc05e9e86e8",
                        "glosses": [
                            "ein imaginäres (= nicht existierendes) Wesen, das für Fehler in gedruckten Texten verantwortlich gemacht wird"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "356b42dc-6c05-4d20-b4f9-4ff864abafca",
                                "sense_id": "b2c2c77d-e337-3f9d-a147-9a376057a860",
                                "text": "Der Druckfehlerteufel hat in meinem Artikel dreimal zugeschlagen. (= In meinem Artikel sind drei Druckfehler.)"
                            },
                            {
                                "example_id": "eab2f3f3-d22a-4ba7-94eb-2d9b8dc1d129",
                                "sense_id": "b2c2c77d-e337-3f9d-a147-9a376057a860",
                                "text": "Der Druckfehlerteufel hat sich in den Text eingeschlichen."
                            },
                            {
                                "example_id": "5796818a-2666-483b-8522-661d04b8f5f2",
                                "sense_id": "b2c2c77d-e337-3f9d-a147-9a376057a860",
                                "text": "„Offenbar gibt es da, wie den bekannten Druckfehlerteufel, einen speziellen »Denkfehlerteufel«, über dessen Klumpfuß wir alle hin und wieder einmal stolpern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
