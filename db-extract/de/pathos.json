                "senses": [
                    {
                        "sense_id": "58dce69b-dc7e-3e1f-927a-f711e3e2d350",
                        "entry_id": "a21357ad-7a09-3bf1-a8eb-cf7f9c8347f6",
                        "glosses": [
                            "eine leidenschaftliche Ergriffenheit oder ein leidenschaftliches Verhalten"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "875c6351-0121-3e03-a1c2-ef5b9aebc2bf",
                        "entry_id": "a21357ad-7a09-3bf1-a8eb-cf7f9c8347f6",
                        "glosses": [
                            "(übertriebener) Gefühlsausdruck"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d047c1fe-dd3d-4ff5-bca0-2cb429ab45c4",
                                "sense_id": "875c6351-0121-3e03-a1c2-ef5b9aebc2bf",
                                "text": "Die Hochzeit wurde mit großem Pathos begangen."
                            },
                            {
                                "example_id": "7637e076-d3fb-40ec-b5c9-4d34d6e139dd",
                                "sense_id": "875c6351-0121-3e03-a1c2-ef5b9aebc2bf",
                                "text": "„Almuth lächelte über ihr eigenes Pathos.“"
                            },
                            {
                                "example_id": "17c21de9-9dad-418d-8d34-b94412b073e9",
                                "sense_id": "875c6351-0121-3e03-a1c2-ef5b9aebc2bf",
                                "text": "„Das ist kein Pathos, kein Versuch, homerische Unmittelbarkeit nachzustellen, sondern Literaturspiel für den Kenner.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7036d50f-0e5e-3c88-9ec7-0a21837eedd0",
                        "entry_id": "a21357ad-7a09-3bf1-a8eb-cf7f9c8347f6",
                        "glosses": [
                            "erhabene Feierlichkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38b30b58-aaa0-4cc1-be0e-7e99b6846da2",
                                "sense_id": "7036d50f-0e5e-3c88-9ec7-0a21837eedd0",
                                "text": "„Was ihnen an der Tragödie gefiel, war das Pathos, die Reden über die Politik und den Verfall der Sitten.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "40655014-6997-39fe-b039-203a69f5f254",
                        "entry_id": "a21357ad-7a09-3bf1-a8eb-cf7f9c8347f6",
                        "glosses": [
                            "Überzeugung durch rednerische Gewalt und emotionalen Appell"
                        ],
                        "tags": [
                            "Rhetorik"
                        ],
                        "examples": [
                            {
                                "example_id": "4d065cb7-4976-446c-8d37-949b626d9bb1",
                                "sense_id": "40655014-6997-39fe-b039-203a69f5f254",
                                "text": "Es gelang ihm, das Publikum mit seinem Pathos zu begeistern."
                            },
                            {
                                "example_id": "059b8396-ad7b-46f4-88d9-6d39fefd8204",
                                "sense_id": "40655014-6997-39fe-b039-203a69f5f254",
                                "text": "Neben Pathos sind Ethos (die Autorität und Glaubwürdigkeit des Sprechers) und Logos (Folgerichtigkeit und Beweisführung) nach Aristoteles Arten der Überzeugung."
                            },
                            {
                                "example_id": "ff6c81fb-2342-4e6a-87db-c46a204879c5",
                                "sense_id": "40655014-6997-39fe-b039-203a69f5f254",
                                "text": "„Mit großem Pathos sprach Kinkel zu seinen Zuhörern.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "36ea81de-a0cc-3bdf-b93c-d7bdc0ae7835",
                        "entry_id": "a21357ad-7a09-3bf1-a8eb-cf7f9c8347f6",
                        "glosses": [
                            "Krankheit oder ein krankhafter Trieb"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"5\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf33f16c-e8fc-4838-8344-e6922a7fde79",
                        "source_entry_id": "a21357ad-7a09-3bf1-a8eb-cf7f9c8347f6",
                        "source_sense_id": "58dce69b-dc7e-3e1f-927a-f711e3e2d350",
                        "source_sense_description": "eine leidenschaftliche Ergriffenheit oder ein leidenschaftliches Verhalten",
                        "target_lang_word": "pathos",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pathos",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec741606-5e27-359d-8ba9-e2e2df5b7e58",
                                        "entry_id": "4373291d-8c91-38d6-96ea-9efe61d63684",
                                        "glosses": [
                                            "The quality or property of anything which touches the feelings or excites emotions and passions, especially that which awakens tender emotions, such as pity, sorrow, and the like; contagious warmth of feeling, action, or expression; pathetic quality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f287cf5-3d16-4dbd-b6d4-1c6d8078a2d4",
                                                "sense_id": "ec741606-5e27-359d-8ba9-e2e2df5b7e58",
                                                "text": "His voice had a genuine pathos now, and his large brown hands perceptibly trembled."
                                            },
                                            {
                                                "example_id": "b46d763b-1f4b-4097-894f-c1e3d76fbee0",
                                                "sense_id": "ec741606-5e27-359d-8ba9-e2e2df5b7e58",
                                                "text": "She could not see, for her whitish eyes were covered with a horny film. Oh, the horrible pathos of the sight! But she could still speak."
                                            },
                                            {
                                                "example_id": "e9c2bad3-d8ca-4134-9a87-6edc7309ebf7",
                                                "sense_id": "ec741606-5e27-359d-8ba9-e2e2df5b7e58",
                                                "text": "20 August 2018, Rhiannon Lucy Cosslett in The Guardian, Young women are smashing it at Edinburgh as the #MeToo legacy kicks in\nPritchard-McLean’s show is perfectly constructed, and at times deeply moving to the point where some audience members were near tears, yet the pathos is undercut by true belly laughs – but don’t trust me, read the reviews."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9df01919-3abf-3a91-8cf8-0d74c15fcf77",
                                        "entry_id": "4373291d-8c91-38d6-96ea-9efe61d63684",
                                        "glosses": [
                                            "A form of rhetoric in which the writer or speaker uses emotional appeals to the audience as the main form of persuasion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c54fea6-7aca-4472-8864-68e85badd0c7",
                                                "sense_id": "9df01919-3abf-3a91-8cf8-0d74c15fcf77",
                                                "text": "It was impossible to endure the jargon and the affected pathos of the squire any longer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6faef525-b3ae-313f-ab6e-5994bc5fa795",
                                        "entry_id": "4373291d-8c91-38d6-96ea-9efe61d63684",
                                        "glosses": [
                                            "An author's attempt to evoke a feeling of pity or sympathetic sorrow for a character."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81c974c8-b546-3df7-a0a5-3063b2b6682d",
                                        "entry_id": "4373291d-8c91-38d6-96ea-9efe61d63684",
                                        "glosses": [
                                            "In theology and existentialist ethics following Kierkegaard and Heidegger, a deep and abiding commitment of the heart, as in the notion of \\\"finding your passion\\\" as an important aspect of a fully lived, engaged life."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f914f0b-8304-3eb7-8af5-c17eb827c95b",
                                        "entry_id": "4373291d-8c91-38d6-96ea-9efe61d63684",
                                        "glosses": [
                                            "Suffering; the enduring of active stress or affliction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9435f808-6232-4b9e-b834-bd00f2953b74",
                        "source_entry_id": "a21357ad-7a09-3bf1-a8eb-cf7f9c8347f6",
                        "source_sense_id": "58dce69b-dc7e-3e1f-927a-f711e3e2d350",
                        "source_sense_description": "eine leidenschaftliche Ergriffenheit oder ein leidenschaftliches Verhalten",
                        "target_lang_word": "pathos",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pathos",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d40379b-4ade-3206-b3e8-e74d6def5297",
                                        "entry_id": "19c60577-7b7c-3b5e-9ff6-7a4acaebdcb1",
                                        "glosses": [
                                            "Chaleur, emphase affectée, confuse et vaine dans un discours, dans un ouvrage littéraire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40b61714-e240-4e83-aa45-3ead6de743da",
                                                "sense_id": "0d40379b-4ade-3206-b3e8-e74d6def5297",
                                                "text": "Modeste m’a dit que tout ce pathos venait du traducteur et qu’il fallait lire l’anglais. Mais, je n’irai pas apprendre l’anglais pour lord Byron."
                                            },
                                            {
                                                "example_id": "53c4fe8c-1336-49a0-a347-5258503ed847",
                                                "sense_id": "0d40379b-4ade-3206-b3e8-e74d6def5297",
                                                "text": "Au milieu du pathos prétentieux qui a envahi, de nos jours, l’apologétique chrétienne, s’est conservée une école de solide doctrine, répudiant l’éclat, abhorrant le succès."
                                            },
                                            {
                                                "example_id": "5fbb8df2-8c40-4408-86af-6c7dd203f95d",
                                                "sense_id": "0d40379b-4ade-3206-b3e8-e74d6def5297",
                                                "text": "En face d'elle, qui ne demande rien à personne et s'impose sans barguigner ses horaires de smigarde, ses nuits de rab et ses veillées de grimaçant pathos, pour qui donc aurais-je le toupet de me prendre ?"
                                            },
                                            {
                                                "example_id": "09cb3bab-381d-4af9-86d2-7c33210ace00",
                                                "sense_id": "0d40379b-4ade-3206-b3e8-e74d6def5297",
                                                "text": "Les gens pourvus de pudeur sont censés s’exprimer froidement, et sans le pathos des prostituées… Ou des poètes."
                                            },
                                            {
                                                "example_id": "2c5e4d4b-68cf-4b92-98c6-4d87215f04ce",
                                                "sense_id": "0d40379b-4ade-3206-b3e8-e74d6def5297",
                                                "text": "Ses lettres prouvent qu’elle l’accomplit en pleine lucidité, elles sont sans pathos, elle met rapidement ses affaires en ordre, elle sait qu’elle est en train de mourir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
