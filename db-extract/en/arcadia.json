                        "tags": [
                            "plural"
                        ],
                        "form": "Arcadias"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "052a88f5-ef35-329c-a9a9-2d2614955662",
                        "entry_id": "65fc7077-b162-32fc-9a03-a0daf66bab53",
                        "glosses": [
                            "An ideal region of rural and idyllic contentment; a pastoral utopia."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d07be866-af4e-49f2-9d64-c7fa17fcb9e6",
                                "sense_id": "052a88f5-ef35-329c-a9a9-2d2614955662",
                                "text": "The homosexual visitors to these southern Mediterranean regions may have been influenced by an imagined geography circulated through classical understandings of homosexuality in their search for a kind of Arcadia where homosexual love and lust could be played out without fear of persecution."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3b00ac5-6314-4e6c-84d4-1283f8433dc7",
                        "source_entry_id": "65fc7077-b162-32fc-9a03-a0daf66bab53",
                        "source_sense_id": "052a88f5-ef35-329c-a9a9-2d2614955662",
                        "source_sense_description": "a district or a prefecture in the central and mid SE Peloponnese",
                        "target_lang_word": "Arcadië",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
