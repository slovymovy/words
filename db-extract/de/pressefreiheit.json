                                        "glosses": [
                                            "Het grondrecht om gedachten of gevoelens openbaar te maken in de media"
                                        ],
                                        "tags": [
                                            "media"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6faabb9-ea6e-4e00-a07e-c5c4cd73d903",
                                                "sense_id": "2571b6c8-04ca-3d40-a295-67cea2f2dada",
                                                "text": "Hoofdredacteuren maken zich zorgen om Nederlandse persvrijheid"
                                            },
                                            {
                                                "example_id": "61792f26-4733-42b7-8be5-b2d757c0d663",
                                                "sense_id": "2571b6c8-04ca-3d40-a295-67cea2f2dada",
                                                "text": "De Nobelprijs voor de Vrede zou ook naar een organisatie kunnen gaan. Zo maakt Verslaggevers Zonder Grenzen, dat wereldwijd strijdt voor persvrijheid, volgens PRIO kans. En wordt de Control Arms Coalition, een wereldwijd samenwerkingsverband voor verantwoorde wapenhandel, veel genoemd."
                                            }
                                        ]
                                    }
                                ]
