                "senses": [
                    {
                        "sense_id": "7f24eff3-d3d7-374e-a203-9987f2a7a01b",
                        "entry_id": "5db60725-e5c4-3fad-87a7-eda6ed4843a7",
                        "glosses": [
                            "kleine Knödel aus Semmelbröseln (besonders als Suppeneinlage)"
                        ],
                        "tags": [
                            "österreichische Küche"
                        ],
                        "examples": [
                            {
                                "example_id": "6c6e953e-d067-40ad-adb9-5bfbebfe3969",
                                "sense_id": "7f24eff3-d3d7-374e-a203-9987f2a7a01b",
                                "text": "„Die Bröselknödel sind eine aus dem Burgenland stammende Suppeneinlage, die als genussvolle Einlage zu Ganslsuppe nach Burgenländischer Art dienen. Sie schmecken aber auch zu allen anderen Brühen sehr bekömmlich.“"
                            },
                            {
                                "example_id": "ba82e92b-a772-4b5d-ae0f-2483aa9e5147",
                                "sense_id": "7f24eff3-d3d7-374e-a203-9987f2a7a01b",
                                "text": "„Für die Bröselknödel Butter, Ei, Salz und Muskat abtreiben. So viel Semmelbrösel dazugeben, dass ein mittelfester Teig entsteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
