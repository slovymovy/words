                "senses": [
                    {
                        "sense_id": "f589b1ee-2d46-34cb-98d2-579e153909a0",
                        "entry_id": "2bff76ca-6abb-3a4d-9333-1e842173cdeb",
                        "glosses": [
                            "небольшой камин; также небольшая печка, очаг для обогревания жилища"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ca93a19-6500-44f9-bcde-24efc3c87274",
                                "sense_id": "f589b1ee-2d46-34cb-98d2-579e153909a0",
                                "text": "Хатка его небольшая, в два окна, с камельком вместо печи."
                            },
                            {
                                "example_id": "b65e76bf-185a-48b0-87a1-ee4b1415b25a",
                                "sense_id": "f589b1ee-2d46-34cb-98d2-579e153909a0",
                                "text": "Перед камельком стоял на коленях белоголовый старик в чёрной сатиновой рубахе и подбрасывал дрова."
                            },
                            {
                                "example_id": "a281c496-bd80-4620-93ab-238b3c31b5d0",
                                "sense_id": "f589b1ee-2d46-34cb-98d2-579e153909a0",
                                "text": "Дверь была прикрыта, а от камелька жаром несло, как от домны."
                            }
                        ]
                    }
                ],
