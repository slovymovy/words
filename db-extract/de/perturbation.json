                    },
                    {
                        "translation_id": "ffb3d200-3304-4697-84dd-05c6a21f9684",
                        "source_entry_id": "18867f01-1e5e-3175-8a0e-da21e3912c19",
                        "source_sense_id": "66991cbc-a3f3-3dbf-b565-785e59e18205",
                        "source_sense_description": "Astronomie: Störung in der Bewegung eines Gestirns",
                        "target_lang_word": "пертурбация",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пертурбация",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "97dc5185-5709-37da-ae89-6ddf9fa4d750",
                                        "entry_id": "740d761b-3c48-3696-994b-8288b5a40fc6",
                                        "glosses": [
                                            "астрон. изменение пути небесного тела под воздействием силы притяжения других тел"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8313c0da-63cd-475e-8b98-bcf5cf333732",
                                                "sense_id": "97dc5185-5709-37da-ae89-6ddf9fa4d750",
                                                "text": "Это то же, что пертурбации, которые суть кажущиеся уклонения факта движения планет от доктрин Ньютона, но в сущности, как и показано потом, теми же Ньютоновыми началами вполне выражаются."
                                            },
                                            {
                                                "example_id": "ea16eecf-6e8c-4c89-a05c-d5fb22fd3133",
                                                "sense_id": "97dc5185-5709-37da-ae89-6ddf9fa4d750",
                                                "text": "И вот, на основании тщательного наблюдения пертурбаций Урана, астроном Леверье предсказал существование другой планеты, до тех пор совершенно неизвестной и ещё никем не виданной, и точно вычислил её величину, диаметр, объём, массу, плотность, расстояние её от Солнца и орбиту движения вокруг Солнца."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f50c07ed-c69a-3a5b-b267-81ec8bae2680",
                                        "entry_id": "740d761b-3c48-3696-994b-8288b5a40fc6",
                                        "glosses": [
                                            "перен. внезапное, резкое нарушение нормального хода чего-либо, вызывающее замешательство, смятение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8be5b9b1-9bdd-4fc9-85e0-8e0a2bc6b3cb",
                                                "sense_id": "f50c07ed-c69a-3a5b-b267-81ec8bae2680",
                                                "text": "Силы в тебе бушуют. Тебе бы теперь дербалызнуть хорошенечко, выпить этак, знаешь, чтоб во всём теле пертурбация произошла. Пьянство отлично освежает…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
