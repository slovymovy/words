                    {
                        "translation_id": "e7ad6803-d0bd-48d8-a4ad-79874c88fcb4",
                        "source_entry_id": "a280f922-85a2-3729-998f-65d2e9615748",
                        "source_sense_id": "671aca8d-8b40-3cec-8f03-463956af781b",
                        "source_sense_description": "Dokument, das zum Führen eines Luftfahrzeugs berechtigt",
                        "target_lang_word": "vliegbrevet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vliegbrevet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "03bb93a7-84da-3ce2-a73c-03a2a39cd18f",
                                        "entry_id": "159ad3c2-bf1c-3dae-94ce-9ad23e3835cb",
                                        "glosses": [
                                            "officieel diploma waarmee je kunt aantonen een erkend vliegtuigbestuurder te zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5501e1e-68c7-4d0b-9b16-1a5772cc55bb",
                                                "sense_id": "03bb93a7-84da-3ce2-a73c-03a2a39cd18f",
                                                "text": "Er zijn immers voldoende opgeleide vliegers voorhanden die bijvoorbeeld ervaring hebben bij defensie. Deze zij-instromers zouden alleen een beperkte vorm van extra training nodig hebben om bij de politie aan te slag te gaan, terwijl agenten zonder vliegbrevet een complete opleiding nodig hebben die vele tienduizenden euro’s kost."
                                            },
                                            {
                                                "example_id": "b6cca0a0-2cf9-4535-9aa4-e1c5411cede0",
                                                "sense_id": "03bb93a7-84da-3ce2-a73c-03a2a39cd18f",
                                                "text": "Willem-Alexander kreeg tijdens het afsluitende persgesprek ook een vraag over zijn vliegbrevet. Of hij niet graag in de cockpit zou willen kruipen van het huurtoestel waarmee hij naar en in Italië reisde. Nee hoor, zei het staatshoofd beslist. U heeft het allemaal in De Telegraaf kunnen lezen: Ik ben bevoegd voor de 737 van KLM. Dus of zijn handen jeukten? Absoluut niet."
                                            },
                                            {
                                                "example_id": "31fe78a7-2e91-4379-a7db-23bb26697cfb",
                                                "sense_id": "03bb93a7-84da-3ce2-a73c-03a2a39cd18f",
                                                "text": "Levi van Kempen is afgelopen weekeinde met de schrik vrijgekomen. De presentator en acteur, die een vliegbrevet heeft, moest in de Verenigde Staten een noodlanding maken, maar dat ging mis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
