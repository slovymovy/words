                        "sense_id": "9db05fc2-ca9d-305e-bcd6-84c0237f664b",
                        "entry_id": "0beed63b-5b9b-33fe-8758-9fc0a68c5377",
                        "glosses": [
                            "Aliment végétalien imitant la texture et le goût des fromages laitiers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "095d0d0b-be1c-4498-8cd6-69c9642784ec",
                                "sense_id": "9db05fc2-ca9d-305e-bcd6-84c0237f664b",
                                "text": "Dans une cuisine aménagée à même sa maison en banlieue de Québec, Nancy Grenier fabrique à la main, avec l’aide de son mari, plus de 15 000 bûchettes de vromage par mois."
                            },
                            {
                                "example_id": "27f11458-b4af-45af-b4cf-4e46294c6999",
                                "sense_id": "9db05fc2-ca9d-305e-bcd6-84c0237f664b",
                                "text": "Pour un délicieux vromage à tartiner, il suffit de mélanger un yaourt végétal (au lait de soja par exemple) à un peu de margarine végétale et du sel, on peut aussi ajouter d’autres herbes ou épices (lavande, thym basilic, herbes de Provence, ail, cumin, etc.)."
                            }
                        ]
                    }
