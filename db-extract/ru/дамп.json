                                    {
                                        "sense_id": "a39ff46f-a240-339d-b275-a097e4ef0c3a",
                                        "entry_id": "e60a67c8-90e6-3b9d-a45f-fc31854a8e28",
                                        "glosses": [
                                            "A sad, gloomy state of the mind; sadness; melancholy; despondency."
