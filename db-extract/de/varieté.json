                "senses": [
                    {
                        "sense_id": "d46d0279-09a7-386a-98ec-6b9a677fdfb6",
                        "entry_id": "67c12e4f-e6a9-3052-bff5-8c0f9a64300a",
                        "glosses": [
                            "Theatervorstellung mit gemischtem Programm (Artistik, Akrobatik, Tanz, Musik)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5e92771-8ad0-483a-9153-79fdedc3fac2",
                                "sense_id": "d46d0279-09a7-386a-98ec-6b9a677fdfb6",
                                "text": "Mit ihrem vielseitigen Können trat die Gruppe vorrangig in Varietés auf."
                            },
                            {
                                "example_id": "b4349b11-b335-49af-b9b8-65652c88850b",
                                "sense_id": "d46d0279-09a7-386a-98ec-6b9a677fdfb6",
                                "text": "„Auch das Varieté im Central-Hotel hatte man renoviert: noch monumentaler, noch leuchtender, noch luxuriöser.“"
                            },
                            {
                                "example_id": "6872f100-2065-4fbd-91a4-32185e9351ad",
                                "sense_id": "d46d0279-09a7-386a-98ec-6b9a677fdfb6",
                                "text": "„Ich unterbrach sie und erzählte ihr von dem Reinfall, den ich im Varieté erlebt hatte, dem ersten seit drei Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
