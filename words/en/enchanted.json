{
    "word_family": [
        "enchant",
        "enchantment",
        "enchanter",
        "enchantress",
        "enchanting",
        "enchantingly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0b964083-d0c7-33f9-a0f3-e0d7e3068315",
                    "sense_definition": "Placed under a magical spell or having magical qualities.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hero had to find a way to enter the <w>enchanted</w> castle guarded by a dragon.",
                            "target_lang_translations": {
                                "ru": "Герою нужно было найти способ проникнуть в <w>заколдованный</w> замок, охраняемый драконом."
                            }
                        },
                        {
                            "text": "They wandered through the <w>enchanted</w> forest where the trees seemed to whisper to them.",
                            "target_lang_translations": {
                                "ru": "Они бродили по <w>волшебному</w> лесу, где деревья, казалось, шептались с ними."
                            }
                        }
                    ],
                    "synonyms": [
                        "magical",
                        "bewitched",
                        "spellbound"
                    ],
                    "antonyms": [
                        "ordinary",
                        "mundane"
                    ],
                    "common_phrases": [
                        "enchanted forest",
                        "enchanted castle",
                        "enchanted object"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся под действием магического заклинания или обладающий магическими свойствами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заколдованный",
                                "target_lang_sense_clarification": "находящийся под действием чар"
                            },
                            {
                                "target_lang_word": "волшебный",
                                "target_lang_sense_clarification": "обладающий магией"
                            },
                            {
                                "target_lang_word": "чарующий",
                                "target_lang_sense_clarification": "магически привлекательный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83c5a4c9-d4dc-3759-b5f9-1e6ca7d88133",
                    "sense_definition": "Feeling great pleasure, delight, or fascination.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children listened, <w>enchanted</w> by the storyteller’s voice as she described distant lands.",
                            "target_lang_translations": {
                                "ru": "Дети слушали, <w>очарованные</w> голосом рассказчицы, описывающей далекие страны."
                            }
                        },
                        {
                            "text": "We spent an <w>enchanted</w> evening watching the sunset over the calm ocean.",
                            "target_lang_translations": {
                                "ru": "Мы провели <w>чудесный</w> вечер, наблюдая за закатом над спокойным океаном."
                            }
                        }
                    ],
                    "synonyms": [
                        "delighted",
                        "captivated",
                        "charmed",
                        "enthralled"
                    ],
                    "antonyms": [
                        "disenchanted",
                        "repelled",
                        "bored"
                    ],
                    "common_phrases": [
                        "enchanted evening",
                        "enchanted by the beauty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий сильное удовольствие, восторг или очарование."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очарованный",
                                "target_lang_sense_clarification": "находящийся в восторге"
                            },
                            {
                                "target_lang_word": "плененный",
                                "target_lang_sense_clarification": "сильно увлеченный чем-то"
                            },
                            {
                                "target_lang_word": "восхищенный",
                                "target_lang_sense_clarification": "испытывающий глубокое восхищение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc2b0a8c-ea02-3292-8ea3-e7316fea0896",
                    "sense_definition": "Simple past and past participle of <w>enchant</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wizard <w>enchanted</w> the sword so that it would never break in battle.",
                            "target_lang_translations": {
                                "ru": "Волшебник <w>заколдовал</w> меч, чтобы тот никогда не ломался в бою."
                            }
                        },
                        {
                            "text": "Her beautiful singing voice <w>enchanted</w> everyone who attended the concert last night.",
                            "target_lang_translations": {
                                "ru": "Ее прекрасный певческий голос <w>очаровал</w> всех, кто пришел на вчерашний концерт."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время глагола «очаровывать» или «заколдовывать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заколдовал",
                                "target_lang_sense_clarification": "наложил заклятие"
                            },
                            {
                                "target_lang_word": "очаровал",
                                "target_lang_sense_clarification": "привел в восторг"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "23384425-0d4d-388c-8388-fa0780e6c1f1",
                    "sense_definition": "A formal greeting used when being introduced to someone for the first time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "greeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bowed slightly and murmured, \"<w>Enchanted</w>,\" as he was introduced to the duchess.",
                            "target_lang_translations": {
                                "ru": "Он слегка поклонился и пробормотал: «<w>Очарован</w>», когда его представили герцогине."
                            }
                        },
                        {
                            "text": "While it sounds very old-fashioned today, saying \"<w>Enchanted</w>\" was once a standard polite greeting.",
                            "target_lang_translations": {
                                "ru": "Хотя сегодня это звучит очень старомодно, слово «<w>Очарован</w>» когда-то было стандартным вежливым приветствием."
                            }
                        }
                    ],
                    "synonyms": [
                        "delighted"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "somewhat old-fashioned"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальное приветствие, используемое при знакомстве (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очарован",
                                "target_lang_sense_clarification": "краткая форма при знакомстве"
                            },
                            {
                                "target_lang_word": "очень рад",
                                "target_lang_sense_clarification": "вежливая форма приветствия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}