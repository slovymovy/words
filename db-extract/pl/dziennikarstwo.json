                        "translation_id": "8590d2ab-c9a9-406e-a498-8b3c1b0e560c",
                        "source_entry_id": "75e67594-617b-3136-8934-65901894634f",
                        "source_sense_id": "1b90866c-00cb-3f71-927a-a2edd12b8dfc",
