                        "glosses": [
                            "The presence of an unusually large number of setae compared to other animals in the same natural group."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b355c0d9-b912-4f5b-9f43-e9e553dc1bfa",
                                "sense_id": "c817d498-17e7-3e90-90d7-e9197572f346",
                                "text": "The idiosoma of all ticks carries a number of sensory and glandular structures. The pattern of these structures can be helpful in identification of larvae, but hypertrichy (the presence of \"excessive\" numbers of setae arranged in random patterns) usually makes those characters unworkable in the postlarval instars."
                            },
                            {
                                "example_id": "c0a1aa4e-5e62-4397-970c-f3e5c1ade186",
                                "sense_id": "c817d498-17e7-3e90-90d7-e9197572f346",
                                "text": "All brown lemur populations demonstrate sexual dichromatism and sex-specific patterns in facial hypertrichy (ear tufting, ruffs, and collars), although sex differences in pelage are less marked in E. f. fulvus (Tattersall, 1982; Shedd and Macedonia, 1991; Mittermeier et al., 1994)."
                            }
                        ]
                    }
