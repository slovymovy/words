{
    "word_family": [
        "banqueter",
        "banqueting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f77d0292-8825-32af-9ffa-d6e4b1ef4bf5",
                    "sense_definition": "A large celebratory meal or feast.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "feast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king prepared a grand <w>banquet</w> to celebrate the victory of his army.",
                            "target_lang_translations": {
                                "zh": "国王准备了一场盛大的<w>宴会</w>来庆祝军队的胜利。"
                            }
                        },
                        {
                            "text": "Guests enjoyed a delicious <w>banquet</w> at the wedding reception.",
                            "target_lang_translations": {
                                "zh": "客人们在婚礼招待会上享用了美味的<w>宴席</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reception"
                    ],
                    "common_phrases": [
                        "wedding banquet",
                        "royal banquet"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种大型的庆祝性餐宴或盛宴。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "宴会",
                                "target_lang_sense_clarification": "指正式的聚餐或庆祝活动。"
                            },
                            {
                                "target_lang_word": "盛宴",
                                "target_lang_sense_clarification": "指规模宏大、菜肴丰盛的宴席。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd63f842-ddd1-3364-9dec-734d9d2875fb",
                    "sense_definition": "A formal dinner party held for many people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "feast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity <w>banquet</w> raised significant funds for the local hospital.",
                            "target_lang_translations": {
                                "zh": "这场慈善<w>宴会</w>为当地医院筹集了大量资金。"
                            }
                        },
                        {
                            "text": "The annual <w>banquet</w> brought together leaders from across the country.",
                            "target_lang_translations": {
                                "zh": "年度<w>宴会</w>汇集了来自全国各地的领导人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "charity banquet",
                        "annual banquet"
                    ],
                    "target_lang_definitions": {
                        "zh": "为多人举办的正式晚宴。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "宴会",
                                "target_lang_sense_clarification": "指正式的社交聚餐。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42038d83-e847-3799-b48e-85a24800c30a",
                    "sense_definition": "A course of sweetmeats or dessert served after a meal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dessert",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guests retired to the parlor to enjoy a light <w>banquet</w> of fruits and cakes.",
                            "target_lang_translations": {
                                "zh": "客人们退到客厅，享用了一份清淡的<w>甜点</w>，包括水果和蛋糕。"
                            }
                        },
                        {
                            "text": "After the main course, the host served a traditional <w>banquet</w> of sweetmeats.",
                            "target_lang_translations": {
                                "zh": "主菜过后，主人端上了传统的<w>甜点</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to an older usage of the term for a dessert course."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古语）正餐后供应的甜点或糖果。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "甜点",
                                "target_lang_sense_clarification": "指餐后食用的甜食。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5852d816-a89c-354b-9e86-ff4b4bacdd44",
                    "sense_definition": "To participate in a large, celebratory feast.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "feast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nobles would <w>banquet</w> for hours in the great hall.",
                            "target_lang_translations": {
                                "zh": "贵族们会在大厅里<w>宴饮</w>数小时。"
                            }
                        },
                        {
                            "text": "They gathered to <w>banquet</w> and celebrate the end of the harvest season.",
                            "target_lang_translations": {
                                "zh": "他们聚在一起<w>赴宴</w>，庆祝收获季节的结束。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "参加大型的庆祝性宴席。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "赴宴",
                                "target_lang_sense_clarification": "指去参加宴会。"
                            },
                            {
                                "target_lang_word": "宴饮",
                                "target_lang_sense_clarification": "指在宴会上饮酒进食。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1ac0b6b-f8e3-32fc-b20d-b027c613b284",
                    "sense_definition": "To provide someone with a sumptuous meal or entertainment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "feast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The host decided to <w>banquet</w> his guests with the finest local delicacies.",
                            "target_lang_translations": {
                                "zh": "主人决定用当地最顶级的美味佳肴来<w>宴请</w>宾客。"
                            }
                        },
                        {
                            "text": "It was a custom to <w>banquet</w> travelers who arrived from distant lands.",
                            "target_lang_translations": {
                                "zh": "从远方而来的旅客，当地有<w>宴请</w>他们的习俗。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用丰盛的餐点或娱乐款待某人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "宴请",
                                "target_lang_sense_clarification": "指设宴招待客人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26d24574-c9e9-38e1-9edc-41393d1f72a5",
                    "sense_definition": "To eat dessert or sweetmeats after a main meal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dessert",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guests moved to the garden to <w>banquet</w> on honey cakes.",
                            "target_lang_translations": {
                                "zh": "客人们移步花园，<w>吃</w>起了蜂蜜蛋糕。"
                            }
                        },
                        {
                            "text": "They would often <w>banquet</w> after the main feast had concluded.",
                            "target_lang_translations": {
                                "zh": "正餐结束后，他们经常会再<w>吃</w>些甜点。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to the historical practice of having a separate dessert course."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古语）在正餐后享用甜点。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "吃甜点",
                                "target_lang_sense_clarification": "指餐后享用甜食。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}