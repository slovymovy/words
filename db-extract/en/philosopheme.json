                        "sense_id": "778baf88-84c3-30bf-9f19-6d7d4ecd11e4",
                        "entry_id": "1c41ebb3-fb98-31b1-8d1e-360c66b24d36",
                        "glosses": [
                            "A philosophical statement, theorem or axiom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49580175-9af9-4232-8f3b-23cf9c4149cd",
                                "sense_id": "778baf88-84c3-30bf-9f19-6d7d4ecd11e4",
                                "text": "This, the most venerable, and perhaps the most ancient, of Grecian mythi, is a philosopheme."
                            },
                            {
                                "example_id": "94fe9e6b-1924-4486-9606-07894a0aa717",
                                "sense_id": "778baf88-84c3-30bf-9f19-6d7d4ecd11e4",
                                "text": "Heidegger makes of distortions of bits of ordinary German — particularly nominalisations of prepositions — and his extensive use of a large number of the obscurer philosophemes (big words) of the tradition."
                            },
                            {
                                "example_id": "62b6b9db-b152-4b7c-90df-8a768e15d9c5",
                                "sense_id": "778baf88-84c3-30bf-9f19-6d7d4ecd11e4",
                                "text": "..in those works by Schelling, the didactic tone passes into one of rebuke: readers are frequently taken to task in advance for their inability to understand. Incomprehensible to the reader of his own philosophemes which arise from want of cleverness in his own thinking."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33062d10-e1c1-4d0a-992b-4951396ae36f",
                        "source_entry_id": "1c41ebb3-fb98-31b1-8d1e-360c66b24d36",
                        "source_sense_id": "778baf88-84c3-30bf-9f19-6d7d4ecd11e4",
                        "source_sense_description": "a philosophical statement, theorem or axiom",
                        "target_lang_word": "philosophème",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
