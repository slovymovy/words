                ],
                "senses": [
                    {
                        "sense_id": "36ad4a46-b073-34f0-a375-505fd077d2c4",
                        "entry_id": "7a7f0d9c-1c72-3b5d-9289-5382f7ad5d14",
                        "glosses": [
                            "der Fachbegriff in der Umweltschutzgesetzgebung des deutschen Bundeslandes Baden-Württemberg für ein Schutzgebiet, das für die jeweilige Vegetationszone repräsentativ ist oder eine Besonderheit aufweist"
                        ],
                        "tags": [
                            "Naturschutz"
                        ],
                        "examples": [
                            {
                                "example_id": "f156cfe2-9ab9-4065-96fc-48baac2192b0",
                                "sense_id": "36ad4a46-b073-34f0-a375-505fd077d2c4",
                                "text": "„In Biosphärengebieten … sollen durch Erhaltung und Förderung traditioneller, extensiver Landnutzungsformen sowie durch die Entwicklung und Erprobung neuer besonders schonender Wirtschaftsweisen großräumige, charakteristische Landschaften gesichert werden."
                            },
                            {
                                "example_id": "4930676f-00c4-42bd-ae2d-cb857c30b34f",
                                "sense_id": "36ad4a46-b073-34f0-a375-505fd077d2c4",
                                "text": "„Der Begriff „Biosphärenreservat“ steht international und auf Bundesebene für das modellhafte Miteinander von Ökonomie, Ökologie und Sozialem. Das Land Baden-Württemberg hat sich gegen den Ausdruck „Reservat“ entschieden, in seinem Landesnaturschutzgesetz findet sich unter § 28 stattdessen der Begriff Biosphärengebiet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
