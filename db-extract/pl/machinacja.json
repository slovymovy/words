                    {
                        "translation_id": "4c85e7b9-a69b-4a71-9a5c-aa4cd41638e4",
                        "source_entry_id": "6f52983f-a7ed-3d59-8272-67c8c823dff1",
                        "source_sense_id": "59aab428-dabe-3d07-bdb6-7ad7285ec748",
                        "target_lang_word": "Machenschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Machenschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42af2148-5054-3f75-9952-75ed2cf19e87",
                                        "entry_id": "76b54708-0ba2-3b8a-ad25-b0a76662ffa4",
                                        "glosses": [
                                            "geheime und fragwürdige Abmachung, Intrige"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "575bc1b3-1b75-4907-aa0a-10e0bd4af8f8",
                                                "sense_id": "42af2148-5054-3f75-9952-75ed2cf19e87",
                                                "text": "Seine Machenschaften wurden ihm schließlich zum Verhängnis."
                                            },
                                            {
                                                "example_id": "f1b52f69-3adf-42c9-a976-801f54f6f102",
                                                "sense_id": "42af2148-5054-3f75-9952-75ed2cf19e87",
                                                "text": "„Man geht sogar davon aus, dass ihre Machenschaften von der Regierung stillschweigend gedeckt werden.“"
                                            },
                                            {
                                                "example_id": "1b51c8d3-7b60-4baa-8ade-872208fd90eb",
                                                "sense_id": "42af2148-5054-3f75-9952-75ed2cf19e87",
                                                "text": "„Die Furcht vor südafrikanischen Machenschaften wuchs sich bei Mugabe in den kommenden Jahren zu einer Obsession aus.“"
                                            },
                                            {
                                                "example_id": "ad69f9d5-65eb-4a66-ba37-ccba0d296390",
                                                "sense_id": "42af2148-5054-3f75-9952-75ed2cf19e87",
                                                "text": "„Übler und übler wurden die Machenschaften dunkler Zirkel – auf französischer Seite und auf deutscher.“"
                                            },
                                            {
                                                "example_id": "be8f4693-dfee-4792-9ad1-4f75e3307cd6",
                                                "sense_id": "42af2148-5054-3f75-9952-75ed2cf19e87",
                                                "text": "„Denn Pécuchet war nahe daran, sie zu kennen, und schob alle Verbrechen den Machenschaften der Aristokraten, dem ausländischen Gold in die Schuhe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
