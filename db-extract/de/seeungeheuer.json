                ],
                "senses": [
                    {
                        "sense_id": "e245f03f-494b-3596-898e-6f0e6cf67684",
                        "entry_id": "ccef1adb-e694-3436-9d93-ddf7c1d83fc6",
                        "glosses": [
                            "Ungeheuer, das in einem Meer leben soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9308678d-fbe6-498e-bbfc-9374e1317c24",
                                "sense_id": "e245f03f-494b-3596-898e-6f0e6cf67684",
                                "text": "„Die Sorge, sich den Zorn des Seeungeheuers zuzuziehen war groß, von 1450 bis 1805 wurde täglich in einer Gruftkapelle eine Messe gelesen, um Schlimmes zu verhindern.“"
                            },
                            {
                                "example_id": "f19a577f-b0ae-4796-88c8-29fe3a5d3fdc",
                                "sense_id": "e245f03f-494b-3596-898e-6f0e6cf67684",
                                "text": "„Eine weitere Gefahr lauert in Gestalt des Strudels Charybdis und des sechsköpfigen Seeungeheuers Skylla, zwischen denen Odysseus sein Schiff hindurch manövriert.“"
                            },
                            {
                                "example_id": "ab95b9b6-9f19-4727-879b-e48fd2870c9d",
                                "sense_id": "e245f03f-494b-3596-898e-6f0e6cf67684",
                                "text": "„Mythologische Götter und Göttinnen, Schlangen und Seeungeheuer oder die ersten wissenschaftlichen Instrumente zierten Sternatlanten vom 17. bis ins 19. Jahrhundert – dem goldenen Zeitalter der illustrierten Sternkarten.“"
                            },
                            {
                                "example_id": "bb3f1967-2a9a-46a2-99c3-406c85e31f70",
                                "sense_id": "e245f03f-494b-3596-898e-6f0e6cf67684",
                                "text": "„Das Seeungeheuer, das von der Trockenlegung überascht worden war, mußte durch den Schacht wieder im Meer verschwunden sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
