                "senses": [
                    {
                        "sense_id": "6664e00b-8983-33f2-b310-0445b709473c",
                        "entry_id": "36bcaaf9-e14f-3a6d-a675-6a7da9201abc",
                        "glosses": [
                            "die fadenförmigen Haftorgane der Weinrebe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64d99197-daea-4b7c-82e6-952680c88b30",
                                "sense_id": "6664e00b-8983-33f2-b310-0445b709473c",
                                "text": "„Sie lachte, wenn er seine Sätze verschnörkelte wie südliche Weinranken oder plötzlich übertriebene Härten einflocht, wie Kinder es machen, wenn sie die Arroganz des Vaters oder die Treibhausblüten des mütterlichen Charmes nachahmen.“"
                            },
                            {
                                "example_id": "c4cd515f-f6ba-4b03-8b14-934882a9c7ab",
                                "sense_id": "6664e00b-8983-33f2-b310-0445b709473c",
                                "text": "„Es war eine Renaissance-Truhe mit einer gedrechselten Leiste am unteren Rand und Weinranken in den Ecken; kleine Säulen teilten die Vorderseite in fünf Felder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
