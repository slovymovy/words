                        "glosses": [
                            "iemand die het contact verzorgt tussen twee personen of groepen die elkaar niet fysiek kunnen of mogen treffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0990e4d7-73b6-43cb-b0fb-30ee31eb1d1c",
                                "sense_id": "ecce6881-0d00-3975-96f7-fdf63c5ec9be",
                                "text": "De contactpersoon liet niets meer van zich horen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6633fa26-3316-4b22-b328-1b3850d73efd",
                        "source_entry_id": "604ff05e-e827-3c13-8f13-25bb17584c54",
                        "source_sense_id": "ecce6881-0d00-3975-96f7-fdf63c5ec9be",
                        "target_lang_word": "Kontaktperson",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kontaktperson",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd0df996-7bfd-3d08-9233-b24cdcf5f572",
                                        "entry_id": "f9466c65-9579-3729-8d8c-b0aa75072285",
                                        "glosses": [
                                            "Mensch, der mit einem Infizierten Kontakt hatte, sich (ungeschützt) in dessen Nähe aufgehalten hat"
                                        ],
                                        "tags": [
                                            "Epidemiologie",
                                            "Infektiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb069185-a97a-4736-b90e-e2d2b7fcf81c",
                                                "sense_id": "cd0df996-7bfd-3d08-9233-b24cdcf5f572",
                                                "text": "Eine Kontaktperson der Kategorie I hat ein höheres Infektionsrisiko, weil sie zum Beispiel länger als eine Viertelstunde mit einem Infizierten in einem Raum war."
                                            },
                                            {
                                                "example_id": "8ca61e0c-ce97-4d05-b9e6-e44389cd8970",
                                                "sense_id": "cd0df996-7bfd-3d08-9233-b24cdcf5f572",
                                                "text": "„Bisher hatte Ari schlicht darauf vertraut, dass Bjarkis Version stimmte, und es war auch nicht üblich, von allen Kontaktpersonen Alibis einzufordern, wenn davon auszugehen war, dass jemand Selbstmord begangen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "186c0700-2624-3e86-9e6c-d3f28f7fa92b",
                                        "entry_id": "f9466c65-9579-3729-8d8c-b0aa75072285",
                                        "glosses": [
                                            "Ansprechpartner für ein bestimmtes Thema, zum Beispiel ein Sachbearbeiter einer Behörde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e9b0feb-f536-4a42-8082-0c55c1e7d2d1",
                                                "sense_id": "186c0700-2624-3e86-9e6c-d3f28f7fa92b",
                                                "text": "Haben Sie schon eine Kontaktperson in der Gruppe? Ich kann Ihnen gerne die Telefonnummer von meinem Ansprechpartner geben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f0965aeb-7242-3459-8966-4e665c97c3f3",
                                        "entry_id": "f9466c65-9579-3729-8d8c-b0aa75072285",
                                        "glosses": [
                                            "Mensch, der Zugang zu wichtigen Informationen hat"
                                        ],
                                        "tags": [
                                            "Spionage",
                                            "Aufklärung",
                                            "DDR"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eca08095-02d9-483f-ad04-b18f2792d229",
                                                "sense_id": "f0965aeb-7242-3459-8966-4e665c97c3f3",
                                                "text": "Eine Quelle der Spionageerkenntnisse konnte durchaus auch eine Kontaktperson sein, die selbst gar nicht wusste, wozu sie beitrug."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "902d5011-bb71-4c3b-aaa5-dc7a8164c0fc",
                        "source_entry_id": "604ff05e-e827-3c13-8f13-25bb17584c54",
                        "source_sense_id": "ecce6881-0d00-3975-96f7-fdf63c5ec9be",
