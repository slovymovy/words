                        "entry_id": "3e624e98-8e50-3f6b-80ee-fcb5b6473249",
                        "glosses": [
                            "opakowanie zbiorcze jakiegoś produktu oklejone w folię"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9d060400-a3bd-4847-9cd1-62cdb3c15ab4",
                                "sense_id": "b6b0f64a-5959-3520-83e2-2b30516fd109",
                                "text": "Weźmiemy dwie zgrzewki piwa i orzeszki."
                            },
                            {
                                "example_id": "b24ef302-514a-42a3-be81-4637dd66f9c5",
                                "sense_id": "b6b0f64a-5959-3520-83e2-2b30516fd109",
                                "text": "Majonezy pakujemy w zgrzewkach po osiem sztuk."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
