        "fr-extract.jsonl": [
            {
                "entry_id": "042b0c27-42e6-3dda-b568-8ed0672c173d",
                "word": "démesure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a68db59c-f248-4ca0-a25f-8bb68ea3181a",
                        "entry_id": "042b0c27-42e6-3dda-b568-8ed0672c173d",
                        "tags": [
                            "plural"
                        ],
                        "form": "démesures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc307af4-8fa2-34af-989c-80be20fe3d45",
                        "entry_id": "042b0c27-42e6-3dda-b568-8ed0672c173d",
                        "glosses": [
                            "Perte du sens de la mesure, exagération excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dd761ee-10a7-4d5c-9788-469f6c13949d",
                                "sense_id": "cc307af4-8fa2-34af-989c-80be20fe3d45",
                                "text": "Comme jadis la noblesse, la plèbe aujourd’hui prenait dans le succès le goût de la démesure."
                            },
                            {
                                "example_id": "2e5755ad-922e-4af0-8d72-1224c6fe4980",
                                "sense_id": "cc307af4-8fa2-34af-989c-80be20fe3d45",
                                "text": "S’il fallait en définitive reconnaître la grandeur de l’humanité européenne, c’est qu’elle pouvait à tout moment compenser la démesure de ses actions par la mesure de ses critiques."
                            },
                            {
                                "example_id": "0359f8c2-9482-46cc-99c6-ebe2093aa594",
                                "sense_id": "cc307af4-8fa2-34af-989c-80be20fe3d45",
                                "text": "Car ce n'est pas le triomphe planétaire du libéralisme qui se profile désormais à l'horizon, mais l'extinction pure et simple du « denier homme », emporté par sa propre démesure."
                            }
                        ]
                    },
                    {
                        "sense_id": "f454b146-f812-38ef-9f96-06f4bf56a965",
                        "entry_id": "042b0c27-42e6-3dda-b568-8ed0672c173d",
                        "glosses": [
                            "Folie, hybris, orgueil qui s’empare d’un héros de fiction."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8dc3729c-e48a-3435-8254-f8bdd35f03cf",
                        "entry_id": "042b0c27-42e6-3dda-b568-8ed0672c173d",
                        "glosses": [
                            "Dimension excédant la mesure ordinaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48b46a94-094b-45a9-9acc-963361559b0c",
                                "sense_id": "8dc3729c-e48a-3435-8254-f8bdd35f03cf",
                                "text": "Le champ était très vaste mais sans démesure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54a4a800-803c-41d2-acab-e179c0c3cb97",
                        "source_entry_id": "042b0c27-42e6-3dda-b568-8ed0672c173d",
                        "target_lang_word": "Übermaß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Übermaß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "440a75ad-89f0-39e9-9b43-15bd8a0f88d2",
                                        "entry_id": "4a51715f-8d42-3d7b-8c97-49d6f838fed3",
                                        "glosses": [
                                            "ein Umfang, eine Menge, Größe, die unangemessen übersteigert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f878b098-c78f-4201-aa81-50bfe08c4345",
                                                "sense_id": "440a75ad-89f0-39e9-9b43-15bd8a0f88d2",
                                                "text": "Hier liegt eindeutig ein Übermaß an Bürokratie vor."
                                            },
                                            {
                                                "example_id": "d2548fb6-cd97-490b-a481-d3cceae44009",
                                                "sense_id": "440a75ad-89f0-39e9-9b43-15bd8a0f88d2",
                                                "text": "„Den Abschluss bildete der abendliche Ball mit Feuerwerk und hurrapatriotischen Reden im Übermaß.“"
                                            },
                                            {
                                                "example_id": "0b3e4465-e099-409d-9dcc-c7efa5fee3aa",
                                                "sense_id": "440a75ad-89f0-39e9-9b43-15bd8a0f88d2",
                                                "text": "„Aufgrund eines Übermaßes an Heißwasser und Energie leisten sich die Isländer in nahezu jedem noch so kleinen Kaff ein Schwimmbad (Sundlaugar).“"
                                            },
                                            {
                                                "example_id": "157dc75f-1bab-454f-9ede-47ce48b7fc64",
                                                "sense_id": "440a75ad-89f0-39e9-9b43-15bd8a0f88d2",
                                                "text": "„Und wie Remarque bekämpft er seine Ängste und künstlerischen Selbstzweifel durch ein Übermaß an Alkohol.“"
                                            },
                                            {
                                                "example_id": "d5785dd8-357a-4f62-8d67-eaa0d0f92a62",
                                                "sense_id": "440a75ad-89f0-39e9-9b43-15bd8a0f88d2",
                                                "text": "„Das Übermaß an Abortdünger schadete den Erdbeerpflanzen, und die Tomaten litten unter dem Mangel an Beschneidung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7debf9f3-9fb9-4315-a213-f7b8c458ad1b",
                        "source_entry_id": "042b0c27-42e6-3dda-b568-8ed0672c173d",
                        "target_lang_word": "outrageousness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outrageousness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0e6657e-3121-37b6-b995-7fca42833282",
                                        "entry_id": "5efe36ce-6692-36d8-b2bb-3bb2497da798",
                                        "glosses": [
                                            "The quality of being outrageous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2da4077-0ef2-49f6-8d6f-aa7dc529f2f2",
                                                "sense_id": "c0e6657e-3121-37b6-b995-7fca42833282",
                                                "text": "The first time Tuvy confided his dream to his mates […] they’d howled with cruel laughter at the outrageousness of it, the silliness of it, the impossibility of it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
