                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "069069c2-936d-3d04-9e6e-ff7c242ba58f",
                        "entry_id": "32451e1e-3b09-39f8-adad-494519160f3a",
                        "glosses": [
                            "z rosyjskiego: radziecki weteran wojny w Afganistanie"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "248d3f91-dc05-4e5c-8d5a-764a100daacd",
                                "sense_id": "069069c2-936d-3d04-9e6e-ff7c242ba58f",
                                "text": "Rosjanie szanują swoich afgańców, jak potocznie nazywają weteranów tamtej wojny"
                            },
                            {
                                "example_id": "82e233f3-4507-4381-9d37-f6297fd47e29",
                                "sense_id": "069069c2-936d-3d04-9e6e-ff7c242ba58f",
                                "text": "Kapitan Armii Czerwonej, Witalij Kaganowicz, dwukrotny kawaler Orderu Bohatera Związku Radzieckiego, stary „afganiec”, weteran kilku pomniejszych konfliktów, nie odrywając wzroku od peryskopu obserwacyjnego, rzucił leniwie do interkomu: „Wpieriod”"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "730e9804-6bc7-4d88-b5ea-873393a798d0",
                        "source_entry_id": "32451e1e-3b09-39f8-adad-494519160f3a",
                        "source_sense_id": "7fdfb94a-1654-3fed-ad56-919aa642898c",
                        "target_lang_word": "афганец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
