                ],
                "senses": [
                    {
                        "sense_id": "958e2c60-ab1b-3d51-a08e-fdd24e9391ba",
                        "entry_id": "1d459196-a38e-312f-8894-d4f5e0b086b2",
                        "glosses": [
                            "Freisetzung von Lachgas (chemisch: Distickstoffmonoxid, N₂O) in die Atmosphäre"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "04e35a08-25e4-48b2-bc92-c8f9f22e8be2",
                                "sense_id": "958e2c60-ab1b-3d51-a08e-fdd24e9391ba",
                                "text": "Lachgasemissionen tragen etwa 6 % zur anthropogenen Erderwärmung bei."
                            },
                            {
                                "example_id": "00f4bf73-8294-40da-8b30-d62482bcf4c3",
                                "sense_id": "958e2c60-ab1b-3d51-a08e-fdd24e9391ba",
                                "text": "„Die Landwirtschaft trägt insbesondere zu den Methan- und Lachgasemissionen Deutschlands bei.“"
                            },
                            {
                                "example_id": "bcd103b4-288a-42ff-82bc-e8dc38974b50",
                                "sense_id": "958e2c60-ab1b-3d51-a08e-fdd24e9391ba",
                                "text": "„Die Landwirtschaft war in den 2010er Jahren für 74 Prozent der vom Menschen verursachten Lachgasemissionen verantwortlich, hauptsächlich durch den Einsatz von Kunstdünger und Tierdung auf Ackerland, […].“"
                            },
                            {
                                "example_id": "ba56deb2-7c10-4a63-8f64-503dbeeaad0e",
                                "sense_id": "958e2c60-ab1b-3d51-a08e-fdd24e9391ba",
                                "text": "Intensive Tierhaltung und stickstoffreiche Düngung führen zu hohen Lachgasemissionen."
                            },
                            {
                                "example_id": "7d6b0410-4205-4a34-9765-c96de1a7df67",
                                "sense_id": "958e2c60-ab1b-3d51-a08e-fdd24e9391ba",
                                "text": "„Der direkte Zusammenhang von Lachgasemission aus dem Boden und der verwendeten Düngemenge ist sehr komplex und hängt von vielen weiteren Parametern ab. “"
                            },
                            {
                                "example_id": "63273716-ba63-45b0-b66b-11e0422784ef",
                                "sense_id": "958e2c60-ab1b-3d51-a08e-fdd24e9391ba",
                                "text": "„Dennoch trägt die Landwirtschaft weiterhin erheblich zu den Emissionen von Lachgas bei. Dabei ist zwischen direkten und indirekten Lachgasemissionen zu unterscheiden.“"
                            },
                            {
                                "example_id": "2bccd58e-93e0-4576-9afe-df3ab8ea20f3",
                                "sense_id": "958e2c60-ab1b-3d51-a08e-fdd24e9391ba",
                                "text": "„Eine 2019 veröffentlichte Studie zeigt eine Abnahme der Lachgasemissionen in der ökologischen Landwirtschaft um 40,2 Prozent gegenüber der konventionellen Landwirtschaft.“"
                            },
                            {
                                "example_id": "94150c81-a421-4830-8083-511630e6372a",
                                "sense_id": "958e2c60-ab1b-3d51-a08e-fdd24e9391ba",
                                "text": "„Die Höhe der Lachgasemissionen aus der Stickstoffdüngung hängt neben der Stickstoffumsetzung im Boden auch von der gedüngten Stickstoffmenge und dem Zeitpunkt und derArt der Düngerausbringung ab […].“"
                            },
                            {
                                "example_id": "05dd7a2c-5b19-49a6-99c1-93b9b3369405",
                                "sense_id": "958e2c60-ab1b-3d51-a08e-fdd24e9391ba",
                                "text": "„Der Wärmenutzungsgrad und die Höhe der mit dem Anbau von Silomais einhergehenden Lachgasemissionen weisen eine hohe Sensitivität in der Wirkungskategorie Treibhauseffekt auf.“"
                            },
                            {
                                "example_id": "19219790-a323-409c-bd9a-d142ede848eb",
                                "sense_id": "958e2c60-ab1b-3d51-a08e-fdd24e9391ba",
                                "text": "„Bei einer Zunahme der Lachgasemissionen um 100% nimmt das spezifische Treibhausgaspotential um 200 % zu.“"
                            },
                            {
                                "example_id": "6271469f-94e7-4acc-a1bb-73bdebf4541e",
                                "sense_id": "958e2c60-ab1b-3d51-a08e-fdd24e9391ba",
                                "text": "„Wiedervernässte Moore nehmen nach einiger Zeit wieder ihre Funktion als Kohlenstoffsenke auf. Es dauert einige Jahre bis Jahrzehnte, bis sich die Vegetation auf den neuen Wasserstand eingestellt hat. Die Lachgasemissionen sinken dagegen sofort. Böden mit einem Wasserstand von 20 cm unter der Oberfläche emittieren kein Lachgas mehr.“"
                            },
                            {
                                "example_id": "5f354c0f-1fe9-444a-a446-5ed41236fc68",
                                "sense_id": "958e2c60-ab1b-3d51-a08e-fdd24e9391ba",
                                "text": "[Kläranlagen:] „Konkret sollen die Bakterien in den Kläranlagen eine «möglichst weitreichende» Stickstoffelimination gewährleisten. «Manche Anlagen müssen daher künftig grösser gebaut werden.» Mit einem solchen Ausbau liessen sich die heutigen Lachgasemissionen etwa halbieren, schätzen die Experten.“"
                            },
                            {
                                "example_id": "af4cbef9-d744-4a6e-a0eb-4c2d25cfb727",
                                "sense_id": "958e2c60-ab1b-3d51-a08e-fdd24e9391ba",
                                "text": "„Spitzwegerich produziert biologische Nitrifikationsinhibitoren – Stoffe, welche die Umwandlung von Ammoniumstickstoff in Nitrat verlangsamen. Dadurch bleibt der Stickstoff länger pflanzenverfügbar und das Risiko der Auswaschung und Lachgasemissionen wird minimiert.“"
                            },
                            {
                                "example_id": "a5ad7865-0333-42ec-a114-2734742d2175",
                                "sense_id": "958e2c60-ab1b-3d51-a08e-fdd24e9391ba",
                                "text": "„Pflanzenkohle aber verbessert die Bodenqualität und verringert Lachgasemissionen.“"
                            },
                            {
                                "example_id": "c3cbfa90-1304-4e64-8f7b-c36b7ba64587",
                                "sense_id": "958e2c60-ab1b-3d51-a08e-fdd24e9391ba",
                                "text": "„Die Autorinnen und Autoren der Studie betonen, dass es zur Einhaltung der Klimaziele nötig sei, auch die Lachgasemissionen zu verringern.“"
                            },
                            {
                                "example_id": "c864d41e-8b7c-484b-9ab0-8d754f6d66ef",
                                "sense_id": "958e2c60-ab1b-3d51-a08e-fdd24e9391ba",
                                "text": "Wenn man die Lachgasemissionen senken will, muss man Kunstdünger besteuern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
