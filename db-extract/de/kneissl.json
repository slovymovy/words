                ],
                "senses": [
                    {
                        "sense_id": "b63f0d21-8057-38c2-8efa-a714c4301ae4",
                        "entry_id": "4ca0ba69-51fa-3ecd-8c61-92fc7c419744",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7686b11-67a1-4412-924b-d240d185709a",
                                "sense_id": "b63f0d21-8057-38c2-8efa-a714c4301ae4",
                                "text": "Frau Kneissl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2158236c-ebfe-4361-aaa3-4c6dc1691a2d",
                                "sense_id": "b63f0d21-8057-38c2-8efa-a714c4301ae4",
                                "text": "Herr Kneissl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9bb452f5-7346-4342-9928-848e08623ed6",
                                "sense_id": "b63f0d21-8057-38c2-8efa-a714c4301ae4",
                                "text": "Die Kneissls fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9e1962b2-77c5-49a4-9442-da86734e0c51",
                                "sense_id": "b63f0d21-8057-38c2-8efa-a714c4301ae4",
                                "text": "Der Kneissl trägt nie die Schals, die die Kneissl ihm strickt."
                            },
                            {
                                "example_id": "d8ab69d5-5de2-4b32-bc14-6168e254da06",
                                "sense_id": "b63f0d21-8057-38c2-8efa-a714c4301ae4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kneissl kommt, geht der Herr Kneissl.“"
                            },
                            {
                                "example_id": "7088ab76-3c48-4920-ace8-a539d998a7ce",
                                "sense_id": "b63f0d21-8057-38c2-8efa-a714c4301ae4",
                                "text": "Kneissl kommt und geht."
                            },
                            {
                                "example_id": "9684e379-e811-4a24-b83a-e900abb1aed7",
                                "sense_id": "b63f0d21-8057-38c2-8efa-a714c4301ae4",
                                "text": "Kneissls kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
