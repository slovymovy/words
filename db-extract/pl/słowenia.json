                                        "glosses": [
                                            "een land in Centraal-Europa, met grenzen met Italië, Oostenrijk, Hongarije en Kroatië"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3408377-e3fe-4728-bcc9-f9d0c8c3a50f",
                                                "sense_id": "35cc482c-6a15-387d-9c0e-9a1f81db4fb0",
                                                "text": "Het inwonertal van Slovenië is redelijk hoog."
                                            },
                                            {
                                                "example_id": "93946da6-5e81-4b5c-aaca-cfd52bf09c95",
                                                "sense_id": "35cc482c-6a15-387d-9c0e-9a1f81db4fb0",
                                                "text": "Toen de deuren van de basiliek van de stad vanochtend om zes uur opengingen, hadden zich al enige duizenden mensen verzameld. Verwacht wordt dat rond de honderdduizend mensen de kerk zullen aandoen. De organisatoren verwachten zelfs bussen uit Slovenië, Polen en Libanon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
