        "fr-extract.jsonl": [
            {
                "entry_id": "2d924ab5-1baa-3f3b-9d8f-4c4417cc09c7",
                "word": "futile",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7d9c610f-ab8b-4a74-8327-d440e31e2a51",
                        "entry_id": "2d924ab5-1baa-3f3b-9d8f-4c4417cc09c7",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "futiles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "73cb265f-9856-30e7-a7f9-186b84048ef8",
                        "entry_id": "2d924ab5-1baa-3f3b-9d8f-4c4417cc09c7",
                        "glosses": [
                            "Qui est frivole, qui est de peu de conséquence, de peu de considération."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3c026a6-8977-493f-873a-9fee0385c772",
                                "sense_id": "73cb265f-9856-30e7-a7f9-186b84048ef8",
                                "text": "Heureuse enfant, murmura le général, qu’une cause aussi futile a encore le pouvoir de chagriner."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e4ea20a-db65-3e50-815c-d320bb3ad125",
                        "entry_id": "2d924ab5-1baa-3f3b-9d8f-4c4417cc09c7",
                        "glosses": [
                            "Qui s’attache à des choses de peu de conséquence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c924f1e8-6c16-4ea2-a8a4-d3afecfe45a3",
                                "sense_id": "0e4ea20a-db65-3e50-815c-d320bb3ad125",
                                "text": "Ce qui rend les femmes particulièrement aptes à soigner, à élever notre première enfance, c’est qu’elles restent elles-mêmes puériles, futiles et bornées ; elles demeurent toute leur vie de grands enfants, une sorte d’intermédiaire entre l’enfant et l’homme."
                            },
                            {
                                "example_id": "ede7118f-e8f6-4590-a889-06f521342f59",
                                "sense_id": "0e4ea20a-db65-3e50-815c-d320bb3ad125",
                                "text": "Le duc d’Orléans était leur garant, leur pavillon, leur espoir. Ils le savaient futile, versatile, influençable, capable de se jeter à l’étourdie dans les entreprises les plus folles, docile à toutes les flagorneries, aussi dépourvu de sens critique que de sens pratique, joueur, débauché, dépensier, […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93c8e0b4-83b5-4e35-a470-52934d595bc9",
                        "source_entry_id": "2d924ab5-1baa-3f3b-9d8f-4c4417cc09c7",
                        "target_lang_word": "futile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "futile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6c5c399-bbbc-3cf7-ab7f-4f5f9108840f",
                                        "entry_id": "c923592c-ea5c-3c25-972b-bf9ffca9cd16",
                                        "glosses": [
                                            "Incapable of producing results, useless; doomed not to be successful; not worth attempting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e136057f-e8dc-444f-8705-7867190c48c1",
                                                "sense_id": "a6c5c399-bbbc-3cf7-ab7f-4f5f9108840f",
                                                "text": "But Bathsheba, though she could feel, was not much given to futile dreaming, and her musings under this head were short and entirely confined to the times when Troy’s neglect was more than ordinarily evident."
                                            },
                                            {
                                                "example_id": "da8a7e69-b535-42c1-8fe9-12fe45a251cf",
                                                "sense_id": "a6c5c399-bbbc-3cf7-ab7f-4f5f9108840f",
                                                "text": "He seemed hitherto to have been living by proxy, in a vision, in reflection—to have been an echo, a shadow, a futile attempt;[…]"
                                            },
                                            {
                                                "example_id": "67188d14-38d6-42bf-95f4-4d25d76649fc",
                                                "sense_id": "a6c5c399-bbbc-3cf7-ab7f-4f5f9108840f",
                                                "text": "No matter how early I came down, I would find him on the veranda, smoking cigarettes, or[…]. And at last I began to realize in my harassed soul that all elusion was futile, and to take such holidays as I could get, when he was off with a girl, in a spirit of thankfulness."
                                            },
                                            {
                                                "example_id": "e1667afd-4f91-4511-be00-3f4f1a5be754",
                                                "sense_id": "a6c5c399-bbbc-3cf7-ab7f-4f5f9108840f",
                                                "text": "There is an hour or two, after the passengers have embarked, which is disquieting and fussy.[…]Stewards, carrying cabin trunks, swarm in the corridors. Passengers wander restlessly about or hurry, with futile energy, from place to place."
                                            },
                                            {
                                                "example_id": "ba5ee4ce-fcdc-4b4c-b857-97e19292051c",
                                                "sense_id": "a6c5c399-bbbc-3cf7-ab7f-4f5f9108840f",
                                                "text": "He wished he had not been saddled with Whippham's rather futile son as his chaplain."
                                            },
                                            {
                                                "example_id": "2f314660-fbd5-4127-af5c-31f1e432ceb1",
                                                "sense_id": "a6c5c399-bbbc-3cf7-ab7f-4f5f9108840f",
                                                "text": "Goals from Steven Pienaar, Andros Townsend, Jermain Defoe and Harry Kane sealed the win, but Rubin Kazan's 1-1 draw against PAOK Salonika rendered Spurs' efforts futile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a0728a3-2f94-302a-babb-77cbc376a9b2",
                                        "entry_id": "c923592c-ea5c-3c25-972b-bf9ffca9cd16",
                                        "glosses": [
                                            "Insignificant; frivolous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a58a63b-5c61-4d8a-891f-5c1a63c9fd0e",
                                                "sense_id": "2a0728a3-2f94-302a-babb-77cbc376a9b2",
                                                "text": "Of its history little is recorded, and that little futile."
                                            },
                                            {
                                                "example_id": "70bbb8f5-8169-45d2-9735-3b1235cd4fa0",
                                                "sense_id": "2a0728a3-2f94-302a-babb-77cbc376a9b2",
                                                "text": "This idiosyncrasy is brought out by social pressure, while in a state of nature it might have betrayed itself only in trivial and futile ways, as it does among barbarians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87e9540b-525b-45ee-9e12-f99b43097cb8",
                        "source_entry_id": "2d924ab5-1baa-3f3b-9d8f-4c4417cc09c7",
