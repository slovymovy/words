        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b8412ce1-483f-3266-b731-0a78394ba511",
                    "sense_definition": "To remove the internal organs of an animal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "eviscerate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter <w>garbaged</w> the catch before bringing it home.",
                            "target_lang_translations": {
                                "ru": "Охотник <w>выпотрошил</w> добычу, прежде чем нести её домой.",
                                "tr": "Avcı, avını eve getirmeden önce <w>içini temizledi</w>."
                            }
                        },
                        {
                            "text": "They <w>garbaged</w> the fish near the riverbank.",
                            "target_lang_translations": {
                                "ru": "Они <w>выпотрошили</w> рыбу у берега реки.",
                                "tr": "Nehir kıyısının yakınında balığın <w>içini çıkardılar</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "disembowel",
                        "eviscerate",
                        "gut"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять внутренние органы у животного.",
                        "tr": "Bir hayvanın iç organlarını çıkarmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потрошить",
                                "target_lang_sense_clarification": "удалять внутренности"
