                        "cross_references": [
                            {
                                "target_word": "verstoren",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "72cb75f3-05fa-3cf8-9d0b-4cee1df5ee40",
                                        "entry_id": "e4c9904e-acba-3d48-99cc-085626929258",
                                        "glosses": [
                                            "uit de concentratie brengen, onderbreken wat men aan het doen is"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14a46267-68e0-4ee1-8b4f-fcd8dbadd206",
                                                "sense_id": "72cb75f3-05fa-3cf8-9d0b-4cee1df5ee40",
                                                "text": "Tijdens het examen werden de kandidaten verstoord doordat er een brandalarm afging."
                                            },
                                            {
                                                "example_id": "899280d5-1cb8-42c9-baeb-62b579cda8a9",
                                                "sense_id": "72cb75f3-05fa-3cf8-9d0b-4cee1df5ee40",
                                                "text": "Omdat het mij speet dat mijn aankomst zijn rookpauze had verstoord, en omdat het waar was, zei ik hem, terwijl de taxi zich over het grind van ons verwijderde, dat mijn bagage wel even kon wachten, dat ik een lange reis achter de rug had en dat ik ook wel een sigaret zou lusten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e55fa478-d5b7-3df2-8adf-d93bb17a15ab",
                                        "entry_id": "e4c9904e-acba-3d48-99cc-085626929258",
                                        "glosses": [
                                            "de kalmte of rust verbreken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f1b872f-f5bf-4ffe-81e6-3e6a4bfa1fb4",
                                                "sense_id": "e55fa478-d5b7-3df2-8adf-d93bb17a15ab",
                                                "text": "Gooi een steen in een meer. Het effect is niet alleen zichtbaar, maar ook veel langduriger. De steen zal de stille wateren verstoren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
