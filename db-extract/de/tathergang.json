                "senses": [
                    {
                        "sense_id": "54e4e267-b94a-3e2a-a45f-8b029f2016c9",
                        "entry_id": "aa23e296-0619-3e6f-8249-650dbeb4a2d6",
                        "glosses": [
                            "der genaue zeitliche Verlauf einer Straftat oder Ordnungswidrigkeit"
                        ],
                        "tags": [
                            "Kriminalistik"
                        ],
                        "examples": [
                            {
                                "example_id": "49836739-4fd7-4226-bc77-4f9ce21c3f1d",
                                "sense_id": "54e4e267-b94a-3e2a-a45f-8b029f2016c9",
                                "text": "Den genauen Tathergang kennt nur der Täter."
                            },
                            {
                                "example_id": "97f10673-c520-48e2-819d-3b471d49b71b",
                                "sense_id": "54e4e267-b94a-3e2a-a45f-8b029f2016c9",
                                "text": "Die Polizei sucht nach Zeugen, da sie wertvolle Hinweise zum Tathergang geben können."
                            },
                            {
                                "example_id": "875ac69f-3231-4d23-951e-1dc9c793dcb3",
                                "sense_id": "54e4e267-b94a-3e2a-a45f-8b029f2016c9",
                                "text": "Der Tathergang konnte von der Polizei wie folgt rekonstruiert werden: Um 10h stürmten die Bankräuber die Bank."
                            },
                            {
                                "example_id": "214447b3-db58-4df4-a405-e157442888ea",
                                "sense_id": "54e4e267-b94a-3e2a-a45f-8b029f2016c9",
                                "text": "Auch Blutspuren analysiert er, um Rückschlüsse auf den Tathergang zu ziehen."
                            },
                            {
                                "example_id": "8781e04a-bd19-427d-a086-d5f96b2c2333",
                                "sense_id": "54e4e267-b94a-3e2a-a45f-8b029f2016c9",
                                "text": "„Der Tathergang dient dem Nachweis der Täterschaft sowie dem Tatnachweis.“"
                            },
                            {
                                "example_id": "b00d045f-f037-449c-b532-e837434d6319",
                                "sense_id": "54e4e267-b94a-3e2a-a45f-8b029f2016c9",
                                "text": "„Tom hatte Peter den Tathergang minutiös dargestellt und dabei auch Fabian Z. schwer belastet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
