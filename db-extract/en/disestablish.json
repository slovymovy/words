                "senses": [
                    {
                        "sense_id": "797e2712-a96e-3a79-91ee-c4419932ff10",
                        "entry_id": "af43525c-32a0-3972-bf57-9fccd03d1b96",
                        "glosses": [
                            "To deprive (an established church, military squadron, operations base, etc.) of its official status."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd58b7e8-2d72-437f-a5ee-4523c2c00e87",
                                "sense_id": "797e2712-a96e-3a79-91ee-c4419932ff10",
                                "text": "Ah, but the virtue of public education, it is said, is that it is secular and non-denominational. Don't count on it. Massachusetts, the last state to disestablish religion (1832), didn't until July of 1978 decide that it was unconstitutional for the public school system to subsidize religious schools through so-called textbook loans."
                            },
                            {
                                "example_id": "527f605d-cf13-470d-a6a8-3b67238155d2",
                                "sense_id": "797e2712-a96e-3a79-91ee-c4419932ff10",
                                "text": "Furthermore, disestablishing the Catholic church in February 1795 essentially instituted a free field in religious belief."
                            }
                        ]
                    },
