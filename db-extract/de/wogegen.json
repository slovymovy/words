                "senses": [
                    {
                        "sense_id": "9a3880ce-7529-3dcb-af50-571a520106bb",
                        "entry_id": "72ba08b6-3c11-3195-a523-feb5e1bf17a4",
                        "glosses": [
                            "Exprime la contradiction, le contraste → voir während et wohingegen Tandis que, alors que."
