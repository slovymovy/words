                    "sense_id": "3ed16834-8d06-30d9-b9e8-fad87f4fce88",
                    "sense_definition": "simple past and past participle of <w>leash</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fastened_with_a_leash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before walking through the busy market, she <w>leashed</w> her dog securely.",
                            "target_lang_translations": {
                                "ru": "Прежде чем идти через оживлённый рынок, она надёжно <w>взяла</w> свою собаку <w>на поводок</w>."
                            }
                        },
                        {
                            "text": "He <w>leashed</w> the excited puppy to a post outside the bakery.",
                            "target_lang_translations": {
                                "ru": "Он <w>привязал</w> взволнованного щенка <w>на поводок</w> к столбу возле пекарни."
                            }
                        }
                    ],
                    "synonyms": [
                        "tethered",
                        "tied"
                    ],
                    "antonyms": [
                        "unleashed"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "форма прошедшего времени и причастие прошедшего времени от глагола leash (взять на поводок, привязать)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взял на поводок",
                                "target_lang_sense_clarification": "о действии посадки животного на поводок"
                            },
                            {
                                "target_lang_word": "привязал на поводок",
                                "target_lang_sense_clarification": "о фиксации поводком к чему-либо"
                            },
                            {
                                "target_lang_word": "на поводке",
                                "target_lang_sense_clarification": "в значении причастия (посаженный на поводок)"
                            }
                        ]
                    }
                }
            ]
        },
        {
