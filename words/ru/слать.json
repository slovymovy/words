                },
                {
                    "sense_id": "b5f7d8b8-24df-391d-9de0-924f757815f2",
                    "sense_definition": "Направлять, перемещать или запускать в определенном направлении.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "отправка",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Генерал приказал <w>слать</w> войска на север для защиты границы."
                        },
                        {
                            "text": "Враг начал <w>слать</w> снаряды прямо по нашим позициям."
