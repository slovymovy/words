                "senses": [
                    {
                        "sense_id": "24225a7a-fbc2-3f9a-9b58-c700a162fd68",
                        "entry_id": "df912c8d-ac10-3f54-a225-7098523dd298",
                        "glosses": [
                            "offizieller Gruß des nationalsozialistischen Dritten Reiches, bei dem der rechte Arm schräg nach oben ausgestreckt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aa01c96-c5c3-47bb-beaa-1c7c5a24b44f",
                                "sense_id": "24225a7a-fbc2-3f9a-9b58-c700a162fd68",
                                "text": "Der Hitlergruß, im nationalsozialistischen Sprachgebrauch auch als „Deutscher Gruß“ bezeichnet, war zur Zeit des Nationalsozialismus die verpflichtende Grußform."
                            },
                            {
                                "example_id": "f1fcf913-ce11-4eb2-a142-870a287a48f1",
                                "sense_id": "24225a7a-fbc2-3f9a-9b58-c700a162fd68",
                                "text": "Die Ausübung des Hitlergrußes ist heutzutage in Deutschland verboten."
                            },
                            {
                                "example_id": "732036fe-f3f8-4cc2-b951-6f733ebbbf84",
                                "sense_id": "24225a7a-fbc2-3f9a-9b58-c700a162fd68",
                                "text": "„Er hob den rechten Arm bizarr in die Luft und winkelte die Hand ab, eine schräge Patodie des Hitlergrußes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
