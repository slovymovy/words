                                "target_lang_sense_clarification": "поэтическое/устаревшее"
                            },
                            {
                                "target_lang_word": "слушать",
                                "target_lang_sense_clarification": "устаревшее употребление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倾听",
                                "target_lang_sense_clarification": "认真地听"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a01e4247-d469-332c-aca1-1432149e1f9b",
                    "sense_definition": "To wish or desire to do something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "desire_wish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind blows where it <w>lists</w>, and no one can control it.",
                            "target_lang_translations": {
                                "ru": "Ветер дует, где <w>хочет</w>, и никто не может им управлять.",
                                "zh": "风随心所欲地吹，没有人能控制它。"
                            }
                        },
                        {
                            "text": "You may do as you <w>list</w> in your own home.",
                            "target_lang_translations": {
                                "ru": "Вы можете делать так, как <w>желаете</w>, в своем собственном доме.",
                                "zh": "在你自己家里，你可以随心所欲地做你想做的事。"
                            }
                        }
