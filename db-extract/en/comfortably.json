                ],
                "senses": [
                    {
                        "sense_id": "42ce0c0b-e71b-3b7e-bbdb-864565d1df1f",
                        "entry_id": "db714a0e-f954-3ed0-8579-b52ca755b13d",
                        "glosses": [
                            "άνετα, βολικά, ξεκούραστα, χωρίς ταλαιπωρία"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2b5933b-1358-44dd-8b0a-c57e05b6c4f0",
                                "sense_id": "42ce0c0b-e71b-3b7e-bbdb-864565d1df1f",
                                "text": "By airplane, you travel quickly and comfortably.",
                                "translation": "Με το αεροπλάνο ταξιδεύεις γρήγορα και άνετα."
                            },
                            {
                                "example_id": "834e3b58-f3fc-41a9-b5dc-91b1902415ed",
                                "sense_id": "42ce0c0b-e71b-3b7e-bbdb-864565d1df1f",
                                "text": "He sat comfortably on the couch, in a relaxed position.",
                                "translation": "Κάθισε άνετα στον καναπέ, σε ξεκούραστη στάση."
                            },
                            {
                                "example_id": "e0934cad-998c-433a-a784-4924f88702fb",
                                "sense_id": "42ce0c0b-e71b-3b7e-bbdb-864565d1df1f",
                                "text": "I am not sitting comfortably at all.",
                                "translation": "Δεν κάθομαι καθόλου βολικά."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ebade9f-ff2d-3ce5-9681-6aa11dd75881",
                        "entry_id": "db714a0e-f954-3ed0-8579-b52ca755b13d",
                        "glosses": [
                            "άνετα, εύκολα, χωρίς ιδιαίτερο κόπο"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8879f771-97e4-4e1a-ae0d-1069ea7da9ca",
                                "sense_id": "4ebade9f-ff2d-3ce5-9681-6aa11dd75881",
                                "text": "Small cars park comfortably anywhere.",
                                "translation": "Τα μικρά αυτοκίνητα παρκάρουν άνετα οπουδήποτε."
                            },
                            {
                                "example_id": "1d8aef32-d429-4319-adfd-339780a5f88c",
                                "sense_id": "4ebade9f-ff2d-3ce5-9681-6aa11dd75881",
                                "text": "With the means he has, he lives comfortably without working.",
                                "translation": "Με το εισόδημα που έχει, ζει άνετα χωρίς να δουλεύει."
                            },
                            {
                                "example_id": "9cf2a8af-496d-4f31-a7e3-9819a8e10068",
                                "sense_id": "4ebade9f-ff2d-3ce5-9681-6aa11dd75881",
                                "text": "When you internalize the rules of English grammar, you will speak it more comfortably.",
                                "translation": "Όταν εσωτερικεύσεις τους κανόνες της γραμματικής της αγγλικής, θα τη μιλάς πιο άνετα."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
