                "senses": [
                    {
                        "sense_id": "9bfef3de-fafa-38fb-a8c5-49c6d8c28099",
                        "entry_id": "b8a053b2-11fd-36ba-b7a8-b2f59ef01d11",
                        "glosses": [
                            "wichtigstes Ziel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53356e0e-f360-4f98-9b80-ddc19dd58a84",
                                "sense_id": "9bfef3de-fafa-38fb-a8c5-49c6d8c28099",
                                "text": "„Ich entschied mich für Freiburg im Breisgau, das Hauptziel der im Ersten Weltkrieg noch recht seltenen und ineffizienten Luftangriffe.“"
                            },
                            {
                                "example_id": "e2c420c0-3839-461c-b03f-c02ddb6bf8c7",
                                "sense_id": "9bfef3de-fafa-38fb-a8c5-49c6d8c28099",
                                "text": "„Das Hauptziel des Lehrens ist nicht, Bedeutungen zu erklären, sondern an die Tür des Geistes zu klopfen.“"
                            },
                            {
                                "example_id": "c154ffe2-d731-4852-a983-ae2c62b647d4",
                                "sense_id": "9bfef3de-fafa-38fb-a8c5-49c6d8c28099",
                                "text": "„Das war, neben seinen Geschäften mit den Indianern, denen er Feuerwaffen verkaufte, sein Hauptziel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
