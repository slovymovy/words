{
    "word_family": [
        "luggage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0a832e8e-6d22-3c1e-a4d9-007776939980",
                    "sense_definition": "To haul or drag something heavy or to carry it with effort.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hauling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Why do you always <w>lug</w> around so many heavy books?",
                            "target_lang_translations": {
                                "cs": "Proč s sebou pořád <w>vláčíš</w> tolik těžkých knih?"
                            }
                        },
                        {
                            "text": "We had to <w>lug</w> our suitcases up three flights of stairs.",
                            "target_lang_translations": {
                                "cs": "Museli jsme <w>vléct</w> kufry tři patra po schodech."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lug around"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vléct nebo táhnout něco těžkého, nebo to s námahou přenášet."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vléct",
                                "target_lang_sense_clarification": "táhnout něco těžkého za sebou nebo s námahou"
                            },
                            {
                                "target_lang_word": "tahat",
                                "target_lang_sense_clarification": "přenášet nebo posouvat něco těžkého"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36bd2850-182d-3ade-beda-7533d3919f52",
                    "sense_definition": "To operate an engine at a speed that is too low for the current gear.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When driving up a steep hill, choose a lower gear so you do not <w>lug</w> the engine.",
                            "target_lang_translations": {
                                "cs": "Při jízdě do prudkého kopce zařaďte nižší rychlostní stupeň, abyste motor <w>nedusili</w>."
                            }
                        },
                        {
                            "text": "The car began to <w>lug</w> because the driver did not shift down in time.",
                            "target_lang_translations": {
                                "cs": "Auto začalo <w>cukat</w>, protože řidič včas nepodřadil."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Provozovat motor při příliš nízkých otáčkách vzhledem k zařazenému rychlostnímu stupni."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dusit motor",
                                "target_lang_sense_clarification": "jízda na příliš vysoký rychlostní stupeň při nízkých otáčkách"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7bc47736-c981-3235-9ad3-03f9a0daaa10",
                    "sense_definition": "A part of an object that sticks out and serves as a handle or support.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy metal lid has a small <w>lug</w> on the side for easier lifting.",
                            "target_lang_translations": {
                                "cs": "Těžké kovové víko má na straně malý <w>úchyt</w> pro snazší zvedání."
                            }
                        },
                        {
                            "text": "Make sure the <w>lug</w> is securely attached to the frame before mounting the shelf.",
                            "target_lang_translations": {
                                "cs": "Před montáží police se ujistěte, že je <w>výstupek</w> bezpečně připevněn k rámu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Část předmětu, která vyčnívá a slouží jako úchyt nebo opora."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "výstupek",
                                "target_lang_sense_clarification": "vyčnívající část sloužící k uchopení"
                            },
                            {
                                "target_lang_word": "úchyt",
                                "target_lang_sense_clarification": "část určená k držení nebo připevnění"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a3e4350-026a-34b8-81f6-bbcaed8ec886",
                    "sense_definition": "An ear or earlobe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "body_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a sharp pain in his <w>lug</w> after the cold wind hit him.",
                            "target_lang_translations": {
                                "cs": "Poté, co ho zasáhl studený vítr, ucítil ostrou bolest v <w>uchu</w>."
                            }
                        },
                        {
                            "text": "The old man reached up to scratch his <w>lug</w> while listening to the story.",
                            "target_lang_translations": {
                                "cs": "Starý muž se při poslechu příběhu natáhl, aby se poškrábal na <w>uchu</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Often used in British or Scottish English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Ucho nebo ušní lalůček (často v britské nebo skotské angličtině)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ucho",
                                "target_lang_sense_clarification": "hovorové označení pro ucho"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "455a3ecc-9570-32d0-a99d-5dd43d68d881",
                    "sense_definition": "A large, clumsy, or foolish person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That big <w>lug</w> knocked over the vase while trying to walk through the room.",
                            "target_lang_translations": {
                                "cs": "Ten velký <w>neohrabanec</w> shodil vázu, když se snažil projít místností."
                            }
                        },
                        {
                            "text": "Don't be such a <w>lug</w> and help me move this table properly.",
                            "target_lang_translations": {
                                "cs": "Nebuď takový <w>neohrabanec</w> a pomoz mi ten stůl pořádně přestěhovat."
                            }
                        }
                    ],
                    "synonyms": [
                        "big lug"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal and slightly derogatory."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Velký, neohrabaný nebo hloupý člověk."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "neohrabanec",
                                "target_lang_sense_clarification": "člověk, který se pohybuje neobratně"
                            },
                            {
                                "target_lang_word": "tupoun",
                                "target_lang_sense_clarification": "hanlivé označení pro hloupého člověka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c38ac8b-4f09-3402-ad0d-ba7ca0fb6196",
                    "sense_definition": "A heavy nut used to secure a wheel to a vehicle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need a special wrench to loosen the <w>lug</w> on the car wheel.",
                            "target_lang_translations": {
                                "cs": "Na povolení <w>matice</w> kola potřebuješ speciální klíč."
                            }
                        },
                        {
                            "text": "Check that every <w>lug</w> is tightened correctly before driving on the highway.",
                            "target_lang_translations": {
                                "cs": "Před jízdou na dálnici zkontroluj, zda je každá <w>matice</w> správně dotažená."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Těžká matice používaná k upevnění kola k vozidlu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "matice kola",
                                "target_lang_sense_clarification": "matice zajišťující disk kola na náboji"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c38e4583-6fbf-32c1-8119-42f2bcf0336e",
                    "sense_definition": "An alternative spelling of the name <w>Lugh</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "In Irish mythology, <w>Lug</w> is a prominent deity associated with skill and craftsmanship.",
                            "target_lang_translations": {
                                "cs": "V irské mytologii je <w>Lug</w> významným božstvem spojeným s dovedností a řemeslem."
                            }
                        },
                        {
                            "text": "The festival is dedicated to the ancient god <w>Lug</w>.",
                            "target_lang_translations": {
                                "cs": "Festival je zasvěcen starověkému bohu <w>Lugovi</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical or mythological context."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Alternativní pravopis jména Lugh, keltského božstva."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Lug",
                                "target_lang_sense_clarification": "jméno keltského boha"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}