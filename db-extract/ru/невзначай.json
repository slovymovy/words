                                    {
                                        "sense_id": "c63bcfd1-f2f5-36a9-8884-188d5030a459",
                                        "entry_id": "9bf1118c-654a-341c-8c05-15ee53d0a411",
                                        "glosses": [
                                            "Accidentally; unintentionally; without meaning to; as the result of an event not expected, aided, or willingly planned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f654d342-2a72-425a-923e-85aa318ddee3",
                                                "sense_id": "c63bcfd1-f2f5-36a9-8884-188d5030a459",
                                                "text": "Sorry. I knocked over the vase by accident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79438e5a-6187-383e-9aef-5dfbaf143e68",
                                        "entry_id": "9bf1118c-654a-341c-8c05-15ee53d0a411",
                                        "glosses": [
                                            "As the result of some undesigned, unintended, unrelated, natural, or random occurrence; as the unexpected and unforeseen result of formerly unrelated factors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9044340e-d76e-403e-9ab6-c5066abc12dc",
                                                "sense_id": "79438e5a-6187-383e-9aef-5dfbaf143e68",
                                                "text": "The car got totaled by accident; a giant snowdrift fell off the church roof."
                                            },
                                            {
                                                "example_id": "bb05287d-8655-471c-92c0-d7edc7f45dd8",
                                                "sense_id": "79438e5a-6187-383e-9aef-5dfbaf143e68",
                                                "text": "The only way that project still exists today is by accident; I thought we closed it years ago."
                                            },
                                            {
                                                "example_id": "cebd0362-7c33-4da9-adc8-3450947d4aec",
                                                "sense_id": "79438e5a-6187-383e-9aef-5dfbaf143e68",
                                                "text": "The scholar thinks the quote and the parable were spoken on different occasions and only by accident were brought together here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92265f56-f8a3-328b-bb1f-8e9805ff5788",
                                        "entry_id": "9bf1118c-654a-341c-8c05-15ee53d0a411",
                                        "glosses": [
                                            "By chance; unexpectedly; as the result of an unrelated series of events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aa47827-163d-4fd5-a6b2-2fe90e6f2f51",
                                                "sense_id": "92265f56-f8a3-328b-bb1f-8e9805ff5788",
                                                "text": "I hadn't seen her for years, but I ran into her by accident at the store."
                                            },
                                            {
                                                "example_id": "9079f2a3-7c5f-477f-8e47-7e5e935eda84",
                                                "sense_id": "92265f56-f8a3-328b-bb1f-8e9805ff5788",
                                                "text": "She overheard the information by accident."
                                            },
                                            {
                                                "example_id": "e719d215-78f7-45f7-aeb0-a25544be378d",
                                                "sense_id": "92265f56-f8a3-328b-bb1f-8e9805ff5788",
                                                "text": "Thou cam'st not to thy place by accident: It is the very place God meant for thee."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "by accident",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53634e61-e90c-32f5-a8ea-05a3157db713",
                                        "entry_id": "9c8e2dca-c723-34cc-9f44-e6a18cb23f73",
                                        "glosses": [
                                            "Accidental; as the result of some unforeseen happening or series of events; unexpected; resulting from an event without the foresight, expectation, aid, or design of the person by whose agency it was caused; unintentional."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "786d10c7-77ca-4237-b8ca-be0d4608d3d9",
                                                "sense_id": "53634e61-e90c-32f5-a8ea-05a3157db713",
                                                "text": "The victim's death was by accident."
                                            },
                                            {
                                                "example_id": "fc16ab94-e72b-4077-b512-d6c3152e38fa",
                                                "sense_id": "53634e61-e90c-32f5-a8ea-05a3157db713",
                                                "text": "That the injury was by accident is not questioned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1c1d0c6-47a5-4760-97fe-cd7b58913868",
                        "source_entry_id": "8d93db17-2fab-3219-b5e3-f4aca29c8a23",
                        "source_sense_id": "ed4e0ec6-ce76-38f9-8163-5a7620c36991",
                        "target_lang_word": "zufällig",
