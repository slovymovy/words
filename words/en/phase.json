                },
                {
                    "sense_id": "746d460f-0c39-35e2-948f-af3234c8d7e0",
                    "sense_definition": "The angle of a complex number in polar coordinates, representing its direction from the origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students learned to calculate the magnitude and <w>phase</w> of complex numbers.",
                            "target_lang_translations": {
                                "ru": "Студенты учились вычислять модуль и <w>аргумент</w> комплексных чисел.",
                                "zh": "学生们学习了如何计算复数的模和<w>辐角</w>。"
                            }
                        },
                        {
                            "text": "The <w>phase</w> determines the rotation of the vector on the diagram.",
