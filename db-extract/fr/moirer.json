                "senses": [
                    {
                        "sense_id": "606d2c9d-a838-3b70-9608-5a24a991722e",
                        "entry_id": "44a05eec-e86d-38a9-b021-7a4a4449cc20",
                        "glosses": [
                            "Donner à une étoffe l’apprêt désigné sous le nom de moire."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4be27824-bc1c-315d-956d-cfa5a5a9e08a",
                        "entry_id": "44a05eec-e86d-38a9-b021-7a4a4449cc20",
                        "glosses": [
                            "Donner l’aspect de moire à une étoffe."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c81161f0-41b4-402a-ab6b-a32cfe11a1c9",
                                "sense_id": "4be27824-bc1c-315d-956d-cfa5a5a9e08a",
                                "text": "La suivante rangea sur la table un vase de fleurs et les flambeaux de cire, dont les reflets moiraient de rouge et de jaune les rideaux de soie bleue au chevet du lit de la malade."
                            }
                        ]
                    },
                    {
                        "sense_id": "4af51726-7813-35cc-95d4-eaa8766aa073",
                        "entry_id": "44a05eec-e86d-38a9-b021-7a4a4449cc20",
                        "glosses": [
                            "Donner l’aspect de moire à un objet."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "64fb8fb3-3d83-4546-a601-ab59f61d55c2",
                                "sense_id": "4af51726-7813-35cc-95d4-eaa8766aa073",
                                "text": "[…] et ils pensaient que c'était assez déjà d’y laisser descendre leur image, tout au fond, dans ces lueurs vertes qui moiraient les pierres d’étranges reflets […]"
                            },
                            {
                                "example_id": "ea130cd3-2d67-4d8b-a8d1-788cbee23f2f",
                                "sense_id": "4af51726-7813-35cc-95d4-eaa8766aa073",
                                "text": "Sur le lac tranquille, une barque passa avec un lampion vert qui moirait l’eau noire de reflets onduleux."
                            },
                            {
                                "example_id": "cad67cb4-02a6-405a-9677-65ca05d601c4",
                                "sense_id": "4af51726-7813-35cc-95d4-eaa8766aa073",
                                "text": "Seul, sur la place, le débit de tabac flamboyait, projetant dans la nuit une vaste lueur tango dont les reflets moiraient le ciment des trottoirs […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "8414dd14-78c5-34b1-b894-77a2a82344ca",
                        "entry_id": "44a05eec-e86d-38a9-b021-7a4a4449cc20",
                        "glosses": [
                            "Apporter un attrait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e9c942b-e54f-45c9-acf8-ee9547710fa7",
                                "sense_id": "8414dd14-78c5-34b1-b894-77a2a82344ca",
                                "text": "L'arrivée d'un nouveau pensionnaire, voyageur de commerce, touriste ou autre, est donc considérée comme une bonne fortune: c'est un peu d'air du dehors qui vient doucement moirer le morne et stagnant étang de l'ennui quotidien."
                            }
                        ]
                    }
                ],
