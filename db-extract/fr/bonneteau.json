                    {
                        "translation_id": "1c2a8bfc-78e2-4cd1-a2d3-6434144268e3",
                        "source_entry_id": "efa40809-e469-378c-9750-92bbf44ce27f",
                        "source_sense_id": "db607323-ce07-3779-bb22-d651243c74e2",
