                "senses": [
                    {
                        "sense_id": "97565b85-d4c3-3586-9724-61d894f33423",
                        "entry_id": "ffc5df3c-75b2-37c3-a21e-7b8b39e21cbe",
                        "glosses": [
                            "Heer; militärische Teilstreitkraft zu Lande"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "779c8a12-9eb6-42e9-990d-8ea7999b0422",
                                "sense_id": "97565b85-d4c3-3586-9724-61d894f33423",
                                "text": "„Carl beruhigte sie oft damit, dass Deutschland eine große Militärmacht sei, die eine überlegene Landstreitmacht besitze.“"
                            },
                            {
                                "example_id": "6fa62779-2b6a-4923-bc18-f69ffd2c2c96",
                                "sense_id": "97565b85-d4c3-3586-9724-61d894f33423",
                                "text": "„Seine Flotte segelte die Küste hinauf, und seine Landstreitmacht folgte der Römerstraße nach Norden.“"
                            },
                            {
                                "example_id": "167bcf9d-f5dc-44ec-9721-878b9b652588",
                                "sense_id": "97565b85-d4c3-3586-9724-61d894f33423",
                                "text": "„War die Armee in der Vergangenheit eine Landstreitmacht, in der das Heer dominierte, werden seither die Luftwaffe, vor allem aber die Marine ausgebaut.“"
                            },
                            {
                                "example_id": "2024cf70-ab53-48b3-b8c2-78a29f874db1",
                                "sense_id": "97565b85-d4c3-3586-9724-61d894f33423",
                                "text": "„Das kämpferische Element im Orden wandelte sich binnen kurzer Zeit von einer berittenen Landstreitmacht zu einem maritimen Kampfverband.“"
                            },
                            {
                                "example_id": "5e4fdc67-0777-4d9d-9c48-f2edb0dc75e2",
                                "sense_id": "97565b85-d4c3-3586-9724-61d894f33423",
                                "text": "„Großbritannien hatte keine ausreichende Landstreitmacht und Preußen-Deutschland hätte nichts gegen eine Küstensperre unternehmen können.“"
                            },
                            {
                                "example_id": "7b2fa2a2-921e-412e-9d98-2704d489ab6d",
                                "sense_id": "97565b85-d4c3-3586-9724-61d894f33423",
                                "text": "„Bestimmte Küstengebiete hatten nun nach Vorbild des von den Landstreitmächten bekannten Rossdienstsystems Seeleute zu stellen (rotering).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
