                ],
                "translations": [
                    {
                        "translation_id": "0265599e-0733-4129-aefa-4973e3fc4401",
                        "source_entry_id": "9f086464-3a21-3525-9543-c94c639ff3dd",
                        "source_sense_description": "line — see also hem",
                        "target_lang_word": "ourlet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ourlet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a638907-55b9-38e8-917c-d2bf7374b15a",
                                        "entry_id": "1d6a14ac-f4b2-3f58-9fae-1bdc7a98a2ef",
                                        "glosses": [
                                            "Bord d’une toile ou d’une étoffe replié et cousu, pour empêcher qu’elle ne s’effile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "375a24e0-b2e7-467f-805a-ca929dafc789",
                                                "sense_id": "5a638907-55b9-38e8-917c-d2bf7374b15a",
                                                "text": "Un simple ourlet bordait la collerette de la petite fille brune, tandis que de jolies broderies ornaient celle du cadet, […]."
                                            },
                                            {
                                                "example_id": "11f74209-6683-4fee-b7e5-0b0fbe70f089",
                                                "sense_id": "5a638907-55b9-38e8-917c-d2bf7374b15a",
                                                "text": "On te saluerait très bas, on baiserait l’ourlet de ta robe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "342622ff-6359-300a-a1f8-cae55a665913",
                                        "entry_id": "1d6a14ac-f4b2-3f58-9fae-1bdc7a98a2ef",
                                        "glosses": [
                                            "Rebord de divers objets."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23820086-742e-4239-9438-c4427602eee2",
                                                "sense_id": "342622ff-6359-300a-a1f8-cae55a665913",
                                                "text": "À l’horizon, un ourlet de collines disposées en cercle comme le rebord du bassin."
                                            },
                                            {
                                                "example_id": "4c043301-f838-4932-a106-488dc403ef9e",
                                                "sense_id": "342622ff-6359-300a-a1f8-cae55a665913",
                                                "text": "Ici même, sur ce dernier ourlet du plateau de Lorette, qui commande le plaine de Douai-Liévin et le bassin de Lens […] la lutte fut infernale."
                                            },
                                            {
                                                "example_id": "37e30dfd-b97a-42e2-a5b5-e04cd7dcaa4c",
                                                "sense_id": "342622ff-6359-300a-a1f8-cae55a665913",
                                                "text": "L’ourlet de ses oreilles était pourpre."
                                            },
                                            {
                                                "example_id": "a7aa7325-ef66-4255-ab97-16d78d8d72b3",
                                                "sense_id": "342622ff-6359-300a-a1f8-cae55a665913",
                                                "text": "L’ourlet d’un vase, d’une cuvette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d24be9cc-df2b-3805-8426-eccffbb5e81a",
                                        "entry_id": "1d6a14ac-f4b2-3f58-9fae-1bdc7a98a2ef",
                                        "glosses": [
                                            "Formation végétale composée de plantes herbacées le long d'une haie, d'un bois."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a71a63a1-79fe-440d-8f89-3831fc0a2a38",
                        "source_entry_id": "9f086464-3a21-3525-9543-c94c639ff3dd",
                        "source_sense_description": "line — see also hem",
                        "target_lang_word": "Saum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d6e1f92-0522-39e8-8cf7-bf531258d348",
                                        "entry_id": "9c993b9d-ebed-32b5-a455-982c61f0fc16",
                                        "glosses": [
                                            "Einfassung eines Stoffstücks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bceccb5d-371b-4a08-8262-02022ae6c766",
                                                "sense_id": "6d6e1f92-0522-39e8-8cf7-bf531258d348",
                                                "text": "Zum Schluss versah er das Tischtuch noch mit einem Saum aus Samt."
                                            },
                                            {
                                                "example_id": "b9b00a5a-8725-411c-95ac-0b514c5b35ce",
                                                "sense_id": "6d6e1f92-0522-39e8-8cf7-bf531258d348",
                                                "text": "„Sie trug nichts darunter, und ihre Brustwarzen stießen spitz durch den leichten Stoff und ließen ihn in zwei schmalen, abstehenden Falten bis zum Saum fallen.“"
                                            },
                                            {
                                                "example_id": "49ca5b26-d8f7-4652-849f-fd1e7c532a5f",
                                                "sense_id": "6d6e1f92-0522-39e8-8cf7-bf531258d348",
                                                "text": "„Ich setzte mich neben sie auf die Holzbank und spielte mit den Fingern am Saum meines Hemdes.“"
                                            },
                                            {
                                                "example_id": "e0a2bbd2-2dcf-4931-891e-93be0b38f2b4",
                                                "sense_id": "6d6e1f92-0522-39e8-8cf7-bf531258d348",
                                                "text": "„Sólveig zupfte am Saum ihrer Jacke und fuhr dann fort.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9ab38a0-6dc9-3f91-b5ea-866279f7b145",
                                        "entry_id": "9c993b9d-ebed-32b5-a455-982c61f0fc16",
                                        "glosses": [
                                            "Rand eines Geländes oder einer Wasserfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b6e914d-a00b-489f-a995-e38c3f3bf8b7",
                                                "sense_id": "b9ab38a0-6dc9-3f91-b5ea-866279f7b145",
                                                "text": "Der Saum eines Waldes ist für die Tierwelt besonders wichtig."
                                            },
                                            {
                                                "example_id": "859e57c0-ddde-4f6e-be67-7c285ae13b5e",
                                                "sense_id": "b9ab38a0-6dc9-3f91-b5ea-866279f7b145",
                                                "text": "„Die ungeheure Bergkette um sich herum empfand er wie einen dunkleren Saum am Nachthimmel.“"
                                            },
                                            {
                                                "example_id": "0d61ca3d-42e5-4689-9763-f6c6d430711f",
                                                "sense_id": "b9ab38a0-6dc9-3f91-b5ea-866279f7b145",
                                                "text": "„Die Säume der Wolken glühten golden, und im Osten zog es schwarz herauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
