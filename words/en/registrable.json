{
    "word_family": [
        "register",
        "registration",
        "registrar",
        "registry"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8f3ae891-9bde-3efa-a6e7-5dd608b1758b",
                    "sense_definition": "Able or needing to be registered.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "registration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every mortgage of land evidenced in writing is <w>registrable</w> with the Land Office.",
                            "target_lang_translations": {
                                "zh": "每一份有书面证明的土地抵押合同都可以在土地登记处<w>登记</w>。"
                            }
                        },
                        {
                            "text": "The new <w>registrable</w> property documents must be submitted by the end of the month.",
                            "target_lang_translations": {
                                "zh": "新的<w>可登记</w>房产文件必须在本月底前提交。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unregistrable"
                    ],
                    "common_phrases": [
                        "registrable property",
                        "registrable document"
                    ],
                    "target_lang_definitions": {
                        "zh": "指可以或需要进行登记、注册的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "可登记的",
                                "target_lang_sense_clarification": "指法律文件或财产可以被正式记录在案。"
                            },
                            {
                                "target_lang_word": "应登记的",
                                "target_lang_sense_clarification": "指根据规定必须进行注册的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb1c4556-c34f-3bac-9ba5-27d5724542c4",
                    "sense_definition": "Capable of receiving trademark registration.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "registration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company argued that their unique logo design was <w>registrable</w> as a trademark.",
                            "target_lang_translations": {
                                "zh": "该公司辩称其独特的标志设计是<w>可注册</w>的商标。"
                            }
                        },
                        {
                            "text": "Legal experts debated whether the <w>registrable</w> symbol met all the necessary criteria for protection.",
                            "target_lang_translations": {
                                "zh": "法律专家们争论该<w>可注册</w>符号是否符合所有必要的保护标准。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unregistrable"
                    ],
                    "common_phrases": [
                        "registrable trademark"
                    ],
                    "target_lang_definitions": {
                        "zh": "指符合条件，可以申请商标注册的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "可注册的",
                                "target_lang_sense_clarification": "特指商标或品牌名称符合法律要求，能够获得注册保护。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}