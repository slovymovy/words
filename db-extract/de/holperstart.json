                "senses": [
                    {
                        "sense_id": "bfe99c50-5f62-34aa-a170-f11ae2a5ca74",
                        "entry_id": "92022bd9-3e8e-3550-b3c6-ada15f8130d4",
                        "glosses": [
                            "Beginn von etwas, bei dem nicht alles wie geplant verläuft; nicht problemlos verlaufender Anfang von etwas"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8d526dbb-2454-449b-a61c-e9af5b8a7140",
                                "sense_id": "bfe99c50-5f62-34aa-a170-f11ae2a5ca74",
                                "text": "„Der FC Augsburg ist in der Fußball-Bundesliga nach seinem Holperstart endgültig in Fahrt gekommen und durch den ersten Heimerfolg in die obere Tabellenhälfte geklettert.“"
                            },
                            {
                                "example_id": "16108ca8-3947-417d-b403-f659a392bdb8",
                                "sense_id": "bfe99c50-5f62-34aa-a170-f11ae2a5ca74",
                                "text": "„Anders als die Spieler begründet Trainer Jens Keller den Holperstart mit dem Fehlen zahlreicher Leistungsträger wie Jefferson Farfan, Atsuto Uchida, Sead Kolasinac oder Joel Matip, dessen zusätzlicher Ausfall besonders schwer wog, weil die Abwehr erneut komplett umgebaut werden musste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
