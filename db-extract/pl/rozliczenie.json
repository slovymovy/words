                        "source_sense_id": "af8f68d8-f53b-3eeb-b8cf-f02466c9b599",
                        "target_lang_word": "payoff",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "payoff",
