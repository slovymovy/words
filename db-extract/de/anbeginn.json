                                "target_senses": [
                                    {
                                        "sense_id": "f080a40d-260a-3c22-800b-d704b9b8bf3f",
                                        "entry_id": "b43c3ed1-1b66-3236-8f82-51d6424a96b2",
                                        "glosses": [
                                            "Momento o punto en que algo empieza; comienzo, inicio; primer instante de un ser."
                                        ],
                                        "tags": [],
