                    },
                    {
                        "translation_id": "f78beae0-575d-40e3-8528-2af7c7e5c180",
                        "source_entry_id": "2d9a2fa9-e886-3e26-8fb9-2fdc21222bb3",
                        "source_sense_id": "f57ab9ce-d754-3518-9734-8121548740a8",
                        "source_sense_description": "een metamorf gesteente met verschillend gekleurde banden of aders",
                        "target_lang_word": "Gneis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gneis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5eb68973-fed6-3d1d-aec0-0ba48b91c848",
                                        "entry_id": "f5119929-43ba-300d-b7dd-aeec25dd6c28",
                                        "glosses": [
                                            "unter hohem Druck und bei hoher Temperatur durch Metamorphose entstandenes Gestein mit gebänderter oder gesprenkelter Textur, bestehend aus Feldspaten, Quarz und verschiedenen Glimmerarten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09e195b8-2b27-4289-92ee-005b72ed5875",
                                                "sense_id": "5eb68973-fed6-3d1d-aec0-0ba48b91c848",
                                                "text": "„Die Feldspäte und Glimmer bestimmen die Farbe und Quarz bestimmt die Abriebfestigkeit der Gneise.“"
                                            },
                                            {
                                                "example_id": "3cceaf30-550b-4b08-b211-ae981b39da8f",
                                                "sense_id": "5eb68973-fed6-3d1d-aec0-0ba48b91c848",
                                                "text": "„Es war keine geringe Arbeit, vor dem Aufkleben der Etiketten die Namen der Gesteine festzustellen; die Verschiedenheit der Farben und des Korns ließ sie Tonerde und Mergel, Granit und Gneis, Quarz und Kalkstein verwechseln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ba187f5-9f93-4885-bf58-8fcb0b813571",
                        "source_entry_id": "2d9a2fa9-e886-3e26-8fb9-2fdc21222bb3",
                        "source_sense_id": "f57ab9ce-d754-3518-9734-8121548740a8",
                        "source_sense_description": "een metamorf gesteente met verschillend gekleurde banden of aders",
                        "target_lang_word": "gneiss",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gneiss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "759e0fec-b773-36db-af27-b0d8b8b8b674",
                                        "entry_id": "07f9e8a1-e532-316d-9f29-58d23a536b0c",
                                        "glosses": [
                                            "A common and widely-distributed metamorphic rock having bands or veins, but not schistose."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ef79ad4-6636-47c8-92d9-c78d19c65124",
                                                "sense_id": "759e0fec-b773-36db-af27-b0d8b8b8b674",
                                                "text": "The old towns along the route are as solidly built from the gneiss of the region as you might expect."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "127f4561-3c52-4180-bbe7-4cc8a3fbd2ee",
                        "source_entry_id": "2d9a2fa9-e886-3e26-8fb9-2fdc21222bb3",
                        "source_sense_id": "f57ab9ce-d754-3518-9734-8121548740a8",
                        "source_sense_description": "een metamorf gesteente met verschillend gekleurde banden of aders",
                        "target_lang_word": "gneiss",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gneiss",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f18abacc-7b47-3519-8245-7ad00ba4898b",
                                        "entry_id": "2c92292b-669a-3f87-a57e-e92335fb344f",
                                        "glosses": [
                                            "Roche métamorphique à grain grossier, composée d’une alternance de plages claires (quartz, feldspath) et foncées (mica, amphibole)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a78e6c8-d070-4551-9fa6-9dc4127d1baa",
                                                "sense_id": "f18abacc-7b47-3519-8245-7ad00ba4898b",
                                                "text": "Au centre même du massif du Tanargue, au hameau des Chambons, les gneiss sont verticaux et courent 88° en moyenne. Dans les gorges du Chassezac, entre Chasseradès et Puylaurent, ils sont orientés en moyenne 120° et plongent de 15 à 30° seulement vers le sud-ouest."
                                            },
                                            {
                                                "example_id": "34c1029a-2eeb-476a-bd8a-9420f7d40198",
                                                "sense_id": "f18abacc-7b47-3519-8245-7ad00ba4898b",
                                                "text": "Le massif dioritique de Lesterps, que la route de Bussière-Boffy recoupe transversalement sur 3 kilomètres, est en disposition synclinale : les gneiss plongent sous la diorite aussi bien à l'Ouest, près de Lesterps, que sur la bordure est."
                                            },
                                            {
                                                "example_id": "deea057d-a877-404a-8eb6-a855c712db0a",
                                                "sense_id": "f18abacc-7b47-3519-8245-7ad00ba4898b",
                                                "text": "Les roches de type stratifiées (calcaires, grès…) ou litées (schistes, gneiss) seront beaucoup plus faciles à dérocter que les roches massives (calcaires récifaux, granites, masses basaltiques…), les plans ou joints de stratification donnant presque toujours lieu à certaines hétérogénéités mécaniques."
                                            },
                                            {
                                                "example_id": "46635c64-f99e-4939-8c40-0f8dc3f8953b",
                                                "sense_id": "f18abacc-7b47-3519-8245-7ad00ba4898b",
                                                "text": "La halde est alors plutôt constituée de fragment de la roche encaissante formée par des gneiss."
                                            },
                                            {
                                                "example_id": "613845f9-3f64-43ca-b669-6565242f9866",
                                                "sense_id": "f18abacc-7b47-3519-8245-7ad00ba4898b",
                                                "text": "Ses murs étaient en gneiss ; sa façade, son seuil, l’encadrement externe de ses fenêtres, son entablement et une partie au moins de sa toiture, en marbre ; les montants et le linteau de sa porte, l’encadrement intérieur de ses fenêtres, son plafond et sa charpente, en bois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
