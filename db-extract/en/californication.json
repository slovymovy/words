        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b06896ce-ca75-37a0-9cf0-b566a042de2c",
                "word": "Californication",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cd9a0659-710e-3206-8c40-6c826e37c0e6",
                        "entry_id": "b06896ce-ca75-37a0-9cf0-b566a042de2c",
                        "glosses": [
                            "The adoption of practices and beliefs associated with California, in particular Hollywood and Silicon Valley."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "62a87fcf-a5b6-4b58-b51d-ce643ec6fc08",
                                "sense_id": "cd9a0659-710e-3206-8c40-6c826e37c0e6",
                                "text": "Isaac was pictured as the only male in the state who could satisfy his many succubi, and the Californication took place on his couch in City Hall, in the Temple, in saloons, in his carriage, in his home, oh, just anywhere."
                            },
                            {
                                "example_id": "82da6cba-4a32-4e28-826d-96a3a3d466ea",
                                "sense_id": "cd9a0659-710e-3206-8c40-6c826e37c0e6",
                                "text": "Indeed, if popular culture can be said to be dispersed in a process of global Californication, then no less should intellectual culture be seen as the product of the Routledgification of the world[.]"
                            },
                            {
                                "example_id": "95246ac0-4b05-4c39-bb1b-74f2ccd7751e",
                                "sense_id": "cd9a0659-710e-3206-8c40-6c826e37c0e6",
                                "text": "A teenage bride with a baby inside getting high on information / And buy me a star on the boulevard, it's Californication"
                            },
                            {
                                "example_id": "e057f44f-bbf0-43d7-b217-c71ffae3a344",
                                "sense_id": "cd9a0659-710e-3206-8c40-6c826e37c0e6",
                                "text": "So we should learn from the Americans. What Europe needs is more Californication."
                            }
                        ]
                    },
                    {
                        "sense_id": "92667189-65af-3748-a5f8-a0f66da9dc0d",
                        "entry_id": "b06896ce-ca75-37a0-9cf0-b566a042de2c",
                        "glosses": [
                            "The large-scale development of land; urban sprawl."
                        ],
                        "tags": [
                            "US",
                            "derogatory",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "29a54485-ceec-49c5-9ed8-dc31d2dff81b",
                                "sense_id": "92667189-65af-3748-a5f8-a0f66da9dc0d",
                                "text": "It's also culturally unique, its natives resisting many elements of \"californication\", the \"glintzy\" urban sprawl typified by Los Angeles."
                            },
                            {
                                "example_id": "2dd3557b-28d8-4077-a2ac-5f1724b69a90",
                                "sense_id": "92667189-65af-3748-a5f8-a0f66da9dc0d",
                                "text": "If the intermountain West, from New Mexico to Montana, is today running scared of growth and Californication, the Great Plains is a large slice of the West that does not share that particular fear."
                            },
                            {
                                "example_id": "d726ccc8-cd3e-42a5-944b-1c4b98ff75af",
                                "sense_id": "92667189-65af-3748-a5f8-a0f66da9dc0d",
                                "text": "Thirty years ago, voters in Portland, Ore., adopted strict growth limits to prevent “Californication” of their landscape. Circumscribed by the nation's first “urban growth boundary,” the Portland region made itself an artificial island on the land with the explicit goal of not becoming another L.A."
                            }
                        ]
                    }
