                    ],
                    "common_phrases": [
                        "op instorten staan",
                        "volledig instorten"
                    ],
                    "target_lang_definitions": {
                        "en": "The sudden falling down or caving in of a structure or building"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "collapse",
                                "target_lang_sense_clarification": "of a building or structure"
                            },
                            {
