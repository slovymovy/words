                                "sense_id": "9b1e5e7b-14b8-3028-851a-e7ec9ee89531",
                                "text": "Nie pomogły płacze, dąsy, żale, trzeba było się pakować i jechać w obce strony"
                            },
                            {
                                "example_id": "65919649-8857-4b04-baca-1b7932339cc4",
                                "sense_id": "9b1e5e7b-14b8-3028-851a-e7ec9ee89531",
                                "text": "Wzgardliwy dąs na pięknej twarzy chłopca działał mu na nerwy"
                            }
                        ],
