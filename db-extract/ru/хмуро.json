                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0fc8b4f-fc47-4707-ad46-b05982f5e718",
                                                "sense_id": "24bfc4d7-75f1-3f2c-8110-95fc0f043570",
                                                "text": "Robert turned and dawdled glumly through the peace of evening[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "953c8873-1075-4c3b-8081-a837138fa5bd",
                        "source_entry_id": "913edbc6-b836-3f5c-9a72-3643d8d318cd",
                        "target_lang_word": "sullenly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sullenly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "390b3781-bab3-3340-8321-093ad6a5b5de",
                                        "entry_id": "7c396428-95cc-361b-882d-7a085c1ecddd",
                                        "glosses": [
                                            "In a sullen manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0231fa29-f50c-4bf5-8b7f-ad058f373b69",
                                                "sense_id": "390b3781-bab3-3340-8321-093ad6a5b5de",
                                                "text": "A grim meaning rose in the vacuous eye of Lovel; Isaacs caressed his diamond pin, smiling in a sickly fashion; McNamara's wandering stare fixed and grew unhumanly bright; Ufert openly dropped his hand on his gun-butt and stood sullenly defiant."
                                            },
                                            {
                                                "example_id": "54d5653f-b0b0-4503-8adb-376d4fdd9ba3",
                                                "sense_id": "390b3781-bab3-3340-8321-093ad6a5b5de",
                                                "text": "Sullenly, jocularly, resentfully, or derisively, names and addresses were extorted from the company, and each member given a jerk of the head to get out of this."
                                            },
                                            {
                                                "example_id": "95a32c4c-5067-4f1a-9335-0ffa3511d1bb",
                                                "sense_id": "390b3781-bab3-3340-8321-093ad6a5b5de",
                                                "text": "Sullenly they paid what was asked, sullenly left, Hamzah feigning a kick at the glass showcase filled with loaves and Chinese cakes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
