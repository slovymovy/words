                        "examples": [
                            {
                                "example_id": "32f2f349-e0d1-443b-9059-c4b0b152dc07",
                                "sense_id": "29d25b91-c263-3ebb-a29b-8b6728446a89",
                                "text": "VVhat meane dull ſoules, in this high meaſure / To haberdaſh / In earths baſe vvares, vvhoſe greateſt treaſure / Is droſſe and traſh?"
                            },
                            {
                                "example_id": "9fb57389-5e8d-48ec-bc0e-cf8b9799517b",
                                "sense_id": "29d25b91-c263-3ebb-a29b-8b6728446a89",
                                "text": "“‘No way-stops,’ says I to Solly, ‘except long enough to get you barbered and haberdashed. This is no Texas feet shampetter,’ says I, ‘where you eat chili-concarne-con-huevos and then holler “Whoopee!” across the plaza. We’re now going against the real high life. We’re going to mingle with the set that carries a Spitz, wears spats, and hits the ground in high spots.’"
                            }
                        ]
