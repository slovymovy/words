                "senses": [
                    {
                        "sense_id": "635d777d-02c4-378d-a7b2-ac3906d6d303",
                        "entry_id": "7d7a429f-f68d-3760-92f4-927fa96f6b9d",
                        "glosses": [
                            "een menu in een restaurant speciaal voor kinderen, vaak bestaande uit patat, appelmoes en kroket"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ad11f92-3c24-4a3a-bc8f-5b8f3f5cb008",
                                "sense_id": "635d777d-02c4-378d-a7b2-ac3906d6d303",
                                "text": "Maar nog belangrijker: er is keuze uit maar liefst vijf kindergerechten (kip, pasta, shaslick, kroket, worstje, tussen 6,50 en 9,50) - kinderen blij, succes verzekerd. Wij laten het kindermenu links liggen en bestellen een grand entrée (14,50), een selectie van de voorgerechten, eigenlijk bedoeld voor één, maar groot genoeg voor twee."
                            },
                            {
                                "example_id": "eb5c1e5f-7700-4e0d-8cbc-00f5ea42a269",
                                "sense_id": "635d777d-02c4-378d-a7b2-ac3906d6d303",
                                "text": "Onlangs zag ik in een restaurant bij het kindermenu de ‘jabadabadoekluif’ staan. Vrolijkheid kan zo treurig maken."
                            }
                        ]
                    },
                    {
                        "sense_id": "160db4c3-a916-327b-8911-491de3c26f4a",
                        "entry_id": "7d7a429f-f68d-3760-92f4-927fa96f6b9d",
                        "glosses": [
                            "product speciaal geschikt voor kinderen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9cb8dead-9c78-4c41-949e-e297d5ff0483",
                                "sense_id": "160db4c3-a916-327b-8911-491de3c26f4a",
                                "text": "Ouders van jonge kinderen zullen het herkennen: je weet K3 nog buiten de deur te houden, geeft je kroost een kindermenu van Beatles en Stones om mee te beginnen, maar op een dag klinkt er getetter uit een iPad in de kinderkamer - vanaf de andere kant van de generatiekloof dus. Avicii. Hey Brother. Voor ouders een oorwurm, voor de kinderen het mooist denkbare liedje aller tijden."
                            }
                        ]
                    }
