            {
                "entry_id": "12e577e7-c4c0-3c69-ac9f-a71cf122115d",
                "word": "scarification",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5a4a7839-8516-417b-8e22-8ee0343dc7cf",
                        "entry_id": "12e577e7-c4c0-3c69-ac9f-a71cf122115d",
                        "tags": [
