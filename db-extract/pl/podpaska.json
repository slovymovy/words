                                            {
                                                "example_id": "ddb39111-dc43-4ca0-97a1-968c162ccb32",
                                                "sense_id": "326d8639-916a-335e-8c80-71c08b63715a",
                                                "text": "„Verwenden Sie Binden während stärkerer Blutungen“, sagte die Hebamme nach der Geburt."
                                            },
                                            {
                                                "example_id": "10941284-3941-481c-8dd1-b5ae4789fb60",
                                                "sense_id": "326d8639-916a-335e-8c80-71c08b63715a",
                                                "text": "„Währenddessen setzt meine Monatsblutung ein, doch ich traue mich nicht, bei einem der Schergen um Binden zu bitten.“"
                                            },
                                            {
                                                "example_id": "bba55659-48ab-4436-8589-00f5b5b096ac",
                                                "sense_id": "326d8639-916a-335e-8c80-71c08b63715a",
                                                "text": "„Andeutungen gab es genug, die vielen Salben und Cremes, Hornhautfeilen und Binden, sie waren verteilt auf Regalfächer und Ablageflächen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c3ffafda-f153-3e27-a8bb-2111d9073b34",
                                        "entry_id": "088e0ca1-2284-359e-95d3-d808240e21d1",
