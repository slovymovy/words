                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "promise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он дал <w>слово</w> помочь нам с переездом.",
                            "target_lang_translations": {
                                "en": "He gave his <w>word</w> to help us with the move.",
                                "zh": "他作出了帮我们搬家的<w>承诺</w>。"
                            }
