                                        "sense_id": "9aaf4661-2492-352d-80a2-9e73ca3bb4dc",
                                        "entry_id": "3a5a7dea-7359-3aa2-9ffd-6125e12371e9",
                                        "glosses": [
                                            "One of several people who take up arms against the local state authority; a participant in insurgency."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
