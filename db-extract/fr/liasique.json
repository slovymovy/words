                "senses": [
                    {
                        "sense_id": "379a77ab-23a3-351a-8771-f5dfd0ceaa3e",
                        "entry_id": "4b9f6d74-1b0a-34d0-99f1-e90f717c6696",
                        "glosses": [
                            "Qui est formé de lias."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d7cc3f2-4bfb-492f-b8d6-a7bef6320a15",
                                "sense_id": "379a77ab-23a3-351a-8771-f5dfd0ceaa3e",
                                "text": "La vallée de la Lanterne […] occupe […] une longue dépression creusée à travers les formations triasiques et liasiques dont les bandes circulaires plus ou moins sinueuses contournent la croupe méridionale des Vosges."
                            },
                            {
                                "example_id": "67eb9171-2e9c-48e8-b265-d856455cc9aa",
                                "sense_id": "379a77ab-23a3-351a-8771-f5dfd0ceaa3e",
                                "text": "Les seules observations récentes que j’aie faites sur la flore jurassique sont relatives à l’interprétation de certains types de la flore infraliasique ou liasique considérés par quelques paléobotanistes […] comme des Proangiospermes, c’est-à-dire des Angiospermes prototypiques, précédant et annonçant l’apparition des formes non douteuses de ce groupe qui se montrent au début de l’époque infracrétacée et prennent bientôt après dans la flore une place prédominante."
                            }
                        ]
                    }
