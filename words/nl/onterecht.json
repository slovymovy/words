{
    "word_family": [
        "terecht",
        "onterechtheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "47d11432-4a86-3502-a211-73627c01cbfc",
                    "sense_definition": "Niet in overeenstemming met de feiten of de waarheid; onjuist.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "onjuist",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn conclusie over de oorzaak van de fout was volkomen <w>onterecht</w>.",
                            "target_lang_translations": {
                                "en": "His conclusion about the cause of the error was completely <w>incorrect</w>."
                            }
                        },
                        {
                            "text": "Het is een <w>onterechte</w> aanname dat iedereen hier Nederlands spreekt.",
                            "target_lang_translations": {
                                "en": "It is an <w>incorrect</w> assumption that everyone here speaks Dutch."
                            }
                        }
                    ],
                    "synonyms": [
                        "onjuist",
                        "foutief",
                        "verkeerd"
                    ],
                    "antonyms": [
                        "terecht"
                    ],
                    "common_phrases": [
                        "een onterechte aanname",
                        "volkomen onterecht"
                    ],
                    "target_lang_definitions": {
                        "en": "Not in accordance with facts or truth; incorrect."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "incorrect",
                                "target_lang_sense_clarification": "General term for something that is not factually right."
                            },
                            {
                                "target_lang_word": "wrong",
                                "target_lang_sense_clarification": "Common term for something that is not true or accurate."
                            },
                            {
                                "target_lang_word": "erroneous",
                                "target_lang_sense_clarification": "Formal term for something based on a mistake or false information."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c88ea08-223d-35e1-83a2-442dfff42773",
                    "sense_definition": "Niet eerlijk of niet gerechtvaardigd; in strijd met het recht of de moraal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "onrechtvaardig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De werknemer protesteerde tegen zijn <w>onterechte</w> ontslag.",
                            "target_lang_translations": {
                                "en": "The employee protested against his <w>unjustified</w> dismissal."
                            }
                        },
                        {
                            "text": "Ik vind het <w>onterecht</w> dat zij alle schuld krijgt.",
                            "target_lang_translations": {
                                "en": "I think it is <w>unfair</w> that she gets all the blame."
                            }
                        }
                    ],
                    "synonyms": [
                        "onrechtvaardig",
                        "oneerlijk"
                    ],
                    "antonyms": [
                        "terecht"
                    ],
                    "common_phrases": [
                        "een onterechte beschuldiging",
                        "onterecht ontslagen"
                    ],
                    "target_lang_definitions": {
                        "en": "Not fair or not justified; contrary to law or morality."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unjustified",
                                "target_lang_sense_clarification": "Lacking a good or valid reason."
                            },
                            {
                                "target_lang_word": "unfair",
                                "target_lang_sense_clarification": "Not following the principles of justice or fairness."
                            },
                            {
                                "target_lang_word": "unwarranted",
                                "target_lang_sense_clarification": "Not authorized or necessary; lacking justification."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5167414e-1afc-3a74-9452-c3c973ff089a",
                    "sense_definition": "Zonder goede redenen of bewijzen; ongegrond.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ongegrond",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Achteraf bleek al onze angst voor de verandering gelukkig <w>onterecht</w>.",
                            "target_lang_translations": {
                                "en": "In hindsight, all our fear of the change fortunately turned out to be <w>groundless</w>."
                            }
                        },
                        {
                            "text": "Zij uitte een <w>onterechte</w> bezorgdheid over de veiligheid van het project.",
                            "target_lang_translations": {
                                "en": "She expressed <w>unfounded</w> concern about the safety of the project."
                            }
                        }
                    ],
                    "synonyms": [
                        "ongegrond"
                    ],
                    "antonyms": [
                        "terecht"
                    ],
                    "common_phrases": [
                        "onterechte angst",
                        "onterechte bezorgdheid"
                    ],
                    "target_lang_definitions": {
                        "en": "Without good reasons or evidence; groundless."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "groundless",
                                "target_lang_sense_clarification": "Having no basis in fact or evidence."
                            },
                            {
                                "target_lang_word": "baseless",
                                "target_lang_sense_clarification": "Without foundation or support."
                            },
                            {
                                "target_lang_word": "unfounded",
                                "target_lang_sense_clarification": "Not based on fact or reality."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e737416-d4b2-3460-a2e3-96276b89af95",
                    "sense_definition": "Niet passend bij de situatie of de persoon; misplaatst.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "misplaatst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>onterechte</w> trots verhinderde hem om hulp te vragen.",
                            "target_lang_translations": {
                                "en": "His <w>misplaced</w> pride prevented him from asking for help."
                            }
                        },
                        {
                            "text": "De leraar vond de grappen van de leerling tijdens de toets erg <w>onterecht</w>.",
                            "target_lang_translations": {
                                "en": "The teacher found the student's jokes during the test very <w>inappropriate</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "misplaatst",
                        "ongepast"
                    ],
                    "antonyms": [
                        "terecht"
                    ],
                    "common_phrases": [
                        "onterechte trots",
                        "onterechte kritiek"
                    ],
                    "target_lang_definitions": {
                        "en": "Not fitting the situation or the person; misplaced."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "misplaced",
                                "target_lang_sense_clarification": "Used for feelings or attitudes that are not appropriate for the context."
                            },
                            {
                                "target_lang_word": "inappropriate",
                                "target_lang_sense_clarification": "Not suitable or proper in the circumstances."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}