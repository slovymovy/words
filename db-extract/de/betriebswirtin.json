                "senses": [
                    {
                        "sense_id": "06e77144-cc00-3f41-8b5f-50871ccff617",
                        "entry_id": "1f307410-1d46-3b6f-832d-f8d52b9c0d0e",
                        "glosses": [
                            "Fachfrau auf dem Gebiet der Handelswissenschaften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d4eb409-7d1e-4209-9021-592e2f8c6dbb",
                                "sense_id": "06e77144-cc00-3f41-8b5f-50871ccff617",
                                "text": "„Die Betriebswirtin Evi Hartmann will uns zu Konsumenten machen, die fair hergestellte Produkte kaufen.“"
                            },
                            {
                                "example_id": "eaf8b925-dfce-4da4-9aca-ac442169a36c",
                                "sense_id": "06e77144-cc00-3f41-8b5f-50871ccff617",
                                "text": "„Anfangs für Recht und Regeltreue (Compliance) sowie Personal verantwortlich, sorgte die inzwischen 50 Jahre alte Betriebswirtin schnell dafür, dass die Bedenken der Aufsicht gegen die Commerzbank wegen mangelnder Geldwäschekontrollen verschwanden.“"
                            }
                        ],
