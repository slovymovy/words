                ],
                "senses": [
                    {
                        "sense_id": "7b03bdf3-20e2-3e2c-b582-4dec94fc1d4d",
                        "entry_id": "4a2a6d15-8184-3916-bfe6-4954d072a21b",
                        "glosses": [
                            "Donner un caractère kitsch à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eac425ee-8837-4d3e-9a79-fa0de3cf7771",
                                "sense_id": "7b03bdf3-20e2-3e2c-b582-4dec94fc1d4d",
                                "text": "Se manifeste notamment par une série de corrections qui tendent (dans la mesure où la résistance des déterminants spatiaux le permet) à ramener dans une voie traditionnelle l’architecture perçue comme «moderne» ou de la «kitschifier» (verkitschen)."
                            },
                            {
                                "example_id": "a7ca0ca2-7056-4015-9e64-62ae2b1825ba",
                                "sense_id": "7b03bdf3-20e2-3e2c-b582-4dec94fc1d4d",
                                "text": "Et le sens de l'absurde qui faisait exploser toutes ces influences, non pas pour s'en moquer ou les prendre de haut, non pas pour les kitschifier et les post-moderniser, comme j'ai toujours eu l'impression qu'un Zappa le fait (je n'argumenterai pas ici, c'est subjectif), mais pour les ramener à un niveau intime, introspectif, contemplatif, personnel."
                            },
                            {
                                "example_id": "1b89d85d-9688-4576-8cb8-7b56183b4ae7",
                                "sense_id": "7b03bdf3-20e2-3e2c-b582-4dec94fc1d4d",
                                "text": "Dans l’une des rares études portant sur ce phénomène, le romancier Hermann Broch suggère que, plutôt que de culture ou d’art kitsch, il vaudrait mieux parler de Kitschmensch, ce type humain kitschifié, si l’on peut dire, qui vit dans cette culture et qui la réclame."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "370c9cc6-7492-4ec8-9d60-b9b2fd16bbba",
                        "source_entry_id": "4a2a6d15-8184-3916-bfe6-4954d072a21b",
                        "source_sense_id": "7b03bdf3-20e2-3e2c-b582-4dec94fc1d4d",
                        "target_lang_word": "verkitschen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verkitschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b5abe1f-110c-3b80-8e58-7611f19277f5",
                                        "entry_id": "ca42e31a-3c63-3799-ace0-e57b2a94fdce",
                                        "glosses": [
                                            "etwas, das als ernsthafter (künstlerischer) Beitrag galt, so bearbeiten, dass es überzogen (kitschig) wirkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35e28e39-2bf1-48fb-bad7-aaf468e9f97b",
                                                "sense_id": "5b5abe1f-110c-3b80-8e58-7611f19277f5",
                                                "text": "„Der damalige, heute mild belächelte Heimatfilm zeigte viel über die Sehnsüchte und Hoffnungen dieser Generation, doch er verkitschte und missbrauchte sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd483a28-0b20-3655-b0d2-95c36e0b8f98",
                                        "entry_id": "ca42e31a-3c63-3799-ace0-e57b2a94fdce",
                                        "glosses": [
                                            "unter Preis verkaufen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "485b47a8-13aa-45df-907f-a8aaee14329b",
                                                "sense_id": "dd483a28-0b20-3655-b0d2-95c36e0b8f98",
                                                "text": "Verkitsch doch den alten Anhänger an einen Liebhaber."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
