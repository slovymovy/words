                },
                {
                    "sense_id": "7f8879c4-4c4d-3640-b84f-ba98402aa6aa",
                    "sense_definition": "A symbol placed on a music staff to indicate low-pitched notes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Piano music for the left hand is usually written in the <w>bass</w> clef.",
                            "target_lang_translations": {
                                "ru": "Фортепианная музыка для левой руки обычно пишется в <w>басовом</w> ключе.",
                                "zh": "钢琴左手的乐谱通常用<w>低音谱号</w>书写。"
                            }
                        },
                        {
                            "text": "Students must learn to read notes on both the treble and <w>bass</w> staves.",
                            "target_lang_translations": {
                                "ru": "Студенты должны научиться читать ноты как в скрипичном, так и в <w>басовом</w> ключах.",
                                "zh": "学生必须学会阅读高音谱表和<w>低音谱号</w>上的音符。"
                            }
