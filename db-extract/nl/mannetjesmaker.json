                        "examples": [
                            {
                                "example_id": "a5c1aa8f-8124-4a35-a91b-a00007f3c44a",
                                "sense_id": "4d9d3043-b375-3faa-a82d-34d3f4749626",
                                "text": "Hans Hylkema en Ton Vorstenbosch gebruikten voor de film Ben Korsten, de eerste spindoctor, of mannetjesmaker in politiek Den Haag, als inspiratiebron. In de film heet hij Ben Mertens. Nadat hij als 'foute' journalist in 1947 een publicatieverbod kreeg, werd hij pr-man van verschillende KVP-politici die hun weg zoeken naar de landelijke top. Hoe meer politici en zakenmensen hem misbruiken, des te dieper groeit zijn grootheidswaanzin, tot hij tenslotte als een wrak in 1969 wordt opgenomen in de Ursulakliniek, waar hij sterft aan een overdosis morfine. Pogingen om de geneesheer aan te klagen die hem lange tijd aan morfine heeft geholpen stranden in de doofpot."
                            },
                            {
                                "example_id": "4980c8c9-2e72-4c0c-a492-647d0735cf3b",
                                "sense_id": "4d9d3043-b375-3faa-a82d-34d3f4749626",
                                "text": "'We kunnen ons niet langer een situatie veroorloven waarin krijgsheren en mannetjesmakers hun eigen spel blijven spelen', zei Eide. Hij zei dat er 'aanzienlijke hervormingen' nodig waren in het Afghaanse politieke landschap."
                            }
                        ]
                    }
