                "senses": [
                    {
                        "sense_id": "19a11529-665d-3d0a-b4af-0b4afbb17bfe",
                        "entry_id": "8da601c0-2844-34e1-b6f3-65d2dc689da4",
                        "glosses": [
                            "Person, die auf der Internetseite »YouTube« Videos veröffentlicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12a4a6fb-8d70-49eb-ae01-ecbf73a505be",
                                "sense_id": "19a11529-665d-3d0a-b4af-0b4afbb17bfe",
                                "text": "In dieser Fotostrecke stellen wir sieben bekannte deutsche YouTuber vor und zeigen, welche ihre beliebtesten Videos sind."
                            },
                            {
                                "example_id": "94436c47-18bf-4347-9003-d586ce991ec7",
                                "sense_id": "19a11529-665d-3d0a-b4af-0b4afbb17bfe",
                                "text": "Ist es also ein erfolgversprechendes Berufsziel, YouTuber zu werden?"
                            },
                            {
                                "example_id": "4356a0df-3750-40e9-a457-3e06e6e9c526",
                                "sense_id": "19a11529-665d-3d0a-b4af-0b4afbb17bfe",
                                "text": "„Sie beschäftigt aktuell über 70 Mitarbeiter, drei von ihnen umgarnen YouTuber und Blogger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52fe1584-e9d1-42e6-8683-41133684699f",
                        "source_entry_id": "8da601c0-2844-34e1-b6f3-65d2dc689da4",
