        "fr-extract.jsonl": [
            {
                "entry_id": "4fb0920f-7d8f-3de3-a766-48231a36cc36",
                "word": "valablement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9d5617bc-1b25-383d-baf4-e8818c479a1c",
                        "entry_id": "4fb0920f-7d8f-3de3-a766-48231a36cc36",
                        "glosses": [
                            "D’une manière valable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c5e84ab-1bc8-4e91-90c7-1f11bc3b8a1d",
                                "sense_id": "9d5617bc-1b25-383d-baf4-e8818c479a1c",
                                "text": "Que les généraux d’armée…. qui auraient entre leurs mains les deniers qu’ils n'auraient point encore portés à l’épargne, en seraient valablement déchargés en les remettant aux décemvirs,"
                            },
                            {
                                "example_id": "38361385-8331-4b29-b4af-bca8a0085d02",
                                "sense_id": "9d5617bc-1b25-383d-baf4-e8818c479a1c",
                                "text": "Pour payer valablement, il faut être propriétaire de la chose donnée en payement, et capable de l’aliéner,"
                            }
                        ]
                    },
                    {
                        "sense_id": "88e24842-78f2-3348-86d4-0a1702bb931e",
                        "entry_id": "4fb0920f-7d8f-3de3-a766-48231a36cc36",
                        "glosses": [
                            "D’une façon appropriée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "affa787c-49bf-450a-97e3-10d44c52fd96",
                                "sense_id": "88e24842-78f2-3348-86d4-0a1702bb931e",
                                "text": "Ce mineur n'a pas été valablement défendu — il ne l’a pas été comme il aurait dû l’être en sa qualité de mineur."
                            },
                            {
                                "example_id": "30ecb707-8d62-4d69-b6a3-2e9acd9e7cd4",
                                "sense_id": "88e24842-78f2-3348-86d4-0a1702bb931e",
                                "text": "Ouvrage sérieux et digne d’être mis au net [expliqué] pour pouvoir être ensuite valablement réfuté,"
                            }
                        ]
                    }
                ],
