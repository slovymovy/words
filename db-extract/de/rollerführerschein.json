                            {
                                "example_id": "b735a8d9-bb92-4531-a9ca-84eb4b3ce9fa",
                                "sense_id": "5e6c802f-ef21-3388-aedf-d12b4b6ee57d",
                                "text": "„Ist ja schon toll, wenn man mobil ist und im Besitz eines Rollerführerscheins, da gebe ich ihnen ja Recht.“"
                            },
                            {
                                "example_id": "997852f1-7a32-4117-8b6a-7895ad56e90e",
                                "sense_id": "5e6c802f-ef21-3388-aedf-d12b4b6ee57d",
                                "text": "„Mit dem sogenannten Rollerführerschein, Klasse AM, dürfen Sie ab 16 Jahren ein Quad fahren.“"
                            },
                            {
                                "example_id": "90a74eb7-1a15-453e-af75-b4593de65118",
                                "sense_id": "5e6c802f-ef21-3388-aedf-d12b4b6ee57d",
                                "text": "„Normalerweise darf man dieses E-Auto ab 15 Jahren mit Rollerführerschein fahren (45 km/h Spitze, 8 PS).“"
                            }
                        ],
