                        "glosses": [
                            "Souiller à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77eb3795-8d73-4a86-918b-74831bc201c0",
                                "sense_id": "a6e8f9d5-1576-3ba8-8288-93c5121cefd5",
                                "text": "Je sais bien encore qu'elles ne doivent pas se resouiller de tous les fantômes impurs du passé, en les rappelant tout exprès, et de dessein sous des prétexte d'une confusion vertueuse ;"
                            },
                            {
                                "example_id": "1aa5dd5e-be3e-4725-a4ac-1881291b20f5",
                                "sense_id": "a6e8f9d5-1576-3ba8-8288-93c5121cefd5",
                                "text": "Heureusement, la pluie lave tout ca, et le lendemain vient tout resouiller."
                            }
                        ]
                    }
