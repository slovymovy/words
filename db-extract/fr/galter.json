                "senses": [
                    {
                        "sense_id": "a54612ae-c944-3a1d-baee-08bfcd3823cd",
                        "entry_id": "13b684be-f8e6-325e-b3c6-c79ee00048a9",
                        "glosses": [
                            "Se casser la figure, tomber par terre."
                        ],
                        "tags": [
                            "Midi toulousain"
                        ],
                        "examples": [
                            {
                                "example_id": "dac35e6b-a14f-482f-b58d-1f22750a5540",
                                "sense_id": "a54612ae-c944-3a1d-baee-08bfcd3823cd",
                                "text": "Quand tout à coup un nain d’café un peu maladroit qui aurait à cet instant mérité qu’on le batte encore plus que de mesure, trouva le moyen de croiser ses petits pieds grassouillets et de se galter avec son plateau couvert de pichets de bière."
                            },
                            {
                                "example_id": "cd72e915-c8e4-4231-8d69-b4d4f3dce4d5",
                                "sense_id": "a54612ae-c944-3a1d-baee-08bfcd3823cd",
                                "text": "Il y en a une qui m'a tapé un sprint de 20 mètres en 5 secondes, elle a fait un maxi saut vers moi et j'étais en mode SVAV du coup je l'ai bien vu se galter à côté de moi c'était trop beau 😆"
                            }
                        ]
                    }
