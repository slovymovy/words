{
    "word_family": [
        "wapperen",
        "wappering"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "43304e59-ebcb-37e1-8065-82d50627d323",
                    "sense_definition": "Snel heen en weer bewegend door de wind of door een zwaaiende beweging.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>wapperende</w> vlaggen aan de gevel maakten veel geluid in de harde wind.",
                            "target_lang_translations": {
                                "en": "The <w>flapping</w> flags on the facade made a lot of noise in the strong wind.",
                                "fr": "Les drapeaux <w>flottants</w> sur la façade faisaient beaucoup de bruit dans le vent fort."
                            }
                        },
                        {
                            "text": "Hij rende naar het station met zijn <w>wapperende</w> jas achter zich aan.",
                            "target_lang_translations": {
                                "en": "He ran to the station with his jacket <w>flapping</w> behind him.",
                                "fr": "Il a couru vers la gare avec son manteau <w>flottant</w> derrière lui."
                            }
                        }
                    ],
                    "synonyms": [
                        "fladderend",
                        "zwaaiend"
                    ],
                    "common_phrases": [
                        "wapperende vlaggen",
                        "wapperende haren"
                    ],
                    "target_lang_definitions": {
                        "en": "Moving back and forth rapidly due to the wind or a waving motion.",
                        "fr": "Qui bouge rapidement d'avant en arrière sous l'effet du vent ou d'un mouvement de balancement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flapping",
                                "target_lang_sense_clarification": "moving back and forth in the wind"
                            },
                            {
                                "target_lang_word": "fluttering",
                                "target_lang_sense_clarification": "waving light or rapid motion in the wind"
                            },
                            {
                                "target_lang_word": "waving",
                                "target_lang_sense_clarification": "moving freely in the air"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "flottant",
                                "target_lang_sense_clarification": "qui flotte au vent"
                            },
                            {
                                "target_lang_word": "battant",
                                "target_lang_sense_clarification": "qui bat au vent, comme un drapeau"
                            },
                            {
                                "target_lang_word": "au vent",
                                "target_lang_sense_clarification": "qui vole au vent, cheveux ou vêtements"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4743e036-5d34-37cc-be28-755219ac75d9",
                    "sense_definition": "Onvoltooid deelwoord van <w>wapperen</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Al <w>wapperend</w> met een krant probeerde ze de vliegen weg te jagen.",
                            "target_lang_translations": {
                                "en": "While <w>waving</w> a newspaper, she tried to chase the flies away.",
                                "fr": "Tout <w>en agitant</w> un journal, elle essayait de chasser les mouches."
                            }
                        },
                        {
                            "text": "De was hing droog te worden, <w>wapperend</w> in de zachte zomerwind.",
                            "target_lang_translations": {
                                "en": "The laundry was hanging to dry, <w>fluttering</w> in the soft summer wind.",
                                "fr": "Le linge séchait, <w>flottant</w> dans la douce brise estivale."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wapperend in de wind"
                    ],
                    "traits": [
