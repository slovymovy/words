    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7b42853f-1ee1-3572-afcf-2699a7488d2a",
                    "sense_definition": "Land covered with trees and other woody vegetation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "forest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers walked through the dense <w>woodland</w> to reach the hidden lake.",
                            "target_lang_translations": {
                                "tr": "Doğa yürüyüşçüleri gizli göle ulaşmak için sık <w>ormanlık alandan</w> geçtiler."
                            }
                        },
                        {
                            "text": "Many animals make their homes in the protected <w>woodland</w> area.",
                            "target_lang_translations": {
                                "tr": "Birçok hayvan, koruma altındaki <w>ormanlık</w> bölgede yuva yapar."
                            }
                        }
                    ],
                    "synonyms": [
                        "forest",
                        "timberland"
                    ],
                    "common_phrases": [
                        "ancient woodland"
                    ],
                    "target_lang_definitions": {
                        "tr": "Ağaçlarla ve diğer odunsu bitkilerle kaplı arazi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ormanlık alan",
                                "target_lang_sense_clarification": "Ağaçlık bölge veya arazi anlamında genel kullanım."
                            },
                            {
                                "target_lang_word": "koruluk",
                                "target_lang_sense_clarification": "Küçük veya seyrek ağaçlıklı alanlar için kullanılır."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f39017ef-aead-35b8-a251-b6e8200a9fb2",
                    "sense_definition": "Relating to creatures or objects that live or exist in a forest environment.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "forest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>woodland</w> birds sang loudly as the sun began to rise.",
                            "target_lang_translations": {
                                "tr": "Güneş doğmaya başladığında <w>orman</w> kuşları yüksek sesle ötüyordu."
                            }
                        },
                        {
                            "text": "We spotted several <w>woodland</w> flowers while hiking along the trail.",
                            "target_lang_translations": {
                                "tr": "Patika boyunca yürürken birkaç <w>orman</w> çiçeği gördük."
                            }
                        }
                    ],
                    "common_phrases": [
                        "woodland creatures"
                    ],
                    "target_lang_definitions": {
                        "tr": "Orman ortamında yaşayan veya bulunan canlılar ya da nesnelerle ilgili."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "orman",
                                "target_lang_sense_clarification": "Sıfat görevinde, ormana ait olan anlamında kullanılır."
                            },
                            {
                                "target_lang_word": "ormanlık",
                                "target_lang_sense_clarification": "Orman bölgesine özgü veya ormanda yaşayan anlamında."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
