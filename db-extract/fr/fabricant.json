        "fr-extract.jsonl": [
            {
                "entry_id": "5ee9507e-f5b1-34f4-aa6e-1bd11a6c06ee",
                "word": "fabricant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2dac1892-98ae-44f1-a81a-0d39b815b586",
                        "entry_id": "5ee9507e-f5b1-34f4-aa6e-1bd11a6c06ee",
                        "tags": [
                            "plural"
                        ],
                        "form": "fabricants"
                    },
                    {
                        "form_id": "98c20cd6-ab3e-451d-bab2-eb8817cdebcc",
                        "entry_id": "5ee9507e-f5b1-34f4-aa6e-1bd11a6c06ee",
                        "tags": [
                            "feminine"
                        ],
                        "form": "fabricante"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9d151483-36f9-3a99-9877-71e36fe84a0b",
                        "entry_id": "5ee9507e-f5b1-34f4-aa6e-1bd11a6c06ee",
                        "glosses": [
                            "Industriel ou artisan qui fabrique ou qui fait fabriquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7fb0542-6f5f-494f-81d6-2a53fd42ca7a",
                                "sense_id": "9d151483-36f9-3a99-9877-71e36fe84a0b",
                                "text": "Si les fabricants vantent ses propriétés anxiolytiques, anti-inflammatoires, neuroprotectrices et antalgiques, l’association invite à en nuancer la fiabilité."
                            },
                            {
                                "example_id": "1bca39d3-5f00-4c2a-acd1-99f34951da42",
                                "sense_id": "9d151483-36f9-3a99-9877-71e36fe84a0b",
                                "text": "Si l’Allemagne n’a point conquis encore la place qui devrait lui revenir dans le monde économique […], cela tient à ce que, pendant longtemps, ses fabricants crurent qu'il était habile d’inonder le marché avec de la camelote ; bien que la production allemande se soit fort améliorée depuis quelques années, elle ne jouit point encore d’une très haute considération."
                            },
                            {
                                "example_id": "41b82e74-c6c3-4c77-ba5e-431dc79455ac",
                                "sense_id": "9d151483-36f9-3a99-9877-71e36fe84a0b",
                                "text": "Les docteurs du Talmud ne donnaient-ils pas eux-mêmes l'exemple en exerçant, pour assurer leur gagne-pain, les métiers les plus humbles, tels que forgerons, ou savetier, ou fabricant d'épingles, etc. ?"
                            },
                            {
                                "example_id": "c5fc0ff8-2dd4-40b1-bb53-ed67da2edbd7",
                                "sense_id": "9d151483-36f9-3a99-9877-71e36fe84a0b",
                                "text": "Si j'étais fabricant de gilets en Kevlar, j'aurais peut-être envie de faire appel à un arachnologue, autrement dit à un spécialiste des araignées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6becbe0-654a-400d-8ac0-b7a84fdba439",
                        "source_entry_id": "5ee9507e-f5b1-34f4-aa6e-1bd11a6c06ee",
                        "source_sense_id": "9d151483-36f9-3a99-9877-71e36fe84a0b",
                        "source_sense_description": "celui qui fabrique",
                        "target_lang_word": "Hersteller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hersteller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34e50181-ee60-3b5e-beaf-77e558801409",
                                        "entry_id": "1e284e49-ba4c-3c4a-8ae0-9f76c079c2ad",
                                        "glosses": [
                                            "Unternehmen, das bestimmte Artikel herstellt (produziert)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b38771f5-b087-4f07-9067-283e26feda2c",
                                                "sense_id": "34e50181-ee60-3b5e-beaf-77e558801409",
                                                "text": "Ersatzteile hierfür gibt es nur direkt beim Hersteller."
                                            },
                                            {
                                                "example_id": "c01b8427-ea6c-4fac-9a8b-08829d51b27b",
                                                "sense_id": "34e50181-ee60-3b5e-beaf-77e558801409",
                                                "text": "„Als die Staatsanwältin nach dem Hersteller fragt, fährt der Beamte mit dem Zeigefinger über den Pistolenlauf und wischt das Blut weg.“"
                                            },
                                            {
                                                "example_id": "e74a42dd-4656-47ed-8a46-b23050dab1ea",
                                                "sense_id": "34e50181-ee60-3b5e-beaf-77e558801409",
                                                "text": "„Der Airbus A321neo mit neuen Triebwerken des Herstellers CFM International hat von Hamburg aus seinen erfolgreichen Erstflug absolviert.“"
                                            },
                                            {
                                                "example_id": "ee39c7a0-3693-47e9-915e-ff17ec098af4",
                                                "sense_id": "34e50181-ee60-3b5e-beaf-77e558801409",
                                                "text": "„So kam die global ausgreifende Chronik nicht zuletzt wegen der lokalen Vernetzung ihrer Mitarbeiter, Hersteller und Financiers zustande.“"
                                            },
                                            {
                                                "example_id": "50d56e7e-3a47-42a6-8267-7ce43382754c",
                                                "sense_id": "34e50181-ee60-3b5e-beaf-77e558801409",
                                                "text": "„Aus Anlass des aktuellen Jubiläums lancierten die Hersteller nun ein Herrenparfüm, über das wir, so hofften sie, dann schreiben würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7034bc9a-9eb8-4a81-9681-17f20941e586",
                        "source_entry_id": "5ee9507e-f5b1-34f4-aa6e-1bd11a6c06ee",
                        "source_sense_id": "9d151483-36f9-3a99-9877-71e36fe84a0b",
                        "source_sense_description": "celui qui fabrique",
                        "target_lang_word": "Macher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Macher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4536bd48-6064-3504-8f1f-8e7fb7c9d25d",
                                        "entry_id": "bc76cfe3-39e4-3346-b9a3-b23c827fee2b",
                                        "glosses": [
                                            "Person, die handelt/aktiv ist/etwas herstellt; Akteur, Handelnder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9be500eb-e760-497c-b2b3-8804c5aeb832",
                                                "sense_id": "4536bd48-6064-3504-8f1f-8e7fb7c9d25d",
                                                "text": "„Pragmatische Macher waren nun am Drücker und sorgten für blühende Landschaften.“"
                                            },
                                            {
                                                "example_id": "50b7f46e-9387-41ff-b342-f5fc74f5f246",
                                                "sense_id": "4536bd48-6064-3504-8f1f-8e7fb7c9d25d",
                                                "text": "„Im Deutschen ist ein Macher ein Machertyp, der immerzu macht und macht.“"
                                            },
                                            {
                                                "example_id": "7152a88a-86ce-4950-b84d-fb7a759caf69",
                                                "sense_id": "4536bd48-6064-3504-8f1f-8e7fb7c9d25d",
                                                "text": "„Um die Ergebnisse unseres Tuns wäre es besser bestellt, wenn die Denker öfter aus sich heraus und die Macher gelegentlich in sich gehen würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f9c3f536-0de1-3fc6-b78a-33a8792b4b4b",
                                        "entry_id": "bc76cfe3-39e4-3346-b9a3-b23c827fee2b",
                                        "glosses": [
                                            "ein Anstifter, der etwas anstiftet"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bab7711-c472-4782-837d-ed6b83cbc681",
                                                "sense_id": "f9c3f536-0de1-3fc6-b78a-33a8792b4b4b",
                                                "text": "Die eigentlichen Macher blieben lange Zeit im Hintergrund."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
