                                    }
                                ]
                            },
                            {
                                "target_word": "Fidschi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c83e7e6-85c2-35ba-be93-9976dd7be71a",
                                        "entry_id": "ba174b60-8fc2-3a7e-92ea-43ac5c46ce70",
                                        "glosses": [
                                            "auf den Fidschi-Inseln gesprochene austronesische Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05d9eb65-0846-4083-add0-1312bae71fd3",
                                                "sense_id": "3c83e7e6-85c2-35ba-be93-9976dd7be71a",
                                                "text": "Wie heißt das auf Fidschi?"
                                            },
                                            {
                                                "example_id": "0b64edd0-3fc0-4974-8f7a-352964e45c38",
                                                "sense_id": "3c83e7e6-85c2-35ba-be93-9976dd7be71a",
                                                "text": "Das Tonganische zeigt Anklänge ans Fidschi."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Fidschi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cea3fb88-fce6-3b4a-b988-bbdd4b416754",
                                        "entry_id": "9c524d19-e8dd-3e61-a740-7f651c44b412",
                                        "glosses": [
                                            "Vietnamese; Person, die aus Vietnam stammt; im weiteren Sinne alle Ost- und Südostasiaten"
                                        ],
                                        "tags": [
                                            "meist abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3a44f2b-7797-4f4c-8e36-222406fc27e6",
                                                "sense_id": "cea3fb88-fce6-3b4a-b988-bbdd4b416754",
                                                "text": "„Einmal habe jemand den Freund „Fidschi“ geschimpft und ihm ein Messer an den Hals gehalten.“"
                                            },
                                            {
                                                "example_id": "d87e9aa7-5257-47a9-bfc1-37cffdfe3a28",
                                                "sense_id": "cea3fb88-fce6-3b4a-b988-bbdd4b416754",
                                                "text": "„Das tröstete sie über die hinweg, die beim Einkaufen in ihren Korb sahen und über die Fidschis schimpften, die den Einheimischen hier alles wegkauften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Fidschi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f7b1ff1-739a-3493-a66e-0ad8e62fa510",
                                        "entry_id": "3bc54a48-8619-368f-ac1a-faafe1ee195d",
                                        "glosses": [
                                            "Vietnamesin; weibliche Person, die aus Indochina stammt; im Plural auch männliche Personen einbeziehend"
