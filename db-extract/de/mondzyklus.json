                ],
                "senses": [
                    {
                        "sense_id": "8cbe8754-7ca2-3d96-bd55-aa348e0a93c1",
                        "entry_id": "497db091-dd68-3967-a994-77398f30233d",
                        "glosses": [
                            "vollständiger Durchlauf durch alle Mondphasen, von Neumond bis Neumond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da1c3c8e-6771-4af9-8b4d-abfcec7228af",
                                "sense_id": "8cbe8754-7ca2-3d96-bd55-aa348e0a93c1",
                                "text": "Ein Mondzyklus dauert 29 Tage, 12 Stunden 44 Minuten und 3 Sekunden."
                            },
                            {
                                "example_id": "c1d0cb2a-3158-47db-88d8-d0fbdf46413e",
                                "sense_id": "8cbe8754-7ca2-3d96-bd55-aa348e0a93c1",
                                "text": "„Die Julianische Osterberechnung unterscheidet sich von der Gregorianischen hauptsächlich darin, daß bei der erstern gar keine Epakten berücksichtigt werden, sondern nur der Mondzyklus zur Anwendung kommt.“"
                            },
                            {
                                "example_id": "50c58bd2-9bce-4beb-b8a2-2f32995d9377",
                                "sense_id": "8cbe8754-7ca2-3d96-bd55-aa348e0a93c1",
                                "text": "„Dies bietet mehrere Optionen: den reinen Sonnenzyklus, den reinen Mondzyklus, den »lunar-solaren« Kompromiss aus beiden oder aber die völlige Aufgabe jedes Versuchs, dem eine Logik abzugewinnen, und die Einrichtung eines völlig künstlichen Systems.“"
                            },
                            {
                                "example_id": "1bcd368a-52dc-4cb5-b27c-502ffa9311cd",
                                "sense_id": "8cbe8754-7ca2-3d96-bd55-aa348e0a93c1",
                                "text": "„Die Eintragungen betreffen Jahreszyklen: den üblichen Sonnenzyklus von 28 Jahren und den Mondzyklus von 19 Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
