        "fr-extract.jsonl": [
            {
                "entry_id": "53286b9d-7fc6-384a-a95e-8cc8e252044e",
                "word": "thaler",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0d1b1c14-d724-47bd-9f5f-864ee5d95ba2",
                        "entry_id": "53286b9d-7fc6-384a-a95e-8cc8e252044e",
                        "tags": [
                            "plural"
                        ],
                        "form": "thalers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dded97e3-800f-360b-80c8-fd448cc79820",
                        "entry_id": "53286b9d-7fc6-384a-a95e-8cc8e252044e",
                        "glosses": [
                            "Ancienne monnaie d’argent allemande."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f34e59b-7444-449a-ba31-3029b7d75b9d",
                                "sense_id": "dded97e3-800f-360b-80c8-fd448cc79820",
                                "text": "Lorsqu’on sut que madame Malibran, allant ramasser des thalers en Allemagne, allait passer à deux lieues de Nancy, M. de Sanréal eut l’idée d’organiser un concert."
                            },
                            {
                                "example_id": "aa5ac1fe-c677-4791-b1cb-6667e78b1e8d",
                                "sense_id": "dded97e3-800f-360b-80c8-fd448cc79820",
                                "text": "3 000 thalers d’argent à l’effigie de Marie-Thérèse, impératrice d’Autriche — ils n’acceptent pas d’autre monnaie — qu’il fallut acheter à Aden."
                            },
                            {
                                "example_id": "e277e875-a530-4401-b514-a058d8d398c6",
                                "sense_id": "dded97e3-800f-360b-80c8-fd448cc79820",
                                "text": "C’est pourquoi, se sentant indigné, il s’avança vers le bohémien, lui mit un thaler dans la main, et, le prenant bras dessus bras dessous, lui dit : « Je te retiens pour cette nuit de Noël ; arrive ! »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91306f91-d624-40b7-879d-e63defff0940",
                        "source_entry_id": "53286b9d-7fc6-384a-a95e-8cc8e252044e",
                        "source_sense_id": "dded97e3-800f-360b-80c8-fd448cc79820",
                        "target_lang_word": "Taler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f48867b-aac8-3814-8e7f-50d26ce7ea4d",
                                        "entry_id": "1b50c858-3128-35ea-8efd-5987e4c0cdea",
                                        "glosses": [
                                            "eine ab dem 16. Jahrhundert geprägte große Silbermünze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "848ed119-4d15-4db2-802b-5c39a63b5f68",
                                                "sense_id": "9f48867b-aac8-3814-8e7f-50d26ce7ea4d",
                                                "text": "Hier geht es um richtige Taler, also strenge dich an."
                                            },
                                            {
                                                "example_id": "e69caf15-04ec-4dfb-97f3-17ad4be060d9",
                                                "sense_id": "9f48867b-aac8-3814-8e7f-50d26ce7ea4d",
                                                "text": "„»Das Mädchen«, sagte mir jetzt der Onkel, »ist eine gute Partie, so wie Sie sie hier sehen; denn sie hat dreitausend Taler. […] “"
                                            },
                                            {
                                                "example_id": "23eac86f-c5f5-44ae-9063-1d5a53b271e9",
                                                "sense_id": "9f48867b-aac8-3814-8e7f-50d26ce7ea4d",
                                                "text": "„Und als er nach dem Gesang zu ihr trat, hatte sie die fünf Groschen, die sie für ihn zurechtgelegt hatte, in einen Taler verwandelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f5b9c86-c979-389f-9010-733079e92f47",
                                        "entry_id": "1b50c858-3128-35ea-8efd-5987e4c0cdea",
                                        "glosses": [
                                            "historische Währungseinheit"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df89e649-bd21-4072-acc5-45d6f8733d7b",
                        "source_entry_id": "53286b9d-7fc6-384a-a95e-8cc8e252044e",
