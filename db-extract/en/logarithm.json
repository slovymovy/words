                                        "entry_id": "56fa489f-2580-3fd9-bcb8-42181e16cc71",
                                        "glosses": [
                                            "die Zahl, mit der man eine Basiszahl potenzieren muss, um die vorgegebene Zahl (Numerus) zu erhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
