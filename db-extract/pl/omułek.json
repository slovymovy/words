                                "target_senses": [
                                    {
                                        "sense_id": "36c845fc-a48f-3c88-9af1-28658d0f6fee",
                                        "entry_id": "4349c5e9-8a4e-3eca-a7a7-5ad65fd1cb8d",
                                        "glosses": [
                                            "зоол. род двустворчатого съедобного моллюска семейства ракушниковых"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10e2944e-0809-4685-8e15-777b181469eb",
                                                "sense_id": "36c845fc-a48f-3c88-9af1-28658d0f6fee",
                                                "text": "Мясо морских ракушек ― мидий ― мы варили с солью. В нем чувствовался сильный привкус ихтиола. Кроме того, мидий надо было добывать самим на Ланжероне, отдирая их ножом от прибрежных скал, конечно, в тихую и теплую погоду. Поэтому мидии были только летней пищей."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
