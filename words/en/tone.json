                                "target_lang_word": "肌张力",
                                "target_lang_sense_clarification": "医学上的肌肉紧张度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "317c48c1-8a84-3f75-b24e-b6fb73ede7bb",
                    "sense_definition": "An interval of a major second in the diatonic scale.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sound_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Western music, a whole <w>tone</w> is equivalent to two semitones.",
                            "target_lang_translations": {
                                "ru": "В западной музыке целый <w>тон</w> эквивалентен двум полутонам.",
                                "zh": "在西方音乐中，一个<w>全音</w>等于两个半音。"
                            }
                        },
                        {
                            "text": "The scale is built using a pattern of <w>tones</w> and semitones.",
                            "target_lang_translations": {
                                "ru": "Гамма строится по схеме <w>тонов</w> и полутонов.",
                                "zh": "音阶是按照全音和半音的模式构建的。"
                            }
                        }
                    ],
                    "synonyms": [
