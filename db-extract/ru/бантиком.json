                        "examples": [
                            {
                                "example_id": "e0ce4fe8-a253-4ade-88c2-3a0142d2e98d",
                                "sense_id": "89ed8140-0f9e-3c8d-8470-cf1322b58f3f",
                                "text": "Теперь на шее у кота оказался белый фрачный галстук бантиком, а на груди перламутровый дамский бинокль на ремешке."
                            },
                            {
                                "example_id": "c32ed035-90c9-4732-b033-ccfe700a0360",
                                "sense_id": "89ed8140-0f9e-3c8d-8470-cf1322b58f3f",
                                "text": "Низкий, без единой морщинки лоб, жёлтые кустики бровей, ротик бантиком ― всё это придавало его физиономии важное качество внешности вора: незаметность."
                            }
                        ]
                    }
