                ],
                "senses": [
                    {
                        "sense_id": "6213434a-964d-3eec-8d3f-9436f31dce33",
                        "entry_id": "cd7adbbf-4dc7-3692-8375-80b191d25fad",
                        "glosses": [
                            "der Vorgang, bei dem nach der quantitativen Beziehung E = m * c² (mit: E = Energie; m = Masse; c = Lichtgeschwindigkeit) Energie in Masse umgewandelt werden kann"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "8b21ad6a-27c5-4664-a161-0c996332f35b",
                                "sense_id": "6213434a-964d-3eec-8d3f-9436f31dce33",
                                "text": "Durch Absorption sehr durchdringender Strahlung können positive und negative Elektronen paarweise entstehen (Materialisation von Strahlung)."
                            },
                            {
                                "example_id": "f0926f66-82be-43a2-b441-7484b773437c",
                                "sense_id": "6213434a-964d-3eec-8d3f-9436f31dce33",
                                "text": "Auch der umgekehrte Prozeß, die „Materialisation\" von Strahlungsenergie wurde beobachtet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ea3167f1-d100-36d4-9b0d-6335cda3c9ca",
                        "entry_id": "cd7adbbf-4dc7-3692-8375-80b191d25fad",
                        "glosses": [
                            "Vorgang, bei dem der Geist in unserer Welt in Form von Körpern oder menschlichen Körperteilen (Händen, Füßen und anderen) Gestalt annimmt"
                        ],
                        "tags": [
                            "Parapsychologie"
                        ],
                        "examples": [
                            {
                                "example_id": "f5f609a5-932d-4236-b328-16289b1ddaeb",
                                "sense_id": "ea3167f1-d100-36d4-9b0d-6335cda3c9ca",
                                "text": "Vielfache, äußerst genaue Experimente, über die wir weiter unten berichten, werden den entscheidenden Beweis für die Materialisation liefern."
                            },
                            {
                                "example_id": "da99aedf-a05f-4351-a4c5-506bb5708dbb",
                                "sense_id": "ea3167f1-d100-36d4-9b0d-6335cda3c9ca",
                                "text": "Keiner der wissenschaftlichen Forscher (Crookes, Geley, Crawford, Schrenck-Notzing) hat den Beweis geliefert, daß Materialisationen oder Teleplastie bestehen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
