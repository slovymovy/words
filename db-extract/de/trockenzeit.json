                        "source_sense_id": "678bfd63-a347-35ed-acaa-ec739a6a90d0",
                        "source_sense_description": "Zeitraum (in den Subtropen und Tropen), in dem nur sehr wenig Regen fällt",
                        "target_lang_word": "saison sèche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saison sèche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a90caec-42bc-36f6-bca4-a4d8f39a33d5",
                                        "entry_id": "43f54de1-585f-3ac1-8eab-85055dd09ffd",
                                        "glosses": [
                                            "Saison de l’année dans les climats tropicaux durant laquelle il pleut peu ou pas du tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34274413-4281-4dbc-8b04-0e1b26efe418",
                                                "sense_id": "9a90caec-42bc-36f6-bca4-a4d8f39a33d5",
                                                "text": "En saison sèche, les Garde-bœuf suivent les feux de forêt et de savane, pour manger les animaux mis à nu par la disparition de la couverture herbacée."
                                            },
                                            {
                                                "example_id": "be1d4545-bdd7-48ac-bf86-71d0e109ac25",
                                                "sense_id": "9a90caec-42bc-36f6-bca4-a4d8f39a33d5",
                                                "text": "Ainsi, un faucheur peut récolter en 4 jours de quoi nourrir en complément une bonne vache pendant la saison sèche, soit de 600 à 800 kg de foin."
                                            },
                                            {
                                                "example_id": "2fc50155-099b-4802-8744-9fe1f21ad571",
                                                "sense_id": "9a90caec-42bc-36f6-bca4-a4d8f39a33d5",
                                                "text": "L’endoréisme en fait des zones de refuge pour les pasteurs pendant l’hivernage. Les pasteurs y séjournent avec leurs troupeaux, fuyant les régions paludéennes des grandes plaines fluviales où ils ne reviennent qu'en saison sèche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
