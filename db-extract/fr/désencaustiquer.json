                "senses": [
                    {
                        "sense_id": "06aefaa5-2963-332c-9883-330f03c6a99f",
                        "entry_id": "e9982269-c239-3ce7-aade-cd6728dd339b",
                        "glosses": [
                            "Défaire l'encaustique qui avait été appliquée sur quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e70c3b6-c06d-485c-ae3f-9ebb604ea24f",
                                "sense_id": "06aefaa5-2963-332c-9883-330f03c6a99f",
                                "text": "J'ai réalisé une greffe de bois sur la porte en bas à gauche, désencaustiqué les portes pour enlever les taches (très anciennes). J'ai reciré l'ensemble."
                            }
                        ]
                    },
                    {
                        "sense_id": "c56febbd-8434-3583-919d-df38956bb30e",
                        "entry_id": "e9982269-c239-3ce7-aade-cd6728dd339b",
                        "glosses": [
                            "Désintoxiquer."
                        ],
                        "tags": [
                            "Par jeu de mot"
                        ],
                        "examples": [
                            {
                                "example_id": "f906f930-783e-4a24-a3ea-5f9e6130ccc8",
                                "sense_id": "c56febbd-8434-3583-919d-df38956bb30e",
                                "text": "C'est à cause du son où c'est encore poissé : on s'est pas tout à fait désencaustiqué du rance hypnoctué de l'indifférence."
                            }
                        ]
                    }
