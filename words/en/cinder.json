{
    "word_family": [
        "cindery",
        "cinderblock",
        "Cinderella"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c20f2ce6-7356-39ee-833d-1fa665b25647",
                    "sense_definition": "A piece of partly or mostly burned coal, wood, or other material that has stopped burning without turning completely to ash.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "burned_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A hot <w>cinder</w> blew out of the fireplace and left a small burn mark on the rug.",
                            "target_lang_translations": {
                                "cs": "Z krbu vylétl horký <w>oharek</w> a zanechal na koberci malou spáleninu."
                            }
                        },
                        {
                            "text": "The toast was left in the oven too long and turned into a black <w>cinder</w>.",
                            "target_lang_translations": {
                                "cs": "Topinka zůstala v troubě příliš dlouho a proměnila se v černý <w>uhel</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "burned to a cinder",
                        "cinder track",
                        "cinder block"
                    ],
                    "target_lang_definitions": {
                        "cs": "Kus částečně nebo většinou ohořelého uhlí, dřeva nebo jiného materiálu, který přestal hořet, aniž by se zcela proměnil v popel."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "oharek",
                                "target_lang_sense_clarification": "ohořelý kus dřeva či uhlí"
                            },
                            {
                                "target_lang_word": "škvara",
                                "target_lang_sense_clarification": "spálený zbytek, zejména uhlí"
                            },
                            {
                                "target_lang_word": "uhel",
                                "target_lang_sense_clarification": "zuhelnatělý zbytek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a0d3137-86a0-33b3-a462-f157474fb102",
                    "sense_definition": "A glowing piece of coal or wood in a dying fire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "burned_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only a few glowing <w>cinders</w> remained in the hearth after midnight.",
                            "target_lang_translations": {
                                "cs": "Po půlnoci zbylo v ohništi jen několik <w>žhavých uhlíků</w>."
                            }
                        },
                        {
                            "text": "He poked at the red <w>cinder</w> to coax a flame from the dry leaves.",
                            "target_lang_translations": {
                                "cs": "Šťouchl do rudého <w>uhlíku</w>, aby z hromádky suchého listí vykřesal plamínek."
                            }
                        }
                    ],
                    "synonyms": [
                        "ember"
                    ],
                    "common_phrases": [
                        "glowing cinders"
                    ],
                    "target_lang_definitions": {
                        "cs": "Žhnoucí kus uhlí nebo dřeva v dohasínajícím ohni."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "žhavý uhel",
                                "target_lang_sense_clarification": "žhnoucí kousek v ohništi"
                            },
                            {
                                "target_lang_word": "žhavý oharek",
                                "target_lang_sense_clarification": "dohořívající kousek dřeva nebo uhlí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa6dc9a5-5039-32c9-a0fa-5adeb41996c4",
                    "sense_definition": "Rough, glassy waste material separated from metal during smelting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "smelting_residue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Piles of dark <w>cinder</w> surrounded the abandoned ironworks.",
                            "target_lang_translations": {
                                "cs": "Opuštěnou huť obklopovaly hromady tmavé <w>strusky</w>."
                            }
                        },
                        {
                            "text": "Workers cleared the furnace to remove accumulated <w>cinder</w> from the metal ore.",
                            "target_lang_translations": {
                                "cs": "Dělníci vyčistili pec, aby odstranili nahromaděnou <w>škváru</w> z kovové rudy."
                            }
                        }
                    ],
                    "synonyms": [
                        "slag"
                    ],
                    "target_lang_definitions": {
                        "cs": "Hrubý, sklovitý odpadní materiál oddělený od kovu při tavení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "struska",
                                "target_lang_sense_clarification": "odpad při tavení rudy"
                            },
                            {
                                "target_lang_word": "škvára",
                                "target_lang_sense_clarification": "hutní a hutnický odpad"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e33c27ce-cc7f-3d7c-b284-9c1b95e7c4b6",
                    "sense_definition": "A strong alcoholic drink or stimulant added to tea, soda water, or another beverage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drink_additive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She requested a cup of hot tea spiked with a <w>cinder</w> to warm her up.",
                            "target_lang_translations": {
                                "cs": "Požádala o šálek horkého čaje s <w>kapkou tvrdého alkoholu</w>, aby se zahřála."
                            }
                        },
                        {
                            "text": "He poured a measure of whiskey as a <w>cinder</w> into his afternoon beverage.",
                            "target_lang_translations": {
                                "cs": "Nalil si odměrku whisky jako <w>panáka</w> do svého odpoledního nápoje."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used historically to refer to liquor added to another drink"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Kapka nebo dávka tvrdého alkoholu přidaná do čaje, sodovky či jiného nápoje."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kapka alkoholu",
                                "target_lang_sense_clarification": "přísada do nealkoholického nápoje"
                            },
                            {
                                "target_lang_word": "panák",
                                "target_lang_sense_clarification": "dávka alkoholu do čaje apod."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "084ee5bf-f5c8-3edb-871e-e55b12a4663f",
                    "sense_definition": "To burn completely or reduce something to cinders.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_cinder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fierce forest fire threatened to <w>cinder</w> the wooden cabins.",
                            "target_lang_translations": {
                                "cs": "Zuřivý lesní požár hrozil, že dřevěné sruby <w>spálí na uhel</w>."
                            }
                        },
                        {
                            "text": "Intense heat managed to <w>cinder</w> the dry paper in seconds.",
                            "target_lang_translations": {
                                "cs": "Intenzivní žár dokázal suchý papír během několika sekund <w>proměnit v popel</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "char",
                        "incinerate"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zcela spálit nebo proměnit v popel a škváru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "spálit na uhel",
                                "target_lang_sense_clarification": "zcela sežehnout"
                            },
                            {
                                "target_lang_word": "zuhelnatět",
                                "target_lang_sense_clarification": "proměnit se v uhel"
                            },
                            {
                                "target_lang_word": "sežehnout na prach",
                                "target_lang_sense_clarification": "zničit žárem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc14696c-d45d-32a7-9aab-ae1cf5ecb354",
                    "sense_definition": "To cover, pave, or treat a surface with cinders.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_cinder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>cinder</w> the driveway to improve traction during winter.",
                            "target_lang_translations": {
                                "cs": "Rozhodli se <w>vysypat</w> příjezdovou cestu <w>škvárou</w>, aby v zimě zlepšili sjízdnost."
                            }
                        },
                        {
                            "text": "The groundskeeper began to <w>cinder</w> the muddy garden path after heavy rain.",
                            "target_lang_translations": {
                                "cs": "Správce areálu začal po vydatném dešti rozblácenou zahradní pěšinu <w>zaškvárovávat</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pokrýt, vysypat nebo zpevnit povrch škvárou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vysypat škvárou",
                                "target_lang_sense_clarification": "upravit povrch cesty"
                            },
                            {
                                "target_lang_word": "zaškvárovat",
                                "target_lang_sense_clarification": "pokrýt škvárovým povrchem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c131c54d-ec9a-3bad-a39e-867fb3e02004",
                    "sense_definition": "A female given name.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "proper_name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Her parents named her <w>Cinder</w> because they loved unusual and striking names.",
                            "target_lang_translations": {
                                "cs": "Rodiče ji pojmenovali <w>Cinder</w>, protože měli rádi neobvyklá a výrazná jména."
                            }
                        },
                        {
                            "text": "I received a cheerful postcard from <w>Cinder</w> during her holiday.",
                            "target_lang_translations": {
                                "cs": "Během její dovolené jsem od <w>Cinder</w> dostal veselý pohled."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Ženské křestní jméno."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Cinder",
                                "target_lang_sense_clarification": "ženské jméno"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3eb7a47e-d612-31d7-90cf-d716ff95025b",
                    "sense_definition": "A river located in Alaska, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "proper_name",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The team took a small boat across the <w>Cinder</w> during their survey of Alaska.",
                            "target_lang_translations": {
                                "cs": "Během průzkumu Aljašky se tým přeplavil přes řeku <w>Cinder</w> na malém člunu."
                            }
                        },
                        {
                            "text": "Wild salmon swim upstream along the cold waters of the <w>Cinder</w> each summer.",
                            "target_lang_translations": {
                                "cs": "Každé léto plují divocí lososi proti proudu studených vod řeky <w>Cinder</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Řeka nacházející se na Aljašce v USA."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Cinder",
                                "target_lang_sense_clarification": "řeka na Aljašce"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}