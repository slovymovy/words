                ],
                "senses": [
                    {
                        "sense_id": "917219e9-189c-3bf2-a117-52717558b803",
                        "entry_id": "4d2c33af-7786-30cd-a7bd-26656d5ee57c",
                        "glosses": [
                            "A former railway guide and timetable published by George Bradshaw. Publication ceased in May 1961."
                        ],
                        "tags": [
                            "British"
                        ],
                        "examples": [
                            {
                                "example_id": "7f437391-0f59-4331-af39-9981d987694b",
                                "sense_id": "917219e9-189c-3bf2-a117-52717558b803",
                                "text": "He was at breakfast at nine, and for the twentieth time consulted his Bradshaw to see at what earliest hour Dr Grantly could arrive from Barchester."
                            },
                            {
                                "example_id": "a996a84c-9771-41aa-8d6f-d0d281812c58",
                                "sense_id": "917219e9-189c-3bf2-a117-52717558b803",
                                "text": "The \"5th Mo. (May) 1939\" issue of Bradshaw's Railway Shipping, and Hotel Guide for Great Britain and Ireland appears in a cream cover printed in blue and gold, and a prefatory note explains that, as 1939 is being celebrated as the centenary year of Bradshaw, it is intended to adopt this livery from now until the September issue inclusive. For October, the centenary month, Bradshaw will be published in a gold cover printed in red and blue."
                            }
                        ]
                    }
