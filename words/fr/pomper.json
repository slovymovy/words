                    "sense_definition": "Absorber les ressources ou l'énergie de quelqu'un jusqu'à l'épuisement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "absorption",
                    "name_type": "no",
                    "examples": [
