                        "glosses": [
                            "автомоб. легковой автомобиль с однообъёмным кузовом и бескапотной (реже — вагонной) или полутораобъёмной компоновкой, обычно — с тремя рядами сидений"
                        ],
                        "tags": [],
                        "examples": [
                            {
