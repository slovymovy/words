                                                "example_id": "5dc2b115-d67b-416b-8f12-b24fceee6db0",
                                                "sense_id": "0090d513-e7b8-32f0-a061-9c8a87e38e8c",
                                                "text": "Maududi was born in 1903 at Aurangabad in Hyderabad, India, into a family with a long religious tradition."
                                            }
