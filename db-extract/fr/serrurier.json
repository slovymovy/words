                        ],
                        "form": "serruriers"
                    },
                    {
                        "form_id": "1e63815c-9c33-40b2-9d9d-6f89cfd6a33d",
                        "entry_id": "62b0a87e-520e-3511-9cba-0a8c095d376f",
                        "tags": [
                            "feminine"
                        ],
                        "form": "serrurière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "469ff991-b636-3fb0-856c-c3d2c0d8884a",
                        "entry_id": "62b0a87e-520e-3511-9cba-0a8c095d376f",
                        "glosses": [
                            "Celui qui fabrique des serrures et divers autres ouvrages de fer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc5b874a-357a-4a72-a651-c21424b26dff",
                                "sense_id": "469ff991-b636-3fb0-856c-c3d2c0d8884a",
                                "text": "On voit par le statut ici reproduit que les maréchaux, les férons, les serruriers et les taillandiers formaient, à Abbeville, une seule corporation industrielle et une même confrérie religieuse sous l’invocation de saint Eloy ; […]."
                            },
                            {
                                "example_id": "fb47b6eb-18b5-478b-91ce-942e845f00af",
                                "sense_id": "469ff991-b636-3fb0-856c-c3d2c0d8884a",
                                "text": "Un serrurier fut requis, et on monta au premier étage.\nAprès quelques difficultés, le pêne joua dans la serrure ; mais la porte me s’ouvrit pas.\n— Fermée en dedans, dit l’inspecteur, bien !"
                            }
                        ]
                    },
                    {
                        "sense_id": "b0a38b16-7564-35d5-acf5-680cb03c46f9",
                        "entry_id": "62b0a87e-520e-3511-9cba-0a8c095d376f",
                        "glosses": [
                            "Surnom de la mésange charbonnière."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "16c7a021-0d87-4cba-8c54-194b23d44eed",
                                "sense_id": "b0a38b16-7564-35d5-acf5-680cb03c46f9",
                                "text": "Le chant ordinaire du mâle, celui qu’il conserve toute l’année, et qu’il fait entendre surtout la veille des jours de pluie, ressemble au grincement d’une lime ou d’un verrou, et lui valu le nom de serrurier. Mais au printemps, il prend une autre modulation et devient si agréable et si varié, qu’on ne croirait pas qu’il vînt du même oiseau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40f55c76-0ccd-406c-8ce9-47924639dc25",
                        "source_entry_id": "62b0a87e-520e-3511-9cba-0a8c095d376f",
                        "target_lang_word": "Schlosser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlosser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c26b979-55cf-3790-b95b-8833424345dc",
                                        "entry_id": "7ee25ca8-ae66-3d4f-9a5c-f18d771c41fa",
                                        "glosses": [
                                            "Handwerker oder Industriearbeiter, der Metall und Kunststoff ver- oder bearbeitet oder Gegenstände repariert, montiert oder instand hält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9508c810-69e2-40bb-a2af-86dee0967c7d",
                                                "sense_id": "7c26b979-55cf-3790-b95b-8833424345dc",
                                                "text": "Der Industrieberuf Schlosser erfordert eine dreieinhalbjährige Ausbildungszeit."
                                            },
                                            {
                                                "example_id": "200ddd91-3c06-4a0e-b806-d6481c16e51c",
                                                "sense_id": "7c26b979-55cf-3790-b95b-8833424345dc",
                                                "text": "Schlosser ist eine allgemeine Bezeichnung für verschiedene Handwerksberufe."
                                            },
                                            {
                                                "example_id": "51e07e41-f232-463c-9417-4d1eef020462",
                                                "sense_id": "7c26b979-55cf-3790-b95b-8833424345dc",
                                                "text": "„Der Beruf des Schlossers ist seit dem 14. Jh. belegt und gehört dem Stand der Kleinschmiede an.“"
                                            },
                                            {
                                                "example_id": "4ea07431-df22-4db0-bac3-556a8f4804ee",
                                                "sense_id": "7c26b979-55cf-3790-b95b-8833424345dc",
                                                "text": "„Im Mai 1945 begann der 14-jährige Horst in Hindenburg eine Lehre als Schlosser: In der Schlosserei von Maksymilian Fiszer lernte er die harte Arbeit kennen.“"
                                            },
                                            {
                                                "example_id": "bb2c550f-d00f-4626-9688-6bb149f75bb4",
                                                "sense_id": "7c26b979-55cf-3790-b95b-8833424345dc",
                                                "text": "„Sobald ich angezogen war, ging ich ein wenig spazieren und traf den Priester mit einem Schlosser.“"
                                            },
                                            {
                                                "example_id": "4d581dff-b6b5-4ab3-aaa9-dc0fccb35921",
                                                "sense_id": "7c26b979-55cf-3790-b95b-8833424345dc",
                                                "text": "„Sie ließen einen Schlosser für die Spalierstangen, einen Klempner für die Drahtverspannungen, einen Zimmermann für die Pfähle kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schlosser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b69ce453-23c4-34a7-aec2-62232b457976",
                                        "entry_id": "c10054e7-02c3-3c27-9437-0870e81eda36",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddaa63d0-aa09-4c55-bb52-63671d55ff22",
                                                "sense_id": "b69ce453-23c4-34a7-aec2-62232b457976",
                                                "text": "Max Schlosser, der Sohn von Paul Schlosser, ist ein guter Tennisspieler und macht seinem Nachnahme wenig Ehre."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
