                        "sense_id": "521ef51b-88e6-3e26-8d44-c440a851a505",
                        "entry_id": "673b18d9-6131-3530-87fb-846e04d783e4",
                        "glosses": [
                            "over het lichaam draperen en zo passend maken"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "461d5b32-7e2d-4e57-8e16-fb079d1de1d5",
                                "sense_id": "521ef51b-88e6-3e26-8d44-c440a851a505",
                                "text": "Irausquin maakte zich de kunst van het mouleren meester, een techniek waarbij stof rechtstreeks wordt gedrapeerd op het lichaam en vervolgens op de juiste plekken met draad en naald wordt gefixeerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "972b5cdf-c908-3902-8e89-5a54a3a23746",
                        "entry_id": "673b18d9-6131-3530-87fb-846e04d783e4",
                        "glosses": [
                            "in een vorm gieten, een afgietsel maken van"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0081a326-fbde-4145-9d91-ebc256b82918",
                                "sense_id": "972b5cdf-c908-3902-8e89-5a54a3a23746",
                                "text": "Bronsgieterijen in huis waren talrijk waar men b.v. evengoed met bijenwas werkte bij het mouleren van godenbeeldjes als bij het maken van hakmessen voor groenten."
                            }
                        ]
                    }
