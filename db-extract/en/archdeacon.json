                        "form_id": "ad16ae06-a519-4f94-9190-201846e5cb71",
                        "entry_id": "74a5c8da-5012-3f68-bcda-81677ccb3762",
                        "tags": [
                            "plural"
                        ],
                        "form": "archdeacons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4063a4d5-c396-31a8-aeff-ab1ae61f2212",
                        "entry_id": "74a5c8da-5012-3f68-bcda-81677ccb3762",
                        "glosses": [
                            "A senior administrative official in a diocese, just under the bishop, often in charge of an archdeaconry. As a title, it can be filled by either a deacon or priest."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f37bedc-0c84-4c47-89e0-813708219810",
                        "source_entry_id": "74a5c8da-5012-3f68-bcda-81677ccb3762",
                        "source_sense_id": "4063a4d5-c396-31a8-aeff-ab1ae61f2212",
                        "source_sense_description": "administrative official in a diocese",
                        "target_lang_word": "archidiacre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archidiacre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12f5f715-86b2-3443-84e7-ef1cf5e7258c",
                                        "entry_id": "98f67fd5-33eb-3263-87b3-2debf73e7d68",
                                        "glosses": [
                                            "Ecclésiastique pourvu d’une dignité qui lui donne quelque sorte de juridiction sur les curés d’un diocèse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c427e4c0-37dc-4e21-b463-7c4a8179e68d",
                                                "sense_id": "12f5f715-86b2-3443-84e7-ef1cf5e7258c",
                                                "text": "Les archidiacres, ainsi que les chanoines de quelques cathédrales fort riches, telles que Tolède, Séville et Valence, avaient aussi des pages en soutane."
                                            },
                                            {
                                                "example_id": "f2d33b7c-77a0-4be2-ac5a-5c7d562ccfb0",
                                                "sense_id": "12f5f715-86b2-3443-84e7-ef1cf5e7258c",
                                                "text": "En cas d'infraction aux lois réglementaires, les bénéficiers étaient condamnés par les archidiacres à aumôner de grosses sommes à la boete des pauvres, expression souvent employée dans les ordonnances des rois de France et les arrêts du parlement."
                                            },
                                            {
                                                "example_id": "a8826d5a-e3aa-426f-8beb-068db215abbe",
                                                "sense_id": "12f5f715-86b2-3443-84e7-ef1cf5e7258c",
                                                "text": "Au dessus des doyens étaient les archidiacres, représentants des évêques pour une partie du diocèse ; souvent ceux-ci avaient des corévêques pour les remplacer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8ff4e26-0e60-4438-9030-9ad9f3800d9f",
