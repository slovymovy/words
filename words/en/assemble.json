{
    "word_family": [
        "assemblage",
        "assembler",
        "assembly",
        "reassemble"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6f5f71b6-a7d7-3ad2-a5e6-096fb97f740a",
                    "sense_definition": "To come together or gather in one place as a group.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students were told to <w>assemble</w> in the main hall for the morning announcement.",
                            "target_lang_translations": {
                                "ru": "Студентам велели <w>собраться</w> в главном зале для утреннего объявления."
                            }
                        },
                        {
                            "text": "A large crowd began to <w>assemble</w> outside the stadium hours before the concert started.",
                            "target_lang_translations": {
                                "ru": "Большая толпа начала <w>собираться</w> у стадиона за несколько часов до начала концерта."
                            }
                        }
                    ],
                    "synonyms": [
                        "gather",
                        "congregate",
                        "meet",
                        "muster",
                        "collect"
                    ],
                    "antonyms": [
                        "disperse",
                        "disband",
                        "break up",
                        "dissolve"
                    ],
                    "common_phrases": [
                        "assemble in the hall",
                        "assemble a team",
                        "crowd began to assemble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собираться или сходиться в одном месте группой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собираться",
                                "target_lang_sense_clarification": "сходиться в одном месте"
                            },
                            {
                                "target_lang_word": "собраться",
                                "target_lang_sense_clarification": "сойтись воедино (совершенный вид)"
                            },
                            {
                                "target_lang_word": "сходться",
                                "target_lang_sense_clarification": "приходить в одно место"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b963fe5-0602-3fe4-b255-fd58a1089e15",
                    "sense_definition": "To fit together the separate component parts of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "build",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took me nearly three hours to <w>assemble</w> the new bookshelf from the flat pack.",
                            "target_lang_translations": {
                                "ru": "У меня ушло почти три часа, чтобы <w>собрать</w> новый книжный шкаф из плоской упаковки."
                            }
                        },
                        {
                            "text": "The factory workers <w>assemble</w> parts quickly to keep up with the high demand for cars.",
                            "target_lang_translations": {
                                "ru": "Рабочие завода быстро <w>собирают</w> детали, чтобы не отставать от высокого спроса на автомобили."
                            }
                        }
                    ],
                    "synonyms": [
                        "construct",
                        "build",
                        "put together"
                    ],
                    "common_phrases": [
                        "assemble the parts",
                        "easy to assemble",
                        "assemble a model"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединять отдельные части чего-либо в единое целое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собирать",
                                "target_lang_sense_clarification": "из отдельных частей"
                            },
                            {
                                "target_lang_word": "собрать",
                                "target_lang_sense_clarification": "завершить сборку"
                            },
                            {
                                "target_lang_word": "монтировать",
                                "target_lang_sense_clarification": "устанавливать оборудование или конструкции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74326290-e775-34a9-8352-23d3f485a4c8",
                    "sense_definition": "To translate instructions from assembly language into machine code that a computer can execute.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer had to <w>assemble</w> the source code before it could run on the legacy hardware.",
                            "target_lang_translations": {
                                "ru": "Разработчику пришлось <w>ассемблировать</w> исходный код, прежде чем его можно было запустить на устаревшем оборудовании."
                            }
                        },
                        {
                            "text": "Modern compilers often <w>assemble</w> code automatically without the programmer needing to intervene.",
                            "target_lang_translations": {
                                "ru": "Современные компиляторы часто <w>ассемблируют</w> код автоматически, без необходимости вмешательства программиста."
                            }
                        }
                    ],
                    "common_phrases": [
                        "assemble the code",
                        "assemble into machine language"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переводить инструкции с языка ассемблера в машинный код, понятный компьютеру."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ассемблировать",
                                "target_lang_sense_clarification": "транслировать код"
                            },
                            {
                                "target_lang_word": "компилировать",
                                "target_lang_sense_clarification": "преобразовывать исходный код"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}