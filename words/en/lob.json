{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6f9d0064-32e2-3143-b346-4459bd6d1097",
                    "sense_definition": "To throw or hit a ball into the air in a high arc.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ball_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tennis player decided to <w>lob</w> the ball over her opponent's head.",
                            "target_lang_translations": {
                                "zh": "那位网球选手决定打个<w>挑高球</w>，把球挑过对手头顶。"
                            }
                        },
                        {
                            "text": "The defender tried to <w>lob</w> a pass across the court, but it was intercepted.",
                            "target_lang_translations": {
                                "zh": "防守球员试图全场<w>吊传</w>，但球被中途拦截了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "toss"
                    ],
                    "common_phrases": [
                        "lob the ball"
                    ],
                    "target_lang_definitions": {
                        "zh": "（在球类运动中）把球击或掷成高弧线，打高吊球"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "打高吊球",
                                "target_lang_sense_clarification": "网球等球类"
                            },
                            {
                                "target_lang_word": "吊",
                                "target_lang_sense_clarification": "使球呈高弧度飞出"
                            },
                            {
                                "target_lang_word": "挑高球",
                                "target_lang_sense_clarification": "高弧线挑球"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1831160f-ef4e-36d1-8454-aa2c6b016053",
                    "sense_definition": "To hit, kick, or throw a ball over another player in a game.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ball_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker managed to <w>lob</w> the goalkeeper from outside the penalty area.",
                            "target_lang_translations": {
                                "zh": "前锋在禁区外成功将球<w>挑过</w>了门将头顶。"
                            }
                        },
                        {
                            "text": "He saw the opponent rushing forward and tried to <w>lob</w> him neatly.",
                            "target_lang_translations": {
                                "zh": "他看到对手猛冲上来，便试图利落地从头顶<w>吊过</w>他。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lob the keeper",
                        "lob the goalkeeper"
                    ],
                    "target_lang_definitions": {
                        "zh": "（在比赛中将球）越过对方球员头顶击出、踢出或投出（尤指吊射或吊过）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "吊过",
                                "target_lang_sense_clarification": "高弧度越过球员"
                            },
                            {
                                "target_lang_word": "挑过",
                                "target_lang_sense_clarification": "越过对手头顶"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79757c86-2adf-326b-9ec4-e73a8e3e2a28",
                    "sense_definition": "To throw something casually or forcefully.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "throw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>lobbed</w> his coat carelessly onto the armchair as soon as he got home.",
                            "target_lang_translations": {
                                "zh": "他一回到家就随手把外套<w>扔</w>在扶手椅上。"
                            }
                        },
                        {
                            "text": "Protesters began to <w>lob</w> stones at the police barricade.",
                            "target_lang_translations": {
                                "zh": "抗议者开始朝警方的路障<w>掷</w>石块。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fling",
                        "hurl",
                        "throw",
                        "toss",
                        "chuck"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "随意或用力扔、掷、抛"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扔",
                                "target_lang_sense_clarification": "随手或用力投掷"
                            },
                            {
                                "target_lang_word": "抛",
                                "target_lang_sense_clarification": "向上或向前扔出"
                            },
                            {
                                "target_lang_word": "掷",
                                "target_lang_sense_clarification": "用力投掷"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e64b947d-75a6-3c62-8008-27693ef33bea",
                    "sense_definition": "To put or place something carelessly or casually.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Just <w>lob</w> the vegetables in the pot and let them simmer for an hour.",
                            "target_lang_translations": {
                                "zh": "只要把蔬菜<w>扔</w>进锅里，炖上一个小时就行。"
                            }
                        },
                        {
                            "text": "She <w>lobbed</w> her keys onto the kitchen counter.",
                            "target_lang_translations": {
                                "zh": "她把钥匙随手<w>丢</w>在厨房台面上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lay",
                        "deposit"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "随手放置，漫不经心地放入或丢下"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "丢",
                                "target_lang_sense_clarification": "随手一丢"
                            },
                            {
                                "target_lang_word": "扔",
                                "target_lang_sense_clarification": "随意放置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d01fd8e8-81e7-3bb4-a2c4-c81f57dd058d",
                    "sense_definition": "To arrive at or reach a place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We finally <w>lobbed</w> at the venue just minutes before the concert began.",
                            "target_lang_translations": {
                                "zh": "音乐会开始前几分钟，我们终于<w>赶到</w>了现场。"
                            }
                        },
                        {
                            "text": "They <w>lobbed</w> into town after driving through the night.",
                            "target_lang_translations": {
                                "zh": "他们开了一整夜的车，终于<w>到达</w>了镇上。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly Australian and New Zealand"
                        },
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（澳、新俚语）到达，抵达"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "到达",
                                "target_lang_sense_clarification": "抵达某地"
                            },
                            {
                                "target_lang_word": "赶到",
                                "target_lang_sense_clarification": "来到某处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d89e0dd-c281-3fea-8655-50930e0b8b6f",
                    "sense_definition": "To hang down loosely or droop heavily.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exhausted horses <w>lobbed</w> their heavy heads toward the dusty ground.",
                            "target_lang_translations": {
                                "zh": "筋疲力尽的马儿朝尘土飞扬的地面<w>耷拉</w>着沉重的脑袋。"
                            }
                        },
                        {
                            "text": "Under the scorching sun, the tired pack animals <w>lob</w> their ears.",
                            "target_lang_translations": {
                                "zh": "在烈日下，疲惫的驮兽<w>耷拉</w>着耳朵。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "沉重地下垂或松弛地耷拉"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "耷拉",
                                "target_lang_sense_clarification": "沉重松弛地下垂"
                            },
                            {
                                "target_lang_word": "下垂",
                                "target_lang_sense_clarification": "垂挂下来"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "af33bb1d-e1e3-3269-b44c-362fc2f2e15c",
                    "sense_definition": "A stroke, kick, or throw that travels high into the air in an arc.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her clever <w>lob</w> caught the advancing defender completely off guard.",
                            "target_lang_translations": {
                                "zh": "她巧妙的<w>高吊球</w>让迎面冲来的防守队员措手不及。"
                            }
                        },
                        {
                            "text": "The goalkeeper was beaten by a stunning <w>lob</w> from distance.",
                            "target_lang_translations": {
                                "zh": "守门员被一记精彩的远距离<w>吊射</w>攻破了球门。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "desperate lob",
                        "clever lob"
                    ],
                    "target_lang_definitions": {
                        "zh": "高弧度的球；高吊球"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "高吊球",
                                "target_lang_sense_clarification": "弧线高的击球或传球"
                            },
                            {
                                "target_lang_word": "挑高球",
                                "target_lang_sense_clarification": "高球"
                            },
                            {
                                "target_lang_word": "吊射",
                                "target_lang_sense_clarification": "足球等项目的高吊射门"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ca8b674-1ce5-34a2-b723-c721fcf79247",
                    "sense_definition": "A women's haircut consisting of a long bob, typically falling just above the shoulders.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to cut her hair into a stylish <w>lob</w> for the summer.",
                            "target_lang_translations": {
                                "zh": "她决定在这个夏天剪一个时髦的<w>长波波头</w>。"
                            }
                        },
                        {
                            "text": "A textured <w>lob</w> is very versatile and easy to maintain.",
                            "target_lang_translations": {
                                "zh": "富有层次感的<w>锁骨发</w>百搭且容易打理。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "长鲍伯发型（长度及肩或稍过肩膀的女式发型）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "长波波头",
                                "target_lang_sense_clarification": "及肩发型"
                            },
                            {
                                "target_lang_word": "锁骨发",
                                "target_lang_sense_clarification": "流行长波波发型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca2df59e-9e66-363d-9d57-ed8d25920f7c",
                    "sense_definition": "A lump or thick mass of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He discovered a heavy <w>lob</w> of clay stuck beneath his boot.",
                            "target_lang_translations": {
                                "zh": "他发现鞋底粘着一大<w>团</w>沉甸甸的黏土。"
                            }
                        },
                        {
                            "text": "There was a solid <w>lob</w> of gold hidden in the old wooden chest.",
                            "target_lang_translations": {
                                "zh": "旧木箱里藏着一整<w>块</w>实心黄金。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一块，厚块，大团"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "团",
                                "target_lang_sense_clarification": "厚重的块状物"
                            },
                            {
                                "target_lang_word": "大块",
                                "target_lang_sense_clarification": "厚实的大块"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5573454d-2416-3a96-a643-5ebbce00e5a2",
                    "sense_definition": "A rustic, unsophisticated country person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person_disparaging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city dwellers mocked him, calling him an ignorant country <w>lob</w>.",
                            "target_lang_translations": {
                                "zh": "城里人嘲笑他，骂他是个无知的乡巴佬。"
                            }
                        },
                        {
                            "text": "He was portrayed on stage as an awkward <w>lob</w> from the rural provinces.",
                            "target_lang_translations": {
                                "zh": "在舞台上，他被刻画成一个来自偏远乡下的笨拙<w>粗汉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "country bumpkin",
                        "yokel",
                        "boor",
                        "churl",
                        "clodhopper",
                        "hayseed",
                        "hick",
                        "rube",
                        "rustic"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古旧）粗鄙的乡巴佬，愚笨的乡下人"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "乡巴佬",
                                "target_lang_sense_clarification": "粗野愚钝的乡下人"
                            },
                            {
                                "target_lang_word": "粗汉",
                                "target_lang_sense_clarification": "举止粗俗的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9048cfb-bc16-345f-8f9a-dad35e0ed631",
                    "sense_definition": "An awkward, heavy, or clumsy person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person_disparaging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The big <w>lob</w> stumbled over his own feet and knocked the table over.",
                            "target_lang_translations": {
                                "zh": "那个大块头<w>笨汉</w>自己绊了自己一下，把桌子撞翻了。"
                            }
                        },
                        {
                            "text": "Nobody expected such an uncoordinated <w>lob</w> to dance so well.",
                            "target_lang_translations": {
                                "zh": "谁也没料到这么一个笨手笨脚的<w>笨家伙</w>能跳得这么好。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古旧）笨拙笨重的人"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "笨家伙",
                                "target_lang_sense_clarification": "笨拙笨重的人"
                            },
                            {
                                "target_lang_word": "笨汉",
                                "target_lang_sense_clarification": "动作不协调的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a52992d3-aae4-30d3-a778-0e6cdee7eedb",
                    "sense_definition": "A competitor who finishes last in a race.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Exhausted and out of breath, the slow runner crossed the line as the <w>lob</w>.",
                            "target_lang_translations": {
                                "zh": "那名跑得慢的选手筋疲力尽、上气不接下气，作为<w>最后一名</w>冲过了终点线。"
                            }
                        },
                        {
                            "text": "He trained hard for weeks to avoid being the <w>lob</w> in the annual marathon.",
                            "target_lang_translations": {
                                "zh": "为了不在一年一度的马拉松赛里成为<w>垫底者</w>，他刻苦训练了好几个星期。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（竞赛中跑在）最后一名的人，垫底者"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "最后一名",
                                "target_lang_sense_clarification": "比赛垫底的人"
                            },
                            {
                                "target_lang_word": "垫底者",
                                "target_lang_sense_clarification": "赛跑最后者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "111c126b-935c-342b-9848-1d2270196a8d",
                    "sense_definition": "A large earthworm used as fishing bait; a <w>lobworm</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman baited his hook with a fat <w>lob</w> from the garden.",
                            "target_lang_translations": {
                                "zh": "钓鱼人把从花园里挖来的肥大<w>大蚯蚓</w>挂在鱼钩上当饵。"
                            }
                        },
                        {
                            "text": "He searched through the damp soil hoping to find a lively <w>lob</w>.",
                            "target_lang_translations": {
                                "zh": "他在潮湿的泥土里翻找，希望能找到一条活蹦乱跳的<w>大蚯蚓</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（用作钓饵的）大蚯蚓"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大蚯蚓",
                                "target_lang_sense_clarification": "钓鱼用的大型蚯蚓"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e39588fb-858e-3ea2-9c92-070a0a7980c8",
                    "sense_definition": "A European pollock (Pollachius pollachius), a marine fish of the cod family.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local anglers caught a large <w>lob</w> off the rocky coast.",
                            "target_lang_translations": {
                                "zh": "当地垂钓者在岩石海岸附近钓到了一条大<w>青鳕</w>。"
                            }
                        },
                        {
                            "text": "Fresh <w>lob</w> was sold alongside cod at the morning harbor market.",
                            "target_lang_translations": {
                                "zh": "在清晨的海港市场上，新鲜的<w>青鳕</w>与大西洋鳕鱼摆在一起售卖。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "青鳕，绿鳕（欧洲近海的一种鳕科鱼类）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "青鳕",
                                "target_lang_sense_clarification": "鳕科海鱼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "009e91d0-39d5-3c0c-a96b-3b992e7d730e",
                    "sense_definition": "A historic con game where a fraudster secretly pockets coins while asking for change and claims to be shortchanged.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief was known across London for practicing the <w>lob</w> on naive shopkeepers.",
                            "target_lang_translations": {
                                "zh": "那个小偷因对天真的店主使出<w>换零钱骗术</w>而在全伦敦闻名。"
                            }
                        },
