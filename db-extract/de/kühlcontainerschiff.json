                    {
                        "sense_id": "d1b53103-fa49-3691-ac83-2d90c08c208e",
                        "entry_id": "40a2c352-f06b-3c10-ba23-483479b658c7",
                        "glosses": [
                            "Schiff, dessen Hauptaufgabe der Transport von Kühlcontainern ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc52b612-6205-4785-a433-b6e7f633bba7",
                                "sense_id": "d1b53103-fa49-3691-ac83-2d90c08c208e",
                                "text": "„Heute dominieren Kühlcontainer bzw. Kühlcontainerschiffe sowie Tankcontainer für flüssige oder gasförmige Produkte.“"
                            },
                            {
                                "example_id": "ea7278bb-7004-4a55-b618-9c89ec04f202",
                                "sense_id": "d1b53103-fa49-3691-ac83-2d90c08c208e",
                                "text": "„Die \"Botany\" ist eines der weltgrößten Kühlcontainerschiffe.“"
                            },
                            {
                                "example_id": "e3e5cc38-a3ae-491c-89c1-465fc7fe9b48",
                                "sense_id": "d1b53103-fa49-3691-ac83-2d90c08c208e",
                                "text": "„Einen besonders hohen Strombedarf auch während der Hafenliegezeit haben Kreuzfahrtschiffe und Kühlcontainerschiffe.“"
                            },
                            {
                                "example_id": "6ba2ac86-5aae-4e28-9a51-4f03cef8f73d",
                                "sense_id": "d1b53103-fa49-3691-ac83-2d90c08c208e",
                                "text": "„Eines der weltgrößten Kühlcontainerschiffe ist am Sonntag bei der HHLA am Burchardkai getauft worden.“"
                            },
                            {
                                "example_id": "7f0f72d5-ccf3-472d-9099-c4086d01ba99",
                                "sense_id": "d1b53103-fa49-3691-ac83-2d90c08c208e",
                                "text": "„Das 204 Meter lange und 32 Meter breite Kühlcontainerschiff \"Dole Chile\" transportiert Bananen von Costa Rica an die Ostküste der USA.“"
                            }
                        ],
