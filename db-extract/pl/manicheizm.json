                                        "glosses": [
                                            "Religión, de doctrina dualista, fundada por el sabio persa Mani (o Manes) (c. 215-276)."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b44449d2-f037-3cba-8844-ed590fee8e7e",
                                        "entry_id": "81ca1df0-78d4-3801-b633-49ed22062856",
                                        "glosses": [
                                            "Actitud de ver el mundo de manera dicotómica (bueno/malo, bello/feo, amigo/enemigo), sin admitir valoraciones intermedias."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdb02eee-7b3d-4681-a8dd-e79e59fe6068",
                                                "sense_id": "b44449d2-f037-3cba-8844-ed590fee8e7e",
                                                "text": "Lamentablemente, en la política es muy común el maniqueísmo."
                                            },
                                            {
                                                "example_id": "4fd9e29a-c0ad-4dec-9d05-e89126790469",
                                                "sense_id": "b44449d2-f037-3cba-8844-ed590fee8e7e",
                                                "text": "Estás cayendo en el maniqueísmo ¡La realidad es más compleja que un mero blanco o negro!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5d68205-f1dc-4970-b533-15e9416f7e60",
                        "source_entry_id": "2c8957e5-34b1-33cc-840d-88cd7df2e683",
                        "source_sense_id": "50ed08ff-270e-35db-9cae-da251291c53e",
                        "target_lang_word": "Manichäismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Manichäismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53e37018-be25-3400-937a-baeae21f2921",
                                        "entry_id": "081d5fbf-7001-3e73-83d3-8063a8a4d939",
                                        "glosses": [
                                            "dualistisch-gnostische Religion der Spätantike und des frühen Mittelalters, die von den Menschen Askese und Reinheit verlangt, um zur Erlösung zu gelangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b80590a7-f749-4ee6-8cea-382b05ed8891",
                                                "sense_id": "53e37018-be25-3400-937a-baeae21f2921",
                                                "text": "„Als zweite große Wurzel … ist das Geistesprinzip des inneren Lichtes anzusehn, das aus Persien stammte und im Manichäismus eine gewaltige Erneuerung und Verchristlichung erfuhr. Dieser Manichäismus … sieht Welt und Mensch als Schauplatz eines gigantischen Kampfes zwischen Gut und Böse, zwischen den Mächten des Lichtes und denen der Finsternis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "861e0698-592b-4d19-b859-540649479a8e",
                        "source_entry_id": "2c8957e5-34b1-33cc-840d-88cd7df2e683",
                        "source_sense_id": "50ed08ff-270e-35db-9cae-da251291c53e",
