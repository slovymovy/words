                    {
                        "sense_id": "699f4846-7ab3-3942-a395-363a749dfb95",
                        "entry_id": "aa8c0bc4-3649-3ebf-8963-7b854d3c7c5d",
                        "glosses": [
                            "Qui vit ou qui pousse dans ou sur les rochers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dec0d54-97c9-4d58-ac3a-dc0be6b317f0",
                                "sense_id": "699f4846-7ab3-3942-a395-363a749dfb95",
                                "text": "Un lichen saxicole pousse sur un support minéral, roche ou béton."
                            },
                            {
                                "example_id": "1242af46-9a90-4e65-bc79-23abe267e259",
                                "sense_id": "699f4846-7ab3-3942-a395-363a749dfb95",
                                "text": "Diguet, auteur d’une très bonne monographie sur les cactées du Mexique, nous indique les tenochtli comme étant des cactées saxicoles, sauvageons, aux fruits relativement durs et peu digestes, l’Opuntia tapona."
                            }
                        ]
                    }
                ],
