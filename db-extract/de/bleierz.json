                ],
                "senses": [
                    {
                        "sense_id": "16196d5e-af8d-31d0-b311-898e443b55e8",
                        "entry_id": "1482d832-90c2-31c8-a7a5-14509200117b",
                        "glosses": [
                            "Gestein, aus dem Blei gewonnen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc7dbfec-c9ec-4c6b-95e2-7305a0940389",
                                "sense_id": "16196d5e-af8d-31d0-b311-898e443b55e8",
                                "text": "„15 Prozent der Kinder in dem ehemaligen Abbaugebiet von Bleierz haben immer noch leicht höhere Bleiwerte im Blut als andere Kinder in Deutschland.“"
                            },
                            {
                                "example_id": "2be507f2-87c0-4a2d-8c73-f1768da4d0d6",
                                "sense_id": "16196d5e-af8d-31d0-b311-898e443b55e8",
                                "text": "„Früher wurde hier Bleierz abgebaut, mittlerweile ist das Bergwerk ein Besuchermagnet.“"
                            },
                            {
                                "example_id": "ef49b20c-9ec4-40fc-8f14-b8c5630fc656",
                                "sense_id": "16196d5e-af8d-31d0-b311-898e443b55e8",
                                "text": "„So gab es teilweise bis ins 19. Jahrhundert in Helmeroth etwa 20 Bergwerke und Gruben, aus denen Silbererz, Bleierz und Eisenerz gewonnen wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
