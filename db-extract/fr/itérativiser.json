                "senses": [
                    {
                        "sense_id": "fcc52aac-fc0b-3d27-b053-33beea997902",
                        "entry_id": "8efb5a6e-5864-3c7c-a8b3-daa598f9b224",
                        "glosses": [
                            "Donner un caractère itératif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "775f2ebd-ac3b-43dc-ab32-45d5e1a72ca6",
                                "sense_id": "fcc52aac-fc0b-3d27-b053-33beea997902",
                                "text": "Il ne reste plus au narrateur qu’à traiter cet élément du rituel sabbatique comme les autres, c’est-à-dire sur le mode itératif, pour itérativiser (si j’ose dire) à son tour l’événement déviant, selon ce processus irrésistible : événement singulier — narration répétitive — récit itératif (de cette narration)."
                            },
                            {
                                "example_id": "2f9bc908-aa74-4891-8948-e393e3e9f560",
                                "sense_id": "fcc52aac-fc0b-3d27-b053-33beea997902",
                                "text": "Le truc, c'est que les récursives terminales sont faciles à \"itérativiser\"..."
                            }
                        ]
                    }
