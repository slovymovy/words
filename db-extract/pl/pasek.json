                ],
                "senses": [
                    {
                        "sense_id": "1aa48d5c-3fc5-3901-8cc3-d21115bcfca7",
                        "entry_id": "6e4f3f7f-c442-33ae-99fa-e6f509779832",
                        "glosses": [
                            "lekki i wąski pas na biodrach lub w talii noszony w celach ozdobnych lub dla przytrzymania odzieży, także do noszenia zegarka, bagażu itp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "578ddfee-a28a-4e86-a130-f8f00e101b54",
                                "sense_id": "1aa48d5c-3fc5-3901-8cc3-d21115bcfca7",
                                "text": "Wiosenną porą ubranie jego składa się z dziwnie długiej zgrzebnej koszuli, pod szyją na czerwoną wstążeczkę związanej i przepasanej paskiem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e9baf1f7-8b88-33bd-8d2d-344797ded8da",
                        "entry_id": "6e4f3f7f-c442-33ae-99fa-e6f509779832",
                        "glosses": [
                            "jedna z naszywek na elementach munduru służąca do określania rangi"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "6d4f63d9-cbab-3e4c-bb83-07df289ce5bf",
                        "entry_id": "6e4f3f7f-c442-33ae-99fa-e6f509779832",
                        "glosses": [
                            "taśma używana do mocowania, łączenia czegoś"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "579e8a16-0766-39c0-a660-658a55ec8829",
                        "entry_id": "6e4f3f7f-c442-33ae-99fa-e6f509779832",
                        "glosses": [
                            "pas będący wąskim wycinkiem powierzchni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6c87d42-6f58-4b8c-8ef2-66dd0c2734e7",
                                "sense_id": "579e8a16-0766-39c0-a660-658a55ec8829",
                                "text": "Błoto było czarniejsze i płynniejsze, trotuary zmieniały się przed każdym prawie domem, raz były szerokie z kamienia, to biegły wąskim wydeptanym paskiem betonu, albo szło się wprost po drobniutkim zabłoconym bruku, który kłuł przez podeszwy."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
