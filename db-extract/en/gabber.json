                    {
                        "sense_id": "8eb270b8-bce8-3d8b-b97a-52420d995e45",
                        "entry_id": "7fba0662-27c4-38a4-842b-09c1a957c579",
                        "glosses": [
                            "A subgenre of hardcore techno characterised by an intense, distorted kick sound and controversial lyrics or samples."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4cf34cd1-b1e4-47fc-bc07-cb728272004c",
                                "sense_id": "8eb270b8-bce8-3d8b-b97a-52420d995e45",
                                "text": "This, in turn, birthed all kinds of mainly regional variations that have lasted from the 90s to today, most notably gabber—a relentless mix of superfast BPMS, distorted kickdrums and roared vocals that evoked the distilled nihilism of Rotterdam skinheads."
                            }
                        ]
                    },
                    {
                        "sense_id": "42f89f8e-1aee-3572-a1bf-b3a1dc00d931",
                        "entry_id": "7fba0662-27c4-38a4-842b-09c1a957c579",
                        "glosses": [
                            "A fan of this music, usually dressed in a tracksuit, often with a completely shaved head (or partially for women), seen primarily in the 1990s."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
