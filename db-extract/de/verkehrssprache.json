                        "source_sense_id": "a466d1f3-3c28-3b9e-93e9-11c801acf966",
                        "source_sense_description": "Linguistik: Sprache, die der Verständigung zwischen Sprechern verschiedener Muttersprachen dient",
                        "target_lang_word": "lingua franca",
