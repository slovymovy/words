                    {
                        "translation_id": "b20f5056-0499-4534-b62c-75e61f691f9b",
                        "source_entry_id": "1bb80299-25d6-3dbc-bf73-8ff858fb8602",
                        "source_sense_id": "2d779c9b-3f7f-3dd0-a32f-300d4413c238",
