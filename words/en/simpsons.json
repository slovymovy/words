                                "target_lang_sense_clarification": "название мультсериала"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0c18296-9dc4-369f-86a3-a03593abf3ef",
                    "sense_definition": "The plural form of the surname <w>Simpson</w>, typically referring to members of a family with that name.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "family_names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Simpsons</w> are our new neighbors who just moved in next door.",
                            "target_lang_translations": {
                                "ru": "<w>Симпсоны</w> — наши новые соседи, которые только что въехали в дом по соседству."
                            }
                        },
                        {
                            "text": "We are going to visit the <w>Simpsons</w> for a holiday dinner this year.",
                            "target_lang_translations": {
                                "ru": "В этом году мы собираемся навестить <w>Симпсонов</w> на праздничный ужин."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the Simpsons family",
                        "visit the Simpsons"
                    ],
                    "traits": [
                        {
