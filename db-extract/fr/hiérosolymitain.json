                                        "glosses": [
                                            "A native or resident of Jerusalem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75c46e88-687a-4841-b173-e0805dd136c8",
                                                "sense_id": "a0c40db8-a8d0-38fc-97a8-5c9bd194ec26",
                                                "text": "I say this because, according to the old Jerusalemites, the building blocks of the world and its inhabitants were formed of the alphabet at the back of God's tongue when He pronounced the world […]."
                                            },
                                            {
                                                "example_id": "04a0b343-238b-4d14-ba9b-474efdb70eb2",
                                                "sense_id": "a0c40db8-a8d0-38fc-97a8-5c9bd194ec26",
                                                "text": "Thousands of Jerusalemites gathered on the battl4ements to gawp at this show, admiring 'the beauty of their armour and admirable order of the men.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ee6ae19-f8e2-371b-aa35-da9be3930420",
                                        "entry_id": "4a8f337e-7e5b-3724-a6b1-36aaf6675540",
                                        "glosses": [
                                            "A residual mineral of the sands of Jerusalem, as with Trinitite."
                                        ],
                                        "tags": [],
