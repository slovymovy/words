                "senses": [
                    {
                        "sense_id": "6e9329a0-5dbf-3dd4-b212-a7a5092ee111",
                        "entry_id": "d6fd0a76-5adc-35dc-87de-7ae5a9bf0fbd",
                        "glosses": [
                            "weibliche Person, die sich erwerbsmäßig mit dem Halten und Züchten von Schafen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95d1243d-895d-4800-bf53-fb25c5bb3a9b",
                                "sense_id": "6e9329a0-5dbf-3dd4-b212-a7a5092ee111",
                                "text": "Die Schäferin hütet mit Hilfe ihrer Hunde die Schafe."
                            },
                            {
                                "example_id": "2b87988a-5816-4636-a354-27659cb39f27",
                                "sense_id": "6e9329a0-5dbf-3dd4-b212-a7a5092ee111",
                                "text": "„An der Wand geradeaus sah man eine Wärmpfanne über zwei Feuerböcken sowie eine Kaminplatte mit der Darstellung eines Mönchs, der mit einer Schäferin kost.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
