                ],
                "senses": [
                    {
                        "sense_id": "a403a29f-1c81-364c-a345-95453e641ac5",
                        "entry_id": "98ba8c55-bc95-357e-8162-5c57c1fdd089",
                        "glosses": [
                            "Atom des chemischen Elementes Kohlenstoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b638878e-5ad1-4284-8a8d-65e6bb215f16",
                                "sense_id": "a403a29f-1c81-364c-a345-95453e641ac5",
                                "text": "\"Aufgrund seiner besonderen Elektronenkonfiguration (halbgefüllte L-Schale) besitzt das Kohlenstoffatom die Fähigkeit zur Bildung von komplexen Molekülen und weist von allen chemischen Elementen die größte Vielfalt an chemischen Verbindungen auf. Kohlenstoffverbindungen bilden die molekulare Grundlage allen irdischen Lebens.\""
                            },
                            {
                                "example_id": "2de62d56-dfde-4b9c-9a05-bef75671bd15",
                                "sense_id": "a403a29f-1c81-364c-a345-95453e641ac5",
                                "text": "\"Die sp³-kovalent tetragonal gebundenen Kohlenstoffatome des Diamanten besitzen keine freien Elektronen. Das Material ist ein Isolator mit einer Bandlücke von 5,45 eV, der sichtbares Licht nicht absorbiert.\""
                            },
                            {
                                "example_id": "91cc2e47-a4e9-48db-823a-f60a2684ebcf",
                                "sense_id": "a403a29f-1c81-364c-a345-95453e641ac5",
                                "text": "„Für ihr Experiment schickten die Forscher einen Strahl elektrisch einfach geladener Kohlenstoffatome (C+-Ionen) in den Röntgenstrahl von PETRA III.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
