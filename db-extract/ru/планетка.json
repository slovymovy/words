                            {
                                "example_id": "cb389b5b-510d-4c4a-804e-a1b5c45f3960",
                                "sense_id": "766d3950-1cba-3250-97a7-6c33526a1a04",
                                "text": "Любопытная планетка этот Меркурий."
                            },
                            {
                                "example_id": "6997ecbe-0c51-41ef-a588-1ba1f0be8304",
                                "sense_id": "766d3950-1cba-3250-97a7-6c33526a1a04",
                                "text": "А маленькая планетка, или спутник, вращающаяся вокруг Голубой планеты, вероятно, вызывает своим притяжением такие волны в ваших морях, которые легко использовать как движущую силу."
                            }
                        ]
