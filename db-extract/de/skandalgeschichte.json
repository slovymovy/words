                "senses": [
                    {
                        "sense_id": "baeec576-8028-3b68-9d33-ea4d47cc8ff9",
                        "entry_id": "f9724edf-272e-38de-9836-3f3724a1ad27",
                        "glosses": [
                            "Erzählung, in der es wesentlich um einen Skandal/Skandale geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "077a31db-0f69-449b-9d08-02f5ea255efb",
                                "sense_id": "baeec576-8028-3b68-9d33-ea4d47cc8ff9",
                                "text": "„Jahrhunderte lebten von tolldreisten Liebschafts- und Skandalgeschichten, die es mit jedem lüsternen Dorfklatsch aufnehmen.“"
                            },
                            {
                                "example_id": "122c691f-f67c-4eb6-aec4-9972b0ce4a55",
                                "sense_id": "baeec576-8028-3b68-9d33-ea4d47cc8ff9",
                                "text": "„Auch Dühren muß zugeben, daß er über das Kloster Panthémont nur eine einzige Skandalgeschichte auffinden konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
