                ],
                "senses": [
                    {
                        "sense_id": "4bb2570a-6fbf-307d-bd3e-e20dc25cec6d",
                        "entry_id": "3a6586a3-bf67-372a-8b9e-ffa3b7e643e5",
                        "glosses": [
                            "(männliche^☆) Person, die eine oder mehrere Gewerkschaften bei Tarifverhandlungen und nach außen vertritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "197e07fb-8e83-44e7-88be-6f494e37b1eb",
                                "sense_id": "4bb2570a-6fbf-307d-bd3e-e20dc25cec6d",
                                "text": "„Zentrum der Demonstrationen in Seoul ist der Platz vor der Myongdong-Kathedrale, wo sich weiterhin jene Gewerkschaftsführer der illegalen KCTU verschanzt halten, gegen die vergangene Woche Haftbefehle erlassen worden waren.“"
                            },
                            {
                                "example_id": "7e210d98-3854-42d2-a178-5997b71b2f90",
                                "sense_id": "4bb2570a-6fbf-307d-bd3e-e20dc25cec6d",
                                "text": "„Genauer gesagt, eine Betonstele, die von heute an auf dem Grünstreifen zwischen Legien- und Leuschnerdamm nahe des Oranienplatzes an den ermordeten Gewerkschaftsführer Wilhelm Leuschner (1890–1944) erinnern wird.“"
                            },
                            {
                                "example_id": "5959b2bf-638f-49a3-b34d-4e4a9b08f289",
                                "sense_id": "4bb2570a-6fbf-307d-bd3e-e20dc25cec6d",
                                "text": "„Nach einem Treffen mit Regierungsvertretern teilten gestern Abend Gewerkschaftsführer mit, dass es am nächsten Dienstag zu landesweiten Arbeitsniederlegungen kommen werde.“"
                            },
                            {
                                "example_id": "069f4806-c6a5-4054-b3b4-ec3d9ce412cb",
                                "sense_id": "4bb2570a-6fbf-307d-bd3e-e20dc25cec6d",
                                "text": "„Oft weilte Gewerkschaftsführer Nikolaus Groß, später von den Nazis ermordet, in Herdorf, dessen Namen das Jugendheim trägt.“"
                            },
                            {
                                "example_id": "db527e78-93be-4054-a15c-4b0558e2fc78",
                                "sense_id": "4bb2570a-6fbf-307d-bd3e-e20dc25cec6d",
                                "text": "„Der Gewerkschaftsführer und Ex-Präsident stritt vor Gericht um seinen guten Namen und bekam in einem Urteil im Jahr 2000 Recht.“"
                            },
                            {
                                "example_id": "4e4c1b1a-3cfe-4bad-9e90-24f8d95b63f0",
                                "sense_id": "4bb2570a-6fbf-307d-bd3e-e20dc25cec6d",
                                "text": "„Der ehemalige Elektriker und Gewerkschaftsführer der ‚Solidarnosc‘ kam und genoss sichtlich die Aufmerksamkeit, die ihm über alle Generationen hinweg zuteilwurde.“"
                            },
                            {
                                "example_id": "377a9316-74e0-4b7a-bb4a-96f5870e4530",
                                "sense_id": "4bb2570a-6fbf-307d-bd3e-e20dc25cec6d",
                                "text": "„Nach Maddalena, einem Singener Gewerkschaftsführer und Widerstandskämpfer gegen den Nationalsozialismus, wurde die Straße nach dem Zweiten Weltkrieg benannt.“"
                            },
                            {
                                "example_id": "66fb2907-0fb6-4292-938a-68ec36528e98",
                                "sense_id": "4bb2570a-6fbf-307d-bd3e-e20dc25cec6d",
                                "text": "„Hartwich führt sein Auftreten auf bittere Erfahrungen zurück, die er als junger Gewerkschaftsführer gemacht hat.“"
                            },
                            {
                                "example_id": "9a4191e7-86d9-4b73-895a-4c15ec3d4875",
                                "sense_id": "4bb2570a-6fbf-307d-bd3e-e20dc25cec6d",
                                "text": "„Einem Gewerkschaftsführer war im Februar gekündigt worden, nachdem er öffentlich zum Widerstand gegen den Umschlag von Militärgütern für Israel im Hafen von Göteborg aufgerufen hatte.“"
                            },
                            {
                                "example_id": "6e671201-bb11-429a-a2d4-b872112abcd7",
                                "sense_id": "4bb2570a-6fbf-307d-bd3e-e20dc25cec6d",
                                "text": "„In London protestiert die sozialistische Labour Party gegen die Verhaftung von Gewerkschaftsführern durch die südafrikanische Regierung im Zusammenhang mit dem seit dem 7. Januar anhaltenden Generalstreik.“"
                            },
                            {
                                "example_id": "cbcb504f-68b4-45af-84db-c952cdf13ec6",
                                "sense_id": "4bb2570a-6fbf-307d-bd3e-e20dc25cec6d",
                                "text": "„Der sowjetische Gewerkschaftsführer Alexandr N. Schelepin wird von seinem Posten im Politbüro der KPdSU abgelöst.“"
                            },
                            {
                                "example_id": "f46e3e4d-538f-4f0d-92bf-1aa2ad5e44c1",
                                "sense_id": "4bb2570a-6fbf-307d-bd3e-e20dc25cec6d",
                                "text": "„In Singapur wird der ehemalige Lehrer und Gewerkschaftsführer Devan Nair zum neuen Staatspräsidenten gewählt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
