                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "eedac2a7-8104-3000-ae45-b81c8657c12d",
                        "entry_id": "79f154a3-a690-3e2f-9bdc-3044db90bb48",
                        "glosses": [
                            "noga sarny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e339155-b400-45d0-b416-57adb0e7e0b7",
                                "sense_id": "eedac2a7-8104-3000-ae45-b81c8657c12d",
                                "text": "Sarny mają gruczoły zapachowe m.in. między racicami tylnych cewek; wydzielająca się z nich ciecz pozostawia w śladach zapach umożliwiający innym zwierzętom rozpoznanie drogi przejścia."
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "66a3a621-6b04-3fb2-b22a-928f857250ce",
