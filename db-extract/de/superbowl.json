                "senses": [
                    {
                        "sense_id": "597a3599-8bd3-38e3-a999-7a1315b52d6b",
                        "entry_id": "8deef6f4-0c52-36e2-b1be-e73fab0cf549",
                        "glosses": [
                            "jährlich in der Regel am ersten Sonntag im Februar stattfindendes Endspiel um die nordamerikanische Meisterschaft der National Football League im American Football"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ef176e5-3d64-4b51-afe0-dd8c26358f2e",
                                "sense_id": "597a3599-8bd3-38e3-a999-7a1315b52d6b",
                                "text": "„Wenn die derzeit besten Football-Teams aus Chicago und Indianapolis heute im Superbowl aufeinandertreffen, wird die ganze US-Sportwelt nach Miami blicken.“"
                            },
                            {
                                "example_id": "366203ab-eb1e-4cc9-9f51-9060d99adf3c",
                                "sense_id": "597a3599-8bd3-38e3-a999-7a1315b52d6b",
                                "text": "„Zwei Tage vor dem fünften Februar, an dem die Demokraten in 22 Staaten an die Wahlurnen schreiten, wurde der Super Tuesday kurzzeitig vom Superbowl überschattet, dem wichtigsten Football-Spiel des Jahres.“"
                            },
                            {
                                "example_id": "5b6a2e1b-adb4-43c1-8989-542cc92b2b4e",
                                "sense_id": "597a3599-8bd3-38e3-a999-7a1315b52d6b",
                                "text": "„Im Vorjahr sahen 163 Millionen Amerikaner den Superbowl im Fernsehen. Deshalb reißen sich Showgrößen regelrecht um das Konzert in der Halbzeitpause.“"
                            },
                            {
                                "example_id": "b8d8a889-62d2-4421-89c3-e4cc1b9af2df",
                                "sense_id": "597a3599-8bd3-38e3-a999-7a1315b52d6b",
                                "text": "„Timberlake bedauerte den Zwischenfall beim Superbowl, als im Duett mit Janet Jackson für Sekunden eine ihrer Brüste entblösst zu sehen war.“"
                            },
                            {
                                "example_id": "5306789e-147d-400a-945e-520ef1d4aa23",
                                "sense_id": "597a3599-8bd3-38e3-a999-7a1315b52d6b",
                                "text": "„Beim letzten Aufeinandertreffen im vergangenen Januar ging es um nichts weniger als den Einzug ins Finale des Superbowls - und das dramatische Spiel ging in die Verlängerung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
