                                    },
                                    {
                                        "sense_id": "0f249b04-e777-3a6e-9e18-29fd8fc62433",
                                        "entry_id": "23d7a040-54f6-34b5-b3f6-301f9de30b97",
                                        "glosses": [
                                            "A fissure in a rock stratum filled with intrusive rock; a fault."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5dcb6a35-4496-315e-8ea2-b0606b610f1b",
                                        "entry_id": "23d7a040-54f6-34b5-b3f6-301f9de30b97",
                                        "glosses": [
                                            "A body of rock (usually igneous) originally filling a fissure but now often rising above the older stratum as it is eroded away."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e37b7b8-4a89-431a-a970-03d9fa51f700",
                                                "sense_id": "5dcb6a35-4496-315e-8ea2-b0606b610f1b",
                                                "text": "Their exact relationship to the host-rock is obscure but from their texture and observed metamorphic relationship they are thought to be intrusive dykes rather than intercalations of more basic lava."
                                            }
                                        ]
                                    }
                                ]
                            },
