                        "examples": [
                            {
                                "example_id": "b5c3c2b6-0489-4f75-b0b9-6ec4f9530b37",
                                "sense_id": "809d5555-414d-310c-814c-5c91b5695edc",
                                "text": "Een handje ongebrande, ongezouten amandelen geeft je een behoorlijke dosis vitamine E, mangaan en magnesium. Om al deze stofjes optimaal te kunnen opnemen laat je de noten een nachtje in water weken."
                            },
                            {
                                "example_id": "771b0b06-7973-4098-aa89-ec5445070208",
                                "sense_id": "809d5555-414d-310c-814c-5c91b5695edc",
                                "text": "Kinderen houden van snacken. Dit hoeft niet per sé slecht te zijn. Zorg voor voldoende vers fruit en rauwkost, ongezouten en ongebrande noten, rozijnen, dadels, zelfgemaakte popcorn, augurken en suikervrije volkoren crackers en koeken. Ook om mee te geven naar school"
                            },
                            {
                                "example_id": "37fb072a-3de3-48c1-8000-e8ca37fb325d",
                                "sense_id": "809d5555-414d-310c-814c-5c91b5695edc",
                                "text": "Of bestel via de lokale koffieboer een zakje groene bonen, of zoek anders op internet. Groene bonen leiden een dubbelleven als afslankmiddel, dus zoek gericht naar ‘ongebrande’ bonen."
                            }
                        ]
                    }
