                "entry_id": "d6174943-9bbe-34ec-83cc-8098fc203abb",
                "word": "théocrate",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "91d62162-811c-45d3-a3c3-30f755b3c7d3",
                        "entry_id": "d6174943-9bbe-34ec-83cc-8098fc203abb",
                        "tags": [
                            "plural",
                            "masculine",
