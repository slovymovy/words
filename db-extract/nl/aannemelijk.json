                        "examples": []
                    },
                    {
                        "sense_id": "318fe643-7984-370b-9169-bc8045e08cf6",
                        "entry_id": "0405d25f-0f64-3393-823a-46aa9a26e915",
                        "glosses": [
                            "waarschijnlijk, plausibel, geloofwaardig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82c9dd56-d2b6-4c4b-95ef-88222cc73c90",
                                "sense_id": "318fe643-7984-370b-9169-bc8045e08cf6",
                                "text": "Toen de wapenstilstand ten slotte een aannemelijk vooruitzicht werd, begon de hoop het er levend af te brengen zelfs bij de grootste pessimisten post te vatten."
                            },
                            {
                                "example_id": "b0a9c303-2483-4ebc-a207-30066d411560",
                                "sense_id": "318fe643-7984-370b-9169-bc8045e08cf6",
                                "text": "Het was aannemelijk dat het gedrag van Jeroen meer en meer onhebbelijk zou worden."
                            },
                            {
                                "example_id": "85ec2b1d-d322-42b1-b868-3fb452f9c414",
                                "sense_id": "318fe643-7984-370b-9169-bc8045e08cf6",
                                "text": "De voorzieningenrechter ging mee in het verweer van de voetbalbond. Enkele uren na de lange middagzitting oordeelde ze dat de KNVB voldoende aannemelijk had gemaakt dat er sprake is van een bijzondere omstandigheid. \"Ik hoop van harte dat het zondag een sportieve wedstrijd kan worden\", besloot de voorzieningenrechter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2323997-57b5-44e6-8d8c-c55fd8971272",
                        "source_entry_id": "0405d25f-0f64-3393-823a-46aa9a26e915",
                        "target_lang_word": "plausible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plausible",
