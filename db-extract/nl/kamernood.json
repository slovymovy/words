                "senses": [
                    {
                        "sense_id": "95fe589d-4e83-3992-8501-759dbb7bee6f",
                        "entry_id": "c9dd06dd-df53-3c04-be98-2aa91a515a18",
                        "glosses": [
                            "het tekort aan woonruimte voor studenten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdde8c35-b5af-427d-822d-35764db90828",
                                "sense_id": "95fe589d-4e83-3992-8501-759dbb7bee6f",
                                "text": "Hoewel woningcorporaties momenteel veel nieuwe kamers bijbouwen voor het Landelijk Actieplan Studentenhuisvesting (doel: 16.000 kamers in 2016), maakt dat komend studiejaar nog weinig verschil. De nieuwbouw verlicht de kamernood niet, maar voorkomt alleen nog langere wachtlijsten, denken studentenvakbonden."
                            },
                            {
                                "example_id": "4334302b-09a0-44a5-94fa-f79943dc06a0",
                                "sense_id": "95fe589d-4e83-3992-8501-759dbb7bee6f",
                                "text": "De kamernood onder studenten zal de komende jaren iets afnemen. Tot 2021 groeit het aantal studentenkamers harder dan het aantal uitwonende studenten. Vanaf 2016 zal de kamernood duidelijk afnemen, verwacht brancheorganisatie voor studentenhuisvesting Kences."
                            },
                            {
                                "example_id": "a925d848-255c-4311-b886-eda001233292",
                                "sense_id": "95fe589d-4e83-3992-8501-759dbb7bee6f",
                                "text": "Studenten in Amsterdam zijn het duurste uit. Zij betalen maandelijks maar liefst €138,12 te veel huur. Na Amsterdam komt Utrecht. Hier betalen studenten gemiddeld €102,15 per maand meer dan toegestaan. De huisjesmelkerij beperkt zich echter niet tot de steden met de grootste kamernood."
                            },
                            {
                                "example_id": "569c9e6e-115c-4ac9-a4fd-a92ea4108284",
                                "sense_id": "95fe589d-4e83-3992-8501-759dbb7bee6f",
                                "text": "De gemiddelde huurprijs voor een studentenkamer is door de kamernood inmiddels gestegen tot meer dan 400 euro per maand, liet verhuurwebsite Kamernet deze week weten. Koploper is Amsterdam, waar een gemiddelde kamer maar liefst 571 euro per maand kost."
                            }
                        ]
                    }
