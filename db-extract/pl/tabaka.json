                    },
                    {
                        "translation_id": "21a25fa7-17a8-4743-a2e2-6f96e85d5acd",
                        "source_entry_id": "a188487b-9f3a-3fe0-885b-1e3ecea1fc0d",
                        "source_sense_id": "102c1acc-5d5a-35e8-bf24-4182cdd0468c",
                        "target_lang_word": "Schnupftabak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnupftabak",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "61aa344d-b822-3da1-8b59-28a8a93e8b33",
                                        "entry_id": "42514ec7-3b55-33e9-9958-bcbc6a91c546",
                                        "glosses": [
                                            "sehr fein gemahlener Tabak, der durch Einatmen in die Nasenlöcher konsumiert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6177a6c0-465f-4f2e-a6b5-35f9a2880479",
                                                "sense_id": "61aa344d-b822-3da1-8b59-28a8a93e8b33",
                                                "text": "„Seit mindestens 500 Jahren weiß in Bayern jedes Kind, dass das Bier sowie der Schnupftabak die Sorgen und den Grant vertreiben.“"
                                            },
                                            {
                                                "example_id": "1e7457db-89b6-40e0-885b-1be094b25bf7",
                                                "sense_id": "61aa344d-b822-3da1-8b59-28a8a93e8b33",
                                                "text": "„Die Spione haben sich Schnupftabak in die Augen gerieben, damit diese rot und entzündet aussehen.“"
                                            },
                                            {
                                                "example_id": "e444aff9-7eba-431a-a34d-f5f3adae64c3",
                                                "sense_id": "61aa344d-b822-3da1-8b59-28a8a93e8b33",
                                                "text": "„Ein anderer Anlass war ihr Schnupftabak, der ihr bald zu trocken, bald zu feucht, bald nicht fein genug zerrieben vorkam.“"
                                            },
                                            {
                                                "example_id": "1b69f0ae-f1cb-4660-8bc4-9dee8bfc642a",
                                                "sense_id": "61aa344d-b822-3da1-8b59-28a8a93e8b33",
                                                "text": "„Übrigens ziehen die Spanier den Schnupftabak ihrem eigenen vor, so wie auch manche von uns den spanischen vorziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
