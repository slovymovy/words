                        "entry_id": "6f52c35b-49ca-3f43-b85c-712aa367cdc2",
                        "glosses": [
                            "Chahut, brouhaha, grand bruit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10358df8-c35d-4ca7-871b-02517a513a2b",
                                "sense_id": "44549e4f-cec1-376d-a2f6-95029824fce7",
                                "text": "Гом м. юж. гомь ж. ряз. гам м. сев. и вост. крик, шум, смех, говор, громкая ссора, нестройные и шумные голоса.",
                                "translation": "Gom, cri, bruit, rire, conversation, querelle bruyante, voix discordantes et bruyantes."
                            }
                        ]
                    }
                ],
