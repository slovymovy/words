                        "entry_id": "e4f84a1f-9b4d-3672-904c-5e1bac66c7f6",
                        "glosses": [
                            "The small splash of water that occurs when an oar enters the water to begin a stroke, just before the rower reaches the catch."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
