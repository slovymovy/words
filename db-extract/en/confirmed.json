                "translations": [
                    {
                        "translation_id": "cafb3c12-c398-465d-b462-6090ba9f4fda",
                        "source_entry_id": "870e41cb-7136-384a-8a65-bd594a9a44d3",
                        "source_sense_description": "having a settled habit; inveterate or habitual",
                        "target_lang_word": "inveterato",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inveterato",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "311a6fba-ad41-3c8c-b476-b1a12b03b256",
                                        "entry_id": "f2167f47-48e4-3ec0-9c5a-05b3ca6dcb24",
                                        "glosses": [
                                            "nel significato letterale di inveterare, di cui è participio passato, equivale a invecchiato o, per estensione, perseverante, perdurante nel tempo; da qui derivano i significati tuttora in uso"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64a2f70b-9e7b-370b-b78b-81c6835fecc4",
                                        "entry_id": "f2167f47-48e4-3ec0-9c5a-05b3ca6dcb24",
                                        "glosses": [
                                            "detto di abitudine o acquisita qualità, il più delle volte poco raccomandabile, poco rispettabile o decisamente detestabile, tanto consolidata nel comportamento o nel carattere da risultare difficilissima da strappare o correggere; lo si dice talvolta e senza connotazioni che esprimano una valutazione morale di consuetudini ancestrali vigenti presso un popolo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3b317d6-c893-4021-82a1-22c2789708a8",
                                                "sense_id": "64a2f70b-9e7b-370b-b78b-81c6835fecc4",
                                                "text": "Quanto valga la forza d'un'inveterata abitudine lo dimostrano luminosamente le cattive abitudini."
                                            },
                                            {
                                                "example_id": "020984da-d741-40eb-bdeb-94af035e1bfa",
                                                "sense_id": "64a2f70b-9e7b-370b-b78b-81c6835fecc4",
                                                "text": "L'occhio di azzurro chiaro era troppo preminente e rotondo; le narici del naso, finamente arcato, erano alquanto arricciate; e le labbra di fino taglio rilevate all'insù: il che indicava, insieme all'angolo acuto delle narici, abito inveterato di superbo spregio."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cd843a0-2eb2-3702-a024-453722899466",
                                        "entry_id": "f2167f47-48e4-3ec0-9c5a-05b3ca6dcb24",
                                        "glosses": [
                                            "di opinione, idea, concetto ecc. ampiamente diffusi che hanno nella tradizione e nell'ottuso consenso il loro unico simulacro di saldezza e validità"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ea0bb49-d731-49ea-a462-2ea858d1b835",
                                                "sense_id": "6cd843a0-2eb2-3702-a024-453722899466",
                                                "text": "Io non chiamerò tale affetto invidia, solita a convertirsi poi in odio ed ira contro agli scopritori di tali fallacie, ma lo dirò uno stimolo e una brama di voler più presto mantener gli errori inveterati, che permetter che si ricevano le verità nuovamente scoperte; la qual brama tal volta gl'induce a scrivere in contradizione a quelle verità, pur troppo internamente conosciute anco da loro medesimi, solo per tener bassa nel concetto del numeroso e poco intelligente vulgo l'altrui reputazione"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2400cfe-3a56-35c1-be5a-45a8a28e4079",
                                        "entry_id": "f2167f47-48e4-3ec0-9c5a-05b3ca6dcb24",
                                        "glosses": [
                                            "di sentimento sia positivo che, più comunemente, negativo che ha radici profonde e che con il tempo, fattosi meno irruente ma più sottile e pervasivo, non ha perso il suo vigore o la sua forza distruttiva"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96e111f2-8760-422f-8247-c497a24a9017",
                                                "sense_id": "b2400cfe-3a56-35c1-be5a-45a8a28e4079",
                                                "text": "si promettevano non vanamente avere disposti al desiderio loro i sanesi, accesi dall'odio inveterato contro a' fiorentini"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c47d7d98-717a-3667-8e2c-dd40e78c9de3",
                                        "entry_id": "f2167f47-48e4-3ec0-9c5a-05b3ca6dcb24",
                                        "glosses": [
                                            "riferito a persona, si dice di chi si incallisce in un comportamento vizioso o poco giovevole"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c6eb2af-a62c-4a9f-8e79-926063b9bfe8",
                                                "sense_id": "c47d7d98-717a-3667-8e2c-dd40e78c9de3",
                                                "text": "più che uno scommettitore inveterato, tu mi sembri un inveterato perditore"
                                            }
                                        ]
                                    }
                                ]
                            },
