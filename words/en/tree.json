                },
                {
                    "sense_id": "bc765b99-3cff-3538-af55-1c908302f27a",
                    "sense_definition": "A shaped block of wood or plastic placed inside a shoe to maintain its shape.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should always use a shoe <w>tree</w> to keep your leather boots from wrinkling.",
                            "target_lang_translations": {
                                "ru": "Всегда следует использовать <w>распорки</w> для обуви, чтобы кожаные ботинки не деформировались."
                            }
                        },
                        {
                            "text": "He placed a cedar <w>tree</w> in each of his expensive dress shoes.",
                            "target_lang_translations": {
                                "ru": "Он вставил кедровую <w>колодку</w> в каждую туфлю из своей дорогой пары."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shoe tree",
                        "boot tree"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревянная или пластиковая колодка, помещаемая внутрь обуви для сохранения её формы."
                    },
                    "translations": {
                        "ru": [
