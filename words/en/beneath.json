{
    "word_family": [
        "underneath"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "c362152c-63c6-351a-a1cc-2bbfc6288211",
                    "sense_definition": "In or to a lower position than someone or something; directly under.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spatial_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient ruins lie buried deep <w>beneath</w> the sand.",
                            "target_lang_translations": {
                                "ru": "Древние руины лежат, погребенные глубоко <w>под</w> песком.",
                                "tr": "Antik kalıntılar kumun derinliklerinde <w>altında</w> gömülü yatıyor.",
                                "zh": "古老的遗迹深埋在沙子<w>下</w>。"
                            }
                        },
                        {
                            "text": "Many strange creatures live <w>beneath</w> the surface of the ocean.",
                            "target_lang_translations": {
                                "ru": "Многие странные существа живут <w>под</w> поверхностью океана.",
                                "tr": "Okyanus yüzeyinin <w>altında</w> birçok tuhaf yaratık yaşar.",
                                "zh": "许多奇异的生物生活在海洋表面<w>下</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "under",
                        "below",
                        "underneath"
                    ],
                    "antonyms": [
                        "above",
                        "over"
                    ],
                    "common_phrases": [
                        "beneath the surface",
                        "beneath the stars",
                        "beneath the ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "В более низком положении по отношению к кому-либо или чему-либо; непосредственно под.",
                        "tr": "Birinin veya bir şeyin daha alt konumunda; doğrudan altında.",
                        "zh": "在某人或某物更低的位置；直接在……下面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "под",
                                "target_lang_sense_clarification": "предлог места"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "altında",
                                "target_lang_sense_clarification": "bir şeyin fiziksel olarak alt kısmında bulunma durumu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在……下",
                                "target_lang_sense_clarification": "表示空间位置的介词"
                            },
                            {
                                "target_lang_word": "在……下方",
                                "target_lang_sense_clarification": "表示位置在某物之下"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1114b470-b118-35f3-9f03-80bc15fb038e",
                    "sense_definition": "Covered, hidden, or protected by something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spatial_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a warm wool sweater <w>beneath</w> his heavy coat.",
                            "target_lang_translations": {
                                "ru": "Он надел теплый шерстяной свитер <w>под</w> тяжелое пальто.",
                                "tr": "Ağır paltosunun <w>altında</w> sıcak bir yün kazak giyiyordu.",
                                "zh": "他在厚外套<w>里</w>穿了一件暖和的羊毛衫。"
                            }
                        },
                        {
                            "text": "Her true emotions were hidden <w>beneath</w> a mask of indifference.",
                            "target_lang_translations": {
                                "ru": "Ее истинные чувства были скрыты <w>под</w> маской безразличия.",
                                "tr": "Gerçek duyguları bir kayıtsızlık maskesinin <w>altında</w> gizliydi.",
                                "zh": "她真实的感情被隐藏在冷漠的面具<w>下</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "under",
                        "underneath"
                    ],
                    "common_phrases": [
                        "beneath a mask",
                        "beneath the skin",
                        "beneath the veneer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытый, скрытый или защищенный чем-либо.",
                        "tr": "Bir şey tarafından örtülmüş, gizlenmiş veya korunmuş.",
                        "zh": "被某物覆盖、隐藏或保护。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "под",
                                "target_lang_sense_clarification": "указывает на нахождение под покровом чего-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "altında",
                                "target_lang_sense_clarification": "bir şeyin örtüsü veya katmanı altında kalma durumu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在……内",
                                "target_lang_sense_clarification": "表示被覆盖或隐藏在某物之下"
                            },
                            {
                                "target_lang_word": "在……下",
                                "target_lang_sense_clarification": "表示处于某物的遮盖或掩饰之下"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5cf9d51-253f-350f-8291-50781e661aec",
                    "sense_definition": "Not good enough for someone; considered inferior or unworthy of one's status.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt that doing such menial work was <w>beneath</w> him.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что выполнение такой черной работы <w>ниже</w> его достоинства.",
                                "tr": "Böylesine basit bir işi yapmanın kendi seviyesinin <w>altında</w> olduğunu hissetti.",
                                "zh": "他觉得干这种低微的活儿<w>有失身份</w>。"
                            }
                        },
                        {
                            "text": "Responding to such a rude comment is <w>beneath</w> my dignity.",
                            "target_lang_translations": {
                                "ru": "Отвечать на такой грубый комментарий — <w>ниже</w> моего достоинства.",
                                "tr": "Böylesine kaba bir yoruma cevap vermek onurumun <w>altında</w>.",
                                "zh": "回应这么粗鲁的评论，只会让我<w>有失身份</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unworthy of"
                    ],
                    "common_phrases": [
                        "beneath one's dignity",
                        "beneath contempt",
                        "beneath notice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Недостаточно хороший для кого-либо; считающийся низшим или недостойным чьего-либо статуса.",
                        "tr": "Birinin statüsüne veya onuruna yakışmayacak kadar düşük veya değersiz.",
                        "zh": "对某人来说不够好；被认为地位低下或不配。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ниже",
                                "target_lang_sense_clarification": "о достоинстве или статусе"
                            },
                            {
                                "target_lang_word": "недостойно",
                                "target_lang_sense_clarification": "не заслуживает внимания"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "altında",
                                "target_lang_sense_clarification": "birinin onuruna veya seviyesine yakışmayacak anlamında"
                            },
                            {
                                "target_lang_word": "yakışmaz",
                                "target_lang_sense_clarification": "birinin seviyesinin altında kalması durumu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有失……身份",
                                "target_lang_sense_clarification": "指某事低于某人的尊严或地位"
                            },
                            {
                                "target_lang_word": "配不上",
                                "target_lang_sense_clarification": "指某事不值得某人去做"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f98ffbdb-4a99-3579-936a-55e47c0b37a2",
                    "sense_definition": "In or to a lower place or position.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "spatial_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We stood on the bridge and watched the river flowing <w>beneath</w>.",
                            "target_lang_translations": {
                                "ru": "Мы стояли на мосту и смотрели на реку, текущую <w>внизу</w>.",
                                "tr": "Köprüde durduk ve <w>aşağıda</w> akan nehri izledik.",
                                "zh": "我们站在桥上，看着河水在<w>下面</w>流淌。"
                            }
                        },
                        {
                            "text": "The floorboards in the apartment <w>beneath</w> creaked loudly.",
                            "target_lang_translations": {
                                "ru": "Половицы в квартире <w>снизу</w> громко скрипели.",
                                "tr": "<w>Alt kattaki</w> dairenin döşeme tahtaları yüksek sesle gıcırdıyordu.",
                                "zh": "<w>楼下</w>公寓的地板发出响亮的吱呀声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "below",
                        "underneath"
                    ],
                    "antonyms": [
                        "above",
                        "overhead"
                    ],
                    "common_phrases": [
                        "from beneath",
                        "look beneath"
                    ],
                    "target_lang_definitions": {
                        "ru": "В более низком месте или положении.",
                        "tr": "Daha alt bir yerde veya konumda.",
                        "zh": "在更低的地方或位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внизу",
                                "target_lang_sense_clarification": "наречие места"
                            },
                            {
                                "target_lang_word": "снизу",
                                "target_lang_sense_clarification": "с нижней стороны"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "aşağıda",
                                "target_lang_sense_clarification": "konum olarak daha alt seviyede"
                            },
                            {
                                "target_lang_word": "alt tarafta",
                                "target_lang_sense_clarification": "daha alt kısımda"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在下面",
                                "target_lang_sense_clarification": "表示位置在下方"
                            },
                            {
                                "target_lang_word": "在楼下",
                                "target_lang_sense_clarification": "特指在建筑物较低的楼层"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}