                    {
                        "sense_id": "6dbb15a8-3c0d-39d3-8085-6e4cfe62e838",
                        "entry_id": "dd35ab5b-04e2-3213-8665-506d836e8a9c",
                        "glosses": [
                            "Nebenform von Birkenbusch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71cfb33a-a994-430d-a98c-124f6fba365e",
                                "sense_id": "6dbb15a8-3c0d-39d3-8085-6e4cfe62e838",
                                "text": "„Am Vorabende desselben war Alles beschäftigt, die Eingangsthüren und das Innere der Häuser mit grünen Maien, Birkenzweigen, welche der Birkbusch des Dorfes lieferte, auszuschmücken, und die Dielen mit frischgebrochenem Kalmus zu bestreuen.“"
                            },
                            {
                                "example_id": "7cd1e82e-e6e5-458e-af5d-5886fb27ec98",
                                "sense_id": "6dbb15a8-3c0d-39d3-8085-6e4cfe62e838",
                                "text": "„Verliert es auch in den Fichtenwaldungen etwas von dem frohen Wuchs zwischen den Birkbüschen der Höhen, so bleibt es doch immer noch, und selbst sehr weit südwärts, die vornehmste und auffallendste Bedeckung des Bodens“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
