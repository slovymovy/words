                                "target_senses": [
                                    {
                                        "sense_id": "2007f237-0e7e-3342-8496-e57c0470c510",
                                        "entry_id": "ca7a6574-af37-3198-ad93-075d4f385f06",
                                        "glosses": [
                                            "Alternative form of preelection."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d9f2de5-8011-456c-869d-387d2948719c",
                                                "sense_id": "2007f237-0e7e-3342-8496-e57c0470c510",
                                                "text": "At least Dr. Beeching can no longer be accused by anyone of disinterest in railways, after the king-sized squib he flung into one of the particularly combustible pre-election topics - transport - at the end of June."
                                            },
                                            {
                                                "example_id": "a8f8acc7-fa1d-4dd8-bcd2-4ae8bb2dae8c",
                                                "sense_id": "2007f237-0e7e-3342-8496-e57c0470c510",
                                                "text": "Due to Purdah (pre-election rules on announcements that could influence voters), this will not be released until after the local elections in May."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
