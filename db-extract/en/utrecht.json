    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a8712056-e15f-38bc-aa84-0fc9f61248b0",
                "word": "Utrecht",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d3f2e100-18cb-3f98-9452-a9f2592ec959",
                        "entry_id": "a8712056-e15f-38bc-aa84-0fc9f61248b0",
                        "glosses": [
                            "A city and municipality, the capital of Utrecht province, Netherlands."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aae174c-37b0-4ed1-909a-5b3384a8877a",
                                "sense_id": "d3f2e100-18cb-3f98-9452-a9f2592ec959",
                                "text": "The Treaty of Utrecht (11 April 1713) recognized Anne as the rightful queen of England and yielded St Kitts and much of Canada to the English."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ea4da9e-a52b-3461-b8be-f5734dcad4b5",
                        "entry_id": "a8712056-e15f-38bc-aa84-0fc9f61248b0",
                        "glosses": [
                            "A province of the Netherlands."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fef94880-2d20-42f3-9f0a-47752f2a70e2",
                                "sense_id": "5ea4da9e-a52b-3461-b8be-f5734dcad4b5",
                                "text": "E.g. muug 'tired' in the Utrecht dialect (Ponelis 1990: 36). Utrechtian, which does not delete intervocalic [χ/ɣ], belongs to the group of Hollandic dialects, which is the Dutch dialect group most closely related to Afrikaans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bbf39bf-413e-4996-aa88-1cc2df9ba3bc",
                        "source_entry_id": "a8712056-e15f-38bc-aa84-0fc9f61248b0",
                        "source_sense_description": "city in the Netherlands",
                        "target_lang_word": "Utrecht",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Utrecht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "70030b77-207b-3df5-b37b-3ec809cfb356",
                                        "entry_id": "bd035ee2-a7ed-3c8a-92f4-a94eb2a2188f",
                                        "glosses": [
                                            "een provincie in het midden van Nederland, die door Noord-Holland, Flevoland, Gelderland en Zuid-Holland wordt begrensd"
                                        ],
                                        "tags": [
                                            "toponiem: provincie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90d08102-6fe8-313c-afe5-239a73018353",
                                        "entry_id": "bd035ee2-a7ed-3c8a-92f4-a94eb2a2188f",
                                        "glosses": [
                                            "de hoofdstad van de provincie Utrecht"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e447d95-2b14-4eb3-a9d1-0cf21c4c7c4a",
                                                "sense_id": "90d08102-6fe8-313c-afe5-239a73018353",
                                                "text": "De kennis in Nederland over de aarde is \"eigenlijk een soort puzzel\", legt Hoogendoorn van het KNGMG uit. \"Er is ook een studie aardwetenschappen aan de Universiteit Utrecht, en bijvoorbeeld een technische variant in Delft. Maar het is allemaal heel nauw op elkaar afgestemd, zonder overlap. Je haalt nu een belangrijke kaart uit het kaartenhuis.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6738652d-93a9-31cf-86b4-f9dcc215cd3c",
                                        "entry_id": "bd035ee2-a7ed-3c8a-92f4-a94eb2a2188f",
                                        "glosses": [
                                            "een plaats aan de voet van het Balele-gebergte in KwaZoeloe-Natal, Zuid-Afrika"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb58be3b-f49e-3d35-bba9-62c3ab167fd2",
                                        "entry_id": "bd035ee2-a7ed-3c8a-92f4-a94eb2a2188f",
                                        "glosses": [
                                            "de naam van een boerenrepubliek rond [3] die bestaan heeft van 1852 tot 1856"
                                        ],
