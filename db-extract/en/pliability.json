                            "plural"
                        ],
                        "form": "pliabilities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a29cfeee-a9f1-31d3-a31d-e917d0dd0a67",
                        "entry_id": "8670dcaa-a30e-358b-881d-3c1d46b2846d",
                        "glosses": [
                            "The quality or state of being pliable; flexibility; pliableness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5128b741-ae1b-40b4-a210-3fadf63f29fb",
                                "sense_id": "a29cfeee-a9f1-31d3-a31d-e917d0dd0a67",
                                "text": "A man with less worldly shrewdness would never have seen how things really stood; a man with less pliability could never have adapted himself to them. It must always be remembered, that his whole administration was one long struggle: he had to maintain his master on the throne, and himself in the ministry; and this was done by sheer force of talent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "043df597-fcde-4c68-b9b4-01eb4c52a3e1",
                        "source_entry_id": "8670dcaa-a30e-358b-881d-3c1d46b2846d",
                        "source_sense_id": "a29cfeee-a9f1-31d3-a31d-e917d0dd0a67",
                        "source_sense_description": "being pliable",
                        "target_lang_word": "Biegsamkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "221f2fb4-d8dd-497f-8526-3e2f1434215d",
                        "source_entry_id": "8670dcaa-a30e-358b-881d-3c1d46b2846d",
                        "source_sense_id": "a29cfeee-a9f1-31d3-a31d-e917d0dd0a67",
                        "source_sense_description": "being pliable",
                        "target_lang_word": "Geschmeidigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschmeidigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7c82dfa-6968-36e8-99e0-b9fde6e4ee2a",
                                        "entry_id": "50fce98d-c1eb-31dc-8d56-2e15e97eeeb5",
                                        "glosses": [
                                            "Fähigkeit, sich flink und geschickt zu bewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10c8990f-dd49-4ff2-8a87-5da098d70c99",
                                                "sense_id": "f7c82dfa-6968-36e8-99e0-b9fde6e4ee2a",
                                                "text": "„Andrew war einen Kopf größer als der Professor, aber er war ungelenk und nicht eben muskulös, während der kleine Rotbart die Geschmeidigkeit einer Katze hatte.“"
                                            },
                                            {
                                                "example_id": "3ea13f4e-c0fb-45c8-be24-1a224522d2f1",
                                                "sense_id": "f7c82dfa-6968-36e8-99e0-b9fde6e4ee2a",
                                                "text": "„Am nächsten Morgen sah ich sie bei ihrem Bruder wieder, aber sie entschlüpfte uns mit der Geschmeidigkeit einer jungen verwilderten Hauskatze.“"
                                            },
                                            {
                                                "example_id": "1f8c68e7-7fa4-4eac-b9a3-b6f6889fa4e9",
                                                "sense_id": "f7c82dfa-6968-36e8-99e0-b9fde6e4ee2a",
                                                "text": "„Der Freikletterer bewegt sich in steiler Wand: Er verzichtet auch bei höchsten Schwierigkeitsgraden auf technische Hilfsmittel und setzt sich mit seiner reinen Körperlichkeit, der Kraft und Geschmeidigkeit seiner Muskeln, der Haltefähigkeit seiner Finger und Zehen, dem natürlichen Fels, seinen glatten Wänden, gefurchten Rillen, sperrigen Überhängen aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02c6044a-9b21-3227-93b3-0eb07071dcf2",
                                        "entry_id": "50fce98d-c1eb-31dc-8d56-2e15e97eeeb5",
                                        "glosses": [
                                            "Eigenschaft, weich und biegsam zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d538f1bf-11a3-490f-850a-46fc3c49af54",
                                                "sense_id": "02c6044a-9b21-3227-93b3-0eb07071dcf2",
                                                "text": "„Der Freikletterer bewegt sich in steiler Wand: Er verzichtet auch bei höchsten Schwierigkeitsgraden auf technische Hilfsmittel und setzt sich mit seiner reinen Körperlichkeit, der Kraft und Geschmeidigkeit seiner Muskeln, der Haltefähigkeit seiner Finger und Zehen, dem natürlichen Fels, seinen glatten Wänden, gefurchten Rillen, sperrigen Überhängen aus.“"
                                            },
                                            {
                                                "example_id": "8488460f-3f09-4e75-9f6d-4383f708256c",
                                                "sense_id": "02c6044a-9b21-3227-93b3-0eb07071dcf2",
                                                "text": "Die Schuhe zeichnen sich durch eine besondere Geschmeidigkeit aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "664e4dae-0936-374b-ae0c-2a9f6158edc7",
                                        "entry_id": "50fce98d-c1eb-31dc-8d56-2e15e97eeeb5",
                                        "glosses": [
                                            "Fähigkeit, sich anzupassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3813a350-1c27-42a0-b63c-e47e7ab27bfa",
                                                "sense_id": "664e4dae-0936-374b-ae0c-2a9f6158edc7",
                                                "text": "Manche Leute übertreiben ihre Geschmeidigkeit bei Verhandlungen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
