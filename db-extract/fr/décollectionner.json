                                "example_id": "c6122325-63f1-4a3c-bd75-296553fc721f",
                                "sense_id": "bf299d95-d053-31f4-a788-283af939616a",
                                "text": "Il faut apprendre à «décollectionner» me disait récemment Germano Celant, lequel sera chargé d’études à partir du mois d’octobre 1990 à la bibliothèque du Cape."
                            }
