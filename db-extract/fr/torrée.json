                "senses": [
                    {
                        "sense_id": "e04ac21d-c42a-3f8a-b0cc-a71f7d0a56aa",
                        "entry_id": "542f85e6-4871-3a81-bbbe-269f54e348c2",
                        "glosses": [
                            "Repas convivial en plein-air où l’on mange des mets, généralement du saucisson neuchâtelois, préparés dans la braise d’un grand feu champêtre."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "c19fdae7-8b94-45b2-970c-ecd53900af23",
                                "sense_id": "e04ac21d-c42a-3f8a-b0cc-a71f7d0a56aa",
                                "text": "Le met traditionnel de la torrée est le saucisson du pays cuit sous la cendre, accompagné de pommes de terre en robe des champs."
                            },
                            {
                                "example_id": "4b6380d4-32fb-4c73-9823-5a7f9a4e76f6",
                                "sense_id": "e04ac21d-c42a-3f8a-b0cc-a71f7d0a56aa",
                                "text": "De ce culte ancestral pour le feu, il ne subsiste plus aujourd’hui dans le Jura suisse que la coutume de la « torrée » qui se pratique surtout au début de l'automne."
                            },
                            {
                                "example_id": "47ec6ac4-b5ab-420e-bfdf-d8108647cf01",
                                "sense_id": "e04ac21d-c42a-3f8a-b0cc-a71f7d0a56aa",
                                "text": "Temps ensoleillé : journée idéale pour une torrée, cette incontournable fête qui célèbre l’arrivée d’une nouvelle saison - celle aux couleurs dorées et aux brumes matinales."
                            }
                        ]
                    }
                ],
