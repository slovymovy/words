                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Likör",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b6bd64d-2b9a-346d-abc3-2791aef56b6f",
                                        "entry_id": "ee1adb42-b91a-3e65-993b-6235ac4051ee",
                                        "glosses": [
                                            "aromatisches alkoholisches Getränk mit relativ hohem Zuckergehalt und einem Alkoholgehalt von 15 bis 40 Prozent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a77755af-d5be-4316-9f2b-8dbbc3739801",
                                                "sense_id": "4b6bd64d-2b9a-346d-abc3-2791aef56b6f",
                                                "text": "Die alten Damen trafen sich jede Woche zum Kartenspiel und tranken dazu immer ein Glas Likör."
                                            },
                                            {
                                                "example_id": "a4a4893a-b201-4680-8dd4-8703acafefda",
                                                "sense_id": "4b6bd64d-2b9a-346d-abc3-2791aef56b6f",
                                                "text": "„Reizl goß sich ein Gläschen Likör ein.“"
                                            },
                                            {
                                                "example_id": "bdec06a9-9628-4c51-861a-429d7b69a40b",
                                                "sense_id": "4b6bd64d-2b9a-346d-abc3-2791aef56b6f",
                                                "text": "„In der Hast ging ihr der Likör übers Glas.“"
                                            },
                                            {
                                                "example_id": "afebedfe-d0f9-4606-9d6f-1f363c8d8b12",
                                                "sense_id": "4b6bd64d-2b9a-346d-abc3-2791aef56b6f",
                                                "text": "„Seine verliebte Beredsamkeit wuchs in dem Maß, wie er seine Kehle mit Champagner, Zyperwein und Likör befeuchtete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
