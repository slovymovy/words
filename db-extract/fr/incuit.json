                "senses": [
                    {
                        "sense_id": "92fcbe72-ec8e-3ecd-ae14-5a08b03698b2",
                        "entry_id": "5694ed0a-3bc9-37d7-8042-f3a6ab4154e5",
                        "glosses": [
                            "Partie d’une chaux, d’un ciment, d’un plâtre qui n’a pas été portée à une température suffisante pour en assurer une bonne cuisson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aac5673c-0e29-4dc4-a8c6-cd85507d610b",
                                "sense_id": "92fcbe72-ec8e-3ecd-ae14-5a08b03698b2",
                                "text": "Quelquefois une partie du calcaire n'a pas été suffisamment chauffée et retient de l'acide carbonique ; il faut séparer avec soin les morceaux de cette nature que l'on appelle des incuits."
                            },
                            {
                                "example_id": "d6d7eec0-17c9-4fb8-814e-c60e9cfa7c9f",
                                "sense_id": "92fcbe72-ec8e-3ecd-ae14-5a08b03698b2",
                                "text": "En traitant de la même façon un incuit de ciment, nous voyons que même une quantité plus forte de gypse n’arrive pas à produire l’effet voulu, l’alumine étant entièrement contenue sous forme d’aluminate."
                            }
                        ]
                    }
