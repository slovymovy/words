                            },
                            {
                                "target_lang_word": "olgunlaştırmak",
                                "target_lang_sense_clarification": "meyveyi olgun kıvama getirmek"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dojrzewać",
                                "target_lang_sense_clarification": "o owocach stających się miękkimi i gotowymi do jedzenia"
                            },
                            {
                                "target_lang_word": "dojść",
                                "target_lang_sense_clarification": "uzyskać pełnię dojrzałości po zebraniu"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "maturare",
                                "target_lang_sense_clarification": "portare a maturazione o raggiungere la maturazione"
                            },
                            {
                                "target_lang_word": "far maturare",
                                "target_lang_sense_clarification": "aiutare la frutta a diventare morbida e dolce"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "rijpen",
                                "target_lang_sense_clarification": "rijp en zacht worden"
                            },
                            {
                                "target_lang_word": "laten rijpen",
                                "target_lang_sense_clarification": "zorgen dat fruit zacht en zoet wordt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6be64e47-6af0-3059-94c0-acfdd3ddf05f",
                    "sense_definition": "To reduce harshness or make something softer and more pleasant.",
                    "learner_level": "C1",
