    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "311a02ca-698a-3a4a-bf8c-c5576b490c1b",
                "word": "Abenaki",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bc2d3eed-3ed8-314e-b0bc-d365a144cb35",
                        "entry_id": "311a02ca-698a-3a4a-bf8c-c5576b490c1b",
                        "glosses": [
                            "Related or pertaining to the Abenaki people or language."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "509b6de4-9d69-4e46-a77d-bfd141c0b01a",
                                "sense_id": "bc2d3eed-3ed8-314e-b0bc-d365a144cb35",
                                "text": "I am to walk left, westward on the Abenaki trail which I will know by the sapling bent into the earth with one sprout growing skyward."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6414b530-3b45-45ca-ad3b-d6fa1c23120e",
                        "source_entry_id": "311a02ca-698a-3a4a-bf8c-c5576b490c1b",
                        "source_sense_id": "bc2d3eed-3ed8-314e-b0bc-d365a144cb35",
                        "source_sense_description": "related to the Abenaki people or language",
                        "target_lang_word": "abénaqui",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abénaqui",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "871da27e-6848-344e-bc86-61eca1e658b5",
                                        "entry_id": "f3042ca2-3a6f-34cb-ac6b-15910de68f1f",
                                        "glosses": [
                                            "Variante orthographique de abénaquis."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71dbac3b-848b-42a4-8745-a61efdfb8b9e",
                                                "sense_id": "871da27e-6848-344e-bc86-61eca1e658b5",
                                                "text": "[…] le baron d’Abadie de Castin, né près de Pau en 1652, épouse la fille d’un chef abénaqui et va exciter contre les Anglais les tribus de son beau-père."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bfd43ce-8202-40a1-b986-618adace83ce",
                        "source_entry_id": "311a02ca-698a-3a4a-bf8c-c5576b490c1b",
                        "source_sense_id": "bc2d3eed-3ed8-314e-b0bc-d365a144cb35",
                        "source_sense_description": "related to the Abenaki people or language",
                        "target_lang_word": "abénaquis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abénaquis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d6e1691-4f37-33d0-91fa-06f47c1fcb15",
                                        "entry_id": "d5c88ba9-8c82-3445-84a3-964822351e79",
                                        "glosses": [
                                            "Langue parlée par les Abénaquis, peuple amérindien du Canada."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67a1837e-4ba6-4c59-905b-c6cb98430e16",
                                                "sense_id": "7d6e1691-4f37-33d0-91fa-06f47c1fcb15",
                                                "text": "Fasciné par les autochtones et aspirant à devenir un des leurs, Harel a vécu dans les réserves de la Côte-Nord, engendré de nombreux rejetons métissés. Il comprend le montagnais, l’algonquin et l’abénaquis."
                                            },
                                            {
                                                "example_id": "be226b3f-57cb-4a31-b573-69f967b8f589",
                                                "sense_id": "7d6e1691-4f37-33d0-91fa-06f47c1fcb15",
                                                "text": "D’ailleurs, la dernière réalisation qu’elle présente au festival, Sigwan - qui signifie printemps en abénaquis -, est un éloge à l’acceptation des différences au sein des communautés autochtones."
                                            },
                                            {
                                                "example_id": "41200d02-4592-4862-a2f5-8c9abfbdca81",
                                                "sense_id": "7d6e1691-4f37-33d0-91fa-06f47c1fcb15",
                                                "text": "Odanak, au confluent de la Nicolet et du lac Saint-Pierre, est un vieux village abénaquis… où plus personne ne parle abénaquis. Pourtant, il n’y a pas 50 ans, cette langue qu’on dit harmonieuse et caractérisée par les formules de politesse était encore parlée par les vieux du bourg. Il a suffi de deux générations pour que l’abénaquis, comme la plupart des langues autochtones du Canada, soit en danger de disparaître. […] Pas de méthode Assimil pour les langues autochtones! Pour apprendre l’abénaquis, Monique Nolett-Ille ne dispose que de deux dictionnaires, de la transcription de textes anciens et de quelques éléments de grammaire. Après 10 ans de travail, elle est incapable de soutenir une conversation. « Soixante personnes se sont manifestées spontanément quand j’ai commencé à donner des cours d’abénaquis à Odanak. Après quelques semaines, il n’en restait qu’une demi-douzaine.»"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abénaquis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05f0c83c-e8c5-35ec-8411-06a6887a05f2",
                                        "entry_id": "9b20d247-6650-3d3a-b43d-1d7bb8b81175",
                                        "glosses": [
                                            "Relatif au peuple et à la culture des Abénaquis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a525a78-5197-4ac1-9499-08aa556067e9",
                                                "sense_id": "05f0c83c-e8c5-35ec-8411-06a6887a05f2",
                                                "text": "En effet, la non moins respectée cinéaste abénaquise Alanis Obomsawin prend le relais de celle qui fut une inspiration pour l’ensemble des Premières Nations."
                                            },
                                            {
                                                "example_id": "931cff03-6bac-461a-9585-61199a327fb7",
                                                "sense_id": "05f0c83c-e8c5-35ec-8411-06a6887a05f2",
                                                "text": "Alors que le Canada ne reconnaît toujours pas le Québec comme une nation, l’Assemblée nationale du Québec, elle, reconnaissait déjà, en 1985, le statut de nation, ainsi que les droits qui y sont rattachés, aux nations abénaquise, algonquine, attikamek, crie, huronne, micmaque, mohawk, montagnaise, naskapie, inuite et malécite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
