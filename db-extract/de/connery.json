                "senses": [
                    {
                        "sense_id": "6a0a8487-c873-3b71-8bee-d30c7088d901",
                        "entry_id": "faf29b32-c0a2-3e33-ad39-ab9fc017b5dc",
                        "glosses": [
                            "englischsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a8bf577-cd09-4e6f-a897-2a2bbc4b6dfa",
                                "sense_id": "6a0a8487-c873-3b71-8bee-d30c7088d901",
                                "text": "Frau Connery ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a0abe7c0-e3ea-4baf-8090-b7daac2e1392",
                                "sense_id": "6a0a8487-c873-3b71-8bee-d30c7088d901",
                                "text": "Herr Connery wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "459c27bd-fba5-47d0-a761-5ce8c9c00f26",
                                "sense_id": "6a0a8487-c873-3b71-8bee-d30c7088d901",
                                "text": "Die Connerys fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9647003f-0a6d-48e6-be8e-8ad579157f4f",
                                "sense_id": "6a0a8487-c873-3b71-8bee-d30c7088d901",
                                "text": "Der Connery trägt nie die Schals, die die Connery ihm strickt."
                            },
                            {
                                "example_id": "64ff93ff-bb99-46d1-a7a5-a45b25d74683",
                                "sense_id": "6a0a8487-c873-3b71-8bee-d30c7088d901",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau ´Connery kommt, geht der Herr Connery.“"
                            },
                            {
                                "example_id": "ef0248b7-f56c-4435-ba04-fb4ac104a5ce",
                                "sense_id": "6a0a8487-c873-3b71-8bee-d30c7088d901",
                                "text": "Connery kommt und geht."
                            },
                            {
                                "example_id": "bd237aa0-b3b7-4828-97ed-e10d293536b3",
                                "sense_id": "6a0a8487-c873-3b71-8bee-d30c7088d901",
                                "text": "Connerys kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
