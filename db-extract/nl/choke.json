                                        "glosses": [
                                            "In wrestling, karate (etc.), a type of hold that can result in strangulation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0422d77a-2c1a-354f-8347-1afe56d3f780",
                                        "entry_id": "c6359c68-d70f-31eb-ae9e-d1d70be127cf",
                                        "glosses": [
                                            "A constriction at the muzzle end of a shotgun barrel which affects the spread of the shot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e080e91-a66a-314c-8929-4ebb46e8a353",
                                        "entry_id": "c6359c68-d70f-31eb-ae9e-d1d70be127cf",
                                        "glosses": [
                                            "A partial or complete blockage (of boulders, mud, etc.) in a cave passage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43037a5b-7016-3504-8890-ac9177e19670",
                                        "entry_id": "c6359c68-d70f-31eb-ae9e-d1d70be127cf",
                                        "glosses": [
                                            "A choking coil."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb77e5a2-0161-36a7-9d44-afc6edba3a23",
                                        "entry_id": "c6359c68-d70f-31eb-ae9e-d1d70be127cf",
                                        "glosses": [
                                            "A major mistake at a crucial stage of a competition because one is nervous, especially when one is winning."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "choke",
                                "target_lang_code": "en",
