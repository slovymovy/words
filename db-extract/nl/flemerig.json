                                    {
                                        "sense_id": "ab6226cf-2b01-354c-81a8-64271f340be2",
                                        "entry_id": "ca263671-f4b9-35cf-b10a-b18fd9cd9707",
                                        "glosses": [
                                            "The act of one who coaxes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3672c5c-44ab-486f-a3ce-f8cfa03f04fe",
                                                "sense_id": "ab6226cf-2b01-354c-81a8-64271f340be2",
                                                "text": "After innumerable coaxings and threats, he agreed to do it."
                                            },
                                            {
                                                "example_id": "74b470c0-54f8-4771-a025-f9e0bf371def",
                                                "sense_id": "ab6226cf-2b01-354c-81a8-64271f340be2",
                                                "text": "Her mother was ever at her side, seeking with coaxings and evil advice to drive her to the irrevocable step."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coaxing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7728fba-c45e-3a42-98be-d533457687e7",
                                        "entry_id": "55c07598-69d2-35a0-ba32-a9b43d03dbf1",
                                        "glosses": [
                                            "That coaxes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fdd02c8-b50b-4c86-bdb8-132e7153567a",
                                                "sense_id": "a7728fba-c45e-3a42-98be-d533457687e7",
                                                "text": "“Poor little thing!” said Alice, in a coaxing tone, and she tried hard to whistle to it;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "257a5fa1-5c5e-4574-ba95-2a88f98d8392",
                        "source_entry_id": "c346ec25-3ae0-389c-a985-0c1a7577ab23",
