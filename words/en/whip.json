{
    "word_family": [
        "whiplash",
        "whipper",
        "whipcord"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "77acdc4e-cec7-39d8-b71c-0d05f0fcc675",
                    "sense_definition": "A long, flexible instrument, such as a leather strap or rope attached to a handle, used for hitting animals or people to drive them or punish them.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jockey used a <w>whip</w> to make the horse run faster.",
                            "target_lang_translations": {
                                "ru": "Жокей использовал <w>хлыст</w>, чтобы заставить лошадь бежать быстрее.",
                                "zh": "骑师用<w>马鞭</w>让马跑得更快。"
                            }
                        },
                        {
                            "text": "The sound of the <w>whip</w> cracking made the lions retreat.",
                            "target_lang_translations": {
                                "ru": "Звук удара <w>кнута</w> заставил львов отступить.",
                                "zh": "鞭子<w>抽打</w>的响声让狮子退缩了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lash",
                        "scourge",
                        "switch",
                        "crop"
                    ],
                    "common_phrases": [
                        "crack the whip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный гибкий инструмент (ремень или веревка на рукоятке), используемый для ударов по животным или людям, чтобы погонять или наказывать их.",
                        "zh": "一种长而灵活的工具，通常由手柄连接皮带或绳子组成，用于抽打动物或人以驱赶或惩罚他们。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кнут",
                                "target_lang_sense_clarification": "толстый, тяжелый инструмент для управления животными"
                            },
                            {
                                "target_lang_word": "хлыст",
                                "target_lang_sense_clarification": "тонкий прут, обычно для верховой езды"
                            },
                            {
                                "target_lang_word": "бич",
                                "target_lang_sense_clarification": "длинная плеть на рукоятке, часто пастушья или цирковая"
                            },
                            {
                                "target_lang_word": "плеть",
                                "target_lang_sense_clarification": "инструмент из сплетенных ремней"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鞭子",
                                "target_lang_sense_clarification": "通用的抽打工具"
                            },
                            {
                                "target_lang_word": "马鞭",
                                "target_lang_sense_clarification": "骑马时使用的鞭子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd974014-d948-3369-ac95-a185f34aedba",
                    "sense_definition": "Short for whipped cream; cream that has been beaten until it is light and fluffy, used as a topping.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like a mocha with extra <w>whip</w>, please.",
                            "target_lang_translations": {
                                "ru": "Я бы хотел мокко с двойной порцией <w>взбитых сливок</w>, пожалуйста.",
                                "zh": "请给我一杯加了双份<w>搅打奶油</w>的摩卡。"
                            }
                        },
                        {
                            "text": "She put a dollop of <w>whip</w> on top of the pumpkin pie.",
                            "target_lang_translations": {
                                "ru": "Она положила ложку <w>взбитых сливок</w> сверху на тыквенный пирог.",
                                "zh": "她在南瓜派上加了一勺<w>搅打奶油</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortening of whipped cream"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от «взбитые сливки»; сливки, взбитые до легкого и воздушного состояния.",
                        "zh": "“搅打奶油”的缩写；指被搅打至轻盈蓬松状态的奶油，常作为甜点配料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взбитые сливки",
                                "target_lang_sense_clarification": "молочный продукт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搅打奶油",
                                "target_lang_sense_clarification": "乳制品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d0e62f0-391a-3abd-8391-b3dfb4bac715",
                    "sense_definition": "A member of a political party in parliament who is responsible for ensuring that other members attend and vote according to the party's policy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chief <w>whip</w> urged all the MPs to support the new bill.",
                            "target_lang_translations": {
                                "ru": "Главный <w>партийный организатор</w> призвал всех депутатов поддержать новый законопроект.",
                                "zh": "首席<w>党鞭</w>敦促所有议员支持这项新法案。"
                            }
                        },
                        {
                            "text": "She was appointed as a party <w>whip</w> shortly after the election.",
                            "target_lang_translations": {
                                "ru": "Вскоре после выборов она была назначена <w>партийным организатором</w>.",
                                "zh": "选举后不久，她就被任命为<w>党鞭</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "party whip"
                    ],
                    "common_phrases": [
                        "chief whip"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "political context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Член политической партии в парламенте, следящий за партийной дисциплиной и голосованием депутатов.",
                        "zh": "议会中负责确保本党议员出席并按党派政策投票的成员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "партийный организатор",
                                "target_lang_sense_clarification": "должность в парламенте"
                            },
                            {
                                "target_lang_word": "партийный кнут",
                                "target_lang_sense_clarification": "политический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "党鞭",
                                "target_lang_sense_clarification": "议会政治术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25d13833-dedd-38c3-a3a4-64c586dd5d27",
                    "sense_definition": "A car, especially one that is expensive or stylish.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pulled up to the party in his brand new <w>whip</w>.",
                            "target_lang_translations": {
                                "ru": "Он подъехал к вечеринке на своей новенькой <w>тачке</w>.",
                                "zh": "他开着他那辆崭新的<w>座驾</w>来到了派对。"
                            }
                        },
                        {
                            "text": "We decided to take my <w>whip</w> because it has a better sound system.",
                            "target_lang_translations": {
                                "ru": "Мы решили поехать на моей <w>тачке</w>, потому что в ней лучше аудиосистема.",
                                "zh": "我们决定开我的<w>座驾</w>去，因为那辆车的音响系统更好。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Автомобиль, особенно дорогой или стильный (слэнг).",
                        "zh": "汽车，尤指昂贵或时髦的汽车（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тачка",
                                "target_lang_sense_clarification": "слэнг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "座驾",
                                "target_lang_sense_clarification": "指代汽车的俚语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e2624000-9af4-328d-82c1-e885e816df08",
                    "sense_definition": "To hit a person or animal with a whip or a similar flexible object.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rider <w>whipped</w> the horse to make it jump the fence.",
                            "target_lang_translations": {
                                "ru": "Всадник <w>хлестнул</w> лошадь, чтобы заставить её перепрыгнуть через забор.",
                                "zh": "骑手<w>抽打</w>马匹，让它跳过栅栏。"
                            }
                        },
                        {
                            "text": "He was <w>whipped</w> as a punishment for his crimes.",
                            "target_lang_translations": {
                                "ru": "Его <w>выпороли</w> в наказание за его преступления.",
                                "zh": "他因犯罪而受到了<w>鞭笞</w>的惩罚。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lash",
                        "flog",
                        "beat",
                        "scourge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бить человека или животное кнутом или похожим гибким предметом.",
                        "zh": "用鞭子或类似的柔性物体抽打人或动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлестать",
                                "target_lang_sense_clarification": "наносить резкие удары"
                            },
                            {
                                "target_lang_word": "пороть",
                                "target_lang_sense_clarification": "наказывать ударами, сечь"
                            },
                            {
                                "target_lang_word": "стегать",
                                "target_lang_sense_clarification": "бить прутом или веткой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抽打",
                                "target_lang_sense_clarification": "用鞭子击打"
                            },
                            {
                                "target_lang_word": "鞭笞",
                                "target_lang_sense_clarification": "正式或惩罚性的抽打"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cad45fed-d0d5-39d6-92cd-dd8201ce7053",
                    "sense_definition": "To beat food, such as eggs or cream, rapidly with a fork or whisk to add air and make it light.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>whip</w> the cream until it forms stiff peaks.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>взбивать</w> сливки, пока они не станут густыми.",
                                "zh": "你需要把奶油<w>搅打</w>到出现硬性发泡。"
                            }
                        },
                        {
                            "text": "She <w>whipped</w> the eggs and sugar together to make the batter.",
                            "target_lang_translations": {
                                "ru": "Она <w>взбила</w> яйца с сахаром, чтобы приготовить тесто.",
                                "zh": "她把鸡蛋和糖<w>搅打</w>在一起做成面糊。"
                            }
                        }
                    ],
                    "synonyms": [
                        "whisk",
                        "beat"
                    ],
                    "common_phrases": [
                        "whip cream",
                        "whip eggs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро мешать продукты (яйца, сливки) вилкой или венчиком для придания воздушности.",
                        "zh": "用叉子或打蛋器快速搅打鸡蛋或奶油等食物，使其混入空气变得轻盈。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взбивать",
                                "target_lang_sense_clarification": "кулинария"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搅打",
                                "target_lang_sense_clarification": "烹饪动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8a35a34-87d5-39cd-8467-4393822d5723",
                    "sense_definition": "To move or pull something very quickly and suddenly.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "5",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>whipped</w> out his phone to take a picture of the celebrity.",
                            "target_lang_translations": {
                                "ru": "Он <w>выхватил</w> свой телефон, чтобы сфотографировать знаменитость.",
                                "zh": "他<w>猛地拿出</w>手机给那位名人拍照。"
                            }
                        },
                        {
                            "text": "The wind <w>whipped</w> through the trees during the storm.",
                            "target_lang_translations": {
                                "ru": "Во время шторма ветер <w>хлестал</w> по деревьям.",
                                "zh": "暴风雨中，狂风在树林间<w>疾驰</w>而过。"
                            }
                        }
                    ],
                    "synonyms": [
                        "snatch",
                        "jerk",
                        "dash",
                        "rush"
                    ],
                    "common_phrases": [
                        "whip out",
                        "whip up",
                        "whip around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигать или вытаскивать что-то очень быстро и внезапно.",
                        "zh": "非常迅速且突然地移动或拉动某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выхватить",
                                "target_lang_sense_clarification": "быстро достать"
                            },
                            {
                                "target_lang_word": "хлестать",
                                "target_lang_sense_clarification": "о ветре или дожде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猛地拿出",
                                "target_lang_sense_clarification": "快速取出动作"
                            },
                            {
                                "target_lang_word": "疾驰",
                                "target_lang_sense_clarification": "形容快速移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4c8c0ed-edde-3309-8f61-85d2109b17c3",
                    "sense_definition": "To defeat an opponent easily in a contest or game.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "6",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our team got <w>whipped</w> in the final match of the season.",
                            "target_lang_translations": {
                                "ru": "Нашу команду <w>разгромили</w> в финальном матче сезона.",
                                "zh": "我们的球队在赛季决赛中被<w>大败</w>。"
                            }
                        },
                        {
                            "text": "I bet I can <w>whip</w> you at a game of chess.",
                            "target_lang_translations": {
                                "ru": "Спорим, я <w>обставлю</w> тебя в шахматы.",
                                "zh": "我敢打赌下棋我能<w>完胜</w>你。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beat",
                        "thrash",
                        "defeat"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко победить противника в состязании или игре.",
                        "zh": "在比赛或游戏中轻松击败对手。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгромить",
                                "target_lang_sense_clarification": "одержать полную победу"
                            },
                            {
                                "target_lang_word": "обставить",
                                "target_lang_sense_clarification": "разг. переиграть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大败",
                                "target_lang_sense_clarification": "彻底击败对手"
                            },
                            {
                                "target_lang_word": "完胜",
                                "target_lang_sense_clarification": "轻松获胜"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}