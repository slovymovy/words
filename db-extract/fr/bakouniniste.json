                        "glosses": [
                            "Personne qui soutient les idées politiques de Mikhaïl Bakounine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3f0b8b5-500b-4dbf-a83d-eb6b5fc4bd4b",
                                "sense_id": "db228ddc-c1c3-3074-a8f4-ea42838b45e6",
                                "text": "Implantée en Espagne depuis la fin des années 1860 au sein de la Federacion Regional Espagnola (FRE), ses liens avec l’Alliance pour la démocratie socialiste se sont intensifiés depuis la visite du « bakouniniste » Giuseppe Fanelli et la tendance anarchiste est en train de l’emporter."
                            },
                            {
                                "example_id": "a4cda5b8-55d2-4b48-af07-91252b336a4f",
                                "sense_id": "db228ddc-c1c3-3074-a8f4-ea42838b45e6",
                                "text": "À partir de 1870, le clivage se déplace, au sein de l’AIT, entre bakouninistes et marxistes, qui divergent sur l’attitude à avoir vis-à-vis de l’État."
                            }
                        ]
                    }
