                    {
                        "translation_id": "908b8224-be0a-47c3-85d8-f82cf076e424",
                        "source_entry_id": "d92c5e46-b330-3d46-b19b-f5ac8f2f7b61",
                        "source_sense_id": "5dd7d190-2054-37a6-bd52-d63a5e9c5a56",
                        "target_lang_word": "Tennisspieler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tennisspieler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35166d98-3c56-3b52-b7c7-787c7178a972",
                                        "entry_id": "cfc20d8d-4c67-3f71-8d86-cbca2ad04cd5",
                                        "glosses": [
                                            "Sportler, der das Tennisspiel ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b56ef16-01de-48e5-887a-9748cdafe506",
                                                "sense_id": "35166d98-3c56-3b52-b7c7-787c7178a972",
                                                "text": "„Ein Tennisspieler zieht nicht nur aus der Optik eines Schlags seine Schlüsse, sondern auch aus dem Geräusch, das beim Treffpunkt entsteht.“"
                                            },
                                            {
                                                "example_id": "456cd9c5-8b99-4500-b29e-e4bd45fa0947",
                                                "sense_id": "35166d98-3c56-3b52-b7c7-787c7178a972",
                                                "text": "„Novak Djokovic ist einer der besten Tennisspieler der Gegenwart und Vergangenheit.“"
                                            },
                                            {
                                                "example_id": "a7549e6d-e8a4-41a8-8883-b8c6f2afb356",
                                                "sense_id": "35166d98-3c56-3b52-b7c7-787c7178a972",
                                                "text": "„Sie sahen wieder den Tennisspielern zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0124793-1e4d-4bd2-ab74-2fc786bdf242",
                        "source_entry_id": "d92c5e46-b330-3d46-b19b-f5ac8f2f7b61",
                        "source_sense_id": "dd98efc5-696d-359b-9446-de380e2d5463",
                        "target_lang_word": "Tischtennisspieler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tischtennisspieler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34e62973-1373-3197-a142-1ec8e3630227",
                                        "entry_id": "5caa8d77-3b08-31f7-97e6-a1635562b92f",
                                        "glosses": [
                                            "Sportler, der das Tischtennisspiel ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb954e6d-7c22-4ac1-897d-af55b27c8d83",
                                                "sense_id": "34e62973-1373-3197-a142-1ec8e3630227",
                                                "text": "Als Tischtennisspieler benötigt man blitzschnelle Reflexe."
                                            },
                                            {
                                                "example_id": "229d1493-442c-4952-b05d-e1eb9b712569",
                                                "sense_id": "34e62973-1373-3197-a142-1ec8e3630227",
                                                "text": "„Nach Tagen des Wartens und der Erlösung am Montag durch Bronze von Tischtennisspieler Krisztian Gardos haben Österreichs Sportler am Mittwoch bei den XV. Paralympics in Rio de Janeiro kräftigst zugeschlagen.“"
                                            },
                                            {
                                                "example_id": "67238806-f616-4d11-a1c5-7b8cc127a800",
                                                "sense_id": "34e62973-1373-3197-a142-1ec8e3630227",
                                                "text": "„Um den 16-fachen Tischtennis-Europameister Timo Boll an der Tischtennisplatte zu schlagen, darf der Kandidat vorher bestimmen, ob der erfolgreiche Tischtennisspieler zum Smartphone oder einer Bratpfanne greifen muss.“"
                                            },
                                            {
                                                "example_id": "c10d7d3c-86e0-4c27-b2d1-30347d071aa9",
                                                "sense_id": "34e62973-1373-3197-a142-1ec8e3630227",
                                                "text": "„Als Behinderter in seiner beruflichen Funktion werde er häufig interviewt, sagt der begeisterte Tischtennisspieler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
