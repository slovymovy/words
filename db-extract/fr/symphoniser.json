                "senses": [
                    {
                        "sense_id": "176811dd-5754-3bf8-85b5-cae0e9857399",
                        "entry_id": "848eea8e-6a9d-3e93-b6b9-1c462086feeb",
                        "glosses": [
                            "Mettre en symphonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0540bca5-3e34-44df-970a-fa86c6a285d8",
                                "sense_id": "176811dd-5754-3bf8-85b5-cae0e9857399",
                                "text": "Bien qu’on ait pu le croire, il ne s’agissait pas de symphoniser l’opéra sur le modèle wagnérien, mais de chercher dans une autre direction, Wagner n’ayant d’ailleurs pas rompu avec les vers."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d1c678d-b77f-34ae-81eb-795f0330b722",
                        "entry_id": "848eea8e-6a9d-3e93-b6b9-1c462086feeb",
                        "glosses": [
                            "Jouer une symphonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35c48612-48a2-42cd-bd3f-df8cbdbd8727",
                                "sense_id": "2d1c678d-b77f-34ae-81eb-795f0330b722",
                                "text": "...il y a toujours du Wagner et du Bach qui co-symphonisent dans mon tympan, de toute façon y a jamais rien eu d’autre qui te fasse vivre ou mourir, la musique, la pulsion..."
                            }
                        ]
                    },
                    {
                        "sense_id": "7811349d-306d-3ac2-ba6b-3d02936e91d7",
                        "entry_id": "848eea8e-6a9d-3e93-b6b9-1c462086feeb",
                        "glosses": [
                            "Jouer, chanter de façon mélodieuse."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4cdad5e8-465a-4c8b-b57f-57bca9e57144",
                                "sense_id": "7811349d-306d-3ac2-ba6b-3d02936e91d7",
                                "text": "Dehors, les oiseaux symphonisent peinards, le bec planté dans les étoiles."
                            }
                        ]
                    }
