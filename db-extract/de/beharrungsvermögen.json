                    {
                        "form_id": "158b5222-f488-486e-b3ed-e6fa458b084c",
                        "entry_id": "eee331c0-f9b8-3e37-99f3-1257f1f255cc",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Beharrungsvermögen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0a0696a5-47f1-362e-b16a-a04b73be0ca7",
                        "entry_id": "eee331c0-f9b8-3e37-99f3-1257f1f255cc",
                        "glosses": [
                            "Fähigkeit/Disposition, nichts zu ändern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0bd1ef6-dfa4-4e8d-aa5b-d9882893aba7",
                                "sense_id": "0a0696a5-47f1-362e-b16a-a04b73be0ca7",
                                "text": "„Das erklärt wohl auch unser Beharrungsvermögen gegenüber Veränderungen.“"
                            },
                            {
                                "example_id": "44a59c1e-64c4-4e53-ad41-67c716595edd",
                                "sense_id": "0a0696a5-47f1-362e-b16a-a04b73be0ca7",
                                "text": "„Gerade das Wechselspiel von Wandelbarkeit und Beharrungsvermögen der Bedeutungsfiguren macht sie zu einem so spannenden Objekt der Beobachtung.“"
                            },
                            {
                                "example_id": "9efd1d83-7413-40c4-855f-3c0c38d4d846",
                                "sense_id": "0a0696a5-47f1-362e-b16a-a04b73be0ca7",
                                "text": "„Unmöglich wäre es zweitens gewesen, weil es zur Paralysierung des Beharrungsvermögens, mit dem Napoleons Heer sich rückwärts bewegte, ganz wesentlich grösserer Truppenmassen bedurft hätte, als sie den Russen zur Verfügung standen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ace76752-bf0d-48b8-b018-485168fed55a",
                        "source_entry_id": "eee331c0-f9b8-3e37-99f3-1257f1f255cc",
                        "source_sense_id": "0a0696a5-47f1-362e-b16a-a04b73be0ca7",
                        "source_sense_description": "Fähigkeit/Disposition, nichts zu ändern",
                        "target_lang_word": "inertie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inertie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a6615d0-a21a-3ce4-86b2-30714437e3ba",
                                        "entry_id": "7dabf1da-30e8-373f-b178-a16a69ea1f7f",
                                        "glosses": [
                                            "État de ce qui est inerte."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75725f81-01c2-4d8b-b146-1d1d83042391",
                                                "sense_id": "7a6615d0-a21a-3ce4-86b2-30714437e3ba",
                                                "text": "Principe d’inertie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d09afc63-50dc-3feb-85e2-42e17707ea20",
                                        "entry_id": "7dabf1da-30e8-373f-b178-a16a69ea1f7f",
                                        "glosses": [
                                            "Absence de réaction chimique en présence d’une substance"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5467ed34-163f-38cf-843f-2745572a09e0",
                                        "entry_id": "7dabf1da-30e8-373f-b178-a16a69ea1f7f",
                                        "glosses": [
                                            "Résistance passive qu’opposent les corps du fait de leur masse au changement de l’état de repos ou de mouvement dans lequel ils se trouvent."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feee2465-5dc7-4497-9759-37f50130440b",
                                                "sense_id": "5467ed34-163f-38cf-843f-2745572a09e0",
                                                "text": "Buridan attaque la métaphysique du mouvement du Stagirite. Au principe aristotélicien : « Tout mobile est mû par un moteur distinct de lui », […], il substitue le principe d’inertie ou de conservation de l'impulsion, en l'absence de toute force appliquée. […], : le véritable moteur d'un mobile n'est autre que l'impulsion (impetus) déposée en lui par la force qui l'a lancé."
                                            },
                                            {
                                                "example_id": "1d022335-1d4e-4e31-86fd-882f6d7841c8",
                                                "sense_id": "5467ed34-163f-38cf-843f-2745572a09e0",
                                                "text": "En physique, l'inertie est la tendance pour un objet à conserver sa vitesse en l'absence de force extérieure. Si vous lancez une balle dans l'espace, elle n'arrêtera jamais sa lancée, sauf si un objet comme une planète l'attire par gravité. En démographie, ce terme sert à illustrer le fait que les mouvements sont dans ce domaine généralement très lents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a970670-8b49-38d0-a45a-9d2a98591ca1",
                                        "entry_id": "7dabf1da-30e8-373f-b178-a16a69ea1f7f",
                                        "glosses": [
                                            "Résistance passive d’une personne, qui consiste principalement à ne pas obéir, à ne pas exécuter ce qui est commandé."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50acc411-f429-4c55-a546-f1318e7c141d",
                                                "sense_id": "5a970670-8b49-38d0-a45a-9d2a98591ca1",
                                                "text": "Il oppose à toutes les réclamations la force d’inertie."
                                            },
                                            {
                                                "example_id": "667718a7-8ac4-4478-9ad3-afe7d9f9d6d8",
                                                "sense_id": "5a970670-8b49-38d0-a45a-9d2a98591ca1",
                                                "text": "Il rencontra dans la nation une force d’inertie qui neutralisa toutes ses mesures."
                                            },
                                            {
                                                "example_id": "0e82f29e-7984-48a6-9d5a-8cccc6fe3837",
                                                "sense_id": "5a970670-8b49-38d0-a45a-9d2a98591ca1",
                                                "text": "Dans l’hypothèse où les textes en vigueur n’ont été que partiellement appliqués, peut-on en fournir l’explication (mauvaise information, inertie, complexité, manque de moyens, textes d’application pris avec retard ou inefficaces) ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0abb4cd1-4839-3bae-8058-bfe42de86146",
                                        "entry_id": "7dabf1da-30e8-373f-b178-a16a69ea1f7f",
                                        "glosses": [
                                            "Manque absolu d’activité ou d’énergie."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49cba85c-0a7f-4016-b783-585bdf5110e3",
                                                "sense_id": "0abb4cd1-4839-3bae-8058-bfe42de86146",
                                                "text": "Rester dans une complète inertie."
                                            },
                                            {
                                                "example_id": "b00f436d-5b3b-4a76-ba93-f18db9e2e2c1",
                                                "sense_id": "0abb4cd1-4839-3bae-8058-bfe42de86146",
                                                "text": "Être plongé dans une profonde inertie."
                                            },
                                            {
                                                "example_id": "a7f873c3-5964-45aa-8135-8e8d3904d684",
                                                "sense_id": "0abb4cd1-4839-3bae-8058-bfe42de86146",
                                                "text": "Tirez-le de cette inertie."
                                            },
                                            {
                                                "example_id": "38d40568-4b6c-40ec-9f81-f617f8697ffa",
                                                "sense_id": "0abb4cd1-4839-3bae-8058-bfe42de86146",
                                                "text": "Vivre dans un état d’indifférence et d’inertie."
                                            },
                                            {
                                                "example_id": "e6f34593-0396-4214-bc52-21f15f303ec0",
                                                "sense_id": "0abb4cd1-4839-3bae-8058-bfe42de86146",
                                                "text": "Tomber, languir dans l’inertie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a11ed4ee-49bc-4dd4-9425-0c6bf5ae481c",
                        "source_entry_id": "eee331c0-f9b8-3e37-99f3-1257f1f255cc",
                        "source_sense_id": "0a0696a5-47f1-362e-b16a-a04b73be0ca7",
                        "source_sense_description": "Fähigkeit/Disposition, nichts zu ändern",
                        "target_lang_word": "persévérance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persévérance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f083fb3-76ce-38ed-be89-095626037f40",
                                        "entry_id": "9ff2679c-5e9b-3c6d-80fc-536d42469e6e",
                                        "glosses": [
                                            "Qualité ou action de celui qui persévère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35d1c894-4225-4920-ab27-41d0bb25f445",
                                                "sense_id": "6f083fb3-76ce-38ed-be89-095626037f40",
                                                "text": "Ce principe de la philosophie cartésienne « je pense, donc je suis », est ce que les adversaires du cartésianisme ont attaqué avec le plus de persévérance ; et cela se conçoit, car ce principe admis, l'autorité de la conscience et de la raison s'ensuit nécessairement."
                                            },
                                            {
                                                "example_id": "7883f1a8-3d51-47a7-a145-e27957ea6ebd",
                                                "sense_id": "6f083fb3-76ce-38ed-be89-095626037f40",
                                                "text": "Maintenant que son dessein était arrêté dans sa tête, il n'avait plus qu'à l'exécuter et il n'était pas homme à en changer. La persévérance est une vertu bretonne."
                                            },
                                            {
                                                "example_id": "1505a80c-0b96-4d68-93f5-4e854c5c4230",
                                                "sense_id": "6f083fb3-76ce-38ed-be89-095626037f40",
                                                "text": "Une telle persévérance, sans garantie de succès, forçait le respect."
                                            },
                                            {
                                                "example_id": "18ab7f7d-e8f7-4a69-9985-be6df60991e7",
                                                "sense_id": "6f083fb3-76ce-38ed-be89-095626037f40",
                                                "text": "Car ce que la persévérance nous aide à atteindre à la fin, ce qu'elle nous aide à atteindre toujours, c'est l'estime de soi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "818b1c6d-955d-4e9c-a6ae-a76e486e906c",
                        "source_entry_id": "eee331c0-f9b8-3e37-99f3-1257f1f255cc",
                        "source_sense_id": "0a0696a5-47f1-362e-b16a-a04b73be0ca7",
                        "source_sense_description": "Fähigkeit/Disposition, nichts zu ändern",
                        "target_lang_word": "opiniâtreté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opiniâtreté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85462b37-ab45-331c-aa6d-70c408b8be26",
                                        "entry_id": "e411e06f-d8cc-3e21-91c7-5e637ef1d60e",
                                        "glosses": [
                                            "Caractère de celui qui est opiniâtre ; trop grand attachement à son opinion, à sa volonté, voire à son idée fixe, à ses erreurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cef4298-20a5-4726-ad4d-f015c8143087",
                                                "sense_id": "85462b37-ab45-331c-aa6d-70c408b8be26",
                                                "text": "Opiniâtreté invincible."
                                            },
                                            {
                                                "example_id": "727ff4fd-0bb4-4308-a7ef-53f2cbe7a3e2",
                                                "sense_id": "85462b37-ab45-331c-aa6d-70c408b8be26",
                                                "text": "Il soutient cette erreur, ce mensonge avec opiniâtreté."
                                            },
                                            {
                                                "example_id": "3c9434b5-6ec4-4d97-8498-eb7278ae65f9",
                                                "sense_id": "85462b37-ab45-331c-aa6d-70c408b8be26",
                                                "text": "La petitesse de l’esprit fait l’opiniâtreté ; et nous ne croyons pas aisément ce qui est au-delà de ce que nous voyons."
                                            },
                                            {
                                                "example_id": "680d4e26-5c09-4d55-a4fe-5e330c0d332a",
                                                "sense_id": "85462b37-ab45-331c-aa6d-70c408b8be26",
                                                "text": "Chacun s'est fait à soi-même un tribunal où il s'est rendu l'arbitre de sa croyance : (…) chaque fidèle en deviendrait l'interprète, et croirait que le Saint-Esprit lui en dicte l'explication; il n'y a point de particulier qui ne se voie autorisé par cette doctrine à adorer ses inventions, à consacrer ses erreurs. (…) Dès lors on a bien prévu que la licence n'ayant plus de frein, les sectes se multiplieraient jusqu'à l'infini ; que l'opiniâtreté serait invincible."
                                            },
                                            {
                                                "example_id": "a52add02-1efb-4f3c-83d2-bbfed96ea989",
                                                "sense_id": "85462b37-ab45-331c-aa6d-70c408b8be26",
                                                "text": "Après avoir mûrement approfondi les hommes et connu le faux de leurs pensées, de leurs sentiments, de leurs goûts et de leurs affections, l'on est réduit à dire qu'il y a moins à perdre pour eux par l'inconstance que par l'opiniâtreté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78903022-502a-380e-b81b-edd8904c94ea",
                                        "entry_id": "e411e06f-d8cc-3e21-91c7-5e637ef1d60e",
                                        "glosses": [
                                            "Fermeté, constance, persévérance, acharnement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e213dd27-47e2-4376-8be3-242f557b3aa5",
                                                "sense_id": "78903022-502a-380e-b81b-edd8904c94ea",
                                                "text": "Ne te parjure pas, dit le Normand en l’interrompant, et prends garde que ton opiniâtreté ne décide de ton sort avant que tu aies vu et bien considéré le destin qui t’attend."
                                            },
                                            {
                                                "example_id": "ad5f51db-2156-46b2-a8bc-ca9f34ac4053",
                                                "sense_id": "78903022-502a-380e-b81b-edd8904c94ea",
                                                "text": "Malheureusement, en ce moment même, elle tomba malade ; quelque temps on espéra que la force de la jeunesse (…) triompherait de l’opiniâtreté de la maladie."
                                            },
                                            {
                                                "example_id": "fa2a571a-dc01-4ab4-967b-998bfcf72d39",
                                                "sense_id": "78903022-502a-380e-b81b-edd8904c94ea",
                                                "text": "Continuer à trimer, je suis persuadé que votre opiniâtreté vous vaudra un jour une médaille."
                                            }
                                        ]
                                    }
                                ]
