                        "examples": [
                            {
                                "example_id": "07add078-15e4-4f4c-b964-066ae30917c9",
                                "sense_id": "29814afb-35a1-3621-a79d-e25199dd7772",
                                "text": "scads of money"
                            },
                            {
                                "example_id": "6bc6c63a-8745-4f46-886f-15b01f702e34",
                                "sense_id": "29814afb-35a1-3621-a79d-e25199dd7772",
                                "text": "it will surely rust, take on a loud of stains and pits, acquire a scad of dust."
                            },
                            {
                                "example_id": "6b3ad05c-aee4-4d82-8e11-931601b5c93e",
                                "sense_id": "29814afb-35a1-3621-a79d-e25199dd7772",
                                "text": "You take temporary employment for office employees and there are a whole scad of people doing that and nothing else."
                            },
                            {
                                "example_id": "418d8510-5e54-4ea1-bed2-5be881c3ae32",
                                "sense_id": "29814afb-35a1-3621-a79d-e25199dd7772",
                                "text": "Galleries everywhere are awash in these brand-name reductivist canvases, […], mimicking a set of preapproved influences. (It’s also a global presence: I saw scads of it in Berlin a few weeks back, and art fairs are inundated.)"
                            }
                        ]
                    }
