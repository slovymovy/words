                {
                    "sense_id": "456bda6d-c50a-3aab-b863-7f0741094e53",
                    "sense_definition": "The central mark or target in traditional archery.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The archer drew back his bowstring and aimed straight for the distant <w>clout</w>.",
                            "target_lang_translations": {
                                "zh": "弓箭手拉开弓弦，直直瞄准远处的<w>箭靶</w>。"
                            }
                        },
                        {
                            "text": "Few competitors managed to hit the <w>clout</w> in such windy conditions.",
                            "target_lang_translations": {
                                "zh": "在如此大风的环境下，很少有选手能够射中<w>靶心</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "target",
                        "bullseye"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Primarily used in historic contexts of archery"
                        }
