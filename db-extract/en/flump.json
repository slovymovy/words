    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "10544b34-715e-36f0-bfea-1939d82b8c92",
                "word": "flump",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1d957c8e-03de-337b-af8b-352aa9e46cc6",
                        "entry_id": "10544b34-715e-36f0-bfea-1939d82b8c92",
                        "glosses": [
                            "A sound of something moving or falling heavily, or with a dull sound."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "853d103f-90ec-4b43-bb99-c361ad962670",
                                "sense_id": "1d957c8e-03de-337b-af8b-352aa9e46cc6",
                                "text": "\"Now again.\" The boy readies himself. The other children stand and stare. Parents look on expectantly. Flump . . . he lands on his back."
                            },
                            {
                                "example_id": "64c5a75e-c723-49c2-98dc-250e1a966dbd",
                                "sense_id": "1d957c8e-03de-337b-af8b-352aa9e46cc6",
                                "text": "The bird going \"flump!\" at the end of Barton Fink."
                            },
                            {
                                "example_id": "55b0b8a9-5295-4a53-8dfd-d2e7eb642735",
                                "sense_id": "1d957c8e-03de-337b-af8b-352aa9e46cc6",
                                "text": "ben: Just lift the hammer. Good. Now when you bring it down, put your whole strength into it. Really kill him. Ready? Now, GO! / jay: HHHHHHHRRRRRRAAAAAAAGH! [Flump!] / ben: And again? jay: DAMMIT! [Flump!] BASTARD! [Flump!] RRRRRRRRAAAAGH! [Flump!] / ben: Okay, okay. Wow. So how do you feel now? Any better?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b9593823-571e-3c45-a912-520a602f7be6",
                "word": "flump",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "de97141c-33f4-40f0-ba85-7e79745228f6",
                        "entry_id": "b9593823-571e-3c45-a912-520a602f7be6",
                        "tags": [
                            "plural"
                        ],
                        "form": "flumps"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0564ff84-5c80-39fc-9daa-2b0e0998d216",
                        "entry_id": "b9593823-571e-3c45-a912-520a602f7be6",
                        "glosses": [
                            "An instance of the dull sound so produced."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bddb044d-552e-308a-b9ea-9369815e471f",
                        "entry_id": "b9593823-571e-3c45-a912-520a602f7be6",
                        "glosses": [
                            "A type of large marshmallow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faf58d68-96dd-4174-a4e3-28f422126be8",
                                "sense_id": "bddb044d-552e-308a-b9ea-9369815e471f",
                                "text": "As the lead cast get ready for an on-screen pint, or a packet of flumps in the case of Thomas, the fun and warmth on set is there for all to see and Riley is busy flitting between her on and off camera jobs."
                            },
                            {
                                "example_id": "15dab9d4-c839-4adb-ba01-b5323db9c5d7",
                                "sense_id": "bddb044d-552e-308a-b9ea-9369815e471f",
                                "text": "So it means you'll always have room for ice cream, flumps, strawberry sauce and a chocolate flake."
                            },
                            {
                                "example_id": "5f444ba5-482e-4253-bd8f-d6fee4868878",
                                "sense_id": "bddb044d-552e-308a-b9ea-9369815e471f",
                                "text": "The luxury marshmallows were not your average flump, they had a chewy and sumptous texture that really gave you something to bite in to, covered in rich milk chocolate and sprinkles for that added sweet flavour."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbfb39a2-384c-3632-b0ad-b34899d3cc33",
                        "entry_id": "b9593823-571e-3c45-a912-520a602f7be6",
                        "glosses": [
                            "A fat out-of-shape person."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "987d09fd-bead-447b-83b9-86c31b5f8705",
                                "sense_id": "cbfb39a2-384c-3632-b0ad-b34899d3cc33",
                                "text": "Ruth said: 'I recently treated myself to a fitted, hot pink dress for a night out and banished that image of being a fat, pink flump for good.'"
                            },
                            {
                                "example_id": "09f6cf71-60fd-41c8-8d8f-ec6b3cbee285",
                                "sense_id": "cbfb39a2-384c-3632-b0ad-b34899d3cc33",
                                "text": "In reality I felt like a fat flump, my belly still bulging like a saggy balloon."
                            },
                            {
                                "example_id": "48857d20-ca05-4a19-b459-b8f97d612863",
                                "sense_id": "cbfb39a2-384c-3632-b0ad-b34899d3cc33",
                                "text": "Peggy: Who you calling a flump?!"
                            }
                        ]
                    }
                ],
