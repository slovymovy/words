                "senses": [
                    {
                        "sense_id": "c949575a-7916-375c-afac-1f6fc199b802",
                        "entry_id": "68957ff9-b4f3-32a6-a3ce-d392eb3b4773",
                        "glosses": [
                            "Chercher, trouver et publier des informations privées de quelqu’un sur Internet."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6c512e3e-e972-48a9-871b-b26505c5e7c3",
                                "sense_id": "c949575a-7916-375c-afac-1f6fc199b802",
                                "text": "S’autodox pour faire croire que tu dox alors que c’est pas moi le dox c’est toi la le dox"
                            },
                            {
                                "example_id": "c87ae605-afec-48be-ae5c-fee830c5e708",
                                "sense_id": "c949575a-7916-375c-afac-1f6fc199b802",
                                "text": "Imagine t’es chez toi tranquille 3h du mat entrain de jouer à Sly 2 d’un coup tu dox le daron de ta meuf parce qu’elle veut pas que tu parles à son daron"
                            },
                            {
                                "example_id": "faf9fefc-ea04-46ed-837c-62637053afef",
                                "sense_id": "c949575a-7916-375c-afac-1f6fc199b802",
                                "text": "Alors\nAtz : pck il dox ses potes,que c’est un harceleur et qu’il le vanne tout le temps\nPol : pck il faisait partis du même groupe mais il se sont embrouillés mais j’en sais pas plus\nMoi : pck j’ai fais des montages \"Ljv like\" a l’ééépoque"
                            }
                        ]
                    }
                ],
