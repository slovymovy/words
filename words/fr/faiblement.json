                },
                {
                    "sense_id": "30ccb7ed-61c6-3baa-9f08-f4145a3d5b7b",
                    "sense_definition": "Avec peu de force physique, d'énergie ou de vigueur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "force_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malade depuis plusieurs jours, le vieil homme serra très <w>faiblement</w> la main de son médecin.",
                            "target_lang_translations": {
                                "en": "Having been ill for several days, the old man squeezed his doctor's hand very <w>weakly</w>.",
                                "ru": "Несколько дней пробыв больным, старик очень <w>слабо</w> пожал руку своему врачу.",
                                "de": "Seit mehreren Tagen krank, drückte der alte Mann die Hand seines Arztes sehr <w>schwach</w>.",
                                "es": "Enfermo desde hacía varios días, el anciano apretó muy <w>débilmente</w> la mano de su médico.",
                                "zh": "病了好几天的老人，非常<w>虚弱地</w>握了握医生的手。"
                            }
                        },
                        {
                            "text": "Épuisée après une longue marche, elle a réussi à pousser <w>faiblement</w> la lourde porte en bois.",
                            "target_lang_translations": {
                                "en": "Exhausted after a long walk, she managed to push the heavy wooden door <w>feebly</w>.",
                                "ru": "Измотанная долгой ходьбой, она сумела <w>слабо</w> толкнуть тяжёлую деревянную дверь.",
                                "de": "Nach einem langen Fußmarsch erschöpft, schaffte sie es, die schwere Holztür <w>schwach</w> aufzudrücken.",
                                "es": "Agotada tras una larga caminata, logró empujar <w>débilmente</w> la pesada puerta de madera.",
                                "zh": "走了很长的路，她已精疲力尽，还是<w>无力地</w>推开了那扇沉重的木门。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mollement"
                    ],
                    "target_lang_definitions": {
                        "en": "With little physical strength, energy or vigour.",
                        "ru": "С малой физической силой, энергией или бодростью.",
                        "de": "Mit wenig körperlicher Kraft, Energie oder Schwung.",
                        "es": "Con poca fuerza física, energía o vigor.",
                        "zh": "以缺乏体力、精力或活力的方式。"
                    },
