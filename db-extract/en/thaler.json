                    {
                        "translation_id": "58719611-c168-410b-b40b-30ad39d2bb6c",
                        "source_entry_id": "e38ffe53-8eb5-3791-bcd3-50a2d69b91e8",
                        "source_sense_description": "historical monetary unit",
                        "target_lang_word": "та́лер",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "та́лер",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "121a10b5-afc3-355f-a59d-4fc55ebacab2",
                                        "entry_id": "1c22ce2e-34b2-3545-8928-5ea32821b292",
                                        "glosses": [
                                            "истор. название крупной серебряной монеты"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73396430-3086-40c1-aa0a-f0535278f7b1",
                                                "sense_id": "121a10b5-afc3-355f-a59d-4fc55ebacab2",
                                                "text": "А давали нам за всякую убитую яныческу голову по золотому червонному, а за полковниковы головы давали по сту талеров."
                                            },
                                            {
                                                "example_id": "c78c5c60-2d74-44a2-8b35-108674ce6a7e",
                                                "sense_id": "121a10b5-afc3-355f-a59d-4fc55ebacab2",
                                                "text": "Везде слышишь немецкий язык — где-где русский, — и везде требуют не рублей, а талеров."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "та́лер",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9cf23f2c-894c-397a-a506-f979591dd9c3",
                                        "entry_id": "64ef72ed-30ba-3efb-b1dd-ba2d314b38df",
                                        "glosses": [
                                            "полигр. металлическая плита в печатной машине, на которой устанавливается печатная форма"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fc0bd09-ada2-4274-bc5d-a3ea350afca0",
                                                "sense_id": "9cf23f2c-894c-397a-a506-f979591dd9c3",
                                                "text": "Плоская чугунная плита — талер — с закреплённым на ней набором ходит взад и вперёд под круглым валом с листом бумаги и валиками, накатывающими краску на шрифт."
                                            },
                                            {
                                                "example_id": "91297dff-6148-4952-91e3-131b310bf7ca",
                                                "sense_id": "9cf23f2c-894c-397a-a506-f979591dd9c3",
                                                "text": "Талер выдвигался из-под пресса, и на него ставили набор одной или нескольких страниц."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17a7431e-2b1e-3b09-b73f-190b543a94c5",
                                        "entry_id": "64ef72ed-30ba-3efb-b1dd-ba2d314b38df",
                                        "glosses": [
                                            "полигр., истор. обитый цинком стол или чугунная доска, где производилась вёрстка и другие работы по подготовке набора в печать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ced6fe60-a9b1-40ac-bb86-3d04b40e02db",
                                                "sense_id": "17a7431e-2b1e-3b09-b73f-190b543a94c5",
                                                "text": "Всю жизнь он простоял за талером в одной из типографий Рязани."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
