                "senses": [
                    {
                        "sense_id": "269ae621-2d20-3e6e-8524-8924b260508d",
                        "entry_id": "7a22e3bd-d961-314b-b250-27233a2832b8",
                        "glosses": [
                            "A handle; the portion of a handle that the hand occupies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50db1ddd-4f58-41cc-801f-6a04b60dae6e",
                                "sense_id": "269ae621-2d20-3e6e-8524-8924b260508d",
                                "text": "On a motorcycle, you work the clutch by squeezing a lever on your left handgrip, and you operate the shift lever with your left foot."
                            },
                            {
                                "example_id": "00cada78-7488-43bf-9bd1-a6138ac437ce",
                                "sense_id": "269ae621-2d20-3e6e-8524-8924b260508d",
                                "text": "Near-synonym: grip"
                            },
                            {
                                "example_id": "b134cbb5-1a53-4103-ab11-690277f32f0c",
                                "sense_id": "269ae621-2d20-3e6e-8524-8924b260508d",
                                "text": "As well as demonstrating operating facilities, full-size car body models are used for experimenting with new types of interior finish, systems of lighting, positioning of route diagrams and advertisements, and the best form of windscreens at doorways, and the height and location of handgrips and handrails."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bea4c31-dceb-3710-98b9-02ee82946a87",
                        "entry_id": "7a22e3bd-d961-314b-b250-27233a2832b8",
                        "glosses": [
                            "A covering (often rubber or foam) on a handle, designed to allow the user a more comfortable or more secure hold on the handle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e3fc52f-cb2e-4728-96a9-6aedabc6d774",
                                "sense_id": "9bea4c31-dceb-3710-98b9-02ee82946a87",
                                "text": "Each cane consists of three parts: (1) the handle (which may or may not be covered by a rubber handgrip), (2) the shaft, and (3) the base (which is usually ..."
                            }
                        ]
                    },
                    {
                        "sense_id": "11084fc3-c36c-3a1d-a0e8-90fb50e64e02",
                        "entry_id": "7a22e3bd-d961-314b-b250-27233a2832b8",
                        "glosses": [
                            "A handshake; a way of gripping hands with another person."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09a64158-5fc0-4316-8f39-820b0775d363",
                                "sense_id": "11084fc3-c36c-3a1d-a0e8-90fb50e64e02",
                                "text": "There are also \"secret\" signs and handgrips, which initiates are never supposed to reveal lest they suffer a fate worse than death."
                            }
                        ]
                    },
                    {
                        "sense_id": "74bd8513-3395-3004-a5b6-957745eba4e6",
                        "entry_id": "7a22e3bd-d961-314b-b250-27233a2832b8",
                        "glosses": [
                            "The ability to grip something with a hand."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aca4d88-0c44-4552-aa34-27e9f80fda7a",
                                "sense_id": "74bd8513-3395-3004-a5b6-957745eba4e6",
                                "text": "The patient's handgrip is also tested for muscle strength."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa595164-419a-35c5-a219-51b501b154d3",
                        "entry_id": "7a22e3bd-d961-314b-b250-27233a2832b8",
                        "glosses": [
                            "A grasp or grip."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8eb37ae-aa3b-4cea-9fe8-f08cc16ebcea",
                                "sense_id": "fa595164-419a-35c5-a219-51b501b154d3",
                                "text": "“I heard that this youngster had the strength of thirty men in his handgrip!”"
                            },
                            {
                                "example_id": "26f0c9a4-9255-47b9-b9e0-0f32709ad279",
                                "sense_id": "fa595164-419a-35c5-a219-51b501b154d3",
                                "text": "The captain of evil discovered himself\nin a handgrip harder than anything\nhe had encountered in any man\non the face of the earth."
                            }
                        ]
                    }
                ],
