                                "target_word": "Fachoberschule",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9083449-aaf4-35cb-ac3d-ddf419f38ac0",
                                        "entry_id": "d64511b9-88e6-3ed1-893e-17d3a9dac4de",
                                        "glosses": [
                                            "Schulform im deutschen Bildungssystem, die zur Fachhochschulreife führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f1d0da1-bc9d-4b3e-b4f6-24187362ce64",
                                                "sense_id": "a9083449-aaf4-35cb-ac3d-ddf419f38ac0",
                                                "text": "„Egal welches Schulmodell gewählt wird: jeder verlässt die Wirtschaftsschule mit dem gleichen Mittleren Bildungsabschluss, mit dem eine Fachoberschule, das Gymnasium besucht oder eine Berufsausbildung begonnen werden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e411dd52-92bb-308d-ae2e-cdcd2a7bfc8e",
                                        "entry_id": "d64511b9-88e6-3ed1-893e-17d3a9dac4de",
                                        "glosses": [
                                            "ein Standort von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55c0829e-a7d8-489b-af92-28cbedb0eac9",
                                                "sense_id": "e411dd52-92bb-308d-ae2e-cdcd2a7bfc8e",
                                                "text": "„Das Annette-Kolb-Gymnasium und das Chiemgau-Gymnasium in Traunstein und das Hertzhaimer-Gymnasium in Trostberg sind ebenfalls Schulen im Sachaufwand des Landkreises, dazu kommen die drei Berufsschulen, die Landwirtschaftsschule, die Fachoberschule und Berufsoberschule sowie das Sozialpädagogische Zentrum in Traunstein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
