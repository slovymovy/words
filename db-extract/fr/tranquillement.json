        "fr-extract.jsonl": [
            {
                "entry_id": "96d18160-d28a-3321-b61c-ea4d179c5d20",
                "word": "tranquillement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "de2633a2-0d7e-3d04-acbb-77c9a4459c32",
                        "entry_id": "96d18160-d28a-3321-b61c-ea4d179c5d20",
                        "glosses": [
                            "D’une manière tranquille ; avec tranquillité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79689f8d-350a-49a0-bbf8-bf8bb1f5ce6b",
                                "sense_id": "de2633a2-0d7e-3d04-acbb-77c9a4459c32",
                                "text": "Le uhlan mettait pied à terre, ouvrait tranquillement une carte ou un calepin, prenait des notes."
                            },
                            {
                                "example_id": "8e64e10c-4c66-4f99-83a0-eb6e7ac0a587",
                                "sense_id": "de2633a2-0d7e-3d04-acbb-77c9a4459c32",
                                "text": "Le départ du défenseur devrait au moins permettre à John Textor de passer plus tranquillement son grand oral devant la DNCG, ce mercredi."
                            },
                            {
                                "example_id": "dca1ada4-7d30-459a-9e89-f8970b055786",
                                "sense_id": "de2633a2-0d7e-3d04-acbb-77c9a4459c32",
                                "text": "Mais, saperlotte ! tâchons donc que tout ça se passe tranquillement; ça vaudrait beaucoup mieux. Puisque nous avons le suffrage universel, il n’y a plus besoin de coups de fusil."
                            },
                            {
                                "example_id": "b67a8ead-6809-488d-b89d-ed78bc6c2d6e",
                                "sense_id": "de2633a2-0d7e-3d04-acbb-77c9a4459c32",
                                "text": "Et Charles IX se remit à siffler tranquillement et plus juste que jamais son air favori."
                            },
                            {
                                "example_id": "19a396ed-e9ab-4fd2-9e24-5d1ffae916eb",
                                "sense_id": "de2633a2-0d7e-3d04-acbb-77c9a4459c32",
                                "text": "Préviens ta femme de ton arrivée. Ça me laissera le temps de passer tranquillement mon froc et de ne pas enfiler, dans la précipitation, mon slip à l'envers."
                            },
                            {
                                "example_id": "52cd3a1b-af4b-4f65-bdd7-ac3fbcd35916",
                                "sense_id": "de2633a2-0d7e-3d04-acbb-77c9a4459c32",
                                "text": "Si jamais le prince de Condé parut un homme extraordinaire, s’il parut voir tranquillement toutes choses, c’est dans ces rapides moments d’où dépendent les victoires,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5fbe60e-c4a5-4e37-9e72-4a672ba06cf6",
                        "source_entry_id": "96d18160-d28a-3321-b61c-ea4d179c5d20",
                        "source_sense_id": "de2633a2-0d7e-3d04-acbb-77c9a4459c32",
                        "source_sense_description": "D’une manière tranquille",
                        "target_lang_word": "calmly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calmly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ff918e0-7c12-3566-befd-7e6ac0ba2f3c",
                                        "entry_id": "636671f3-ff5b-364c-aeb4-196392addb1e",
                                        "glosses": [
                                            "In a calm manner; coolly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0244a25-f6fc-4d45-b7b4-d19a81d2c22b",
                                                "sense_id": "9ff918e0-7c12-3566-befd-7e6ac0ba2f3c",
                                                "text": "She ran to the door and there beheld the ragged street urchin calmly playing his organ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45ae156a-cf83-4737-be64-5e0622c39f6d",
                        "source_entry_id": "96d18160-d28a-3321-b61c-ea4d179c5d20",
                        "source_sense_id": "de2633a2-0d7e-3d04-acbb-77c9a4459c32",
                        "source_sense_description": "D’une manière tranquille",
                        "target_lang_word": "easily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "easily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74f8b005-0de0-34a6-8f13-a303b9ded51e",
                                        "entry_id": "bf6260e9-3b3e-33bb-9d14-62d75892a580",
                                        "glosses": [
                                            "Comfortably, without discomfort or anxiety."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cef2a41d-c145-4478-969b-08be97e52d1f",
                                                "sense_id": "74f8b005-0de0-34a6-8f13-a303b9ded51e",
                                                "text": "Eftsoones she causd him vp to be conuayd, / And of his armes despoyled easily […]"
                                            },
                                            {
                                                "example_id": "e5697fbd-63a0-4e85-9de0-20171846afe1",
                                                "sense_id": "74f8b005-0de0-34a6-8f13-a303b9ded51e",
                                                "text": "Why this already very fast train should be speeded up still further, when none of the other more easily timed S.R. West of England trains has a single minute pared from its schedule, is unexplained - unless this is a playful dig at the Western Region, most of whose expresses, by reason of additional stops, will be decelerated from the same date."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ddacfbc-bf5a-3a7b-a21d-fba3769a7c19",
                                        "entry_id": "bf6260e9-3b3e-33bb-9d14-62d75892a580",
                                        "glosses": [
                                            "Without difficulty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ec2c8d4-67a1-4ebc-8d41-2b229f1edffc",
                                                "sense_id": "4ddacfbc-bf5a-3a7b-a21d-fba3769a7c19",
                                                "text": "Individuals without a family network are easily controlled."
                                            },
                                            {
                                                "example_id": "440a8791-4a61-4fbf-8ffa-38b5c81cd629",
                                                "sense_id": "4ddacfbc-bf5a-3a7b-a21d-fba3769a7c19",
                                                "text": "Carried somehow, somewhither, for some reason, on these surging floods, were these travelers, of errand not wholly obvious to their fellows, yet of such sort as to call into query alike the nature of their errand and their own relations. It is easily earned repetition to state that Josephine St. Auban's was a presence not to be concealed."
                                            },
                                            {
                                                "example_id": "d640ae62-ba5d-4b09-ab46-a5bed5e1fda5",
                                                "sense_id": "4ddacfbc-bf5a-3a7b-a21d-fba3769a7c19",
                                                "text": "One saint's day in mid-term a certain newly appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.” He at once secured attention by his informal method, and when presently the coughing of Jarvis[…]interrupted the sermon, he altogether captivated his audience with a remark about cough lozenges being cheap and easily procurable."
                                            },
                                            {
                                                "example_id": "a2948249-cde3-43b6-a33e-21a2b3256298",
                                                "sense_id": "4ddacfbc-bf5a-3a7b-a21d-fba3769a7c19",
                                                "text": "For instance, if the girl character is getting rescued by a boy, we can tell our girls the story could easily have been changed so the girl is doing the rescuing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40c6e3f8-c748-3fd9-aee9-7cd81d972a0b",
                                        "entry_id": "bf6260e9-3b3e-33bb-9d14-62d75892a580",
                                        "glosses": [
                                            "Absolutely, without question."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9ee722e-81e5-487a-9f6a-e04950359ac3",
                                                "sense_id": "40c6e3f8-c748-3fd9-aee9-7cd81d972a0b",
                                                "text": "This is easily the best meal I have eaten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c7fd022-a5b8-3ae4-92fb-0cc98f388cbd",
                                        "entry_id": "bf6260e9-3b3e-33bb-9d14-62d75892a580",
                                        "glosses": [
                                            "More quickly or likely than is usual or expected."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96572097-814b-40c4-904a-b04bc5c9937b",
                                                "sense_id": "1c7fd022-a5b8-3ae4-92fb-0cc98f388cbd",
                                                "text": "not easily offended"
                                            },
                                            {
                                                "example_id": "461767dd-94d7-47fb-aa1f-d73228851226",
                                                "sense_id": "1c7fd022-a5b8-3ae4-92fb-0cc98f388cbd",
                                                "text": "I get distracted very easily."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "004319e2-8bb4-46b3-a569-718e4c5f217f",
                        "source_entry_id": "96d18160-d28a-3321-b61c-ea4d179c5d20",
                        "source_sense_id": "de2633a2-0d7e-3d04-acbb-77c9a4459c32",
