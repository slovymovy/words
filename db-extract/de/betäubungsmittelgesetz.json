                "senses": [
                    {
                        "sense_id": "95a164cf-c8e6-3e9f-80d5-c4895d63de5c",
                        "entry_id": "d1c79b06-1a76-3c8e-b96d-b716f3c39e1a",
                        "glosses": [
                            "Gesetz, das den Umgang mit Betäubungsmitteln in Deutschland regelt und ein Verzeichnis enthält, welche Stoffe hiervon betroffen sind"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "770a0159-7ef6-4b5a-aa60-43200e39f0a0",
                                "sense_id": "95a164cf-c8e6-3e9f-80d5-c4895d63de5c",
                                "text": "„In Deutschland ist der Anbau, Erwerb, Besitz, Handel, sowie die Weitergabe von Substanzen, die dem Betäubungsmittelgesetz unterstellt sind, strafbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "20906f82-9d1c-3e39-b3a1-fe559ccff3be",
                        "entry_id": "d1c79b06-1a76-3c8e-b96d-b716f3c39e1a",
                        "glosses": [
                            "Gesetz, das den Umgang mit Betäubungsmitteln und psychotropen Stoffen in der Schweiz regelt und ein Verzeichnis enthält, welche Stoffe hiervon betroffen sind"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "9a072d1d-2741-4dc7-a6ac-fb21b2a47bff",
                                "sense_id": "20906f82-9d1c-3e39-b3a1-fe559ccff3be",
                                "text": "„Nach kleineren Änderungen mit Anpassungen an internationale Übereinkommen folgte 1975 die letzte grosse Revision des Betäubungsmittelgesetzes (BetmG), das noch heute weitgehend gültig ist.“"
                            }
                        ],
