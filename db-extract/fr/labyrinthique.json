                                        "glosses": [
                                            "Like a maze; labyrinthine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb686acc-c460-4e36-af8b-953a498f0a5a",
                                                "sense_id": "03fe7681-c5a2-3aaa-8961-26cfd4699542",
                                                "text": "If a military man with AIDS were discharged for homosexuality, he would lose his medical benefits and be thrown into the already overtaxed and maze-like system of public welfare."
                                            },
                                            {
                                                "example_id": "49d3f412-8d15-400e-9cb5-39de2b644d8a",
                                                "sense_id": "03fe7681-c5a2-3aaa-8961-26cfd4699542",
                                                "text": "The dark New York restaurant is a mazelike “ninja village,” with iron bars and cold stone lining the walls."
                                            }
                                        ]
