                ],
                "senses": [
                    {
                        "sense_id": "3de8a160-35f8-3b77-b973-38cf38e0121d",
                        "entry_id": "39379696-500c-31df-aa1c-f26f4e616ade",
                        "glosses": [
                            "durch zu wenig Einsatz/Pflege oder zu geringe materielle Mittel verursachter Mangelzustand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b4637ea-77ad-440c-a14c-4df298d5c4a1",
                                "sense_id": "3de8a160-35f8-3b77-b973-38cf38e0121d",
                                "text": "„Was sie auszeichnete, war einzig ein gewisser Einfallsreichtum an Verwahrlosung, der sich bis auf die Straßen und in die Hinterhöfe fortsetzte.“"
                            },
                            {
                                "example_id": "81edee96-48d4-41c2-8076-454040016315",
                                "sense_id": "3de8a160-35f8-3b77-b973-38cf38e0121d",
                                "text": "„Der Unterversorgung folgte in vielen Vierteln der Reichshauptstadt offene Verwahrlosung.“"
                            },
                            {
                                "example_id": "130e6eb3-ace9-434f-9b9a-03edcd757361",
                                "sense_id": "3de8a160-35f8-3b77-b973-38cf38e0121d",
                                "text": "„Mehr denn je ward sich Robert der Verwahrlosung inne, die aus aller Umgebung sprach, Türen hingen halb in den Angeln, Zaunlücken waren ohne Sorgfalt mit zufälligem Ersatz verstellt, mit zerfetzten Säcken, herausgeborstenen Dachplatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9c5a3de7-8a78-3575-b4c8-7945077913d7",
                        "entry_id": "39379696-500c-31df-aa1c-f26f4e616ade",
                        "glosses": [
                            "Prozess/Verlauf, der zu einem Mangelzustand führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50c33a29-92ba-477a-956a-d977d3175804",
                                "sense_id": "9c5a3de7-8a78-3575-b4c8-7945077913d7",
                                "text": "„Wie früher erwähnt, hatte sich der Hof Laxnes in den Jahren zuvor in ständiger Verwahrlosung befunden, vor allem aber, nachdem Pferdehändler Páll Vídalín das Anwesen aufgegeben hatte.“"
                            },
                            {
                                "example_id": "00f3bf4d-4c85-4533-9325-39e8cd4bf79f",
                                "sense_id": "9c5a3de7-8a78-3575-b4c8-7945077913d7",
                                "text": "Man konnte dabei zusehen, wie seine Verwahrlosung immer weiter zunahm."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
