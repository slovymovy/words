                    "sense_id": "be73b75a-cb4a-384d-82ef-aebf2de57415",
                    "sense_definition": "Altérer gravement l'aspect physique de quelqu'un, en particulier son visage, ou gâcher l'apparence d'un lieu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce violent accident de la route a failli lui <w>défigurer</w> le visage à jamais."
                        },
                        {
                            "text": "La construction de cette immense tour moderne risque de <w>défigurer</w> tout le quartier historique."
                        }
                    ],
                    "synonyms": [
