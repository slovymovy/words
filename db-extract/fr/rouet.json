                                        "glosses": [
                                            "A domestic device for making yarn or thread; having a single spindle and a wheel driven by hand or foot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1d568fa-eb04-4ae5-b367-121cf7595e43",
                                                "sense_id": "1544a940-4a93-37ff-9c6b-31f62b713135",
                                                "text": "Dobrunka always began the day by feeding the goats, then she prepared the breakfast, swept the kitchen, and when everything else was done she sat down at her spinning wheel and spun."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
