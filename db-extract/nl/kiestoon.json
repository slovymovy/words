                                "sense_id": "a8f380e7-217c-366c-94ee-18d8c0f5947e",
                                "text": "De kiestoon van oude telefoons klinkt anders dan moderne.",
                                "translation": "The dialling tone of old phones sounds different than modern ones.",
                                "english": "The dialling tone of old phones sounds different than modern ones."
                            },
