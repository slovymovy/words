                        "examples": [
                            {
                                "example_id": "5b2f3584-d771-4932-8c2a-eeb498d8154b",
                                "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Dobermann das Schmücken von Weihnachtsbäumen."
                            },
                            {
                                "example_id": "03e65c03-5d6e-4a59-8052-7f6b0b0ca764",
                                "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                "text": "Frau Dobermann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "198ce5b2-bb37-4701-9606-3276cef9b9f9",
                                "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                "text": "Herr Dobermann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "94980f7f-0e35-4dea-bdb1-c55f7d8f6ecf",
                                "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                "text": "Die Dobermanns kommen heute aus dem Saaletal."
                            },
                            {
                                "example_id": "d851588f-786d-4aa2-883b-bff654026855",
                                "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                "text": "Der Dobermann trägt nie die Schals, die die Dobermann ihm strickt."
                            },
                            {
                                "example_id": "1ec40dfb-e8f3-497f-adb6-1c5cf49bd94a",
                                "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Dobermann kommt, geht der Herr Dobermann.“"
                            },
                            {
                                "example_id": "88202da7-4fad-46fc-9e93-087442a010e6",
                                "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                "text": "Dobermann kommt und geht."
                            },
                            {
                                "example_id": "8310b86f-d8e6-472b-b076-9373d0761132",
                                "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                "text": "Dobermanns kamen, sahen und siegten."
                            },
                            {
                                "example_id": "c00a313d-c482-45eb-845b-8dd75d573d6d",
                                "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                "text": "An verregneten Herbsttagen ist Familie Dobermanns liebste Beschäftigung das Bemalen von Hühnereiern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
