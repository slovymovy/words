                        "tags": [],
                        "examples": [
                            {
                                "example_id": "982ed46a-ec14-4375-bde4-ea1db73fa2d2",
                                "sense_id": "316b9af7-a192-3d81-a805-db3180b18433",
                                "text": "„Für Nicht-Paschtunen bildet der zurückgegangene Bevölkerungsanteil der Paschtunen daher seit den achtziger Jahren das wichtigste Argument gegen deren Hegemonieanspruch.“"
                            },
                            {
                                "example_id": "e421160f-de6f-4e9c-b935-20ab9c3c6144",
                                "sense_id": "316b9af7-a192-3d81-a805-db3180b18433",
                                "text": "„Syrien sah seinen Hegemonieanspruch im Libanon durch Aouns erklärtes Bestreben, die Syrer aus dem Land zu vertreiben, gefährdet und startete im März 1989 eine bis in den Spätsommer dauernde Offensive gegen dessen Truppen, die auf beiden Seiten zahlreiche Opfer forderte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
