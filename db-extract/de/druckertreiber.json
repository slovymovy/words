                "senses": [
                    {
                        "sense_id": "d0f2954a-6c1f-31bb-b81b-b801ca355141",
                        "entry_id": "33f37b4f-620c-362c-9a4a-1c6bf5bae63d",
                        "glosses": [
                            "Computerprogramm, das die Steuerung eines angeschlossenen Druckers ermöglicht"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "446b29cd-6e69-41fb-9497-c02fe6797057",
                                "sense_id": "d0f2954a-6c1f-31bb-b81b-b801ca355141",
                                "text": "„Die Do-it-yourself-Bastler versuchen nach und nach, zu so etwas wie einem gemeinsamen standardisierten Konzept der Formwandlungsmaschinen zu kommen - das, was man heute gemeinhin als Druckertreiber kennt.“"
                            },
                            {
                                "example_id": "2b569a5c-72ea-4d75-96f8-08908f445422",
                                "sense_id": "d0f2954a-6c1f-31bb-b81b-b801ca355141",
                                "text": "„Sofern ein PostScript-Laserdrucker bereitsteht, genügt es, im Dialog für die Eigenschaften des Druckertreibers (Systemsteuerung/Drucker/Eigenschaften) in der Registerkarte `Grafik´ die Checkbox `Spiegelverkehrt drucken´ zu aktivieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
