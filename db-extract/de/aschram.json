                                "target_senses": [
                                    {
                                        "sense_id": "b3577cf9-e1ab-39c4-8fc6-1291cbf02b60",
                                        "entry_id": "4069386b-bd44-3a04-8ccb-173507737a55",
                                        "glosses": [
                                            "A secluded religious hermitage inhabited by gurus, or the population of such a hermitage."
                                        ],
                                        "tags": [
                                            "Hinduism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ce417ef-ac66-4350-9121-80d3e1c4bf66",
                                                "sense_id": "b3577cf9-e1ab-39c4-8fc6-1291cbf02b60",
                                                "text": "The entire ashram was excited."
                                            },
                                            {
                                                "example_id": "b4e17c0c-7d33-4636-8586-f6eda4593488",
                                                "sense_id": "b3577cf9-e1ab-39c4-8fc6-1291cbf02b60",
                                                "text": "In our broken culture those who have experienced the training of the yogic ashram are often woefully ignorant in the ways of the university, and vice versa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6183b96d-11a4-440a-87fc-2c109b85fede",
                        "source_entry_id": "0b7ae4dc-233d-36e8-866a-67bc7e2bc0e3",
                        "source_sense_id": "02821bee-852f-3da0-9bfa-da514485e1dc",
