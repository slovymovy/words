                                "target_senses": [
                                    {
                                        "sense_id": "22954c29-ccc8-3185-8130-083171c4c171",
                                        "entry_id": "a9db223b-aeea-3fed-a524-362b40a5ff26",
                                        "glosses": [
                                            "chemische Verbindung, die benutzt wird, um andere Materialien zu färben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0b212c5-8f59-4bd9-acd4-e00ac7349f67",
                                                "sense_id": "22954c29-ccc8-3185-8130-083171c4c171",
                                                "text": "Heute wurden die meisten natürlichen Farbstoffe durch künstliche Chemikalien ersetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
