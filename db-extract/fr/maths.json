                                "target_senses": [
                                    {
                                        "sense_id": "8ee29210-1924-3bac-b034-2e0f5b62d039",
                                        "entry_id": "bb334df5-2582-305a-add6-1c1cd665b9d4",
                                        "glosses": [
                                            "Clipping of mathematics."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US",
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0913dd9-d019-499d-a140-461e24a64d62",
                                                "sense_id": "8ee29210-1924-3bac-b034-2e0f5b62d039",
                                                "text": "Clarke stumbled into music by way of a high school course he took to raise his grades. \"Music was a bird course. I had more interest in math, science, and women\", he divulged."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "434ca898-b6c5-3b6c-808e-a4f773350ebc",
                                        "entry_id": "bb334df5-2582-305a-add6-1c1cd665b9d4",
                                        "glosses": [
                                            "Arithmetic calculations; (see do the math)."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69236599-27b5-41bf-ac59-ce59de8636a7",
                                                "sense_id": "434ca898-b6c5-3b6c-808e-a4f773350ebc",
                                                "text": "If you do the math, you'll see that it’s not such a bargain."
                                            },
                                            {
                                                "example_id": "799d71a1-d28e-4ffb-a228-caf1ab2bb9ee",
                                                "sense_id": "434ca898-b6c5-3b6c-808e-a4f773350ebc",
                                                "text": "$170 a month? That doesn’t sound right. Let me check your math."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79e9a732-5fa8-3b9e-b72d-13803043e2b1",
                                        "entry_id": "bb334df5-2582-305a-add6-1c1cd665b9d4",
                                        "glosses": [
                                            "A math course or class."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US",
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a045459-c1ee-4f62-a416-f294debbc63f",
                                                "sense_id": "79e9a732-5fa8-3b9e-b72d-13803043e2b1",
                                                "text": "They needed to take two more maths in order to graduate."
                                            },
                                            {
                                                "example_id": "2611fad6-8bde-4fb5-b282-772eba43649f",
                                                "sense_id": "79e9a732-5fa8-3b9e-b72d-13803043e2b1",
                                                "text": "Did you take math today? / What did you do in math today?"
                                            },
                                            {
                                                "example_id": "d22e6417-a0ca-49b6-9e20-ea024069eab5",
                                                "sense_id": "79e9a732-5fa8-3b9e-b72d-13803043e2b1",
                                                "text": "Then, I further worked myself into an A+ panic attack with the realization that on top of the algebra, I would have to take three more maths, from a choice of calculus, finite math, statistics, logic, or differential equation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "math",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81e1744f-25f7-346e-bf4f-75a53aa30df7",
                                        "entry_id": "735e2d61-a9a1-36c5-b6a2-1527df8b9493",
                                        "glosses": [
                                            "To perform mathematical calculations or mathematical analysis; to do math"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79c1b0b2-0a42-3b5f-91c3-e1ae4428b495",
                                        "entry_id": "735e2d61-a9a1-36c5-b6a2-1527df8b9493",
                                        "glosses": [
                                            "To add up, compute; (by extension) to make sense."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de4c323a-9084-4469-b08f-225e8e30593f",
                                                "sense_id": "79c1b0b2-0a42-3b5f-91c3-e1ae4428b495",
                                                "text": "Wait. This doesn't make sense. I mean, the math is not mathing."
                                            },
                                            {
                                                "example_id": "566736c6-7b93-4d05-9527-6d88535967c7",
                                                "sense_id": "79c1b0b2-0a42-3b5f-91c3-e1ae4428b495",
                                                "text": "Some of the same people who called for the abolishment of the monarchy back during that explosive Oprah interview are now saying how sweet it is that baby Lili is named after her grandmother, how perfectly it fits her, and the math isn’t mathing. There is a fundamental contradiction here."
                                            },
                                            {
                                                "example_id": "83181020-5819-4129-a29e-e857b6e98705",
                                                "sense_id": "79c1b0b2-0a42-3b5f-91c3-e1ae4428b495",
                                                "text": "Following intense speculation over the account’s veracity, fellow manga artist Yusuke Murata, the creator behind One-Punch Man, confirmed that the account indeed belongs to Togashi. The math started mathing for Hunter x Hunter fans, who are hoping there will be new installments of the manga on the way."
                                            }
                                        ]
                                    }
                                ]
                            },
