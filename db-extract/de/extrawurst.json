                "senses": [
                    {
                        "sense_id": "ed150458-6d94-33a3-8875-30b1658d68e5",
                        "entry_id": "7ea3e2bb-954b-3792-ad54-4376e48b82d8",
                        "glosses": [
                            "Saucisse à l'ail, saucisson à l'ail."
                        ],
                        "tags": [
                            "Autriche"
                        ],
                        "examples": [
                            {
                                "example_id": "8d3054dc-4707-4b85-8d1f-95d62d324d25",
                                "sense_id": "ed150458-6d94-33a3-8875-30b1658d68e5",
                                "text": "Grüß Gott, ich hätt’ gern 25 Deka Extrawurst.",
                                "translation": "Bonjour, je voudrais 250 g de saucisson à l'ail."
                            }
                        ]
                    },
                    {
                        "sense_id": "58679378-e1d3-35c5-b4f3-14841b7ca99e",
                        "entry_id": "7ea3e2bb-954b-3792-ad54-4376e48b82d8",
                        "glosses": [
                            "dans certaines expressions Régime de faveur, traitement à part."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3496b452-0935-42e9-85d4-03df792cc668",
                                "sense_id": "58679378-e1d3-35c5-b4f3-14841b7ca99e",
                                "text": "Sie will immer eine Extrawurst bekommen.",
                                "translation": "Elle veut toujours qu'on la traite à part."
                            },
                            {
                                "example_id": "c737ee78-96dd-4de9-a2ec-81108d0970fc",
                                "sense_id": "58679378-e1d3-35c5-b4f3-14841b7ca99e",
                                "text": "In der Familie gibt es keine Extrawürste.",
                                "translation": "Dans la famille il n'y a pas de traitements de faveur."
                            },
                            {
                                "example_id": "7c889b24-edcc-49a8-ae51-7df808c3d723",
                                "sense_id": "58679378-e1d3-35c5-b4f3-14841b7ca99e",
                                "text": "Ich habe dir eine Extrawurst gebraten.",
                                "translation": "Je t'ai fait une fleur."
                            }
                        ]
                    }
                ],
