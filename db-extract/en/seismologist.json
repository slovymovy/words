                                    {
                                        "sense_id": "b3497b29-b507-3132-a4b5-7b49a31f962c",
                                        "entry_id": "e1a983e2-cd3d-35ed-a8a6-9be108ace0e3",
                                        "glosses": [
                                            "Person, die sich mit der Seismologie beschäftigt, also Erdbeben erforscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3d9523f-e59e-4cdd-9aee-cfa60c4ab72d",
                                                "sense_id": "b3497b29-b507-3132-a4b5-7b49a31f962c",
                                                "text": "„Mithilfe von künstlichen und echten Erdbebenwellen können Seismologen in unerreichbare Tiefen unseres Planeten blicken, ähnlich wie sich ein Arzt mittels Ultraschall ein Bild vom Innern unseres Körpers macht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eeea87ed-dd0a-459d-a7c8-eeab105c4fec",
                        "source_entry_id": "755277a1-1cd2-3e13-96fd-3720a2027f8a",
                        "source_sense_id": "6f51d097-5e2d-3efe-915e-feee66641d61",
                        "source_sense_description": "person who practices seismology",
                        "target_lang_word": "Seismologin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seismologin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "edb410e2-15f6-35e1-8eeb-4c71fa71719f",
                                        "entry_id": "f6798987-29f8-3d4d-b5c1-d3d25b77f551",
                                        "glosses": [
                                            "weibliche Person, die sich mit der Seismologie beschäftigt, also Erdbeben erforscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "545eb7d8-9af9-4a59-ae23-5a45563b179b",
                                                "sense_id": "edb410e2-15f6-35e1-8eeb-4c71fa71719f",
                                                "text": "„Man könne nicht vorhersagen, ob es in den kommenden Tagen und Wochen noch zu stärkeren oder gleich starken Nachbeben komme, sagte die Seismologin auf Nachfrage.“"
                                            },
                                            {
                                                "example_id": "8dbe4188-1409-49d6-b045-8148d76d48ff",
                                                "sense_id": "edb410e2-15f6-35e1-8eeb-4c71fa71719f",
                                                "text": "„Die Londoner Seismologin Paula Koelemeijer hat einen deutlichen Rückgang der durch menschliche Aktivitäten verursachten Schwingungen festgestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
