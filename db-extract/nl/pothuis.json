                        "sense_id": "4fc2be22-a22e-3181-8f28-629f8aecc70e",
                        "entry_id": "abb25900-d3d1-3ca3-a1e6-9d3d0f34ebba",
                        "glosses": [
                            "laag bouwsel met aflopend dak voor of naast een gebouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e0b2abb-76c6-4edf-b911-def620d1cbdd",
                                "sense_id": "4fc2be22-a22e-3181-8f28-629f8aecc70e",
                                "text": "Tegelijkertijd zijn de terrassen in de straat de afgelopen tijd flink ingekrompen. Twee krukjes die buiten staan bij café De Ooievaar: het mag niet. Kussens op het bijbehorende pothuis: het mag niet. Een gevelbankje bij 't Aepjen, Het Elfde Gebod, de Barderij of Verhoeff: het mag niet. Alles moet weg. \"Daarmee wordt de leefbaarheid kapotgemaakt\", zegt de uitbaatster van Het Elfde Gebod."
                            },
                            {
                                "example_id": "ef755648-5792-41b2-8314-e3664336113c",
                                "sense_id": "4fc2be22-a22e-3181-8f28-629f8aecc70e",
                                "text": "Iedereen die op de Prinsengracht langs het Algerijnse zaakje loopt, ziet op het pothuis de groente al liggen. Dat wordt gedoogd. „Het is mooi om te zien”, vindt Khellout die in de culinaire wereld bekend staat door zijn twee kookboeken waarin bij iedereen het water in de mond loopt."
                            }
                        ]
                    }
