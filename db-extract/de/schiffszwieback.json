                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b5e9f4d-08f2-47b3-9154-66994508dc24",
                                                "sense_id": "99b170f0-7f4e-32df-9d5e-3a80d3d8c6f3",
                                                "text": "I found nothing else to do but to offer him one of my good Swede’s ship’s biscuits I had in my pocket."
                                            },
                                            {
                                                "example_id": "24b95ce9-5ffb-4751-8d96-b4b4a502e813",
                                                "sense_id": "99b170f0-7f4e-32df-9d5e-3a80d3d8c6f3",
                                                "text": "I found a ship's biscuit and a wizened apple in my sketch sack. They smelled of turpentine and revolted my appetite. At dusk I ate them greedily."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
