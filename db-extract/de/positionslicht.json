                                "target_senses": [
                                    {
                                        "sense_id": "e67a7676-cdc0-34c6-9d43-f47efd59dd02",
                                        "entry_id": "7f6aad0f-8606-310e-b9ce-b68d7f95d00f",
                                        "glosses": [
                                            "Dispositif d’éclairage équipant les véhicules et signalant leur présence aux autres usagers la nuit et lorsque les conditions de visibilité sont mauvaises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38673059-a3a9-45a3-af65-946eb5403bee",
                                                "sense_id": "e67a7676-cdc0-34c6-9d43-f47efd59dd02",
                                                "text": "Quelles sont les conséquences en cas de panne d’un feu de position arrière ? Réponse : Être mal vu et un risque de collision."
                                            },
                                            {
                                                "example_id": "e5b3f0dd-4904-454c-b62f-043dd8831b75",
                                                "sense_id": "e67a7676-cdc0-34c6-9d43-f47efd59dd02",
                                                "text": "En cas de circulation dans une ville éclairée, l’automobiliste doit recourir à l’usage exclusif des feux de position (veilleuses) ou des feux de croisement. Si la ville n’est pas éclairée, l’automobiliste doit allumer ses feux de croisement ou de route (plein phare) sans gêner les usagers circulant en face."
                                            },
                                            {
                                                "example_id": "e99e0871-6d1a-4246-be75-b9b76cfc6be6",
                                                "sense_id": "e67a7676-cdc0-34c6-9d43-f47efd59dd02",
                                                "text": "Les feux de position clignotèrent et les portes se déverrouillèrent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7245b024-bc61-3e58-a968-afaf5013e0d2",
                                        "entry_id": "7f6aad0f-8606-310e-b9ce-b68d7f95d00f",
                                        "glosses": [
                                            "Poisson de la famille des Characidés, Hemigrammus ocellifer."
                                        ],
