                "senses": [
                    {
                        "sense_id": "2d681377-a853-38c8-92eb-12d317d005cc",
                        "entry_id": "afb82676-c254-3597-a4b3-086d87a12494",
                        "glosses": [
                            "Staatsbürgerin von Mazedonien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "436075a7-d02f-4df8-9f6f-5f83ad212a0a",
                                "sense_id": "2d681377-a853-38c8-92eb-12d317d005cc",
                                "text": "„Alexander verliebte sich völlig in sie. Sie war nicht Griechin, nicht Mazedonin, aber doch Indogermanin und artverwandt, und er warf jetzt alle Vorurteile seines Volkes hintan und machte sie durch vollgültige Ehe zu seiner Königin.“"
                            },
                            {
                                "example_id": "fa66d371-73b8-4be5-9360-6f3b2b7be999",
                                "sense_id": "2d681377-a853-38c8-92eb-12d317d005cc",
                                "text": "„Die Mazedonin Karolina Godeva sang einen Teil ihres Liedes \"Od nas zavisi\" auf Englisch - nach langen Debatten mit ihrem nationalen Fernsehsender setzte sie sich durch und hatte damit Erfolg.“"
                            },
                            {
                                "example_id": "ac641585-93d8-40a3-b9e4-2788f4e8f9a2",
                                "sense_id": "2d681377-a853-38c8-92eb-12d317d005cc",
                                "text": "„Sie sind Freundinnen geworden, die impulsiv wirkende Mazedonin und die ruhigere Slowakin.“"
                            },
                            {
                                "example_id": "6a1857ac-0145-47da-9041-f67c61007a19",
                                "sense_id": "2d681377-a853-38c8-92eb-12d317d005cc",
                                "text": "„Die Mazedoninnen waren als Dritte ihrer Gruppe in der Champions-League gescheitert und wurden den Leverkusenern entsprechend zugelost.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94ea56e2-2b2d-4764-8334-c543f247b032",
                        "source_entry_id": "afb82676-c254-3597-a4b3-086d87a12494",
                        "source_sense_id": "2d681377-a853-38c8-92eb-12d317d005cc",
