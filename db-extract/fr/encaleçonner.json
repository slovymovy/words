                                "example_id": "7d93db88-1ff1-43e2-b078-042b05d03819",
                                "sense_id": "3abd2456-9370-36a7-b83d-d0c9669da8ce",
                                "text": "Tandis que la société Coup de Cœur se diversifie tous azimuts (chaussons, peignoirs) et n’hésite pas à encaleçonner les statues des Tuileries pour faire parler d’elle, Billichic se garde bien de tout faux mouvement."
                            },
                            {
                                "example_id": "2d4ad4a5-1d8b-4259-bdfe-7c75d2fbd136",
                                "sense_id": "3abd2456-9370-36a7-b83d-d0c9669da8ce",
                                "text": "Il fallut draper les sexes, encaleçonner les cuisses."
                            }
                        ]
