                    "frequency": "High",
                    "semantic_group_id": "geografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>Region</w> um den Bodensee zieht jedes Jahr viele Touristen an."
                        },
                        {
                            "text": "In einer ländlichen <w>Region</w> sind viele Menschen auf das eigene Auto angewiesen."
                        }
                    ],
                    "synonyms": [
                        "Gebiet",
                        "Gegend",
                        "Landschaft"
                    ],
                    "common_phrases": [
