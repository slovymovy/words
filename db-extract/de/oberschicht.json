                    {
                        "form_id": "1f26f619-4459-4278-99b3-ef3adf720c63",
                        "entry_id": "68f9e571-a38a-31ec-8ac7-ef08539b7a9b",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Oberschicht"
                    },
                    {
                        "form_id": "f95d6933-ed6f-4753-8c61-da464ba6af53",
                        "entry_id": "68f9e571-a38a-31ec-8ac7-ef08539b7a9b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Oberschichten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "446b1000-510a-346e-b26f-07c224fe88f9",
                        "entry_id": "68f9e571-a38a-31ec-8ac7-ef08539b7a9b",
                        "glosses": [
                            "eine Schicht, die sich über mindestens einer anderen Schicht befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df636c3a-c5c5-4dd0-9c11-b2f60515e44e",
                                "sense_id": "446b1000-510a-346e-b26f-07c224fe88f9",
                                "text": "„Beim Laubwald weiche Bodenauflage; darunter eine ausgeprägt krümelige, lockere und humusreiche Oberschicht mit starker tierischer Aktivität. “"
                            },
                            {
                                "example_id": "e2505442-96b6-4a43-9576-69b2975cfd8d",
                                "sense_id": "446b1000-510a-346e-b26f-07c224fe88f9",
                                "text": "„Eine gut gepflegte Regenwurmpopulation pflügt in 10 Jahren die ganze Oberschicht des Bodens um.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d3bb07c9-c655-315c-8974-7d4388ddba56",
                        "entry_id": "68f9e571-a38a-31ec-8ac7-ef08539b7a9b",
                        "glosses": [
                            "oberste Schicht einer Bevölkerung, die über die höchsten Einkommen und/oder den höchsten Lebensstandard verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "605bc967-7ed4-4b03-8b87-924a90180a3e",
                                "sense_id": "d3bb07c9-c655-315c-8974-7d4388ddba56",
                                "text": "„Die Einteilung in die verschiedenen Kategorien ist denkbar einfach, denn es gibt im Grunde nur zwei davon: die Angehörigen der Unterschicht und die der Oberschicht.“"
                            },
                            {
                                "example_id": "c23f5458-093d-475a-9e3f-7ff878877b06",
                                "sense_id": "d3bb07c9-c655-315c-8974-7d4388ddba56",
                                "text": "„Die Krise verschärfte sich erheblich, als im Jahre 455 die Vandalen Rom einnahmen, die Stadt plünderten, die Oberschicht gefangen nahmen und erst nach Zahlung eines hohen Lösegeldes entließen.“"
                            },
                            {
                                "example_id": "e8a2966a-f447-47eb-8ab2-f634e69e3c69",
                                "sense_id": "d3bb07c9-c655-315c-8974-7d4388ddba56",
                                "text": "„Es gab so gut wie keine gesellschaftliche Oberschicht, deren Interessen akut gefährdet waren.“"
                            },
                            {
                                "example_id": "7b19b2ad-a673-4062-8a77-f7ba8ca6f646",
                                "sense_id": "d3bb07c9-c655-315c-8974-7d4388ddba56",
                                "text": "„Die Oberschicht ist natürlich nicht besser oder schlimmer als die sogenannte Unterschicht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
