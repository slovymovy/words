                        "cross_references": [
                            {
                                "target_word": "Confucianism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fbd4ddd-95cf-32b4-9829-ebca073f1ce2",
                                        "entry_id": "0a9982fe-fa5e-3428-a070-e3bdf5ca4396",
                                        "glosses": [
                                            "The philosophy and teaching of Confucius, which emphasizes self-cultivation, collective harmony, righteousness and the family structure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "161335d3-c445-4258-ac3e-f70799accc22",
                                                "sense_id": "2fbd4ddd-95cf-32b4-9829-ebca073f1ce2",
                                                "text": "A third important part of Confucianism is the concept of chun tzu or \"ideal gentlemanly behavior.\" Confucius believed that the ideal man \"is kind and upholds moral principles. He is a man who loves learning, who is calm and perfectly at ease and constantly careful of his own conduct, believing that by example he has great influence over society.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2654095-b9f2-3a75-9d97-922f5a0a5fe3",
                                        "entry_id": "0a9982fe-fa5e-3428-a070-e3bdf5ca4396",
                                        "glosses": [
                                            "The school of thought and philosophy centered on Confucian principles, originating in China, including later teachings of scholars such as Zhu Xi (Chu Hsi)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76ae9a1c-a921-4c7d-9354-e26726fedd06",
                                                "sense_id": "f2654095-b9f2-3a75-9d97-922f5a0a5fe3",
                                                "text": "The Chinese New Year holiday period, being disrupted this year by the outbreak of a viral illness, has evolved over more than 3,000 years to become the most important of China’s traditional festivals.\nAs celebrated in China and in many other places where its known as the Lunar New Year, it is largely a secular holiday, yet it includes rituals and traditions that derive from Confucianism, Buddhism and Taoism, as well as from ancient myths and folk religions."
                                            }
                                        ]
                                    },
