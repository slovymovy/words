                "senses": [
                    {
                        "sense_id": "3fe89ec7-2755-35c7-84a8-826d39cd38d0",
                        "entry_id": "993ef451-709d-3b18-b32e-f1c2cadfe1cc",
                        "glosses": [
                            "Celle qui venge, qui punit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d96fc25-482e-4d3b-bbdd-0bd6b0e301b6",
                                "sense_id": "3fe89ec7-2755-35c7-84a8-826d39cd38d0",
                                "text": "Un assassin, une vengeuse, et elle, entre eux, victime de leur longue guerre à tous les deux, une guerre séculaire, sans doute, dont elle n’avait été qu’un épisode."
                            },
                            {
                                "example_id": "3b8c92a0-6bca-459e-817a-b04b79cc62b9",
                                "sense_id": "3fe89ec7-2755-35c7-84a8-826d39cd38d0",
                                "text": "Sans le vouloir, Nicky avait peut-être mis la main sur une dangereuse psychopathe, agissant tel une vengeuse dans l’ombre, éliminant les rebus de la société, […]"
                            },
                            {
                                "example_id": "0f8074d7-a4b1-4ef4-b741-ed7dccccad34",
                                "sense_id": "3fe89ec7-2755-35c7-84a8-826d39cd38d0",
                                "text": "Elle aussi s’appelle une vengeuse des femmes, et c’en est une, à sa façon, sans bruit et sans réclame ; elle fait une trop grande part à son indépendance et à ses goûts personnels pour les sacrifier aux exigences d’un mari."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad434920-daeb-406b-a317-fe212168c26e",
                        "source_entry_id": "993ef451-709d-3b18-b32e-f1c2cadfe1cc",
                        "source_sense_id": "3fe89ec7-2755-35c7-84a8-826d39cd38d0",
                        "target_lang_word": "Rächerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rächerin",
