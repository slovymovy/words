                "senses": [
                    {
                        "sense_id": "dbd18ba0-0a14-3a17-99a8-cd0483dd2dbb",
                        "entry_id": "750e0b2e-e6f6-3110-b295-0d715cbf1b4c",
                        "glosses": [
                            "Être langoureux."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4aedcf61-29f0-4099-8ce1-a117caaa7de6",
                                "sense_id": "dbd18ba0-0a14-3a17-99a8-cd0483dd2dbb",
                                "text": "Mille violons lourds langourent dans mon cœur !"
                            },
                            {
                                "example_id": "c43958af-c76b-4c86-a306-bdcd8c0a09bf",
                                "sense_id": "dbd18ba0-0a14-3a17-99a8-cd0483dd2dbb",
                                "text": "Le Soir où dans l’azur langourentles étoiles, nous allons à pas doux, les lèvres aux lilas."
                            },
                            {
                                "example_id": "acdba995-969a-476e-8956-579d835f5b05",
                                "sense_id": "dbd18ba0-0a14-3a17-99a8-cd0483dd2dbb",
                                "text": "Après le dîner, prêts à se glisser dans les toiles, on écoute un moment les vedettes locales, soit deux gommeux à guitare qui langourent ou qui contestent à grands coups de médiator sur des grattes maquillées pop, et un fantaisiste qui bruite une arrivée du Tour de France entre deux imitations du tonton Simon et du camarade Montand."
                            }
                        ]
                    },
                    {
                        "sense_id": "97450005-c6e7-34cf-9e99-b63f26103175",
                        "entry_id": "750e0b2e-e6f6-3110-b295-0d715cbf1b4c",
                        "glosses": [
                            "Exprimer quelque chose de façon langoureuse."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "28699ae4-e849-4d84-8275-2115d1b2cce8",
                                "sense_id": "97450005-c6e7-34cf-9e99-b63f26103175",
                                "text": "Conchita, presque aussi envapée que bibi, me langoure un regard teinté de reproche."
                            }
                        ]
                    }
                ],
