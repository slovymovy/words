                                        "glosses": [
                                            "A flowering plant of the genus Primula."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2abda2be-1ff0-411c-8556-61a90137669f",
                                                "sense_id": "ac8dd61b-7525-3f26-9511-13123954b9b8",
                                                "text": "A mile or so further on is the intermediate station of Ryhall, smothered with primroses in the season, and at all times a veritable flower garden."
                                            },
                                            {
                                                "example_id": "0b889ad8-eb5c-48d6-878f-afed5adfbced",
                                                "sense_id": "ac8dd61b-7525-3f26-9511-13123954b9b8",
                                                "text": "Here is spring were celandine, marsh marigold, wind-flower, primrose, cowslip and dog's violet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43705921-4c45-3b66-9c76-b0c4c45a3348",
