                    {
                        "sense_id": "a1e495bc-d72f-30a4-97aa-ba500e880c4b",
                        "entry_id": "3cfaf0cf-fbb0-3396-9203-04c58919459b",
                        "glosses": [
                            "Information qui s’affiche lorsque le curseur de la souris passe au-dessus d’un objet graphique (tel un bouton, un hyperlien…)."
                        ],
                        "tags": [
                            "Interface graphique"
                        ],
                        "examples": [
                            {
                                "example_id": "6c06fcde-d5ae-4e57-b384-d28a8ab6ce28",
                                "sense_id": "a1e495bc-d72f-30a4-97aa-ba500e880c4b",
                                "text": "Chaque fois que le pointeur de la souris survole une commande, une infobulle s'affiche pour en décrire la fonction et éventuellement indiquer le raccourci clavier associé."
                            },
                            {
                                "example_id": "bac3e436-b813-4340-b9f8-fe38213234d5",
                                "sense_id": "a1e495bc-d72f-30a4-97aa-ba500e880c4b",
                                "text": "Les infobulles apparaissent lorsque vous pointez votre souris sur une option ou une icône. Elles permettent de décoder une image ou d'expliquer brièvement l'intérêt d'une fonctionnalité."
                            }
                        ]
                    }
                ],
