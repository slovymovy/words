                "senses": [
                    {
                        "sense_id": "345f94e2-51f1-3902-85e0-227c984d0a94",
                        "entry_id": "4e86d32d-bdb0-31ec-ac62-a11479962a43",
                        "glosses": [
                            "tarantass (a low horse-drawn carriage without springs used in Russia)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f593c52e-9a16-43a5-a8e0-8b90b0dce947",
                                "sense_id": "345f94e2-51f1-3902-85e0-227c984d0a94",
                                "text": "Он мо́лча отвори́л две́рцу коля́ски и отстегну́л фа́ртук таранта́са",
                                "translation": "He silently opened the carriage door and unbuttoned the apron of the tarantass.",
                                "english": "He silently opened the carriage door and unbuttoned the apron of the tarantass."
                            },
                            {
                                "example_id": "ce5152df-56d2-4333-ba0e-791c9fdf71be",
                                "sense_id": "345f94e2-51f1-3902-85e0-227c984d0a94",
                                "text": "Когда́ ло́шади ста́ли, он вы́кинул из таранта́са но́гу в вое́нном сапоге́ с ро́вным голени́щем и, приде́рживая рука́ми в за́мшевых перча́тках по́лы шине́ли, взбежа́л на крыльцо́ избы́.",
                                "translation": "When the horses came to a halt, he threw a leg in a level-topped military boot out of the tarantass and, holding back the skirts of the greatcoat with suede-gloved hands, ran up onto the porch of the hut.",
                                "english": "When the horses came to a halt, he threw a leg in a level-topped military boot out of the tarantass and, holding back the skirts of the greatcoat with suede-gloved hands, ran up onto the porch of the hut."
                            }
                        ]
                    },
