                                        "glosses": [
                                            "zwei zweischalige Muschelarten der Gattung Pecten (Mittelmeerpilgermuschel und große Pilgermuschel), welche wegen ihrer langgezogenen Streifen und Strahlen auch Kammmuschel oder Strahlenmuschel genannt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdbcddbc-393d-4f22-917e-2132119c5570",
                                                "sense_id": "ecc58eca-7592-3a19-90dc-1db28730fbff",
                                                "text": "\"Als Jakobsmuscheln oder Pilgermuscheln werden zwei nahe verwandte Arten von Muscheln bezeichnet, die beide zur Gattung Pecten gehören.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ecb752e1-e108-3f87-8251-a729f70c408d",
                                        "entry_id": "4e1fb1a1-3287-348b-ae09-e32fbc77a5f0",
                                        "glosses": [
                                            "die von Jakobspilgern als Trinkgefäß und als kennzeichnendes Symbol benutzte Kammmuschel, die klassischerweise am Hut getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60f86a41-6ac9-4243-91b1-6ac8bb735199",
                                                "sense_id": "ecb752e1-e108-3f87-8251-a729f70c408d",
                                                "text": "Die Jakobsmuscheln werden von den Santiago-Pilgern klassischerweise am Hut getragen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
