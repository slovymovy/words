                "senses": [
                    {
                        "sense_id": "6dc8b554-8607-375c-af65-40da093e072d",
                        "entry_id": "6b515d44-b3e6-3a91-8193-26100222f00c",
                        "glosses": [
                            "Donner un caractère horrible à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e5d4e07-5f47-4acb-97cd-d5fa21fc69ed",
                                "sense_id": "6dc8b554-8607-375c-af65-40da093e072d",
                                "text": "Je n’attaquerai donc pas Victor Hugo dans la complaisance avec laquelle il enlaidit , il horribilise — passez-moi le mot — sa sorcière."
                            },
                            {
                                "example_id": "feede39d-8a32-4b51-a8dd-1a677597a877",
                                "sense_id": "6dc8b554-8607-375c-af65-40da093e072d",
                                "text": "Le narrateur ne cherche pas à ridiculiser le monstre, il « horribilise » son rire."
                            },
                            {
                                "example_id": "5418baa6-c799-4e7c-81e3-7aca0ca06761",
                                "sense_id": "6dc8b554-8607-375c-af65-40da093e072d",
                                "text": "Comment \"horribiliser une AK\"... et encore, je sais bien que je suis pas au max..."
                            }
                        ]
                    }
