                "senses": [
                    {
                        "sense_id": "65d27016-0502-3543-ae03-87740a59f616",
                        "entry_id": "fa1a9561-832c-309d-91d5-18d20f82c893",
                        "glosses": [
                            "nadenken als activiteit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ca48e1a-2763-46ad-9f56-b660f84078ce",
                                "sense_id": "65d27016-0502-3543-ae03-87740a59f616",
                                "text": "Hoewel Sleurink de kleurrijke ekster met een hoefijzer op de computer heeft gemaakt, is de vertaling naar een muurschildering hand- én hoofdwerk."
                            }
                        ]
                    },
                    {
                        "sense_id": "84d735f0-d949-37dd-b08e-534544042310",
                        "entry_id": "fa1a9561-832c-309d-91d5-18d20f82c893",
                        "glosses": [
                            "belangrijkste activiteit van iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f9956b5-0b43-4e6f-b753-6e2f65fac64c",
                                "sense_id": "84d735f0-d949-37dd-b08e-534544042310",
                                "text": "Hoofdwerk was het American Songbook van George Crumb, waaruit Andueza de Afro-Amerikaanse spirituals selecteerde."
                            }
                        ]
                    },
                    {
                        "sense_id": "5bf997fb-9156-3bef-9b7a-602fce44f293",
                        "entry_id": "fa1a9561-832c-309d-91d5-18d20f82c893",
                        "glosses": [
                            "belangrijkste onderdeel van een groep door mensen gemaakte of te maken zaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "185153c6-c61b-499c-babe-264b363e938b",
                                "sense_id": "5bf997fb-9156-3bef-9b7a-602fce44f293",
                                "text": "Donderdagavond gingen 47 hoofdwerken van de verzameling van Bowie in twee uur voor bijna 28 miljoen euro onder de hamer. De tweede veilingsdag vrijdag duurde meer dan 10 uur en ging door tot diep in de nacht. Daarbij werd alleen voor designobjecten van Ettore Sottsass en de Memphisgroep ongeveer 1,5 miljoen euro neergeteld. Die waren vooraf op maximaal 130.000 euro geschat."
                            },
                            {
                                "example_id": "acb4ecd1-ae4e-45b9-b084-d060c73ca014",
                                "sense_id": "5bf997fb-9156-3bef-9b7a-602fce44f293",
                                "text": "Van november 2015 tot eind april 2016 werden al heel wat nutswerken uitgevoerd, maar die blijken onvoldoende te zijn. ‘Uit steekproeven blijkt dat er op sommige plaatsen nog leidingen zijn die niet diep genoeg liggen, wat problemen kan veroorzaken bij de hoofdwerken’, zegt Eveline Vandecaetsbeek, woordvoerster bij Wegen en Verkeer West-Vlaanderen."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ee19c00-633f-386d-bcbd-1c4cb2fb6256",
                        "entry_id": "fa1a9561-832c-309d-91d5-18d20f82c893",
                        "glosses": [
                            "belangrijkste dat iemand ooit gemaakt heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e927beb2-a786-44ba-a038-275e637de3d1",
                                "sense_id": "7ee19c00-633f-386d-bcbd-1c4cb2fb6256",
                                "text": "Proefstuk van dit jaar is een idealistisch gedachte-experiment van de Belgische componist Claude Ledoux. A Butterfly’s Dream reflecteert op een passage uit het filosofische hoofdwerk van de Chinese wijsgeer Zhuang Zi: droomde de meester dat hij een vlinder was, of is hij een vlinder die droomt dat hij de meester is? Anders gezegd: is de wereld een droom, of dromen we de wereld?"
                            }
                        ]
                    },
                    {
                        "sense_id": "c8e04848-6209-3442-baf6-2aa54e249a9c",
                        "entry_id": "fa1a9561-832c-309d-91d5-18d20f82c893",
                        "glosses": [
                            "belangrijkste gedeelte van een orgel dat zich direct boven het hoofd van de organist bevindt"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
