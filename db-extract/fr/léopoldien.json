                    {
                        "sense_id": "dd7ab7c3-9e7a-3083-a578-c00d5202a5f6",
                        "entry_id": "c658ea20-2052-34d6-ba30-2c40eb0b6897",
                        "glosses": [
                            "Relatif à Léopold II de Belgique, et au régime appliqué au Congo-Kinshasa à son époque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4019e62-0807-41af-9335-389728bd7bd6",
                                "sense_id": "dd7ab7c3-9e7a-3083-a578-c00d5202a5f6",
                                "text": "Lumumba déséquilibre la construction léopoldienne."
                            },
                            {
                                "example_id": "f2e4f6e8-ebac-425c-b563-c45a1e0ba7c9",
                                "sense_id": "dd7ab7c3-9e7a-3083-a578-c00d5202a5f6",
                                "text": "Les impératifs de la guerre, l’imposition de l’effort de guerre, dissipèrent la mauvaise conscience née des excès du régime léopoldien."
                            },
                            {
                                "example_id": "62eebc8e-977f-4b21-9371-8f75d6e339b2",
                                "sense_id": "dd7ab7c3-9e7a-3083-a578-c00d5202a5f6",
                                "text": "Étienne souhaitait introduire par décret au Congo français le système léopoldien."
                            },
                            {
                                "example_id": "1bd37bc7-f176-4850-b3b4-1aa63e275a5d",
                                "sense_id": "dd7ab7c3-9e7a-3083-a578-c00d5202a5f6",
                                "text": "Le système léopoldien — tarifs ferroviaires excessifs, immenses concessions, cueillette, destruction des ressources naturelles, travail forcé, monopole commercial — entravait le développement de la colonisation."
                            }
                        ]
                    },
                    {
                        "sense_id": "734902eb-b899-3095-9df2-dbead0f3ffb3",
                        "entry_id": "c658ea20-2052-34d6-ba30-2c40eb0b6897",
                        "glosses": [
                            "Relatif à Léopold II du Saint-Empire et au style architectural de son époque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b7bd973-9b13-4a83-8383-f55da797b02e",
                                "sense_id": "734902eb-b899-3095-9df2-dbead0f3ffb3",
                                "text": "Une très belle villa avec sa typique tourelle de style léopoldien."
                            }
                        ]
                    }
