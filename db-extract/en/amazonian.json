                    },
                    {
                        "sense_id": "8c74f7e3-6419-3660-b47e-f48fb3429eaf",
                        "entry_id": "2065580c-3928-3be2-95f3-839e105d1dee",
                        "glosses": [
                            "Having to do with the Amazon River in South America, and its surrounding region."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64a215fd-e77c-48af-b877-8accabe0eb0c",
                                "sense_id": "8c74f7e3-6419-3660-b47e-f48fb3429eaf",
                                "text": "The new numbers, showing almost 10,000 sq kms were lost in the year to August, were released as emboldened farm owners scuffled with forest defenders in Altamira, the Amazonian city at the heart of the recent devastation."
                            }
                        ]
                    },
                    {
                        "sense_id": "60dd57fc-b1c5-38a3-bb83-23b9872f534e",
                        "entry_id": "2065580c-3928-3be2-95f3-839e105d1dee",
                        "glosses": [
                            "Of or relating to the most recent Martian geological time period."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1ed10220-52d9-352d-93dc-f3727e397940",
                        "entry_id": "2065580c-3928-3be2-95f3-839e105d1dee",
                        "glosses": [
                            "Very tall, strong and athletic."
                        ],
                        "tags": [
                            "of a woman"
                        ],
                        "examples": [
                            {
                                "example_id": "852a7462-49e6-430c-a2a9-6e5a6cf40b5a",
                                "sense_id": "1ed10220-52d9-352d-93dc-f3727e397940",
                                "text": "Women's Tennis champions Maria Sharapova and Venus Williams are noted for their Amazonian physiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0002e09-7dc3-3d8b-a254-386fe4193269",
                        "entry_id": "2065580c-3928-3be2-95f3-839e105d1dee",
                        "glosses": [
                            "Requiring a huge amount of work; of extraordinary difficulty; Herculean."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c8028c3-aa38-43c3-8d2b-c40e4d33ddd0",
                                "sense_id": "e0002e09-7dc3-3d8b-a254-386fe4193269",
                                "text": "It's to their credit that they are capable of such \"transformations,\" as well as performing the amazonian task of surviving and working as a small theater."
                            },
                            {
                                "example_id": "44e2bcda-ad0d-4536-b428-ad8dc0974ec4",
                                "sense_id": "e0002e09-7dc3-3d8b-a254-386fe4193269",
                                "text": "Russian capitalism created an exploited economic class that was up against these common enemies at every turn and was forced to take on the Amazonian task of battling class rule, its ideology and state."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a957a68-d487-3ba8-a3dc-2d196af29e9f",
                        "entry_id": "2065580c-3928-3be2-95f3-839e105d1dee",
                        "glosses": [
                            "Of or relating to Amazon.com, Inc.."
                        ],
                        "tags": [
                            "informal",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "dec6400d-a6f6-48d7-8fe1-8ba1e1840172",
                                "sense_id": "3a957a68-d487-3ba8-a3dc-2d196af29e9f",
                                "text": "I’ve […] languidly sipped merlot while my Amazonian inamorato responds to a high-priority event."
                            }
                        ]
                    }
