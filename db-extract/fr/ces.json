                                                "sense_id": "d032c885-d2ec-3fe8-be5e-8f33a9dfd840",
                                                "text": "He read the letter aloud. Sophia listened with the studied air of one for whom, even in these days, a title possessed some surreptitious allurement."
                                            },
                                            {
                                                "example_id": "e4e962b9-6028-42ec-83a1-8ddc1b00946b",
                                                "sense_id": "d032c885-d2ec-3fe8-be5e-8f33a9dfd840",
                                                "text": "Seinfeld, The Alternate Side\nThese pretzels are making me thirsty."
                                            },
                                            {
                                                "example_id": "ec081bb7-2653-4cfc-8b54-36210dfc1f45",
                                                "sense_id": "d032c885-d2ec-3fe8-be5e-8f33a9dfd840",
                                                "text": "MDF and HDF – or medium-density fiberboard and high-density fiberboard – are two of the trendiest materials in woodworking these days."
                                            }
