                            {
                                "example_id": "43fb0b3e-1942-453c-9ea4-771713598cba",
                                "sense_id": "606d1325-3247-34b9-8d97-617acbdc55d5",
                                "text": "CARTONNÉE. Ancienne mesure agraire ou de superficie, usitée à Cahors en France. La cartonnée, ¼ de la quarterée, se divise en 4 boisseaux = 64 onces = 12100 pieds carrés de Paris = 12.768 ares."
                            },
                            {
                                "example_id": "622e37c1-c06b-45e9-9146-6bc350436fd8",
                                "sense_id": "606d1325-3247-34b9-8d97-617acbdc55d5",
                                "text": "En 1784 , le patrimoine du prieuré de Sail-sous-Couzan se composait des éléments suivants : Fort belle maison appelée le prieuré , grange , écurie , cuvage , cuves , pressoir , 3 cartonnées de jardin en deux pièces , 2 journalées de vigne , 60 cartonnées de bois taillis, 2 prés de la contenue de 27 cartonnées."
                            }
                        ]
                    }
