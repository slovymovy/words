                                            {
                                                "example_id": "a52f6903-2058-42e0-a167-1f71c699b52f",
                                                "sense_id": "b34b9f71-18b5-380c-885b-131a8fe485f5",
                                                "text": "Rosalind: But what will you be called?\nCelia: Something that hath a reference to my state:\nNo longer Celia, but Aliena."
                                            },
                                            {
                                                "example_id": "1e258ab1-db67-4f20-80c8-205f7b786819",
                                                "sense_id": "b34b9f71-18b5-380c-885b-131a8fe485f5",
                                                "text": "The British author Celia Dodd, who recently updated her 2011 book, “The Empty Nest: How to Survive and Stay Close to Your Adult Child,” told me that dads often seem to be coping fine with the transition but might be struggling the most."
                                            }
                                        ]
                                    }
