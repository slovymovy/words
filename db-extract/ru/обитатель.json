                    {
                        "translation_id": "ca8e5907-26be-4f12-a3fa-a209ab475e59",
                        "source_entry_id": "893fa770-88c5-39ff-8fe5-be78cd85f33f",
                        "target_lang_word": "Bewohner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bewohner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee715dee-a95e-3298-a582-0a66d5c8903e",
                                        "entry_id": "25ef592e-900c-338a-9f1f-3051f025c59a",
                                        "glosses": [
                                            "jemand, der in einem Gebäude, einem Haus, einem Gebiet, einer Wohnung, auf einer Insel wohnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9259aea2-c301-46be-9251-8171f85fcc9d",
                                                "sense_id": "ee715dee-a95e-3298-a582-0a66d5c8903e",
                                                "text": "Der Bewohner kann wegen des Lärmes nicht schlafen."
                                            },
                                            {
                                                "example_id": "85290dfc-216b-4ad4-8db5-83b195ec1d24",
                                                "sense_id": "ee715dee-a95e-3298-a582-0a66d5c8903e",
                                                "text": "„Was archaisierend als »Stammesspott« bezeichnet wird, Frotzeleien und Sottisen zwischen den Bewohnern verschiedener deutscher Länder und Landschaften, ist ein wichtiger Bestandteil des Witzerepertoires.“"
                                            },
                                            {
                                                "example_id": "3d50fcc1-52fd-4a79-a8e7-a41b09c15711",
                                                "sense_id": "ee715dee-a95e-3298-a582-0a66d5c8903e",
                                                "text": "„Anfangs gründeten sie nur viele kleine Siedlungen, deren Bewohner Rinder züchteten und Gerste anbauten.“"
                                            },
                                            {
                                                "example_id": "4a4b2c83-aed7-47c8-8aee-d28f818f0ed7",
                                                "sense_id": "ee715dee-a95e-3298-a582-0a66d5c8903e",
                                                "text": "„Und daneben, in einem Futteral, ihr wichtigstes Instrument: eine Klappwaage aus Bronze, wie sie die Araber und viele Bewohner in Haithabu verwenden, kaum größer als eine Handfläche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
