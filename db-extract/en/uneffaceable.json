                        "glosses": [
                            "Impossible to efface; permanent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9a1200e-843d-4d5d-973e-2001e8c1cf7d",
                                "sense_id": "361842a6-a905-39c4-a569-c885fb4adfc6",
                                "text": "How could the events of a few hours wear such deep and uneffaceable channels in human lives?"
                            },
                            {
                                "example_id": "9035729e-2ba8-4d42-a4ec-cd9126e21d4d",
                                "sense_id": "361842a6-a905-39c4-a569-c885fb4adfc6",
                                "text": "The emotion remains uneffaceable after more than threescore years, one of the most vivid of my life."
                            },
                            {
                                "example_id": "91e86ead-6d17-480d-a2de-b48d0818698d",
                                "sense_id": "361842a6-a905-39c4-a569-c885fb4adfc6",
                                "text": "The secondary personages in Richardson's \"Clarissa\" grow somewhat faint in our memories; but the figures of his heroine and of Lovelace remain not only uneffaceable but undimmed by time."
                            }
                        ]
                    }
                ],
