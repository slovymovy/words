                "senses": [
                    {
                        "sense_id": "37bc28cc-135d-386a-89f8-c145b47fda40",
                        "entry_id": "66aed1ec-9d54-3014-a33e-63a0ec1f917a",
                        "glosses": [
                            "Very; extremely."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ab29847-846d-4901-aa84-d9c0ef584bdd",
                                "sense_id": "37bc28cc-135d-386a-89f8-c145b47fda40",
                                "text": "He was so tarnation black you couldn't see him except in the middle of the day."
                            },
                            {
                                "example_id": "88a3bb3b-1442-490d-be88-b1bf1fc7dbb3",
                                "sense_id": "37bc28cc-135d-386a-89f8-c145b47fda40",
                                "text": "Since Britannia ruled the waves, I guess it's a tarnation queer thing that she didn't rule 'em straighter."
                            },
                            {
                                "example_id": "26ca2a11-428c-4477-afa0-d05218427d0f",
                                "sense_id": "37bc28cc-135d-386a-89f8-c145b47fda40",
                                "text": "Well, that's tarnation strange !"
                            },
                            {
                                "example_id": "88ad7ec8-a32f-47aa-ae66-5a46c8ac198d",
                                "sense_id": "37bc28cc-135d-386a-89f8-c145b47fda40",
                                "text": "I know it is lonesome for you, but I will be with you again in time and then we can and will have a \"tarnation good time.\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b4fb9670-6723-3fa8-ac70-94e45a8d7294",
                "word": "tarnation",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b7242dd9-7313-3bc4-bd52-9cf503f34b6a",
                        "entry_id": "b4fb9670-6723-3fa8-ac70-94e45a8d7294",
                        "glosses": [
                            "Used to express anger, irritation, disappointment, annoyance, contempt, etc."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "be830aea-1149-4bbd-b130-06595e4cb4d2",
                                "sense_id": "b7242dd9-7313-3bc4-bd52-9cf503f34b6a",
                                "text": "\"Tarnation! You all right?\" \"Hell, no, I ain't all right!\""
                            },
                            {
                                "example_id": "6f335ed8-8751-48dd-911d-5bf7939e943d",
                                "sense_id": "b7242dd9-7313-3bc4-bd52-9cf503f34b6a",
                                "text": "“They contain the precise description of the place where the nuggets are hidden.” “Tarnation! Is that true?\""
                            },
                            {
                                "example_id": "d4209cd9-6f2d-401e-a08e-6645e14dcb0d",
                                "sense_id": "b7242dd9-7313-3bc4-bd52-9cf503f34b6a",
                                "text": "“Tarnation,” Jasper murmured, his attention turning to the thing in the Aether bubble."
                            },
                            {
                                "example_id": "3f0cb152-6496-4e65-85c1-74291583da72",
                                "sense_id": "b7242dd9-7313-3bc4-bd52-9cf503f34b6a",
                                "text": "“Oh, what in the Sam Hill are you a-wearing? I thought I was supposed to be Twain.” “I say you are incorrect, sir. I believe we decided I would be Twain.” “Twin Twains? That dog won't hunt.” “Uh, Mr. Clemens?” “Mmhmm. That's me.” “No, I'm Twain. Switch costumes, you ignominious pretender.” “You're more stubborn than a senate mule.” “Grits, grits, grits!” “Tarnation!” “Fancy pants, big-city lawyer.” “I say you are incorrect, sir.”"
                            }
                        ]
                    }
                ],
