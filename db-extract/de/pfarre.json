                                    {
                                        "sense_id": "33617256-c386-32b9-afc1-353b74d2b854",
                                        "entry_id": "fc2bf1a6-2ced-3bdb-b1bc-476b9fdcb7a7",
                                        "glosses": [
                                            "najmniejsza jednostka podziału administracyjnego w niektórych wspólnotach chrześcijańskich, wspólnota eucharystyczna kierowana przez proboszcza"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1deb89ae-f123-44ee-a97e-340836eb537c",
                                                "sense_id": "33617256-c386-32b9-afc1-353b74d2b854",
                                                "text": "W maju w naszej parafii odbędzie się uroczystość pierwszej komunii świętej."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "166bd1f9-8b42-30aa-8f01-f2097cd5957a",
                                        "entry_id": "fc2bf1a6-2ced-3bdb-b1bc-476b9fdcb7a7",
                                        "glosses": [
                                            "ogół mieszkańców parafii (1.1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d931de36-8bf7-4c7b-85aa-83599725366c",
                                                "sense_id": "166bd1f9-8b42-30aa-8f01-f2097cd5957a",
                                                "text": "Cała parafia przyszła na mszę z udziałem arcybiskupa."
                                            }
