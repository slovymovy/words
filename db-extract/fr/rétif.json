                                        "examples": [
                                            {
                                                "example_id": "c57c1dbc-9a3b-4865-91d1-d2aa2c164b72",
                                                "sense_id": "ccc43940-c0c6-381b-92bc-ee2b2b6342bd",
                                                "text": "De recalcitrante jongeman werd gedwongen om de taak te verrichten."
                                            },
                                            {
                                                "example_id": "3208ea36-7c21-4ebb-b4dd-ff63253c9774",
                                                "sense_id": "ccc43940-c0c6-381b-92bc-ee2b2b6342bd",
                                                "text": "Rond 01.00 uur was er veel politie aanwezig in en rondom de Marktstraat. In korte tijd werden meerdere personen aangehouden, zo is te zien op beelden die omstanders maakten. Volgens de politie was er sprake van recalcitrant gedrag, openbaar dronkenschap, belediging en werd er geduwd."
                                            },
                                            {
                                                "example_id": "3086dd2b-1b40-453d-9066-567596992f54",
                                                "sense_id": "ccc43940-c0c6-381b-92bc-ee2b2b6342bd",
                                                "text": "De vrouw had spullen gestolen uit een winkel en werd vervolgens door medewerkers op straat aangesproken. Daarop gedroeg de vrouw zich recalcitrant, omstanders hebben de vrouw vastgehouden tot de politie er was."
                                            }
                                        ]
