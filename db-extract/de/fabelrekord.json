                "senses": [
                    {
                        "sense_id": "960ef1ca-20fc-3f63-a472-29e022eed056",
                        "entry_id": "3131e652-e982-3ebf-ad57-1554ef76bf09",
                        "glosses": [
                            "Höchstleistung in einer bestimmten Sportdisziplin, die die frühere Höchstleistung in unerwartet hohem Maße übertrifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c446946-7c93-4d07-824b-712950346f75",
                                "sense_id": "960ef1ca-20fc-3f63-a472-29e022eed056",
                                "text": "„‚Sie werden sich vergebens quälen, diese Fabelrekorde in einem anderen Stadion zu erreichen.‘“"
                            },
                            {
                                "example_id": "8fe4a413-65b3-4e3d-8654-f4d1b292fc3a",
                                "sense_id": "960ef1ca-20fc-3f63-a472-29e022eed056",
                                "text": "„Im Schatten dieses Fabelrekordes gab es eine Reihe von Resultaten, die hoffen lassen, daß wir im nächsten Jahr in München nicht nur hinterherlaufen werden.“"
                            },
                            {
                                "example_id": "a6aba114-25b8-4dfa-9f9a-91f0d867552b",
                                "sense_id": "960ef1ca-20fc-3f63-a472-29e022eed056",
                                "text": "„Mit spektakulären Erfolgen, Fabelrekorden und überhaupt großen Momenten von Sportlern lädt sich auch deren Ausrüstermarke emotional auf.“"
                            },
                            {
                                "example_id": "d9e96ea1-528d-4227-ac1d-8bca871ff058",
                                "sense_id": "960ef1ca-20fc-3f63-a472-29e022eed056",
                                "text": "„Im Moment seines Fabelrekords erlaubten sich die Mitspieler von Peyton Manning einen kleinen Scherz.“"
                            },
                            {
                                "example_id": "a2836b06-17aa-4bed-ba73-bbaa81339c4d",
                                "sense_id": "960ef1ca-20fc-3f63-a472-29e022eed056",
                                "text": "„Mit knapp 30 Jahren ist er immer noch das Maß der Dinge im Sprint, auch wenn seine Siegerzeit diesmal nicht beeindruckt: 9,81 Sekunden, deutlich über seinem Fabelrekord von 9,58 Sekunden, die er spielerisch leicht 2009 in Berlin lief.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
