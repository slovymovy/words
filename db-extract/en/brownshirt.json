                "word": "Brownshirt",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7ca2ed80-c431-4f0c-8704-7a60a54d7998",
                        "entry_id": "0caff7bb-1dfb-3936-8da0-e33abf339444",
                        "tags": [
                            "plural"
                        ],
                        "form": "Brownshirts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "59d92316-49cd-3115-8483-e074d2ced10c",
                        "entry_id": "0caff7bb-1dfb-3936-8da0-e33abf339444",
                        "glosses": [
                            "A uniformed member of the German Nazi Party (NSDAP), especially a storm trooper of the Sturmabteilung."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "a0ac7df6-43de-4144-b158-b21657a7387b",
                                "sense_id": "59d92316-49cd-3115-8483-e074d2ced10c",
                                "text": "A heavy arched door was pouring a raucous and lurching party of Brownshirts on to the trampled snow. […] Half-way up the vaulted stairs a groaning Brownshirt, propped against the wall on a swastika'd arm, was unloosing, in a staunchless gush down the steps, the intake of hours."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb0a1946-b0f1-3891-a1fe-16cf46cf2b20",
                        "entry_id": "0caff7bb-1dfb-3936-8da0-e33abf339444",
                        "glosses": [
                            "Any member of a fascist party; any person accused of being neofascist or neo-Nazi."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
