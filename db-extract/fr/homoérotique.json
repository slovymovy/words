                            {
                                "example_id": "be81e217-caaa-4faf-9a9d-779cead562f4",
                                "sense_id": "e4373a33-ea31-3043-b221-cfb88f22ce17",
                                "text": "Photographe homoérotique."
                            },
                            {
                                "example_id": "036ca98e-e2b7-45be-af54-a9b34f4ea2e4",
                                "sense_id": "e4373a33-ea31-3043-b221-cfb88f22ce17",
                                "text": "Mais l'arrivée du christianisme change la donne : la thématique homoérotique est expurgée des anthologies poétiques et condamnée explicitement."
                            }
                        ]
