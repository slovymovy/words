                "senses": [
                    {
                        "sense_id": "39935cbf-5777-3409-89ad-641ecd06fd48",
                        "entry_id": "435c3210-f0c5-32c2-8ec6-63f37bfb7422",
                        "glosses": [
                            "aus vergorenen Trauben gebrannter Schnaps"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0df496bd-b317-4544-b692-5d14148abda0",
                                "sense_id": "39935cbf-5777-3409-89ad-641ecd06fd48",
                                "text": "„Pisco ist der peruanische Traubenbrand. Seine besondere Charakteristik verdankt der Pisco seiner Herstellung gepaart mit den regionalen Vorzügen des Klimas und des Bodens.“"
                            },
                            {
                                "example_id": "2443fc92-bc92-4afc-822b-67224abf74ef",
                                "sense_id": "39935cbf-5777-3409-89ad-641ecd06fd48",
                                "text": "„So ist ein „Riesling Eisweintrester\" oder „Weinhefebrand aus kaltvergorener Rivanerhefe\" oder ein „Deutscher Weinbrand X. O. vom Riesling\" oder ein „Traubenbrand aus Gewürztraminer\" den unspezifizierten Erzeugnissen vorzuziehen.“"
                            },
                            {
                                "example_id": "79c26116-2e60-4253-9cc8-7d03a6bf0386",
                                "sense_id": "39935cbf-5777-3409-89ad-641ecd06fd48",
                                "text": "„Weitere Produkte aus der Traube: Schaumweinproduktion, Tresterbrand, Traubenbrand, Weinbrand, Alternativprodukte.“"
                            },
                            {
                                "example_id": "ddc6f698-7429-4d02-a000-1c5e816724a6",
                                "sense_id": "39935cbf-5777-3409-89ad-641ecd06fd48",
                                "text": "„Und in Saucen und Fonds wird der Traubenbrand ebenfalls verarbeitet.“"
                            },
                            {
                                "example_id": "6df35837-881a-4c28-856c-4696437c332b",
                                "sense_id": "39935cbf-5777-3409-89ad-641ecd06fd48",
                                "text": "„Das ist jetzt kein kathartischer Befreiungsschrei, sondern ein Traubenbrand von Markus Wieser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b6d0a5a8-b8cc-3045-a193-e9383191ece1",
                        "entry_id": "435c3210-f0c5-32c2-8ec6-63f37bfb7422",
                        "glosses": [
                            "Erkrankung der Trauben (Crambus), krankhaftes Einschrumpfen der Pflanze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86c763c1-c00f-497d-aa10-85b85b3be834",
                                "sense_id": "b6d0a5a8-b8cc-3045-a193-e9383191ece1",
                                "text": "Der Traubenbrand ist hier nur vereinzelt aufgetreten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
