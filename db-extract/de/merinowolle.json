                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45f3c87f-b50c-42d2-b420-13c8ad095e4c",
                                "sense_id": "4045c1fb-cff6-3a06-bd09-2cc9b4ef3f6d",
                                "text": "„Eine Million Kilo Merinowolle benötigt allein ein Unternehmen wie Zegna im Jahr, über 80 Prozent davon ist super- oder ultrafein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
