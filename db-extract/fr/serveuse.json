                ],
                "senses": [
                    {
                        "sense_id": "a7dced68-ebf2-3021-b429-e70aeaf2f5dc",
                        "entry_id": "e3122d75-310b-370e-b82e-afd7c723ed87",
                        "glosses": [
                            "Celle qui a pour activité professionnelle de servir à table ou au buffet."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "73c1a233-80df-4820-9424-1fc0e0666648",
                                "sense_id": "a7dced68-ebf2-3021-b429-e70aeaf2f5dc",
                                "text": "L’établissement est également très populaire pour ses serveuses ultra-sexy qui poussent à la consommation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d30e25c2-b988-4da4-8f19-df4d281a5bd8",
                        "source_entry_id": "e3122d75-310b-370e-b82e-afd7c723ed87",
                        "source_sense_id": "a7dced68-ebf2-3021-b429-e70aeaf2f5dc",
                        "target_lang_word": "Kellnerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kellnerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21e176d4-3fab-3b25-a313-b046855e53f8",
                                        "entry_id": "b12a078b-3477-3c3f-8dd3-716151ef12c7",
                                        "glosses": [
                                            "Angestellte in der Gastronomie, deren Aufgabe die Bedienung der Gäste ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a715a1ee-a5d8-41f9-ad3d-4bb37ac1e499",
                                                "sense_id": "21e176d4-3fab-3b25-a313-b046855e53f8",
                                                "text": "„Eine junge Kellnerin erzählte beispielsweise, wie sie kurz nach der Maueröffnung von einem Filmteam interviewt wurde.“"
                                            },
                                            {
                                                "example_id": "1111c9f0-8a11-40e3-8488-626aaaeb7d28",
                                                "sense_id": "21e176d4-3fab-3b25-a313-b046855e53f8",
                                                "text": "„Nach dem sehr guten Essen, für das wir komischerweise sehr viel mehr Zeit brauchten als sonst für das Essen, fragte uns die Kellnerin noch, ob wir ein Dessert wünschten.“"
                                            },
                                            {
                                                "example_id": "75d6b0d1-7026-426b-8a1c-fc112af27120",
                                                "sense_id": "21e176d4-3fab-3b25-a313-b046855e53f8",
                                                "text": "„Als wir fertig waren, brachte die Kellnerin vier kleine Gäser und deutete auf die Bar.“"
                                            },
                                            {
                                                "example_id": "0449b461-58b3-4727-8220-f193a281f0f5",
                                                "sense_id": "21e176d4-3fab-3b25-a313-b046855e53f8",
                                                "text": "„Es ändert nichts daran, daß ihr Blick dem der Kellnerin für kurze Zeit begegnet ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94788552-ec78-43c2-916f-84e6ef4ffd9c",
                        "source_entry_id": "e3122d75-310b-370e-b82e-afd7c723ed87",
                        "source_sense_id": "a7dced68-ebf2-3021-b429-e70aeaf2f5dc",
                        "target_lang_word": "waitress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waitress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12e248f3-34df-319b-8bbe-aa2ad429a00a",
                                        "entry_id": "be9c2b65-23c8-3496-8d39-39fbf487925d",
                                        "glosses": [
                                            "A female attendant who serves customers in a restaurant, café, or similar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89f46ec8-0e6d-45ea-b106-de486d5712f2",
                                                "sense_id": "12e248f3-34df-319b-8bbe-aa2ad429a00a",
                                                "text": "a waitress in a cocktail bar."
                                            },
                                            {
                                                "example_id": "b0133215-3c6c-4e98-869d-9cd274c10444",
                                                "sense_id": "12e248f3-34df-319b-8bbe-aa2ad429a00a",
                                                "text": "It would take a few more beers, but when the liquid courage kicked in, his wobbly legs were unable to keep pace with the fleetfooted waitress, who rolled her eyes, smiling, and finally twirled away."
                                            },
                                            {
                                                "example_id": "307dfe36-374c-4f00-bce2-b758d53e0e9b",
                                                "sense_id": "12e248f3-34df-319b-8bbe-aa2ad429a00a",
                                                "text": "The chefs never cooked before, the cashiers never cashiered before, the dishwashers never dishwashed before, the waitresses never waitressed before, and the managers never managed before."
                                            },
                                            {
                                                "example_id": "4bccd0b8-2ad8-4b70-ac9a-8af1709dc7cd",
                                                "sense_id": "12e248f3-34df-319b-8bbe-aa2ad429a00a",
                                                "text": "I ask everybody… A waitress, flight attendant… …someone I’m shitting next to on the plane… “You know what my biggest hobby is?” Puking."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "waitress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b162aa7-d99d-3801-b56b-aedba8273d4a",
                                        "entry_id": "e6d74cf4-2998-3dec-bc14-a99fc37fafb5",
                                        "glosses": [
                                            "To work as a waitress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "987becd8-28af-460d-bf43-ae44a228fe49",
                                                "sense_id": "7b162aa7-d99d-3801-b56b-aedba8273d4a",
                                                "text": "But it never did heal properly and Lizzie stayed on at the bar — waitressing until she came of legal age to bar-tend."
                                            },
                                            {
                                                "example_id": "d58e019b-d6b0-4ffd-8fca-27c5f40d9c6c",
                                                "sense_id": "7b162aa7-d99d-3801-b56b-aedba8273d4a",
                                                "text": "The chefs never cooked before, the cashiers never cashiered before, the dishwashers never dishwashed before, the waitresses never waitressed before, and the managers never managed before."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
