                    "frequency": "VeryLow",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique <w>shrank</w> in the hallway was filled with delicate porcelain figurines.",
                            "target_lang_translations": {
                                "fr": "L'antique <w>armoire</w> dans le couloir était remplie de délicates figurines en porcelaine."
                            }
                        },
                        {
                            "text": "They inherited a massive oak <w>shrank</w> from their grandmother that dominated the dining room.",
                            "target_lang_translations": {
