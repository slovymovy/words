                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "911a75e9-5a81-4f68-a971-3f7d0578e003",
                                                "sense_id": "bbade666-493c-3db4-bea7-8ad036ab6ccb",
                                                "text": "Aktualizacja danych następuje w naszym systemie co godzinę."
