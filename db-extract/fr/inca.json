                "senses": [
                    {
                        "sense_id": "d13a23a2-2a3e-3282-95bd-4561fd596f2c",
                        "entry_id": "4d28e1c2-1b9f-39c6-b5be-8d298e6012a5",
                        "glosses": [
                            "Relatif à l’histoire et à la civilisation précolombienne des Incas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cad04980-5b70-4111-90d8-60826447614d",
                                "sense_id": "d13a23a2-2a3e-3282-95bd-4561fd596f2c",
                                "text": "Machupichu est une ville inca."
                            },
                            {
                                "example_id": "d81b04aa-6111-4032-88b6-45b237edbefc",
                                "sense_id": "d13a23a2-2a3e-3282-95bd-4561fd596f2c",
                                "text": "La liste des empereurs incas s’appelle la capaccuna (en quechua « les plus puissants parmi les êtres humains »)."
                            },
                            {
                                "example_id": "79812d64-d54b-4a6b-8b72-86cb38afe9ca",
                                "sense_id": "d13a23a2-2a3e-3282-95bd-4561fd596f2c",
                                "text": "La fête du Soleil, qui comme tant de fêtes incas fut interdite par les conquérants, a retrouvé de sa vigueur à partir de 1944."
                            }
                        ]
                    },
                    {
                        "sense_id": "fab26230-8c64-3346-9946-b4568ba5dd45",
                        "entry_id": "4d28e1c2-1b9f-39c6-b5be-8d298e6012a5",
                        "glosses": [
                            "Qui concerne un os surnuméraire du crâne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90c86c38-112f-4627-95c0-76458b5e5d16",
                                "sense_id": "fab26230-8c64-3346-9946-b4568ba5dd45",
                                "text": "L'os inca ou interpariétal occupe une position analogue sur le lambda."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e0c22b5-fda3-4715-bb64-3a3f9da9b2e8",
                        "source_entry_id": "4d28e1c2-1b9f-39c6-b5be-8d298e6012a5",
                        "target_lang_word": "Inca",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inca",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "881390b5-370d-3b08-9c91-f5c9d4535342",
                                        "entry_id": "df1620c5-8938-31f9-9522-9ee4b49e7ae1",
                                        "glosses": [
                                            "A member of the group of Quechuan peoples of highland Peru who established an empire from northern Ecuador to central Chile before the Spanish conquest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f08f3673-1e07-4c8f-a3b9-5d2143ff2a4e",
                                                "sense_id": "881390b5-370d-3b08-9c91-f5c9d4535342",
                                                "text": "To honor the spirits that take form as mountains, the Inca stoneworkers carved rock outcrops to replicate their shapes."
                                            },
                                            {
                                                "example_id": "a34b0133-349a-4e82-823c-f446d3ef4c3d",
                                                "sense_id": "881390b5-370d-3b08-9c91-f5c9d4535342",
                                                "text": "Archaeologists say the Incas, brought down by the Spanish conquest, used khipus – strands of woolen cords made from the hair of animals like llamas or alpacas – as an alternative to writing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28a01de1-3deb-4621-94d7-dbf328068551",
                        "source_entry_id": "4d28e1c2-1b9f-39c6-b5be-8d298e6012a5",
