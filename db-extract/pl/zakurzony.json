                    }
                ],
                "translations": [
                    {
                        "translation_id": "9921ecdb-ad81-4400-b661-1c5b0b44e176",
                        "source_entry_id": "7d406171-0e5f-37dc-bf7a-4aeb80d0859e",
                        "source_sense_id": "d7584cd5-2bc2-3fb8-a086-8ebb55bfbd68",
                        "target_lang_word": "dusty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dusty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acaba006-5125-363c-ad0e-8479c5af3fc3",
                                        "entry_id": "9b392888-3639-36f3-92da-1508758acb65",
                                        "glosses": [
                                            "Covered with dust."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36eaab53-8d6b-4916-8b20-64906913ae58",
                                                "sense_id": "acaba006-5125-363c-ad0e-8479c5af3fc3",
                                                "text": "a dusty carpet"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e93f7fb-1454-3d5b-8e58-e67ad73c83c7",
                                        "entry_id": "9b392888-3639-36f3-92da-1508758acb65",
                                        "glosses": [
                                            "Powdery and resembling dust."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f938afe0-3ea7-3d6c-b72e-4aaf94c0ac56",
                                        "entry_id": "9b392888-3639-36f3-92da-1508758acb65",
                                        "glosses": [
                                            "Grey or greyish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "657ca6ce-f1cf-41f4-bd93-0a682b92fa29",
                                                "sense_id": "f938afe0-3ea7-3d6c-b72e-4aaf94c0ac56",
                                                "text": "a dusty peach color"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52f365d8-8b77-3520-9deb-9fae014a5ecc",
                                        "entry_id": "9b392888-3639-36f3-92da-1508758acb65",
                                        "glosses": [
                                            "Old; outdated; stuffily traditional."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9182731e-7780-4b6f-81e9-96664240324b",
                                                "sense_id": "52f365d8-8b77-3520-9deb-9fae014a5ecc",
                                                "text": "The very smart practitioners of my acquaintance do not rest their right hand on old dusty knowledge, but bend and move along a ground of being in which they are perpetually on the lookout for what is trusty and true, new and old."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cf192d6-9399-3d16-ab02-9b789cbeb1af",
                                        "entry_id": "9b392888-3639-36f3-92da-1508758acb65",
                                        "glosses": [
                                            "Ugly, disgusting (a general term of abuse)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c46eadd4-3e68-33c8-b5e7-30ea189c4131",
                                        "entry_id": "9b392888-3639-36f3-92da-1508758acb65",
                                        "glosses": [
                                            "Ugly, unwell, inadequate, bad."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8c46e21-b5bb-4f2d-80d7-9eb3e4eb37bf",
                                                "sense_id": "c46eadd4-3e68-33c8-b5e7-30ea189c4131",
                                                "text": "...the toilet-glass on the table...had probably reflected few such faces as that of the lady calling herself Mrs. Lloyd, who looked attentively into it when she found herself alone and decided that she was not so very dusty, considering"
                                            },
                                            {
                                                "example_id": "369fed74-79b7-4051-800e-67394669c08a",
                                                "sense_id": "c46eadd4-3e68-33c8-b5e7-30ea189c4131",
                                                "text": "One morning, I said to a patient: \"How are you today, Mrs. White?\" And she replied \"Not so dusty - quite well brushed.\""
                                            },
                                            {
                                                "example_id": "860f0496-7f1a-4be4-86cc-90ddcfe068f7",
                                                "sense_id": "c46eadd4-3e68-33c8-b5e7-30ea189c4131",
                                                "text": "\"Never mind,\" she ventured, \"but thanks for the compliment. You're not so dusty yourself!\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dusty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2d9c57c-536a-3453-9ab4-5026d01c15be",
                                        "entry_id": "6bb20834-7142-378b-9d0b-1d2235642a02",
                                        "glosses": [
                                            "A medium-brown color."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e367bf3-f646-4490-9cae-7fc102728f21",
                                                "sense_id": "d2d9c57c-536a-3453-9ab4-5026d01c15be",
                                                "text": "The orange shades ranged from brilliant to soft; pinks from delicate little-girl hues to strong dusties; yellows were soft buttermilks to ochre; reds ran from scarlets to bloods;"
                                            },
                                            {
                                                "example_id": "0f9e840d-72e9-4949-a196-461cc8097a7e",
                                                "sense_id": "d2d9c57c-536a-3453-9ab4-5026d01c15be",
                                                "text": "I chose small floral prints for the garden area and broke them into lights, mediums, dark mediums, and darks, in other words, pastels, dusties, dark dusties, and jewel tones (refer to the Montano Color chart, page 35)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "626029e4-8ab8-3b13-81fc-6a04740b4364",
                                        "entry_id": "6bb20834-7142-378b-9d0b-1d2235642a02",
                                        "glosses": [
                                            "An old bottle of spirits that has been kept for a long time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55cf701a-4e4c-4240-b223-9a516671b500",
                                                "sense_id": "626029e4-8ab8-3b13-81fc-6a04740b4364",
                                                "text": "A lighter, less expensive version—The White Label—was taken off the market in 2016. But dusties can still be found."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "059161ab-3a87-3ee9-964e-a4fe5bdc7367",
                                        "entry_id": "6bb20834-7142-378b-9d0b-1d2235642a02",
                                        "glosses": [
                                            "A miller (from the image of millers being covered in flour dust)."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9649e4b4-8ded-471e-b6b1-c2df1fb05d71",
                                                "sense_id": "059161ab-3a87-3ee9-964e-a4fe5bdc7367",
                                                "text": "I do not like to see too much strife between dusties on the short and long system question, as it is liable to cause hard feelings."
                                            },
                                            {
                                                "example_id": "67f5e72d-b80c-415b-93a4-4a2433b15f08",
                                                "sense_id": "059161ab-3a87-3ee9-964e-a4fe5bdc7367",
                                                "text": "It is designed to do scalping and grading in a way to satiffy the most fastidious of dusties."
                                            },
                                            {
                                                "example_id": "70117148-abdc-4b26-a0da-5a986271033f",
                                                "sense_id": "059161ab-3a87-3ee9-964e-a4fe5bdc7367",
                                                "text": "I've been a dusty in sixteen mills […] I'd like to hear from other dusties on this subject of a long and a short system milling and how they clean up well. Yours for the fraternity, A Bro. Miller, -Heimer."
                                            },
                                            {
                                                "example_id": "d15c8819-1da8-4e94-9655-c3227763569e",
                                                "sense_id": "059161ab-3a87-3ee9-964e-a4fe5bdc7367",
                                                "text": "We believe these exhibitions have been the means of very largely increasing the attendance because the miller now knows if he goes to the convention, he will not only be able to get the experiences of his brother dusties but will see the latest improvements in milling machinery."
                                            },
                                            {
                                                "example_id": "b62d527c-52da-41b5-a45e-10fc9960cfe7",
                                                "sense_id": "059161ab-3a87-3ee9-964e-a4fe5bdc7367",
                                                "text": "We give this hint as an inducement to the wives and as a warning to the dusties. On Wednesday afternoon of this memorable week all the visitors will go on the excursion to Lake Minnetonka where they will have one of the great pleasure ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b48fc0c-1822-3c88-87fe-38ddcce72b01",
                                        "entry_id": "6bb20834-7142-378b-9d0b-1d2235642a02",
                                        "glosses": [
                                            "A supply petty officer."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e15fdc0-28c2-454f-a3b1-2a7aa9d2fbab",
                                                "sense_id": "6b48fc0c-1822-3c88-87fe-38ddcce72b01",
                                                "text": "The mess was so overcrowded that hammock-slinging space became the perks of the badgemen the “jack-dusties” invariably slept in their store-rooms and offices."
                                            },
                                            {
                                                "example_id": "d3bda987-4df2-469b-97e1-e76a104beddc",
                                                "sense_id": "6b48fc0c-1822-3c88-87fe-38ddcce72b01",
                                                "text": "The 'Dusties' — supply Petty Officers were frantically pumping out the kit, gas masks, kit bags, blankets, army boots, toilet bags, socks, underclothes."
                                            },
                                            {
                                                "example_id": "505d16c8-3939-49bc-988d-ca170361f1dc",
                                                "sense_id": "6b48fc0c-1822-3c88-87fe-38ddcce72b01",
                                                "text": "From time to time I'd get up to the dusties' mess for this or that reason, and became known to the writers and dusties up there."
                                            },
                                            {
                                                "example_id": "dfd25595-3f9d-42b1-9753-fb73825164a5",
                                                "sense_id": "6b48fc0c-1822-3c88-87fe-38ddcce72b01",
                                                "text": "Take the Jack Dusties, the stores blokes, they were in our mess."
                                            },
                                            {
                                                "example_id": "12ee0e4d-3341-493a-887d-0b4a21c7f60c",
                                                "sense_id": "6b48fc0c-1822-3c88-87fe-38ddcce72b01",
                                                "text": "As soon as I become an officer all the Dusties, Tugs, Knockers, Gingers and Macs will call me 'sir' and conceal their thoughts from me;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcb28ebb-b6b7-31a4-8252-e6cd416adf2a",
                                        "entry_id": "6bb20834-7142-378b-9d0b-1d2235642a02",
                                        "glosses": [
                                            "A recording of music from another era, especially R&B; an oldie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fc94b7c-39fd-4f74-a724-871d3317bf86",
                                                "sense_id": "bcb28ebb-b6b7-31a4-8252-e6cd416adf2a",
                                                "text": "In Los Angeles, listeners can tune in to KACE, the \"dusties\" station that plays music from the '50s, '60s and '70s;"
                                            },
                                            {
                                                "example_id": "04b626c2-fdd2-4428-9418-b588646f82c9",
                                                "sense_id": "bcb28ebb-b6b7-31a4-8252-e6cd416adf2a",
                                                "text": "WGCI 1390 - AM was previously known for playing R & B oldies known as \"dusties\"."
                                            },
                                            {
                                                "example_id": "fe791cf4-c603-4dbd-be3c-827832f67681",
                                                "sense_id": "bcb28ebb-b6b7-31a4-8252-e6cd416adf2a",
                                                "text": "nice old scratchy records that had been played over and over again, I called them \"dusty records,\" reasoning that it was the dust in the grooves from being around so long that made them crackle. Actually, to me, if a record's been played so often that it can become a dusty, that means it's good music. […] I've been following a dusties format ever since, […]"
                                            },
                                            {
                                                "example_id": "872edb71-93cd-4a02-87fa-ae587813e359",
                                                "sense_id": "bcb28ebb-b6b7-31a4-8252-e6cd416adf2a",
                                                "text": "Leah turned on a radio station that played the dusties— rhythm and blues classics that I had enjoyed all my life."
                                            },
                                            {
                                                "example_id": "39225d65-149a-4589-9d24-52330123bb65",
                                                "sense_id": "bcb28ebb-b6b7-31a4-8252-e6cd416adf2a",
                                                "text": "The Tom Joyner Morning Show (TJMS), for four hours Monday through Friday, played the music I identified with and wanted to hear—“the best of the hits and dusties.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44856827-97bb-3175-bab4-9a87ecce9bad",
                                        "entry_id": "6bb20834-7142-378b-9d0b-1d2235642a02",
                                        "glosses": [
                                            "An old person, especially one who is unwilling to change with the times."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa9c9188-ebcd-4452-9c74-37c9dbe5e8f3",
                                                "sense_id": "44856827-97bb-3175-bab4-9a87ecce9bad",
                                                "text": "United States. Congress. House. Committee on Appropriations. Subcommittee on Agriculture--Environmental and Consumer Protection Appropriations"
                                            },
                                            {
                                                "example_id": "6b518d53-05ff-4f0f-9b3b-620a9a879d54",
                                                "sense_id": "44856827-97bb-3175-bab4-9a87ecce9bad",
                                                "text": "Max and Fizz both felt resentful and indignant: how dare any stupid oldie obscure their happiness by dreary talk of pennies and pensions; how dare the dusties link love with security, matrimony with mortgages, pleasure with prams?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8aabef04-500e-3673-9ecf-5d6743e4d912",
                                        "entry_id": "6bb20834-7142-378b-9d0b-1d2235642a02",
                                        "glosses": [
                                            "A person of mixed race who has a swarthy complexion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b26f9ae8-3136-4513-8451-2704df6d802e",
                                                "sense_id": "8aabef04-500e-3673-9ecf-5d6743e4d912",
                                                "text": "There are scarcely any Indo-Europeans of pure blood in Peru, for with the exception of pure Indians in the interior, the population consists of mestizos, Zambos, mulattoes, terceroones, terceroones, quadroons, cholos, musties, fusties, and dusties; crosses between Spaniards and negroes, Spaniards and yellows; crosses between these people and the cholos, musties, and dusties; crosses between mongrels of one kind and mongrels of the other kinds."
                                            },
                                            {
                                                "example_id": "ca302ab3-39a8-49e4-8c6c-b565ea1f9e1b",
                                                "sense_id": "8aabef04-500e-3673-9ecf-5d6743e4d912",
                                                "text": "Ashy niggas and dusties went everywhere, forgetting about looking dap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46b573e9-22ff-3d6f-a4f6-c269de6a064b",
                                        "entry_id": "6bb20834-7142-378b-9d0b-1d2235642a02",
                                        "glosses": [
                                            "A migrant farmer from the dustbowl."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59fe43ec-62d3-4e33-b226-378605765aee",
                                                "sense_id": "46b573e9-22ff-3d6f-a4f6-c269de6a064b",
                                                "text": "And pretty much the same time, you started to hear about dusties down in states like California and Arizona: farmers who'd had to leave their farms because of drought, people in towns with no more water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f397b819-fbcf-381d-a2e3-ebd72a87b1bb",
                                        "entry_id": "6bb20834-7142-378b-9d0b-1d2235642a02",
                                        "glosses": [
                                            "A dustman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89d48e60-d180-4add-9431-605ad9ae4e1d",
                                                "sense_id": "f397b819-fbcf-381d-a2e3-ebd72a87b1bb",
                                                "text": "One Council put that principle into practice some five years ago when it changed from a refuse collection system employing its own 'dusties' to one based upon tenders from private contractors."
                                            },
                                            {
                                                "example_id": "ab3c371e-8bb0-4a4f-b90b-5f75c11c970e",
                                                "sense_id": "f397b819-fbcf-381d-a2e3-ebd72a87b1bb",
                                                "text": "His neighbours persist in this behaviour: they dump their unfinished dinners (molten broccoli? the stewed remains of infidels?) in unofficial bags the dusties shun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37993771-65a5-3c16-abc6-e083c2b3f159",
                                        "entry_id": "6bb20834-7142-378b-9d0b-1d2235642a02",
                                        "glosses": [
                                            "A duststorm."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "858a3c9f-d599-4aae-ae42-61f2410438e0",
                                                "sense_id": "37993771-65a5-3c16-abc6-e083c2b3f159",
                                                "text": "[…] dust storms, does it? Well, nothing like what it used to have: One spring the dusties blew so thick We staked five claims above Clay Crick Fifty foot high in the fallow air. Blows lots worse on the prairie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16fefa52-6e7c-3eba-8b78-17661a763da9",
                                        "entry_id": "6bb20834-7142-378b-9d0b-1d2235642a02",
                                        "glosses": [
                                            "A clump of dust; a dust bunny."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "possibly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ca400e8-e17b-4bc2-bc62-4225457f95eb",
                                                "sense_id": "16fefa52-6e7c-3eba-8b78-17661a763da9",
                                                "text": "Sparse iron gray hair, stuck on his egg-shaped head like dusties from the vacuum bag, cold pewter eyes in little round metal-rimmed glasses, a sharp, hard nose, a mouth like a slot."
                                            },
                                            {
                                                "example_id": "8a16a3c9-b44d-4515-84cf-fba3664fa7c4",
                                                "sense_id": "16fefa52-6e7c-3eba-8b78-17661a763da9",
                                                "text": "His room was airy with a slight breeze gently blowing in from the top portion of the two-part window which was that had been left ajar for the purpose of refreshing and clearing the dusties."
                                            },
                                            {
                                                "example_id": "e0b421e7-ccb7-445d-bf51-6cd3d98ca1c9",
                                                "sense_id": "16fefa52-6e7c-3eba-8b78-17661a763da9",
                                                "text": "Are the 'dusties' settled in your house? Electrolux will clean them out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
