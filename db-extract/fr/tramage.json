                                    {
                                        "sense_id": "a07c9033-e7da-384d-898d-98d012ac5e6d",
                                        "entry_id": "908df2d1-fb04-37a5-9b84-c1d6a635e1bc",
                                        "glosses": [
                                            "A piece of such material."
