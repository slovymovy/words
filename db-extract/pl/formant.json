                "translations": [
                    {
                        "translation_id": "a2127053-eb96-41c1-8ea3-e31af4949e51",
                        "source_entry_id": "94ef966b-8c0f-3cc3-add7-235acd571f08",
                        "source_sense_id": "32beb232-3b41-311c-84f0-12485f7d3cd8",
                        "target_lang_word": "formant",
