                        ]
                    },
                    {
                        "translation_id": "cb019658-280b-4147-91e0-7dba814941f0",
                        "source_entry_id": "b3b772aa-e466-3c32-bfc6-bb2885192aca",
                        "source_sense_description": "farm worker",
                        "target_lang_word": "Knecht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e39bcb04-b17b-3e77-83ed-fc8232e14ea8",
                                        "entry_id": "88b1ee15-c222-3b54-861c-f826d08c5242",
                                        "glosses": [
                                            "Mann, der auf einem Bauernhof niedere Arbeiten verrichtet"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69aed410-8bd3-4d38-9d92-8628dd1bda7c",
                                                "sense_id": "e39bcb04-b17b-3e77-83ed-fc8232e14ea8",
                                                "text": "„Trommel-Meier und Knecht Stolten traten näher und grinsten Kurt Marenke an, der ostpreußisch, berlinerisch, sächsisch und thüringisch durcheinandersprach, wie es die Zeiten so mit sich gebracht hatten.“"
                                            },
                                            {
                                                "example_id": "847d4b97-e80e-4396-bb87-ecdb31a1d84a",
                                                "sense_id": "e39bcb04-b17b-3e77-83ed-fc8232e14ea8",
                                                "text": "„Es ist noch früh, hauptsächlich sind Knechte und Mägde da.“"
                                            },
                                            {
                                                "example_id": "ee2e8ca8-9908-4077-a7bc-25a50d6fa95a",
                                                "sense_id": "e39bcb04-b17b-3e77-83ed-fc8232e14ea8",
                                                "text": "„Polnische Fremdarbeiter und ehemalige Knechte haben ihn in Besitz genommen und unter sich aufgeteilt.“"
                                            },
                                            {
                                                "example_id": "69f68f7d-8296-407d-8154-8deb2a179140",
                                                "sense_id": "e39bcb04-b17b-3e77-83ed-fc8232e14ea8",
                                                "text": "„Sie übernehmen einen Bauernhof nach dem anderen; Knechte und Herren tauschen die Rollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5af2f0bf-9251-3839-b6df-ba7b0e1be8fe",
                                        "entry_id": "88b1ee15-c222-3b54-861c-f826d08c5242",
                                        "glosses": [
                                            "unfreier, abhängiger Mann"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb9abaa8-57c6-447e-b86c-8fd7846ec536",
                                                "sense_id": "5af2f0bf-9251-3839-b6df-ba7b0e1be8fe",
                                                "text": "Als Politiker ist man schnell der Knecht der öffentlichen Meinung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dc8fde6b-05aa-30d6-a53b-3b2fcd9a0dc9",
                                        "entry_id": "88b1ee15-c222-3b54-861c-f826d08c5242",
                                        "glosses": [
                                            "Diener, Untergebener"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6706408-b538-46e5-8d46-a89cee50dd58",
                                                "sense_id": "dc8fde6b-05aa-30d6-a53b-3b2fcd9a0dc9",
                                                "text": "Er arbeitete, seit er zwanzig geworden war, als Knecht Gottes."
                                            },
                                            {
                                                "example_id": "94d6f4cc-49aa-4b98-9f41-fe4fdb7b3c57",
                                                "sense_id": "dc8fde6b-05aa-30d6-a53b-3b2fcd9a0dc9",
                                                "text": "„Auch die Knechte, die sich dem Kloster verpflichteten, die sogenannten Donaten, waren hier abgetrennt in einem eigenen Bauteil untergebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Knecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "37a304fc-26c8-3006-84cc-e89786f7ae61",
                                        "entry_id": "a637457b-b6fb-345a-878d-39cd46e48143",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8217b8cf-5a6b-4130-a7d6-e0c4c271e3ba",
                                                "sense_id": "37a304fc-26c8-3006-84cc-e89786f7ae61",
                                                "text": "Frau Knecht ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "09b04817-5875-486b-b3bd-f3cf12a76e01",
                                                "sense_id": "37a304fc-26c8-3006-84cc-e89786f7ae61",
                                                "text": "Herr Knecht wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "cdc947db-3cb7-40f6-bd72-4f8907e0ccd6",
                                                "sense_id": "37a304fc-26c8-3006-84cc-e89786f7ae61",
                                                "text": "Die Knechts fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "5de213be-42e3-438b-800d-c05c950cac00",
                                                "sense_id": "37a304fc-26c8-3006-84cc-e89786f7ae61",
                                                "text": "Der Knecht trägt nie die Schals, die die Knecht ihm strickt."
                                            },
                                            {
                                                "example_id": "608d1054-0f4a-4ec8-9e5a-c2d9eb8395d2",
                                                "sense_id": "37a304fc-26c8-3006-84cc-e89786f7ae61",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Knecht kommt, geht der Herr Knecht.“"
                                            },
                                            {
                                                "example_id": "4134c34a-1f90-4577-b2f7-109734a8658c",
                                                "sense_id": "37a304fc-26c8-3006-84cc-e89786f7ae61",
                                                "text": "Knecht kommt und geht."
                                            },
                                            {
                                                "example_id": "e53d6ed1-70bc-4e4c-9507-744baedc0d84",
                                                "sense_id": "37a304fc-26c8-3006-84cc-e89786f7ae61",
                                                "text": "Knechts kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a1d4f25-6936-4dd0-92c9-2fa1b9956d5c",
                        "source_entry_id": "b3b772aa-e466-3c32-bfc6-bb2885192aca",
                        "source_sense_description": "farm worker",
                        "target_lang_word": "Landarbeiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landarbeiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "201bec60-e35c-3cbd-a4cd-a51db2da0e42",
                                        "entry_id": "671c2b28-4038-3a82-b4b4-a44a9dfeaaf6",
                                        "glosses": [
                                            "Person, die als Arbeiter in der Landwirtschaft beschäftigt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32ffb4ea-5f66-4816-897c-21207ce9f99a",
                                                "sense_id": "201bec60-e35c-3cbd-a4cd-a51db2da0e42",
                                                "text": "„Ursprünglich waren ihre Eltern Landarbeiter auf dem Gut der Rothes, doch 1932 fängt der Vater bei der Bahn an.“"
                                            },
                                            {
                                                "example_id": "12829ba5-8aad-40bd-98a2-52887c7839ff",
                                                "sense_id": "201bec60-e35c-3cbd-a4cd-a51db2da0e42",
                                                "text": "Sie haben sich wie Landarbeiter gekleidet, und North muss eine Perücke tragen, da die Einheimischen dieser Region sich nie die Haare schneiden.“"
                                            },
                                            {
                                                "example_id": "cd19899a-8b8e-4dca-adf1-d399d788a801",
                                                "sense_id": "201bec60-e35c-3cbd-a4cd-a51db2da0e42",
                                                "text": "„Und es ist eine Sinnlosigkeit und ein Verbrechen wider die Natur und Kultur, wenn die westeuropäischen Emigranten nun durchaus in Landarbeiter umgewandelt werden sollen.“"
                                            },
                                            {
                                                "example_id": "eaf507de-e8be-4218-abf0-5fcde6f14614",
                                                "sense_id": "201bec60-e35c-3cbd-a4cd-a51db2da0e42",
                                                "text": "„Zurzeit wohnt nur Kspar dort, zeitweise auch osteuropäische Landarbeiter, die Piontek als Erntehelfer anheuert; und die auch – weil Ursula es verlangt und durchgesetzt hat – menschenwürdig versorgt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
