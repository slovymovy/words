                        "entry_id": "86372f68-5767-35a3-aef3-2cf08ced07ed",
                        "glosses": [
                            "łopatka z krótkim uchwytem do przerzucania sypkich materiałów, zagarniania śmieci,"
                        ],
                        "tags": [
                            "itp."
                        ],
                        "examples": [
                            {
                                "example_id": "fc6f8822-e060-45c4-9c83-a2e696ab50d6",
                                "sense_id": "05a96e3e-fb20-39e4-8fcd-222a8fe39821",
                                "text": "Zmiotkę i szufelkę znajdziesz w magazynku."
                            },
                            {
                                "example_id": "b13af421-2d43-4b41-90b8-399b1e777877",
                                "sense_id": "05a96e3e-fb20-39e4-8fcd-222a8fe39821",
                                "text": "Zostaw szufelkę w węglarce przy piecu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "fdfc03db-b578-3365-9ce6-0d8c2a6ac350",
                        "entry_id": "86372f68-5767-35a3-aef3-2cf08ced07ed",
                        "glosses": [
                            "ilość materiału mieszcząca się na szufelce (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
