                        "glosses": [
                            "Gesamtheit dreier selbstständiger Filme, die inhaltlich und thematisch unmittelbar zusammenhängen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7844ebb7-dfd0-4734-b582-bddf90ff3102",
                                "sense_id": "f2ada57c-0977-39fc-9c31-cfbd2335fac0",
                                "text": "„Die Filmtrilogie »Herr der Ringe« von Regisseur Peter Jackson machte Neuseeland weltweit als »Mittelerde« bekannt.“"
                            },
                            {
                                "example_id": "2423a160-a2eb-4e2b-923b-a123141e1a51",
                                "sense_id": "f2ada57c-0977-39fc-9c31-cfbd2335fac0",
                                "text": "„In George A. Romeros Filmtrilogie Night of the Living Dead (1968), Dawn of the Dead (1978) und Day of the Dead (1985) liefen die Zombies immer unter dem freien Himmel herum.“"
                            }
