                                        "glosses": [
                                            "auf Klarheit und Schönheit, auf Maß und Ordnung ausgerichtet"
                                        ],
                                        "tags": [
                                            "insbesondere in der Philosophie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f708113-a212-4461-8f30-f6646c03f5e9",
                                                "sense_id": "5a1aaeab-4bae-3d41-a15f-bcab0bd2db1a",
                                                "text": "„Das auf die Erzeugung von Ordnung und Form bezogene apollinische Moment ist auf das dionysische angewiesen: Nur weil dieses nach Bändigung verlangt, kommt das Apollinische zur Geltung.“"
                                            }
                                        ],
