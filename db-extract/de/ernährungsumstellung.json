                ],
                "senses": [
                    {
                        "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                        "entry_id": "a06c6fa8-ec5a-323d-9d88-b84e2ea18c4c",
                        "glosses": [
                            "Änderung der Nahrungsaufnahme, beispielsweise in Bezug auf Menge, Art und Zeiten der Aufnahme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33ed2a7d-36a1-4810-b174-d186730bd3c6",
                                "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                                "text": "„Es gibt dutzende Ernährungsumstellungen, die immer wieder beworben, dann kritisiert und schließlich doch wieder empfohlen werden.“"
                            },
                            {
                                "example_id": "3a006bf1-a34c-4899-b4a0-a3156e70f2b3",
                                "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                                "text": "„Ob Migräne, Rheuma oder Diabetes – mit einer angeratenen gezielten Ernährungsumstellung schafft es die Ärztin, den Patienten viel Leidensdruck zu nehmen.“"
                            },
                            {
                                "example_id": "b84ec9e2-cd8c-4835-a6f9-7006f803de19",
                                "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                                "text": "„Das Gewicht auf Dauer zu senken klappt nur mit einer Ernährungsumstellung - am besten in kleinen Schritten.“"
                            },
                            {
                                "example_id": "b47e7a0a-2653-4d3c-837f-37b89e4abc14",
                                "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                                "text": "„»Die Wissenschaft ist ziemlich klar: Das größte Potential, um Gewicht zu verlieren, hat eine Ernährungsumstellung«, sagt Lars Donath.“"
                            },
                            {
                                "example_id": "1b9cba82-822c-4c15-aa45-ae8db33802fb",
                                "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                                "text": "„Zu einem nachhaltigen Gewichtsverlust führen nur dauerhafte und (zumindest teilweise) lustvoll erlebte Ernährungsumstellungen.“"
                            },
                            {
                                "example_id": "7ff9c1cc-caa5-473d-aa62-35abbbeae216",
                                "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                                "text": "[Nach dem Fastenbrechen ist es] „wichtig, die Energiezufuhr sehr langsam zu erhöhen und, falls Übergewicht vorlag, gleich nach dem Buchinger-Fasten eine dauerhafte Ernährungsumstellung vorzunehmen.“"
                            },
                            {
                                "example_id": "9cd737a6-0cde-49d5-9a01-2d7958ad8426",
                                "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                                "text": "„Die vegane Ernährung ist vielfach nicht nur eine reine Ernährungsumstellung, sondern kommt mit einem deutlichen Gesinnungswechsel und dem Wunsch, Tier und Natur zu schützen, einher.“"
                            },
                            {
                                "example_id": "c6d581e3-d3f2-40b3-adbf-e4bcc70c0ba4",
                                "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                                "text": "„Grundsätzlich dient die vegane – und vegetarische – Ernährungsumstellung nicht dem Abnehmen, auch wenn sie natürlich hilfreich ist.“"
                            },
                            {
                                "example_id": "fa609b1a-7d3a-472e-86d3-6b46181c6ff3",
                                "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                                "text": "„Generell ist die vegane/vegetarische Ernährungsumstellung jedoch empfehlenswert und bietet die Chance einer sehr gesunden Ernährung.“"
                            },
                            {
                                "example_id": "0d27bf05-d5ae-44d2-bcf1-319228a0a43f",
                                "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                                "text": "[Verzicht auf Zucker:] „Ein Jahr danach will «Puls» wissen, ob die Ernährungsumstellung noch heute anhält und wie der Zuckerverzicht gelingt.“"
                            },
                            {
                                "example_id": "518cad1b-adb5-4f44-b681-4f238cf05003",
                                "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                                "text": "[Diabetes Typ 2:] „Jüngst haben mehrere Studien belegt, dass dieser Diabetes-Typ mit einer Ernährungsumstellung und Gewichtsreduktion genauso gut behandelt werden kann wie mit Medikamenten.“"
                            },
                            {
                                "example_id": "14dc1e28-9d3f-4ecd-9398-e9534bf62d39",
                                "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                                "text": "[mediterrane Ernährung:] „Obwohl der Effekt einer solchen Ernährungsumstellung auf den Serum-Cholesterinspiegel nur moderat ist, stellte sich heraus, dass 50 % weniger Herzerkrankungen auftraten.“"
                            },
                            {
                                "example_id": "93728b4a-5de8-41e9-bdef-6327622e3b52",
                                "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                                "text": "[Verstopfung:] „Eine Ernährungsumstellung mit vermehrter Aufnahme von Ballaststoffen in Kombination mit einer ausreichenden Flüssigkeitsaufnahme und mit mehr Bewegung kann helfen, die Darmtätigkeit anzuregen und die Stuhlkonsistenz zu verbessern.“"
                            },
                            {
                                "example_id": "c37ff6cc-28df-4c47-80bf-63bb49fd54f2",
                                "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                                "text": "[ketogene Ernährung:] „Bei der Ernährungsumstellung sollte deshalb insbesondere auf ausreichende und ausgewogene Zufuhr von Natrium, Kalium und Magnesium geachtet werden.“"
                            },
                            {
                                "example_id": "9ebcf218-1f66-44c6-a690-a48045999ac9",
                                "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                                "text": "[Neuseeland:] „Doch die Ausrottung des Moas [Anm.: ein Laufvogel] in nur wenigen Jahrzehnten und die Populationszunahme ihrer Bevölkerung zwang die Māori zur Ernährungsumstellung. Sie begannen neben dem tradierten Fischkonsum auch Ackerbau zu betreiben.“"
                            },
                            {
                                "example_id": "deb5a702-4fd1-44ca-ae20-e4008fa190df",
                                "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                                "text": "„[…] tatsächlich ist die Wissenschaft sehr lange davon ausgegangen, dass Homo erectus sich von seinen Vorfahren unterschied, weil er mehr Fleisch gegessen hat und diese Ernährungsumstellung dazu führte, dass sich Gehirn- und Körpergröße veränderten.“"
                            },
                            {
                                "example_id": "bc291c69-b29c-4bfa-9949-887916105647",
                                "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                                "text": "„[…] der Verlust der Wildtiere auf unserem Planeten ließe sich mit einfachen Schritten verlangsamen: mit mehr Naturschutzgebieten, weniger Pestiziden in der Landwirtschaft, den Verzicht auf Monokulturen und einer Ernährungsumstellung, das heißt weg von Fleisch und hin zu Pflanzen.“"
                            },
                            {
                                "example_id": "57641902-2060-4ae9-88a1-3b9f67fed3b8",
                                "sense_id": "9391e980-40fb-3603-886e-4e59cca74615",
                                "text": "„»Interessanterweise kann bereits der bloße Wechsel zu einer stärker pflanzlichen 'flexitarischen' Ernährung die Treibhausgasemissionen aus der landwirtschaftlichen Produktion ungefähr halbieren«, so Rockström. Die Ernährungsumstellung \"könne dazu beitragen, alle gesund zu halten: den Planeten, und die Menschen.\"“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
