        "fr-extract.jsonl": [
            {
                "entry_id": "ee98842c-40fd-3e47-af65-235a7c49afbd",
                "word": "hectomètre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9dd049c2-cbc6-4f5e-9b1b-2e0c4962a9c4",
                        "entry_id": "ee98842c-40fd-3e47-af65-235a7c49afbd",
                        "tags": [
                            "plural"
                        ],
                        "form": "hectomètres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6e873e5-1de8-3584-b9d2-7ec23384473a",
                        "entry_id": "ee98842c-40fd-3e47-af65-235a7c49afbd",
                        "glosses": [
                            "Unité de mesure de longueur du Système international (SI), valant 10² mètres, et dont le symbole est hm."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd41a310-3b21-4d14-9358-bc8544b6cbde",
                                "sense_id": "e6e873e5-1de8-3584-b9d2-7ec23384473a",
                                "text": "Déjà les bornes kilométriques nous annoncent la France; les hectomètres eux-mêmes parlent sur cette route."
                            },
                            {
                                "example_id": "d35fa255-a5d0-4ad1-87c7-1ce8abcf1645",
                                "sense_id": "e6e873e5-1de8-3584-b9d2-7ec23384473a",
                                "text": "Puis on tomba dans une route plus large, plus droite, plus dégagée. On l’aimait moins.\nLa distance y prenait une tenue officielle. Au passage, les hectomètres vous toisaient. Le vent, filant sans obstacle, vous dépassait comme un automobiliste riche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3d8c581-10b3-4329-a262-a07b0fc332cd",
                        "source_entry_id": "ee98842c-40fd-3e47-af65-235a7c49afbd",
                        "source_sense_id": "e6e873e5-1de8-3584-b9d2-7ec23384473a",
                        "source_sense_description": "Unité de mesure de longueur",
                        "target_lang_word": "Hektometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hektometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d0209b2-2afd-3a2a-9532-e836b4f4b6ec",
                                        "entry_id": "6b883b2c-a23f-305b-a601-e3262d710449",
                                        "glosses": [
                                            "einhundert Meter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53f8fd1e-aea2-4634-80f9-8e63383f1b89",
                                                "sense_id": "6d0209b2-2afd-3a2a-9532-e836b4f4b6ec",
                                                "text": "Ein Hektometer besteht aus 100 Metern."
                                            },
                                            {
                                                "example_id": "16ba62eb-8c8b-433b-84dd-f2d624e632ad",
                                                "sense_id": "6d0209b2-2afd-3a2a-9532-e836b4f4b6ec",
                                                "text": "„Die Bezugnahme auf zwei durch die Angabe der Entfernung vom Nullpunkt der Forststraße in Hektometer (hm) genau bestimmte und in dem im Akt erliegenden Plan eingezeichnete Punkte der Straße stellt eine ausreichende örtliche Präzisierung dar […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
