                "senses": [
                    {
                        "sense_id": "6555f8db-34e9-3b47-8886-d12341754db8",
                        "entry_id": "1ce5fffb-933c-3e56-95dc-a47d0e7d0186",
                        "glosses": [
                            "Donner un caractère scholaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2362d486-a6ca-45c3-b3b0-0ff6632477f3",
                                "sense_id": "6555f8db-34e9-3b47-8886-d12341754db8",
                                "text": "On ne parle que d’écoles, et l’on n’a pas encore scholarisé les maîtres; l’instruction est en projet, la science en théorie et l’ignorance en pratique."
                            },
                            {
                                "example_id": "98d24a22-e244-4efc-a08c-53b1fe45724b",
                                "sense_id": "6555f8db-34e9-3b47-8886-d12341754db8",
                                "text": "Progressivement cette action va se « Scholariser» : dans nul autre pays étranger, on n’aura l’occasion d’entendre tant d’œuvres d’Alquier, Castéra, Labey ou Séverac, pour ne citer qu’eux."
                            }
                        ]
                    }
