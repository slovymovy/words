                                        "glosses": [
                                            "Of, pertaining to, or characteristic of Pedro Almodóvar (born 1949), Spanish filmmaker, director, screenwriter, producer, and actor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4909bafa-f2be-477b-b700-e4b58768e2ce",
                                                "sense_id": "b30643f1-593d-3cca-a824-8ca086ae1095",
                                                "text": "“Women on the Verge of a Nervous Breakdown,” in 2010, jumbled the image further. His witty songs, with their strong Latin flavor and Almodóvarian edge, evoked the narcissistic torments of a quartet of melodramatic Madrileñas."
                                            }
