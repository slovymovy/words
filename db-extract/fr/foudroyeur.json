                        ],
                        "examples": [
                            {
                                "example_id": "ea4bc0bf-680a-4655-b94d-d77c0f90840b",
                                "sense_id": "f46c02b2-7667-37ed-a3c3-0d7b9d52bd1b",
                                "text": "Ce mec-là, réformé (comment ?) nᵒ 2 avant la guerre, dégueuleur ses tripes en 39 de vitesse de fuite, pleurant la pitié, le voilà foudroyeur en Cour qui vous expédie le piètre gnasse “ad patres” ! au bagne ! tcetera !… au pur culot ! du coup qu’il siège !"
                            }
                        ]
