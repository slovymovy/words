                    {
                        "sense_id": "f26e584a-4538-3ff6-a678-8468a7a9ffe4",
                        "entry_id": "c19daecd-569f-3b10-bfac-b24c082f8d44",
                        "glosses": [
                            "unerhört schlimm; schändlich, ungeheuerlich"
                        ],
                        "tags": [
                            "derogatory",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "db080b27-f1f1-4f04-b160-6e32cfae23d4",
                                "sense_id": "f26e584a-4538-3ff6-a678-8468a7a9ffe4",
                                "text": "“In any event, the UN resolutions were clear, as were the repeated Serb violations – including, most egregiously, in the Serb-captured ‘safe area’ of Srebrenica, where the massacre of some 8,000 men and boys was later judged by an international court as constituting ‘genocide’.”",
                                "translation": "„In jedwedem Fall waren die UN-Resolutionen eindeutig, wie auch die wiederholten serbischen Übergriffe – darunter, am schändlichsten, [die] in der von den Serben eroberten ‚geschützten Zone‘ von Srebrenica, wo das Massaker an etwa 8000 Männern und Jungen später vom Internationalen Gerichtshof als ‚Genozid‘ beurteilt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "523bd56d-7f65-489c-8891-28cea75e278b",
                        "source_entry_id": "c19daecd-569f-3b10-bfac-b24c082f8d44",
                        "source_sense_id": "f26e584a-4538-3ff6-a678-8468a7a9ffe4",
                        "source_sense_description": "gehoben abwertend: unerhört schlimm; schändlich, ungeheuerlich",
                        "target_lang_word": "unerhört",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unerhört",
