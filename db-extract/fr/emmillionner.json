                ],
                "senses": [
                    {
                        "sense_id": "b51a4564-70d2-36ae-ad22-35f62da659e6",
                        "entry_id": "9fd04313-9183-3791-9a06-b96f27443ca2",
                        "glosses": [
                            "Enrichir à millions."
                        ],
                        "tags": [
                            "dated",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "c1d476ef-70dd-4908-b9e2-35b6cc7018af",
                                "sense_id": "b51a4564-70d2-36ae-ad22-35f62da659e6",
                                "text": "On voit qu'à cette époque, les hommes de bien, les vrais amis de la liberté ne songeaient guère à s’emmillionner, et qu'ils savaient mourir pauvres... Noble science !"
                            },
                            {
                                "example_id": "4b357720-22b1-4f5a-bb21-d5d2a268c457",
                                "sense_id": "b51a4564-70d2-36ae-ad22-35f62da659e6",
                                "text": "[…] ; tous, même les moins conscients, savaient admirablement à quoi s’en tenir sur les vaillants industriels qui s’emmillionnaient sans fatigue en faisant travailler à cinq cents mètres sous terre tout un peuple d’esclaves pour des salaires de famine."
                            },
                            {
                                "example_id": "7e814385-3714-4e73-b05b-569dd1faf00a",
                                "sense_id": "b51a4564-70d2-36ae-ad22-35f62da659e6",
                                "text": "Quand le savant saura que ses découvertes et ses travaux aideront à rendre l'existence des hommes plus douce et plus facile, et non plus à emmillionner quelques individus, il aura plus de cœur à l'ouvrage."
                            },
                            {
                                "example_id": "735986b4-fc26-4147-9e89-02bdd57617fe",
                                "sense_id": "b51a4564-70d2-36ae-ad22-35f62da659e6",
                                "text": "Des intermédiaires parasites, des commerçants occasionnels, des spéculateurs sans vergogne, étrangers à toute production et à tout travail, ne s’emmillionnent-ils pas chaque jour sous nos yeux […] ?"
                            }
                        ]
                    }
