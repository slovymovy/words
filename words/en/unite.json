    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b73dc72-3efe-3ddb-869f-902dcbe86758",
                    "sense_definition": "To bring people or things together to form a single unit or group.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "unite_verb_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new government will try to <w>unite</w> the various factions.",
                            "target_lang_translations": {
                                "ru": "Новое правительство попытается <w>объединить</w> различные фракции.",
                                "zh": "新政府将试图<w>联合</w>各派系。",
                                "es": "El nuevo gobierno intentará <w>unir</w> a las diversas facciones."
                            }
                        },
                        {
                            "text": "Music has the power to <w>unite</w> people from different cultures.",
                            "target_lang_translations": {
                                "ru": "Музыка обладает силой <w>объединять</w> людей разных культур.",
                                "zh": "音乐有力量将不同文化背景的人<w>团结</w>在一起。",
                                "es": "La música tiene el poder de <w>unir</w> a personas de diferentes culturas."
                            }
                        }
                    ],
                    "synonyms": [
                        "join",
                        "combine",
                        "merge"
                    ],
                    "antonyms": [
                        "divide",
                        "separate"
                    ],
                    "common_phrases": [
                        "unite the country",
                        "unite the people",
                        "unite efforts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединять людей или вещи вместе, образуя единое целое или группу.",
                        "zh": "使人或事物结合在一起，形成一个整体或群体。",
                        "es": "Juntar personas o cosas para formar una sola unidad o grupo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объединять",
                                "target_lang_sense_clarification": "соединять в одно целое"
                            },
                            {
                                "target_lang_word": "сплачивать",
                                "target_lang_sense_clarification": "делать дружным, единодушным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "联合",
                                "target_lang_sense_clarification": "结合在一起以实现共同目标"
                            },
                            {
                                "target_lang_word": "统一",
                                "target_lang_sense_clarification": "使分散的事物成为一个整体"
                            },
                            {
                                "target_lang_word": "团结",
                                "target_lang_sense_clarification": "使人齐心协力"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "unir",
                                "target_lang_sense_clarification": "poner varias cosas conformando un todo"
                            },
                            {
                                "target_lang_word": "cohesionar",
                                "target_lang_sense_clarification": "unir de manera coherente para dar unidad"
                            },
                            {
                                "target_lang_word": "aunar",
                                "target_lang_sense_clarification": "juntar varias cosas para que conformen una sola"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a98df84-6d94-3148-9c51-964e483d7f20",
                    "sense_definition": "To come together or join forces for a common purpose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "unite_verb_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If we want to win, we will need to <w>unite</w>.",
                            "target_lang_translations": {
                                "ru": "Если мы хотим победить, нам нужно <w>объединиться</w>.",
                                "zh": "如果我们想赢，就需要<w>联合</w>起来。",
                                "es": "Si queremos ganar, tendremos que <w>unirnos</w>."
                            }
                        },
                        {
                            "text": "The workers decided to <w>unite</w> against the unfair policies.",
                            "target_lang_translations": {
                                "ru": "Рабочие решили <w>объединиться</w> против несправедливой политики.",
                                "zh": "工人们决定<w>团结</w>起来反对不公平的政策。",
                                "es": "Los trabajadores decidieron <w>unirse</w> contra las políticas injustas."
                            }
                        }
                    ],
                    "synonyms": [
                        "join",
                        "team up",
                        "band together"
                    ],
                    "antonyms": [
                        "separate"
                    ],
                    "common_phrases": [
                        "unite against",
                        "unite behind",
                        "unite as one"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собираться вместе или объединять усилия ради общей цели.",
                        "zh": "为了共同的目标而聚集在一起或联合力量。",
                        "es": "Juntarse o unir fuerzas para un propósito común."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объединяться",
                                "target_lang_sense_clarification": "действовать сообща"
                            },
                            {
                                "target_lang_word": "сплотиться",
                                "target_lang_sense_clarification": "достигать единства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "联合",
                                "target_lang_sense_clarification": "为了共同目的而结合"
                            },
                            {
                                "target_lang_word": "团结",
                                "target_lang_sense_clarification": "为了共同目标而齐心协力"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "unirse",
                                "target_lang_sense_clarification": "ponerse en consonancia o de acuerdo las voluntades de varias personas"
                            },
                            {
                                "target_lang_word": "juntarse",
                                "target_lang_sense_clarification": "congregar personas en un mismo lugar para un fin"
                            }
                        ]
                    }
                }
            ]
        },
        {
