                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2858cec1-5e8c-48d2-89fc-11e8353cc553",
                                "sense_id": "684ffce6-9e1d-3a08-87dc-89b7ad54ef28",
                                "text": "[Софья Игнатьевна Турусина, жен] Не ворожеи, а гадальщицы, ― это большая разница; к ворожее я бы не поехала ни за что."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e77797b-0b27-47d9-a72f-4aaf92aec261",
                        "source_entry_id": "e19ed592-9c85-378f-bd00-789462ceec27",
                        "source_sense_id": "684ffce6-9e1d-3a08-87dc-89b7ad54ef28",
                        "target_lang_word": "fortune-teller",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fortune-teller",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9847f24a-f947-3452-a54e-32069c075f73",
                                        "entry_id": "c8e09518-ff9b-334c-8125-5f26054a218a",
                                        "glosses": [
                                            "A person who professes to predict the future in return for money."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b104375-e7a8-4db6-87fb-b50c83e2df5c",
                                                "sense_id": "9847f24a-f947-3452-a54e-32069c075f73",
                                                "text": "\"Cross my palm with silver and I'll tell you your fortune,\" said the fortune-teller."
                                            },
                                            {
                                                "example_id": "034ad2d7-8dfe-4a49-a068-3c901f36b5d2",
                                                "sense_id": "9847f24a-f947-3452-a54e-32069c075f73",
                                                "text": "So I guess the fortune teller's right / I should've seen just what was there"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "835f6212-a660-3069-a0bf-436ba42cd649",
                                        "entry_id": "c8e09518-ff9b-334c-8125-5f26054a218a",
                                        "glosses": [
                                            "A cootie catcher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5040ae2-533a-4c2a-8d94-f879e517bb9c",
                                                "sense_id": "835f6212-a660-3069-a0bf-436ba42cd649",
                                                "text": "The usual exchange between English children is as follows: A: Who do you love? (referring to one of the names on the fortune-teller) B: Simon. A: S-I-M-O-N (alternately opens and shuts the device as he or she says each letter)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "313c61c7-769d-43cc-b794-b4ff1f20cce0",
                        "source_entry_id": "e19ed592-9c85-378f-bd00-789462ceec27",
                        "source_sense_id": "684ffce6-9e1d-3a08-87dc-89b7ad54ef28",
