                "senses": [
                    {
                        "sense_id": "aaadb026-5ede-332c-8fac-a1fec39a3b09",
                        "entry_id": "32f23695-8c61-354c-aee1-428b671d81de",
                        "glosses": [
                            "op een goede manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20ee7b71-07e3-45ef-90ea-e9a1f39b233b",
                                "sense_id": "aaadb026-5ede-332c-8fac-a1fec39a3b09",
                                "text": "Ik nader de dertig en heb het gevoel dat ik helemaal opnieuw moet beginnen, in een stad die mijn naam niet eens treffelijk kan uitspreken. Nele. Een naam zo Vlaams als regen op stront op klei. Daan heeft vast hetzelfde probleem."
                            },
                            {
                                "example_id": "8555aeae-8fcd-44b0-91c1-874bd56ffd67",
                                "sense_id": "aaadb026-5ede-332c-8fac-a1fec39a3b09",
                                "text": "Als u deze zomer naar de Kust trekt, dan stelt u zich daar natuurlijk massaal dezelfde vraag: waar kun je treffelijk eten? Op de zeedijk lukt dat zelden, en zeker niet in Middelkerke, een dorp waar goede koks doorgaans niet aan denken om zich te vestigen."
                            },
                            {
                                "example_id": "4796a344-45b5-4376-9234-a581ba83a0c4",
                                "sense_id": "aaadb026-5ede-332c-8fac-a1fec39a3b09",
                                "text": "En toch kunnen we over zijn finaleproef bijzonder kort zijn. Chi Ho Han speelde een treffelijke versie van het plichtwerk, gevolgd door een stereotiep uitstekende Rachmaninov."
                            }
                        ]
                    }
                ],
