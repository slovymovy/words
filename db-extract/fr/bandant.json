                    },
                    {
                        "translation_id": "43d55abd-7fb6-46b7-b194-b895365be613",
                        "source_entry_id": "b6473125-95a4-3eb5-b839-9e38184ec14e",
                        "source_sense_id": "23e2b853-dd00-3467-a710-f46daf2708a3",
                        "source_sense_description": "umgangssprachlich, übertragen, meist verneint: aufregend, berauschend, toll",
                        "target_lang_word": "aufregend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aufregend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d1782e1-bdbe-39f7-b988-d603e2afaf3c",
                                        "entry_id": "b5d7c02d-379a-348a-a002-2ed5bd3b83d8",
                                        "glosses": [
                                            "innerlich aufwühlend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b3a7382-5ad0-4881-beb5-b66b8518465f",
                                                "sense_id": "6d1782e1-bdbe-39f7-b988-d603e2afaf3c",
                                                "text": "„Das schönste und aufregendste Gefühl auf der Welt ist die Liebe.“"
                                            },
                                            {
                                                "example_id": "174ddd11-1a9d-44f0-b5f5-fd302c7cbd81",
                                                "sense_id": "6d1782e1-bdbe-39f7-b988-d603e2afaf3c",
                                                "text": "[…] „beide merken bald, dass ihre Liebe etwas ganz Besonderes ist. Sie genießen unbeschwerte und aufregende Tage auf dem Land.“"
                                            },
                                            {
                                                "example_id": "eee4abe8-0ef3-46e7-9e5f-7cb5c29f0de6",
                                                "sense_id": "6d1782e1-bdbe-39f7-b988-d603e2afaf3c",
                                                "text": "[…] „der junge Fußballtrainer steht vor seiner bislang aufregendsten Saison, die sicher an die Nerven gehen und vollen Einsatz erfordern wird.“"
                                            },
                                            {
                                                "example_id": "fba1b44d-126e-497f-931e-29a6e0efe048",
                                                "sense_id": "6d1782e1-bdbe-39f7-b988-d603e2afaf3c",
                                                "text": "„Wir sehnen uns zurück in unsere Zeit als Teenager ohne große Verantwortung und viele aufregende erste Male.“"
                                            },
                                            {
                                                "example_id": "eac5a367-b4d2-493d-885a-62c6ea75e8e9",
                                                "sense_id": "6d1782e1-bdbe-39f7-b988-d603e2afaf3c",
                                                "text": "[Mike Powell springt Weltrekord bei den Leichtathletik-Weltmeisterschaften 1991:] „In einem aufregenden Duell mit dem mehrfachen Olympiasieger Carl Lewis gewann er dank dieses Sprunges den Weltmeistertitel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e1c96b8-d445-336b-966b-ef1727bbe3a2",
                                        "entry_id": "b5d7c02d-379a-348a-a002-2ed5bd3b83d8",
                                        "glosses": [
                                            "sehr interessant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6870d6ad-bc96-4553-ac5d-c0b75c9cc6cc",
                                                "sense_id": "9e1c96b8-d445-336b-966b-ef1727bbe3a2",
                                                "text": "„Diesmal beschäftigen wir uns mit der Suche nach dem besten Ausblick und zeigen einige der aufregendsten Skywalks in Europa.“"
                                            },
                                            {
                                                "example_id": "fef743b8-275e-4b59-80fb-64cc33b31e27",
                                                "sense_id": "9e1c96b8-d445-336b-966b-ef1727bbe3a2",
                                                "text": "„London zählt zu den aufregendsten Metropolen der Welt“ […]."
                                            },
                                            {
                                                "example_id": "a4f85680-cce9-4aeb-b169-8380b5ed1205",
                                                "sense_id": "9e1c96b8-d445-336b-966b-ef1727bbe3a2",
                                                "text": "[Tove Jansson (1914-2001): ] „In \"Tove\" erzählt Regisseurin Zaida Bergroth vom aufregenden Leben der wohl bekanntesten Autorin und Zeichnerin Finnlands,“ […]."
                                            },
                                            {
                                                "example_id": "5dc31759-affc-4541-8db7-6ab5f4f34c37",
                                                "sense_id": "9e1c96b8-d445-336b-966b-ef1727bbe3a2",
                                                "text": "„Teodor Currentzis gilt als einer der aufregendsten Musiker der Gegenwart.“"
                                            },
                                            {
                                                "example_id": "d5c3f552-8a85-4f04-9774-82c74df8be24",
                                                "sense_id": "9e1c96b8-d445-336b-966b-ef1727bbe3a2",
                                                "text": "[…] „Trent Dalton vermischt in seinem zweiten Roman Elemente der australischen Geschichte, Abenteuer und Fantasy - über weite Strecken ein richtig aufregendes Buch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
