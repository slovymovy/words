                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e429816-0aa7-47b9-b698-3ae78e3186d8",
                                                "sense_id": "bbe7f6c4-9115-3fa5-ba1d-ed787a3865db",
                                                "text": "And both encreast the prayse of woman kynde, / And both encreast her beautie excellent: / So all did make in her a perfect complement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf1e245b-2129-35a3-b45b-c9f8427d6a9a",
                                        "entry_id": "15f5041e-f002-3c1b-9467-e6e2378a8f6b",
                                        "glosses": [
                                            "Something which completes one's equipment, dress etc.; an accessory."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "441277c4-fa2c-4ed6-aa26-37e674a7e53c",
                                                "sense_id": "cf1e245b-2129-35a3-b45b-c9f8427d6a9a",
                                                "text": "A doleful case desires a doleful song,\nWithout vain art or curious complements."
                                            },
                                            {
                                                "example_id": "bb8f9ed0-dca3-4ea9-92f0-8f6e764a74ce",
                                                "sense_id": "cf1e245b-2129-35a3-b45b-c9f8427d6a9a",
                                                "text": "Garnish'd and deck'd in modest complement,"
                                            },
                                            {
                                                "example_id": "d8d99f11-028c-4131-b360-e015659218ac",
                                                "sense_id": "cf1e245b-2129-35a3-b45b-c9f8427d6a9a",
                                                "text": "A man should be judged by himselfe, and not by his complements."
                                            }
                                        ]
                                    }
                                ]
                            },
