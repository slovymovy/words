                "senses": [
                    {
                        "sense_id": "2279e821-732e-3346-9224-d8787c3d987d",
                        "entry_id": "0b57bff5-f26e-3c23-8889-1429d9d3f5f8",
                        "glosses": [
                            "weibliche Person, die auf dem Friedhof die Gräber aushebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51038cc2-a9aa-4420-8a64-fad25dbc37f8",
                                "sense_id": "2279e821-732e-3346-9224-d8787c3d987d",
                                "text": "Die Totengräberin hatte schon drei Gräber ausgehoben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e4827fd3-295e-3e92-ad07-26c7e8ffca0a",
                        "entry_id": "0b57bff5-f26e-3c23-8889-1429d9d3f5f8",
                        "glosses": [
                            "weibliche Person, die einen schlechten Einfluss ausübt, eine Sache ins Grab bringt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "23c5ee3d-9770-4781-8d8e-5a8d661979dd",
                                "sense_id": "e4827fd3-295e-3e92-ad07-26c7e8ffca0a",
                                "text": "„Sie ist aber auch die Totengräberin der Dynastie Romanow, denn wegen Rasputin hat sie den allgemeinen Haß und die Verachtung auf den Kaiser und die Dynastie herabgerufen, selbst jener, die von Rasputin Rang, Ehren und Ämter erhalten hatten, weil sie es ihm nicht verzeihen konnten, daß sie sich vor einem solchen Bauern erniedrigen und um Gnaden bitten mußten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
