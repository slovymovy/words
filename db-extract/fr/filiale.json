                "senses": [
                    {
                        "sense_id": "9411a8d6-1d24-3b4d-9d95-95b50d64275e",
                        "entry_id": "8b283e28-5bef-36af-87f0-9172ed55fb52",
                        "glosses": [
                            "Société appartenant à une société mère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29c6169d-aaef-4679-9573-ba3754d57dc7",
                                "sense_id": "9411a8d6-1d24-3b4d-9d95-95b50d64275e",
                                "text": "- CERALIMENT.LU.BRUN à Augy fabrique des biscottes, du pain grillé, des biscuits et réalise de la panification fraîche. C’est une filiale de la GÉNÉRALE BISCUIT, l’un des premiers groupes européens né de la fusion successive de plusieurs entreprises concurrentes."
                            },
                            {
                                "example_id": "401ffa55-019a-4450-be9e-cef380057c64",
                                "sense_id": "9411a8d6-1d24-3b4d-9d95-95b50d64275e",
                                "text": "Il arrive aussi que ce ne soit pas une filiale qui soit cédée mais directement la société mère du groupe."
                            },
                            {
                                "example_id": "481e2c0d-0681-4ee8-b277-e4c80bcc31aa",
                                "sense_id": "9411a8d6-1d24-3b4d-9d95-95b50d64275e",
                                "text": "Le crédit conso n'est plus en effet seulement l'affaire des filiales spécialisées des banques, des hypermarchés ou des constructeurs automobiles. De nouveaux acteurs sont apparus : les banques en ligne, notamment, qui désormais s'intéressent toutes à ce produit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65d6da5c-85f5-44fb-ae39-56fc96de84ab",
                        "source_entry_id": "8b283e28-5bef-36af-87f0-9172ed55fb52",
                        "source_sense_id": "9411a8d6-1d24-3b4d-9d95-95b50d64275e",
                        "target_lang_word": "Tochtergesellschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tochtergesellschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83902490-bb78-33ed-a853-3f5445c6a41f",
                                        "entry_id": "f4ad8bb4-ae32-3a86-8723-3a9d87f3def9",
                                        "glosses": [
                                            "rechtlich eigenständiges, aber wirtschaftlich unselbstständiges Unternehmen, das von der Hauptgesellschaft (kurz auch: Muttergesellschaft) geführt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "601c3c26-3a07-4fdc-862b-46f9f9f968b8",
                                                "sense_id": "83902490-bb78-33ed-a853-3f5445c6a41f",
                                                "text": "Die Tochtergesellschaft in Madrid hat vergangenes Jahr deutlich mehr Gewinn erzielt als ein Jahr zuvor."
                                            },
                                            {
                                                "example_id": "bb1aec2e-03e2-40f7-89e7-8aee371edc3e",
                                                "sense_id": "83902490-bb78-33ed-a853-3f5445c6a41f",
                                                "text": "„Hochrangige Bahn-Insider sprechen laut dem Bericht von einem »IT-Chaos«, das sich durch alle Tochtergesellschaften ziehe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
