                ],
                "senses": [
                    {
                        "sense_id": "2e7da2b4-7183-3aed-97f3-cd6991f189b0",
                        "entry_id": "1aabab09-9651-3375-a432-25fe5e4ddf60",
                        "glosses": [
                            "Se dit d’une fonction qui a exactement le même résultat qu’on l’appelle une fois ou plusieurs : fof=f,."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5921da6f-ddd8-4089-ae23-f8d23b4b371e",
                                "sense_id": "2e7da2b4-7183-3aed-97f3-cd6991f189b0",
                                "text": "Mais ici apparaît une différence avec tous les opérateurs modaux ; “très très grand” n’est pas équivalent à “très grand”. L’opérateur “très” n’est pas idempotent…"
                            },
                            {
                                "example_id": "7faae745-9c7c-4403-9d7e-525836c4981f",
                                "sense_id": "2e7da2b4-7183-3aed-97f3-cd6991f189b0",
                                "text": "La fonction cofinalité est idempotente et à valeurs dans Card."
                            }
                        ]
                    },
                    {
                        "sense_id": "07416dc3-922c-3b4a-b3e8-15ca610d9f82",
                        "entry_id": "1aabab09-9651-3375-a432-25fe5e4ddf60",
                        "glosses": [
                            "Qualifie un nombre qui est son propre carré : a×a=a."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dec6b158-faff-4f27-a777-0aa6f5723013",
                        "source_entry_id": "1aabab09-9651-3375-a432-25fe5e4ddf60",
                        "source_sense_id": "2e7da2b4-7183-3aed-97f3-cd6991f189b0",
                        "target_lang_word": "idempotent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idempotent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68e91fda-ad88-303a-8f96-9af065560297",
                                        "entry_id": "367ceac1-4998-3cb6-adc8-40dd378d5ed9",
                                        "glosses": [
                                            "so, dass es sich bei Verknüpfung mit sich wieder selbst ergibt (xdisplaystyle ∘x=x)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4698bd27-cc26-4181-a95d-7d927356c4f2",
                                                "sense_id": "68e91fda-ad88-303a-8f96-9af065560297",
                                                "text": "„Bei der Suche nach idempotenten Zahlen werden vielfältige algebraische und zahlentheoretische Zusammenhänge entdeckt.“"
                                            },
                                            {
                                                "example_id": "2d244977-1f25-4017-95fa-3e1c983e25f3",
                                                "sense_id": "68e91fda-ad88-303a-8f96-9af065560297",
                                                "text": "„Unipotente Gruppoide, freie Monoide und Gruppen besitzen jeweils genau ein idempotentes Element.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62e36226-6f02-4b58-be5d-eef374500b61",
                        "source_entry_id": "1aabab09-9651-3375-a432-25fe5e4ddf60",
                        "source_sense_id": "2e7da2b4-7183-3aed-97f3-cd6991f189b0",
                        "target_lang_word": "idempotent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idempotent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95dcf4bf-0b36-3f00-8637-eda22317e748",
                                        "entry_id": "fc1d05b1-ca42-385e-ad23-0a699bead1d2",
                                        "glosses": [
                                            "(said of a function) Such that, when performed multiple times on the same subject, it has no further effect on its subject after the first time it is performed."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "888c4bbb-9ef2-438e-aeeb-ae57871015e3",
                                                "sense_id": "95dcf4bf-0b36-3f00-8637-eda22317e748",
                                                "text": "A projection operator is idempotent."
                                            },
                                            {
                                                "example_id": "93295196-8de1-400c-b851-8929e745d2ca",
                                                "sense_id": "95dcf4bf-0b36-3f00-8637-eda22317e748",
                                                "text": "An HTTP request using the PUT verb should be idempotent, so that it can be sent to the server any number of times with the same end result."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9b563c2-a975-3d7b-aa20-33d00b84fe03",
                                        "entry_id": "fc1d05b1-ca42-385e-ad23-0a699bead1d2",
                                        "glosses": [
                                            "(said of an element of an algebraic structure with a binary operation, such as a group or semigroup) Such that, when it operates on itself, the result is equal to itself."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "191ea93b-217c-4fc1-88a7-eeba2b9bcc23",
                                                "sense_id": "e9b563c2-a975-3d7b-aa20-33d00b84fe03",
                                                "text": "Every finite semigroup has an idempotent element."
                                            },
                                            {
                                                "example_id": "936af9b7-fa55-44ec-a416-900fc1d4de80",
                                                "sense_id": "e9b563c2-a975-3d7b-aa20-33d00b84fe03",
                                                "text": "Every group has a unique idempotent element: namely, its identity element."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c3e10aa-25a9-3fe8-afa8-4b778ed9d6f5",
                                        "entry_id": "fc1d05b1-ca42-385e-ad23-0a699bead1d2",
                                        "glosses": [
                                            "(said of a binary operation) Such that all of the distinct elements it can operate on are idempotent (in the sense given just above)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "295efa01-0d4f-4d80-be25-f60391f83fc5",
                                                "sense_id": "2c3e10aa-25a9-3fe8-afa8-4b778ed9d6f5",
                                                "text": "Since the AND logical operator is commutative, associative, and idempotent, it distributes with respect to itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45d35e79-d317-3c10-9aeb-7b749719b916",
                                        "entry_id": "fc1d05b1-ca42-385e-ad23-0a699bead1d2",
                                        "glosses": [
                                            "(said of an algebraic structure) Having an idempotent operation (in the sense given above)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "idempotent",
                                "target_lang_code": "en",
                                "target_senses": [
