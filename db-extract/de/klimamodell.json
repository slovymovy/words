                "senses": [
                    {
                        "sense_id": "047ba363-bd76-3115-86b0-10f468e92334",
                        "entry_id": "b52f4be0-05c1-32a2-8bcb-dbaa83daff0b",
                        "glosses": [
                            "Gesamtheit mathematischer Funktionen, mit deren Hilfe das zukünftige Klima vorhergesagt werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29748671-4fe6-4c16-9de8-3f380a9c88b6",
                                "sense_id": "047ba363-bd76-3115-86b0-10f468e92334",
                                "text": "„Goddard-Instituts für Weltraumstudien (GISS) der NASA veröffentlichte 1988 ein Klimamodell mit drei Emissionsszenarien.“"
                            },
                            {
                                "example_id": "f8ea555a-3685-4876-8c41-fce4fee9f971",
                                "sense_id": "047ba363-bd76-3115-86b0-10f468e92334",
                                "text": "„Darüber hinaus dürften einige Klimamodelle zu stark auf die Konzentration von Treibhausgasen reagieren.“"
                            },
                            {
                                "example_id": "6fe6f19f-6bff-451b-8862-3e3a2095f085",
                                "sense_id": "047ba363-bd76-3115-86b0-10f468e92334",
                                "text": "„Die gängigen Klimamodelle nehmen daher an, dass sich die Erde bis 2050 »nur« um zwei Grad und bis 2100 mindestens um drei Grad erwärmt.“"
                            },
                            {
                                "example_id": "663eb0cb-5f63-46be-85f8-3a3aa99d36b1",
                                "sense_id": "047ba363-bd76-3115-86b0-10f468e92334",
                                "text": "[2023:] „Seit 2020 hat sich das CO2-Budget für die Einhaltung der 1,5-Grad-Grenze halbiert. Grund sind hohe Emissionen und ein aktualisiertes Klimamodell.“"
                            },
                            {
                                "example_id": "592ef5f0-e5dc-4967-8949-e1866f20995e",
                                "sense_id": "047ba363-bd76-3115-86b0-10f468e92334",
                                "text": "„Klimamodelle, die die zukünftige Erderwärmung voraussagen und Naturkatastrophen in direkten Zusammenhang mit dem Klimawandel stellen, stießen zunächst auf harsche Kritik. Jetzt wurden die Pioniere dieser Wissenschaft mit dem Nobelpreis für Physik ausgezeichnet.“"
                            },
                            {
                                "example_id": "2f841da1-b1a2-48bb-910a-6f2641bb70fa",
                                "sense_id": "047ba363-bd76-3115-86b0-10f468e92334",
                                "text": "„Mit Hilfe von Klimamodellen haben die Wissenschaftlerinnen und Wissenschaftler die Auswirkungen auf das globale und regionale Klima auf der Basis von Szenarien untersucht.“"
                            },
                            {
                                "example_id": "546eaf33-3fda-4225-90d7-d0c716515b1a",
                                "sense_id": "047ba363-bd76-3115-86b0-10f468e92334",
                                "text": "„Eine Änderung von nur 1 °C ist laut den Klimamodellen nur bei deutlicher Reduktion der Emission von Treibhausgasen möglich.“"
                            },
                            {
                                "example_id": "66aadb11-4fd5-451a-a884-34ccfb8dd53f",
                                "sense_id": "047ba363-bd76-3115-86b0-10f468e92334",
                                "text": "„Die Auflösung (Gitterpunktabstand) globaler Klimamodelle ist sehr grob, damit sie innerhalb einer akzeptablen Rechenzeit über viele Jahre gerechnet werden können.“"
                            }
                        ],
