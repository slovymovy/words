                "senses": [
                    {
                        "sense_id": "192739f2-b00e-3f1e-b273-fa8b053c5e8f",
                        "entry_id": "379e4364-6047-3240-aa4b-5e028d08cbbc",
                        "glosses": [
                            "Zustand, in dem nicht genügend Personal oder Material zur Verfügung steht, um alle Aufträge/Lieferungen zu bewältigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6efc1b6-bf4c-4322-a241-ec20d3fd6cd8",
                                "sense_id": "192739f2-b00e-3f1e-b273-fa8b053c5e8f",
                                "text": "Durch den Streik der Belegschaft kam es zu einem Lieferengpass."
                            },
                            {
                                "example_id": "48ce62c5-4d08-41e4-82f6-37345c03cbbc",
                                "sense_id": "192739f2-b00e-3f1e-b273-fa8b053c5e8f",
                                "text": "Weil bei der Spedition alle Lkws abgebrannt sind, müssen die Kunden mit Lieferengpässen rechnen."
                            },
                            {
                                "example_id": "5ee10f81-f4ea-45d8-a6ef-d7293354af21",
                                "sense_id": "192739f2-b00e-3f1e-b273-fa8b053c5e8f",
                                "text": "„Die Abwrackprämie ist seit Anfang des Jahres in aller Munde. Und in den Lokalnachrichten ist zu hören, dass die Gebrauchtwagenhändler sich vor Arbeit kaum noch retten können. Von ersten Lieferengpässen ist die Rede.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
