                ],
                "senses": [
                    {
                        "sense_id": "4a273d3a-c8b7-3aff-9cd2-b1c3e8be4a56",
                        "entry_id": "b860c281-1f25-31f3-8c27-48c0552eb20b",
                        "glosses": [
                            "vielfache Schüsse durch Geschütze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c43f5b5-96ba-417f-bf68-648a60b95663",
                                "sense_id": "4a273d3a-c8b7-3aff-9cd2-b1c3e8be4a56",
                                "text": "„Geschützfeuer war zu hören, und in der Nacht, als wir von der Arbeit kamen, war der Himmel ganz feuerrot.“"
                            },
                            {
                                "example_id": "a903bdb1-6839-4222-af43-2428cb0cc44f",
                                "sense_id": "4a273d3a-c8b7-3aff-9cd2-b1c3e8be4a56",
                                "text": "„Kurz vor Kriegsende hatte man es dem Sanitäter Wendelin Tippelt verliehen für die Rettung Verwundeter aus dem Geschützfeuer.“"
                            },
                            {
                                "example_id": "a7280e91-9d69-40ec-bf08-391dd4492f5b",
                                "sense_id": "4a273d3a-c8b7-3aff-9cd2-b1c3e8be4a56",
                                "text": "„Die Auseinandersetzung erhielt durch das Geschützfeuer zugeschlagener Türen zusätzliche Würze und verlief sich in beleidigtem Schweigen, flackerte dann aber mitten aus der trügerischen Stille immer wieder auf.“"
                            },
                            {
                                "example_id": "080d4429-bbda-4440-9dea-01fe76697b5f",
                                "sense_id": "4a273d3a-c8b7-3aff-9cd2-b1c3e8be4a56",
                                "text": "„Mit der größten Anstrengung arbeitete sich Kutusow aus dem Strom der Flüchtigen nach links heraus und ritt mit seiner, um über die Hälfte zusammengeschmolzenen Suite auf das in der Nähe krachende Geschützfeuer zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
