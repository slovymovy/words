                                        "glosses": [
                                            "Characterized by a dream-like or nightmare-like state, often as part of schizophrenia."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40f159e1-7126-4813-9e0f-d696e6f8abc8",
                                                "sense_id": "79c64807-82e8-3c79-b3c2-77b14e9bece0",
                                                "text": "Oneiroid state is described as narrowing of consciousness together with multiple scenic hallucinations. Such a state may occur in schizophrenia, but may also be observed in patients under excessive care and dependent upon others."
                                            }
                                        ]
                                    }
