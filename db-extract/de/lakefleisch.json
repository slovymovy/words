                        "sense_id": "aef7b8fe-667b-3af9-95e7-6ce6bbcc3671",
                        "entry_id": "6c6f7c1e-1010-39cf-ba23-e64b24f729d0",
                        "glosses": [
                            "in Glut gegartes vorher in Salzlake eingelegtes Schweinefleisch"
                        ],
                        "tags": [
                            "Spessart"
                        ],
                        "examples": [
                            {
                                "example_id": "7d901948-0de8-4d8a-b7fc-5a310fa6bc0d",
                                "sense_id": "aef7b8fe-667b-3af9-95e7-6ce6bbcc3671",
                                "text": "„In den Regionen Bayerns bestens bekannt ist das Lakefleisch, welches ursprünglich gut eingewickelt in der Holzglut im Freien gegart wird.“"
                            },
                            {
                                "example_id": "d5a876a1-3587-4d20-af8e-b9abf81735ca",
                                "sense_id": "aef7b8fe-667b-3af9-95e7-6ce6bbcc3671",
                                "text": "„Das Lakefleisch wird in Alufolie und Zeitungspapier in der Glut eines großen Feuers vergraben und ist nach 30–40 Minuten fertig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
