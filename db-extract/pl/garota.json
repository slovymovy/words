                "senses": [
                    {
                        "sense_id": "fbf833f8-7763-3e5d-8be9-dfecb8b03c69",
                        "entry_id": "a4e023f0-c599-380e-a6fa-34b40402584f",
                        "glosses": [
                            "broń mająca postać cienkiego paska materiału lub linki do uchwycenia oburącz i zaciśnięcia na szyi ofiary"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf07ce53-c8b1-41f7-8328-b5d9c9eea1a0",
                                "sense_id": "fbf833f8-7763-3e5d-8be9-dfecb8b03c69",
                                "text": "Garota jest bronią wykorzystywaną do szybkiego duszenia ofiar."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ca397d76-a767-3f48-b928-ff51223e4b2f",
                        "entry_id": "a4e023f0-c599-380e-a6fa-34b40402584f",
                        "glosses": [
                            "urządzenie do wykonywania kary śmierci w Hiszpanii i Portugalii w XIX i XX wieku"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb24d919-34d7-49f3-8d1f-4f328c9c533f",
                        "source_entry_id": "a4e023f0-c599-380e-a6fa-34b40402584f",
                        "source_sense_id": "fbf833f8-7763-3e5d-8be9-dfecb8b03c69",
                        "target_lang_word": "garrote",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garrote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ab687a0-e7ef-3504-8708-9205157e581e",
                                        "entry_id": "f30cb59d-c8c2-33ed-b1ae-e9b556a9e346",
                                        "glosses": [
                                            "An iron collar formerly used in Spain to execute people by strangulation."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f501a783-220c-432c-a95a-6a01c07fedcc",
                                                "sense_id": "5ab687a0-e7ef-3504-8708-9205157e581e",
                                                "text": "[…] promising that, by so doing, the painful death to which he had been sentenced should be commuted for the milder form of the garrote,—a mode of punishment by strangulation, used for criminals in Spain."
                                            },
                                            {
                                                "example_id": "feafa006-f559-42f7-b082-d183fa83acee",
                                                "sense_id": "5ab687a0-e7ef-3504-8708-9205157e581e",
                                                "text": "The prison, scaffold, garrote, handcuffs, iron necklace and leadballs do their work, / The named and unnamed heroes pass to other spheres,"
                                            },
                                            {
                                                "example_id": "a72b0f5f-32c2-4315-90ea-a970e4bc915e",
                                                "sense_id": "5ab687a0-e7ef-3504-8708-9205157e581e",
                                                "text": "The Spanish had responded to the insurgency with characteristic brutality. They gave rebels the \"usual four shots in the back\" or the garrote—an iron collar tightened around the victim's neck with a screw until he was strangled to death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7af4c06f-bfaa-3a06-804a-b150655bcb5f",
                                        "entry_id": "f30cb59d-c8c2-33ed-b1ae-e9b556a9e346",
                                        "glosses": [
                                            "Something, especially a cord or wire, used for strangulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef9a4f83-348f-46c0-b915-0045763ed03f",
                                                "sense_id": "7af4c06f-bfaa-3a06-804a-b150655bcb5f",
                                                "text": "The mob boss was known for having his enemies executed with a garrote of piano wire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "garrote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7934a950-f4cb-30e3-8810-8b54a4386bbd",
                                        "entry_id": "3e8ce948-79bc-33ec-a3e3-d584859cf664",
                                        "glosses": [
                                            "To execute by strangulation, to kill using a garrote."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9d27a34-f59f-3688-9eaa-3a9191a4b92b",
                                        "entry_id": "3e8ce948-79bc-33ec-a3e3-d584859cf664",
                                        "glosses": [
                                            "To suddenly render insensible by semi-strangulation, and then to rob."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a601ddf8-34cc-4786-aab8-371410b8c4c9",
                                                "sense_id": "c9d27a34-f59f-3688-9eaa-3a9191a4b92b",
                                                "text": "“And then Lee may have fallen into the river, and Norton been garrotted. It is certainly a formidable indictment that you have against Bellingham; but if you were to place it before a police magistrate, he would simply laugh in your face.”"
                                            },
                                            {
                                                "example_id": "8069042e-6940-4658-884b-bb8d1ffdfebd",
                                                "sense_id": "c9d27a34-f59f-3688-9eaa-3a9191a4b92b",
                                                "text": "About this time the police reports were full of cases of garrotting. The victim was seized from behind, one man gagged or burked him, while another picked his pocket."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
