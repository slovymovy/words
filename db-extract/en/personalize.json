                ],
                "senses": [
                    {
                        "sense_id": "2a390750-ece1-31fc-9d0e-ccc13504453e",
                        "entry_id": "d1ca02ee-ef89-3505-9560-deef139b39ff",
                        "glosses": [
                            "To adapt something to the needs or tastes of an individual."
                        ],
                        "tags": [
                            "British",
                            "English",
                            "Oxford",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "747d89e0-bf6b-49b7-bbea-164ebe884768",
                                "sense_id": "2a390750-ece1-31fc-9d0e-ccc13504453e",
                                "text": "These \"Eternal Ones of the Dream\" are not to be confused with the personally modified symbolic figures that appear in nightmare and madness to the still tormented individual. Dream is the personalized myth, myth the depersonalized dream; both myth and dream are symbolic in the same general way of the dynamics of the psyche."
                            },
                            {
                                "example_id": "a2ad7513-5a24-4ebe-9e4c-183047f4e339",
                                "sense_id": "2a390750-ece1-31fc-9d0e-ccc13504453e",
                                "text": "“Over the past month, the Department has held three separate meetings with the ACLU to receive feedback and engage the organization in the solutions,” the department said in a statement. “As a result of the meetings, the Department agrees that publishing FIO statistics going forward is necessary, and the Department is working toward personalizing interactions between officers and citizens.”"
                            },
                            {
                                "example_id": "ad9d1f17-3359-45ac-b5a1-c6e0625f10e2",
                                "sense_id": "2a390750-ece1-31fc-9d0e-ccc13504453e",
                                "text": "In a draft of their paper, the unnamed researchers describe how they not only used AI to generate responses, but attempted to personalize its replies based on information gleaned from the original poster’s prior Reddit history."
                            }
                        ]
                    },
                    {
                        "sense_id": "8806ae0b-55ed-3946-934a-8d7667d3b9d9",
                        "entry_id": "d1ca02ee-ef89-3505-9560-deef139b39ff",
                        "glosses": [
                            "To represent something abstract as a person; to embody."
                        ],
                        "tags": [
                            "British",
                            "English",
                            "Oxford",
                            "US"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "70348a9c-07b2-315d-b413-bd8c20aa8af7",
                        "entry_id": "d1ca02ee-ef89-3505-9560-deef139b39ff",
                        "glosses": [
                            "To imbue something with one's personality."
                        ],
                        "tags": [
                            "British",
                            "English",
                            "Oxford",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "78e3b7cb-d8b6-497e-af9e-4274da7ce14e",
                                "sense_id": "70348a9c-07b2-315d-b413-bd8c20aa8af7",
                                "text": "Gloria Hull, best known as a Black Feminist literary critic, expands and personalizes her examination of creative thought in her first collection of poetry, Healing Heart."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6df49614-c61e-4c77-8cd0-763896052284",
                        "source_entry_id": "d1ca02ee-ef89-3505-9560-deef139b39ff",
                        "source_sense_description": "to adapt to an individual",
                        "target_lang_word": "personnaliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "personnaliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "060afbfd-7c5d-39b2-af75-dfc693ad449d",
                                        "entry_id": "cafbf532-6f39-3a8f-9d36-0353907a70ba",
                                        "glosses": [
                                            "Adapter pour donner un caractère personnel à un objet ou une création."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "723b0392-2474-49e1-b556-c6dbe7f7fed4",
                                                "sense_id": "060afbfd-7c5d-39b2-af75-dfc693ad449d",
                                                "text": "Il est conseillé de personnaliser votre messagerie par une annonce d’accueil qui vous est propre et de la protéger par un code d'accès."
                                            },
                                            {
                                                "example_id": "a6fe57e6-6c4d-44ae-9ced-d86088e751a3",
                                                "sense_id": "060afbfd-7c5d-39b2-af75-dfc693ad449d",
                                                "text": "Celui-ci s'est alors tourné vers la Cour de justice européenne afin de savoir si la collecte des données de civilité des clients, limitée aux mentions \"Monsieur\" et \"Madame\", peut se voir qualifiée de licite et conforme, notamment, au principe de minimisation des données, \"lorsque cette collecte vise à permettre une communication commerciale personnalisée à l’égard de ces clients, conformément aux usages couramment admis en la matière\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99232224-67e3-3dbc-9bfe-9e1c2c2c2464",
                                        "entry_id": "cafbf532-6f39-3a8f-9d36-0353907a70ba",
                                        "glosses": [
                                            "Adapter des produits à la demande exprimée par chaque client pour les rendre plus conformes aux goûts de celui-ci."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4617923b-2691-42b5-ac0a-d37c89fc98be",
                                                "sense_id": "99232224-67e3-3dbc-9bfe-9e1c2c2c2464",
                                                "text": "Il est également possible de personnaliser le lapinou avec ses propres musiques, histoires ou comptines, depuis un ordinateur, en le branchant en USB et en effectuant des copier/déposer de fichiers audio."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "676b8e93-00ef-3dc3-b376-87cee9564ba7",
                                        "entry_id": "cafbf532-6f39-3a8f-9d36-0353907a70ba",
                                        "glosses": [
                                            "Prêter des sens, une existence personnelle à une abstraction pure, ou à un être inanimé."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "450be23a-a502-4029-977e-87b03102de2c",
                                                "sense_id": "676b8e93-00ef-3dc3-b376-87cee9564ba7",
                                                "text": "Personnaliser la justice, la prudence."
                                            },
                                            {
                                                "example_id": "62c87e7f-2597-4705-ad6c-b49bfd645298",
                                                "sense_id": "676b8e93-00ef-3dc3-b376-87cee9564ba7",
                                                "text": "Personnaliser le vice, la vertu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b79ac6c-71ca-31cc-b91f-26731c92c5d9",
                                        "entry_id": "cafbf532-6f39-3a8f-9d36-0353907a70ba",
                                        "glosses": [
                                            "Dire des personnalités, lancer des traits piquants, injurieux et personnels contre quelqu’un."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aa28d20-bb44-468d-9390-004416f56195",
                                                "sense_id": "5b79ac6c-71ca-31cc-b91f-26731c92c5d9",
                                                "text": "[…] ; exposons aux regards du peuple, non pas leurs portraits , […], mais leurs horribles faits et gestes.\nIls finiront par en rougir; ils finiront par nous savoir gré de leur épargner l'innocente représaille de les personnaliser, de les montrer aux regards des passans dans leur hideuse nudité , […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0badbf6-2381-3032-b5d3-0dcdcbc7f3d8",
                                        "entry_id": "cafbf532-6f39-3a8f-9d36-0353907a70ba",
                                        "glosses": [
                                            "Rapporter tout à soi, à sa personne."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f99645ae-7574-42fd-9c5d-667724c7c810",
                        "source_entry_id": "d1ca02ee-ef89-3505-9560-deef139b39ff",
