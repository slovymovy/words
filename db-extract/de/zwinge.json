                                                "example_id": "e0bdbb90-7b87-4097-bde8-bbdd18937d91",
                                                "sense_id": "c77025fa-bb26-33ec-a5a1-fa933f8de75f",
                                                "text": "I was only parked there for five minutes but my car was still clamped."
                                            }
