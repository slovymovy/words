                "forms": [],
                "senses": [
                    {
                        "sense_id": "d23e5692-ec74-35df-beae-2333b9c65d89",
                        "entry_id": "dbc80c86-cd3c-3e39-a718-7791d8f7249d",
                        "glosses": [
                            "wzniecić myśl lub uczucie i pobudzić kogoś do działania"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "742555e5-1e6c-4de3-894f-3df94880b8ac",
                                "sense_id": "d23e5692-ec74-35df-beae-2333b9c65d89",
                                "text": "Widok gór natchnął poetę do napisania wiersza."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "12d925a9-69b0-30f0-ae05-4eb9e576cd68",
                        "entry_id": "dbc80c86-cd3c-3e39-a718-7791d8f7249d",
                        "glosses": [
                            "wtłoczyć powietrze; napełnić tchem"
                        ],
