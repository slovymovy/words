{
    "word_family": [
        "gymnasium",
        "gymnast",
        "gymnastic",
        "gymnastics"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87dce29f-7569-301b-9c5a-5777c0be8842",
                    "sense_definition": "A sports facility specialized for lifting weights, cardio machines, and other exercise.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "exercise_facility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been hitting the <w>gym</w> a lot lately to prepare for the marathon.",
                            "target_lang_translations": {
                                "ru": "В последнее время он часто <w>ходит в зал</w>, чтобы подготовиться к марафону.",
                                "zh": "他最近经常去<w>健身房</w>，为马拉松比赛做准备。"
                            }
                        },
                        {
                            "text": "I have a membership at a commercial <w>gym</w> and also a small home <w>gym</w> in my garage.",
                            "target_lang_translations": {
                                "ru": "У меня есть абонемент в коммерческий <w>фитнес-клуб</w>, а также небольшой домашний <w>спортзал</w> в гараже.",
                                "zh": "我有一张商业<w>健身房</w>的会员卡，车库里还有一个小型的家庭<w>健身房</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fitness center"
                    ],
                    "common_phrases": [
                        "hit the gym",
                        "commercial gym",
                        "home gym",
                        "gym membership"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спортивное сооружение, предназначенное для поднятия тяжестей, занятий на кардиотренажерах и других упражнений.",
                        "zh": "专门用于举重、有氧运动器械和其他锻炼的体育设施。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тренажёрный зал",
                                "target_lang_sense_clarification": "наиболее точный термин для места с тренажерами"
                            },
                            {
                                "target_lang_word": "спортзал",
                                "target_lang_sense_clarification": "общее название для места занятий спортом"
                            },
                            {
                                "target_lang_word": "качалка",
                                "target_lang_sense_clarification": "разговорное название тренажёрного зала"
                            },
                            {
                                "target_lang_word": "фитнес-клуб",
                                "target_lang_sense_clarification": "коммерческое заведение для фитнеса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "健身房",
                                "target_lang_sense_clarification": "最常用的词，指配备健身器材的场所"
                            },
                            {
                                "target_lang_word": "健身中心",
                                "target_lang_sense_clarification": "通常指规模较大、设施齐全的商业健身场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "322238eb-f622-33eb-ad35-d264f132d2af",
                    "sense_definition": "A large room or hall, especially in a school, used for indoor sports and physical activities; a clipping of <w>gymnasium</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "exercise_facility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was pouring rain, so the kids played kickball in the <w>gym</w> instead of on the field.",
                            "target_lang_translations": {
                                "ru": "Шел проливной дождь, поэтому дети играли в кикбол в <w>спортзале</w>, а не на поле.",
                                "zh": "外面下着大雨，所以孩子们在<w>体育馆</w>里踢球，而不是在操场上。"
                            }
                        },
                        {
                            "text": "The school <w>gym</w> is used for basketball games and graduation ceremonies.",
                            "target_lang_translations": {
                                "ru": "Школьный <w>спортзал</w> используется для баскетбольных матчей и выпускных церемоний.",
                                "zh": "学校的<w>体育馆</w>用于举办篮球赛和毕业典礼。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "school gym"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое помещение или зал, особенно в школе, используемый для занятий спортом в помещении; сокращение от «gymnasium».",
                        "zh": "一个大型房间或大厅，常见于学校，用于室内体育活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спортзал",
                                "target_lang_sense_clarification": "школьный или универсальный зал"
                            },
                            {
                                "target_lang_word": "спортивный зал",
                                "target_lang_sense_clarification": "полное официальное название"
                            },
                            {
                                "target_lang_word": "гимнастический зал",
                                "target_lang_sense_clarification": "зал для гимнастики и упражнений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "体育馆",
                                "target_lang_sense_clarification": "指室内大型运动场地"
                            },
                            {
                                "target_lang_word": "体育室",
                                "target_lang_sense_clarification": "指学校内较小的室内运动空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e02502a-772e-3496-bf80-3394fd5ee7e5",
                    "sense_definition": "A physical education class (PE class) held in a school.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>gym</w> teacher at our school makes us stretch before and after each class.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>физкультуры</w> в нашей школе заставляет нас делать растяжку до и после каждого занятия.",
                                "zh": "我们学校上<w>体育课</w>时，老师要求我们课前课后都做拉伸。"
                            }
                        },
                        {
                            "text": "She has <w>gym</w> class on Tuesday and Thursday afternoons.",
                            "target_lang_translations": {
                                "ru": "У неё уроки <w>физкультуры</w> по вторникам и четвергам после обеда.",
                                "zh": "她周二和周四下午有<w>体育课</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gym teacher",
                        "gym class"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used by students and teachers"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Урок физической культуры (физкультуры) в школе.",
                        "zh": "学校里的体育课。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "физкультура",
                                "target_lang_sense_clarification": "название школьного предмета"
                            },
                            {
                                "target_lang_word": "физра",
                                "target_lang_sense_clarification": "школьный жаргон"
                            },
                            {
                                "target_lang_word": "урок физкультуры",
                                "target_lang_sense_clarification": "официальное название занятия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "体育课",
                                "target_lang_sense_clarification": "指学校课程表中的体育科目"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8632fb43-47d3-3aa4-bee3-3ebc0393b5c0",
                    "sense_definition": "A clipping of <w>gymnastics</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has been practicing her <w>gym</w> routines all morning for the upcoming competition.",
                            "target_lang_translations": {
                                "ru": "Всё утро она отрабатывала свои <w>гимнастические</w> упражнения перед предстоящими соревнованиями.",
                                "zh": "她整个上午都在为即将到来的比赛练习<w>体操</w>动作。"
                            }
                        },
                        {
                            "text": "The coach said his <w>gym</w> skills have improved significantly this season.",
                            "target_lang_translations": {
                                "ru": "Тренер сказал, что его навыки в <w>гимнастике</w> значительно улучшились в этом сезоне.",
                                "zh": "教练说他这个赛季的<w>体操</w>技巧有了显著提高。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal shortening"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное сокращение от слова «gymnastics» (гимнастика).",
                        "zh": "体操（gymnastics）的口语缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гимнастика",
                                "target_lang_sense_clarification": "вид спорта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "体操",
                                "target_lang_sense_clarification": "指竞技体操运动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9094db1a-1895-349e-873d-ae75e44914c7",
                    "sense_definition": "To go to the gym or engage in physical exercise at a gym.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have tried everything from yoga to dancing to <w>gymming</w>, but I cannot be consistent.",
                            "target_lang_translations": {
                                "ru": "Я перепробовала всё, от йоги и танцев до <w>походов в зал</w>, но не могу заниматься регулярно.",
                                "zh": "我尝试过从瑜伽、跳舞到<w>健身</w>的各种运动，但都无法坚持下来。"
                            }
                        },
                        {
                            "text": "Just like you go <w>gymming</w> for your body, you should exercise your mind as well.",
                            "target_lang_translations": {
                                "ru": "Подобно тому, как вы <w>тренируете</w> своё тело, вам следует тренировать и свой ум.",
                                "zh": "就像你为了身体而<w>健身</w>一样，你也应该锻炼你的大脑。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ходить в спортзал или заниматься физическими упражнениями в тренажерном зале.",
                        "zh": "去健身房或在健身房进行体育锻炼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "качаться",
                                "target_lang_sense_clarification": "разговорное: заниматься силовыми упражнениями"
                            },
                            {
                                "target_lang_word": "ходить в зал",
                                "target_lang_sense_clarification": "общеупотребительное выражение"
                            },
                            {
                                "target_lang_word": "тренироваться",
                                "target_lang_sense_clarification": "заниматься спортом в целом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "健身",
                                "target_lang_sense_clarification": "指进行锻炼活动"
                            },
                            {
                                "target_lang_word": "去健身房",
                                "target_lang_sense_clarification": "指前往健身场所的行为"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}