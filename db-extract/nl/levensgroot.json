                "senses": [
                    {
                        "sense_id": "acef61b2-2fc2-3830-847d-68bf62c8deeb",
                        "entry_id": "05a1816c-5f6c-3c31-829f-7a649737357f",
                        "glosses": [
                            "weerɡeɡeven in de werkelijke grootte, niet met een meer gebruikelijke verkleining"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b89bd20c-b67c-4e4f-bab9-5eb682630e4f",
                                "sense_id": "acef61b2-2fc2-3830-847d-68bf62c8deeb",
                                "text": "Op het plein was een meer dan levensgrote afbeelding van een roos te zien."
                            },
                            {
                                "example_id": "6497674b-0819-4c90-9253-49f4c16e54e4",
                                "sense_id": "acef61b2-2fc2-3830-847d-68bf62c8deeb",
                                "text": "Natuurlijk ging het niet om echte exemplaren, maar levensgrote replica's van meer dan 50 dinosoorten. De namaakdino's brullen wel, en laten hun tanden zien of zwiepen met hun hoofd."
                            }
                        ]
                    },
                    {
                        "sense_id": "32135cd0-df33-3217-8701-2c288a284673",
                        "entry_id": "05a1816c-5f6c-3c31-829f-7a649737357f",
                        "glosses": [
                            "intensief heel erg groot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9062ca46-d4f4-4c12-b647-7df557d91412",
                                "sense_id": "32135cd0-df33-3217-8701-2c288a284673",
                                "text": "De bezorgde man zag weer levensgrote problemen opdoemen."
                            },
                            {
                                "example_id": "843fba17-958d-4cd6-a823-768cbd530f08",
                                "sense_id": "32135cd0-df33-3217-8701-2c288a284673",
                                "text": "Syrische vluchtelingen in Gaziantep wonen vaak in slecht onderhouden, krakkemikkige gebouwen, dicht op elkaar. Het instortingsgevaar is levensgroot."
                            },
                            {
                                "example_id": "d3c27c8a-1f4d-4a67-91fe-c61a6c479023",
                                "sense_id": "32135cd0-df33-3217-8701-2c288a284673",
                                "text": "Om de Rotterdammers een handje te helpen, is een projector naast de vuilnisbakken geplaatst. Die projecteert beelden van een levensgrote rat bij de container. De projectie van het knaagdier wordt afgewisseld met de tekst: \"Voorkom ratten.\""
                            }
                        ]
                    }
