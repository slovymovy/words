                    },
                    {
                        "translation_id": "35934fe3-4a2f-4631-8ac1-aa2645a6d67d",
                        "source_entry_id": "21a08106-e1cf-3c9b-a816-8ec97d7bc99c",
                        "source_sense_description": "Norse merchant ship used by the Vikings",
                        "target_lang_word": "Knorr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knorr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd6db617-00a0-3144-ad2d-222eadd7adb1",
                                        "entry_id": "ebe344c6-91d4-3f29-9662-9d5ec2482dce",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70feccdf-8452-4129-8a00-1da6879a1c3a",
                                                "sense_id": "cd6db617-00a0-3144-ad2d-222eadd7adb1",
                                                "text": "Frau Knorr ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "ac73609c-901b-4c1f-a779-aeeede7c4eb7",
                                                "sense_id": "cd6db617-00a0-3144-ad2d-222eadd7adb1",
                                                "text": "Herr Knorr wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "9bee817b-5e1c-4375-9a0f-6611df0c543b",
                                                "sense_id": "cd6db617-00a0-3144-ad2d-222eadd7adb1",
                                                "text": "Die Knorrs fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "4439b8e7-d8c3-434e-bcfe-2fbe7acf76e6",
                                                "sense_id": "cd6db617-00a0-3144-ad2d-222eadd7adb1",
                                                "text": "Der Knorr trägt nie die Schals, die die Knorr ihm strickt."
                                            },
                                            {
                                                "example_id": "eb8128bc-66cd-45f5-8afa-5db15ea61d55",
                                                "sense_id": "cd6db617-00a0-3144-ad2d-222eadd7adb1",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Knorr kommt, geht der Herr Knorr.“"
                                            },
                                            {
                                                "example_id": "6ad78b05-1ceb-4662-a65a-133636557bbf",
                                                "sense_id": "cd6db617-00a0-3144-ad2d-222eadd7adb1",
                                                "text": "Knorr kommt und geht."
                                            },
                                            {
                                                "example_id": "dfe453bb-ebdf-4cfe-b0b1-ea49422e464e",
                                                "sense_id": "cd6db617-00a0-3144-ad2d-222eadd7adb1",
                                                "text": "Knorrs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
