        "ru-extract.jsonl": [
            {
                "entry_id": "aaa36954-bd84-391d-9da7-3d815e5b7d6b",
                "word": "кажись",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5d552cde-f231-3c01-8361-2c472eac6fa5",
                        "entry_id": "aaa36954-bd84-391d-9da7-3d815e5b7d6b",
                        "glosses": [
                            "прост. как будто, кажется"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eda14595-c9c5-45cb-8b98-3d4f8af8f73e",
                                "sense_id": "5d552cde-f231-3c01-8361-2c472eac6fa5",
                                "text": "Сознание вспыхнет иногда копотно, и не понять ― неужто жив ещё, за что она цепляется, душа, кажись, всё оборвано, а не отлетает, какая-то жилка осталась, держит, дряблая, тонкая, не натягивается, сил нет, но что-то пульсирует в этой жилке еле слышно."
                            },
                            {
                                "example_id": "8e49591c-de91-403a-8eae-9486a073989f",
                                "sense_id": "5d552cde-f231-3c01-8361-2c472eac6fa5",
                                "text": "Да там мотор перегорел, и с тех пор, кажись, не чинили."
                            },
                            {
                                "example_id": "9466799c-3806-4d72-92a8-8e0ff32b8b74",
                                "sense_id": "5d552cde-f231-3c01-8361-2c472eac6fa5",
                                "text": "Спросить бы его, барыня, откуда он… всё бы, кажись, не так опасливо…"
                            }
                        ]
                    }
                ],
