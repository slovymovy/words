                "forms": [
                    {
                        "form_id": "fbfe5104-85fc-473e-8dfb-d503a4ba1220",
                        "entry_id": "c0b5fe2b-d443-38c5-90f2-8c225ae39358",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "folkloriques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd643a65-86db-3ad3-90e2-e1a426a09545",
                        "entry_id": "c0b5fe2b-d443-38c5-90f2-8c225ae39358",
                        "glosses": [
                            "Relatif au folklore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9df03017-7b12-448f-a157-b2f6faa7bc38",
                                "sense_id": "cd643a65-86db-3ad3-90e2-e1a426a09545",
                                "text": "Contrairement à beaucoup d’érudits en chambre, notre confrère profitait de ses inspections communales pour mener ses enquêtes sociologiques ou folkloriques sur le terrain, souvent dans des conditions d’inconfort inimaginables."
                            }
                        ]
                    },
                    {
                        "sense_id": "16516e16-06c3-3fb6-9f16-86cc4dcd961e",
                        "entry_id": "c0b5fe2b-d443-38c5-90f2-8c225ae39358",
                        "glosses": [
                            "Qui tient du folklore ; qui se rattache au folklore d’un pays, d’une région, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b26c8dd-66c6-4f38-9d56-5f7d29ae2bc0",
                                "sense_id": "16516e16-06c3-3fb6-9f16-86cc4dcd961e",
                                "text": "Costumes, traditions folkloriques."
                            }
                        ]
                    },
                    {
                        "sense_id": "1437bc9a-ebe0-3af5-9014-07859d00b0f3",
                        "entry_id": "c0b5fe2b-d443-38c5-90f2-8c225ae39358",
                        "glosses": [
                            "Qui est pittoresque ou original mais dépourvu de sérieux."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "c0b54aa4-93eb-485f-be84-3d6352a116c3",
                                "sense_id": "1437bc9a-ebe0-3af5-9014-07859d00b0f3",
                                "text": "Tout aussi folklorique, les relevés des inclinomètres —appareils servant à mesurer la stabilité d’un ouvrage — ont été falsifiés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b97f64b2-8e2b-43fe-8b6b-b9330e7e26ce",
                        "source_entry_id": "c0b5fe2b-d443-38c5-90f2-8c225ae39358",
                        "target_lang_word": "folkloristisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9ca85d07-0c27-42d1-91c5-ddfc06679ef7",
                        "source_entry_id": "c0b5fe2b-d443-38c5-90f2-8c225ae39358",
                        "target_lang_word": "volkskundlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volkskundlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "379565b7-206d-3115-9612-d9c6a201af57",
                                        "entry_id": "dd437771-d722-3091-a322-a6ddb2daec15",
                                        "glosses": [
                                            "die Volkskunde betreffend, zu ihr gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f7c4684-e658-4e4e-ac31-792a47186339",
                                                "sense_id": "379565b7-206d-3115-9612-d9c6a201af57",
                                                "text": "„Die volkskundliche Sammel- und Forschungstätigkeit entwickelte sich in enger Beziehung zur Germanischen Philologie (Jacob und Wilhelm Grimm), zur Statistik und Landeskunde sowie zur völkerkundlichen und völkerpsychologischen Forschung.“"
                                            },
                                            {
                                                "example_id": "3bd8f718-6972-4bcb-b288-7ae755ee9e43",
                                                "sense_id": "379565b7-206d-3115-9612-d9c6a201af57",
                                                "text": "„1929 wurde mit den Erhebungen zum Atlas der deutschen Volkskunde das bisher umfangreichste volkskundliche Forschungsprojekt begonnen.“"
                                            },
                                            {
                                                "example_id": "0f7cd44a-b28f-4c34-aa21-4d7b418f40ec",
                                                "sense_id": "379565b7-206d-3115-9612-d9c6a201af57",
                                                "text": "„Die volkskundliche Innovations- und Diffusionsforschung wurde erst möglich, als man die große Bedeutung des Individuums auch für die Volkskultur erkannt hatte.“"
                                            },
                                            {
                                                "example_id": "016f76c6-89e6-41a9-827e-986a9dc5a20f",
                                                "sense_id": "379565b7-206d-3115-9612-d9c6a201af57",
                                                "text": "„Die Volkskultur wird von der Volkskunde erforscht und durch den Rücklauf volkskundlicher Forschungsergebnisse und Darstellungen beeinflusst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
