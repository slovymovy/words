{
    "word_family": [
        "idle",
        "idler",
        "idleness",
        "idly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "24eef3f4-0b76-30b5-b1cb-849a459db0d5",
                    "sense_definition": "present participle and gerund of <w>idle</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers were <w>idling</w> by the front gate while waiting for the delivery truck to arrive.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>бездельничали</w> у главных ворот в ожидании прибытия грузовика с доставкой."
                            }
                        },
                        {
                            "text": "His car was <w>idling</w> outside with the air conditioning on full blast.",
                            "target_lang_translations": {
                                "ru": "Его машина <w>работала на холостом ходу</w> на улице с включенным на полную мощность кондиционером."
                            }
                        }
                    ],
                    "common_phrases": [
                        "idling away the time"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола idle: бездельничающий, работающий вхолостую."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бездельничать",
                                "target_lang_sense_clarification": "проводить время в праздности"
                            },
                            {
                                "target_lang_word": "работать на холостом ходу",
                                "target_lang_sense_clarification": "о двигателе или механизме"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cd4504d0-79d0-372a-9c7f-eb6d5c359908",
                    "sense_definition": "The operation of an engine while out of gear and disconnected from load.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "City regulations prohibit vehicle <w>idling</w> near school zones to reduce harmful exhaust fumes.",
                            "target_lang_translations": {
                                "ru": "Городские правила запрещают <w>работу на холостом ходу</w> автомобилей вблизи школьных зон для снижения вредных выхлопов."
                            }
                        },
                        {
                            "text": "Excessive <w>idling</w> wastes fuel and causes unnecessary engine wear.",
                            "target_lang_translations": {
                                "ru": "Чрезмерная <w>работа двигателя на холостом ходу</w> приводит к перерасходу топлива и ненужному износу двигателя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "engine idling",
                        "vehicle idling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Работа двигателя на холостом ходу без нагрузки и включенной передачи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холостой ход",
                                "target_lang_sense_clarification": "режим работы двигателя"
                            },
                            {
                                "target_lang_word": "работа на холостом ходу",
                                "target_lang_sense_clarification": "функционирование двигателя без движения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23eaf70f-34cc-3d80-b7d3-b0877ee7d04a",
                    "sense_definition": "A period spent without working or engaging in meaningful activity.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent months in unproductive <w>idling</w> instead of looking for a steady job.",
                            "target_lang_translations": {
                                "ru": "Он провел месяцы в бесплодном <w>безделье</w> вместо того, чтобы искать постоянную работу."
                            }
                        },
                        {
                            "text": "Such continuous <w>idling</w> was frowned upon by his hardworking parents.",
                            "target_lang_translations": {
                                "ru": "Такую постоянную <w>праздность</w> не одобряли его трудолюбивые родители."
                            }
                        }
                    ],
                    "synonyms": [
                        "inactivity",
                        "loitering",
                        "sloth"
                    ],
                    "antonyms": [
                        "labor",
                        "toil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период времени, проведенный в безделье или без полезной деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безделье",
                                "target_lang_sense_clarification": "состояние праздности и отсутствия работы"
                            },
                            {
                                "target_lang_word": "праздность",
                                "target_lang_sense_clarification": "времяпрепровождение без полезных занятий"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}