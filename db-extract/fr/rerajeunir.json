                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19a74b49-9423-42d1-91a2-9455a18734a8",
                                "sense_id": "31ae506b-6df0-3afb-a119-c5e33745aee3",
                                "text": "Vous saurez, noble Dame, continua la Rat-musqué, que le Roi mon Maître a de l'essence de vesse-de-loup qui rerajeunit, quand on a été rajeuni déja, en en mettant une goutte dans un verre d'ouron, dont j'apporte quelques jarres à votre excellence ; — (sic)"
                            },
                            {
                                "example_id": "4a237e2d-247c-4f14-94f1-d76812b6ca8d",
                                "sense_id": "31ae506b-6df0-3afb-a119-c5e33745aee3",
                                "text": "La revanche des Siths m'a vieilli, heureusement qu'il ya des forums comme ça pour rerajeunir!"
                            }
                        ]
                    }
