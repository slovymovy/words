                    {
                        "translation_id": "617c6f57-ed2a-4122-a056-d41a20c1d5e7",
                        "source_entry_id": "e6e56a0f-ee79-33dd-8759-7ab7c993c4c6",
                        "target_lang_word": "рефрен",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "рефрен",
