                            },
                            {
                                "target_word": "faste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bbbd32d-873e-3f57-8f9b-4e4cbedab3a2",
                                        "entry_id": "4bff8400-8092-3f47-aac3-f41722db91a6",
                                        "glosses": [
                                            "Magnificence qui se déploie et s’étale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e30c357f-6800-4cf4-afa6-8fac3bb628b7",
                                                "sense_id": "2bbbd32d-873e-3f57-8f9b-4e4cbedab3a2",
                                                "text": "L'idée de déployer tous les fastes de la République et d'afficher une solennité churchillienne pour annoncer une augmentation de 1,6 point de la TVA ne peut venir que de cerveaux hallucinés."
                                            },
                                            {
                                                "example_id": "f32fe3bf-3a8f-4ea7-b84d-de415d69929c",
                                                "sense_id": "2bbbd32d-873e-3f57-8f9b-4e4cbedab3a2",
                                                "text": "Benadad était un roi timide et vain qui n'avait que du faste et de l’orgueil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b11ac44-7f99-339a-8130-18d8d00a75be",
                                        "entry_id": "4bff8400-8092-3f47-aac3-f41722db91a6",
                                        "glosses": [
                                            "Affectation de paraître avec luxe et éclat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "651a536e-48c7-425d-86f5-0828bd915bfe",
                                                "sense_id": "7b11ac44-7f99-339a-8130-18d8d00a75be",
                                                "text": "J'ai remarqué l’horreur que ce peuple a montrée Lorsque avec tant de faste il a vu ses faisceaux [de César] Marcher arrogamment et braver nos drapeaux."
                                            },
                                            {
                                                "example_id": "d3a613b8-ac64-4311-bc8b-5465f03ffe0b",
                                                "sense_id": "7b11ac44-7f99-339a-8130-18d8d00a75be",
                                                "text": "La Rappinière reçut son compliment avec un faste de prévôt provincial, et ne lui rendit pas la dixième partie des civilités qu’il en reçut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68f1a506-2e6e-3c75-8159-b017f400e615",
                                        "entry_id": "4bff8400-8092-3f47-aac3-f41722db91a6",
                                        "glosses": [
                                            "Étalage, ostentation dans les actes ou dans les paroles."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f43a46d4-0e52-41db-b9f8-7fc8c3c46592",
                                                "sense_id": "68f1a506-2e6e-3c75-8159-b017f400e615",
                                                "text": "Azora se répandit en des invectives si longues, éclata en reproches si violents contre la jeune veuve, que ce faste de vertu ne plut pas à Zadig."
                                            },
                                            {
                                                "example_id": "c01f8e0d-9032-424b-be96-967714655fc5",
                                                "sense_id": "68f1a506-2e6e-3c75-8159-b017f400e615",
                                                "text": "Mademoiselle de Villenoix a sans doute détruit les véritables lettres qui lui furent adressées, fastes éloquents du délire qu’elle causa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
