                ],
                "senses": [
                    {
                        "sense_id": "b41b9aa5-215a-37e8-8edd-f3231ee734df",
                        "entry_id": "3f1be38c-f37b-3f05-a5d6-54c334e6b716",
                        "glosses": [
                            "The lowest stratum of the proletariat, whose mental and physical health, mores and morale have deteriorated, through exploitation by the bourgeoisie, to a degree where they cannot build class consciousness and hence cannot be mobilized for the revolution."
                        ],
                        "tags": [
                            "Marxism"
                        ],
                        "examples": [
                            {
                                "example_id": "5c327114-2052-40d8-9ec1-8b229b9910b7",
                                "sense_id": "b41b9aa5-215a-37e8-8edd-f3231ee734df",
                                "text": "I hadn't quite figured her out yet: rude snob or lumpenproletariat?"
                            }
                        ]
                    },
                    {
                        "sense_id": "02111656-847e-3cbc-840c-a59c4a48b388",
                        "entry_id": "3f1be38c-f37b-3f05-a5d6-54c334e6b716",
                        "glosses": [
                            "A social underclass; the riffraff."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
