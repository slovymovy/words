    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5ccd5e4e-5745-3515-a267-ca20cbf46ff0",
                    "sense_definition": "Qui tremble légèrement sous l'effet d'une émotion vive, d'une sensation ou d'un mouvement léger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tremblement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a remercié ses amis d'une voix <w>frémissante</w> d'émotion à la fin de la cérémonie."
                        },
                        {
                            "text": "Marguerite prit la lettre délicate de sa main <w>frémissante</w> sans oser la regarder."
                        }
                    ],
                    "synonyms": [
                        "tremblant",
                        "vibrant"
                    ],
                    "antonyms": [
                        "calme",
                        "impassible"
                    ],
                    "common_phrases": [
                        "voix frémissante",
                        "main frémissante",
                        "feuillage frémissant"
                    ]
                },
                {
                    "sense_id": "39bcfa8d-799f-32fe-bd33-e78408c621ea",
                    "sense_definition": "Qualifie un liquide chaud qui commence tout juste à bouillir en produisant de petites bulles.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ebullition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Versez l'eau <w>frémissante</w> sur les feuilles de thé vert pour préserver tous les arômes."
                        },
                        {
                            "text": "Le cuisinier surveillait le bouillon <w>frémissant</w> pour y plonger les légumes délicats."
                        }
                    ],
                    "common_phrases": [
                        "eau frémissante"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f894f30-0ec0-35fc-9060-9dfe595bb17d",
                    "sense_definition": "Participe présent de <w>frémir</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>frémissant</w> sous la brise fraîche, les arbres du jardin semblaient murmurer un secret."
                        },
                        {
                            "text": "L'orateur continuait à parler tout en <w>frémissant</w> d'indignation devant l'assemblée."
                        }
                    ]
                }
            ]
        }
