                                "target_senses": [
                                    {
                                        "sense_id": "3d510337-c0df-3ee5-8688-2b58aff0048a",
                                        "entry_id": "4e49632a-3267-35c7-8258-4a30b76d9006",
                                        "glosses": [
                                            "An item of clothing for people (especially babies) tied around their neck to protect their clothes from getting dirty when eating."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81d1d4c7-9d7a-3f04-b926-96787ba640cf",
                                        "entry_id": "4e49632a-3267-35c7-8258-4a30b76d9006",
                                        "glosses": [
                                            "Similar items of clothing such as the Chinese dudou and Vietnamese yem."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19fd0f55-8594-38c2-8cec-a78a41d45321",
                                        "entry_id": "4e49632a-3267-35c7-8258-4a30b76d9006",
                                        "glosses": [
                                            "A rectangular piece of material, carrying a bib number, worn as identification by competitors."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eaeddc81-5555-3665-a6ad-3d2b9ca79356",
                                        "entry_id": "4e49632a-3267-35c7-8258-4a30b76d9006",
                                        "glosses": [
                                            "A colourful polyester or plastic vest worn over one's clothes, usually to mark one's team during group activities."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "429a869a-6336-307d-87cb-9231d8820b15",
                                        "entry_id": "4e49632a-3267-35c7-8258-4a30b76d9006",
                                        "glosses": [
                                            "The upper part of an apron or overalls."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f34d765b-7475-3ac1-886f-30452ea33ae8",
                                        "entry_id": "4e49632a-3267-35c7-8258-4a30b76d9006",
                                        "glosses": [
                                            "Ellipsis of bib short."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbeb2316-f29c-38ee-b961-d43929033261",
                                        "entry_id": "4e49632a-3267-35c7-8258-4a30b76d9006",
                                        "glosses": [
                                            "A patch of colour around an animal's upper breast and throat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c94f3568-8525-437c-868c-a92094c50146",
                                                "sense_id": "fbeb2316-f29c-38ee-b961-d43929033261",
                                                "text": "In summer the whole throat and breast are black, but in winter plumage the throat is white bounded by a horseshoe-shaped black bib."
                                            },
                                            {
                                                "example_id": "f8025f83-312a-4e22-8b53-646aa44b62f6",
                                                "sense_id": "fbeb2316-f29c-38ee-b961-d43929033261",
                                                "text": "He don't look anything like the captain. This here cat has got a nice thick black coat of fur with a nice white bib and white feet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0ada725-787f-3eba-96d1-4691bee09705",
                                        "entry_id": "4e49632a-3267-35c7-8258-4a30b76d9006",
                                        "glosses": [
                                            "A north Atlantic fish (Trisopterus luscus), allied to the cod."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b0b4bb4-a3ac-35d9-94ba-25974e965f75",
                                        "entry_id": "4e49632a-3267-35c7-8258-4a30b76d9006",
                                        "glosses": [
                                            "A bibb (bibcock)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bib",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e6e5635-fc33-3e36-bad7-562d6014e936",
                                        "entry_id": "7bef1040-d86a-38bd-b253-219684bba1b2",
                                        "glosses": [
                                            "To dress (somebody) in a bib."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc33ad6a-d78f-4a08-8cfe-fdd8053ffe08",
                                                "sense_id": "7e6e5635-fc33-3e36-bad7-562d6014e936",
                                                "text": "Wise women use them, but new fathers seldom seem to understand that one minute bibbing baby saves who knows how long swabbing, finding clean clothes, changing, and coddling later — not to mention laundry time."
                                            },
                                            {
                                                "example_id": "1d1ab247-931f-4c5e-b0cd-d00bc13fdadc",
                                                "sense_id": "7e6e5635-fc33-3e36-bad7-562d6014e936",
                                                "text": "Mel got Daniel into his chair and bibbed him up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a5afd2c-38a5-31a3-b771-8c5b6906c4ff",
                                        "entry_id": "7bef1040-d86a-38bd-b253-219684bba1b2",
                                        "glosses": [
                                            "To drink heartily; to tipple."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7381ed9-2e57-4970-897d-59e694b561e5",
                                                "sense_id": "5a5afd2c-38a5-31a3-b771-8c5b6906c4ff",
                                                "text": "Iff I were a fleſhly felowe, and a preacher of lyes and tolde them that they might ſyt bebbinge and bollynge, and be droncken: O that were a prophet for this people."
                                            },
                                            {
                                                "example_id": "42889fac-4979-46f6-900f-43f074937837",
                                                "sense_id": "5a5afd2c-38a5-31a3-b771-8c5b6906c4ff",
                                                "text": "they gave him drink as often as he cry'd; so that he was constantly bibbing"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bib",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5ce063b-8245-39e5-b36c-3af77414b934",
                                        "entry_id": "2eb4335e-52ba-3c8c-9097-ddf426fc634e",
                                        "glosses": [
                                            "To beep (e.g. a car horn)."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "783c96d1-cf74-40ab-aad9-8d8ec6871293",
                        "source_entry_id": "96ac7b49-883d-3b6c-b6aa-1a9a97495e6b",
                        "source_sense_id": "39dff33d-a3a7-3a97-9820-f642add8228f",
                        "target_lang_word": "Latz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Latz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b07d4de-5e11-3529-837b-e8a3b58c7c7c",
                                        "entry_id": "43c7237c-b21a-31a4-87d0-06dfa23a7c31",
                                        "glosses": [
                                            "Brustteil eines Bekleidungsstückes, oft zwei Träger und ein verbindendes Mittelstück als oberes Teil einer Hose oder eines Rocks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd85d099-549d-4810-96e8-10ff6be5cb5e",
                                                "sense_id": "0b07d4de-5e11-3529-837b-e8a3b58c7c7c",
                                                "text": "Soll ich Dir einen Latz annähen?"
                                            },
                                            {
                                                "example_id": "1add4504-cd8a-46f2-a74d-3c7ad7b7c85b",
                                                "sense_id": "0b07d4de-5e11-3529-837b-e8a3b58c7c7c",
                                                "text": "Auf dem Latz prangte ein kleines Amulett aus Hirschgeweih."
                                            },
                                            {
                                                "example_id": "1362ff80-11f9-4199-8b9a-910965d5109d",
                                                "sense_id": "0b07d4de-5e11-3529-837b-e8a3b58c7c7c",
                                                "text": "Und dann hat er Schluss gemacht und mir das einfach so vor den Latz geknallt, ohne jede Vorwarnung, verstehst du das?"
                                            },
                                            {
                                                "example_id": "d6856959-b95c-4f49-ae0b-7894f2bf571e",
                                                "sense_id": "0b07d4de-5e11-3529-837b-e8a3b58c7c7c",
                                                "text": "„Er zog am Latz seines Overalls, bog den Kopf zurück und spähte auf die Innenseite.“"
                                            },
                                            {
                                                "example_id": "4bad9405-6fa3-4c28-b509-599fb7072fde",
                                                "sense_id": "0b07d4de-5e11-3529-837b-e8a3b58c7c7c",
                                                "text": "„Außerdem ist nicht sicher, ob du die Antwort wirklich vor den Latz geknallt bekommen möchtest, das ist nicht immer wünschenswert; manche Antworten führen zu nichts als weiteren Fragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e59ff0f0-b67b-3742-8153-8cbbb5a481e4",
                                        "entry_id": "43c7237c-b21a-31a4-87d0-06dfa23a7c31",
                                        "glosses": [
                                            "Teil einer Hose, der sich öffnen lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "808e4831-4f37-4ce0-9580-0aed39421c86",
                                                "sense_id": "e59ff0f0-b67b-3742-8153-8cbbb5a481e4",
                                                "text": "Nu mach mal den Latz zu, so kannst du doch nicht herumlaufen."
                                            },
                                            {
                                                "example_id": "039a09c8-d809-464a-b944-5af5e20b8b14",
                                                "sense_id": "e59ff0f0-b67b-3742-8153-8cbbb5a481e4",
                                                "text": "„Adrienne zog mich aufs Parkett, mein Latz stand weit offen.“"
                                            },
                                            {
                                                "example_id": "f4f9dd28-0f9f-4491-afd0-41f37ff3f355",
                                                "sense_id": "e59ff0f0-b67b-3742-8153-8cbbb5a481e4",
                                                "text": "„Eine Hose mit großem Latz, die unten auf den Kastorschuhen Falten warf, schmiegte sich prall an seinen Bauch und bauschte sein Hemd am Gürtel; und sein blondes Haar, das sich von selbst in leichten Wellen kräuselte, verlieh ihm etwas Kindliches.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
