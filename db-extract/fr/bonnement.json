                "senses": [
                    {
                        "sense_id": "e92973a1-afd7-329e-a7dd-23c90b849b99",
                        "entry_id": "3c7db79c-b689-38ed-add9-f3a7287e41e8",
                        "glosses": [
                            "De bonne foi ; naïvement ; avec simplicité."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "84741751-3838-4845-8a07-38ad62215748",
                                "sense_id": "e92973a1-afd7-329e-a7dd-23c90b849b99",
                                "text": "Et tandis que le Roi Pausole demandait bonnement au fermier ses prévisions sur la récolte et les cours du marché au grain, […]"
                            },
                            {
                                "example_id": "844c91dd-168c-40b5-833f-f030b0541547",
                                "sense_id": "e92973a1-afd7-329e-a7dd-23c90b849b99",
                                "text": "Entre le père et le fils, je m’interpose bonnement, par désir de silence et de calme plutôt que dans l’espoir d’arranger les choses, et mon bizarre beau-fils semble m’en savoir gré parfois."
                            },
                            {
                                "example_id": "623d6708-c5c0-4f29-8ff1-ddd8b99d3fc2",
                                "sense_id": "e92973a1-afd7-329e-a7dd-23c90b849b99",
                                "text": "Contente d’avoir trouvé quelqu’un pour l’écouter jusqu’au bout, elle dévisagea bonnement Francine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2fc5b88-4c1b-4756-b71b-93d27485d520",
                        "source_entry_id": "3c7db79c-b689-38ed-add9-f3a7287e41e8",
