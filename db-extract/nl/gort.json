                                "sense_id": "6f2d695b-27b2-3c25-bb76-3363bd602f23",
                                "text": "De gort werd klaargemaakt met stukjes spek."
                            }
                        ]
                    },
                    {
                        "sense_id": "60e68775-e502-3c36-8be7-9b543e0f4ca7",
