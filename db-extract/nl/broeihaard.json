                    {
                        "sense_id": "62219dda-a292-37d5-a7d0-0e9ea0a64402",
                        "entry_id": "8488f9ba-fb2d-3910-b7e7-6e0be9a636dd",
                        "glosses": [
                            "plaats waar veel opstandige mensen zijn verzameld en waar dus een rel kan ontstaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6095bfb-bfa9-4884-ab61-8fb845683c63",
                                "sense_id": "62219dda-a292-37d5-a7d0-0e9ea0a64402",
                                "text": "Nice, de stad die gisteren het decor werd van een dodelijke terroristische aanslag, staat in Frankrijk al enkele jaren bekend als een broeihaard voor radicalisering. Dat zegt Sébastien Pietrasanta, een medewerker van de parlementaire onderzoekscommissie naar de aanslag in Nice begin vorig jaar, tegen De Morgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3123040-d6a1-3879-9f08-33c573e06c32",
                        "entry_id": "8488f9ba-fb2d-3910-b7e7-6e0be9a636dd",
                        "glosses": [
                            "warme vochtige plaats waar bacteriën kunnen groeien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "022c5d15-5294-443d-83c9-0b5139ad3886",
                                "sense_id": "d3123040-d6a1-3879-9f08-33c573e06c32",
                                "text": "Manager Peter Baratt van Initial: „Veel werknemers eten tegenwoordig achter hun bureau. Daardoor zijn muizen en toetsenborden een broeihaard voor bacteriën en andere organismen.”"
                            },
                            {
                                "example_id": "bcd4aec5-6343-4aff-8638-5800e0342acb",
                                "sense_id": "d3123040-d6a1-3879-9f08-33c573e06c32",
                                "text": "Goede hotelhygiëne begint al voordat je de kamer binnenstapt. Open, als het mogelijk is, de deur met je ellebogen als dat mogelijk is, want deurklinken zijn vaak broeihaarden van bacteriën."
                            }
                        ]
                    }
