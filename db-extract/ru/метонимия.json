                                        "glosses": [
                                            "een beeldspraak waarbij men een woord B zegt in plaats van het woord A terwijl er tussen A en B een vaste relatie (een contiguïteitsrelatie) is"
                                        ],
                                        "tags": [],
                                        "examples": [
