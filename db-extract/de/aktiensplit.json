                "senses": [
                    {
                        "sense_id": "091f1148-f415-3dbd-af07-ab101d452d4b",
                        "entry_id": "b24d1eff-fd08-3eb7-a6f9-991f1ee145ca",
                        "glosses": [
                            "Umwandlung bestehender Aktien einer Aktiengesellschaft in eine größere Anzahl von neuen Aktien mit einem geringeren Nennwert je Aktie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71cb226f-7281-4417-8478-4bab3a094ca2",
                                "sense_id": "091f1148-f415-3dbd-af07-ab101d452d4b",
                                "text": "„Der Kursauftrieb der letzten drei Jahre bei den Aktien der Flughafen Wien AG hat diesen Titel zum mittlerweile mit Abstand schwersten im Börseindex ATX gemacht. Aus dem Grund bereitet die Gesellschaft einen Aktiensplit im Verhältnis 1:4 vor.“"
                            },
                            {
                                "example_id": "7aa042c8-c306-45a9-b007-0ac3f5e4477a",
                                "sense_id": "091f1148-f415-3dbd-af07-ab101d452d4b",
                                "text": "„Unternehmen wollen mit Aktiensplits in der Regel neue Anleger locken.“"
                            },
                            {
                                "example_id": "dbe49895-1692-4ba5-9a38-73a43d6abaff",
                                "sense_id": "091f1148-f415-3dbd-af07-ab101d452d4b",
                                "text": "„Mastercard erfreut seine Aktionäre. Der Finanzdienstleister will seine Dividende kräftig aufstocken und einen Aktiensplit vornehmen, wie er am Dienstagabend mitteilte.“"
                            }
                        ],
