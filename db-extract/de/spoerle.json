                "senses": [
                    {
                        "sense_id": "b3829d4d-2a32-39fb-bfa7-2d62f04ad324",
                        "entry_id": "e148df65-f642-3264-a2a5-648b65a20bf9",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02a6d6dc-b970-4e6a-9e42-dba74059c894",
                                "sense_id": "b3829d4d-2a32-39fb-bfa7-2d62f04ad324",
                                "text": "Frau Spoerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "721d94a1-6a42-4d65-8b02-f1f762aa43e0",
                                "sense_id": "b3829d4d-2a32-39fb-bfa7-2d62f04ad324",
                                "text": "Herr Spoerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d7fca628-8c61-4276-b001-1d8abdc02a19",
                                "sense_id": "b3829d4d-2a32-39fb-bfa7-2d62f04ad324",
                                "text": "Die Spoerles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "884d6ef6-a66a-444b-a7a3-7a53982dc3c2",
                                "sense_id": "b3829d4d-2a32-39fb-bfa7-2d62f04ad324",
                                "text": "Der Spoerle trägt nie die Schals, die die Spoerle ihm strickt."
                            },
                            {
                                "example_id": "94092b5a-ec7b-428e-bcc3-4c6ab6451142",
                                "sense_id": "b3829d4d-2a32-39fb-bfa7-2d62f04ad324",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Spoerle kommt, geht der Herr Spoerle.“"
                            },
                            {
                                "example_id": "970d9361-b2b1-4793-bf1d-54866021d78c",
                                "sense_id": "b3829d4d-2a32-39fb-bfa7-2d62f04ad324",
                                "text": "Spoerle kommt und geht."
                            },
                            {
                                "example_id": "ef65c1b9-f969-44da-b5ac-c263f6760682",
                                "sense_id": "b3829d4d-2a32-39fb-bfa7-2d62f04ad324",
                                "text": "Spoerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
