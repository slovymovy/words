                                        "sense_id": "1303ab09-7eeb-3338-9a7c-3ac12df15b43",
                                        "entry_id": "d847b669-0c12-3481-9d83-1a9d95e1e749",
                                        "glosses": [
                                            "A pyrotechnic tear gas canister."
