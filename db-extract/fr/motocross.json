                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c902d5e-ccd9-4d47-b648-0317ec4f9937",
                                "sense_id": "fe1e4f21-4d00-3c3f-8fa7-8e0296d81bd9",
                                "text": "Les motos conçues spécialement pour le motocross sont dépourvues de tout accessoire superflu : rarement de démarreur électrique, jamais de rétroviseur ou de signalisation."
                            },
                            {
                                "example_id": "f77934a3-0db5-4c33-8cbc-11eade515331",
                                "sense_id": "fe1e4f21-4d00-3c3f-8fa7-8e0296d81bd9",
                                "text": "Un autre destin qui m’a profondément marqué est celui qu’a connu André Malherbe, trois fois champion du monde de motocross."
                            }
                        ]
                    }
