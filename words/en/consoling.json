    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4092cb13-57ae-382a-be84-3374c33174cc",
                    "sense_definition": "providing comfort or reducing feelings of grief, sorrow, or disappointment",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comforting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the loss of her pet, she found his <w>consoling</w> words to be very helpful.",
                            "target_lang_translations": {
                                "ru": "После потери питомца его <w>утешительные</w> слова очень ей помогли."
                            }
                        },
                        {
                            "text": "The soft music had a <w>consoling</w> effect on the grieving family during the service.",
                            "target_lang_translations": {
                                "ru": "Тихая музыка оказала <w>успокаивающее</w> действие на скорбящую семью во время службы."
                            }
                        }
                    ],
                    "synonyms": [
                        "comforting",
                        "solacing",
                        "reassuring",
                        "soothing"
                    ],
                    "antonyms": [
                        "distressing",
                        "upsetting",
                        "discouraging"
                    ],
                    "common_phrases": [
                        "consoling words",
                        "consoling presence",
                        "consoling thought"
                    ],
                    "target_lang_definitions": {
