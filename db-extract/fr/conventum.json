                                        "entry_id": "f28fee16-2c75-3e1c-9316-5caf3f184c97",
                                        "glosses": [
                                            "Treffen ehemaliger Schüler, die in die gleiche Klasse gegangen sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb88f3c5-41e8-4d5d-8a21-a86ba3086cc4",
                                                "sense_id": "7823c18c-5952-3b2b-82bc-d1eebf010f7c",
                                                "text": "„Einige Wochen vor dem Klassentreffen war ich ähnlich unruhig auf dem Stuhl hin und her gerutscht.“"
                                            },
                                            {
                                                "example_id": "2f7abdff-0872-48fb-9f5f-343a52ad9cd3",
                                                "sense_id": "7823c18c-5952-3b2b-82bc-d1eebf010f7c",
                                                "text": "„Zum Klassentreffen in Jever fuhr Mama alleine.“"
                                            },
                                            {
                                                "example_id": "870ccbfd-e418-43af-bd5f-189da4a5090e",
                                                "sense_id": "7823c18c-5952-3b2b-82bc-d1eebf010f7c",
                                                "text": "„Klassentreffen sind Brutstätten gemischter Gefühle.“"
                                            },
                                            {
                                                "example_id": "476bb4b2-f4ba-46fa-93c3-3555aed99f1a",
                                                "sense_id": "7823c18c-5952-3b2b-82bc-d1eebf010f7c",
                                                "text": "„Später, auf einem der Klassentreffen, zwanzig Jahre danach, fragten wir einander, wie wir es geschafft hatten, in Chemie nicht durchzufallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
