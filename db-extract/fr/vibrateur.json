                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "7566d752-5e06-4a3e-b914-28c517e25bc5",
                                "sense_id": "641cffc8-b089-38f0-a61d-e56095e4afdc",
                                "text": "À l’arrivée, les vibrations envoyées par le fil télégraphique vont animer les vibrateurs correspondant aux languettes du départ."
                            },
                            {
                                "example_id": "bb358d0b-db67-4ac2-9a8d-aca542551f6c",
                                "sense_id": "641cffc8-b089-38f0-a61d-e56095e4afdc",
                                "text": "Dans le tamis vibrant électrique Hummer, les vibrations sont provoquées par voie électro-magnétique. Elles se produisent perpendiculairement à la surface tamisante et elles sont déterminées par quatre vibrateurs actionnant à chaque coin le cadre sur lequel la toile est tendue."
                            }
                        ]
                    }
