                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8650c6d-bf30-35b2-b1e8-5c162d269d3f",
                    "sense_definition": "Carrying a hidden electronic device to record or transmit conversations secretly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surveillance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police informant was <w>wired</w> during the meeting with the suspect.",
                            "target_lang_translations": {
                                "ru": "Полицейский информатор был <w>с жучком</w> во время встречи с подозреваемым.",
                                "nl": "De politie-informant <w>droeg een zendertje</w> tijdens de ontmoeting met de verdachte."
                            }
                        },
                        {
                            "text": "They spoke in whispers because they feared the room might be <w>wired</w>.",
                            "target_lang_translations": {
                                "ru": "Они говорили шепотом, потому что боялись, что комната может быть <w>на прослушке</w>.",
                                "nl": "Ze fluisterden omdat ze bang waren dat de kamer <w>afgeluisterd</w> werd."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий при себе скрытое электронное устройство для тайной записи или передачи разговоров.",
                        "nl": "Voorzien van verborgen afluisterapparatuur om gesprekken in het geheim op te nemen of door te sturen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с жучком",
                                "target_lang_sense_clarification": "о человеке со скрытым микрофоном"
                            },
                            {
                                "target_lang_word": "на прослушке",
