                    {
                        "sense_id": "5547b48c-e379-3ef3-a753-4055388c48a5",
                        "entry_id": "77fac40f-7ab3-3680-9760-15f18be6ef72",
                        "glosses": [
                            "de rode bloedkleurstof die verantwoordelijk is voor het zuurstof- en CO2 transport in het bloed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ba25277-1fe2-4447-9734-f26d88e4b759",
                                "sense_id": "5547b48c-e379-3ef3-a753-4055388c48a5",
                                "text": "Cyanose is een blauwe verkleuring van huid en slijmvliezen door tekort aan zuurstof. Het bloed bevat te veel hemoglobine zonder zuurstof. Dat kan plaatselijk zijn of algemeen."
                            },
                            {
                                "example_id": "3d8d2b3d-4046-4614-a623-ee5980917ed7",
                                "sense_id": "5547b48c-e379-3ef3-a753-4055388c48a5",
                                "text": "Mol (1999) beschrijft hoe verschillende soorten bloedarmoede kunnen bestaan. Door te luisteren naar klachten of door het hemoglobinegehalte van een patiënt te vergelijken met het gemiddelde van een populatie, kan een arts tot deze diagnose komen. Het gaat dan echter om diagnoses die elkaar niet precies overlappen. Een patiënt kan klachten hebben, terwijl zijn hemoglobinegehalte volgens de statistiek niet buiten de normale waarden valt en omgekeerd."
                            }
                        ]
                    }
                ],
