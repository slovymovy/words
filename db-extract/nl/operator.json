                        "entry_id": "d459907e-b9ac-3d7c-abb0-e88bdbc346eb",
                        "glosses": [
                            "symbool waarmee een functie [3] wordt aangeduid die een bepaalde bewerking uitvoert op één of meer operanden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a95ba98-9981-406c-b432-aa4a7f3a2cf6",
                                "sense_id": "f80acc57-0374-346e-930e-8d5b8e2b8638",
                                "text": "Een wiskundige operator."
                            }
                        ]
