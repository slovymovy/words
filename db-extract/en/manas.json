                "senses": [
                    {
                        "sense_id": "ac05e757-a22b-34d8-977c-1cc60f3ca1c6",
                        "entry_id": "a739d507-387b-3537-8bbe-050043a76223",
                        "glosses": [
                            "A county of Changji prefecture, Xinjiang autonomous region, China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37a0aa2b-8b03-4662-9db1-bc03ac39c5cf",
                                "sense_id": "ac05e757-a22b-34d8-977c-1cc60f3ca1c6",
                                "text": "Murder convict Li Xinming's wife delivered a third baby intentionally, and the (Lanzhouwan) Township Government in Manas County subsequently made a decision on dealing with the latter."
                            },
                            {
                                "example_id": "3f7a0076-b8db-41ef-90ac-0df716bd7ae0",
                                "sense_id": "ac05e757-a22b-34d8-977c-1cc60f3ca1c6",
                                "text": "In the western part of the prefecture, cities like Changji and Manas grew quickly; smaller towns in the east of the prefecture like Qitai and Jimsar also saw increases in their populations, aided by improved roads linking these areas to the regional capital of Urumqi."
                            },
                            {
                                "example_id": "72de7ec2-c88c-4a4e-881d-477bc340ced2",
                                "sense_id": "ac05e757-a22b-34d8-977c-1cc60f3ca1c6",
                                "text": "The Qigu oil field is located to the southwest of Manas County in the west part of the South Junggar Depression."
                            },
                            {
                                "example_id": "99f8506c-041f-41fa-9a11-8f37144e3025",
                                "sense_id": "ac05e757-a22b-34d8-977c-1cc60f3ca1c6",
                                "text": "The ministry said 13 swans had died in the Manas county wetlands near Changji city that were inhabited by around 800 birds."
                            }
                        ]
                    },
