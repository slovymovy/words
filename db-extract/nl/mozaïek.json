                        "entry_id": "6bd6b143-aa29-3ead-aef0-094d97daef13",
                        "glosses": [
                            "figuur van aaneengesloten kleine, ingelegde stukjes glas, steen, hout die op een harde ondergrond zijn bevestigd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f45c767-a325-4f70-9b9b-d93ed9fa6785",
