                "translations": [
                    {
                        "translation_id": "c7862da0-09f8-4f75-8e6e-eb75046888ce",
                        "source_entry_id": "48355a8b-b4c1-383f-b635-8d07f12a0499",
                        "target_lang_word": "aparté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aparté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b407213-ccc8-39cd-beb0-bf381a7aadd1",
                                        "entry_id": "bf5ed56e-35e3-375f-a421-f095f653d73e",
                                        "glosses": [
                                            "Monologue ou petite réplique théâtrale qui n’est pas entendu par les autres personnages de la scène mais uniquement par les spectateurs."
                                        ],
                                        "tags": [],
                                        "note": "Cette petite réplique permet au metteur en scène d’annoncer au public quelque chose qui peut ne pas être évident, comme les sentiments du personnage, ou d’ajouter une pointe d’humour",
                                        "examples": [
                                            {
                                                "example_id": "72bf91d8-95e7-41dd-8cee-aeb967452184",
                                                "sense_id": "1b407213-ccc8-39cd-beb0-bf381a7aadd1",
                                                "text": "Plus que le monologue, cʼest lʼaparté que Sénèque a pratiqué."
                                            },
                                            {
                                                "example_id": "444c22f2-c0b3-4be2-aae4-d8a0a0b09f66",
                                                "sense_id": "1b407213-ccc8-39cd-beb0-bf381a7aadd1",
                                                "text": "Elle ajoutait, dans une sorte d’aparté théâtral, assez fort cependant pour qu’on l’entende, qu’elle avait l’habitude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "133134ee-a1c7-35d0-b357-65a6aad54dc0",
                                        "entry_id": "bf5ed56e-35e3-375f-a421-f095f653d73e",
                                        "glosses": [
                                            "Conversation secrète."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc5e6db9-8401-4842-9e2c-d2579b3f06ee",
                                                "sense_id": "133134ee-a1c7-35d0-b357-65a6aad54dc0",
                                                "text": "La conversation continuait ainsi agréablement entre Lucien, Théodelinde et son amie, lorsque madame de Serpierre crut convenable à son rôle de mère de rompre un peu cet aparté, que, d’ailleurs, elle voyait avec beaucoup de plaisir."
                                            },
                                            {
                                                "example_id": "e2a8d56c-d738-40c8-8e57-f0993dbb89b3",
                                                "sense_id": "133134ee-a1c7-35d0-b357-65a6aad54dc0",
                                                "text": "Le Roi, qui voulait le mal recevoir, affecta de le saluer légèrement et de continuer un aparté à voix basse avec le duc de Beaufort."
                                            },
                                            {
                                                "example_id": "aa7c410f-0d10-4f19-865f-4ecdd7c1c131",
                                                "sense_id": "133134ee-a1c7-35d0-b357-65a6aad54dc0",
                                                "text": "Çà ! souperons-nous ? demanda aigrement Coconnas, interrompant les apartés de son hôte."
                                            },
                                            {
                                                "example_id": "017fc652-0aec-40e4-9c28-87e8c090cf28",
                                                "sense_id": "133134ee-a1c7-35d0-b357-65a6aad54dc0",
                                                "text": "De joyeuse humeur, le mari cause avec force gestes, […] ; puis, sa tête se détourne ou se lève vers le plafond, et il prononce quelques paroles en aparté."
                                            },
                                            {
                                                "example_id": "9646a3b3-658f-4b42-a3ce-ff163722429a",
                                                "sense_id": "133134ee-a1c7-35d0-b357-65a6aad54dc0",
                                                "text": "Et, faisant moi-même alors un aparté à haute voix qui ne pouvait pas l’inquiéter puisqu’elle était sourde, je me souviens que je dis : « Mais non, ma belle, tu n’aimes pas mieux mourir. »"
                                            },
                                            {
                                                "example_id": "8da0741c-f9a2-49b0-b151-679021337818",
                                                "sense_id": "133134ee-a1c7-35d0-b357-65a6aad54dc0",
                                                "text": "Appartenant l’un et l’autre à la même coterie dans la même société, ils eurent d’incessantes occasions de se voir à des dîners, à des bals ou à des réceptions et chaque fois qu’ils se retrouvaient, mais sans jamais offenser les convenances en prolongeant d’une minute la durée de leurs apartés, ils se mettaient à l’écart et l’on aurait dit alors qu’ils avaient quelque chose d’important et d’urgent à se confier."
                                            },
                                            {
                                                "example_id": "ecca4567-5331-4d2d-8654-14c7e3589baf",
                                                "sense_id": "133134ee-a1c7-35d0-b357-65a6aad54dc0",
                                                "text": "À son arrivée, il demande de s’entretenir avec le prince et de l’entendre en aparté pour connaître les causes de sa souffrance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
