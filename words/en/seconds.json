                            {
                                "target_lang_word": "вторая порция",
                                "target_lang_sense_clarification": "еда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "第二份",
                                "target_lang_sense_clarification": "食物"
                            },
                            {
                                "target_lang_word": "加餐",
                                "target_lang_sense_clarification": "添菜添饭"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fe501e1-9b59-35e5-a7f3-4b57ffcd41fa",
                    "sense_definition": "Goods that are sold at a reduced price because they are slightly imperfect or of lower quality.",
