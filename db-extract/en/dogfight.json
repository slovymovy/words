                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nahkampf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9ea0239-684f-3ef8-bc50-f289c14afdc1",
                                        "entry_id": "0d7b8e19-918d-3af6-ab4d-6477502d789a",
                                        "glosses": [
                                            "direkte Kampfhandlung über kurze/kürzeste Distanz, zum Beispiel zwischen zwei Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f12863a5-32e5-41bb-8932-33caf0d3cf05",
                                                "sense_id": "a9ea0239-684f-3ef8-bc50-f289c14afdc1",
                                                "text": "Soldaten werden auch im Nahkampf ausgebildet."
                                            },
                                            {
                                                "example_id": "d64b551d-3861-47e1-9cfe-65df807129fd",
                                                "sense_id": "a9ea0239-684f-3ef8-bc50-f289c14afdc1",
                                                "text": "„Er aber fragt mich, ob ich auch einen Nahkampf mitgemacht hätte.“"
                                            },
                                            {
                                                "example_id": "300166f2-2d46-4149-9fce-900f7fc8d0b3",
                                                "sense_id": "a9ea0239-684f-3ef8-bc50-f289c14afdc1",
                                                "text": "„Im Nahkampf kennt er sich bestens aus und setzt auch da eine Menge Treffer.“"
                                            },
                                            {
                                                "example_id": "ea8722a9-2465-4cb8-9c99-c8698f791dd2",
                                                "sense_id": "a9ea0239-684f-3ef8-bc50-f289c14afdc1",
                                                "text": "„Carl Damm, Jahrgang 1927, hat noch die letzten Nahkämpfe in den Straßen Berlins mitgemacht.“"
                                            },
                                            {
                                                "example_id": "10f0cbcc-52f0-4731-9e8f-a271eec9e8ca",
                                                "sense_id": "a9ea0239-684f-3ef8-bc50-f289c14afdc1",
                                                "text": "„Diese Elite der Athletischsten und Gesündesten unter ihnen wurde ausgewählt und in ein Trainingslager in Mitischtschi nördlich von Moskau geschickt, wo man sie in Nahkampf, Waffenkunde, Fallschirmsprüngen aus niedriger Höhe und den Umgang mit Sprengstoff unterrichtete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
