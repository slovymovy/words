                                        "sense_id": "32a1d877-4ef2-352f-9b00-7c9f0e70b1da",
                                        "entry_id": "05b71b83-a9ed-3869-a064-bc198b178b6d",
                                        "glosses": [
                                            "Entzündung der Gefäßwand einer Vene, meist von Bakterien verursacht"
                                        ],
                                        "tags": [],
