                        "tags": [],
                        "examples": [
                            {
                                "example_id": "480802a6-3819-4169-8763-dbc8f0a1cc5c",
                                "sense_id": "3c8c1400-d950-3a46-ba4f-83659592a514",
                                "text": "Faire une récollection c’est prendre du temps, s’arrêter et se mettre à l’écoute de Dieu."
                            },
                            {
                                "example_id": "8eaf2c4f-7b04-4c75-8239-a1ecd30de2e0",
                                "sense_id": "3c8c1400-d950-3a46-ba4f-83659592a514",
                                "text": "L'usage de faire un jour de récollection chaque mois."
                            }
                        ]
                    },
