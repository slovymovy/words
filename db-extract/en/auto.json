                        ],
                        "examples": [
                            {
                                "example_id": "49ccd4ac-9c0c-4461-813b-d54d9d9324dd",
                                "sense_id": "d5ae0428-5994-3de2-93ea-dfc009df8545",
                                "text": "My brother is an auto mechanic. He can get me a discount on auto parts."
                            },
                            {
                                "example_id": "e6315423-2b76-49dd-9088-35ca30e97a1c",
                                "sense_id": "d5ae0428-5994-3de2-93ea-dfc009df8545",
                                "text": "In 1909, his grandfather was the first farmer in the county to buy an auto."
                            },
                            {
                                "example_id": "181a1bb7-0a24-4e4f-a944-453d6c8216a3",
                                "sense_id": "d5ae0428-5994-3de2-93ea-dfc009df8545",
                                "text": "“There were golden years for GM in China, but those are over, and they’ll never have a comeback story,” said Michael Dunne, an auto industry consultant who has been involved in Western automakers’ efforts in China since the 1990s, including GM’s entry into the market."
                            },
                            {
                                "example_id": "e5523ef7-d502-4b70-b416-c66671023501",
                                "sense_id": "d5ae0428-5994-3de2-93ea-dfc009df8545",
                                "text": "“We spoke with the Big Three auto dealers. We are going to give a one-month exemption on any autos coming through USMCA,” President Donald Trump said in a statement read by White House Press Secretary Karoline Leavitt at a press briefing Wednesday. Those dealers included Stellantis, Ford and General Motors."
                            }
                        ]
                    },
                    {
                        "sense_id": "778b0655-5a72-34a2-b5a7-26d75ca63d6f",
                        "entry_id": "73ddca0a-bad3-3e4d-8bad-ff1eada776cb",
                        "glosses": [
                            "A setting for automatic operation."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bbcc7905-7049-43d8-ac67-0946b37519ef",
                                "sense_id": "778b0655-5a72-34a2-b5a7-26d75ca63d6f",
                                "text": "Put it on auto."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2573661-eea5-35cd-b347-7056683499f5",
                        "entry_id": "73ddca0a-bad3-3e4d-8bad-ff1eada776cb",
                        "glosses": [
                            "An automatic gearbox/transmission."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7ace5ef8-5014-433f-94ff-05e9674e0623",
                                "sense_id": "e2573661-eea5-35cd-b347-7056683499f5",
                                "text": "A body-coloured centre pillar signalled the arrival of an electronic four-speed auto, slight suspension revisions and minor trim changes."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c11ebed-9a90-378a-be24-ad6a039039a6",
                        "entry_id": "73ddca0a-bad3-3e4d-8bad-ff1eada776cb",
                        "glosses": [
                            "A car with an automatic gearbox/transmission."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9d531409-ca96-4f55-8565-3787c0feeb71",
                                "sense_id": "6c11ebed-9a90-378a-be24-ad6a039039a6",
                                "text": "It wasn't too bad but we did hire an auto (couldn't imagine changing gears with my right hand)."
                            }
                        ]
                    }
