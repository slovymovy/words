                    {
                        "translation_id": "c076390c-0b17-43b3-bb22-7954ca8c9215",
                        "source_entry_id": "dc43b339-fe84-317d-b4b7-1830422c8ecd",
                        "source_sense_id": "b0669711-bbcd-3215-8012-613f2c87df9e",
                        "source_sense_description": "in a convincing manner",
                        "target_lang_word": "überzeugend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überzeugend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                        "entry_id": "7c7f1c14-cfd7-3b8d-a35d-02f80e1b8f33",
                                        "glosses": [
                                            "so, dass jemand glaubt, dass etwas wahr ist: einleuchtend, glaubhaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9572542d-ef89-429d-abe8-8d8a14429899",
                                                "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                                "text": "Seine Argumentation ist wirklich überzeugend."
                                            },
                                            {
                                                "example_id": "3ce18e73-ef91-4fd2-99a4-844089c148e3",
                                                "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                                "text": "Dieser Kandidat hat einen überzeugenden Auftritt."
                                            },
                                            {
                                                "example_id": "59bfb04f-c659-44c6-ac27-7366215dcedd",
                                                "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                                "text": "Ich fand ihre Erklärungsversuche nicht überzeugend."
                                            },
                                            {
                                                "example_id": "95316b15-9ffa-4940-ad5d-a26db0dd7824",
                                                "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                                "text": "Sollen das ihre überzeugenden Beweise sein?"
                                            },
                                            {
                                                "example_id": "412f9c49-c42a-4053-954d-b6e323d37550",
                                                "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                                "text": "„Der Bericht sagt sehr überzeugend, wohlfundiert, dass es sich lohnt, in Klima zu investieren.“"
                                            },
                                            {
                                                "example_id": "cb3f94c6-b74a-448c-93f5-9505a1c54eac",
                                                "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                                "text": "Gerade in einem Song wie \"All my hope is gone\" kommt der Blues zurück, den Faulkner so liebt und so überzeugend spielt, als wäre er selbst am Mississippi groß geworden."
                                            },
                                            {
                                                "example_id": "374ce25b-34c6-415b-b35e-6da36c4a21fe",
                                                "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                                "text": "[…] wenn er bisher in den ersten Tagen seit seiner Wahl eines überzeugend unter Beweis gestellt hat: Donald Trump ist immer für Überraschungen gut."
                                            },
                                            {
                                                "example_id": "59645911-b2c5-4c15-b18e-28cfe849b65e",
                                                "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                                "text": "DFB-Frauen siegen gegen Frankreich: Mit einem überzeugenden Erfolg gegen die Equipe Tricolore haben die deutschen Fußball-Frauen ein schlechtes Länderspiel-Jahr beendet."
                                            },
                                            {
                                                "example_id": "16426988-6172-4847-8425-38c187e9488f",
                                                "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                                "text": "Damit kein Mißverständnis aufkommt: Zarnajews Tat war verabscheuungswürdig und muß entsprechend hart bestraft werden. Die Frage ist nur, ob Juroren und Richter wirklich frei in ihrer Entscheidung waren und die Todesstrafe demzufolge überzeugend gefällt wurde. Ich bleibe bei meinen Zweifeln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
