                                                "sense_id": "cd5f709b-644c-3d8e-82a7-255a49c5651c",
                                                "text": "Dat wordt later voltooid."
                                            },
                                            {
                                                "example_id": "7188ab28-4904-40e2-ab4b-d35322a6736e",
                                                "sense_id": "cd5f709b-644c-3d8e-82a7-255a49c5651c",
                                                "text": "Hij heeft het later voltooid."
                                            },
                                            {
                                                "example_id": "0729dd57-cf6a-414f-9c15-af45c07809f5",
                                                "sense_id": "cd5f709b-644c-3d8e-82a7-255a49c5651c",
                                                "text": "De toepasselijk genaamde Tats was een zogenaamde Triple Crowner (iemand die zowel de de Appalachian Trail als de Continental Divide Trail en de Pacific Crest Trail heeft voltooid) die de afgelopen acht jaar meer dan 30.000 kilometer had gelopen."
                                            },
                                            {
                                                "example_id": "760d168d-d9a9-4514-87a0-ff8a919681f3",
                                                "sense_id": "cd5f709b-644c-3d8e-82a7-255a49c5651c",
                                                "text": "De voltooide tijden drukken uit dat de handeling of het proces van het gezegde compleet is."
                                            },
                                            {
                                                "example_id": "b04b9082-5bc4-487c-bd38-63b001158d58",
                                                "sense_id": "cd5f709b-644c-3d8e-82a7-255a49c5651c",
                                                "text": "In ijltempo voltooid oogstte de nieuwe brug veel blijken van waardering."
                                            }
                                        ]
                                    }
                                ]
                            },
