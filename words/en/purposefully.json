{
    "word_family": [
        "purpose",
        "purposeful"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9b17ba53-954e-3ba7-bc96-e2812c30b1e0",
                    "sense_definition": "In a way that shows determination and a clear goal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She walked <w>purposefully</w> toward the stage to accept her award.",
                            "target_lang_translations": {
                                "pl": "Podeszła <w>zdecydowanym krokiem</w> do sceny, aby odebrać nagrodę."
                            }
                        },
                        {
                            "text": "The team worked <w>purposefully</w> to finish the project before the deadline.",
                            "target_lang_translations": {
                                "pl": "Zespół pracował <w>z pełnym zaangażowaniem</w>, aby ukończyć projekt przed terminem."
                            }
                        }
                    ],
                    "synonyms": [
                        "intentionally"
                    ],
                    "common_phrases": [
                        "move purposefully",
                        "work purposefully"
                    ],
                    "target_lang_definitions": {
                        "pl": "W sposób wykazujący determinację i posiadanie jasnego celu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zdecydowanie",
                                "target_lang_sense_clarification": "w sposób pewny siebie i ukierunkowany na cel"
                            },
                            {
                                "target_lang_word": "celowo",
                                "target_lang_sense_clarification": "z wyraźnym zamiarem osiągnięcia czegoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0732a9c6-f975-3cdf-8f4b-45d9cb2cf80d",
                    "sense_definition": "Done in a way that is planned or intended rather than accidental.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>purposefully</w> ignored the rude comment to avoid an argument.",
                            "target_lang_translations": {
                                "pl": "Zignorował <w>celowo</w> chamski komentarz, aby uniknąć kłótni."
                            }
                        },
                        {
                            "text": "The artist <w>purposefully</w> left parts of the canvas blank for effect.",
                            "target_lang_translations": {
                                "pl": "Artysta <w>umyślnie</w> pozostawił fragmenty płótna puste dla uzyskania efektu."
                            }
                        }
                    ],
                    "synonyms": [
                        "deliberately",
                        "intentionally",
                        "purposely",
                        "wilfully",
                        "willfully"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zrobione w sposób zaplanowany lub zamierzony, a nie przypadkowy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "umyślnie",
                                "target_lang_sense_clarification": "z pełną świadomością i zamiarem"
                            },
                            {
                                "target_lang_word": "celowo",
                                "target_lang_sense_clarification": "z premedytacją, nieprzypadkowo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}