                    {
                        "sense_id": "bde7944b-9a1f-3809-ab43-58aea6f0a086",
                        "entry_id": "db285c39-777b-3ccf-bd3a-4d8de73145c9",
                        "glosses": [
                            "Genre musical mêlant musique électro des années 1980, new wave et synthpop à de la techno des années 1990, de l’electropop retro et de la musique dance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84559305-cbfd-4953-b305-0be588f5421a",
                                "sense_id": "bde7944b-9a1f-3809-ab43-58aea6f0a086",
                                "text": "La new wave synthétique des années 1980 côtoie la techno glacée de Vitalic et l’électroclash de Miss Kittin."
                            },
                            {
                                "example_id": "60f4d8ff-c2a8-4ab3-abaf-cc746f89fcc7",
                                "sense_id": "bde7944b-9a1f-3809-ab43-58aea6f0a086",
                                "text": "Le fait que le nom de DJ Hell revienne souvent dans les discussions n’est pas anodin. Pour David Carretta, qui cite pourtant Space Invaders Are Smoking Grass d’I-F comme pièce fondatrice de l’électroclash, le producteur allemand est celui par qui tout pouvait arriver. « Il aimait être dans la représentation, toujours à organiser des conférences de presse, des repas ou des soirées. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d69cdb3b-5f6a-42cc-b0ef-8e82b729c63c",
                        "source_entry_id": "db285c39-777b-3ccf-bd3a-4d8de73145c9",
                        "source_sense_id": "bde7944b-9a1f-3809-ab43-58aea6f0a086",
                        "target_lang_word": "electroclash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "electroclash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f8c2178-0cf0-39d4-9a7d-edf713230eb3",
                                        "entry_id": "94f1158d-f566-38d3-ba7f-1fa4abc0ceb7",
                                        "glosses": [
                                            "A music style from the late 1990s fusing dance music, punk and electronic."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06e5b3b2-d3a5-4f08-a075-1db6a583f2ec",
                                                "sense_id": "1f8c2178-0cf0-39d4-9a7d-edf713230eb3",
                                                "text": "Electroclash began as an esoteric offshoot of techno, revisiting some of the genre's original sonic touchstones: Kraftwerk, Depeche Mode, New Order, Afrika Bambaataa and New York disco."
                                            },
                                            {
                                                "example_id": "178d46a3-b827-49e8-881c-f2a85c04e649",
                                                "sense_id": "1f8c2178-0cf0-39d4-9a7d-edf713230eb3",
                                                "text": "Oft-derided, even in its 2002 heyday, no one expected electroclash to last. But, just as sonic heirs such as La Roux or Little Boots capitalise on their groundwork, the old electro guard return with works of real solidity and depth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
