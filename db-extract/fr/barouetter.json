                        "glosses": [
                            "Transporter une charge avec une brouette."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "fbbc5984-1889-4c11-b0bd-44cd47e58584",
                                "sense_id": "f77abe8a-00b0-3808-a3b0-ce6c13514a4e",
                                "text": "J’ai tout barouetté la gravelle du camion jusqu’au chantier."
                            }
                        ]
                    },
                    {
                        "sense_id": "1221339d-b860-3b1c-a743-5216af65c340",
                        "entry_id": "bda277de-b64d-3bc6-afd0-7e14fd17c3fc",
                        "glosses": [
                            "Mener continuellement d’un lieu à un autre, sinon autoritairement du moins plutôt cavalièrement."
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "253496b8-3c2d-49b1-bf06-e23815787c31",
                                "sense_id": "1221339d-b860-3b1c-a743-5216af65c340",
                                "text": "Depuis qu’elle est veuve, leur mère arrête pas de se faire barouetter de chez un enfant chez un autre."
                            }
                        ]
                    }
