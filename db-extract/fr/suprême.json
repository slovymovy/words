        "fr-extract.jsonl": [
            {
                "entry_id": "71b4caf7-7035-3087-a6d3-f040dfacc892",
                "word": "suprême",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d2db041e-8743-4f42-9bcb-847e648fc568",
                        "entry_id": "71b4caf7-7035-3087-a6d3-f040dfacc892",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "suprêmes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5cd06917-0012-3450-88b7-81b1b95e6388",
                        "entry_id": "71b4caf7-7035-3087-a6d3-f040dfacc892",
                        "glosses": [
                            "Qui est au-dessus de tout ; supérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01658e0a-ee25-4c1c-835e-2a33294bce60",
                                "sense_id": "5cd06917-0012-3450-88b7-81b1b95e6388",
                                "text": "Le quiétisme […] érigeait en système et posait avec franchise comme suprême perfection l’état d’immobilité et d’impuissance où l’âme parvient à la longue quand elle abdique son activité."
                            },
                            {
                                "example_id": "9f3768e7-9157-4645-b043-798d000848e8",
                                "sense_id": "5cd06917-0012-3450-88b7-81b1b95e6388",
                                "text": "Le fléau suprême, c’est dans le Tarn-et-Garonne comme dans toute la France, la tuberculose."
                            },
                            {
                                "example_id": "db6e6e2c-c113-4c87-948d-6e807b48acb0",
                                "sense_id": "5cd06917-0012-3450-88b7-81b1b95e6388",
                                "text": "Ils remontaient au temps d’une certaine pègre pour qui la suprême élégance consistait à se pourvoir d’un couvre-chef de couleur tendre et de souliers vernis."
                            },
                            {
                                "example_id": "fdefb8f7-5eb0-4780-b25a-3df8e2b9899a",
                                "sense_id": "5cd06917-0012-3450-88b7-81b1b95e6388",
                                "text": "Dans le sillage de Milton Friedman, les « économistes » américains, et pas seulement américains, ont élevé l'argent – sous le pseudonyme rabâché de «marché» – au rang d'une autorité suprême et consciente."
                            }
                        ]
                    },
                    {
                        "sense_id": "422c9d43-1bdd-31b3-ad6c-1a7f85c9cb30",
                        "entry_id": "71b4caf7-7035-3087-a6d3-f040dfacc892",
                        "glosses": [
                            "Dernier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89c003b4-ef40-420a-b16b-e2b296239c55",
                                "sense_id": "422c9d43-1bdd-31b3-ad6c-1a7f85c9cb30",
                                "text": "Suprême pensée."
                            },
                            {
                                "example_id": "7c4d4933-0163-4ae8-9c9f-ab80041d7204",
                                "sense_id": "422c9d43-1bdd-31b3-ad6c-1a7f85c9cb30",
                                "text": "Il s’était défendu jusqu’à la suprême minute, d’une fenêtre de l’hôtel canardant les agents qui devaient traverser la cour pour arriver jusqu’à sa chambre."
                            },
                            {
                                "example_id": "fbffd39c-118b-47c1-ae0e-fa7f4b1edba4",
                                "sense_id": "422c9d43-1bdd-31b3-ad6c-1a7f85c9cb30",
                                "text": "Condé eut une suprême hésitation, puis, levant la main, il prononça : \"Demain, à quatre heures, je serai ici et nous marcherons sur le Louvre.\""
                            },
                            {
                                "example_id": "25d8d90e-0aa0-4dc3-a96a-fb87e03b0609",
                                "sense_id": "422c9d43-1bdd-31b3-ad6c-1a7f85c9cb30",
                                "text": "Suprême espoir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
