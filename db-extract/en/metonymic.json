                                        "entry_id": "ba1570cb-927e-3f06-975f-f9d437ffec5b",
                                        "glosses": [
                                            "Relatif à la métonymie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dab7d4f8-3496-4678-b648-7b9736e29522",
                                                "sense_id": "9497b5fa-9219-34fc-b46e-ed573af20a0d",
                                                "text": "Il y a relation métonymique entre une ville et ses habitants, ceux-ci étant une partie de celle-là."
                                            }
