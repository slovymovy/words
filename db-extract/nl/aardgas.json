        "nl-extract.jsonl": [
            {
                "entry_id": "b7c6ac39-34c8-330d-afb1-5a0aaf554bf0",
                "word": "aardgas",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "cfb60299-b738-456c-a5c9-d7a90759ec47",
                        "entry_id": "b7c6ac39-34c8-330d-afb1-5a0aaf554bf0",
                        "tags": [
                            "plural"
                        ],
                        "form": "aardgassen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c2a3a07f-bc9a-3e1d-9009-ff61577dae95",
                        "entry_id": "b7c6ac39-34c8-330d-afb1-5a0aaf554bf0",
                        "glosses": [
                            "een gas dat uit de aarde komt en dat grotendeels uit methaan bestaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "298f713f-2eb1-4bcf-ae00-c89d0c698d4c",
                                "sense_id": "c2a3a07f-bc9a-3e1d-9009-ff61577dae95",
                                "text": "Rusland is momenteel de grootste exporteur van aardgas."
                            },
                            {
                                "example_id": "d012b114-4fe5-4438-9d04-4d3ea2fa6f35",
                                "sense_id": "c2a3a07f-bc9a-3e1d-9009-ff61577dae95",
                                "text": "In Groningen is bij Slochteren een groot aardgasveld gevonden."
                            },
                            {
                                "example_id": "bbbbae8c-7cfd-4af7-9b3e-7ed9168a9610",
                                "sense_id": "c2a3a07f-bc9a-3e1d-9009-ff61577dae95",
                                "text": "En vervolgens dumpen ze in zulke gebieden een hele partij windmolens, mag je niet meer in je diesel naar je werk rijden, verkopen ze de boerenakkers aan de hoogst biedende investeerder, dreigen ze mensen die zich geen aardgas kunnen veroorloven hun houtkachels af te nemen en overwegen ze zonder blikken of blozen om ook nog barbecues en kampvuurtjes te verbieden waar mensen zich in hun laatste beetje vrije tijd mee vermaken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6489378b-ca33-4628-9b72-f8c2459ea66e",
                        "source_entry_id": "b7c6ac39-34c8-330d-afb1-5a0aaf554bf0",
                        "source_sense_id": "c2a3a07f-bc9a-3e1d-9009-ff61577dae95",
                        "source_sense_description": "een gas dat uit de aarde komt en dat grotendeels uit methaan bestaat",
                        "target_lang_word": "Erdgas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erdgas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2c832c6-69bb-3697-8d1d-319bbb55b8f7",
                                        "entry_id": "b12cec1d-e8c6-3f8f-bf1a-880092a24358",
                                        "glosses": [
                                            "ein in den Hohlräumen der Erdkruste vorkommendes brennbares Gas, besteht überwiegend aus Methan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8672b7d9-09a0-48dc-b7de-fd8a51fe214f",
                                                "sense_id": "b2c832c6-69bb-3697-8d1d-319bbb55b8f7",
                                                "text": "Erdgas wird als Energieträger in Zukunft eine zunehmend wichtige Rolle spielen."
                                            },
                                            {
                                                "example_id": "76e02242-9fb4-431d-be37-d49e3d96fd41",
                                                "sense_id": "b2c832c6-69bb-3697-8d1d-319bbb55b8f7",
                                                "text": "„So entstehen Risse, durch die mit herkömmlichen Methoden nicht förderbares Erdgas entweichen kann.“"
                                            },
                                            {
                                                "example_id": "0bb7be17-95d2-4e40-b77a-588db2738679",
                                                "sense_id": "b2c832c6-69bb-3697-8d1d-319bbb55b8f7",
                                                "text": "„[…] Deutschland hatte […] im Jahr 2023 einen Jahresverbrauch von rund 76 Milliarden Kubikmeter Erdgas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6db9f256-ccdf-4ebb-807e-9f5c8da4f406",
                        "source_entry_id": "b7c6ac39-34c8-330d-afb1-5a0aaf554bf0",
                        "source_sense_id": "c2a3a07f-bc9a-3e1d-9009-ff61577dae95",
                        "source_sense_description": "een gas dat uit de aarde komt en dat grotendeels uit methaan bestaat",
                        "target_lang_word": "natural gas",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "natural gas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "993fccf0-7c20-3d83-8791-9786092f0eac",
                                        "entry_id": "c407be35-b080-359b-baf8-8dfcad1173af",
                                        "glosses": [
                                            "A mixture of gaseous hydrocarbons associated with petroleum deposits; mostly methane with smaller amounts of ethane, propane and butane; principally used as a fuel."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbca2379-bd91-42e0-8bd5-a6978c5397ef",
                                                "sense_id": "993fccf0-7c20-3d83-8791-9786092f0eac",
                                                "text": "For a good many years, beginning in London, Brighton & South Coast days, the station at Heathfield, between Tunbridge Wells and Eastbourne, was lighted by natural gas. The use of this illuminant was discontinued about 1934."
                                            },
                                            {
                                                "example_id": "04c61dfd-02a5-413f-9e81-1107769c691e",
                                                "sense_id": "993fccf0-7c20-3d83-8791-9786092f0eac",
                                                "text": "Natural gas is an odorless, colorless gas from inside the Earth. When burned, it provides abundant heat to homes and businesses around the United States and the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b30fe187-2555-47c4-b6b7-cde634a2986d",
                        "source_entry_id": "b7c6ac39-34c8-330d-afb1-5a0aaf554bf0",
                        "source_sense_id": "c2a3a07f-bc9a-3e1d-9009-ff61577dae95",
                        "source_sense_description": "een gas dat uit de aarde komt en dat grotendeels uit methaan bestaat",
                        "target_lang_word": "gaz naturel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaz naturel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ece12580-c5a3-31d3-af9a-021c82a1d1a3",
                                        "entry_id": "9dcd76d1-4272-35f1-bc16-59c6eb2550c0",
                                        "glosses": [
                                            "Mélange gazeux à 70‑90 % de méthane, renfermant de l’éthane, du propane, du butane et des impuretés, extrait de roches‑réservoirs souterraines (souvent avec le pétrole) et employé comme combustible ainsi que comme matière première pétrochimique."
                                        ],
                                        "tags": [
                                            "Industrie de l’énergie",
                                            "Pétrochimie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fd0297a-6c41-484c-8096-efb670e2c85f",
                                                "sense_id": "ece12580-c5a3-31d3-af9a-021c82a1d1a3",
                                                "text": "Un véritable gâchis. Un peu partout dans le monde, chaque année, des milliards de mètres cubes de gaz naturel partent en fumée, brûlés en pure perte. Ce gaspillage a un nom : le “torchage”, ou flaring."
                                            },
                                            {
                                                "example_id": "0d1313ea-3847-4ba3-bd8b-7860d20d398f",
                                                "sense_id": "ece12580-c5a3-31d3-af9a-021c82a1d1a3",
                                                "text": "La roche en fusion des sills pourrait avoir enflammé des gisements de gaz naturel peu profonds, un peu comme une allumette qu’on approche d’un barbecue à gaz."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
