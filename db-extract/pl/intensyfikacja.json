                    },
                    {
                        "translation_id": "ca1a6a0f-552d-4686-a477-a934ed4d5160",
                        "source_entry_id": "54f50d41-e1d4-368e-86df-647d8c3f877e",
                        "source_sense_id": "ffe40a57-0b5d-3295-a60e-54149d58a647",
                        "target_lang_word": "Intensivierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Intensivierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "876a9e34-9c82-30da-a55c-941b517d184e",
                                        "entry_id": "a80c3de6-3606-36f7-8dd3-4b3292b15bc9",
                                        "glosses": [
                                            "Handlung, etwas stärker/intensiver zu machen, und Ergebnis dieser Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c6b98ea-f530-48f7-b0d5-42f64c3dc5a9",
                                                "sense_id": "876a9e34-9c82-30da-a55c-941b517d184e",
                                                "text": "„Es klingt paradox, aber jene zwanzig Jahre, in denen Ostpreußen vom Rest Deutschlands territorial abgetrennt war, führten zu einer Intensivierung der Beziehungen, zu einem mentalen Zusammenrücken, ja zu einer nationalen Überhöhung der Provinz.“"
                                            },
                                            {
                                                "example_id": "d59b13e4-7c07-4c76-9d6c-394c5c06a323",
                                                "sense_id": "876a9e34-9c82-30da-a55c-941b517d184e",
                                                "text": "„Auch der professionelle Grenzgänger hat in der Regel Ambitionen, die als vordergründiges Reizstreben nicht begreifbar sind: Er sucht nach einer Intensivierung seines Lebens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68905ba5-df53-44c8-a9f9-3ea7ec3694b6",
                        "source_entry_id": "54f50d41-e1d4-368e-86df-647d8c3f877e",
                        "source_sense_id": "ffe40a57-0b5d-3295-a60e-54149d58a647",
                        "target_lang_word": "интенсифика́ция",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "интенсифика́ция",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1781f0d3-409c-38c7-92fd-2c5c2336e11f",
                                        "entry_id": "d88f7fd7-3559-3527-8060-e46385137d82",
                                        "glosses": [
                                            "книжн. действие по значению гл. интенсифицировать; увеличение интенсивности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03d5d248-84f2-4824-863d-ee4aa71dfcd9",
                                                "sense_id": "1781f0d3-409c-38c7-92fd-2c5c2336e11f",
                                                "text": "У меня в связи с интенсификацией огородных и строительных усилий наблюдается определённый куркулизм и даже где-то обрастание шерстью."
                                            },
                                            {
                                                "example_id": "0927d884-d915-41ba-bccb-bb4470acd065",
                                                "sense_id": "1781f0d3-409c-38c7-92fd-2c5c2336e11f",
                                                "text": "Сибирь даёт много новой обработанной земли, а интенсификация сельского хозяйства даст возможность повысить производство."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
