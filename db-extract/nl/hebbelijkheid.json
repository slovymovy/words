                "senses": [
                    {
                        "sense_id": "30802975-55e1-3fa0-9c5a-320fcffb9e96",
                        "entry_id": "e2bee6fc-7a03-371b-97c9-d9a90f9fe272",
                        "glosses": [
                            "kenmerkende, vreemde gewoonte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "201f6e26-baae-4ade-8cb0-3c4f07761d0c",
                                "sense_id": "30802975-55e1-3fa0-9c5a-320fcffb9e96",
                                "text": "Ik vrees dat de attractie meer te maken had met zijn strakke Latijns-Amerikaanse aarsje. Al was Duarte dan de jongste niet meer tijdens zijn laatste proces kwam aan het licht dat hij twaalf intensieve escortjaren in New York doorlopen had , dat aarsje van hem had de hebbelijkheid om razendsnel, wat het ook te verstouwen had gehad, terug te springen naar zijn oervorm."
                            },
                            {
                                "example_id": "38d4c85e-0e68-4b87-b8be-ebffb9a1146c",
                                "sense_id": "30802975-55e1-3fa0-9c5a-320fcffb9e96",
                                "text": "Nog één moderne hebbelijkheid. Iets gewoon mooi vinden is verleden tijd. In de radio en op de televisie is het op z’n minst héél mooi, of heel erg mooi of ontzettend mooi. Het bijvoeglijke naamwoord zonder versterking is aan het verdwijnen. Ook dat is heel erg opmerkelijk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6ce89fb-e9e5-4611-8c0a-23a46774b71f",
                        "source_entry_id": "e2bee6fc-7a03-371b-97c9-d9a90f9fe272",
                        "source_sense_id": "30802975-55e1-3fa0-9c5a-320fcffb9e96",
                        "source_sense_description": "kenmerkende, vreemde gewoonte",
                        "target_lang_word": "mannerism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mannerism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9a5f9a5-5f84-33b7-b1b1-80a56066eb77",
                                        "entry_id": "b30d47fa-420e-39f9-89eb-511d3788c684",
                                        "glosses": [
                                            "A noticeable personal habit, a verbal or other (often, but not necessarily unconscious) habitual behavior peculiar to an individual."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24a56144-0664-4a9a-a249-f25ab4522c3e",
                                                "sense_id": "d9a5f9a5-5f84-33b7-b1b1-80a56066eb77",
                                                "text": "In the old days, to my commonplace and unobserving mind, he gave no evidences of genius whatsoever. He never read me any of his manuscripts, […], and therefore my lack of detection of his promise may in some degree be pardoned. But he had then none of the oddities and mannerisms which I hold to be inseparable from genius, and which struck my attention in after days when I came in contact with the Celebrity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f0048f8-093b-3e76-8751-640a74863159",
                                        "entry_id": "b30d47fa-420e-39f9-89eb-511d3788c684",
                                        "glosses": [
                                            "Exaggerated or affected style in art, speech, or other behavior."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a49471f1-682d-4a92-861f-5344887a67c1",
                                                "sense_id": "5f0048f8-093b-3e76-8751-640a74863159",
                                                "text": "artists […] dabblingly pursuing a kind of formalist mannerism merely in the interest of careerism"
                                            },
                                            {
                                                "example_id": "6536f028-9d74-4449-8bd2-26748dd90a86",
                                                "sense_id": "5f0048f8-093b-3e76-8751-640a74863159",
                                                "text": "He generally spoke without academic mannerism, though on occasion he dipped into the over-wrought thickets of eduspeak to find words like “antithetical” or “foci” or “interface.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mannerism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ebcaa7d-80cb-3cc9-ad05-9069e5608390",
                                        "entry_id": "4333d455-b30f-3f70-a2b4-a099bfbc0c39",
                                        "glosses": [
                                            "In literature, an ostentatious and unnatural style of the second half of the sixteenth century. In the contemporary criticism, described as a negation of the classicist equilibrium, pre-Baroque, and deforming expressiveness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0880b538-646a-3312-9c07-a0fee5133444",
                                        "entry_id": "4333d455-b30f-3f70-a2b4-a099bfbc0c39",
                                        "glosses": [
                                            "In fine art, a style that is inspired by previous models, aiming to reproduce subjects in an expressive language."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
