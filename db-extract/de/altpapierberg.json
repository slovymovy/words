                ],
                "senses": [
                    {
                        "sense_id": "429db88b-2281-3c4f-a55e-817a84acb516",
                        "entry_id": "a6c8b144-e3af-304f-9c25-300ca9501431",
                        "glosses": [
                            "Anhäufung von Altpapier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ed976fc-200a-49f8-a71c-6da6d5bfe77a",
                                "sense_id": "429db88b-2281-3c4f-a55e-817a84acb516",
                                "text": "„Von den immer grösser werdenden Altpapierbergen in den Trams gar nicht zu reden.“"
                            },
                            {
                                "example_id": "181e3315-5ecb-4331-bccb-3fc4071bcd6d",
                                "sense_id": "429db88b-2281-3c4f-a55e-817a84acb516",
                                "text": "„Erst vor einigen Wochen hatten in dem Gebäude Unrat, Altpapierberge, Matratzen, ehemalige Büroutensilien und sonstiger Sperrmüll gebrannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "46520f4f-5990-363f-9a24-a11a19cda506",
                        "entry_id": "a6c8b144-e3af-304f-9c25-300ca9501431",
                        "glosses": [
                            "große Menge von aus einem bestimmten Grund anfallendem Altpapier"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "36af86e7-252b-43b8-baab-08f5c9569322",
                                "sense_id": "46520f4f-5990-363f-9a24-a11a19cda506",
                                "text": "„Angesichts der riesigen Altpapierberge von bis zu 2000 Tonnen, die sich nach der Euro-Einführung auftürmen werden, haben sich kluge Denker natürlich schon die Köpfe zerbrochen, ob das Papier denn nicht wiederverwertet werden kann.“"
                            },
                            {
                                "example_id": "7128a539-82ba-4e18-b41c-c75784b04f68",
                                "sense_id": "46520f4f-5990-363f-9a24-a11a19cda506",
                                "text": "„Denn der Altpapierberg wird immer höher, der Absatz hingegen immer schwieriger, die Preise fallen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
