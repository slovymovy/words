{
    "word_family": [
        "wigmaker",
        "wigging"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "375b31dc-6068-33a1-a9a4-a32ea7b0ec3b",
                    "sense_definition": "A head of real or synthetic hair worn on the head to disguise baldness, for fashion, or by actors.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hair_covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor wore a <w>wig</w> to look like a historical figure.",
                            "target_lang_translations": {
                                "zh": "那位演员戴着<w>假发</w>，让自己看起来像个历史人物。",
                                "ru": "Актер надел <w>парик</w>, чтобы быть похожим на историческую личность.",
                                "fr": "L'acteur portait une <w>perruque</w> pour ressembler à un personnage historique."
                            }
                        },
                        {
                            "text": "She decided to wear a <w>wig</w> for the costume party.",
                            "target_lang_translations": {
                                "zh": "她决定在化装舞会上戴<w>假发</w>。",
                                "ru": "Она решила надеть <w>парик</w> на костюмированную вечеринку.",
                                "fr": "Elle a décidé de porter une <w>perruque</w> pour la fête costumée."
                            }
                        }
                    ],
                    "synonyms": [
                        "hairpiece",
                        "toupee",
                        "peruke",
                        "periwig"
                    ],
                    "common_phrases": [
                        "wear a wig"
                    ],
                    "target_lang_definitions": {
                        "zh": "戴在头上的真发或人造头发制品，可用于遮掩秃头、时尚打扮或演员表演。",
                        "ru": "Изделие из натуральных или искусственных волос, надеваемое на голову для маскировки облысения, в качестве модного аксессуара или для театрального образа.",
                        "fr": "Coiffure de faux cheveux ou de cheveux naturels que l'on porte sur la tête pour masquer la calvitie, par mode ou au théâtre."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "假发",
                                "target_lang_sense_clarification": "戴在头上的人造或真发制品，用来遮掩秃头、配合造型或表演"
                            },
                            {
                                "target_lang_word": "发套",
                                "target_lang_sense_clarification": "较正式说法，指整件头发饰物"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "парик",
                                "target_lang_sense_clarification": "накладные волосы, имитирующие прическу"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "perruque",
                                "target_lang_sense_clarification": "coiffure de faux cheveux"
                            },
                            {
                                "target_lang_word": "postiche",
                                "target_lang_sense_clarification": "chevelure d'appoint ou fausse chevelure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b94e993-c238-35d3-b0da-b2529a9795f3",
                    "sense_definition": "A person of high rank or importance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person_importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All the big <w>wigs</w> attended the annual board meeting.",
                            "target_lang_translations": {
                                "zh": "所有<w>大人物</w>都出席了年度董事会会议。",
                                "ru": "Все важные <w>шишки</w> присутствовали на ежегодном собрании совета директоров.",
                                "fr": "Tous les <w>gros bonnets</w> ont assisté à la réunion annuelle du conseil d'administration."
                            }
                        },
                        {
                            "text": "The local <w>wigs</w> gathered to discuss the new city policy.",
                            "target_lang_translations": {
                                "zh": "本地的<w>要人</w>聚在一起讨论新的城市政策。",
                                "ru": "Местные <w>авторитеты</w> собрались, чтобы обсудить новую городскую политику.",
                                "fr": "Les <w>sommités</w> locales se sont réunies pour discuter de la nouvelle politique de la ville."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the plural form bigwigs."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "地位高或很重要的人。",
                        "ru": "Человек, занимающий высокое положение или обладающий большим влиянием.",
                        "fr": "Personne de haut rang, influente ou importante."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大人物",
                                "target_lang_sense_clarification": "口语，指有地位或有影响力的人"
                            },
                            {
                                "target_lang_word": "要人",
                                "target_lang_sense_clarification": "较正式，指重要人物"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "шишка",
                                "target_lang_sense_clarification": "разговорное, ироничное обозначение важного лица"
                            },
                            {
                                "target_lang_word": "важная персона",
                                "target_lang_sense_clarification": "официальное или ироничное обозначение влиятельного человека"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "grosse légume",
                                "target_lang_sense_clarification": "familier, personnage influent"
                            },
                            {
                                "target_lang_word": "gros bonnet",
                                "target_lang_sense_clarification": "familier, personnage important"
                            },
                            {
                                "target_lang_word": "sommité",
                                "target_lang_sense_clarification": "personnalité éminente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7aa57df2-c2d5-3273-b3f9-896ef919f3c7",
                    "sense_definition": "An old seal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>wig</w> rested on the rocky shore.",
                            "target_lang_translations": {
                                "zh": "那只上了年纪的<w>海豹</w>趴在多岩石的海岸上休息。",
                                "ru": "Старый <w>тюлень</w> отдыхал на каменистом берегу.",
                                "fr": "Le vieux <w>phoque</w> se reposait sur le rivage rocheux."
                            }
                        },
                        {
                            "text": "Researchers observed a large <w>wig</w> swimming near the ice.",
                            "target_lang_translations": {
                                "zh": "研究人员观察到一只巨大的<w>海豹</w>在冰层附近游泳。",
                                "ru": "Исследователи наблюдали, как большой <w>тюлень</w> плавает рядом со льдами.",
                                "fr": "Les chercheurs ont observé un grand <w>phoque</w> qui nageait près de la glace."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional term for a seal."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "海豹的方言旧称。",
                        "ru": "Устаревшее или диалектное название тюленя.",
                        "fr": "Vieux phoque mâle."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "海豹",
                                "target_lang_sense_clarification": "方言用法，指海豹"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тюлень",
                                "target_lang_sense_clarification": "морское млекопитающее"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "phoque",
                                "target_lang_sense_clarification": "mammifère marin"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b60a87e8-1fda-357d-93ff-318262d2ca11",
                    "sense_definition": "To act in an extremely emotional, erratic, or nervous way.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He started to <w>wig</w> out when he heard the bad news.",
                            "target_lang_translations": {
                                "zh": "他一听到那个坏消息就开始<w>抓狂</w>了。",
                                "ru": "Он начал <w>беситься</w>, когда услышал плохие новости.",
                                "fr": "Il a commencé à <w>péter un plomb</w> en apprenant la mauvaise nouvelle."
                            }
                        },
                        {
                            "text": "Please do not <w>wig</w> out over such a small mistake.",
                            "target_lang_translations": {
                                "zh": "请别为了这么一个小错误就<w>慌神</w>。",
                                "ru": "Пожалуйста, не <w>паникуй</w> из-за такой маленькой ошибки.",
                                "fr": "S'il te plaît, ne <w>panique</w> pas pour une si petite erreur."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wig out"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "表现得极其情绪化、失常或紧张慌乱。",
                        "ru": "Вести себя крайне эмоционально, неадекватно или впадать в панику.",
                        "fr": "Agir de manière extrêmement émotive, nerveuse ou perdre son sang-froid."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抓狂",
                                "target_lang_sense_clarification": "俚语，指情绪失控或突然非常慌乱"
                            },
                            {
                                "target_lang_word": "慌神",
                                "target_lang_sense_clarification": "口语，指因为紧张或激动而乱了方寸"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "беситься",
                                "target_lang_sense_clarification": "проявлять сильное раздражение или неадекватность"
                            },
                            {
                                "target_lang_word": "паниковать",
                                "target_lang_sense_clarification": "впадать в состояние сильной тревоги"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "péter un plomb",
                                "target_lang_sense_clarification": "familier, perdre son calme ou paniquer"
                            },
                            {
                                "target_lang_word": "paniquer",
                                "target_lang_sense_clarification": "être pris de panique"
                            },
                            {
                                "target_lang_word": "pétoche",
                                "target_lang_sense_clarification": "avoir une vive peur ou angoisse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dd38dd3-8df5-32e1-96a4-2b65b5d3c239",
                    "sense_definition": "To reprimand or scold someone severely.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager had to <w>wig</w> the employee for being late.",
                            "target_lang_translations": {
                                "zh": "经理不得不因为那名员工迟到而<w>训斥</w>他。",
                                "ru": "Менеджеру пришлось <w>отчитать</w> сотрудника за опоздание.",
                                "fr": "Le responsable a dû <w>passer un savon à</w> l'employé pour son retard."
                            }
                        },
                        {
                            "text": "She was <w>wigged</w> by her supervisor for the error.",
                            "target_lang_translations": {
                                "zh": "她因为这个错误被主管<w>训斥</w>了。",
                                "ru": "Ее <w>отчитал</w> начальник за допущенную ошибку.",
                                "fr": "Elle s'est fait <w>remonter les bretelles</w> par son supérieur à cause de cette erreur."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Less common in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "严厉地责备或斥责某人。",
                        "ru": "Строго отчитывать или критиковать кого-либо.",
                        "fr": "Réprimander ou sermonner sévèrement quelqu'un."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "训斥",
                                "target_lang_sense_clarification": "严厉责骂或批评某人"
                            },
                            {
                                "target_lang_word": "痛骂",
                                "target_lang_sense_clarification": "口语，狠狠责骂"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отчитывать",
                                "target_lang_sense_clarification": "делать строгий выговор"
                            },
                            {
                                "target_lang_word": "песочить",
                                "target_lang_sense_clarification": "разговорное, сурово критиковать"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "passer un savon",
                                "target_lang_sense_clarification": "familier, réprimander vertement"
                            },
                            {
                                "target_lang_word": "engueuler",
                                "target_lang_sense_clarification": "familier, disputer fortement"
                            },
                            {
                                "target_lang_word": "réprimander",
                                "target_lang_sense_clarification": "blâmer formellement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42437f89-d795-3bd9-9e5a-1c054b8fe309",
                    "sense_definition": "To provide someone with a wig.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hair_covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The makeup artist had to <w>wig</w> the lead actor for the scene.",
                            "target_lang_translations": {
                                "zh": "为了那场戏，化妆师得给主演<w>戴假发</w>。",
                                "ru": "Гримеру пришлось <w>надеть парик</w> на главного актера для этой сцены.",
                                "fr": "Le maquilleur a dû <w>coiffer d'une perruque</w> l'acteur principal pour la scène."
                            }
                        },
                        {
                            "text": "They <w>wigged</w> the performers before they went on stage.",
                            "target_lang_translations": {
                                "zh": "他们在演员上台前给他们<w>戴假发</w>。",
                                "ru": "Они <w>надели парики</w> на артистов перед выходом на сцену.",
                                "fr": "Ils ont <w>perruqué</w> les comédiens avant qu'ils ne montent sur scène."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "给某人配上或戴上假发。",
                        "ru": "Надевать на кого-либо парик или обеспечивать кого-либо париком.",
                        "fr": "Pourvoir quelqu'un d'une perruque ou lui en faire porter une."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "戴假发",
                                "target_lang_sense_clarification": "给某人戴上假发"
                            },
                            {
                                "target_lang_word": "给…配假发",
                                "target_lang_sense_clarification": "使某人配上假发造型"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "надевать парик",
                                "target_lang_sense_clarification": "процесс помещения парика на голову"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "perruquer",
                                "target_lang_sense_clarification": "coiffer d'une perruque"
                            },
                            {
                                "target_lang_word": "coiffer d'une perruque",
                                "target_lang_sense_clarification": "mettre une perruque à quelqu'un"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "301eaa6e-f916-3726-a3da-3a05eec8edff",
                    "sense_definition": "To shoot someone in the head.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal threatened to <w>wig</w> the witness.",
                            "target_lang_translations": {
                                "zh": "那个罪犯威胁要<w>爆头</w>那名证人。",
                                "ru": "Преступник угрожал <w>выстрелить в голову</w> свидетелю.",
                                "fr": "Le criminel a menacé de <w>tirer une balle dans la tête</w> du témoin."
                            }
                        },
                        {
                            "text": "He was <w>wigged</w> during the confrontation.",
                            "target_lang_translations": {
                                "zh": "他在对峙过程中被<w>爆头</w>了。",
                                "ru": "Ему <w>выстрелили в голову</w> во время столкновения.",
                                "fr": "Il a reçu <w>une balle dans la tête</w> pendant l'affrontement."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Criminal or street slang."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "朝某人的头部开枪。",
                        "ru": "Выстрелить кому-либо в голову.",
                        "fr": "Tirer une balle dans la tête de quelqu'un."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "爆头",
                                "target_lang_sense_clarification": "俚语，指朝某人头部开枪"
                            },
                            {
                                "target_lang_word": "朝头部开枪",
                                "target_lang_sense_clarification": "较直白说法，指击中头部"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "выстрелить в голову",
                                "target_lang_sense_clarification": "прямое описание действия"
                            },
                            {
                                "target_lang_word": "снять скальп",
                                "target_lang_sense_clarification": "сленговое, метафорическое обозначение выстрела в голову"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "tirer une balle dans la tête",
                                "target_lang_sense_clarification": "abattre d'un tir à la tête"
                            },
                            {
                                "target_lang_word": "loger une balle dans la tête",
                                "target_lang_sense_clarification": "argot criminel"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e74e0a82-0ec9-3fb5-891a-a14535589d78",
                    "sense_definition": "Initialism of wing-in-ground effect.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new vessel uses <w>wig</w> technology to fly above water.",
                            "target_lang_translations": {
                                "zh": "这艘新型船只使用<w>地效应</w>技术在水面上方飞行。",
                                "ru": "Новое судно использует технологию <w>экранного эффекта</w>, чтобы летать над водой.",
                                "fr": "Le nouveau navire utilise la technologie <w>à effet de sol</w> pour voler au-dessus de l'eau."
                            }
                        },
                        {
                            "text": "Engineers are testing the <w>wig</w> design for efficiency.",
                            "target_lang_translations": {
                                "zh": "工程师们正在测试这种<w>地效应</w>设计的效率。",
                                "ru": "Инженеры тестируют эффективность конструкции с <w>экранным эффектом</w>.",
                                "fr": "Les ingénieurs testent l'efficacité de la conception <w>à effet de sol</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wing-in-ground-effect",
                        "wing in ground-effect",
                        "wing-in-ground effect",
                        "wing in surface effect",
                        "WISE",
                        "wing-in-surface-effect",
                        "wing in surface-effect",
                        "wing-in-surface effect"
                    ],
                    "target_lang_definitions": {
                        "zh": "“wing-in-ground effect”的首字母缩略形式，指地面效应。",
                        "ru": "Аббревиатура для эффекта близости крыла к экрану (земле или воде).",
                        "fr": "Relatif à l'effet de sol (acronyme de wing-in-ground effect)."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "地效应",
                                "target_lang_sense_clarification": "指贴近地面或水面飞行所利用的空气动力效应"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "экранный эффект",
                                "target_lang_sense_clarification": "аэродинамический эффект при полете вблизи поверхности"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "à effet de sol",
                                "target_lang_sense_clarification": "technologie aéronautique / maritime"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "f6f01f5f-aeb2-3225-bc0b-406588fff2df",
                    "sense_definition": "An expression of shock.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
