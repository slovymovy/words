                    {
                        "sense_id": "fd9d6e64-c744-365a-b2b6-8d1621ced829",
                        "entry_id": "6cdb0d80-1798-3499-b041-4f0a24db49a2",
                        "glosses": [
                            "vor allem in Mittel- und Südeuropa vorkommender Schmetterling aus der Familie der Zahnspinner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24640232-e19b-42f8-8038-01ce91620342",
                                "sense_id": "fd9d6e64-c744-365a-b2b6-8d1621ced829",
                                "text": "„Nordrhein-Westfalen wird von Gespinstmotten heimgesucht, Brandenburg leidet unter dem Eichenprozessionsspinner, der Maikäfer dringt nach Norden vor.“"
                            },
                            {
                                "example_id": "dab2b2f7-30bf-4252-98c0-3377dba7f3fc",
                                "sense_id": "fd9d6e64-c744-365a-b2b6-8d1621ced829",
                                "text": "„Besteht im Zusammenhang mit dem Auftreten des Eichenprozessionsspinners eine die Gesundheit von Menschen unmittelbar bedrohende Gefahr, hat der Magistrat ohne vorausgegangenes Verfahren auf Kosten der Eigentümer (Miteigentümer) der Liegenschaften, von denen die Gefahr ausgeht, die zur Beseitigung der Gefahr erforderlichen angemessenen und geeigneten Maßnahmen zu setzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
