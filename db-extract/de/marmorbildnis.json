                "senses": [
                    {
                        "sense_id": "19571230-fb11-3b78-a320-a8e9fecfbcab",
                        "entry_id": "33abcb45-e7e0-3553-8874-77943c3111e1",
                        "glosses": [
                            "bildliche Darstellung einer Person, hergestellt aus Marmor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93e48eda-6111-4c2e-bb79-c7ab14b0430f",
                                "sense_id": "19571230-fb11-3b78-a320-a8e9fecfbcab",
                                "text": "„Da die Lovatelli und die Torlonia befreundet sind, erbot sich Graf Filippo, die Herzogin zu porträtieren und schuf auch in der Tat, nach häufigen Sitzungen, wie es heißt, ein schönes Marmorbildnis von ihr, das allgemein Anerkennung fand.“"
                            },
                            {
                                "example_id": "47de9268-dbdf-4c6b-9f15-5344b62bea8a",
                                "sense_id": "19571230-fb11-3b78-a320-a8e9fecfbcab",
                                "text": "„Aus dem hessischen Schloss Erbach (Odenwald) wurde das Marmorbildnis Alexanders des Großen für die Ausstellung entliehen, das als bedeutendste und am besten erhaltene Version des frühesten offiziellen Bildnistyps Alexanders des Großen gilt.“"
                            },
                            {
                                "example_id": "8395f485-75d1-41eb-9612-cc6209f0662f",
                                "sense_id": "19571230-fb11-3b78-a320-a8e9fecfbcab",
                                "text": "„Das Marmorbildnis Marias, die den Leichnam ihres Sohnes Jesus auf dem Schoß trägt, wurde zum Symbol der Trauer schlechthin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
