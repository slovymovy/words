            {
                "entry_id": "e7e7dff0-e021-33a7-8e86-0dd1a32ab1b8",
                "word": "cruchon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fd6043c6-6ddf-4991-8286-d6bf21a97506",
                        "entry_id": "e7e7dff0-e021-33a7-8e86-0dd1a32ab1b8",
                        "tags": [
                            "plural"
                        ],
                        "form": "cruchons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "96ba8a4d-adfc-3579-87d5-e7892ab8f6cf",
                        "entry_id": "e7e7dff0-e021-33a7-8e86-0dd1a32ab1b8",
                        "glosses": [
                            "Petite cruche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "771d2cbc-76a0-4367-9862-c093ebbc1efd",
                                "sense_id": "96ba8a4d-adfc-3579-87d5-e7892ab8f6cf",
                                "text": "Quand l’amant de la jeune femme eut constaté le ravage apporté par le Magyar au système pileux de sa bien-aimée, il bondit sur le coupable, lui cassa un cruchon de kummel sur le crâne et le fit passer à coups de poing au travers de la fenêtre du rez-de-chaussée…"
                            },
                            {
                                "example_id": "b817ca31-0847-4d54-b263-a382ab60d642",
                                "sense_id": "96ba8a4d-adfc-3579-87d5-e7892ab8f6cf",
                                "text": "Le dimanche nous avions chacun un cruchon de bière fraîche ; je connus ce que c’est que la bière fraîche."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ffbea04-1115-3cd7-905e-de04670bc701",
                        "entry_id": "e7e7dff0-e021-33a7-8e86-0dd1a32ab1b8",
                        "glosses": [
                            "Personne peu intelligente ou peu cultivée."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "e215cd1a-d69b-429f-bbfb-91aa22c629f2",
                                "sense_id": "4ffbea04-1115-3cd7-905e-de04670bc701",
                                "text": "— Qu’on est malheureux d’avoir toujours ce vieux cruchon sur le dos !"
                            },
                            {
                                "example_id": "23dae864-a508-4f6f-a8a3-f942a16ae6be",
                                "sense_id": "4ffbea04-1115-3cd7-905e-de04670bc701",
                                "text": "Réponse: ils passent pour des cruchons, s’en rendent compte, et ils cessent de poser des questions."
                            }
                        ]
                    }
                ],
