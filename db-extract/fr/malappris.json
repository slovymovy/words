                "senses": [
                    {
                        "sense_id": "53ad094c-ffb6-3d2e-a3b5-79548c404434",
                        "entry_id": "740197b3-4013-3222-bfa6-8381187e99da",
                        "glosses": [
                            "Personne qui est mal élevée, qui manque d’éducation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a2bf6b8-200b-4a34-baa3-7509bb9fc8c0",
                                "sense_id": "53ad094c-ffb6-3d2e-a3b5-79548c404434",
                                "text": "Ce garçon est un malappris."
                            },
                            {
                                "example_id": "eceee815-539f-4179-919b-9854a626da46",
                                "sense_id": "53ad094c-ffb6-3d2e-a3b5-79548c404434",
                                "text": "Vous qui êtes allée en France, à la cour et dans tant d’endroits recherchés, vous pouvez à coup sûr reconnaître un malappris sur l’instant, je suppose."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1885fbb9-fac8-4456-b0b2-689ec4ad66be",
                        "source_entry_id": "740197b3-4013-3222-bfa6-8381187e99da",
                        "source_sense_id": "53ad094c-ffb6-3d2e-a3b5-79548c404434",
                        "target_lang_word": "flegelhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flegelhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ffa8f7b-7b1d-37d6-b32a-b41f8855a255",
                                        "entry_id": "2d034713-02c0-3cee-8293-15cfea9f71e3",
                                        "glosses": [
                                            "in der Art eines Flegels, wie ein Flegel; sich schlecht oder unhöflich benehmend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "120f93fe-9fe1-4a02-9301-0061bc266ec5",
                                                "sense_id": "1ffa8f7b-7b1d-37d6-b32a-b41f8855a255",
                                                "text": "Die Jungen legen heute wieder ein besonders flegelhaftes Verhalten an den Tag."
                                            },
                                            {
                                                "example_id": "8ea9db5e-f1b9-4eaf-800e-5925587a5ad5",
                                                "sense_id": "1ffa8f7b-7b1d-37d6-b32a-b41f8855a255",
                                                "text": "„Um ernsthaft zu sprechen, sind die Leute so flegelhaft und verbohrt geworden, dass sie eine gewisse Mäßigung gar nicht mehr vertragen können.“"
                                            },
                                            {
                                                "example_id": "45ba1718-f1f0-4d0f-aeff-c6882859256f",
                                                "sense_id": "1ffa8f7b-7b1d-37d6-b32a-b41f8855a255",
                                                "text": "„Ich hoffe nur, Sie benehmen sich gegenüber Kunden nicht so flegelhaft wie gegenüber Arbeitskollegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
