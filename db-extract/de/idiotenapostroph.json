                        "glosses": [
                            "ein regelwidriger, idiotisch gesetzter Apostroph"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2545f611-2909-4e4b-9a25-380a00e1919b",
                                "sense_id": "0cbf7cb8-83dd-39ac-814d-e5bff3dedaba",
                                "text": "Immer häufiger sieht man Idiotenapostrophe in der Schriftlandschaft."
                            }
