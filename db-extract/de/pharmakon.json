                                            {
                                                "example_id": "69a712c1-1f6f-4b14-bc06-a030e8c1f89b",
                                                "sense_id": "b385addc-4c23-3420-8dee-969ba836c934",
                                                "text": "The company specializes in pharmaceutical research."
                                            },
                                            {
                                                "example_id": "e21b590f-9762-4511-ae2c-39c5f1b2ed44",
                                                "sense_id": "b385addc-4c23-3420-8dee-969ba836c934",
