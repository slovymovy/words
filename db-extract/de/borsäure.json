                    {
                        "translation_id": "0c8fee82-affe-4ac2-aa0a-452ce9fc4053",
                        "source_entry_id": "b68e0bda-22b1-3e35-8e7c-0130ec563b95",
                        "source_sense_id": "8338fc04-d47d-3d92-9028-fe4d2f55d708",
