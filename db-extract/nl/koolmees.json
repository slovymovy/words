                                        "sense_id": "0bc51a82-587f-3186-88bb-21be1bffb5f1",
                                        "entry_id": "36c3b0da-1d53-389a-aa9c-cf80c94b36a4",
                                        "glosses": [
                                            "Espèce de petit oiseau passereau d'Eurasie et d’Afrique du Nord, mésange à la calotte noire, aux joues blanches, au dos verdâtre, et avec une bande noire le long de la poitrine et du ventre jaunes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3a8e0be-2e11-4b28-bdf6-f199d5b51d02",
                                                "sense_id": "0bc51a82-587f-3186-88bb-21be1bffb5f1",
                                                "text": "Si seulement il pouvait se lever, ou appeler quelqu’un, il chercherait dans le Peterson la description exacte de la mésange charbonnière."
                                            },
                                            {
                                                "example_id": "66a0521f-3e31-46b0-a134-7df1e9122caf",
                                                "sense_id": "0bc51a82-587f-3186-88bb-21be1bffb5f1",
                                                "text": "Les mésanges charbonnières occupent de préférence les nichoirs suspendus à des troncs épais au trou de vol orienté vers les branches touffues d’un arbre voisin."
                                            },
                                            {
                                                "example_id": "2f16b246-e735-4fb1-aedd-cafbabed5bbc",
                                                "sense_id": "0bc51a82-587f-3186-88bb-21be1bffb5f1",
                                                "text": "En 1938 son père, Guy Tabarly, achète le célèbre « Pen Duick » signifiant littéralement petite tête noire, c'est-à-dire mésange charbonnière en breton"
                                            }
                                        ]
                                    }
