                        "translation_id": "1d911923-10ef-47c1-9187-190f652eb220",
                        "source_entry_id": "5a420615-fcb5-3e0a-b76f-7b62b45d96ec",
                        "target_lang_word": "wedge-shaped",
                        "target_lang_code": "en",
