                ],
                "translations": [
                    {
                        "translation_id": "57ba8977-7dd7-488a-bf02-2d8168d2dda4",
                        "source_entry_id": "11285582-5b2a-3157-8a4a-c213a3194153",
                        "source_sense_id": "6add1733-f049-3749-b2c8-44f7cd057d81",
                        "target_lang_word": "punctuality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "punctuality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "015fa66b-32bc-3506-a430-4b0a4bf86182",
                                        "entry_id": "4bdbec27-ccac-349b-ace3-c3fd27c613a1",
                                        "glosses": [
                                            "The state of being punctual"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1fe2066-bfd1-41d3-a64d-718de3559f72",
                                                "sense_id": "015fa66b-32bc-3506-a430-4b0a4bf86182",
                                                "text": "You were punctual to your appointment: punctuality is the first of virtues, and a sign of pretty behaviour in a young man. I foresee that you will succeed!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50b7dfb3-8014-4f45-b674-2787ff8fd048",
                        "source_entry_id": "11285582-5b2a-3157-8a4a-c213a3194153",
                        "source_sense_id": "6add1733-f049-3749-b2c8-44f7cd057d81",
                        "target_lang_word": "ponctualité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ponctualité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08a1094c-6296-305a-be7c-87cec849aee4",
                                        "entry_id": "dd6ca298-288d-36b7-a6cd-fa085e187541",
                                        "glosses": [
                                            "Exactitude à faire certaines choses dans un temps donné, comme on se l’est proposé, ou comme on l’a promis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "162e2ed2-7479-48eb-b56d-e28345b8db5b",
                                                "sense_id": "08a1094c-6296-305a-be7c-87cec849aee4",
                                                "text": "Au marché et à la devanture du bureau des Postes, c’est avec une grande ponctualité et une assiduité jamais démentie que les ’'miskines’' et les alyatimes se donnent rendez-vous."
                                            },
                                            {
                                                "example_id": "cf3d21d5-6e62-4952-b2cf-bcb98ca64931",
                                                "sense_id": "08a1094c-6296-305a-be7c-87cec849aee4",
                                                "text": "On pouvait subodorer que c’était mal barré pour l’équipe de Suisse quand une conférence de presse d’avant-tournoi, la semaine dernière, a commencé avec 35 minutes de retard. Pour le pays de la ponctualité, il s’agissait bien entendu d’un impair considérable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f938b45c-df19-4f60-8283-0e7083df4f18",
                        "source_entry_id": "11285582-5b2a-3157-8a4a-c213a3194153",
                        "source_sense_id": "6add1733-f049-3749-b2c8-44f7cd057d81",
                        "target_lang_word": "puntualidad",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puntualidad",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "d6fabd32-772a-3f2b-b0c8-dba06c7cfecc",
                                        "entry_id": "d140c48f-9e01-3627-96be-49f50f180eed",
                                        "glosses": [
                                            "Calidad o cualidad de puntual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55fff1c6-0da4-46fc-bedf-e2909ef17756",
                                                "sense_id": "d6fabd32-772a-3f2b-b0c8-dba06c7cfecc",
                                                "text": "Cuanto más que, si bien caigo en la cuenta, este vuestro libro no tiene necesidad de ninguna cosa de aquellas que vos decís que le falta, porque todo él es una invectiva contra los libros de caballerías, de quien nunca se acordó Aristóteles, ni dijo nada San Basilio, ni alcanzó Cicerón; ni caen debajo de la cuenta de sus fabulosos disparates las puntualidades de la verdad, ni las observaciones de la astrología; (...)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4671d870-dcb5-32ef-9de4-b09c8037e876",
                                        "entry_id": "d140c48f-9e01-3627-96be-49f50f180eed",
                                        "glosses": [
                                            "Acto de realizar las cosas a su debido tiempo."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58708ac0-13b1-4ec4-a746-2769d37fa600",
                        "source_entry_id": "11285582-5b2a-3157-8a4a-c213a3194153",
                        "source_sense_id": "6add1733-f049-3749-b2c8-44f7cd057d81",
                        "target_lang_word": "Pünktlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pünktlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf18c35e-8f65-3527-b175-f97b7fc492b9",
                                        "entry_id": "e8110ae6-82b1-3c6d-8147-4966f7ba1926",
                                        "glosses": [
                                            "genaue Einhaltung eines festgesetzten Termins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a16ffd42-c834-48ab-b173-5e22b5e4afb7",
                                                "sense_id": "bf18c35e-8f65-3527-b175-f97b7fc492b9",
                                                "text": "Unser Chef legt besonderen Wert auf Pünktlichkeit."
                                            },
                                            {
                                                "example_id": "ece400c1-9d18-46a6-8d00-65918fed13d5",
                                                "sense_id": "bf18c35e-8f65-3527-b175-f97b7fc492b9",
                                                "text": "Auf die Pünktlichkeit der Bahn würde ich mich lieber nicht verlassen."
                                            },
                                            {
                                                "example_id": "89e9c58b-554a-4a70-8110-ef45c7cbe2f4",
                                                "sense_id": "bf18c35e-8f65-3527-b175-f97b7fc492b9",
                                                "text": "„Dass die »Orientalen« ein Problem mit der Pünktlichkeit haben, ist leider alles andere als ein Vorurteil.“"
                                            },
                                            {
                                                "example_id": "64fa3229-d030-41b1-b9c5-e925f8967bbd",
                                                "sense_id": "bf18c35e-8f65-3527-b175-f97b7fc492b9",
                                                "text": "„Sehr genau mit der Pünktlichkeit nahm er es nie, doch nach einer Viertelstunde machte Clas sich auf ins Lehrerzimmer.“"
                                            },
                                            {
                                                "example_id": "45ae38a2-6fc2-405a-888c-4ff2a784ab9f",
                                                "sense_id": "bf18c35e-8f65-3527-b175-f97b7fc492b9",
                                                "text": "„Gerade bei Langstreckenzügen machen die Kunden häufig die Erfahrung, dass die Pünktlichkeit doch sehr zu wünschen übrig lässt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
