                    "frequency": "High",
                    "semantic_group_id": "fonctionnement_technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette porte vitrée s'ouvre <w>automatiquement</w> quand quelqu'un s'approche de l'entrée."
                        },
                        {
                            "text": "Le logiciel sauvegarde <w>automatiquement</w> tous vos documents importants chaque soir."
                        }
                    ],
                    "common_phrases": [
                        "s'ouvrir automatiquement",
                        "se fermer automatiquement",
                        "généré automatiquement"
