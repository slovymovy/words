{
    "word_family": [
        "suffocation",
        "suffocant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "66fa1ae3-e07d-3da2-bab6-78189cb88a0f",
                    "sense_definition": "Avoir du mal à respirer ou manquer d'air.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ouvre vite la fenêtre de la chambre car nous <w>suffoquons</w> avec cette chaleur."
                        },
                        {
                            "text": "Le coureur a dû s'arrêter immédiatement parce qu'il <w>suffoquait</w> après cette montée."
                        }
                    ],
                    "synonyms": [
                        "étouffer",
                        "asphyxier"
                    ],
                    "antonyms": [
                        "respirer"
                    ],
                    "common_phrases": [
                        "suffoquer de chaleur"
                    ]
                },
                {
                    "sense_id": "3571977d-9c79-31d6-bc57-09efea362d7a",
                    "sense_definition": "Gêner ou bloquer la respiration de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'épaisse fumée noire de l'incendie <w>suffoquait</w> les habitants réfugiés sur le balcon."
                        },
                        {
                            "text": "Cette odeur chimique très forte risque de <w>suffoquer</w> les ouvriers sans masque."
                        }
                    ],
                    "synonyms": [
                        "étouffer",
                        "asphyxier",
                        "oppresser"
                    ],
                    "common_phrases": [
                        "suffoquer quelqu'un"
                    ]
                },
                {
                    "sense_id": "0c890119-3134-3904-9d69-abdb4f251139",
                    "sense_definition": "Provoquer une vive indignation ou une immense surprise qui laisse sans voix.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une telle insolence devant toute la famille a totalement <w>suffoqué</w> les invités."
                        },
                        {
                            "text": "L'aplomb incroyable de l'accusé face aux juges a <w>suffoqué</w> toute l'assistance."
                        }
                    ],
                    "synonyms": [
                        "scandaliser",
                        "sidérer",
                        "abasourdir"
                    ],
                    "common_phrases": [
                        "suffoquer d'indignation",
                        "suffoquer de colère"
                    ]
                },
                {
                    "sense_id": "8ba5aa23-e0be-3366-a672-b5acaed8425b",
                    "sense_definition": "Faire périr par manque d'air ou obstruction des voies respiratoires.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les gaz toxiques dégagés dans la mine ont <w>suffoqué</w> plusieurs animaux."
                        },
                        {
                            "text": "Le piège s'est refermé brutalement et a fini par <w>suffoquer</w> la proie."
                        }
                    ],
                    "synonyms": [
                        "asphyxier",
                        "étrangler"
                    ]
                }
            ]
        }
    ]
