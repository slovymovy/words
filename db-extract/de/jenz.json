                ],
                "senses": [
                    {
                        "sense_id": "3974753b-5d45-398b-9790-7dcbbe4664ff",
                        "entry_id": "4ec856ab-fbf9-34fb-9361-5903459ec8d9",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad75e957-04e2-418b-ab09-f012ebc61e50",
                                "sense_id": "3974753b-5d45-398b-9790-7dcbbe4664ff",
                                "text": "Frau Jenz ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d9bfa18a-1c35-4887-8245-35b6f5e02b3a",
                                "sense_id": "3974753b-5d45-398b-9790-7dcbbe4664ff",
                                "text": "Herr Jenz wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "858ab19d-c3ca-4d43-b02c-34adc5861c85",
                                "sense_id": "3974753b-5d45-398b-9790-7dcbbe4664ff",
                                "text": "Die Jenzes fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "6c0d0b03-04a8-4db4-bd5f-571b3c4e51d0",
                                "sense_id": "3974753b-5d45-398b-9790-7dcbbe4664ff",
                                "text": "Der Jenz trägt nie die Schals, die die Jenz ihm strickt."
                            },
                            {
                                "example_id": "4be7d9f4-169b-4271-b657-9dcad5eea7e2",
                                "sense_id": "3974753b-5d45-398b-9790-7dcbbe4664ff",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jenz kommt, geht der Herr Jenz.“"
                            },
                            {
                                "example_id": "f1300ab5-dc77-4d65-bf47-24ff0fe16879",
                                "sense_id": "3974753b-5d45-398b-9790-7dcbbe4664ff",
                                "text": "Jenz kommt und geht."
                            },
                            {
                                "example_id": "4a7e8023-7e97-47ae-885d-a8ecae54116e",
                                "sense_id": "3974753b-5d45-398b-9790-7dcbbe4664ff",
                                "text": "Jenzens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
