                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4a856ca2-b73f-46cc-8520-c1cb04cd7733",
                        "entry_id": "0e1c4cb8-4e81-3c2a-997d-d0a0b2b5dd07",
                        "tags": [
                            "plural"
                        ],
                        "form": "gemmaux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db2be2b8-312b-34ce-9d3b-ccef8e005017",
                        "entry_id": "0e1c4cb8-4e81-3c2a-997d-d0a0b2b5dd07",
                        "glosses": [
                            "Lames de verre coloré superposées ou/et juxtaposées et éclairées par transparence, mais sans nervures de plomb à la différence du vitrail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57e9118f-3a39-4832-b867-b6de67ed0d11",
                                "sense_id": "db2be2b8-312b-34ce-9d3b-ccef8e005017",
                                "text": "Dans les années 1950, Cocteau attribua au gemmail le titre de « huitième art »."
                            },
                            {
                                "example_id": "690e44cf-485e-43cd-9863-e5d6554f00e0",
                                "sense_id": "db2be2b8-312b-34ce-9d3b-ccef8e005017",
                                "text": "Un art nouveau est né “Les Gemmaux”."
                            },
                            {
                                "example_id": "eb78bdbc-a6d6-4676-b2e1-43d7a445c255",
                                "sense_id": "db2be2b8-312b-34ce-9d3b-ccef8e005017",
                                "text": "Par rapport aux autres moyens d’expression artistiques, le gemmail trouve toute sa place entre le vitrail et la peinture. https://web.archive.org/web/20100421170708/http://www.carrefourdesarts-lalouvesc.com/p_gemmail.html"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c330c82-ab75-4790-a39d-1ec0fd4e69ca",
                        "source_entry_id": "0e1c4cb8-4e81-3c2a-997d-d0a0b2b5dd07",
                        "source_sense_id": "db2be2b8-312b-34ce-9d3b-ccef8e005017",
                        "target_lang_word": "Buntglasfenster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buntglasfenster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c85b525c-7482-3f81-9c8d-83eb392d2ca2",
                                        "entry_id": "736852ae-f34d-3478-b34b-347ec9122ba7",
                                        "glosses": [
                                            "Fenster aus Buntglas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "243ee158-09dc-49ea-a698-46bc9f8b1bd7",
                                                "sense_id": "c85b525c-7482-3f81-9c8d-83eb392d2ca2",
                                                "text": "„Das Haus hat Vorratskammern und abgeschirmte Schlafveranden und Buntglasfenster am Treppenabsatz.“"
                                            },
                                            {
                                                "example_id": "aa4f8c57-8637-4868-bc77-23c8e0f64639",
                                                "sense_id": "c85b525c-7482-3f81-9c8d-83eb392d2ca2",
                                                "text": "„Am Ende der Galerie, so weit weg, dass sie nur als kleiner schwarzer Umriss vor einem riesigen Buntglasfenster zu sehen ist, steht eine Gestalt.“"
                                            },
                                            {
                                                "example_id": "980e8977-3933-40ad-b755-f4417612ae3c",
                                                "sense_id": "c85b525c-7482-3f81-9c8d-83eb392d2ca2",
                                                "text": "„Ein sanfter Regenbogen aus Grün und Gold schimmerte durch eine ferne Reihe von Buntglasfenstern, und ein Rauchfaden, der sich über einem bröckelnden Schornstein kräuselte, verriet einen einsamen späten Bewohner.“"
                                            },
                                            {
                                                "example_id": "a0d0ccc0-6eae-45ba-8d96-0d667142d297",
                                                "sense_id": "c85b525c-7482-3f81-9c8d-83eb392d2ca2",
                                                "text": "„Als mein Blick auf die hohe, gewölbte Zimmerdecke und die schmalen Buntglasfenster im Zimmer meines Freundes fiel, brach eine Flut unangenehmer Erkenntnisse über mich herein.“"
                                            },
                                            {
                                                "example_id": "f721548c-766f-4cae-81d1-fda0d15345af",
                                                "sense_id": "c85b525c-7482-3f81-9c8d-83eb392d2ca2",
                                                "text": "„Es war auf eine Wand gemalt gewesen, in Orgelmusik getaucht, und wurde nur vom Licht der Buntglasfenster berührt.“"
                                            },
                                            {
                                                "example_id": "4f737346-e72f-4f27-9794-72f9a5ff0c5e",
                                                "sense_id": "c85b525c-7482-3f81-9c8d-83eb392d2ca2",
                                                "text": "„In der Mauer über dem Pult befand sich der einzige echte Schmuck der Kirche, ein Buntglasfenster, das eine Szene aus dem Garten Eden darstellte.“"
                                            },
                                            {
                                                "example_id": "8679efbc-d33a-4d5f-b0ef-11adc3b90c6b",
                                                "sense_id": "c85b525c-7482-3f81-9c8d-83eb392d2ca2",
                                                "text": "„Die hoch aufragenden Buntglasfenster erzitterten.“"
                                            },
                                            {
                                                "example_id": "b83a5e5f-017b-498e-aefb-ca336bd4b00c",
                                                "sense_id": "c85b525c-7482-3f81-9c8d-83eb392d2ca2",
                                                "text": "„Eine transparente Scheibe im Buntglasfenster der Rückwand gestattete ihm ungehinderte Sicht auf den Platz.“"
                                            },
                                            {
                                                "example_id": "aedab9bd-543c-46f4-8aba-09a610688709",
                                                "sense_id": "c85b525c-7482-3f81-9c8d-83eb392d2ca2",
                                                "text": "„Mit dem Griff ihres rosa Bauchtrainers zertrümmerte sie ein Buntglasfenster im gotischen Raucherzimmer und fand dahinter eine Wand, ausgestattet mit künstlichen Lichtquellen, die Tageslicht vortäuschen sollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
