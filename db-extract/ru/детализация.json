                    },
                    {
                        "sense_id": "e6e71f42-5b6a-3aa7-ada0-c092842b372d",
                        "entry_id": "b223d6a7-24cc-3a28-8753-24bd75620ed0",
                        "glosses": [
                            "результат такого действия"
                        ],
                        "tags": [],
