                                "ru": "На результаты квартала <w>сильно</w> повлияли недавние события.",
                                "de": "Die Ergebnisse des Quartals wurden <w>stark</w> von den jüngsten Ereignissen beeinflusst.",
                                "es": "Los resultados del trimestre se vieron <w>fuertemente</w> influidos por los acontecimientos recientes.",
                                "zh": "近期事件<w>大大</w>影响了本季度的业绩。"
                            }
                        }
                    ],
                    "synonyms": [
                        "considérablement",
                        "grandement",
                        "intensément"
                    ],
                    "antonyms": [
                        "légèrement",
                        "peu"
                    ],
                    "common_phrases": [
