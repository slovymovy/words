                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4424f2ac-4144-447c-a928-2ff59011cec1",
                                "sense_id": "7935a05b-8bf2-372d-9985-2aa77fb7c203",
                                "text": "Verhit olie in een wok, voeg zaden toe en laat die open barsten. Voeg uisnippers toe, bak tot glazig, voeg rode peper en ingrediënten toe t/m komijn toe, roerbak 3 min, voeg tomatenpuree toe."
                            },
                            {
                                "example_id": "a9755590-6d40-43a5-b9bf-5b25c7fb3bf0",
                                "sense_id": "7935a05b-8bf2-372d-9985-2aa77fb7c203",
                                "text": "Meng vlees, aardappel- en meiraapblokjes met de uisnippers en breng op smaak net zout en peper."
                            },
                            {
                                "example_id": "735a9989-bd2e-456b-90c9-6f6e95fbac2c",
                                "sense_id": "7935a05b-8bf2-372d-9985-2aa77fb7c203",
                                "text": "Doe dan de uisnippers, suiker, stroop, de in blokjes gesneden peperkoek en het marinadevocht erbij en laat alles op een laag vuur met het deksel op de pan in 2 uur zachtjes gaar stoven. Roer er ten slotte een eetlepel bessengelei door en dien het zoervleisj (zuurvlees) op met friet of met gekookte aardappelen en groente."
                            }
                        ]
                    }
