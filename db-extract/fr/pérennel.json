                ],
                "senses": [
                    {
                        "sense_id": "fd303c25-9153-39b6-b09c-c811a29f6298",
                        "entry_id": "6c54d952-7734-361a-aec9-49da83525191",
                        "glosses": [
                            "Qui dure toute l’année, pérenne."
                        ],
                        "tags": [
                            "literary",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "cc45abbc-bfb4-4c5b-8fb8-dfc9e3b1246e",
                                "sense_id": "fd303c25-9153-39b6-b09c-c811a29f6298",
                                "text": "Et c’est pourquoi, indépendant des saisons, sensible à des influences plus continues et plus subtiles, le pin montre un feuillage pérennel."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c3d7bc2-596d-32ec-9620-8c66bf91cf2a",
                        "entry_id": "6c54d952-7734-361a-aec9-49da83525191",
                        "glosses": [
                            "Éternel, perdurable."
                        ],
                        "tags": [
                            "dated",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "ea29f18a-5278-44c8-94fb-9cdec34a53fc",
                                "sense_id": "6c3d7bc2-596d-32ec-9620-8c66bf91cf2a",
                                "text": "Quand donc le temps, cessant sa fuite, laissera-t-il que cet écoulement se repose ? Formes, formes divines et pérennelles ! qui n’attendez que le repos pour reparaître, oh ! quand, dans quelle nuit, dans quel silence, vous recristalliserez-vous ?"
                            },
                            {
                                "example_id": "6db96c97-8878-4502-84f8-582ad06006ce",
                                "sense_id": "6c3d7bc2-596d-32ec-9620-8c66bf91cf2a",
                                "text": "La joie pérennelle de la terre Tahiti leur pesait"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8de82f46-44b7-4210-9149-691249121672",
                        "source_entry_id": "6c54d952-7734-361a-aec9-49da83525191",
                        "target_lang_word": "perennial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perennial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ba118c1-ef9c-3ac6-aec2-fc113c8f3565",
                                        "entry_id": "05ed3246-5a90-3584-a422-5f1b6101738b",
                                        "glosses": [
                                            "Lasting or remaining active throughout the year, for multiple years, or all the time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2de0c851-3743-4ddf-a12e-f55239d3e830",
                                                "sense_id": "0ba118c1-ef9c-3ac6-aec2-fc113c8f3565",
                                                "text": "a perennial stream"
                                            },
                                            {
                                                "example_id": "ee2332d4-6ae5-4cb7-b4a8-dba994dd0a09",
                                                "sense_id": "0ba118c1-ef9c-3ac6-aec2-fc113c8f3565",
                                                "text": "[W]hat is most admirable is the vast enclosure, and variety of ground, in yᵉ large garden, containing vineyards, cornefields, meadows, groves (whereof one is of perennial greens), and walkes of vast lengthes, so accurately kept and cultivated, that nothing can be more agreeable."
                                            },
                                            {
                                                "example_id": "67367386-8382-47f9-afd5-be090d04ffab",
                                                "sense_id": "0ba118c1-ef9c-3ac6-aec2-fc113c8f3565",
                                                "text": "And there is ſuch a thing as Subterraneous Heat, […] [a]s is manifeſt from the ſmoking of perennial Fountains in froſty VVeather, and VVater dravvn out of Pumps and open VVells."
                                            },
                                            {
                                                "example_id": "f32efd86-88ee-4412-ac39-9cea71b1ffab",
                                                "sense_id": "0ba118c1-ef9c-3ac6-aec2-fc113c8f3565",
                                                "text": "It [the pond] is a clear and deep green well, half a mile long and a mile and three quarters in circumference, and contains about sixty-one and a half acres; a perennial spring in the midst of pine and oak woods, without any visible inlet or outlet except by the clouds and evaporation."
                                            },
                                            {
                                                "example_id": "8ddca763-0fbf-4f2d-812d-d759eafe7348",
                                                "sense_id": "0ba118c1-ef9c-3ac6-aec2-fc113c8f3565",
                                                "text": "That desert's age the gorge may prove, / Piercing profound the mountain bare; / Yet hardly churned out in the groove / By a perennial wear and tear / Of floods; nay, dry it shows within; / But twice a year the waters flow, / Nor then in tide, but dribbling thin: […]"
                                            },
                                            {
                                                "example_id": "aa0882d1-bb3d-4090-bb09-84c3d1d2199c",
                                                "sense_id": "0ba118c1-ef9c-3ac6-aec2-fc113c8f3565",
                                                "text": "These offshore Sonoman mountains likely formed an orogenic (mountainous) barrier to moisture inland, resulting in a mountain-shadow onshore desert punctuated by regional annual and large basin perennial streams draining into a forearc saline sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d826ae2-922c-3201-aed0-343e005828e3",
                                        "entry_id": "05ed3246-5a90-3584-a422-5f1b6101738b",
                                        "glosses": [
                                            "Continuing without cessation or intermission for several years, or for an undetermined or infinite period; neverending or never failing; perpetual, unceasing."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f755abc-2e18-434a-9871-a461146e1227",
                                                "sense_id": "3d826ae2-922c-3201-aed0-343e005828e3",
                                                "text": "His artwork has a perennial beauty."
                                            },
                                            {
                                                "example_id": "a7035ff0-1e00-4f46-a766-df1bac02cfcd",
                                                "sense_id": "3d826ae2-922c-3201-aed0-343e005828e3",
                                                "text": "There, on perennial Adamant deſign'd, / The various Fortunes of your Race you'll find: […]"
                                            },
                                            {
                                                "example_id": "382bebeb-1531-406e-b600-caa12859f3b0",
                                                "sense_id": "3d826ae2-922c-3201-aed0-343e005828e3",
                                                "text": "Good humour may be defined a habit of being pleaſed, a conſtant and perennial ſoftneſs of manner, eaſineſs of approach, and ſuavity of diſpoſition; […]"
                                            },
                                            {
                                                "example_id": "31ea56cb-6b3e-4d0f-ae0f-05e4cf2a0261",
                                                "sense_id": "3d826ae2-922c-3201-aed0-343e005828e3",
                                                "text": "The perennial exiſtence of bodies corporate and their fortunes, are things particularly ſuited to a man who has long views; who meditates deſigns that require time in faſhioning; and which propoſe duration when they are accompliſhed."
                                            },
                                            {
                                                "example_id": "4fb1e0a2-beda-45d6-b816-5d0e7c227fa9",
                                                "sense_id": "3d826ae2-922c-3201-aed0-343e005828e3",
                                                "text": "Has Ireland been governed in a 'wise and loving' manner? A government and guidance of white European men which has issued in perennial hunger of potatoes to the third man extant,—ought to drop a veil over its fact, and walk out of court under conduct of proper officers; saying no word; expecting now of a surety sentence either to change or die."
                                            },
                                            {
                                                "example_id": "4e2d3208-357f-4c8e-8c6d-0b10a7b61370",
                                                "sense_id": "3d826ae2-922c-3201-aed0-343e005828e3",
                                                "text": "She has a large gold eye-glass, has Lady Tippins, to survey the proceedings with. If she had one in each eye, it might keep that other drooping lid up, and look more uniform. But perennial youth is in her artificial flowers, and her list of lovers is full."
                                            },
                                            {
                                                "example_id": "f3b6da28-c5a5-4ff0-aa2f-7219b077635b",
                                                "sense_id": "3d826ae2-922c-3201-aed0-343e005828e3",
                                                "text": "Her name was Liberty! Earth lay before her, / And throbbed unconscious fealty and truth; / Morning and night men hastened to adore her, / And from her eyes Peace drew perennial youth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41283ce6-a9a5-3414-b52f-9c6977b36868",
                                        "entry_id": "05ed3246-5a90-3584-a422-5f1b6101738b",
                                        "glosses": [
                                            "Appearing or recurring again and again; recurrent."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd1c2f35-983b-483e-b9fb-dc3a7c340b74",
                                                "sense_id": "41283ce6-a9a5-3414-b52f-9c6977b36868",
                                                "text": "a perennial candidate in elections"
                                            },
                                            {
                                                "example_id": "f5095335-a335-41da-b286-106afcd7273a",
                                                "sense_id": "41283ce6-a9a5-3414-b52f-9c6977b36868",
                                                "text": "Change is a perennial theme in politics."
                                            },
                                            {
                                                "example_id": "32ac4137-5f07-4ff0-afdb-040153371b6d",
                                                "sense_id": "41283ce6-a9a5-3414-b52f-9c6977b36868",
                                                "text": "Ludgate Hill is not Moirosi’s Mountain, but, after all, is only a gentle ascent of about half an inch in the foot, over a length of about two hundred yards, up which unshod omnibus horses would trot with a full load in any weather. Yet there it must remain, a chief thoroughfare in the heart of London, a perennial cause of complaint, and of fear, disgust, and injury to man and horse."
                                            },
                                            {
                                                "example_id": "00a1876e-b285-4893-bee5-4d0e4639b275",
                                                "sense_id": "41283ce6-a9a5-3414-b52f-9c6977b36868",
                                                "text": "Of all the questions which, throughout the centuries, have escaped from the lips of man, there is none which has been asked with such persistence, none which has possessed interest more perennial, than \"Whence do I come? Whither shall I go?\" Man's origin, man's hereafter, have ever been of intensest interest to man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1b03f1c-f547-3496-84e3-a062db277f04",
                                        "entry_id": "05ed3246-5a90-3584-a422-5f1b6101738b",
                                        "glosses": [
                                            "Appearing or recurring again and again; recurrent.",
                                            "Appearing again each year; annual."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6b8d1e4-d120-3869-9325-a7f75d45cd07",
                                        "entry_id": "05ed3246-5a90-3584-a422-5f1b6101738b",
                                        "glosses": [
                                            "Of a plant: active throughout the year, or having a life cycle of more than two growing seasons."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "perennial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9563aec-e7b0-3a5c-a5f8-340cc18dae27",
                                        "entry_id": "71ec6728-37f8-3bc4-9862-eba9c587ab79",
                                        "glosses": [
                                            "A plant that is active throughout the year, or has a life cycle of more than two growing seasons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c95cbaf-4e5d-416e-bd52-da66a33639fa",
                                                "sense_id": "c9563aec-e7b0-3a5c-a5f8-340cc18dae27",
                                                "text": "One would have supposed from the appearance of the country at the end of the first season after the eruption that practically all plants except the trees and bushes had been destroyed, and that revegetation must be due to new seedlings started on the ash. Such, however, is not the case. Excavation of the root systems of the new plants shows that they are old perennials which have come through the ash from the old soil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a7ddf06-f9a5-3458-906a-8f0b2431218a",
                                        "entry_id": "71ec6728-37f8-3bc4-9862-eba9c587ab79",
                                        "glosses": [
                                            "A thing that lasts forever."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19687702-1e2a-3231-ad63-b45747770824",
                                        "entry_id": "71ec6728-37f8-3bc4-9862-eba9c587ab79",
                                        "glosses": [
                                            "A person or thing (such as a problem) that appears or returns regularly."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ede542f-a1d5-490f-b904-afd015b89ce0",
                                                "sense_id": "19687702-1e2a-3231-ad63-b45747770824",
                                                "text": "Some of the stars on our list are perennials who fill huge venues year after year after year, but there's also a returning superstar on our list of the hottest summer tours of 2019."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
