                        "cross_references": []
                    },
                    {
                        "translation_id": "79c7a330-81df-4ed5-9f61-1f23c523db25",
                        "source_entry_id": "489ff8e4-ca42-3fc7-9a80-0f2acf7a64ae",
                        "source_sense_description": "area of the United States",
                        "target_lang_word": "Mittlerer Westen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mittlerer Westen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c113fc8e-9fc9-32c4-8dcc-b8695da4a63d",
                                        "entry_id": "49cd6c10-7761-3130-b42b-36eb789c94c6",
                                        "glosses": [
                                            "Region der Vereinigten Staaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c51b48e9-77bb-4edd-a1f8-4c476bcd184e",
                                                "sense_id": "c113fc8e-9fc9-32c4-8dcc-b8695da4a63d",
                                                "text": "„Wir fahren durch den Mittleren Westen.“"
                                            },
                                            {
                                                "example_id": "f5e350d7-3ee6-416d-b989-89f92d0bfc85",
                                                "sense_id": "c113fc8e-9fc9-32c4-8dcc-b8695da4a63d",
                                                "text": "„Eine Tenorstimme, angespannt wie ein Drahtseil. Aus dem Mittleren Westen, vielleicht Minnesota.“"
                                            },
                                            {
                                                "example_id": "d27a1339-12ff-42fc-b086-9ef7cb147e13",
                                                "sense_id": "c113fc8e-9fc9-32c4-8dcc-b8695da4a63d",
                                                "text": "„Sein besonderes Interesse galt der Haut der Leiche, die er ablöste, gerbte und sich überzog, wenn er nicht eine Schneiderpuppe oder seine Möbel damit schmückte. Damals hatte er eine Geschlechtsumwandlung ins Auge gefasst - was in den Fünfzigerjahren im Mittleren Westen noch revolutionär war -, und als sich das als undurchführbar erwies, entschloss er sich zu der zweitbesten Möglichkeit, die darin bestand, sich einen Frauenanzug aus echten Frauen anzufertigen.“"
                                            },
                                            {
                                                "example_id": "7e919cf5-df12-495f-90c9-8a4b6866ce4a",
                                                "sense_id": "c113fc8e-9fc9-32c4-8dcc-b8695da4a63d",
                                                "text": "„Das Leben hier verlief anders als im Mittleren Westen.“"
                                            },
                                            {
                                                "example_id": "a1ed70d3-ef88-472b-8c46-dfd45cd3bfef",
                                                "sense_id": "c113fc8e-9fc9-32c4-8dcc-b8695da4a63d",
                                                "text": "„Auf diese Weise belästigen wir in einer Schicht zuerst Leute in Großbritannien, dann im Osten der Vereinigten Staaten, dann im Mittleren Westen, dann an der Westküste usw.“"
                                            },
                                            {
                                                "example_id": "f12d5d50-8468-4468-b06b-0c20a17948f3",
                                                "sense_id": "c113fc8e-9fc9-32c4-8dcc-b8695da4a63d",
                                                "text": "„Ihr Lkw-Fuhrpark verbindet rund um die Uhr und sieben Tage die Woche Los Angeles mit den Städten des Mittleren Westens.“"
                                            },
                                            {
                                                "example_id": "b345ded4-ab2f-4fd1-89d5-f192d5cae109",
                                                "sense_id": "c113fc8e-9fc9-32c4-8dcc-b8695da4a63d",
                                                "text": "„Mit Unterstützung, Ermutigung und Anleitung seiner Mutter, des Genies, und seiner Frau, die nur ein kleines bisschen klüger als die Mutter war, verkaufte Franco den größten Teil seines Immobilienbestands und begann, Einkaufszentren im ganzen Mittleren Westen zu bauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
