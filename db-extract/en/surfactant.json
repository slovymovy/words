                                "target_senses": [
                                    {
                                        "sense_id": "59b79c10-f9cb-3425-8d64-a0f43b49efed",
                                        "entry_id": "d61b6d44-0a9e-32c6-a66f-cb4a710b1ed3",
                                        "glosses": [
                                            "Qui mouille une surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19034479-0782-4a80-abc2-ebe514954ee7",
                                                "sense_id": "59b79c10-f9cb-3425-8d64-a0f43b49efed",
                                                "text": "Dans une bouillie bourguignonne alcaline, le même pouvoir mouillant peut être obtenu avec des quantités de savon variant de 100 à 1,000 grammes de savon par hecto, suivant la vitesse avec laquelle on a versé le carbonate de soude."
                                            },
                                            {
                                                "example_id": "816aab7f-612a-406f-8135-c92fffe4840a",
                                                "sense_id": "59b79c10-f9cb-3425-8d64-a0f43b49efed",
                                                "text": "Lorsque le substrat est une solution aqueuse et le liquide mouillant un alcane, on peut s'affranchir de ce problème en utilisant les propriétés de surface d'un polymère fluoré industriel : le téflon, ou polytétrafluoroéthylène."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mouillant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54e62551-ddfd-3e28-9e08-8da5461c6fa4",
                                        "entry_id": "8cd5a004-0e46-3112-a6c4-1f88a383b9c0",
                                        "glosses": [
                                            "Produit qui augmente la capacité d'une bouillie, d'une solution aqueuse à mouiller la surface sur laquelle on la dépose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb0fc55f-cf89-4095-98a8-90c3ef51df13",
                                                "sense_id": "54e62551-ddfd-3e28-9e08-8da5461c6fa4",
                                                "text": "L'ajout d’huile parafinique ou de mouillant au bentazon, au bromophénoxime et à l’ioxynil diminue la sélectivité de ces produits surtout celle de l’ioxynil et est de ce fait déconseillé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mouillant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d210b48-1fb3-3294-a475-1e3c335dff5a",
                                        "entry_id": "2b0686ff-1c0f-37c4-a222-f4a99f0654a8",
                                        "glosses": [
                                            "Participe présent du verbe mouiller."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
