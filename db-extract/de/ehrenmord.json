                    }
                ],
                "senses": [
                    {
                        "sense_id": "368bfbd1-93b1-31c1-9535-34d27c6ec742",
                        "entry_id": "07cc9b5e-cb5d-39e1-9c16-f34c83e3167e",
                        "glosses": [
                            "vorsätzliche Tötung bzw. Ermordung eines Menschen, durch die – aus der Sicht des Täters – die Ehre einer bestimmten Person oder einer Personengruppe oder des Getöteten vermeintlich wieder hergestellt werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afb35866-1874-48e7-ade8-09227fbcf930",
                                "sense_id": "368bfbd1-93b1-31c1-9535-34d27c6ec742",
                                "text": "Die sogenannten Ehrenmorde schockieren jedesmal die Öffentlichkeit."
                            },
                            {
                                "example_id": "be280f36-5a93-4896-be78-74bdf808ac84",
                                "sense_id": "368bfbd1-93b1-31c1-9535-34d27c6ec742",
                                "text": "„In all diesen Religionsgemeinschaften kommt es immer wieder zu Ehrenmorden, auch unter Christen.“"
                            },
                            {
                                "example_id": "931f875c-b756-4d07-89ee-487ba918a730",
                                "sense_id": "368bfbd1-93b1-31c1-9535-34d27c6ec742",
                                "text": "„Die Ehre wird eben im Zweifel bis zum Ehrenmord verteidigt.“"
                            },
                            {
                                "example_id": "7ac09b93-9200-4e69-a80a-080d2ac33030",
                                "sense_id": "368bfbd1-93b1-31c1-9535-34d27c6ec742",
                                "text": "„Ehrenmord ist das fatale Produkt falsch verstandener Traditionen.“"
                            },
                            {
                                "example_id": "ceb35da9-cd28-47a5-b8f6-497fe9553b6e",
                                "sense_id": "368bfbd1-93b1-31c1-9535-34d27c6ec742",
                                "text": "„2011 wurden offiziell 943 Fälle von Ehrenmorden an Frauen registriert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
