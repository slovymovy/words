{
    "word_family": [
        "drommels"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "b8e1b3dd-8c75-3b90-8c8f-920bbdd3bd7b",
                    "sense_definition": "uitroep van boze verontwaardiging of verbazing",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat <w>drommel</w> spook jij daar midden in de nacht uit?",
                            "target_lang_translations": {
                                "fr": "Que <w>diable</w> fabriques-tu là au beau milieu de la nuit ?"
                            }
                        },
                        {
                            "text": "Waarom heeft hij dat in 's hemelsnaam gedaan, wat <w>drommel</w>!",
                            "target_lang_translations": {
                                "fr": "Pourquoi diable a-t-il fait cela, <w>morbleu</w> !"
                            }
                        }
                    ],
                    "synonyms": [
                        "allemachtig",
                        "morbleu",
                        "drommels",
                        "verduiveld"
                    ],
                    "common_phrases": [
                        "wat drommel"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "vooral in oudere teksten of uitdrukkingen"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Exclamation d'indignation, de colère ou d'étonnement (vieilli ou littéraire)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "morbleu",
                                "target_lang_sense_clarification": "juron désuet marquant l'indignation ou la surprise"
                            },
                            {
                                "target_lang_word": "diable",
                                "target_lang_sense_clarification": "exclamation d'étonnement ou de dépit"
                            },
                            {
                                "target_lang_word": "que diable",
                                "target_lang_sense_clarification": "dans une question marquant l'incompréhension"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c33f63c3-a813-3a5c-b6c5-70ce2a07e053",
                    "sense_definition": "de duivel of een boze geest",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Loop naar de <w>drommel</w> en laat me met rust!",
                            "target_lang_translations": {
                                "fr": "Va au <w>diable</w> et laisse-moi tranquille !"
                            }
                        },
                        {
                            "text": "Hij vloekte hevig en wenste zijn tegenstander naar de <w>drommel</w>.",
                            "target_lang_translations": {
                                "fr": "Il jura violemment et envoya son adversaire à tous les <w>diables</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "naar de drommel"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verouderde benaming voor de duivel"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Le diable ou un esprit malin (archaïque)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "diable",
                                "target_lang_sense_clarification": "le démon, l'esprit malin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7126efc9-c690-31e3-ac76-c52b917c84e2",
                    "sense_definition": "een beklagenswaardig of meelijwekkend persoon",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arme <w>drommel</w> had al dagen niets meer gegeten.",
                            "target_lang_translations": {
                                "fr": "Le pauvre <w>diable</w> n'avait rien mangé depuis des jours."
                            }
                        },
                        {
                            "text": "Niemand keek om naar die eenzame <w>drommel</w> op straat.",
                            "target_lang_translations": {
                                "fr": "Personne ne prêtait attention à ce pauvre <w>hère</w> solitaire dans la rue."
                            }
                        }
                    ],
                    "synonyms": [
                        "sukkelaar",
                        "stakker",
                        "stumper"
                    ],
                    "common_phrases": [
                        "arme drommel"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "weinig gebruikelijk in modern Nederlands"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne pitoyable, digne de compassion (vieilli)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "bougre",
                                "target_lang_sense_clarification": "notamment dans 'pauvre bougre'"
                            },
                            {
                                "target_lang_word": "diable",
                                "target_lang_sense_clarification": "dans l'expression 'pauvre diable'"
                            },
                            {
                                "target_lang_word": "hère",
                                "target_lang_sense_clarification": "littéraire, homme misérable ou sans ressources"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}