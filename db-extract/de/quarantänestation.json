                        "entry_id": "1d3ad55b-d4a8-3c06-b46f-9ffed8416149",
                        "glosses": [
                            "medizinische Einrichtung zur zeitweiligen Isolierung von Personen oder Tieren, wenn befürchtet wird, dass diese eine Infektionskrankheit übertragen könnten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3403b66f-2ce3-4c9f-8330-13abc45f8cf8",
                                "sense_id": "4756d621-c7f0-3353-a969-f2641ad3facf",
                                "text": "„Wegen einer möglichen Infektion wurde ein Patient in der baskischen Wirtschaftsmetropole in Bilbao in die Quarantänestation eines Krankenhauses gebracht.“"
                            },
                            {
                                "example_id": "314446a0-a255-4cad-afbf-c87b8af62e11",
                                "sense_id": "4756d621-c7f0-3353-a969-f2641ad3facf",
                                "text": "„Wer Krankheitssymptome hatte, musste auf die Quarantänestation.“"
                            }
                        ],
