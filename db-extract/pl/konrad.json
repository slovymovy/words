                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b047b5c6-2f74-4d57-a2e0-1ca5cb94aca9",
                        "source_entry_id": "1693a46f-9a18-37e4-8e5a-283ca1064c6a",
                        "source_sense_id": "293ff685-0356-3826-9140-bb07996c4ffd",
                        "target_lang_word": "Conrad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Conrad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01ad9130-af29-34b5-b41e-139eea1c84b3",
                                        "entry_id": "4765d018-e584-3c44-bab0-4f8a0a0d663b",
                                        "glosses": [
                                            "A male given name from the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a32b108b-2d75-4650-b107-7f5dce9bfa1c",
                                                "sense_id": "01ad9130-af29-34b5-b41e-139eea1c84b3",
                                                "text": "There was no further need for words, because the lexicon of Romance jargon has just been fully deployed. In it chaps are called names like Conrad, and girls names like Delora, quite unlike the names of those who are reading it on the way to work."
                                            },
                                            {
                                                "example_id": "3da14f6b-a74f-43ef-9f8c-15ee0e18a876",
                                                "sense_id": "01ad9130-af29-34b5-b41e-139eea1c84b3",
                                                "text": "Career diplomat Conrad Tribble said on Twitter that multiculturalism “is one of our greatest strengths as a country, and I go to that well often as an American diplomat. It’s hard to overstate the global soft power impact of America’s cultural diversity.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cda5989-fbe8-3123-bf70-95b29e7ba3cb",
                                        "entry_id": "4765d018-e584-3c44-bab0-4f8a0a0d663b",
                                        "glosses": [
                                            "A surname."
                                        ],
