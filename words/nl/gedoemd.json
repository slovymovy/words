                    "frequency": "Middle",
                    "semantic_group_id": "noodlot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het project was vanaf het begin <w>gedoemd</w> om te mislukken door een gebrek aan geld.",
                            "target_lang_translations": {
                                "fr": "Le projet était <w>voué</w> à l'échec dès le début par manque d'argent."
                            }
                        },
                        {
                            "text": "Zij voelde zich <w>gedoemd</w> tot een leven in eenzaamheid na het vertrek van haar familie.",
                            "target_lang_translations": {
                                "fr": "Elle se sentait <w>condamnée</w> à une vie de solitude après le départ de sa famille."
