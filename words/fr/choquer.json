{
    "word_family": [
        "choc",
        "choquant",
        "entrechoquer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5e615533-905e-32e1-8f78-e84ea9787585",
                    "sense_definition": "Blesser moralement, offenser ou scandaliser quelqu'un par ses paroles ou ses actes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses propos méprisants risquent de choquer l'opinion publique lors de cette conférence."
                        },
                        {
                            "text": "Elle craignait de <w>choquer</w> sa famille en refusant de suivre cette tradition."
                        }
                    ],
                    "synonyms": [
                        "scandaliser",
                        "outrer",
                        "indigner"
                    ],
                    "common_phrases": [
                        "choquer l'opinion",
                        "choquer les esprits"
                    ]
                },
                {
                    "sense_id": "62c3ca0f-3ca2-3027-854a-fddb66086fbc",
                    "sense_definition": "Frapper vivement par un effet d'effroi ou d'extrême surprise, provoquer une commotion morale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La violence de cette nouvelle tragique est venue <w>choquer</w> profondément les habitants du village."
                        },
                        {
                            "text": "Cette scène d'accident a tellement <w>choqué</w> les témoins qu'ils sont restés sans voix."
                        }
                    ],
                    "synonyms": [
                        "stupéfier",
                        "abasourdir",
                        "atterrer"
                    ],
                    "common_phrases": [
                        "choquer profondément"
                    ]
                },
                {
                    "sense_id": "cb7f1183-d8e0-3078-a8de-9b188327401e",
                    "sense_definition": "Donner un choc physique, heurter ou faire entrer en collision.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les convives aiment choquer les verres avec entrain avant de boire leur vin."
                        },
                        {
                            "text": "Le conducteur a perdu le contrôle du véhicule avant de <w>choquer</w> la barrière de sécurité."
                        }
                    ],
                    "common_phrases": [
                        "choquer les verres"
                    ]
                },
                {
                    "sense_id": "f4cf5e39-e903-3e6e-b717-3295a361adce",
                    "sense_definition": "Contrevenir à quelque chose, aller à l'encontre de la raison, de la morale ou des usages.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une telle décision financière semble choquer le bon sens le plus élémentaire des investisseurs."
                        },
                        {
                            "text": "Ce comportement égoïste <w>choque</w> la bienséance lors des réceptions officielles."
                        }
                    ],
                    "common_phrases": [
                        "choquer le bon sens"
                    ]
                },
                {
                    "sense_id": "35f5c475-4677-36a7-bc29-98d2a3e713a7",
                    "sense_definition": "Donner du mou à une corde ou relâcher la tension d'une manœuvre.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le skipper a immédiatement ordonné de choquer l'écoute pour soulager le mât fragilisé."
                        },
                        {
                            "text": "Quand le vent se lève brutalement, le marin doit <w>choquer</w> la voile rapidement."
                        }
                    ],
                    "antonyms": [
                        "border"
                    ],
                    "common_phrases": [
                        "choquer l'écoute"
                    ]
                }
            ]
        }
    ]
}