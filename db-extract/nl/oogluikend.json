                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb5235d7-17d4-4a18-bc2f-d67a8751f5b2",
                                "sense_id": "67748be1-b298-37b9-987b-b8db5fb7983f",
                                "text": "Daarnaast worden wat mij betreft per direct de vergunningen ingetrokken voor festivals die geen goed preventiebeleid hebben voor het gebruik van xtc-pillen. Zolang we die troep oogluikend toestaan, is het dweilen met de kraan open."
                            },
                            {
                                "example_id": "68d83a0f-3159-4706-a2e7-658b62f0ab4e",
                                "sense_id": "67748be1-b298-37b9-987b-b8db5fb7983f",
                                "text": "Winkeliers buiten het centrum mogen net als hun collega's in de binnenstad maar twee zondagen per maand geopend zijn. Daarmee is een einde gekomen aan het gedoogbeleid dat sinds 2013 bestaat en waarin de gemeente oogluikend toestond dat veel winkels buiten het centrum elke zondag open waren."
                            }
                        ]
                    }
