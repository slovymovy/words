                        "entry_id": "437ad7a6-364c-38fd-b865-d5b5ce4efcf5",
                        "glosses": [
                            "Truppenverband, in dem mehrere Großverbände zusammengefasst sind"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "26b5f198-a1c0-4ecf-b46f-0f034a17e977",
                                "sense_id": "a2bd624f-67fc-33f2-b0c7-9f5f3dc1d03b",
                                "text": "„Auch Stalin grollte im Kreml. Denn ihm paßte die Kapitulation der deutschen Heeresgruppe in Italien überhaupt nicht in seine strategischen Überlegungen.“"
                            },
                            {
                                "example_id": "7a423982-3752-4c77-954b-e4e5254c7434",
                                "sense_id": "a2bd624f-67fc-33f2-b0c7-9f5f3dc1d03b",
                                "text": "„Frankreich hatte kapituliert, nachdem starke Panzerverbände der deutschen Heeresgruppe B die französische Verteidigungslinie von Somme und Aisne durchbrochen hatten.“"
                            }
                        ],
