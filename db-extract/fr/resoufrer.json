                "senses": [
                    {
                        "sense_id": "dd1ffda9-ef83-3798-b6d3-2956a96112e1",
                        "entry_id": "e4ac0f77-015f-301b-8448-225dbc2283eb",
                        "glosses": [
                            "Soufrer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e7bc934-c0f2-4f84-b71c-2f4163e633f5",
                                "sense_id": "dd1ffda9-ef83-3798-b6d3-2956a96112e1",
                                "text": "Ils dépendent du temps, le mildiou menace la vigne, et alors il faut sulfater et resulfater, soufrer et resoufrer."
                            },
                            {
                                "example_id": "8abf1301-7c92-4b7d-af7a-8507eafb2e35",
                                "sense_id": "dd1ffda9-ef83-3798-b6d3-2956a96112e1",
                                "text": "(...) abondamment les souches malades par temps chaud et les resoufrer si la maladie continue à s'étendre."
                            }
                        ]
                    }
