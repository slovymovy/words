                "senses": [
                    {
                        "sense_id": "96225a83-fd2f-329b-b268-d7696492df1a",
                        "entry_id": "d7f91e0c-542e-390c-aaa7-cdb820a60cba",
                        "glosses": [
                            "Rendre frivole (une personne ou une chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28ea9392-d22f-4318-bf81-1db7141b1913",
                                "sense_id": "96225a83-fd2f-329b-b268-d7696492df1a",
                                "text": "On parlait d'un bureau de magie et d'incantation, d'une fabrique de poisons terribles que, dans leur manie de tout frivoliser, les Parisiens avaient baptisés du nom de \"poudre de succession\"."
                            },
                            {
                                "example_id": "53f3e937-007a-4844-b65d-1003ca12a4f8",
                                "sense_id": "96225a83-fd2f-329b-b268-d7696492df1a",
                                "text": "Rousseau s'alarme de voir la femme se mondaniser et se frivoliser à outrance, il la ramène rudement à son rôle de ménagère."
                            }
                        ]
                    },
