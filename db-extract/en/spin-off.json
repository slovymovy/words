                                                "sense_id": "44bb475a-2022-38cd-85e9-2cbfa9830c84",
                                                "text": "Unser Ableger muss jetzt endlich seinen Schulabschluss machen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c856cda3-e3f9-342b-9593-3b3a92b17537",
                                        "entry_id": "f2b3247e-761a-3b89-a367-195d927409be",
                                        "glosses": [
