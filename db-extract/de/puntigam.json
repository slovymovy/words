                ],
                "senses": [
                    {
                        "sense_id": "1fd11341-9c91-30d5-8587-34796a6ed2c6",
                        "entry_id": "ab423007-38fe-3545-bdc6-4e96679bc50e",
                        "glosses": [
                            "Familienname, Nachname mit überwiegendem Vorkommen in Österreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d36c48e-c42a-413f-a9ef-f5c64e36e7e5",
                                "sense_id": "1fd11341-9c91-30d5-8587-34796a6ed2c6",
                                "text": "Frau Puntigam ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e1e450fb-5a4c-4042-ad5d-09f0195e4006",
                                "sense_id": "1fd11341-9c91-30d5-8587-34796a6ed2c6",
                                "text": "Herr Puntigam wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fb1e8767-fd13-4779-891c-f4a6b71c7176",
                                "sense_id": "1fd11341-9c91-30d5-8587-34796a6ed2c6",
                                "text": "Die Puntigams fliegen heute nach Tallinn."
                            },
                            {
                                "example_id": "1063c62b-a21f-4a45-ae2a-d37ae31b3aab",
                                "sense_id": "1fd11341-9c91-30d5-8587-34796a6ed2c6",
                                "text": "Der Puntigam trägt nie die Pullover, die die Puntigam ihm strickt."
                            },
                            {
                                "example_id": "64512f8e-c7da-43dd-80e3-cc044de6f664",
                                "sense_id": "1fd11341-9c91-30d5-8587-34796a6ed2c6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Puntigam kommt, geht der Herr Puntigam.“"
                            },
                            {
                                "example_id": "f252e7d0-e9b7-4fcd-b6b6-6aa8b1992f51",
                                "sense_id": "1fd11341-9c91-30d5-8587-34796a6ed2c6",
                                "text": "Puntigam kommt und geht."
                            },
                            {
                                "example_id": "3e19d07f-a90b-4641-a77f-c4f80652b811",
                                "sense_id": "1fd11341-9c91-30d5-8587-34796a6ed2c6",
                                "text": "Puntigams kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
