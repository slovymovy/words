                "senses": [
                    {
                        "sense_id": "6cf540f8-9fec-30d1-b2b1-f2abb8bd379f",
                        "entry_id": "68bc7744-4737-3591-b36e-7319ed836d61",
                        "glosses": [
                            "относящийся ко времени после упразднения советской власти на территории бывшего СССР"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99b916af-3c3d-4c89-8a28-b18f31dc50ab",
                                "sense_id": "6cf540f8-9fec-30d1-b2b1-f2abb8bd379f",
                                "text": "В нашей постсоветской истории было два таких критических момента."
                            },
                            {
                                "example_id": "9b241936-b66a-4312-98e5-bf1f9aedb45d",
                                "sense_id": "6cf540f8-9fec-30d1-b2b1-f2abb8bd379f",
                                "text": "Попытка поставить постсоветскую Россию на правильные рельсы — общеевропейского демократического развития — как известно, провалилась."
                            }
                        ]
                    },
