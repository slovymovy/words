                "senses": [
                    {
                        "sense_id": "57d29468-0669-3023-81cf-a3f2656f0a92",
                        "entry_id": "6950c089-d22d-3bfb-b1f7-8b0125e36bc1",
                        "glosses": [
                            "rotierende elektrische Maschine, die mit Gleichstrom betrieben wird (und somit als Motor arbeitet)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a632c61-ea0e-4346-b029-8aca09461d27",
                                "sense_id": "57d29468-0669-3023-81cf-a3f2656f0a92",
                                "text": "„Die Gleichstrommaschine (GSM) ist ein elektromechanischer Energiewandler.“"
                            },
                            {
                                "example_id": "16b8fc4f-e39d-4ed7-a9ce-985cb3ca1c1f",
                                "sense_id": "57d29468-0669-3023-81cf-a3f2656f0a92",
                                "text": "„Der wesentliche Vorteil der Gleichstrommaschine (GSM) gegenüber der Drehfeldmaschine ist ihre über die Spannungsamplitude veränderbare Betriebsdrehzahl bei gleichbleibendem Moment. Gleichstrommaschinen ermöglichen einen großen Drehzahlbereich.“"
                            },
                            {
                                "example_id": "08439af4-bd70-4b42-ac22-881361f0db72",
                                "sense_id": "57d29468-0669-3023-81cf-a3f2656f0a92",
                                "text": "„Da sich die Drehrichtung einer Gleichstrommaschine nicht ändert, wenn der Erregerfluss und der Strom im Anker gleichzeitig ihre Richtung umkehren, liegt die Vermutung nahe, dass man eine Gleichstrommaschine an Wechselspannung betreiben kann.“"
                            },
                            {
                                "example_id": "49ff6579-2898-4a9c-91ea-ab809316bf15",
                                "sense_id": "57d29468-0669-3023-81cf-a3f2656f0a92",
                                "text": "„Das verlustärmste und dynamisch günstigste Verfahren zur Drehzahlverstellung der Gleichstrommaschine ist die Variation der Ankerspannung.“"
                            },
                            {
                                "example_id": "ee5a74ca-0f48-4466-b641-14bfadef7a94",
                                "sense_id": "57d29468-0669-3023-81cf-a3f2656f0a92",
                                "text": "„Gleichstrommaschinen sind ohne Änderungen im Aufbau für den Motor- oder Generatorbetrieb geeignet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "77f8b528-8615-363d-b52d-6e15c6ee9e3e",
                        "entry_id": "6950c089-d22d-3bfb-b1f7-8b0125e36bc1",
                        "glosses": [
                            "rotierende elektrische Maschine, die Gleichstrom erzeugt (und somit als Generator arbeitet)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "160b2d95-3653-49f8-a171-93e4047a6e84",
                                "sense_id": "77f8b528-8615-363d-b52d-6e15c6ee9e3e",
                                "text": "„Gleichstrommaschinen sind ohne Änderungen im Aufbau für den Motor- oder Generatorbetrieb geeignet.“"
                            },
                            {
                                "example_id": "8fcff8fe-6097-470f-9b86-47389eab548a",
                                "sense_id": "77f8b528-8615-363d-b52d-6e15c6ee9e3e",
                                "text": "„Soll die Gleichstrommaschine als Generator arbeiten (Nutzbremsung) muß der Strom I_A seine Richtung ändern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
