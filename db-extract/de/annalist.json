                                "sense_id": "1f5fbe59-d495-3660-b93b-4e75c5930f5a",
                                "text": "Ein Schweizer Annalist berichtet in diesem Dokument über Vorkommnisse im Aargau in den Jahren 1847 und 1848."
                            },
                            {
                                "example_id": "1e96e1b6-6d83-47ba-a7d2-023b351fdb92",
                                "sense_id": "1f5fbe59-d495-3660-b93b-4e75c5930f5a",
                                "text": "Heidrun beschäftigt sich schon lange mit dem Wirken der römischen Annalisten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
