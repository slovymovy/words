                    {
                        "form_id": "77699d36-75d9-4307-8c28-41e0b3e36603",
                        "entry_id": "25a8c896-9e16-3660-99c4-129411978662",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Obsidiane"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7862a1a1-99b9-3ab3-bfde-0817957d5376",
                        "entry_id": "25a8c896-9e16-3660-99c4-129411978662",
                        "glosses": [
                            "dunkles und glasiges Gestein vulkanischer Herkunft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b090368-8f46-44da-ac1e-6259e2d14e3f",
                                "sense_id": "7862a1a1-99b9-3ab3-bfde-0817957d5376",
                                "text": "„Steinwerkzeuge aus Obsidian und Flint lassen sich unter bestimmten Voraussetzungen aufgrund ihrer Patinaschichten, deren Stärke temperatur- und zeitabhängig ist, datieren.“"
                            },
                            {
                                "example_id": "16f95e55-4249-435c-bc1e-37e48fba3545",
                                "sense_id": "7862a1a1-99b9-3ab3-bfde-0817957d5376",
                                "text": "„Obsidian […] tritt in allen Fundstellen als Schneidewerkzeug, Pfeil- und Speerspitzen auf.“"
                            },
                            {
                                "example_id": "904fd928-4fd1-4be7-8767-c7734b0d517b",
                                "sense_id": "7862a1a1-99b9-3ab3-bfde-0817957d5376",
                                "text": "„Die nötigen Mittel konnten durch den Handel mit Obsidian gewonnen werden, der von allen Völkern für Messer oder Waffen erforderlich war, denn das vulkanische Glas hatte messerscharfe Kanten.“"
                            },
                            {
                                "example_id": "9f52008f-6959-412b-b905-7d8625641064",
                                "sense_id": "7862a1a1-99b9-3ab3-bfde-0817957d5376",
                                "text": "„Der Boden war von plutonischen Kräften geformt, auf Schritt und Tritt traf man auf Basaltbrocken, Bimsstein, erratische Blöcke und Obsidiane.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
