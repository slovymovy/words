                        "entry_id": "739edd09-c375-3771-8c70-656fffe62c4b",
                        "glosses": [
                            "ademhalingsorgaan van vele in water levende dieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a12b26eb-8d13-407d-b18e-bfc06d06c942",
                                "sense_id": "148eb70b-87a8-3d16-8709-5dcb5f5f40e9",
                                "text": "Bij de meeste vissen zijn de kieuwen door kieuwdeksels bedekt, maar bij de larven van kikkers en salamanders zijn ze vaak uitwendig waar te nemen."
                            }
                        ]
                    }
                ],
