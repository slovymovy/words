                        "glosses": [
                            "Nom d’un ulcère qui attaque la peau, ainsi que les tissus mous et l’os du visage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf869274-a2d8-42f2-a2bd-25f375feda11",
                                "sense_id": "6d16b00c-6027-319f-9fea-84737b622d7d",
                                "text": "Le noma consiste en une gangrène, non contagieuse, du visage qui peut se déclencher très rapidement, commençant au niveau de la bouche, puis gagne les lèvres, le nez, les joues et l’os sous-jacent …"
                            }
                        ]
