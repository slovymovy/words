                    },
                    {
                        "translation_id": "c327b66b-fd9a-4e42-8aae-367696f24dc4",
                        "source_entry_id": "5278e636-cbd9-34ba-8a94-837e954645d9",
                        "source_sense_id": "5e710f34-d79f-33ee-850e-560801bdabc3",
                        "target_lang_word": "Haiku",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haiku",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef1eb505-a0ca-35f0-ad16-0e4d05e35823",
                                        "entry_id": "1bc84e06-285f-3c0e-84e6-261ff8554178",
                                        "glosses": [
                                            "Gedichtform aus dem Japanischen, bei der in 3 Zeilen 17 Silben vorkommen, nämlich in der ersten 5, in der zweiten 7, und in der dritten wieder 5"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acfcc317-d67c-47f8-8f46-720d71281218",
                                                "sense_id": "ef1eb505-a0ca-35f0-ad16-0e4d05e35823",
                                                "text": "„Das Kurze ist eine unterschätzte literarische Form und in anderen Kulturen stärker verankert: Hemingways Sechs-Wörter-Geschichte, das Haiku – Texte wie Koffeintabletten!“"
                                            },
                                            {
                                                "example_id": "9134cb52-fcb3-48b3-8cc1-039ce885f0dd",
                                                "sense_id": "ef1eb505-a0ca-35f0-ad16-0e4d05e35823",
                                                "text": "„Haikus schreiben war erholsam wie Kreuzworträtsellösen.“"
                                            },
                                            {
                                                "example_id": "2f8fee51-2a16-4c9a-a493-5d02d74953d6",
                                                "sense_id": "ef1eb505-a0ca-35f0-ad16-0e4d05e35823",
                                                "text": "„Bis zum Morgen fand ich das den großartigsten Satz ever, ein gewiefter Haiku der Spitzenklasse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e737da3c-2ead-439b-9105-ac1533f08b63",
                        "source_entry_id": "5278e636-cbd9-34ba-8a94-837e954645d9",
                        "source_sense_id": "5e710f34-d79f-33ee-850e-560801bdabc3",
                        "target_lang_word": "haiku",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haiku",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b6d01aa-0fca-37f4-9d0c-d2ae6f2d49cb",
                                        "entry_id": "5521b3d5-2a93-3796-850a-a55b9bda01c9",
                                        "glosses": [
                                            "Variante orthographique de haïku."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6648639a-0ffa-415f-af64-431ae259217c",
                                                "sense_id": "8b6d01aa-0fca-37f4-9d0c-d2ae6f2d49cb",
                                                "text": "Il y a un autre de mes écoliers qui a réussi et devant lequel je reste pantois ; celui-là, c’est un pédagogue. À l’époque où il fréquentait l’université, il me demanda un jour de lui enseigner le haiku. Moi qui, par nature, ne déteste pas non plus cette voie, j’allais jusqu’à lui ouvrir ma bibliothèque ; et puis je l’exhortais en lui demandant à l’occasion où il en était, s’il réussissait à composer ; il m’arriva même de lui corriger quelque pièce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
