                "senses": [
                    {
                        "sense_id": "b9fe2141-3697-3a04-8204-c04f1ea5b73b",
                        "entry_id": "e2c1c91f-b459-3471-bee9-2a5d7c4bdeef",
                        "glosses": [
                            "eine zu Taiwan gehörige und von China beanspruchte Inselgruppe vor der Küste von Fujian"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a97070c-4535-45de-a4c1-e7c27848632d",
                                "sense_id": "b9fe2141-3697-3a04-8204-c04f1ea5b73b",
                                "text": "„Kinmen liegt direkt vor Chinas Küste, gehört aber zu Taiwan.“"
                            },
                            {
                                "example_id": "4eab84f6-fea9-4625-9d04-ed2d272f183b",
                                "sense_id": "b9fe2141-3697-3a04-8204-c04f1ea5b73b",
                                "text": "„Erst 1992 wurde auf Kinmen das Kriegsrecht aufgehoben.“"
                            },
                            {
                                "example_id": "55dd601a-1c78-49b3-a423-63619e10de24",
                                "sense_id": "b9fe2141-3697-3a04-8204-c04f1ea5b73b",
                                "text": "„Auf Kinmen fühlt sich die Mehrheit dem chinesischen Teil näher, wegen der familiären Beziehungen.“"
                            },
                            {
                                "example_id": "582ee029-6191-4d44-a03b-ba0c3f5de9ee",
                                "sense_id": "b9fe2141-3697-3a04-8204-c04f1ea5b73b",
                                "text": "„Auf der Hauptinsel gebe es Stimmen, Kinmen an China zurückzugeben, weil es nicht zu Taiwan gehöre.“"
                            },
                            {
                                "example_id": "d679e04c-1855-4c83-8e87-f2343ea34f2c",
                                "sense_id": "b9fe2141-3697-3a04-8204-c04f1ea5b73b",
                                "text": "„Kinmen mit mehr als 140.000 Einwohnern liegt nur wenige Kilometer von der chinesischen Millionenstadt Xiamen im Südosten der Volksrepublik entfernt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7cddf25-6925-449e-b7f0-9e03f3837bb8",
                        "source_entry_id": "e2c1c91f-b459-3471-bee9-2a5d7c4bdeef",
                        "source_sense_id": "b9fe2141-3697-3a04-8204-c04f1ea5b73b",
                        "source_sense_description": "zu Taiwan gehörige und von China beanspruchte Inselgruppe",
                        "target_lang_word": "金門縣",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d62339e7-b258-4ea4-8f89-fb643360a8d1",
                        "source_entry_id": "e2c1c91f-b459-3471-bee9-2a5d7c4bdeef",
                        "source_sense_id": "b9fe2141-3697-3a04-8204-c04f1ea5b73b",
                        "source_sense_description": "zu Taiwan gehörige und von China beanspruchte Inselgruppe",
                        "target_lang_word": "Kinmen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kinmen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "967ac2f5-2e14-3129-b7a7-00e84b0db610",
                                        "entry_id": "a385da29-406b-3570-9e76-f7024ca2912e",
                                        "glosses": [
                                            "A county of Taiwan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e0d8f68-9e32-4a5d-9529-74c86a232859",
                                                "sense_id": "967ac2f5-2e14-3129-b7a7-00e84b0db610",
                                                "text": "The Kinmen County Government reported that during the past four months of Red bombardment of Kinmen, a total of 105 civilians were killed and 312 wounded."
                                            },
                                            {
                                                "example_id": "619dec33-7cba-4ffa-ab97-2ae824cb8da8",
                                                "sense_id": "967ac2f5-2e14-3129-b7a7-00e84b0db610",
                                                "text": "Kinmen County, an island chain with a population of 76,000, is catering to Chinese tourists by converting military facilities into tourist traps and building museums with wartime themes."
                                            },
                                            {
                                                "example_id": "2769b092-9873-4430-a69a-6ed0b0aae1dc",
                                                "sense_id": "967ac2f5-2e14-3129-b7a7-00e84b0db610",
                                                "text": "Shiyu, or Lion Islet, part of Kinmen County, one of Taiwan’s offshore islands, seen in front of Xiamen, China, on September 8, 2015."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb20968b-fef7-31f6-a135-01bee69dabcf",
                                        "entry_id": "a385da29-406b-3570-9e76-f7024ca2912e",
                                        "glosses": [
                                            "An island of Kinmen County, Taiwan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1fca6d8-c90a-4227-b4bf-409014105166",
                                                "sense_id": "bb20968b-fef7-31f6-a135-01bee69dabcf",
                                                "text": "5. Chi Govt wishes to call attn of US Govt again to fact that Chi Govt is at present maintaining positions on a nr of islands such as Lintin and Lema Islands off Canton, Kinmen Island off Amoy, Matsu Island off Foochow, Tachen Islands off Chekiang Province, etc. These island positions, together with those on the Pescadores, form part of the defense of Taiwan. They are guarded by considerable nr of ground troops with the support of air and naval forces. They have been, however, under constant attacks by Chi Commies, and Chi milit command feels obliged to resist these attacks in self-defense. Chi Govt will appreciate it if US Govt wld indicate its views regarding the matter."
                                            },
                                            {
                                                "example_id": "84a2af9f-1352-4bb8-bb13-c15c61e96804",
                                                "sense_id": "bb20968b-fef7-31f6-a135-01bee69dabcf",
                                                "text": "The whole Kinmen island complex was divided into 7 operation areas, namely, Tatan, Erhtan, Small Kinmen, and Kinchen-Kinshan, Kinning, Kinhu and Kinsa on Kinmen."
                                            },
                                            {
                                                "example_id": "a7908969-73da-4702-895c-57a367a4a26c",
                                                "sense_id": "bb20968b-fef7-31f6-a135-01bee69dabcf",
                                                "text": "KINMEN\nTHE little island of Kinmen, three miles off the Chinese coast, must be the world's most heavily defended.\n. . .\nThis week it was learnt that in March China's military leaders plan \"Operation Kinmen\", a simulated invasion of the island, on the eve of Taiwan's first election for the presidency in which all adult Taiwanese will be able to vote. On Kinmen itself, the Taiwanese are declining to panic."
                                            },
                                            {
                                                "example_id": "9a3e1baa-7501-4574-b422-1f272a2e301f",
                                                "sense_id": "bb20968b-fef7-31f6-a135-01bee69dabcf",
                                                "text": "The PLA had landed several battalions on the beaches and suffered immediate counterattacks by the Nationalist “Kinmen Bears” riding in American M5 A1 tanks for which the Communists had no counter. Fifteen thousand men had died in less than three days. The victory left Kinmen itself a hallowed ground in the minds of the Taiwanese."
                                            },
                                            {
                                                "example_id": "8182d841-4430-4009-a9b9-27dc697bbf1e",
                                                "sense_id": "bb20968b-fef7-31f6-a135-01bee69dabcf",
                                                "text": "Arguments over Kinmen's relationship with China swing between \"accusing someone of either jeopardizing the most crucial geopolitical relationship of all or committing treason,\" said Michael Szonyi, director of the Fairbank Center for Chinese Studies at Harvard University and the author of \"Cold War Island,\" a book about Kinmen.\n\"Virtually every local issue on Kinmen, no matter how small, gets linked to the larger geopolitical context of how to relate to a rising and changing China,\" Szonyi said. \"These are exactly the same questions that Taiwan, that Africa and Latin America, that even the United States are increasingly grappling with.\""
                                            },
                                            {
                                                "example_id": "3cdd6da4-c8c6-4de6-a99a-0776fdc4b60b",
                                                "sense_id": "bb20968b-fef7-31f6-a135-01bee69dabcf",
                                                "text": "The San Jiao Fort cafe on Kinmen Island may well be the best place in Taiwan to watch for the threat of invasion by China.[…]\nA handful of people on the Taiwanese islands near China did catch a glimpse of the drills. On Kinmen, Chiu Yi-hsuan, a 39-year-old owner of an independent bookstore, said she felt a shock wave on Thursday. “At first I thought it was thunder, then I realized it wasn’t,” she said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
