                        "sense_id": "8421caf5-2ef3-3232-b495-55e117a11722",
                        "entry_id": "03bb61b7-5401-3964-80ff-77a251953d82",
                        "glosses": [
                            "Instrument en bois, en métal ou en toute autre matière, qui sert à couper le papier et spécialement les enveloppes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9573d86-1f39-4b85-8d17-80c2109b8f97",
                                "sense_id": "8421caf5-2ef3-3232-b495-55e117a11722",
                                "text": "Jacques s’empara du scalpel de chirurgien qui servait d’ouvre-lettre, il se gratta la base du cou sous la chemise."
                            },
                            {
                                "example_id": "02a1e1a9-1491-4b82-b0d4-d69aa121c616",
                                "sense_id": "8421caf5-2ef3-3232-b495-55e117a11722",
                                "text": "Un des côtés de l’enveloppe était grossièrement déchiré, comme par un doigt qui aurait servi d’ouvre-lettre."
                            }
                        ]
                    }
                ],
