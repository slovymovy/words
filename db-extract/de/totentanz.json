                        "cross_references": []
                    },
                    {
                        "translation_id": "b248f965-7d06-4c16-b019-034026428763",
                        "source_entry_id": "d290cef4-5542-3ac0-ab13-94ce21fbadf0",
                        "source_sense_id": "001b53e2-e4d9-36e6-8705-498b96d9ca21",
                        "target_lang_word": "dodendans",
                        "target_lang_code": "nl",
