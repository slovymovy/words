                "senses": [
                    {
                        "sense_id": "e647b2e9-7420-3139-a6cb-723715700ba6",
                        "entry_id": "9529a87a-c3af-3005-86d2-f80eef32a151",
                        "glosses": [
                            "Computerspiel, bei dem körperliche Gewalt, meist in Anwendung verschiedener Kampftechniken, das Spielgeschehen bestimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bb3f67a-f20c-4968-8475-6e708b7cad5b",
                                "sense_id": "e647b2e9-7420-3139-a6cb-723715700ba6",
                                "text": "„In der Spielhalle Merkur in Hamburg, wo eine dieser Spielstationen steht und an diesem Oktobernachmittag wenig los ist, sitzt ein paar Plätze weiter eine junge Frau mit blonden Korkenzieherlocken vor einem Automaten, auf dem ein Beat’m up läuft, ein sogenanntes Prügelspiel.“"
                            },
                            {
                                "example_id": "ecdeab16-4a89-4f92-822b-bdefde2517a1",
                                "sense_id": "e647b2e9-7420-3139-a6cb-723715700ba6",
                                "text": "„Und Wiedemanns Aufgabe dabei war gerade, zu erklären, warum das beliebte japanische Prügelspiel Tekken sich besonders gut eignet, um zwei Minuten Lebenszeit totzuschlagen.“"
                            },
                            {
                                "example_id": "c23a5dc0-75d8-4660-a920-65fab8cc0ea7",
                                "sense_id": "e647b2e9-7420-3139-a6cb-723715700ba6",
                                "text": "„Das Kriegsspiel präsentiert sich in vielen Facetten. Die breite Skala reicht von primitiven Baller- und Prügelspielen wie dem elektronischen Streetfighter oder dem verrufenen Computerspiel Counterstrike bis zu feinsinnig sublimierten Spielformen wie dem Schachspiel.“"
                            },
                            {
                                "example_id": "9d1eb3f1-eed9-4c17-89e0-a8bbcc852584",
                                "sense_id": "e647b2e9-7420-3139-a6cb-723715700ba6",
                                "text": "„1992 gab es große Aufregung um das sinnlos brutale Prügelspiel Mortal Kombat, das der Mehrheit der Spieler zu blutrünstig war.“"
                            },
                            {
                                "example_id": "36bdbe03-65dd-4f85-aa6b-7e157b915500",
                                "sense_id": "e647b2e9-7420-3139-a6cb-723715700ba6",
                                "text": "„Ende 1994 sprach sich herum, daß die neue Fassung des Prügelspiels, Mortal Kombat II, schon in der ersten Woche ihres Daseins mehr Geld eingebracht hat als ein Film wie Forrest Gump, nämlich fünfzig Millionen Dollar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
