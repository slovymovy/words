                        "glosses": [
                            "Préparer à l'hiver, pour éviter les dommages dus au froid."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "63c05a63-9e86-416e-a5eb-2e78ca807713",
                                "sense_id": "280acb0b-2650-3b3a-b3cf-a9f892425bc5",
                                "text": "Il est important que les propriétaires de véhicules de plaisance, de bateaux, de piscines, de chalets et d’autres habitations saisonnières effectuent un entretien de routine des canalisations d’eau et des appareils sanitaires afin d’hivériser correctement leurs biens."
                            },
                            {
                                "example_id": "5ff9fd48-d380-42d5-95ec-aabe5bb3dd22",
                                "sense_id": "280acb0b-2650-3b3a-b3cf-a9f892425bc5",
                                "text": "France s'occupe à hivériser la maison."
                            }
                        ]
                    }
