                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The canyon wall clearly exposes a dramatic <w>nonconformity</w> where sandstone sits directly atop ancient granite."
                        },
                        {
                            "text": "Geologists studied the <w>nonconformity</w> to understand the long period of erosion that had occurred."
