                "senses": [
                    {
                        "sense_id": "5f48105d-12c9-3396-a1ea-0934a6bc2173",
                        "entry_id": "7c59315e-476b-3c12-bdda-80b17d53ccca",
                        "glosses": [
                            "Fahrzeug, das als Bibliothek dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf2dca52-c51c-4d13-a05a-59c0571e85db",
                                "sense_id": "5f48105d-12c9-3396-a1ea-0934a6bc2173",
                                "text": "An jedem dritten Dienstag im Monat kam der Bücherbus in die Stadt."
                            },
                            {
                                "example_id": "431bd880-bea7-47ac-9bb7-0eb93949058d",
                                "sense_id": "5f48105d-12c9-3396-a1ea-0934a6bc2173",
                                "text": "„Das war das erste Geschenk, das der Bücherbus Bobby machte, auch wenn er noch nicht genau wusste, was er damit anfangen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
