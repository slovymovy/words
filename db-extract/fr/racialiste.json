            },
            {
                "entry_id": "e88789be-d8f4-3546-b635-67e525b5f363",
                "word": "racialiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f71046de-f476-4d01-87fa-2440725e2741",
                        "entry_id": "e88789be-d8f4-3546-b635-67e525b5f363",
                        "tags": [
