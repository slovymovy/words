                        "glosses": [
                            "de mate waarin iets als nuttig en waardevol wordt ervaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c44dcf22-7cad-4449-a5d0-7806637e49c6",
                                "sense_id": "fc1933bf-b0ae-3f83-bfc1-1651371ecbdd",
                                "text": "De zinvolheid van het systeem waarin zorgverzekeraars een vaste prijs per diagnose en bijbehorende behandeling betalen, krijgt van de ondervraagde psychologen een 2,9 op een schaal van 10, schrijft Trouw. Dat blijkt uit een enquête waarin 680 psychologen hebben gereageerd, uitgevoerd door de Universiteit Utrecht."
                            },
                            {
                                "example_id": "628fc08e-6025-4998-a3e1-481ef677bfd4",
                                "sense_id": "fc1933bf-b0ae-3f83-bfc1-1651371ecbdd",
                                "text": "Berichten in de media over de hoge zorgkosten en het framen van ouderen als een groep die de samenleving vooral tot last is, kunnen dit gevoel van overbodigheid versterken en het gevoel van zinvolheid aantasten."
                            }
                        ]
                    }
