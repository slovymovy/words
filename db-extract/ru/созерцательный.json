                                    {
                                        "sense_id": "90976127-bf0b-3814-b9e8-39dc718aa4eb",
                                        "entry_id": "615929f1-2b14-3dad-9425-79822916923f",
                                        "glosses": [
                                            "Of or pertaining to meditation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e455f19a-6cb0-4749-af9b-8d896af264fe",
                                                "sense_id": "90976127-bf0b-3814-b9e8-39dc718aa4eb",
                                                "text": "Yoga is a meditative practice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26c054d3-6353-31d2-a213-408a9781bef9",
                                        "entry_id": "615929f1-2b14-3dad-9425-79822916923f",
                                        "glosses": [
                                            "Thoughtful; pensive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8c5f193-17eb-4a44-96a3-867ad3a33176",
                                                "sense_id": "26c054d3-6353-31d2-a213-408a9781bef9",
                                                "text": "After hearing the news he became meditative."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
