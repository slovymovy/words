                "senses": [
                    {
                        "sense_id": "5ac66ecb-d93a-3f06-84d5-fd0d2a2dca70",
                        "entry_id": "46b1640e-21cb-3802-8de2-f4707fb52e16",
                        "glosses": [
                            "osadzenie kogoś w areszcie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5236ba4d-37a2-45fc-bc98-cd25fbe39384",
                                "sense_id": "5ac66ecb-d93a-3f06-84d5-fd0d2a2dca70",
                                "text": "Mój kolega zaciągnął się do legii cudzoziemskiej, aby uniknąć aresztowania za popełnione przestępstwo."
                            },
                            {
                                "example_id": "b0c0bee0-cee8-445e-ba03-6fe0b94327df",
                                "sense_id": "5ac66ecb-d93a-3f06-84d5-fd0d2a2dca70",
                                "text": "Było to po głośnej aferze aresztowania posłów opozycji i w uszach dźwięczały mi jeszcze tak wyraźnie gorzkie słowa ojca, rozczarowanego boleśnie dyktatorskim posunięciem Piłsudskiego, że odmówiłem"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ab215047-4118-3adb-8011-14855dfa6d41",
                        "entry_id": "46b1640e-21cb-3802-8de2-f4707fb52e16",
                        "glosses": [
                            "zajęcie mienia w celu zabezpieczenia czyichś roszczeń"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efb78470-20b1-4b5e-bd53-aeba061448e4",
                        "source_entry_id": "46b1640e-21cb-3802-8de2-f4707fb52e16",
                        "source_sense_id": "5ac66ecb-d93a-3f06-84d5-fd0d2a2dca70",
                        "target_lang_word": "arrestation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrestation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48679a88-8b30-382a-a170-bf61ee1ca911",
                                        "entry_id": "48be0071-2766-3b38-be58-8f54a2242929",
                                        "glosses": [
                                            "Action d’arrêter quelqu’un pour l’emprisonner."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d343f778-36c1-4dab-9699-95ebbbe6b563",
                                                "sense_id": "48679a88-8b30-382a-a170-bf61ee1ca911",
                                                "text": "À la préfecture, depuis 1830, ils veulent d’honnêtes gens, j’ai donné ma démission, et je me suis fait un petit tran-tran avec les arrestations pour dettes…"
                                            },
                                            {
                                                "example_id": "a05073d8-e095-4ff3-aa4d-c34ee3823c17",
                                                "sense_id": "48679a88-8b30-382a-a170-bf61ee1ca911",
                                                "text": "Désormais donc, les prévenus seront, au moment de leur arrestation, conduits directement ä la Roquette, où, séparés les uns des autres, comme le sont les enfants jugés, ils n'auront pas à souffrir du contact de leurs co-détenus."
                                            },
                                            {
                                                "example_id": "922abcfe-819c-45a4-81a4-8c0afa76b6a4",
                                                "sense_id": "48679a88-8b30-382a-a170-bf61ee1ca911",
                                                "text": "Le gouvernement ordonne une répression sanglante. Arrestations, pendaisons, exécutions sommaires plongent Tripoli dans un bain de sang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9bb369d-24cc-343d-ac30-f367bae8a48b",
                                        "entry_id": "48be0071-2766-3b38-be58-8f54a2242929",
                                        "glosses": [
                                            "État de celui qui est emprisonné."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0c10345-287f-4a29-ba66-2e7a918ce979",
                                                "sense_id": "e9bb369d-24cc-343d-ac30-f367bae8a48b",
                                                "text": "Son arrestation fut de courte durée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
