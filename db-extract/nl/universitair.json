                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "universitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91d29eea-9c7d-30e4-9935-01aa45dda855",
                                        "entry_id": "849fc249-6874-3d69-a0a6-87bf2dc0f35e",
                                        "glosses": [
                                            "De l’université, voire par extension de l’enseignement supérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16bbadb9-30db-4cdb-9472-161d2214b136",
                                                "sense_id": "91d29eea-9c7d-30e4-9935-01aa45dda855",
                                                "text": "Les auteurs ont présenté à des étudiants universitaires des personnes souffrant de bégaiement et à qui on avait accolé une vignette explicative des causes à l'origine de leur bégaiement."
                                            },
                                            {
                                                "example_id": "bbef600d-d27e-4e91-ae73-d974f35c62cf",
                                                "sense_id": "91d29eea-9c7d-30e4-9935-01aa45dda855",
                                                "text": "Diplôme universitaire."
                                            },
                                            {
                                                "example_id": "481d3f06-dd1f-4000-be3e-0785ca18ffc5",
                                                "sense_id": "91d29eea-9c7d-30e4-9935-01aa45dda855",
                                                "text": "Calendrier universitaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9587c4f5-3aaa-33db-876a-bcf6084159ab",
                                        "entry_id": "849fc249-6874-3d69-a0a6-87bf2dc0f35e",
                                        "glosses": [
                                            "Relatif à l’université."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b106efc-8b2c-42d4-8ca1-1d3bb763f317",
                                                "sense_id": "9587c4f5-3aaa-33db-876a-bcf6084159ab",
                                                "text": "Il se spécialise en linguistique à l'université de Leipzig (1895-1896) et, de retour à Groningue, rédige un travail universitaire sous la direction du sanskriste Speiger, Le Vidûsaka dans le théâtre indien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6269624a-3528-34e4-a776-5a9facae0313",
                                        "entry_id": "849fc249-6874-3d69-a0a6-87bf2dc0f35e",
                                        "glosses": [
                                            "Qui appartient à l’université."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94007826-4b14-499a-8ede-4607ee37a0da",
                                                "sense_id": "6269624a-3528-34e4-a776-5a9facae0313",
                                                "text": "Régime universitaire."
                                            },
                                            {
                                                "example_id": "3e8a1e14-81f8-4567-ab3f-d9fdadd5ffba",
                                                "sense_id": "6269624a-3528-34e4-a776-5a9facae0313",
                                                "text": "Rétribution universitaire."
                                            },
                                            {
                                                "example_id": "4a5468c0-6da3-40c0-936f-c264b5254815",
