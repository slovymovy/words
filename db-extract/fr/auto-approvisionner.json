                "senses": [
                    {
                        "sense_id": "fe63f351-3a7e-3d1b-b7a1-dd54e1c7561a",
                        "entry_id": "74e23da0-3acb-3254-a858-b7ac33fea6c4",
                        "glosses": [
                            "Approvisionner en utilisant ses propres ressources."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f72ccee-6d27-441c-8078-825885c0c2dc",
                                "sense_id": "fe63f351-3a7e-3d1b-b7a1-dd54e1c7561a",
                                "text": "Multiplication de plants de fraisiers en mode de culture biologique afin d'auto-approvisionner la ferme pour l'implantation de nouveaux champs."
                            },
                            {
                                "example_id": "530e0883-c6d4-41b5-b9ab-f1df4454b14a",
                                "sense_id": "fe63f351-3a7e-3d1b-b7a1-dd54e1c7561a",
                                "text": "Avec une variété lignée, une variété population ou une variété synthétique, l’utilisateur peut s’auto-approvisionner avec plus ou moins de risques."
                            },
                            {
                                "example_id": "8f86fe30-fa7d-445f-a12f-8577dbab84cf",
                                "sense_id": "fe63f351-3a7e-3d1b-b7a1-dd54e1c7561a",
                                "text": "Il est toutefois possible de s’auto-approvisionner."
                            }
                        ]
                    }
