                                        "examples": [
                                            {
                                                "example_id": "6ff2027d-f5ed-4d92-8154-7527211021af",
                                                "sense_id": "618cb2cf-7290-370e-ad31-48354c9fa8fb",
                                                "text": "παιδιά της Κατοχής"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bd77096-faf8-36a1-9f8f-4c644eac8b14",
                                        "entry_id": "67ab2423-a7a4-3eb9-b6fe-7469fb9a1b16",
                                        "glosses": [
                                            "υπάλληλος μικρής ηλικίας για ασήμαντες δουλειές και θελήματα"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c04acaa-b0b2-4642-a693-c050f236aec0",
                                                "sense_id": "2bd77096-faf8-36a1-9f8f-4c644eac8b14",
                                                "text": "το παιδί του γραφείου έφερε καφέ στο διευθυντή"
                                            },
                                            {
                                                "example_id": "f21fd16c-2507-4db8-b08e-b2f1e739c52d",
                                                "sense_id": "2bd77096-faf8-36a1-9f8f-4c644eac8b14",
                                                "text": "να έρθει το παιδί να πάρει τους φακέλους"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfe75a96-988c-3e6c-9f2e-c0cd89516b0d",
                                        "entry_id": "67ab2423-a7a4-3eb9-b6fe-7469fb9a1b16",
                                        "glosses": [
                                            "ο ανώριμος άνθρωπος που δε συμπεριφέρεται ως ενήλικας"
                                        ],
