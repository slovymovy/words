                "senses": [
                    {
                        "sense_id": "4d945f8c-6670-3f3b-a190-8a87d97d053b",
                        "entry_id": "e470182d-df24-397b-9fa4-275d5447643b",
                        "glosses": [
                            "Something that is not workable, or cannot be made to work."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a3a42d1-2ea0-4a95-b34c-66651374f23c",
                                "sense_id": "4d945f8c-6670-3f3b-a190-8a87d97d053b",
                                "text": "The building of the consensus group, however, forced these interests to distinguish annoying features of the law from unworkable ones, and the list of the unworkables steadily dwindled."
                            },
                            {
                                "example_id": "57c89021-dcbb-496b-b2f8-05a812b2f166",
                                "sense_id": "4d945f8c-6670-3f3b-a190-8a87d97d053b",
                                "text": "We all have some secret little hope that the unworkables will be resurrected. You haven't seen any of the occupants of the pyramids pull this off yet, nor will you see any use for old, outdated, dead office stuff."
                            },
                            {
                                "example_id": "d14cf3f3-2de8-4943-8fd8-71a890fe9fc7",
                                "sense_id": "4d945f8c-6670-3f3b-a190-8a87d97d053b",
                                "text": "His effort at maintaining a casual relationship was one of the unworkables in his life. Ealy had once observed that friends may become lovers, but lovers could never be friends."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
