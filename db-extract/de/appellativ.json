                    {
                        "sense_id": "0d21f240-b0bb-37a1-9c19-938c015a5672",
                        "entry_id": "76989d01-9da5-32a9-8b92-611ec5143f0f",
                        "glosses": [
                            "Bezeichnung für eine Klasse von Personen, Tieren, Pflanzen oder Gegenständen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41b0d697-c346-4a75-bbee-93030daa4f11",
                                "sense_id": "0d21f240-b0bb-37a1-9c19-938c015a5672",
                                "text": "„Interessanterweise können Eigennamen aber in Gattungsnamen, sogenannte Appellative, übergehen - und umgekehrt.“"
                            },
                            {
                                "example_id": "4a0dadca-9a7b-4475-bf17-13c8b9535300",
                                "sense_id": "0d21f240-b0bb-37a1-9c19-938c015a5672",
                                "text": "„Das Verhältnis von Propria und Appellativen auf der morphematisch-lexematischen Ebene ist dadurch gekennzeichnet, daß es Morpheme/Lexeme gibt, die synchron ausschließlich auf diesen Bereich beschränkt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
