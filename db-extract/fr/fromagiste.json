                        "examples": [
                            {
                                "example_id": "a202695c-4cee-488f-9246-724fa63f5ebe",
                                "sense_id": "68a151b0-d671-3547-946d-2e0261b8b2eb",
                                "text": "Le général Fouad Chéhab, nouveau président de la République, qui ambitionne de mettre fin au règne des grandes familles et des « fromagistes », l’appelle à ses côtés."
                            },
                            {
                                "example_id": "1e03782b-3a94-416d-a92b-5db4eee6e25a",
                                "sense_id": "68a151b0-d671-3547-946d-2e0261b8b2eb",
                                "text": "Les hommes politiques que le président qualifiait de « fromagistes » et les forces traditionnelles s’opposèrent farouchement à toute réforme moderniste du système politique car cette dernière risque de leur priver du pouvoir et de l’autorité qu’ils monopolisent entre leurs mains."
                            }
                        ]
                    }
