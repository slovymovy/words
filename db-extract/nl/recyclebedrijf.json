                        "examples": [
                            {
                                "example_id": "f2e8a1c0-6b6b-435c-acb4-00d4a95448f0",
                                "sense_id": "adc1be61-cd48-3ade-8406-53efbe08dfd9",
                                "text": "Bij het Moerdijkse recyclebedrijf Remondis waar gisteren brand woedde, is kortgeleden een paar keer ernstig explosiegevaar vastgesteld. Er was elk moment een zwaar ongeluk te verwachten, staat in een inspectierapport dat in handen is van Omroep Brabant."
                            },
                            {
                                "example_id": "f55dcd27-4dd3-47ec-b8fe-d71041102964",
                                "sense_id": "adc1be61-cd48-3ade-8406-53efbe08dfd9",
                                "text": "Een Amerikaans recyclebedrijf is op zoek naar een vrouw die zonder het te weten een zeldzame computer met het oud vuil meegaf. Het bedrijf ontdekte dat het om een Apple 1 gaat. Dat is de eerste generatie van het computermerk, waar slechts 200 exemplaren van werden gemaakt."
                            }
