                        ],
                        "examples": [
                            {
                                "example_id": "4ce6ce9e-fe0d-445a-85a4-c00b12ff8688",
                                "sense_id": "314c8585-42cf-39b1-9450-133e45f9dc22",
                                "text": "Voor het experiment komen naar verwachting zo’n 100.000 freelancers in aanmerking die werken voor onder meer muziek- en dansgezelschappen, theaters en concertpodia."
                            },
                            {
                                "example_id": "3267e7b2-7abc-4164-b05a-4e9fb2d3866a",
                                "sense_id": "314c8585-42cf-39b1-9450-133e45f9dc22",
                                "text": "De missie van een concertpodium ligt in de muziek. Vanuit deze missie werk je aan diversiteit en inclusie. Natuurlijk wil een concertgebouw in een stad die voor de helft bestaat uit mensen met een andere culturele achtergrond, vaak geboren Rotterdammers, zich verhouden tot álle Rotterdammers."
                            },
                            {
                                "example_id": "bd4efaa5-db98-4e26-b91a-81f80a2c041c",
                                "sense_id": "314c8585-42cf-39b1-9450-133e45f9dc22",
                                "text": "In de voormalige technische school aan de Dr. Jan van Breemenstraat (West, niet ver van het Rembrandtpark) komen naast de club in de oude fietsenkelder ook een concertpodium, restaurant, café en een sportlocatie."
                            },
                            {
                                "example_id": "0768718f-2db1-48ac-b5eb-002d93844f61",
                                "sense_id": "314c8585-42cf-39b1-9450-133e45f9dc22",
                                "text": "Dat de blokfluit zo wijd verspreid is en toch nauwelijks op de concertpodiums is te vinden vindt Coolsma niet verwonderlijk."
                            }
                        ]
                    },
                    {
                        "sense_id": "e08888d9-0423-39bf-9994-58ae24884549",
