                            },
                            {
                                "target_lang_word": "really scary",
                                "target_lang_sense_clarification": "very informal; making you feel very afraid"
                            },
                            {
                                "target_lang_word": "super scary",
                                "target_lang_sense_clarification": "stronger colloquial intensifier"
                            }
                        ]
