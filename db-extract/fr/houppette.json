                        "form": "houppettes"
                    },
                    {
                        "form_id": "a6edcb4f-6ce6-4e0c-8848-75a2d0bb031d",
                        "entry_id": "e8d26c3c-2bdb-3c3d-8961-ce5890d5706e",
                        "tags": [
                            "singular",
                            "plural"
                        ],
                        "form": "^((h aspiré))\\u.pɛt\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4416de57-302d-3db5-9339-aa5c350409ae",
                        "entry_id": "e8d26c3c-2bdb-3c3d-8961-ce5890d5706e",
                        "glosses": [
                            "Petite houppe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "125fe159-e8f4-4326-9815-2297d250d5cb",
                                "sense_id": "4416de57-302d-3db5-9339-aa5c350409ae",
                                "text": "Pourquoi Juliette n’est-elle pas venue ?… Pourquoi ?… et, distinctement, au milieu des jupons étalés sur les tapis, dans son cabinet de toilette, devant sa glace, les épaules nues, je l’aperçois qui secoue sur son visage une houppette de poudre de riz…"
                            },
                            {
                                "example_id": "6c16b5ea-b080-4516-86a2-ad25eff2f324",
                                "sense_id": "4416de57-302d-3db5-9339-aa5c350409ae",
                                "text": "La haine de cette femme. De sa petite vie nourrie de crèmes de beauté et de fonds de teint. De parfums, de houppettes, d’épilations « maillot », de laits autobronzants."
                            },
                            {
                                "example_id": "3b9e8f27-024f-4e09-a91a-324462131bab",
                                "sense_id": "4416de57-302d-3db5-9339-aa5c350409ae",
                                "text": "Lorsqu’arrivait le mois de septembre et que chaque branche de cotonnier brandissait sa houpette blanche, Zariffa et Ahmed Abdou prenaient part à la cueillette, ainsi que tous les habitants du village."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1e87b93-47c1-39d0-baf5-abb0ac6860e5",
                        "entry_id": "e8d26c3c-2bdb-3c3d-8961-ce5890d5706e",
                        "glosses": [
                            "Obturateur utérin utilisé par les femmes pour leur contraception."
                        ],
                        "tags": [
                            "analogy",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "53dd62e9-cbd4-48fd-a41a-af9aea9284fc",
                                "sense_id": "e1e87b93-47c1-39d0-baf5-abb0ac6860e5",
                                "text": "Aussi est-il plus simple, sinon plus certain d’employer un obturateur utérin tel que la houppette, nommée aussi la rosette et l’absorbite. C’est un tampon composé de fils de soie blanche réunis en leur milieu, offrant une grande douceur au toucher, et qui ne se laisse traverser par aucun liquide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3c5a2db-a89e-4366-8651-8133c539e7e4",
                        "source_entry_id": "e8d26c3c-2bdb-3c3d-8961-ce5890d5706e",
                        "source_sense_id": "4416de57-302d-3db5-9339-aa5c350409ae",
