    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c936334e-a3da-38f4-9808-f1345341f5b6",
                "word": "interpersonal",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d69637b9-2367-3fc0-b435-1a009315df0f",
                        "entry_id": "c936334e-a3da-38f4-9808-f1345341f5b6",
                        "glosses": [
                            "Between two or more people."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "33568623-827f-492a-8b27-4431ac0d56e1",
                                "sense_id": "d69637b9-2367-3fc0-b435-1a009315df0f",
                                "text": "By slightly modifying Piaget's scheme of the development of the capacity to follow and be aware of rules, I propose to distinguish three stages, or types, of mastery of interpersonal processes: coercion, self-help, and cooperation."
                            },
                            {
                                "example_id": "dfa526ff-59ad-4e63-b8b8-c10b9c0a45e8",
                                "sense_id": "d69637b9-2367-3fc0-b435-1a009315df0f",
                                "text": "The complexity of having so many organisations involved, and the deep integration required, has undoubtedly tested the interpersonal skills of project leaders who have had little face-to-face contact."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66e4f07c-2f56-4de0-ac21-6de20b8866e0",
                        "source_entry_id": "c936334e-a3da-38f4-9808-f1345341f5b6",
                        "source_sense_id": "d69637b9-2367-3fc0-b435-1a009315df0f",
                        "source_sense_description": "between persons",
                        "target_lang_word": "mezilidský",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1be31971-0bea-4866-83ec-a413e26b0420",
                        "source_entry_id": "c936334e-a3da-38f4-9808-f1345341f5b6",
                        "source_sense_id": "d69637b9-2367-3fc0-b435-1a009315df0f",
