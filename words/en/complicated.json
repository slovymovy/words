{
    "word_family": [
        "complicate",
        "complication"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fb969397-d652-3f9b-afda-95855d579233",
                    "sense_definition": "Difficult to understand or deal with because of many parts or details.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The instructions for the new game were too <w>complicated</w> for us.",
                            "target_lang_translations": {
                                "ru": "Инструкции к новой игре были для нас слишком <w>сложными</w>.",
                                "tr": "Yeni oyunun talimatları bizim için çok <w>karmaşıktı</w>.",
                                "zh": "新游戏的说明书对我们来说太<w>复杂</w>了。"
                            }
                        },
                        {
                            "text": "She found herself in a <w>complicated</w> situation that was hard to explain.",
                            "target_lang_translations": {
                                "ru": "Она оказалась в <w>запутанной</w> ситуации, которую было трудно объяснить.",
                                "tr": "Kendini açıklaması zor, <w>karışık</w> bir durumun içinde buldu.",
                                "zh": "她发现自己陷入了一种难以解释的<w>复杂</w>境地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "complex",
                        "intricate",
                        "difficult"
                    ],
                    "antonyms": [
                        "simple"
                    ],
                    "common_phrases": [
                        "complicated situation",
                        "complicated relationship",
                        "complicated process",
                        "complicated system"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный для понимания или решения из-за множества частей или деталей.",
                        "tr": "Birçok parça veya ayrıntı nedeniyle anlaşılması veya başa çıkılması zor olan.",
                        "zh": "因包含许多部分或细节而难以理解或处理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сложный",
                                "target_lang_sense_clarification": "трудный для понимания или выполнения"
                            },
                            {
                                "target_lang_word": "запутанный",
                                "target_lang_sense_clarification": "неясный, имеющий сложную структуру"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "karmaşık",
                                "target_lang_sense_clarification": "anlaşılması veya çözülmesi zor olan"
                            },
                            {
                                "target_lang_word": "karışık",
                                "target_lang_sense_clarification": "düzensiz veya anlaşılması güç"
                            },
                            {
                                "target_lang_word": "çetrefilli",
                                "target_lang_sense_clarification": "içinden çıkılması zor, pürüzlü"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复杂",
                                "target_lang_sense_clarification": "指事物结构或情况繁琐，难以理解或处理"
                            },
                            {
                                "target_lang_word": "棘手",
                                "target_lang_sense_clarification": "形容问题难以解决"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef79a6e2-b407-3418-b9e6-c7c91b40b71f",
                    "sense_definition": "Folded lengthwise, specifically referring to the wings of certain insects.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beetle has <w>complicated</w> wings that fit neatly under its shell.",
                            "target_lang_translations": {
                                "ru": "У жука <w>складчатые</w> крылья, которые аккуратно помещаются под панцирем.",
                                "tr": "Kın kanatlı böceğin, kabuğunun altına düzgünce sığan <w>katlanmış</w> kanatları vardır.",
                                "zh": "甲虫有<w>折叠的</w>翅膀，可以整齐地收在壳下。"
                            }
                        },
                        {
                            "text": "Scientists studied the <w>complicated</w> structure of the insect's folded wings.",
                            "target_lang_translations": {
                                "ru": "Ученые изучали <w>складчатую</w> структуру сложенных крыльев насекомого.",
                                "tr": "Bilim insanları, böceğin katlanmış kanatlarının <w>kıvrımlı</w> yapısını inceledi.",
                                "zh": "科学家们研究了这种昆虫翅膀<w>折叠的</w>结构。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сложенный продольно (обычно о крыльях некоторых насекомых).",
                        "tr": "Boylamasına katlanmış, özellikle bazı böceklerin kanatları için kullanılır.",
                        "zh": "指纵向折叠的，特指某些昆虫的翅膀。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "складчатый",
                                "target_lang_sense_clarification": "биологический термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "katlanmış",
                                "target_lang_sense_clarification": "biyoloji terimi, boylamasına katlı"
                            },
                            {
                                "target_lang_word": "kıvrımlı",
                                "target_lang_sense_clarification": "biyoloji terimi, katlı yapıya sahip"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "折叠的",
                                "target_lang_sense_clarification": "生物学中指具有折叠结构的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe2c9541-eafe-3034-874d-fd718d287fdf",
                    "sense_definition": "Simple past and past participle of <w>complicate</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden rain <w>complicated</w> our travel plans significantly.",
                            "target_lang_translations": {
                                "ru": "Внезапный дождь значительно <w>усложнил</w> наши планы на путешествие.",
                                "tr": "Aniden bastıran yağmur seyahat planlarımızı önemli ölçüde <w>zorlaştırdı</w>.",
                                "zh": "突如其来的大雨大大<w>增加了</w>我们旅行计划的<w>难度</w>。"
                            }
                        },
                        {
                            "text": "A lack of proper tools <w>complicated</w> the repair job.",
                            "target_lang_translations": {
                                "ru": "Отсутствие подходящих инструментов <w>усложнило</w> ремонтные работы.",
                                "tr": "Uygun aletlerin olmaması onarım işini <w>karmaşıklaştırdı</w>.",
                                "zh": "缺乏合适的工具使维修工作变得<w>复杂化</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past simple and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время от глагола \"усложнять\".",
                        "tr": "\"Complicate\" (zorlaştırmak/karmaşıklaştırmak) fiilinin geçmiş zaman ve geçmiş zaman sıfat-fiil hali.",
                        "zh": "使变得更加困难或复杂。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усложнил",
                                "target_lang_sense_clarification": "сделал более трудным"
                            },
                            {
                                "target_lang_word": "запутал",
                                "target_lang_sense_clarification": "внес неясность"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zorlaştırdı",
                                "target_lang_sense_clarification": "daha güç hale getirdi"
                            },
                            {
                                "target_lang_word": "karmaşıklaştırdı",
                                "target_lang_sense_clarification": "işleri daha karmaşık hale getirdi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使复杂化",
                                "target_lang_sense_clarification": "使事情变得更难处理"
                            },
                            {
                                "target_lang_word": "增加难度",
                                "target_lang_sense_clarification": "使某事变得更难完成"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}