                                                "example_id": "20c5e2d4-995f-42ff-86ac-ed0d1b0826a9",
                                                "sense_id": "e30f5fc3-d904-3d38-8ee4-6e5f2d9aee56",
                                                "text": "„Der Bezirksleiter betonte immer, es gebe keinen Anlass zur Sorge, und verstarb bald an Leukämie.“"
                                            },
                                            {
                                                "example_id": "c69bd6e4-d1b4-4a51-b26f-b9e613fcefec",
                                                "sense_id": "e30f5fc3-d904-3d38-8ee4-6e5f2d9aee56",
                                                "text": "„Rainer Maria Rilke starb 1926 im Alter von 51 Jahren an Leukämie.“"
