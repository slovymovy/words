                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b334cc0b-a607-4234-9814-6ff6d87eaf34",
                                "sense_id": "f9a6795b-ac2f-309c-8676-a4b205bf7294",
                                "text": "A good cook can often just eyeball the correct quantities of ingredients.",
                                "translation": "Un bon cuisinier peut souvent corriger la quantité des ingrédients rien qu'en jaugeant."
                            },
                            {
                                "example_id": "d68685fb-ac52-45a1-860b-e53c1d6728a2",
                                "sense_id": "f9a6795b-ac2f-309c-8676-a4b205bf7294",
                                "text": "Each geometric construction must be exact; eyeballing it and getting close does not count.",
                                "translation": "Chaque construction géométrique doit être exacte ; les jauger à peu près ne doit pas compter."
                            }
                        ]
                    },
