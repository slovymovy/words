                                    {
                                        "sense_id": "72ccc3a3-3c9a-3004-8f47-0110fb2c1900",
                                        "entry_id": "6749352d-92d7-3752-9a88-c39cd7836d7d",
                                        "glosses": [
                                            "iemand die bevrediging zoekt in het pijnigen van een ander"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b61bcac-5b65-4d5e-818e-9d3ff0f26765",
                                                "sense_id": "72ccc3a3-3c9a-3004-8f47-0110fb2c1900",
                                                "text": "Sadisten werken graag als ondervragers of in het gevangeniswezen."
                                            },
                                            {
                                                "example_id": "79621aaa-39a9-40ac-9e07-c227d9f998e8",
                                                "sense_id": "72ccc3a3-3c9a-3004-8f47-0110fb2c1900",
                                                "text": "Bepaald geestig is hoe Peter, na het debacle met zijn eerste vriend, probeert ‘pittiger’ te worden, aan de hand van een SM-handboek, ‘De betere sadist’, waarvoor de Vijftig tinten grijs-trilogie als voorbeeld heeft gediend. Hij deelt dus af en toe wat klappen en zweepslagen uit, zonder dat zijn seksleven er bijzonder van opfleurt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38cdbf07-c843-35d2-8dfd-b63d2842f7f6",
                                        "entry_id": "6749352d-92d7-3752-9a88-c39cd7836d7d",
                                        "glosses": [
                                            "iemand die kennelijk plezier beleeft aan het leed of de moeite die hij anderen bezorgt"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aca3a6dd-5b3b-4659-afd6-302e5b528d91",
                                                "sense_id": "38cdbf07-c843-35d2-8dfd-b63d2842f7f6",
                                                "text": "Terwijl ik dat irritante sirene’tje hoor loeien, de klep langzaam voor mijn neus dicht gaat en een olijke sadist me nog even hartelijk uitzwaait (hij vaart, ik vloek) probeer ik te bedenken waarom ik het wachten op de pont van en naar Noord zo verschrikkelijk vind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d988818f-9e18-4c39-bcfd-d29f1b325328",
                        "source_entry_id": "ce905f04-5190-30a8-a520-d7dfb80ea789",
                        "source_sense_id": "259b5ef7-bc79-3855-abae-51737df4fbff",
                        "source_sense_description": "one who derives pleasure through cruelty or pain to others",
                        "target_lang_word": "sadique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sadique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73b56bb0-4754-3262-8184-3a126f913e62",
                                        "entry_id": "ce5dfa59-95b7-308f-bfb6-e8b994f9f0a5",
                                        "glosses": [
                                            "Qui prend plaisir à faire souffrir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f56f6ce-8a0c-42e4-9858-55d22686938a",
                                                "sense_id": "73b56bb0-4754-3262-8184-3a126f913e62",
                                                "text": "La partie repart, les clients sadiques s’approchent, soudain intéressés de voir un froggy en situation délicate, et arrive mon tour."
                                            },
                                            {
                                                "example_id": "a2a066d5-cfa3-4ba7-bd1a-879b4dbd5166",
                                                "sense_id": "73b56bb0-4754-3262-8184-3a126f913e62",
                                                "text": "On songe que les victimes de bourreaux sadiques mises en scène Wajdi Mouawad rêvaient peut-être en vain d’une ambulance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sadique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f3423f0-3c9d-3e3c-a65b-507d9be6cf25",
                                        "entry_id": "11c80966-b3e9-3566-8cd7-16c6e4ef9d1d",
                                        "glosses": [
                                            "Personne qui prend plaisir à faire souffrir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6479c890-f32b-4b77-80f3-28f08aa5d9b5",
                                                "sense_id": "8f3423f0-3c9d-3e3c-a65b-507d9be6cf25",
                                                "text": "Surgi dans une période de réaction, le mot sadique ne contribue peut-être pas tant aux progrès de la science qu’il ne sert une stratégie littéraire : la critique de la modernité."
                                            },
                                            {
                                                "example_id": "39d20022-00e7-40e1-b8a9-4fd72b0bfd37",
                                                "sense_id": "8f3423f0-3c9d-3e3c-a65b-507d9be6cf25",
                                                "text": "Qui sont encore ces sadiques capables d'incendier en plein jour un marché public, jetant ainsi des milliers de familles dans de graves difficultés économiques ?"
                                            },
                                            {
                                                "example_id": "03198aac-a2c4-4e10-a440-b6a71eed083f",
                                                "sense_id": "8f3423f0-3c9d-3e3c-a65b-507d9be6cf25",
                                                "text": "Alex DeLarge, le sadique d’Orange mécanique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78960956-b37f-46e1-8179-70c06d747655",
                        "source_entry_id": "ce905f04-5190-30a8-a520-d7dfb80ea789",
                        "source_sense_id": "259b5ef7-bc79-3855-abae-51737df4fbff",
                        "source_sense_description": "one who derives pleasure through cruelty or pain to others",
                        "target_lang_word": "sadiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sadiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80d6d79b-1818-3f82-9cdb-95d46cc46989",
                                        "entry_id": "f5a5e2dc-4a34-3406-84ff-c163bfe7dead",
                                        "glosses": [
                                            "Adepte du sadisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96774b3a-6bcd-438a-9382-d9195ea4aef1",
                                                "sense_id": "80d6d79b-1818-3f82-9cdb-95d46cc46989",
                                                "text": "Les sadistes peuvent être répartis en trois catégories : les blasés, les monomanes, les passionnels. Mais, à vrai dire, entre ces trois genres de débauchés maniaques, les distinctions sont très subtiles."
                                            },
                                            {
                                                "example_id": "e3727cb3-691d-4a37-a776-af020d919842",
                                                "sense_id": "80d6d79b-1818-3f82-9cdb-95d46cc46989",
                                                "text": "Les sadistes deviennent de véritables virtuoses dans l’art d’assassiner sans être découverts. Le cynisme avec lequel plusieurs d’entre eux ont décrit leurs sensations témoigne de leur froide indifférence dans le tragique et l’effroyable."
                                            },
                                            {
                                                "example_id": "79fda52c-6b80-4e12-9d8c-873d665212cc",
                                                "sense_id": "80d6d79b-1818-3f82-9cdb-95d46cc46989",
                                                "text": "Il se croyait communiste, mais sa pensée était assez courte pour qu’il se satisfît de l’idée d’une révolution qui serait une catastrophe sans lendemain. Il était aussi sadiste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e7cf0ba-0b71-3668-8504-b98dd7a0cec1",
                                        "entry_id": "f5a5e2dc-4a34-3406-84ff-c163bfe7dead",
                                        "glosses": [
                                            "Relatif à l’œuvre du marquis de Sade."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61be77ff-5ca0-47c3-b2e6-67698c9237a0",
                        "source_entry_id": "ce905f04-5190-30a8-a520-d7dfb80ea789",
                        "source_sense_id": "259b5ef7-bc79-3855-abae-51737df4fbff",
                        "source_sense_description": "one who derives pleasure through cruelty or pain to others",
                        "target_lang_word": "Sadist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sadist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b8c5df8-60f2-3d96-8826-0b0fc7a2af13",
                                        "entry_id": "a15f78f9-d707-3ee4-bbb4-99cf111ac0e8",
                                        "glosses": [
                                            "Person, die Lustgewinn daraus zieht, andere zu quälen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b955b34-d4d5-48fa-b30c-86f5c873c7e7",
                                                "sense_id": "7b8c5df8-60f2-3d96-8826-0b0fc7a2af13",
                                                "text": "„Schon am Nachmittag nach diesem feierlichen Treueschwur, den wir vor einem Korvettenkapitän, unserem Kompaniechef und einigen Marineoffizieren leisten mussten, entpuppten sich einige unserer Ausbilder als einfallsreiche Sadisten.“"
                                            },
                                            {
                                                "example_id": "aabc4fe2-7795-43cb-9365-e60bce4ea056",
                                                "sense_id": "7b8c5df8-60f2-3d96-8826-0b0fc7a2af13",
                                                "text": "„Ob Reinhold Sadist von Anlage war, weiß er nicht.“"
                                            },
                                            {
                                                "example_id": "166dbab9-d06b-4946-9696-86333fe3c837",
                                                "sense_id": "7b8c5df8-60f2-3d96-8826-0b0fc7a2af13",
                                                "text": "„Er weckte immer den guten Sadisten in mir.“"
                                            },
                                            {
                                                "example_id": "0a97d6d2-3c4e-4484-a8e8-2d8faf29b788",
                                                "sense_id": "7b8c5df8-60f2-3d96-8826-0b0fc7a2af13",
                                                "text": "„Irgendwann würde ich so weit sein, daß ich Kinkel anpumpte, auch Sommerwild und sogar diesen Sadisten Fredebeul, der mir wahrscheinlich ein Fünfmarkstück vor die Nase halten und mich zwingen würde, danach zu springen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
