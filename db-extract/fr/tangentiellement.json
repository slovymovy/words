                "senses": [
                    {
                        "sense_id": "766eb30d-aacf-3c3f-b4a6-2f0d608344fd",
                        "entry_id": "c496a1c4-9300-34c0-a105-83a025bf55ef",
                        "glosses": [
                            "D’une façon tangentielle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e04ee6dc-0eb4-4189-950a-eb2a271ff423",
                                "sense_id": "766eb30d-aacf-3c3f-b4a6-2f0d608344fd",
                                "text": "Ils communiquent et s’équilibrent par le bord de leurs ventres, tangentiellement."
                            },
                            {
                                "example_id": "b11533a9-4c2a-4b14-9945-d0d65c71bcbf",
                                "sense_id": "766eb30d-aacf-3c3f-b4a6-2f0d608344fd",
                                "text": "Chacun de ces six faisceaux se bifurque tangentiellement vers la moitié de la hauteur de l’ovaire [d’une plante] ou un peu plus bas."
                            },
                            {
                                "example_id": "b8a21f89-a9f2-418c-8b98-a3501bd819c4",
                                "sense_id": "766eb30d-aacf-3c3f-b4a6-2f0d608344fd",
                                "text": "Des palettes placées tangentiellement sur ces rouleaux reprennent le liquide qui passe en dessous […]."
                            }
                        ]
                    }
                ],
