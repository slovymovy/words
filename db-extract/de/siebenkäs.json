                "senses": [
                    {
                        "sense_id": "a18f77f4-d0a1-3145-a40e-670e6e524ad6",
                        "entry_id": "b32a751a-a23c-3751-8468-0f457d4f324d",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8a63562-d8f9-47ff-8e1c-0e7f1c921848",
                                "sense_id": "a18f77f4-d0a1-3145-a40e-670e6e524ad6",
                                "text": "Frau Siebenkäs ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3bbc5f88-6ca3-45c7-9df4-0e77e98fb464",
                                "sense_id": "a18f77f4-d0a1-3145-a40e-670e6e524ad6",
                                "text": "Herr Siebenkäs wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "08b4d2f5-f960-4a60-b797-137ed2307903",
                                "sense_id": "a18f77f4-d0a1-3145-a40e-670e6e524ad6",
                                "text": "Die Siebenkäsens fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "cc301ef7-0dbd-45d4-8d11-196fa169349b",
                                "sense_id": "a18f77f4-d0a1-3145-a40e-670e6e524ad6",
                                "text": "Der Siebenkäs trägt nie die Schals, die die Siebenkäs ihm strickt."
                            },
                            {
                                "example_id": "117544f4-7e09-473b-8ca0-f952ab78415e",
                                "sense_id": "a18f77f4-d0a1-3145-a40e-670e6e524ad6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Siebenkäs kommt, geht der Herr Siebenkäs.“"
                            },
                            {
                                "example_id": "fb4464ee-00d4-4132-8fa0-61ff2e4d1597",
                                "sense_id": "a18f77f4-d0a1-3145-a40e-670e6e524ad6",
                                "text": "Siebenkäs kommt und geht."
                            },
                            {
                                "example_id": "69b157d0-ee76-4e9f-ba63-593700f095c5",
                                "sense_id": "a18f77f4-d0a1-3145-a40e-670e6e524ad6",
                                "text": "Siebenkäses kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
