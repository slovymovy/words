                "word": "d’enfer",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8560a6a7-d303-3b0e-a014-7cd4e12fa5a0",
                        "entry_id": "bbb9de03-f5d4-31be-a332-676b6a84319c",
                        "glosses": [
                            "Très grand, très violent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c30a6afa-4851-4266-8cdf-6ecb8ccbaaf2",
                                "sense_id": "8560a6a7-d303-3b0e-a014-7cd4e12fa5a0",
                                "text": "Il y a toujours un feu d’enfer dans cette verrerie, feu très ardent."
                            },
                            {
                                "example_id": "7feb80b8-b4f9-4ace-aa04-28979a353d43",
                                "sense_id": "8560a6a7-d303-3b0e-a014-7cd4e12fa5a0",
                                "text": "Jouer un jeu d’enfer, jouer très gros jeu."
                            },
                            {
                                "example_id": "31550fb2-aba0-460a-a62f-d9dcec6aa140",
                                "sense_id": "8560a6a7-d303-3b0e-a014-7cd4e12fa5a0",
                                "text": "Aller un train d’enfer, aller fort vite."
                            },
                            {
                                "example_id": "b0650a41-8145-4224-accd-9064d407f05a",
                                "sense_id": "8560a6a7-d303-3b0e-a014-7cd4e12fa5a0",
                                "text": "Rinaldo, sous bois, retrouva son cheval, sauta en selle, et, sur le coups de midi, rentra dans Paris par la porte Saint-Honoré et traversa la bonne ville de Sa Majesté Louis XIII, en un galop d’enfer, sans s’inquiéter des cris d’effroi ou des clameurs menaçantes qu’il soulevait sur son passage."
                            }
                        ]
                    },
                    {
                        "sense_id": "43b5db4f-dae3-3048-9ea4-4cfee80ec0dd",
                        "entry_id": "bbb9de03-f5d4-31be-a332-676b6a84319c",
                        "glosses": [
                            "Super, génial."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a6e9e897-5a21-4111-b8cd-6d389a56118e",
                                "sense_id": "43b5db4f-dae3-3048-9ea4-4cfee80ec0dd",
                                "text": "Avec leurs tatouages et leurs barbes aussi, j’ai trouvé qu’ils avaient une dégaine d’enfer."
                            }
                        ]
                    }
                ],
                "translations": [
