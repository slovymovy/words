                "senses": [
                    {
                        "sense_id": "1b520d02-60ea-3848-946f-9aa726e27f8e",
                        "entry_id": "fa6397bf-a453-3213-b53b-f876f5fc383f",
                        "glosses": [
                            "religiös konnotiertes Arrangement auf dem Richtertisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b3cbcd1-eb8f-4fc4-b639-fed833ce0173",
                                "sense_id": "1b520d02-60ea-3848-946f-9aa726e27f8e",
                                "text": "„Bis heute gibt es Richterpulte, auf denen eine sogenannte ‚Schwurgarnitur‘ angeschraubt ist, also zwei Kerzen mit einem Kreuz dazwischen.“"
                            },
                            {
                                "example_id": "930a80e1-fb5f-458b-aef0-bac3cebb1993",
                                "sense_id": "1b520d02-60ea-3848-946f-9aa726e27f8e",
                                "text": "„Diese sogenannte ‚Schwurgarnitur‘ ist meist sogar angeschraubt, seit ein rabiat gewordener Beschuldigter damit auf einen Richter losgegangen ist.“"
                            },
                            {
                                "example_id": "c84ab4e2-b574-4b3c-81eb-7a86c3299acd",
                                "sense_id": "1b520d02-60ea-3848-946f-9aa726e27f8e",
                                "text": "„Müssen auch die Schwurgarnitur und das Kreuz verschwinden, wenn man im Gerichtssaal oder in der Schule kein Kopftuch will?“"
                            },
                            {
                                "example_id": "637b7fde-4f60-435a-82a3-7b364e2ddd81",
                                "sense_id": "1b520d02-60ea-3848-946f-9aa726e27f8e",
                                "text": "„Noch gibt es in jedem gerichtlichen Verhandlungssaal die ‚Schwurgarnitur‘, also zwei Kerzen und ein Kreuz dazwischen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
