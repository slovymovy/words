                "senses": [
                    {
                        "sense_id": "5a9dcc02-4fab-3537-b6d8-f357fda576ce",
                        "entry_id": "c7537664-14dd-3f65-a5a2-da3438c6d1e3",
                        "glosses": [
                            "Unternehmen, das Automobile verkauft"
                        ],
                        "tags": [
                            "Handel"
                        ],
                        "examples": [
                            {
                                "example_id": "2883f8b0-4045-4686-9615-09ff46731690",
                                "sense_id": "5a9dcc02-4fab-3537-b6d8-f357fda576ce",
                                "text": "Sein neues Auto hatte er vor einer Woche bei einem Autohaus gekauft."
                            },
                            {
                                "example_id": "55fafd61-092c-45d9-83ff-f922ab458c00",
                                "sense_id": "5a9dcc02-4fab-3537-b6d8-f357fda576ce",
                                "text": "„Er schraubte für verschiedene Autohäuser in Tel Aviv und Jerusalem, lernte Hebräisch.“"
                            },
                            {
                                "example_id": "efe36744-5860-4c4b-ae3a-f93c75486ce1",
                                "sense_id": "5a9dcc02-4fab-3537-b6d8-f357fda576ce",
                                "text": "„Haben wir das je gekonnt, überlegt Eiríkur, als sie Njarđvík verlassen, auf die Straße nach Reykjavík einbiegen und an den ganzen Autohäusern dort vorbeifahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
