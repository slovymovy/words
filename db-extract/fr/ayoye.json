        "fr-extract.jsonl": [
            {
                "entry_id": "d4116376-1bb1-3eda-af52-1e342cca2401",
                "word": "ayoye",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "05620480-96b4-3473-9793-2e06bf840642",
                        "entry_id": "d4116376-1bb1-3eda-af52-1e342cca2401",
                        "glosses": [
                            "Qui exprime la douleur, généralement physique."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "46d5c029-f166-43ea-9578-84b8bcaebe1a",
                                "sense_id": "05620480-96b4-3473-9793-2e06bf840642",
                                "text": "Ayoye donc!"
                            },
                            {
                                "example_id": "20ab0db8-9a05-40c2-8579-7ae208bf444f",
                                "sense_id": "05620480-96b4-3473-9793-2e06bf840642",
                                "text": "David peut sans l’ombre d’un doute prédire que son père est sur le point d’attraper un torticolis et de crier ayoye!"
                            },
                            {
                                "example_id": "a5fc56c7-1f01-4341-8045-2c8e0d6221d7",
                                "sense_id": "05620480-96b4-3473-9793-2e06bf840642",
                                "text": "Un premier jet qui voudrait décrire sur le vif une dépression se limiterait à trois mots : « Ayoye! Ayoye! Ayoye! »"
                            }
                        ]
                    },
                    {
                        "sense_id": "c121d239-f89f-3332-8a36-6d7d831fb062",
                        "entry_id": "d4116376-1bb1-3eda-af52-1e342cca2401",
                        "glosses": [
                            "Qui exprime l’étonnement, l’admiration ou encore l’exaspération."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "919b6218-6be7-427a-a626-332dda74b96d",
                                "sense_id": "c121d239-f89f-3332-8a36-6d7d831fb062",
                                "text": "Si les Québécois proposent une identité nationale partagée sans fondement racial, c’est raciste, mais si une “communauté” encourage la discrimination sur la base de la race, ça, c’est de l’inclusion. Ayoye !"
                            },
                            {
                                "example_id": "1b703852-9b03-4618-a8f6-4dde5cbeadc3",
                                "sense_id": "c121d239-f89f-3332-8a36-6d7d831fb062",
                                "text": "«Ayoye», «complètement fou» ou «histoire cauchemardesque», les médecins du Québec ne savaient pas comment expliquer ce qui a bien pu se produire à Hawkesbury, en Ontario. !"
                            },
                            {
                                "example_id": "ebe9ef7a-0a8e-4b7d-a164-c151f6de7579",
                                "sense_id": "c121d239-f89f-3332-8a36-6d7d831fb062",
                                "text": "« Vous parlez de la loi et de l’ordre, c’est un peu fort étant donné que votre parti, votre Parti libéral, a encaissé un demi-million de dollars de dons illégaux quand vous le dirigiez ».\nAyoye !"
                            },
                            {
                                "example_id": "ef240cb0-10e5-4ccf-8bae-34cb15cbd5e9",
                                "sense_id": "c121d239-f89f-3332-8a36-6d7d831fb062",
                                "text": "Ayoye! Tu viens de manquer une maudite belle cascade!"
                            }
                        ]
                    }
                ],
