                                            {
                                                "example_id": "2b6c47f2-5503-49b0-ad2a-a2c5aa82d265",
                                                "sense_id": "f40e040a-6fe4-33a6-90ef-708998b68c88",
                                                "text": "Ma grand-mère nous faisait de bons petits plats, des strudels aux pommes et aux noix, de la mousse au chocolat, des confitures de pétales de roses qui sentaient si bon."
                                            }
                                        ]
                                    }
                                ]
