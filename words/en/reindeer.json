            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a924708-4fff-34de-a0ce-b70e1e0405f1",
                    "sense_definition": "A type of large deer with large antlers that lives in cold northern regions.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "deer species",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Santa Claus is famous for having a sleigh pulled by eight flying <w>reindeer</w>.",
                            "target_lang_translations": {
                                "ru": "Санта-Клаус знаменит тем, что его сани тянут восемь летающих <w>северных оленей</w>."
                            }
                        },
                        {
                            "text": "The <w>reindeer</w> herd moved across the snowy tundra in search of food.",
                            "target_lang_translations": {
                                "ru": "Стадо <w>северных оленей</w> двигалось по заснеженной тундре в поисках пищи."
                            }
                        }
                    ],
                    "synonyms": [
                        "caribou"
                    ],
                    "common_phrases": [
                        "reindeer herd",
                        "wild reindeer",
                        "reindeer moss",
                        "reindeer antlers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид крупного оленя с большими рогами, обитающий в холодных северных регионах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "северный олень",
                                "target_lang_sense_clarification": "общее название животного"
                            },
                            {
                                "target_lang_word": "карибу",
