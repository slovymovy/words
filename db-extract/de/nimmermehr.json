                                                "example_id": "749c3cf9-91be-4a22-babb-330232fba49a",
                                                "sense_id": "39d2d686-6b70-3d83-8d1a-86183931d757",
                                                "text": "Pracuję już od dwóch lat i stać mnie już na samochód."
                                            }
