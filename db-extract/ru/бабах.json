                "senses": [
                    {
                        "sense_id": "5f58feed-50ca-30a0-9b97-4a1b54cad4e1",
                        "entry_id": "44ac7cbd-e348-321c-9f4c-fd28b864dfd6",
                        "glosses": [
                            "разг. резкий громкий звук, взрыв"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5462949-9a5f-4e66-8d5a-83f0257edb2f",
                                "sense_id": "5f58feed-50ca-30a0-9b97-4a1b54cad4e1",
                                "text": "С громким бабахом молния ударила в соседнюю высотку."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f2c15ba-587d-3825-bb60-b80ed7c2f2d2",
                        "entry_id": "44ac7cbd-e348-321c-9f4c-fd28b864dfd6",
                        "glosses": [
                            "одуш. эвф. террорист, обычно исламский"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "160de40a-00c1-4e09-9fd9-c1cbab736c96",
                                "sense_id": "7f2c15ba-587d-3825-bb60-b80ed7c2f2d2",
                                "text": "Уж не знаю, как он [броневик] попал в Кубинку — видимо, от курдов достался бабахам, а уже от них — правительственным войскам Сирии."
                            }
                        ]
                    }
                ],
