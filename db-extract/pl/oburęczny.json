                                                "sense_id": "161d9dad-858b-3893-b3df-6c6d2c4f2c18",
                                                "text": "Sie spielt die beidhändige Rückhand sehr kraftvoll."
                                            },
                                            {
                                                "example_id": "0e401cb2-cf89-4c01-855c-59c118ce251e",
                                                "sense_id": "161d9dad-858b-3893-b3df-6c6d2c4f2c18",
                                                "text": "Er hatte eine beidhändige Amputation zu überstehen."
                                            }
