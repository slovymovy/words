                },
                {
                    "sense_id": "b96552d1-7cab-3c5a-8f16-ccfab6b54a04",
                    "sense_definition": "Категория людей, предметов или явлений, имеющих общие признаки или свойства.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "classification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У пациента редкая четвёртая <w>группа</w> крови, поэтому срочно нужен донор.",
                            "target_lang_translations": {
                                "en": "The patient has a rare fourth blood <w>type</w>, so a donor is urgently needed.",
                                "zh": "病人是罕见的第四血<w>型</w>，所以急需捐献者。"
                            }
                        },
                        {
                            "text": "Эти продукты входят в <w>группу</w> товаров первой необходимости.",
                            "target_lang_translations": {
                                "en": "These products belong to the <w>group</w> of essential goods.",
                                "zh": "这些产品属于生活必需品这一<w>类</w>。"
                            }
                        },
                        {
                            "text": "Бабушка получила вторую <w>группу</w> инвалидности по состоянию здоровья.",
                            "target_lang_translations": {
                                "en": "Grandmother received the second disability <w>group</w> due to her health.",
                                "zh": "奶奶因健康状况被评定为二级残疾<w>等级</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "совокупность",
                        "круг"
                    ],
                    "common_phrases": [
                        "группа крови",
                        "группа риска",
                        "группа инвалидности",
                        "возрастная группа"
                    ],
                    "target_lang_definitions": {
                        "en": "A category of people, objects, or phenomena sharing common signs or properties.",
                        "zh": "具有共同特征或属性的人、事物或现象的类别。"
                    },
