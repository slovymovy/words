                    {
                        "sense_id": "10cd8a74-52ba-3eb6-b314-7e07dea39678",
                        "entry_id": "317c141e-7ec1-3fb5-8780-212a8093f81f",
                        "glosses": [
                            "een organisme in het eerste ontwikkelingsstadium na de bevruchting"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a532cf67-b50a-4b10-b26b-e7ecf014cb71",
                                "sense_id": "10cd8a74-52ba-3eb6-b314-7e07dea39678",
                                "text": "Het gebruiken van embryo's voor de wetenschap roept ethische vragen op."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a38237ee-a872-41e6-ba56-28e0a43e4412",
                        "source_entry_id": "317c141e-7ec1-3fb5-8780-212a8093f81f",
                        "source_sense_id": "10cd8a74-52ba-3eb6-b314-7e07dea39678",
