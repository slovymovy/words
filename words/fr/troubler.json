{
    "word_family": [
        "trouble",
        "troublant",
        "troubleur",
        "introublable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "29ea4d6b-7abf-3347-aa47-a69aafe87931",
                    "sense_definition": "Perturber le déroulement, le calme ou l'ordre normal de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "perturbation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un cri soudain dans la rue est venu <w>troubler</w> le silence de la nuit."
                        },
                        {
                            "text": "Cette mauvaise nouvelle risque de <w>troubler</w> la tranquillité de toute la famille."
                        }
                    ],
                    "synonyms": [
                        "perturber",
                        "déranger",
                        "interrompre"
                    ],
                    "antonyms": [
                        "apaiser",
                        "calmer"
                    ],
                    "common_phrases": [
                        "troubler le silence",
                        "troubler la tranquillité",
                        "troubler le sommeil"
                    ]
                },
                {
                    "sense_id": "6d781c5e-e824-3c9e-8aa4-351d8555d1d9",
                    "sense_definition": "Faire naître chez quelqu'un une émotion vive, un sentiment d'attirance ou un émoi affectif.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son regard plein de tendresse a suffi pour la <w>troubler</w> dès le premier soir."
                        },
                        {
                            "text": "Cette déclaration inattendue a beaucoup <w>troublé</w> le jeune homme au fond de lui."
                        }
                    ],
                    "synonyms": [
                        "émouvoir",
                        "chambouler",
                        "toucher"
                    ],
                    "antonyms": [
                        "laisser indifférent"
                    ],
                    "common_phrases": [
                        "troubler le cœur"
                    ]
                },
                {
                    "sense_id": "9b37f3e0-928c-3003-9dfd-0d2a6a9c36ab",
                    "sense_definition": "Faire perdre sa limpidité ou sa transparence à un liquide en remuant les dépôts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En marchant dans le ruisseau, les enfants ont fini par <w>troubler</w> l'eau claire avec la boue."
                        },
                        {
                            "text": "Si vous secouez cette vieille bouteille de vin, vous allez inévitablement le <w>troubler</w>."
                        }
                    ],
                    "synonyms": [
                        "brouiller",
                        "obscurcir"
                    ],
                    "antonyms": [
                        "clarifier",
                        "décanter",
                        "éclaircir"
                    ],
                    "common_phrases": [
                        "troubler l'eau"
                    ]
                },
                {
                    "sense_id": "65d764ab-b991-3f29-b97e-3e7e37e9d5bb",
                    "sense_definition": "Déconcerter quelqu'un ou lui faire perdre ses moyens et sa présence d'esprit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La question directe et imprévue du professeur a réussi à <w>troubler</w> l'étudiant timide."
                        },
                        {
                            "text": "Ne me regardez pas comme cela pendant que je parle, vous me <w>troublez</w> beaucoup."
                        }
                    ],
                    "synonyms": [
                        "déconcerter",
                        "désarçonner",
                        "intimider",
                        "embarrasser"
                    ],
                    "antonyms": [
                        "rassurer",
                        "encourager"
                    ],
                    "common_phrases": [
                        "troubler les esprits",
                        "se troubler"
                    ]
                },
                {
                    "sense_id": "8fd99384-4b4d-3745-9747-4ac655a1f32f",
                    "sense_definition": "Perdre de sa clarté, de sa netteté ou de sa précision, en parlant des sens ou de la mémoire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous l'effet de l'extrême fatigue, sa vue semblait peu à peu se <w>troubler</w>."
                        },
                        {
                            "text": "Avec l'âge et le choc de l'accident, ses souvenirs ont commencé à se <w>troubler</w>."
                        }
                    ],
                    "synonyms": [
                        "s'obscurcir",
                        "s'altérer",
                        "s'embrouiller"
                    ],
                    "antonyms": [
                        "s'éclaircir"
                    ],
                    "common_phrases": [
                        "vue qui se trouble",
                        "mémoire qui se trouble"
                    ]
                }
            ]
        }
    ]
}