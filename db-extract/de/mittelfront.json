                "senses": [
                    {
                        "sense_id": "8ccb6ac0-3d23-33bf-a91d-3ce1d939d5ca",
                        "entry_id": "1003073e-8c13-3584-a497-9be473ca3b4e",
                        "glosses": [
                            "Front, die sich zwischen einer Nord- und Südfront oder einer West- und Ostfront befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5b22706-5c3f-45e9-a6a9-de01733e603e",
                                "sense_id": "8ccb6ac0-3d23-33bf-a91d-3ce1d939d5ca",
                                "text": "„Die deutsche Mittelfront ist aufgerollt. Ein Dammbruch, der durch nichts mehr aufzufangen ist.“"
                            },
                            {
                                "example_id": "7782778d-1beb-438e-9093-bf37ce760a6b",
                                "sense_id": "8ccb6ac0-3d23-33bf-a91d-3ce1d939d5ca",
                                "text": "„Die Heeresgruppe Mitte (GFM von Bock) wurde für den Angriff auf Moskau durch die Panzergruppe 4 (Hoepner) erheblich verstärkt, die von Leningrad zur Mittelfront abgezogen wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "96771317-693c-3b94-ae12-b62a0716881a",
                        "entry_id": "1003073e-8c13-3584-a497-9be473ca3b4e",
                        "glosses": [
                            "mittlerer Teil eines Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e62aa951-02c7-40d0-9f2f-5e493b9b6128",
                                "sense_id": "96771317-693c-3b94-ae12-b62a0716881a",
                                "text": "„Die Mittelfront des Langhauses schiebt sich vor die Türme und ist von achteckigen Flankentürmchen begleitet, die die Turmtreppen aufnehmen.“"
                            },
                            {
                                "example_id": "a9645c18-07bb-427b-bd43-b92dc762dbd7",
                                "sense_id": "96771317-693c-3b94-ae12-b62a0716881a",
                                "text": "„Zwei hohe Türme begrenzen die Fassade der Mittelfront.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
