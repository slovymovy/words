                "senses": [
                    {
                        "sense_id": "982853de-6bf3-350b-8ab7-82164a6d6044",
                        "entry_id": "0ad2d2c0-58f7-3a5b-9e1e-c4717d8efc66",
                        "glosses": [
                            "Remuer les lèvres sans émettre de son."
                        ],
                        "tags": [
                            "Ouest de la France"
                        ],
                        "examples": [
                            {
                                "example_id": "0d1b4dc5-59f8-4e2e-87b6-182805a495b6",
                                "sense_id": "982853de-6bf3-350b-8ab7-82164a6d6044",
                                "text": "Ses vieux yeux, qui ne distinguaient pas un moineau d’un pinson, suivaient, à bonne distance, les moindres mouvements de ses mains et de ses doigts ; enfin, ses mâchoires avaient cessé de babinoter comme celles d’un vieux lapin."
                            }
                        ]
                    },
                    {
                        "sense_id": "74eacc9d-4f7b-37b3-96ea-d39d21c40b43",
                        "entry_id": "0ad2d2c0-58f7-3a5b-9e1e-c4717d8efc66",
                        "glosses": [
                            "Manifester sa désapprobation ou sa mauvaise humeur en remuant les lèvres sans rien dire."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ae860290-eff8-4b12-87d0-7c3e07db7861",
                                "sense_id": "74eacc9d-4f7b-37b3-96ea-d39d21c40b43",
                                "text": "Tu crois que je ne t’ai pas vue, là, à babinoter de la goule dans ton coin."
                            }
                        ]
                    }
                ],
