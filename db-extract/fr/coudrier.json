                                    {
                                        "sense_id": "3ec1e33f-414d-3aaf-8dc6-92b2ba3106db",
                                        "entry_id": "aa3cfcd6-d90a-3e09-a032-170f57b69382",
                                        "glosses": [
                                            "A tree or shrub of the genus Corylus, bearing edible nuts called hazelnuts or filberts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f80b80b6-efbd-4da5-b74e-067d8fc7094e",
                                                "sense_id": "3ec1e33f-414d-3aaf-8dc6-92b2ba3106db",
                                                "text": "The green turf was velvet underfoot. The blackbirds fluted in the hazels there."
                                            },
                                            {
                                                "example_id": "7d9e0a3c-ba6b-40b8-ae7f-a819eae3fa43",
                                                "sense_id": "3ec1e33f-414d-3aaf-8dc6-92b2ba3106db",
                                                "text": "Have a tree or two the witches particularly like, such as the alder, larch, cypress and hemlock; then, to counteract any possible evil effects, there must be a holly, yew, hazel, elder, mountain ash or juniper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61674094-253a-3151-9b92-a93a21930512",
                                        "entry_id": "aa3cfcd6-d90a-3e09-a032-170f57b69382",
