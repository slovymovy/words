                                "target_senses": [
                                    {
                                        "sense_id": "d4b0d92a-6575-357e-babe-b5472bb57143",
                                        "entry_id": "9aa2a5c1-0032-32d4-8ffd-404d393e3cf1",
                                        "glosses": [
                                            "Défaire ce qui est fermé d’un sceau, d’un cachet, décacheter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2486235f-b4b8-4f87-81de-1972438cf6b0",
                                                "sense_id": "d4b0d92a-6575-357e-babe-b5472bb57143",
                                                "text": "Desceller un acte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b08b04c8-e00e-35b7-b5ea-6bcf8f7ac6f4",
                                        "entry_id": "9aa2a5c1-0032-32d4-8ffd-404d393e3cf1",
                                        "glosses": [
                                            "Détacher ce qui est scellé en plâtre, en plomb, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8bc1299-2b7a-4367-9af1-d0815cdec981",
                                                "sense_id": "b08b04c8-e00e-35b7-b5ea-6bcf8f7ac6f4",
                                                "text": "[…] elle invente un moyen de desceller sa grille, elle saute par la croisée, escalade le mur du parc, et va folâtrer chez le voisin."
                                            },
                                            {
                                                "example_id": "081c2b1e-6a58-40ad-b802-658bfb9eddb9",
                                                "sense_id": "b08b04c8-e00e-35b7-b5ea-6bcf8f7ac6f4",
                                                "text": "L'un d'eux, le plus petit, tira de sa poche un outil qui pouvait bien être un ciseau à froid et se mit avec ardeur à desceller la plaque en pratiquant des pesées de place en place."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
