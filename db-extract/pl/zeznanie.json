                ],
                "senses": [
                    {
                        "sense_id": "3e83e281-f4b5-39ea-a543-0e94b0cdbe50",
                        "entry_id": "bf6abaa9-ef95-3815-94ea-4c0f623ffcb7",
                        "glosses": [
                            "oficjalne wyjaśnienia złożone w sądzie lub przed innymi władzami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95b351da-9d47-46b4-bcc6-3b9a0588067c",
                                "sense_id": "3e83e281-f4b5-39ea-a543-0e94b0cdbe50",
                                "text": "Wczoraj przed południem złożyłem zeznanie przed sądem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "02dac85b-8db0-3c52-a91d-d942f7fc3a74",
                        "entry_id": "bf6abaa9-ef95-3815-94ea-4c0f623ffcb7",
                        "glosses": [
                            "dokument zawierający treść zeznania (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e84ebcb3-0e37-42c4-bd13-e35470be0732",
                                "sense_id": "02dac85b-8db0-3c52-a91d-d942f7fc3a74",
                                "text": "Czy sporządziłeś już swoje zeznanie podatkowe?"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b95b6a3-9c59-4ce1-a3c6-e83b7900d393",
                        "source_entry_id": "bf6abaa9-ef95-3815-94ea-4c0f623ffcb7",
                        "source_sense_id": "3e83e281-f4b5-39ea-a543-0e94b0cdbe50",
                        "target_lang_word": "testimony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "testimony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5cd8c71-97e6-30da-9dfa-3bbcdf6f9339",
                                        "entry_id": "cbaf1a46-0669-319b-a383-afc418c90490",
                                        "glosses": [
                                            "Statements made by a witness in court."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "067420ea-35c9-471d-b881-a111ca3f8156",
                                                "sense_id": "f5cd8c71-97e6-30da-9dfa-3bbcdf6f9339",
                                                "text": "The Missouri prosecutors' case against Clemons, based partly on incriminating testimony given by his co-defendants, was that Clemons was part of a group of four youths who accosted the sisters on the Chain of Rocks Bridge one dark night in April 1991."
                                            },
                                            {
                                                "example_id": "0c3a5d7c-c355-467b-b1aa-9e95589ed4b3",
                                                "sense_id": "f5cd8c71-97e6-30da-9dfa-3bbcdf6f9339",
                                                "text": "“The suspected cause of the death is believed to be the consumption of tainted alcoholic beverages,” KPL said. “Officials are in the process of collecting detailed information, evidence, and witness testimonies and are expected to release an official statement soon.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e1c839d-9ed0-3a6e-890b-1ab6dfa7d9e7",
                                        "entry_id": "cbaf1a46-0669-319b-a383-afc418c90490",
                                        "glosses": [
                                            "An account of first-hand experience."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0512724-0ba7-4343-9490-08b233c9e284",
                                                "sense_id": "1e1c839d-9ed0-3a6e-890b-1ab6dfa7d9e7",
                                                "text": "[Thou] for the testimony of truth, hast borne / Universal reproach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "063626f4-2e7e-313c-b1cf-357d8f265d38",
                                        "entry_id": "cbaf1a46-0669-319b-a383-afc418c90490",
                                        "glosses": [
                                            "In a church service (or religious service), a personal account, such as one's conversion, testimony of faith, or life testimony."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59ad6cc2-60ee-3796-8813-0727ddae5708",
                                        "entry_id": "cbaf1a46-0669-319b-a383-afc418c90490",
                                        "glosses": [
                                            "Witness; evidence; proof of some fact."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc6b8171-bdd8-4460-a793-a382d7783a45",
                                                "sense_id": "59ad6cc2-60ee-3796-8813-0727ddae5708",
                                                "text": "And whoſoeuer ſhall not receiue you, noꝛ heare you, when yee depart thence, *ſhake off the duſt vnder your feet, foꝛ a teſtimonie against them: Uerely I ſay vnto you, it ſhalbe moꝛe tolerable for Sodom and Gomoꝛrha in the day of iudgement, then foꝛ that citie."
                                            },
                                            {
                                                "example_id": "a6f40539-bba4-4341-b383-5eca825f1eec",
                                                "sense_id": "59ad6cc2-60ee-3796-8813-0727ddae5708",
                                                "text": "Of course, the testimony of the early writers on orthography and pronunciation on the question under discussion is not always easy to interpret, especially when they offer comparisons with foreign sounds or when they give descriptions derived from other sources or from classical models."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cf5e41a-4f46-41db-8880-eea665520bfe",
                        "source_entry_id": "bf6abaa9-ef95-3815-94ea-4c0f623ffcb7",
                        "source_sense_id": "3e83e281-f4b5-39ea-a543-0e94b0cdbe50",
                        "target_lang_word": "показание",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "показание",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bce35271-53ec-38fc-87ba-dcf34b4d4851",
                                        "entry_id": "fbf4fbb8-dae2-3bb5-97c2-ceeb21300fa6",
                                        "glosses": [
                                            "юр. устное или письменное изложение обстоятельств какого-нибудь дела со стороны допрашиваемого"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd8bb3ec-d281-4c7e-b91b-0a7780a85ff5",
                                                "sense_id": "bce35271-53ec-38fc-87ba-dcf34b4d4851",
                                                "text": "Но подсудимый дал ясное и твёрдое показание о том, откуда взял деньги."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37661c86-e219-319f-a358-719609c742d1",
                                        "entry_id": "fbf4fbb8-dae2-3bb5-97c2-ceeb21300fa6",
                                        "glosses": [
                                            "значение, величина, показываемая измерительным прибором"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4585192e-934d-489c-bb7a-a04b321e3c86",
                                                "sense_id": "37661c86-e219-319f-a358-719609c742d1",
                                                "text": "С Золотого острова сообщили, что дирижабль вылетел, несмотря на угрожающие показания барометра."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c3491d3-a676-33d0-b1c7-54372711d8cd",
                                        "entry_id": "fbf4fbb8-dae2-3bb5-97c2-ceeb21300fa6",
                                        "glosses": [
                                            "данные, указывающие на необходимость или целесообразность применения какого-либо средства или действия (обычно мед.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c23ff36-fe00-4b6c-b303-7ee0702e0106",
                                                "sense_id": "4c3491d3-a676-33d0-b1c7-54372711d8cd",
                                                "text": "Если же у кого-то из родственниц по материнской линии был рак яичников или матки, то для вас это прямое показание к применению препарата!."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41ec3190-efa4-3ca6-884d-0fc1c4a1f046",
                                        "entry_id": "fbf4fbb8-dae2-3bb5-97c2-ceeb21300fa6",
                                        "glosses": [
                                            "устар. действие по значению гл. показывать, показать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe9b453f-62c4-44d1-8003-a7881cf7ed37",
                                                "sense_id": "41ec3190-efa4-3ca6-884d-0fc1c4a1f046",
                                                "text": "Адъютант предуведомил дежурного, что я пришелец из XIX века, и чиновник, осмотрев меня с любопытством с головы до ног, предложил мне свои услуги для показания всего, находящегося в этом хранилище."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc643e08-00cd-3948-a141-97c288955030",
                                        "entry_id": "fbf4fbb8-dae2-3bb5-97c2-ceeb21300fa6",
                                        "glosses": [
                                            "свидетельство, знак, по которому можно судить, догадываться о чём-либо"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
