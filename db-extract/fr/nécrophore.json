                                                "sense_id": "092d5747-bb97-333f-9025-ad436b7f59c6",
                                                "text": "Einige Arten der Aaskäfer sind augenlos und in unterirdischen Höhlen verbreitet."
                                            },
                                            {
                                                "example_id": "45f5ee35-e351-458b-9c84-ba9cc9a75d9b",
                                                "sense_id": "092d5747-bb97-333f-9025-ad436b7f59c6",
                                                "text": "Der Totengräber ist zu den Aaskäfern zu zählen"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
