                "senses": [
                    {
                        "sense_id": "094ca95f-0df1-33b8-9567-a4389586d256",
                        "entry_id": "5681210c-8548-30dd-bbad-865447f4b426",
                        "glosses": [
                            "A conventionally defined time interval in a schedule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "356d0f26-2f89-4906-ab19-78eb9386fb9a",
                                "sense_id": "094ca95f-0df1-33b8-9567-a4389586d256",
                                "text": "Prime-time television has two- to four-hour-long timeslots."
                            },
                            {
                                "example_id": "8e5120bb-35c0-45c2-a5a9-2c2af73fb5c1",
                                "sense_id": "094ca95f-0df1-33b8-9567-a4389586d256",
                                "text": "At the peak of its success, the show drew 3.9 million viewers per week to its Sunday night timeslot."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1cc70823-bbd9-4cb1-8c47-3cd1725cc813",
                        "source_entry_id": "5681210c-8548-30dd-bbad-865447f4b426",
                        "source_sense_id": "094ca95f-0df1-33b8-9567-a4389586d256",
                        "source_sense_description": "Translations",
                        "target_lang_word": "tijdvenster",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1a72388a-e474-4c90-a574-0ed084ce85c9",
                        "source_entry_id": "5681210c-8548-30dd-bbad-865447f4b426",
                        "source_sense_id": "094ca95f-0df1-33b8-9567-a4389586d256",
                        "source_sense_description": "Translations",
                        "target_lang_word": "tijdslot",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tijdslot",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ff04badd-cde1-38e8-b896-a2497d1fe905",
                                        "entry_id": "b57ab046-4ed8-31fd-ab28-4725591f6317",
                                        "glosses": [
                                            "afsluitmechanisme van een kluis of ruimte waarin een of meer uurwerken zijn verwerkt zodat het na opening met sleutel of code pas ontgrendelt na een bepaalde tijd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b513af79-7a70-4dec-b8b9-90ccecfa4a56",
                                                "sense_id": "ff04badd-cde1-38e8-b896-a2497d1fe905",
                                                "text": "Ze dachten waarschijnlijk dat hij zijn dagomzet bij zich had, maar dat stadium van naïviteit is deze ondernemer allang voorbij. Hij roomt zijn kassa regelmatig af en stopt tussentijds geld in de kluis met tijdslot, zijn geld gaat nooit rond hetzelfde tijdstip zijn winkel uit."
                                            },
                                            {
                                                "example_id": "85fa7543-2598-45db-8438-8db9a23f9231",
                                                "sense_id": "ff04badd-cde1-38e8-b896-a2497d1fe905",
                                                "text": "Maar ik maakte me toch zorgen, en ik was opgelucht toen ik eindelijk weer kon vertrekken, weg uit dat benauwde appartement met die zware, sponzige tapijten, weg uit die luxegevangenis met tijdsloten op de deuren, weg van Paranoia City waar je via televisieschermen met mensen moest praten."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tijdslot",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2a1b4f29-2fb0-3965-8fbe-5ee3ecb428d9",
                                        "entry_id": "1bee045a-37fb-3e72-9743-1bf145f2a575",
                                        "glosses": [
                                            "afgebakende periode waarbinnen men recht op iets heeft, zoals toegang tot een tentoonstelling of zendtijd in een reclameblok"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a69f6761-8967-45bc-aac2-25aea0b36f92",
                                                "sense_id": "2a1b4f29-2fb0-3965-8fbe-5ee3ecb428d9",
                                                "text": "Volgens TUI heeft het ministerie ’grote steken’ laten vallen. „Alle gaatjes op Schiphol moeten worden gevuld, bijvoorbeeld met niet gebruikte tijdslots uit de winterperiode. Na 2020 kunnen er makkelijk 50.000 vluchten bij binnen de normen.”"
                                            },
                                            {
                                                "example_id": "b8ea602b-a725-42fa-844d-2f5e7a717922",
                                                "sense_id": "2a1b4f29-2fb0-3965-8fbe-5ee3ecb428d9",
                                                "text": "De Super Bowl is de finale van het American Football-seizoen en het grootste eendaagse sportevenement in de Verenigde Staten. Reclamespotjes rondom de nationale uitzending van NBC kosten zomaar $5 miljoen, maar zoveel kon Stephen Eimers niet betalen. De man gokt erop dat president Trump de wedstrijd bekijkt vanaf zijn golfresort in Mar-a-Lago en heeft een tijdslot gekocht op een lokaal netwerk: voor $1000."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ef4393f-eea9-4dbb-94f3-5260f92a9959",
                        "source_entry_id": "5681210c-8548-30dd-bbad-865447f4b426",
                        "source_sense_id": "094ca95f-0df1-33b8-9567-a4389586d256",
                        "source_sense_description": "Translations",
                        "target_lang_word": "tijdblok",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tijdblok",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e7fbe0ba-266e-3a8f-a054-418e308aa024",
                                        "entry_id": "6c7ab32e-7b98-3b22-9b22-6df74dcc84ee",
                                        "glosses": [
                                            "een tijdseenheid die in een bepaalde situatie wordt gebruikt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d051512c-1022-4a1d-ba50-b4beda314a22",
                                                "sense_id": "e7fbe0ba-266e-3a8f-a054-418e308aa024",
                                                "text": "Ook zijn er DBC’s die op tijdblokken gebaseerd zijn. Dit motiveert zorgverleners om net een paar minuten meer te schrijven zodat ze net over de grens van de volgende code komen. Als je aan je zorgverzekeraar uitleg vraagt dan krijg je een lijst met onbegrijpelijke codes. De verzekeraars interesseert het niet. Hun winst is een percentage van de gedeclareerde zorg, dus hoe meer zorg, hoe liever. Hoog tijd voor een ander systeem, gebaseerd op zuinigheid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26298670-47e2-37dc-877d-4e8688fcae7e",
                                        "entry_id": "6c7ab32e-7b98-3b22-9b22-6df74dcc84ee",
                                        "glosses": [
                                            "een bepaalde tijdsperiode met een duidelijke begin- en eindtijd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f090483-7343-4458-ba16-8571e124d4bc",
                                                "sense_id": "26298670-47e2-37dc-877d-4e8688fcae7e",
                                                "text": "De wereld draait door (VARA) van Nederland 3 naar Nederland 1. Niet omdat Van Nieuwkerk zo aandrong, maar omdat het netmanagement dat het beste vindt voor de publieke tv. Dat wil zeggen: het gaat door tenzij een andere omroep een beter plan indient voor het programmaslot (tijdblok in het uitzendschema) tussen 19.00 en 20.00 uur. Dat lijkt onwaarschijnlijk, maar dat is wel de officiële lijn van de Nederlandse Publieke Omroep (NPO)."
                                            },
                                            {
                                                "example_id": "9179cf04-603d-49b0-91bd-8708fd4765ed",
                                                "sense_id": "26298670-47e2-37dc-877d-4e8688fcae7e",
                                                "text": "Wil je meer rust in je schema? Reserveer dan enkele weken vooruit tijdblokken in je agenda om ongestoord te kunnen werken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a81b24b-3e95-436b-b701-86d80c290af9",
                        "source_entry_id": "5681210c-8548-30dd-bbad-865447f4b426",
                        "source_sense_id": "094ca95f-0df1-33b8-9567-a4389586d256",
                        "source_sense_description": "Translations",
                        "target_lang_word": "créneau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "créneau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Espace entre deux merlons en haut d’un rempart, pour tirer sur l'ennemi, tout en restant abrité de son tir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f85bfd0-322b-472b-ab19-54f4fa578ea8",
                                                "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                                "text": "L’unique fenêtre s’ouvrait sur une petite terrasse surmontant la tourelle, […] mais elle vit bientôt qu’elle ne communiquait avec aucune partie des créneaux."
                                            },
                                            {
                                                "example_id": "343d1d38-8fda-4a44-9e78-8497f97da186",
                                                "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                                "text": "Elle se penche entre les noirs créneaux de moment en moment, et observe d'un oeil attentif l'ennemi dans son camp."
                                            },
                                            {
                                                "example_id": "133f8fc6-e052-4c3d-a025-b0caf3c3a693",
                                                "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                                "text": "Or, cette surélévation est construite en pierres avec bossages, les créneaux sont plus espacés, l’appareil beaucoup plus soigné que dans la partie inférieure."
                                            },
                                            {
                                                "example_id": "89b71505-3669-4484-a324-675251e11b99",
                                                "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                                "text": "Cela fait, le gars aux biques alla se poster à un créneau et se mit à envoyer aux tirailleurs allemands des balles bien dirigées."
                                            },
                                            {
                                                "example_id": "a7f77566-c405-43a7-ae20-9b422165d234",
                                                "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                                "text": "La loge du concierge figure une tour carrée, avec une plate-forme à créneaux, garnie d'échauguettes."
                                            },
                                            {
                                                "example_id": "8fa31f00-1474-4242-9824-ec99aec340d1",
                                                "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                                "text": "Il passa une heure entière à se promener dans le hall, allant d’une pièce à l’autre, dans un silence fortifié, par les créneaux duquel il lançait parfois un regard éperdu, ne voulant, ne pouvant rien dire à personne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceca25f7-0f49-36cd-90d6-a04cf6e67d00",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Ouverture faite au parapet des tranchées, par lesquelles on peut tirer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ff88a18-098d-3a24-a97d-51cb8bf5a87f",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Intervalle que les pelotons laissent entre eux dans l’ordre de bataille et où se placent les chefs de peloton."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e53abbc4-45c8-3e91-9fb6-7108821e8354",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Manœuvre pour mettre en stationnement le long d’un trottoir, un véhicule entre deux autres déjà stationnés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a73397c3-24c8-4d96-b701-5e3e1104c715",
                                                "sense_id": "e53abbc4-45c8-3e91-9fb6-7108821e8354",
                                                "text": "Dans les livres de code de la route, il y a trois types de stationnement : en épi, en bataille ou en créneau."
                                            },
                                            {
                                                "example_id": "fce8cf46-cd00-402c-a34a-6b8916d97082",
                                                "sense_id": "e53abbc4-45c8-3e91-9fb6-7108821e8354",
                                                "text": "Rater un créneau le jour du permis, ça peut être éliminatoire."
                                            },
                                            {
                                                "example_id": "7ff9f711-4415-4ebf-afe1-947e02457096",
                                                "sense_id": "e53abbc4-45c8-3e91-9fb6-7108821e8354",
                                                "text": "Certains modèles sont équipés de systèmes électroniques qui aident le conducteur à faire son créneau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbb7c54f-5145-3ad1-a3d2-24256c61e5a8",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Place disponible sur le marché, segment où peut être exploité un type de produit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54e91585-6d85-4e55-a082-3bd7e01675a1",
                                                "sense_id": "cbb7c54f-5145-3ad1-a3d2-24256c61e5a8",
                                                "text": "A peine moins pessimistes, nombre d’économistes se préoccupent surtout du retard pris par l’Europe en matière d’innovation – au risque de rater les créneaux du futur, comme celui de l’intelligence artificielle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57daf438-cef0-369f-92c5-dcd676e542b6",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Intervalle de temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a3aa80c-9ffb-4ef0-a88c-2d9cb0eab787",
                                                "sense_id": "57daf438-cef0-369f-92c5-dcd676e542b6",
                                                "text": "Notre emploi du temps divise la journée de travail en 5 créneaux."
                                            },
                                            {
                                                "example_id": "beb66212-61ed-48f6-b106-1f423ae8de3c",
                                                "sense_id": "57daf438-cef0-369f-92c5-dcd676e542b6",
                                                "text": "Il y a forcément un créneau qu'on va trouver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcab2a12-2672-3664-82ba-ed00f5c10567",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Emplacement destiné à recevoir un conteneur sur un porte-conteneurs."
                                        ],
                                        "tags": [
                                            "Transport maritime"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f34b7b3-b7fc-32be-96df-f12f075c32e3",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Créneau horaire."
                                        ],
                                        "tags": [
                                            "Transport aérien"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
