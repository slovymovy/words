                    "frequency": "High",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij wilde nog een belangrijk argument <w>inbrengen</w> tegen het voorgestelde plan.",
                            "target_lang_translations": {
                                "en": "He wanted to <w>put forward</w> another important argument against the proposed plan."
                            }
                        },
                        {
                            "text": "Tijdens de discussie kon zij weinig tegen zijn logica <w>inbrengen</w>.",
                            "target_lang_translations": {
