                "senses": [
                    {
                        "sense_id": "b4c41aa4-b70d-3b3e-b157-193b027d79a0",
                        "entry_id": "cdcfaef7-515d-3f39-94a6-9b0636bdb632",
                        "glosses": [
                            "Einstellung/Haltung mit Vorurteilen, vorgefassten Meinungen gegenüber anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7ad7879-eb7c-4b12-8c7a-a3a517f4876b",
                                "sense_id": "b4c41aa4-b70d-3b3e-b157-193b027d79a0",
                                "text": "„Fest steht, dass Mosenthal gerade in »Jephtha's Tochter« die Vorurteilsbeladenheit jüdisch-christlicher Interaktion thematisiert.“"
                            },
                            {
                                "example_id": "3a4e9fb8-52c4-45ba-aa57-30eae390dac5",
                                "sense_id": "b4c41aa4-b70d-3b3e-b157-193b027d79a0",
                                "text": "„So wird an Elisabeths Beispiel nachvollziehbar, wie sehr die Vorurteilsbeladenheit einer wenig differenziert urteilenden Mehrheit den Weg in ein soziales Abseits vorzeichnen kann.“"
                            },
                            {
                                "example_id": "a1ad0aac-cb7d-4172-8ff9-814c3898b766",
                                "sense_id": "b4c41aa4-b70d-3b3e-b157-193b027d79a0",
                                "text": "„Romantik als einer Epoche der Irrationalität und zynischen Ausblendung des Elends in der Welt artikuliert sich eine ideologische Vorurteilsbeladenheit, wie sie der Gegenseite gerade zum Vorwurf gemacht wird.“"
                            },
                            {
                                "example_id": "252325e4-f414-4353-bfc0-a9985f43dd3a",
                                "sense_id": "b4c41aa4-b70d-3b3e-b157-193b027d79a0",
                                "text": "„Je weniger klare und überzeugende Informationen in die Organisation gegeben werden, desto größer ist die Gefahr, dass sich Gerüchte bilden und eine solche Maßnahme auf Grund der Vorurteilsbeladenheit kaum mehr Chance auf Erfolg hat.“"
                            },
                            {
                                "example_id": "118278f9-063a-4a65-8dff-041c37ab7ef6",
                                "sense_id": "b4c41aa4-b70d-3b3e-b157-193b027d79a0",
                                "text": "„Hinter derartigen Verallgemeinerungen erkennt er eine prekäre Vorurteilsbeladenheit, wenn nicht gar bewusste Verleumdungen oder auch Rassismus, die dem Ziel der politischen Unterdrückung bestimmter Gruppen vorausgehen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
