                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f73183ab-a7a5-3502-a76e-3fb5b47a212a",
                        "entry_id": "6c5964fc-e128-396b-b280-1355fca02633",
