                    {
                        "translation_id": "d12a2bed-debb-4381-a293-6962e0d2b9f6",
                        "source_entry_id": "abd3e5f8-b3e0-3629-9e5d-fd983f49794f",
                        "source_sense_id": "25011def-69b6-3009-82ff-179e13a6aa1b",
                        "source_sense_description": "having cohesion",
                        "target_lang_word": "сплочённый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сплочённый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5700d4cb-30ed-3c47-8209-c93e53d20e40",
                                        "entry_id": "fa21059f-779b-319e-8935-a234aabfd92c",
                                        "glosses": [
                                            "спец. соединённый в плоты (о брёвнах, лесе и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "сплочённый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c9be23e2-f077-3118-99be-46ca28e241be",
                                        "entry_id": "4aa4aff8-aaee-3c80-aa89-5001596b7e7f",
                                        "glosses": [
                                            "соединённый вплотную, состоящий из сомкнутых друг с другом частей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f74facec-b776-458d-8405-bdf65eeed4cf",
                                                "sense_id": "c9be23e2-f077-3118-99be-46ca28e241be",
                                                "text": "Квадраты досок и брёвен, тесно сплочённые одни возле других, возвышались над землею более чем на три сажени."
                                            },
                                            {
                                                "example_id": "4e47897d-3caf-4f01-9bbb-6da28fba39b3",
                                                "sense_id": "c9be23e2-f077-3118-99be-46ca28e241be",
                                                "text": "И почему-то не казалось унизительно сидеть сплочённой грязной кучкой на земле в каком-то закутке…"
                                            },
                                            {
                                                "example_id": "b139db7a-6442-473d-b987-bf013f0d97d9",
                                                "sense_id": "c9be23e2-f077-3118-99be-46ca28e241be",
                                                "text": "Здесь не прыгают клавиши одна за другою, а всё движется стройно, цельно, как будто каждый солдат сплочён с другими."
                                            },
                                            {
                                                "example_id": "b51f911d-743b-4e3a-b74f-cfd58bf63b3e",
                                                "sense_id": "c9be23e2-f077-3118-99be-46ca28e241be",
                                                "text": "Тяжёлым запахом погреба веяло мне в лицо от этой груды мелких, тесно сплочённых камней, с которых давно свалилась гранитная оболочка стены."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e544350d-a5c3-32de-a3c3-0bdf7c375e07",
                                        "entry_id": "4aa4aff8-aaee-3c80-aa89-5001596b7e7f",
                                        "glosses": [
                                            "перен. единодушный, дружный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6859835a-142d-4d55-b1d9-1d54ce9c6979",
                                                "sense_id": "e544350d-a5c3-32de-a3c3-0bdf7c375e07",
                                                "text": "Если вы будете достаточно упорны и сплочённы, скорее всего вам пойдут навстречу."
                                            },
                                            {
                                                "example_id": "2ccb3c52-8e79-41b8-b9b2-e92a308908a6",
                                                "sense_id": "e544350d-a5c3-32de-a3c3-0bdf7c375e07",
                                                "text": "― Угу. На редкость сплоченный коллектив попался. У них даже на всех одна девица была."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "сплочённый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "590ee4f0-f9d6-383b-8668-039d1f415f49",
                                        "entry_id": "6bcc9afe-6ec4-33f0-915b-3b48ca3137ae",
                                        "glosses": [
                                            "страд. прич. прош. вр. от сплотить"
                                        ],
                                        "tags": [
                                            "participle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dd411a7-646e-47e4-ade0-6b61e979cbe9",
                                                "sense_id": "590ee4f0-f9d6-383b-8668-039d1f415f49",
                                                "text": "Рядом с табуреткой, где светилась сосновая ветвь, были сплочены две тумбочки, образуя как бы стол."
                                            },
                                            {
                                                "example_id": "52a798b5-257c-441e-b422-29ec979509dc",
                                                "sense_id": "590ee4f0-f9d6-383b-8668-039d1f415f49",
                                                "text": "Двери в башню, сплочённые из толстых дубовых досок и заваленные внутри камнем, находились сажени три выше почвы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
