        "fr-extract.jsonl": [
            {
                "entry_id": "3395c40f-8b33-38fc-99a3-6ea60a111cd2",
                "word": "unicorne",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c31d32a0-795c-4519-9bad-fac87ebe6206",
                        "entry_id": "3395c40f-8b33-38fc-99a3-6ea60a111cd2",
                        "tags": [
                            "plural"
                        ],
