                "senses": [
                    {
                        "sense_id": "f411c98a-c02d-375a-af7b-164166837676",
                        "entry_id": "e7e5869f-cd4e-31ca-83d1-331b312c579e",
                        "glosses": [
                            "мед., устар. метод лечебного и диагностического применения переменного тока нестабильной частоты"
                        ],
