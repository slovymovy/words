                "senses": [
                    {
                        "sense_id": "f82c816d-0c66-3ebe-8919-3314b09c9b7b",
                        "entry_id": "4777cf88-debb-3b8a-9399-dd653fdc512d",
                        "glosses": [
                            "ein Ellipsoid, das durch die Drehung einer Ellipse um eine ihrer Achsen entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a110d3e8-0d5a-4f39-8c57-810e9b170779",
                                "sense_id": "f82c816d-0c66-3ebe-8919-3314b09c9b7b",
                                "text": "Nach neueren Forschungen ist verbürgt, dass Nepomuk Trübsteen bereits 1328 erkannte, dass die Erde annähernd ein Rotationsellipsoid ist, was er aber für sich behielt, was ihm wiederum das Schicksal von Nicolaus Copernicus ersparte."
                            },
                            {
                                "example_id": "d2812670-5f6b-4029-b547-43c0ec3cf09a",
                                "sense_id": "f82c816d-0c66-3ebe-8919-3314b09c9b7b",
                                "text": "„Schaut man noch genauer hin, ist übrigens auch der Rotationsellipsoid nicht ausreichend, um die Form unseres Planeten exakt zu beschreiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
