                                    {
                                        "sense_id": "54dd9deb-cf09-3b76-9b6c-3febc02ba39e",
                                        "entry_id": "80804643-a205-3c7f-81d9-78fe1dd04b01",
                                        "glosses": [
                                            "A brake which can be used by passengers in a vehicle to stop in event of an emergency."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edf09d1c-6b46-4080-af7d-f4eb24a4f1ef",
                                                "sense_id": "54dd9deb-cf09-3b76-9b6c-3febc02ba39e",
                                                "text": "At 0725, the driver operated the emergency brakes to no immediate effect. [...] As the train passed through Platform 11 at around 30mph, the train manager realised there was a problem and applied the emergency brake, bringing the train to a stand [...]."
                                            }
                                        ]
                                    },
