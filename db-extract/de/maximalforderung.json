                "senses": [
                    {
                        "sense_id": "099ffd36-838f-37d2-8c6c-a42c665313ce",
                        "entry_id": "e444e2a3-2ef8-3ea0-b7a2-7f97a9282119",
                        "glosses": [
                            "extrem hohe/anspruchsvolle Forderung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2622d8ec-f4d5-47e6-b891-a2a2df34ed48",
                                "sense_id": "099ffd36-838f-37d2-8c6c-a42c665313ce",
                                "text": "„Diese Maximalforderungen waren eine direkte Provokation der Staatsmacht.“"
                            },
                            {
                                "example_id": "56bb50eb-7c75-48d1-bff5-ebbb0ba5a337",
                                "sense_id": "099ffd36-838f-37d2-8c6c-a42c665313ce",
                                "text": "„Dabei waren Unbeugsamkeit und Kompromisslosigkeit wichtig, denn nur derjenige, der bis zum Ende an seinen Maximalforderungen festhielt, konnte den Sieg davontragen.“"
                            },
                            {
                                "example_id": "de231521-5e2d-4633-9eeb-00edfbff7913",
                                "sense_id": "099ffd36-838f-37d2-8c6c-a42c665313ce",
                                "text": "„Seitdem hat Russland sich in keiner Weise verhandlungsbereit gezeigt und beharrt auf den Maximalforderungen, die es seit Beginn seiner Invasion in die Ukraine erhebt.“"
                            },
                            {
                                "example_id": "b2ef4958-7fb1-41ef-b8e9-185697410774",
                                "sense_id": "099ffd36-838f-37d2-8c6c-a42c665313ce",
                                "text": "„Russland bekräftigte zudem wieder, es wolle eine Lösung für die «Kernprobleme des Konflikts». So umschreibt es seine Maximalforderungen: die Kapitulation und Unterwerfung der Ukraine.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
