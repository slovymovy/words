                        "zh": "和谐一致的；意见或看法统一的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "согласны",
                                "target_lang_sense_clarification": "имеющие общее мнение"
                            },
                            {
                                "target_lang_word": "единодушны",
                                "target_lang_sense_clarification": "полное совпадение мнений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意见一致的",
                                "target_lang_sense_clarification": "对某事看法相同"
                            },
                            {
                                "target_lang_word": "一致赞同的",
                                "target_lang_sense_clarification": "大家均表赞成"
                            }
                        ]
                    }
                }
            ]
        },
        {
