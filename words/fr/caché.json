        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7fc71c53-44e9-3341-b305-4d5e1c02a058",
                    "sense_definition": "Participe passé masculin singulier de <w>cacher</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cacher_forme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voleur a <w>caché</w> les bijoux volés sous le plancher de sa chambre.",
                            "target_lang_translations": {
                                "en": "The thief <w>hid</w> the stolen jewellery under the floorboards of his room.",
                                "ru": "Вор <w>спрятал</w> украденные драгоценности под половицами своей комнаты.",
                                "de": "Der Dieb hat die gestohlenen Juwelen unter den Dielen seines Zimmers <w>versteckt</w>.",
                                "es": "El ladrón ha <w>escondido</w> las joyas robadas bajo las tablas del suelo de su habitación.",
                                "zh": "小偷把偷来的珠宝<w>藏</w>在了卧室的地板下面。"
                            }
                        },
                        {
                            "text": "Pourquoi as-tu <w>caché</w> cette mauvaise nouvelle à tes parents pendant si longtemps ?",
                            "target_lang_translations": {
                                "en": "Why have you <w>hidden</w> this bad news from your parents for so long?",
                                "ru": "Почему ты так долго <w>скрывал</w> эту плохую новость от родителей?",
                                "de": "Warum hast du deinen Eltern diese schlechte Nachricht so lange <w>verheimlicht</w>?",
                                "es": "¿Por qué has <w>ocultado</w> esta mala noticia a tus padres durante tanto tiempo?",
                                "zh": "你为什么对父母<w>隐瞒</w>这个坏消息这么久？"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past participle of the verb hide, masculine singular form.",
                        "ru": "Причастие прошедшего времени мужского рода единственного числа от глагола «прятать» или «скрывать».",
                        "de": "Maskulines Partizip Perfekt im Singular von „verstecken“ oder „verheimlichen“.",
                        "es": "Forma masculina singular del participio pasado de «cacher», que significa esconder u ocultar.",
                        "zh": "动词“藏”的过去分词阳性单数形式，表示把东西藏起来或隐瞒事情。"
                    },
