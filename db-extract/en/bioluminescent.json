                        "cross_references": [
                            {
                                "target_word": "bioluminescent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac49f27d-7a7e-3a90-aa5c-364dff46cb58",
                                        "entry_id": "5b403b34-a1e2-3d99-bab5-b933da269952",
                                        "glosses": [
                                            "Qualifie un phénomène biologique qui produit de la lumière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65cd0a13-5551-47eb-9124-9be6146eedc9",
                                                "sense_id": "ac49f27d-7a7e-3a90-aa5c-364dff46cb58",
                                                "text": "Dans l’après-midi et durant la première partie de la migration liée au coucher du soleil, un crochet isolé occasionnel indiquant un éclat bioluminescent apparait sur le tracé."
                                            },
                                            {
                                                "example_id": "444fb1ba-4581-400a-b3f1-520c48cd84a7",
                                                "sense_id": "ac49f27d-7a7e-3a90-aa5c-364dff46cb58",
                                                "text": "De nombreux poissons des abysses sont bioluminescents (c’est-à-dire qu’ils produisent leur propre lumière) mais, bien souvent, les signaux lumineux sont destinés aux ennemis (prédateurs et proies) plutôt qu’aux partenaires sexuels."
                                            },
                                            {
                                                "example_id": "77cb9b44-ffd9-483a-8a63-b1790df2017f",
                                                "sense_id": "ac49f27d-7a7e-3a90-aa5c-364dff46cb58",
                                                "text": "Entièrement noir, ce squale a également la particularité d’être bioluminescent : il possède sur son ventre des photophores, de petits organes qui produisent de la lumière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83e4caf4-94ba-481f-995c-2fd1feed75ee",
                        "source_entry_id": "2cff7e06-56fd-3eb4-95e9-ac833d4cf974",
                        "source_sense_id": "12d622d9-ac52-329e-b5c7-9c98d0a8aa81",
                        "source_sense_description": "exhibiting bioluminescence",
                        "target_lang_word": "biolumineszent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biolumineszent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a443916-f2bc-319f-ada0-a6ea4c8e1f43",
                                        "entry_id": "7631ed6f-731d-3461-ab06-1b23c36a4919",
                                        "glosses": [
                                            "zur Ausstrahlung von biochemisch erzeugtem Licht fähig"
                                        ],
                                        "tags": [
                                            "Biochemie",
                                            "Lebewesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4505c7e-d9d5-4ac3-b026-0c839e25587a",
                                                "sense_id": "5a443916-f2bc-319f-ada0-a6ea4c8e1f43",
                                                "text": "In der Dämmerzone finden sich besonders viele biolumineszente Organismen."
                                            },
                                            {
                                                "example_id": "58bb078f-4aa5-4629-ab7f-d4b9edf5238b",
                                                "sense_id": "5a443916-f2bc-319f-ada0-a6ea4c8e1f43",
                                                "text": "Biolumineszente Tiere verwenden Licht, um aufzuscheuchen, anzulocken und zu kommunizieren."
                                            },
                                            {
                                                "example_id": "233250aa-ec19-430f-b0aa-295428a011a2",
                                                "sense_id": "5a443916-f2bc-319f-ada0-a6ea4c8e1f43",
                                                "text": "Bisher hat man nur zwei Riesenkalmare gefilmt, und nur einmal haben Forscher einen Riesenkalmar aufgenommen, der biolumineszente Signale ausgesandt hat."
                                            },
                                            {
                                                "example_id": "b1ac570a-91cc-4632-b904-b9d8d5c32061",
                                                "sense_id": "5a443916-f2bc-319f-ada0-a6ea4c8e1f43",
                                                "text": "Unter den rund 100.000 heute bekannten Pilzarten gibt es 71, die biolumineszent sind, also im Dunkeln leuchten."
                                            },
                                            {
                                                "example_id": "11cd6e25-3b83-45d0-aea2-9d68c6889fed",
                                                "sense_id": "5a443916-f2bc-319f-ada0-a6ea4c8e1f43",
                                                "text": "Der Tiefsee-Anglerfisch schwimmt in bis zu 4.000 Meter Tiefe mit einem Fortsatz herum, dessen Ende mit biolumineszenten Bakterien gefüllt ist, um mit deren Licht Beute anzulocken."
                                            },
                                            {
                                                "example_id": "ea00bda7-57ee-4fd3-bec3-bf3a7e33cb3c",
                                                "sense_id": "5a443916-f2bc-319f-ada0-a6ea4c8e1f43",
                                                "text": "Außerdem erkennen sich zwei füreinander Bestimmte im Lichtermeer der vielen biolumineszenten Tieren kaum."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
