                {
                    "sense_id": "7cfa23f7-28de-3149-9250-763cd4d1f3ff",
                    "sense_definition": "To cause something to take effect or to land a physical strike or blow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer managed to <w>fasten</w> a blow to his opponent's chin.",
                            "target_lang_translations": {
                                "ru": "Боксеру удалось <w>нанести</w> удар в подбородок противника.",
                                "nl": "De bokser slaagde erin zijn tegenstander een klap op de kin <w>toe te brengen</w>.",
                                "pl": "Bokserowi udało się <w>zadać</w> cios w podbródek przeciwnika.",
                                "de": "Dem Boxer gelang es, seinem Gegner einen Schlag auf das Kinn zu <w>versetzen</w>.",
                                "fr": "Le boxeur a réussi à <w>asséner</w> un coup sur le menton de son adversaire.",
                                "it": "Il pugile è riuscito ad <w>assestare</w> un colpo al mento del suo avversario.",
                                "cs": "Boxerovi se podařilo <w>zasadit</w> úder na soupeřovu bradu.",
                                "tr": "Boksör rakibinin çenesine bir darbe <w>indirmeyi</w> başardı.",
                                "es": "El boxeador logró <w>asestar</w> un golpe en la barbilla de su oponente."
                            }
                        },
                        {
                            "text": "He tried to <w>fasten</w> a cup of wine upon his guest to make him stay.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>навязать</w> гостю чашу вина, чтобы тот остался.",
                                "nl": "Hij probeerde zijn gast een beker wijn <w>op te dringen</w> om hem te laten blijven.",
                                "pl": "Próbował <w>narzucić</w> gościowi puchar wina, aby ten został.",
                                "de": "Er versuchte, seinem Gast einen Becher Wein <w>aufzudrängen</w>, damit dieser bliebe.",
                                "fr": "Il essaya d'<w>imposer</w> une coupe de vin à son invité pour le faire rester.",
                                "it": "Ha cercato di <w>rifilare</w> una coppa di vino al suo ospite per farlo rimanere.",
                                "cs": "Snažil se svému hostu <w>vnutit</w> pohár vína, aby ho přiměl zůstat.",
                                "tr": "Kalmasını sağlamak için misafirine zorla bir kadeh şarap <w>içirmeye</w> çalıştı.",
                                "es": "Intentó <w>imponer</w> una copa de vino a su invitado para que se quedara."
                            }
                        }
                    ],
