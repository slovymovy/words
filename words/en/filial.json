{
    "word_family": [
        "filiation",
        "filiate"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "60af7117-db60-301f-aaad-b6735b67f5a6",
                    "sense_definition": "Respectful of the duties and attitudes of sons or daughters toward their parents.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "family_relations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He showed <w>filial</w> devotion by visiting his elderly parents every single weekend.",
                            "target_lang_translations": {
                                "zh": "他每个周末都去探望年迈的父母，以此表达他的<w>孝心</w>。"
                            }
                        },
                        {
                            "text": "The young man felt a strong sense of <w>filial</w> duty toward his aging mother.",
                            "target_lang_translations": {
                                "zh": "这个年轻人对年迈的母亲怀有一种强烈的<w>孝道</w>责任感。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dutiful"
                    ],
                    "antonyms": [
                        "unfilial"
                    ],
                    "common_phrases": [
                        "filial duty",
                        "filial piety"
                    ],
                    "target_lang_definitions": {
                        "zh": "指子女对父母应尽的责任、态度或孝顺之心。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "孝顺的",
                                "target_lang_sense_clarification": "形容子女对父母尽心尽力、顺从。"
                            },
                            {
                                "target_lang_word": "孝道的",
                                "target_lang_sense_clarification": "与孝顺相关的道德规范或行为。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c8dffc4-d882-3420-b0ec-aa13b796caf9",
                    "sense_definition": "Pertaining to or befitting a son or daughter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "family_relations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She performed her <w>filial</w> obligations with grace and patience.",
                            "target_lang_translations": {
                                "zh": "她优雅而耐心地履行了自己作为<w>子女</w>的义务。"
                            }
                        },
                        {
                            "text": "The inheritance was a reward for his long years of <w>filial</w> service.",
                            "target_lang_translations": {
                                "zh": "这份遗产是对他多年来尽<w>孝道</w>的奖赏。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "filial obligation"
                    ],
                    "target_lang_definitions": {
                        "zh": "作为子女应尽的或适合子女身份的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "子女的",
                                "target_lang_sense_clarification": "指代子女身份或其应有的行为。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6155e99f-37bb-3118-9e76-85c57601d463",
                    "sense_definition": "Relating to a generation or generations descending from a specific previous one, often used in genetics.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "genetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The first <w>filial</w> generation showed traits inherited from both parents.",
                            "target_lang_translations": {
                                "zh": "第一<w>子代</w>表现出了遗传自双亲的特征。"
                            }
                        },
                        {
                            "text": "Researchers analyzed the second <w>filial</w> generation to track the mutation.",
                            "target_lang_translations": {
                                "zh": "研究人员分析了第二<w>子代</w>以追踪该突变。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "filial generation"
                    ],
                    "target_lang_definitions": {
                        "zh": "指生物学中由亲代产生的后代世代。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "子代的",
                                "target_lang_sense_clarification": "遗传学用语，指亲代之后的后代。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}