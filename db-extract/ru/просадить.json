                ],
                "senses": [
                    {
                        "sense_id": "6112c9a4-3dd4-3495-9534-d4cf1f98fbfe",
                        "entry_id": "30311c26-71b3-3f83-8f0f-19e9893a8486",
                        "glosses": [
                            "разг. высадить по всей длине, площади что-либо для выращивания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00a701e0-d398-44c2-a226-1f7fec6fde5c",
                                "sense_id": "6112c9a4-3dd4-3495-9534-d4cf1f98fbfe",
                                "text": "Рассказал им метод посадки свеклы. Распределили труд. Просадили показательную грядку."
                            },
                            {
                                "example_id": "351ac7ef-b1d4-44fd-8565-64f678eebb2c",
                                "sense_id": "6112c9a4-3dd4-3495-9534-d4cf1f98fbfe",
                                "text": "Для того, чтобы почва при такой вспашке на глубину 20 см меньше иссушалась, нужно её в хозяйстве просадить в первые весенние дни, выделяя для этого участии, в наибольшей степени требующие такой вспашки."
                            }
                        ]
                    }
                ],
