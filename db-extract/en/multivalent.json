                        "glosses": [
                            "Able to bind to different parts of speech."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3de0845c-8a91-4339-b6ed-79223a6273a9",
                                "sense_id": "28a9b4e9-5a21-3827-b8fc-d165a1973fd7",
                                "text": "This procedure can be justified by considering the difficult word or compound as a separate part of a sentence of which the (verbal) adjective is the multivalent predicate, i.e. able to bind more than one part of speech."
                            },
                            {
                                "example_id": "f2a2bf83-6d8c-4abe-ae98-e42547d01b3b",
                                "sense_id": "28a9b4e9-5a21-3827-b8fc-d165a1973fd7",
                                "text": "In general terms, each of the causative suffixes derives a multivalent verb having the meaning 'to cause/make to V', where V is a variable standing for the verbal action of the base."
                            }
                        ]
