    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "64a1c43a-2b13-33d5-a3e9-8711d6912f03",
                    "sense_definition": "iemand officieel benoemen voor een bepaalde functie of taak",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "benoeming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De raad van bestuur besloot om hem als de nieuwe directeur <w>aan te stellen</w>.",
                            "target_lang_translations": {
                                "en": "The board of directors decided to <w>appoint</w> him as the new director."
                            }
                        },
                        {
                            "text": "Hij werd officieel <w>aangesteld</w> tot bestuurder van de organisatie.",
                            "target_lang_translations": {
                                "en": "He was officially <w>appointed</w> as a director of the organization."
                            }
                        }
                    ],
                    "synonyms": [
                        "benoemen"
                    ],
                    "antonyms": [
                        "ontslaan"
                    ],
                    "common_phrases": [
                        "iemand aanstellen tot",
                        "officieel aanstellen"
                    ],
                    "target_lang_definitions": {
                        "en": "To officially name someone for a specific position or task"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "appoint",
                                "target_lang_sense_clarification": "to name someone to a post or role"
                            },
                            {
                                "target_lang_word": "assign",
                                "target_lang_sense_clarification": "to designate someone to a specific task"
                            },
                            {
                                "target_lang_word": "designate",
                                "target_lang_sense_clarification": "to officially choose someone for a role"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0342af17-3733-3f37-b8a1-d34dea045d64",
                    "sense_definition": "zich overdreven of kinderachtig gedragen om aandacht te trekken of medelijden op te wekken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ach, <w>stel</w> je niet zo <w>aan</w>, het was maar een klein schrammetje!",
                            "target_lang_translations": {
                                "en": "Oh, don't <w>make such a fuss</w>, it was only a small scratch!"
                            }
                        },
                        {
                            "text": "Zij <w>stelt</w> zich altijd vreselijk <w>aan</w> als ze haar zin niet krijgt.",
                            "target_lang_translations": {
                                "en": "She always <w>acts up</w> terribly when she doesn't get her way."
                            }
                        }
                    ],
                    "synonyms": [
                        "overdrijven",
                        "theatralisch doen"
                    ],
                    "antonyms": [
                        "zich beheersen",
                        "kalm blijven"
                    ],
                    "common_phrases": [
                        "zich aanstellen",
                        "niet zo aanstellen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in informele situaties om iemands gedrag te bekritiseren."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To behave in an exaggerated or childish way to attract attention or sympathy"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "show off",
                                "target_lang_sense_clarification": "to behave in a way that attracts attention"
                            },
                            {
                                "target_lang_word": "make a fuss",
                                "target_lang_sense_clarification": "to behave in an exaggeratedly emotional way"
                            },
                            {
                                "target_lang_word": "be dramatic",
                                "target_lang_sense_clarification": "to overreact to a situation"
                            },
                            {
                                "target_lang_word": "act up",
                                "target_lang_sense_clarification": "to behave badly or childishly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "244821bc-4d07-364d-8168-9397098c30e2",
                    "sense_definition": "iets in werking stellen of op de juiste plaats installeren",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "installatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De monteur kwam langs om de nieuwe verwarmingsinstallatie <w>aan te stellen</w>.",
                            "target_lang_translations": {
                                "en": "The mechanic came by to <w>set up</w> the new heating system."
                            }
                        },
                        {
                            "text": "Nadat de machine was geplaatst, moesten we hem nog correct <w>aanstellen</w>.",
                            "target_lang_translations": {
                                "en": "After the machine was placed, we still had to <w>adjust</w> it correctly."
                            }
                        }
                    ],
                    "synonyms": [
                        "installeren",
                        "instellen",
                        "opstellen"
                    ],
                    "common_phrases": [
                        "een apparaat aanstellen"
                    ],
                    "target_lang_definitions": {
                        "en": "To put something into operation or install it in the correct place"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "set up",
                                "target_lang_sense_clarification": "to prepare equipment for use"
                            },
                            {
                                "target_lang_word": "install",
                                "target_lang_sense_clarification": "to place or fix equipment in position"
                            },
                            {
                                "target_lang_word": "adjust",
                                "target_lang_sense_clarification": "to set or regulate a machine"
                            }
                        ]
                    }
                }
            ]
        }
    ]
