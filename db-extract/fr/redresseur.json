                        "tags": [],
                        "examples": [
                            {
                                "example_id": "947f1430-3919-492e-bd36-e35129590f4f",
                                "sense_id": "75bb6a5b-3c82-33cd-84a0-98f2e371446d",
                                "text": "En général, il faut compter pouvoir utiliser au maximum une tension alternative de 6 volts par rondelle de redresseur à oxyde de cuivre et 15 volts par rondelle de redresseur au sélénium."
                            },
                            {
                                "example_id": "bae07938-dfc1-4254-88dd-69c917830664",
                                "sense_id": "75bb6a5b-3c82-33cd-84a0-98f2e371446d",
                                "text": "Voici quelques années , ces appareils nécessitaient une commutatrice fournissant le courant à la périodicité requise pour les vibrateurs. Actuellement on dispose de redresseurs plus simples et moins coûteux."
                            }
                        ]
                    }
