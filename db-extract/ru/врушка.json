                                        "entry_id": "632eedfe-d31c-36f0-8eec-85a9d8fb6260",
                                        "glosses": [
                                            "osoba, która łże"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9a28dff-386d-4b33-b693-f7f8da77b020",
                                                "sense_id": "1826e683-3034-3288-804c-41f13e18aca2",
                                                "text": "Po tym, jak po raz drugi przyłapano Józefa na kłamstwie, przylgnęła do niego opinia łgarza."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
