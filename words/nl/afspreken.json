                    "semantic_group_id": "meeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zullen we volgende week een keer <w>afspreken</w> om bij te praten?",
                            "target_lang_translations": {
                                "en": "Shall we <w>meet up</w> sometime next week to catch up?",
                                "ru": "Может, <w>встретимся</w> как-нибудь на следующей неделе, чтобы поболтать?",
                                "de": "Wollen wir uns nächste Woche mal <w>verabreden</w>, um uns mal wieder zu unterhalten?",
                                "it": "Ci <w>vediamo</w> la prossima settimana per fare due chiacchiere?",
                                "pl": "Czy możemy <w>umówić się</w> w przyszłym tygodniu, żeby porozmawiać?",
                                "fr": "Est-ce qu'on se <w>donne rendez-vous</w> la semaine prochaine pour discuter un peu ?",
                                "cs": "Co kdybychom se příští týden <w>domluvili</w> a probrali novinky?",
                                "tr": "Haftaya bir gün konuşup hasret gidermek için <w>buluşalım mı</w>?",
                                "es": "¿<w>Quedamos</w> la semana que viene para ponernos al día?",
                                "zh": "我们下周找个时间<w>见面</w>叙叙旧好吗？"
                            }
                        },
                        {
                            "text": "Ik heb met mijn vrienden in het park <w>afgesproken</w>.",
                            "target_lang_translations": {
                                "en": "I <w>arranged to meet</w> my friends in the park.",
                                "ru": "Я <w>договорился встретиться</w> с друзьями в парке.",
                                "de": "Ich habe mich mit meinen Freunden im Park <w>verabredet</w>.",
                                "it": "Mi sono <w>dato appuntamento</w> con i miei amici al parco.",
                                "pl": "Jestem <w>umówiony</w> z przyjaciółmi w parku.",
                                "fr": "Je me suis <w>donné rendez-vous</w> avec mes amis au parc.",
                                "cs": "S přáteli jsem se <w>domluvil</w> v parku.",
                                "tr": "Arkadaşlarımla parkta <w>buluşmak için sözleştim</w>.",
                                "es": "He <w>quedado</w> con mis amigos en el parque.",
                                "zh": "我<w>约好</w>和朋友们在公园见面。"
                            }
                        }
