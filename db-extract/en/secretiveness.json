                                            {
                                                "example_id": "e4ee27b8-4c24-47c5-9e0a-55b21a3ccef0",
                                                "sense_id": "e9e2a238-ff3e-3166-a5d1-06769125c519",
                                                "text": "O governo adotou um secretismo incomum sobre o desenvolvimento da nova política pública."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f33a91e-9b44-3e59-9d6b-af4ebf3e013d",
