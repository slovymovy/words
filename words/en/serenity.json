{
    "word_family": [
        "serene",
        "serenely",
        "sereneness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "353076e1-7d82-3dc7-b9fd-37d575f7ca88",
                    "sense_definition": "The state of being serene; calmness; peacefulness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "calmness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long day of work, she finally found <w>serenity</w> while sitting by the quiet lake.",
                            "target_lang_translations": {
                                "ru": "После долгого рабочего дня она наконец обрела <w>умиротворение</w>, сидя у тихого озера.",
                                "de": "Nach einem langen Arbeitstag fand sie endlich <w>Seelenruhe</w>, während sie an dem stillen See saß."
                            }
                        },
                        {
                            "text": "The yoga retreat helped him achieve a sense of inner <w>serenity</w> that he had never felt before.",
                            "target_lang_translations": {
                                "ru": "Занятия йогой помогли ему достичь чувства внутренней <w>безмятежности</w>, которого он никогда не испытывал прежде.",
                                "de": "Das Yoga-Retreat half ihm, ein Gefühl innerer <w>Gelassenheit</w> zu erlangen, das er zuvor noch nie gespürt hatte."
                            }
                        }
                    ],
                    "synonyms": [
                        "sereneness",
                        "tranquility",
                        "tranquillity",
                        "peace"
                    ],
                    "antonyms": [
                        "agitation",
                        "chaos",
                        "turmoil",
                        "anxiety"
                    ],
                    "common_phrases": [
                        "inner serenity",
                        "absolute serenity",
                        "disturb the serenity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние безмятежности, спокойствия и умиротворения.",
                        "de": "Der Zustand, heiter, ruhig und vollkommen friedlich zu sein; seelische Ausgeglichenheit."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безмятежность",
                                "target_lang_sense_clarification": "состояние полного покоя"
                            },
                            {
                                "target_lang_word": "умиротворение",
                                "target_lang_sense_clarification": "чувство внутреннего мира"
                            },
                            {
                                "target_lang_word": "спокойствие",
                                "target_lang_sense_clarification": "отсутствие тревоги"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Gelassenheit",
                                "target_lang_sense_clarification": "innere Ruhe und seelisches Gleichgewicht"
                            },
                            {
                                "target_lang_word": "Seelenruhe",
                                "target_lang_sense_clarification": "tiefer innerer Frieden"
                            },
                            {
                                "target_lang_word": "Ausgeglichenheit",
                                "target_lang_sense_clarification": "emotionales Gleichgewicht"
                            },
                            {
                                "target_lang_word": "Gemütsruhe",
                                "target_lang_sense_clarification": "psychische Ruhe und Beherrschtheit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1bd3b8e-87c2-3cda-829e-a0bb5b2ff476",
                    "sense_definition": "A lack of agitation or disturbance in one's environment or mind.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "calmness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>serenity</w> of the morning was only broken by the soft chirping of birds.",
                            "target_lang_translations": {
                                "ru": "Утреннее <w>спокойствие</w> нарушалось лишь тихим щебетанием птиц.",
                                "de": "Die morgendliche <w>Ruhe</w> wurde nur durch das leise Zwitschern der Vögel unterbrochen."
                            }
                        },
                        {
                            "text": "She found a rare <w>serenity</w> in the empty chapel at the end of the day.",
                            "target_lang_translations": {
                                "ru": "В конце дня она обрела редкое <w>спокойствие</w> в пустой часовне.",
                                "de": "Am Ende des Tages fand sie eine seltene <w>Friedlichkeit</w> in der leeren Kapelle."
                            }
                        }
                    ],
                    "synonyms": [
                        "harmony",
                        "tranquility"
                    ],
                    "antonyms": [
                        "disturbance",
                        "commotion"
                    ],
                    "common_phrases": [
                        "serenity of nature",
                        "perfect serenity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствие волнения или беспокойства в окружающей обстановке или в мыслях.",
                        "de": "Das Fehlen von Unruhe, Hektik oder Störungen in der Umgebung oder im Geist."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спокойствие",
                                "target_lang_sense_clarification": "тишина и отсутствие шума"
                            },
                            {
                                "target_lang_word": "покой",
                                "target_lang_sense_clarification": "состояние тишины и неподвижности"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Ruhe",
                                "target_lang_sense_clarification": "Stille, Abwesenheit von Lärm oder Störung"
                            },
                            {
                                "target_lang_word": "Friedlichkeit",
                                "target_lang_sense_clarification": "friedliche und ungestörte Atmosphäre"
                            },
                            {
                                "target_lang_word": "Stille",
                                "target_lang_sense_clarification": "völlige Lautlosigkeit und Ungestörtheit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7bb2e36-c05f-3655-ae7a-79f4d3ffbc18",
                    "sense_definition": "A title given to a reigning prince or similar high-ranking dignitary.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "titles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ambassador was granted an audience with His <w>Serenity</w> to discuss the new treaty.",
                            "target_lang_translations": {
                                "ru": "Послу была дарована аудиенция у Его <w>Светлости</w> для обсуждения нового договора.",
                                "de": "Dem Botschafter wurde eine Audienz bei Seiner <w>Durchlaucht</w> gewährt, um über den neuen Vertrag zu verhandeln."
                            }
                        },
                        {
                            "text": "Protocol dictates that you must address the prince as Your <w>Serenity</w> during the ceremony.",
                            "target_lang_translations": {
                                "ru": "Протокол предписывает обращаться к принцу «Ваша <w>Светлость</w>» во время церемонии.",
                                "de": "Das Protokoll schreibt vor, dass Sie den Fürsten während der Zeremonie mit Eure <w>Durchlaucht</w> ansprechen müssen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Your Serenity",
                        "His Serenity"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used as a formal title of address"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Титул, используемый при обращении к правящему принцу или другому высокопоставленному лицу.",
                        "de": "Titel und ehrenvolle Anrede für regierende Fürsten oder ranghohe Würdenträger."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светлость",
                                "target_lang_sense_clarification": "в составе официального титула"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Durchlaucht",
                                "target_lang_sense_clarification": "Adelstitel und Anredeformel"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ead77865-f94f-3a70-8604-d001ece7a040",
                    "sense_definition": "A female given name from English in general use since the 1990s.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My younger sister <w>Serenity</w> was born in 1995 and loves her unique name.",
                            "target_lang_translations": {
                                "ru": "Моя младшая сестра <w>Серенити</w> родилась в 1995 году и очень любит своё необычное имя.",
                                "de": "Meine jüngere Schwester <w>Serenity</w> wurde 1995 geboren und liebt ihren einzigartigen Namen."
                            }
                        },
                        {
                            "text": "The teacher called on <w>Serenity</w> to answer the question about the history of the town.",
                            "target_lang_translations": {
                                "ru": "Учитель вызвал <w>Серенити</w> ответить на вопрос об истории города.",
                                "de": "Der Lehrer rief <w>Serenity</w> auf, um die Frage über die Geschichte der Stadt zu beantworten."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское личное имя английского происхождения.",
                        "de": "Weiblicher Vorname aus dem Englischen, der seit den 1990er-Jahren verwendet wird."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Серенити",
                                "target_lang_sense_clarification": "транслитерация имени"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Serenity",
                                "target_lang_sense_clarification": "weiblicher Vorname"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}