                        "sense_id": "96d5ead2-f239-3a1f-8a0b-90581d8ce8ec",
                        "entry_id": "3a1e0c73-428e-3e3f-8ae2-5c6604be8f2b",
                        "glosses": [
                            "Related to or prompted by instinct."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5276f37c-5569-33d9-9af1-584fa31b77b6",
                        "entry_id": "3a1e0c73-428e-3e3f-8ae2-5c6604be8f2b",
                        "glosses": [
                            "Driven by impulse, spontaneous and without thinking."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "258010f8-1439-4a66-a09f-02ddf173f7a3",
                                "sense_id": "5276f37c-5569-33d9-9af1-584fa31b77b6",
                                "text": "When approached by a stranger, Jared clenched his fists in an instinctive manner."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83e689c2-2b4a-4e44-93a0-321108332c04",
                        "source_entry_id": "3a1e0c73-428e-3e3f-8ae2-5c6604be8f2b",
                        "source_sense_description": "related to or prompted by instinct",
                        "target_lang_word": "instinctief",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instinctief",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5157ffc2-d142-3b53-93a7-044f4d3fa38b",
                                        "entry_id": "73cd2a32-e9fe-308a-9349-91c396108f59",
                                        "glosses": [
                                            "direkt uit de instincten ontstaand zonder nadenken of beredeneren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8feed81-c93d-4df3-961c-a425d5bdfaa1",
                                                "sense_id": "5157ffc2-d142-3b53-93a7-044f4d3fa38b",
                                                "text": "Ik schaats naar de anderen toe, we schuiven een stukje op, nog iets dichter naar de rots. Het ijs is niet langer doorzichtig hier maar melkwit en bros. „Niet zo dicht bij de rots!” hoor ik Anna roepen, maar het is al te laat: samen met drie anderen zak ik door het ijs. Eerst tot mijn middel: het blok ijs waar ik op stond bevindt zich nog altijd onder me, en instinctief denk ik me erop te kunnen afzetten en zo weer uit het wak te klimmen. Maar dan schiet de minischots onder me vandaan en zink ik tot aan mijn nek. Niet kopje onder gelukkig: daar zorgt de rugzak voor."
                                            },
                                            {
                                                "example_id": "2e2c70fd-f97a-4f75-8c12-9eedfcbd88f7",
                                                "sense_id": "5157ffc2-d142-3b53-93a7-044f4d3fa38b",
                                                "text": "Mijn onzekerheid werd steeds intenser en instinctief had ik nog maar één behoefte: vluchten, weg uit de bergen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c13a96eb-f43a-4439-b9c2-6dc6a84e5662",
                        "source_entry_id": "3a1e0c73-428e-3e3f-8ae2-5c6604be8f2b",
                        "source_sense_description": "related to or prompted by instinct",
                        "target_lang_word": "instinctmatig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instinctmatig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d239ed9a-2676-3f8a-8bfe-6c27a54a9506",
                                        "entry_id": "d3dda32f-6511-30fa-95de-e3ee12ae4d09",
                                        "glosses": [
                                            "betrekking hebbend op aangeboren gedrag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c36d730-277b-4463-a8f5-83028963a935",
                                                "sense_id": "d239ed9a-2676-3f8a-8bfe-6c27a54a9506",
                                                "text": "Isaacson ten slotte: 'Was Jobs intelligent? Nee, niet buitengewoon. Maar hij was wel geniaal. De sprongen die hij in zijn verbeelding maakte waren instinctmatig, onverwacht en soms magisch.'"
                                            },
                                            {
                                                "example_id": "f01ace00-befa-49f5-b90e-4fbc8ed6021e",
                                                "sense_id": "d239ed9a-2676-3f8a-8bfe-6c27a54a9506",
                                                "text": "Directeur Adler zei geschokt te zijn. Hij vindt dat de tijger geen blaam treft. „Het dier zag een indringer in zijn territorium en viel instinctmatig aan.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1c0885b-664f-44d9-9dc9-c7b3e389d853",
                        "source_entry_id": "3a1e0c73-428e-3e3f-8ae2-5c6604be8f2b",
                        "source_sense_description": "related to or prompted by instinct",
                        "target_lang_word": "instinctif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instinctif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c77976a-01f2-3c95-a902-ee454cd80bc7",
                                        "entry_id": "c72d52e5-f691-336d-a1cb-0fc006c3733b",
                                        "glosses": [
                                            "Qui tient de l’instinct, qui naît de l’instinct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2150296-b0ec-4ee1-b68a-10d3a475c4a4",
                                                "sense_id": "3c77976a-01f2-3c95-a902-ee454cd80bc7",
                                                "text": "Silencieux, obéissant toujours dans ses rapports avec les hommes à la première impression instinctive qu'il sentait juste, il se renferma en lui-même."
                                            },
                                            {
                                                "example_id": "8a665fe4-17e9-4b98-8b87-a752108ba7b0",
                                                "sense_id": "3c77976a-01f2-3c95-a902-ee454cd80bc7",
                                                "text": "Privé de tout accommodement, […], le vice a peu de chance de séduire la vertu la plus chancelante. Elle s'en détourne avec horreur et trouve soudain dans cet instinctif revirement son équilibre et son salut"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f686bd8f-4d56-4d61-8f2d-a7a39fc9bd92",
                        "source_entry_id": "3a1e0c73-428e-3e3f-8ae2-5c6604be8f2b",
                        "source_sense_description": "related to or prompted by instinct",
                        "target_lang_word": "instinktiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instinktiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16e4f735-1e55-3493-9430-b8dff9418a7f",
                                        "entry_id": "31f856de-e6e2-31c4-b8b5-f8192a812a9b",
                                        "glosses": [
                                            "einem Trieb, angeborenen Mechanismen folgend"
                                        ],
                                        "tags": [
                                            "Tierpsychologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8581221-0e37-412a-be43-3094b51e1239",
                                                "sense_id": "16e4f735-1e55-3493-9430-b8dff9418a7f",
                                                "text": "„Vögel reagieren instinktiv, wenn ihnen etwas in der Behausung nicht zusagt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d7478475-8c43-3638-a952-c93e574734ac",
                                        "entry_id": "31f856de-e6e2-31c4-b8b5-f8192a812a9b",
                                        "glosses": [
                                            "ohne langwieriges Nachdenken, dem Gefühl, einem inneren Impuls folgend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ca2d140-9ad9-4078-9a7c-8a64102c3eab",
                                                "sense_id": "d7478475-8c43-3638-a952-c93e574734ac",
                                                "text": "„Doch dann habe der Hund die Zweijährige attackiert. Die Mutter habe instinktiv reagiert und rettete ihrer Tochter so vermutlich das Leben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa4609b5-c5d4-4f9c-ba9e-7d402085bcce",
                        "source_entry_id": "3a1e0c73-428e-3e3f-8ae2-5c6604be8f2b",
                        "source_sense_description": "related to or prompted by instinct",
                        "target_lang_word": "instynktowny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instynktowny",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "f80982b4-e48a-3a4c-8061-9c2543216f8d",
                                        "entry_id": "f46a6370-002a-3e0e-b849-cdd6ea4bb3a8",
                                        "glosses": [
                                            "od: instynkt"
                                        ],
                                        "tags": [
                                            "adjective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70711e39-5d57-4a9b-9c57-00df22f8b094",
                                                "sense_id": "f80982b4-e48a-3a4c-8061-9c2543216f8d",
                                                "text": "Ewoluując, człowiek tylko doskonalił charakterystyczne dla gatunku zachowania opiekuńcze, które są z jednej strony instynktowne, a z drugiej uwarunkowane kulturowo"
                                            },
                                            {
                                                "example_id": "bb62a3a0-1fac-4c7f-be67-c3d0f836eb7a",
                                                "sense_id": "f80982b4-e48a-3a4c-8061-9c2543216f8d",
                                                "text": "Prawdziwa miłość nie jest instynktowna, nie jest fizycznym zauroczeniem ani chęcią posiadania na wyłączność, nie jest akceptacją rozumianą jako nagroda za posłuszeństwo czy sukcesy"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
