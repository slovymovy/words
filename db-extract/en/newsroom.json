                                "target_senses": [
                                    {
                                        "sense_id": "284d5dc6-2bb8-3a62-8f17-e98cc6997cef",
                                        "entry_id": "87c83032-f1a1-3c26-99c4-8382644d7dfc",
                                        "glosses": [
                                            "die Prüfung und Bearbeitung eines Manuskriptes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d16a959-6b98-43e9-93b9-96240c8b75de",
                                                "sense_id": "284d5dc6-2bb8-3a62-8f17-e98cc6997cef",
                                                "text": "Bei der Redaktion sind mir keine groben Fehler aufgefallen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8e120b49-59dd-3ffc-b473-338cdea80e7e",
                                        "entry_id": "87c83032-f1a1-3c26-99c4-8382644d7dfc",
                                        "glosses": [
                                            "die Gesamtheit der Redakteure eines Verlags"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b35d1030-613f-426d-8b12-4b6ef5cfc1d4",
                                                "sense_id": "8e120b49-59dd-3ffc-b473-338cdea80e7e",
                                                "text": "Die ganze Redaktion befasst sich derzeit nur mit einem Thema."
                                            },
                                            {
                                                "example_id": "8ec50aaa-c92f-43e6-a2f8-989503f04897",
                                                "sense_id": "8e120b49-59dd-3ffc-b473-338cdea80e7e",
                                                "text": "„Für Korrespondenten wie mich ist das natürlich äußerst praktisch, denn auch deutsche Redaktionen vertrauen diesen Ranglisten blind.“"
                                            },
                                            {
                                                "example_id": "3ddb44cf-0dd8-4689-8788-1773d1f011e5",
                                                "sense_id": "8e120b49-59dd-3ffc-b473-338cdea80e7e",
                                                "text": "„Die Redaktionen in Deutschland scheinen sich bestens an den Service aus Krakau gewöhnt zu haben.“"
                                            },
                                            {
                                                "example_id": "5abc78b8-9bc1-4bcb-be59-fb782f2d7982",
                                                "sense_id": "8e120b49-59dd-3ffc-b473-338cdea80e7e",
                                                "text": "„Man hatte sich mit der Redaktion geeinigt, den Alien besser nicht zu erwähnen.“"
                                            },
                                            {
                                                "example_id": "d3dd4ce2-94de-4b0e-9add-dee575bef4a6",
                                                "sense_id": "8e120b49-59dd-3ffc-b473-338cdea80e7e",
                                                "text": "„Die Redaktion greift kräftig in die Gefühlskiste, rührend und mit Sinn für den Zeitgeist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3387c7ef-14ae-3e78-a40c-eb2357dd7cae",
                                        "entry_id": "87c83032-f1a1-3c26-99c4-8382644d7dfc",
                                        "glosses": [
                                            "Gebäude oder Raum, in dem die Redakteure arbeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba55619f-1fd3-4bf1-8602-2222c8430c0f",
                                                "sense_id": "3387c7ef-14ae-3e78-a40c-eb2357dd7cae",
                                                "text": "Der Chef ist gerade in die Redaktion gegangen."
                                            },
                                            {
                                                "example_id": "8a67a2e8-1e08-42c7-974f-b000369cc039",
                                                "sense_id": "3387c7ef-14ae-3e78-a40c-eb2357dd7cae",
                                                "text": "„Weil ihm ein Taxi wie Luxus vorkam, war er mit der Tram zur Redaktion gefahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
