                "senses": [
                    {
                        "sense_id": "66f932e8-daf9-3c88-b188-2c959aa90329",
                        "entry_id": "0534f9ab-0d11-39c3-94eb-8f3a2310ee85",
                        "glosses": [
                            "Connaître à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b18cc1f4-37d5-4c9d-81c4-4245723f4615",
                                "sense_id": "66f932e8-daf9-3c88-b188-2c959aa90329",
                                "text": "Accompagner à « re-connaître » les Acquis de l’Expérience en milieu carcéral"
                            },
                            {
                                "example_id": "4230af0b-d4de-4709-90c2-30da4afea0bf",
                                "sense_id": "66f932e8-daf9-3c88-b188-2c959aa90329",
                                "text": "Si l’homme se connaît, c’est parce qu’il est re-connu par un autre : l’effet miroir lui renvoie son image ; de même l’autre se connaît parce qu’il le re'''-connaît."
                            },
                            {
                                "example_id": "bb8deb99-86f5-416e-b616-a79aded1611a",
                                "sense_id": "66f932e8-daf9-3c88-b188-2c959aa90329",
                                "text": "Et nul ne voyait ce qui crevait pourtant les yeux et que cette brave fille, Ursula, comprenait d’instinct : qu’elle était un miroir ou Stéphane et Carlotta s’épiaient, se re-connaissaient…"
                            }
                        ]
                    }
