{
    "word_family": [
        "vicinal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9f9ade2d-c49d-3565-a38c-a65be35ff61b",
                    "sense_definition": "The area near or surrounding a particular place.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "location_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There are several excellent restaurants in the <w>vicinity</w> of the hotel.",
                            "target_lang_translations": {
                                "ru": "В <w>окрестностях</w> отеля есть несколько отличных ресторанов.",
                                "es": "Hay varios restaurantes excelentes en los <w>alrededores</w> del hotel."
                            }
                        },
                        {
                            "text": "Police searched the immediate <w>vicinity</w> for any sign of the missing keys.",
                            "target_lang_translations": {
                                "ru": "Полиция обыскала ближайшие <w>окрестности</w> на предмет пропавших ключей.",
                                "es": "La policía buscó en las <w>inmediaciones</w> cualquier rastro de las llaves perdidas."
                            }
                        }
                    ],
                    "synonyms": [
                        "neighborhood",
                        "locality",
                        "area",
                        "surroundings"
                    ],
                    "common_phrases": [
                        "in the vicinity",
                        "immediate vicinity",
                        "surrounding vicinity",
                        "general vicinity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Территория, прилегающая к определенному месту или окружающая его.",
                        "es": "Zona cercana o que rodea un lugar determinado."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окрестность",
                                "target_lang_sense_clarification": "окружающая местность"
                            },
                            {
                                "target_lang_word": "округа",
                                "target_lang_sense_clarification": "окружающая местность, разг."
                            },
                            {
                                "target_lang_word": "соседство",
                                "target_lang_sense_clarification": "смежная территория"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "alrededores",
                                "target_lang_sense_clarification": "zona circundante"
                            },
                            {
                                "target_lang_word": "inmediaciones",
                                "target_lang_sense_clarification": "zona muy próxima a un lugar"
                            },
                            {
                                "target_lang_word": "cercanías",
                                "target_lang_sense_clarification": "lugar cercano o próximo"
                            },
                            {
                                "target_lang_word": "vecindad",
                                "target_lang_sense_clarification": "contorno o barrio adyacente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0311ced7-9304-31c1-8fb6-a8bea4277602",
                    "sense_definition": "An approximate amount, number, or size.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The repairs to the old car will cost in the <w>vicinity</w> of five hundred dollars.",
                            "target_lang_translations": {
                                "ru": "Ремонт старой машины обойдется в <w>районе</w> пятисот долларов.",
                                "es": "Las reparaciones del coche viejo costarán <w>alrededor de</w> quinientos dólares."
                            }
                        },
                        {
                            "text": "He weighs somewhere in the <w>vicinity</w> of eighty kilograms.",
                            "target_lang_translations": {
                                "ru": "Он весит где-то в <w>районе</w> восьмидесяти килограммов.",
                                "es": "Pesa <w>aproximadamente</w> unos ochenta kilos."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the vicinity of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приблизительное количество, число или размер.",
                        "es": "Cantidad, número o tamaño aproximado."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "район",
                                "target_lang_sense_clarification": "в значении «приблизительно» (в районе)"
                            },
                            {
                                "target_lang_word": "пределы",
                                "target_lang_sense_clarification": "диапазон значений"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "alrededor de",
                                "target_lang_sense_clarification": "aproximadamente una cantidad"
                            },
                            {
                                "target_lang_word": "aproximadamente",
                                "target_lang_sense_clarification": "de manera aproximada"
                            },
                            {
                                "target_lang_word": "unos",
                                "target_lang_sense_clarification": "cantidad aproximada"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39bdbd91-ce82-373f-8311-f6ce57cdc476",
                    "sense_definition": "The state of being near or close to something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "location_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>vicinity</w> of the forest brings fresh air to the small village.",
                            "target_lang_translations": {
                                "ru": "<w>Близость</w> леса приносит свежий воздух в маленькую деревню.",
                                "es": "La <w>proximidad</w> del bosque aporta aire fresco al pequeño pueblo."
                            }
                        },
                        {
                            "text": "She felt nervous due to the <w>vicinity</w> of the large dog.",
                            "target_lang_translations": {
                                "ru": "Она нервничала из-за <w>близости</w> большой собаки.",
                                "es": "Se sentía nerviosa por la <w>cercanía</w> del perro grande."
                            }
                        }
                    ],
                    "synonyms": [
                        "proximity",
                        "nearness",
                        "closeness"
                    ],
                    "antonyms": [
                        "remoteness",
                        "distance"
                    ],
                    "common_phrases": [
                        "close vicinity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние нахождения рядом или близко к чему-либо.",
                        "es": "Estado o cualidad de estar cerca o próximo a algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "близость",
                                "target_lang_sense_clarification": "состояние нахождения рядом"
                            },
                            {
                                "target_lang_word": "соседство",
                                "target_lang_sense_clarification": "нахождение бок о бок"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "proximidad",
                                "target_lang_sense_clarification": "cualidad de estar cerca en el espacio"
                            },
                            {
                                "target_lang_word": "cercanía",
                                "target_lang_sense_clarification": "estado de estar a poca distancia"
                            },
                            {
                                "target_lang_word": "vecindad",
                                "target_lang_sense_clarification": "calidad de estar próximo o contiguo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
