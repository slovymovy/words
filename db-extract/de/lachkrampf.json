                ],
                "senses": [
                    {
                        "sense_id": "688e6217-97e2-3b3d-8b49-e4ece384aecd",
                        "entry_id": "bdbd9629-ef8d-374b-bdf3-f26694f395ef",
                        "glosses": [
                            "kaum beherrschbarer Lachanfall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3a33a84-969d-4775-a898-cdbface559bb",
                                "sense_id": "688e6217-97e2-3b3d-8b49-e4ece384aecd",
                                "text": "„Ich glaube, ich hatte in meinem ganzen Leben nur einen echten Lachkrampf, und der liegt Jahre zurück.“"
                            },
                            {
                                "example_id": "a6ea95cc-89c5-4db7-9cf1-728519ec3c3f",
                                "sense_id": "688e6217-97e2-3b3d-8b49-e4ece384aecd",
                                "text": "„Ich musste meine Lektüre mehrmals unterbrechen und aus dem Fenster schauen, um meine Mitreisenden durch meinen Lachkrampf nicht zu stören.“"
                            },
                            {
                                "example_id": "c4352f8b-b566-4f46-a0ef-998e71de665f",
                                "sense_id": "688e6217-97e2-3b3d-8b49-e4ece384aecd",
                                "text": "„Alle taten desgleichen, der Herr Pfarrer gab eine Art Glucksen von sich, Hurel hustete, dem Doktor liefen die Tränen herunter, seine Frau bekam einen nervösen Lachkrampf – und Foureau, ein Mann, der keine Scheu kannte, brach einen Abd-el-Kader ab und steckte ihn als Andenken in die Tasche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
