                    "sense_definition": "A place name for unincorporated communities in the United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through the small community of <w>Bonus</w> on their road trip.",
                            "target_lang_translations": {
                                "ru": "Во время поездки они проехали через небольшое поселение <w>Бонус</w>.",
                                "zh": "他们在公路旅行中开车穿过了<w>博纳斯</w>这个小社区。"
                            }
                        },
                        {
                            "text": "He lives in <w>Bonus</w>, Texas, which is a very small town.",
                            "target_lang_translations": {
                                "ru": "Он живет в <w>Бонусе</w>, штат Техас, который является очень маленьким городком.",
                                "zh": "他住在德克萨斯州的<w>博纳斯</w>，那是一个非常小的城镇。"
                            }
                        }
                    ],
                    "traits": [
                        {
