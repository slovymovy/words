                "senses": [
                    {
                        "sense_id": "c180e1ef-2267-35bf-9f00-14a6a5bbbe90",
                        "entry_id": "469cad7f-c2be-3464-9874-d92901874913",
                        "glosses": [
                            "a diminutive, Tanya, of the female given name Татья́на (Tatʹjána)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c88493a0-404f-4fbb-8516-6755c5c55b05",
                                "sense_id": "c180e1ef-2267-35bf-9f00-14a6a5bbbe90",
                                "text": "На́ша Та́ня гро́мко пла́чет: / Урони́ла в ре́чку мя́чик. / — Ти́ше, Та́нечка, не пла́чь: / Не уто́нет в ре́чке мя́ч.",
                                "translation": "Our Tanya is crying loudly: / She dropped a ball into the stream. / “Hush, Little Tanya, don’t cry: / The ball won’t sink in the stream.”",
                                "english": "Our Tanya is crying loudly: / She dropped a ball into the stream. / “Hush, Little Tanya, don’t cry: / The ball won’t sink in the stream.”"
                            }
                        ]
                    }
                ],
