        "nl-extract.jsonl": [
            {
                "entry_id": "ca23b142-f5b6-3113-aa7e-f82ee2d8786e",
                "word": "gepast",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c43b8b05-ce3f-38fd-8a66-9f6fd97d78d4",
                        "entry_id": "ca23b142-f5b6-3113-aa7e-f82ee2d8786e",
                        "glosses": [
                            "goed aansluitend bij de situatie of bedoelingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd80adce-0e06-4ecb-b70e-89c77c2be21f",
                                "sense_id": "c43b8b05-ce3f-38fd-8a66-9f6fd97d78d4",
                                "text": "Met gepaste bewoordingen wist hij de ruziemakers tot rust te brengen."
                            },
                            {
                                "example_id": "e83bcef9-03c8-4c44-bb29-3d0ea8bac240",
                                "sense_id": "c43b8b05-ce3f-38fd-8a66-9f6fd97d78d4",
                                "text": "De perrons zijn verlaten, in de hal zitten de reizigers op gepaste afstand van elkaar op de wachtbanken, die anders vol zijn. Deze hele week is het al rustiger dan normaal, maar deze vrijdag is het echt opvallend stil, zegt een NS-medewerker. Toch nemen ook nog aanzienlijk wat mensen wél de trein."
                            }
                        ]
                    },
                    {
                        "sense_id": "114ddd02-d32f-3a8b-ab87-62cb029dd24b",
                        "entry_id": "ca23b142-f5b6-3113-aa7e-f82ee2d8786e",
                        "glosses": [
                            "behoorlijk, fatsoenlijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c809d5e4-41eb-4eb7-a0af-fc19c5bb2007",
                                "sense_id": "114ddd02-d32f-3a8b-ab87-62cb029dd24b",
                                "text": "Vloeken is geen gepast gedrag."
                            },
                            {
                                "example_id": "fad69e8f-5151-45d5-a257-0b22ad25689a",
                                "sense_id": "114ddd02-d32f-3a8b-ab87-62cb029dd24b",
                                "text": "Hij was vijfenzestig geworden, dan was het niet langer gepast. Dat nam niet weg dat het een observatie was die niet te vermijden viel, en wat hij bij zichzelf in zijn zolderkamer dacht kon niemand schaden of in verlegenheid brengen."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec366ef2-5ae6-3fe5-9cda-fb4aa2e782c2",
                        "entry_id": "ca23b142-f5b6-3113-aa7e-f82ee2d8786e",
                        "glosses": [
                            "die iemand heeft aangehad om te zien of het de goede maat heeft"
                        ],
                        "tags": [
                            "kleding|nld"
                        ],
                        "examples": [
                            {
                                "example_id": "1254fe30-a936-4025-a637-26f8315ac8e6",
                                "sense_id": "ec366ef2-5ae6-3fe5-9cda-fb4aa2e782c2",
                                "text": "Wilt u de gepaste broeken weer in het rek hangen?"
                            }
                        ]
                    },
                    {
                        "sense_id": "c990198f-08ef-3fe4-b0fb-983e4e9593a4",
                        "entry_id": "ca23b142-f5b6-3113-aa7e-f82ee2d8786e",
                        "glosses": [
                            "met precies het juiste bedrag, zodat geen wisselgeld nodig is"
                        ],
                        "tags": [
                            "bij contante betaling"
                        ],
                        "examples": [
                            {
                                "example_id": "a3616208-f645-4413-a120-3579097fb07e",
                                "sense_id": "c990198f-08ef-3fe4-b0fb-983e4e9593a4",
                                "text": "Zij betaalde met gepast geld, zonder een fooi te geven."
                            }
                        ]
                    }
                ],
