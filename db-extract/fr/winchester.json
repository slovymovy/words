                                            {
                                                "example_id": "e802d66f-908f-44f2-b0b9-c9f4810938dd",
                                                "sense_id": "b8c354f9-814c-36c3-b5e0-2cd0436df602",
                                                "text": "H. Rider Haggard, King Solomon's Mines\n\"Give me my express,\" I said, laying down the Winchester, and he handed it to me cocked."
                                            },
                                            {
                                                "example_id": "a2e2666b-39b7-47e5-95ca-c50269eff3f9",
                                                "sense_id": "b8c354f9-814c-36c3-b5e0-2cd0436df602",
                                                "text": "Almost simultaneously Jim Taylor and Kit Hunter shot at each other with Winchesters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2631ddf0-4596-392d-9a15-c418a7f691d6",
                                        "entry_id": "7ea546c0-7884-3de9-ab9b-4eccfecdbcb6",
