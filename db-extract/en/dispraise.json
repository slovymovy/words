    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "89e924f1-392c-3c37-89c8-f7dd12968a7f",
                "word": "dispraise",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f106241a-ebdd-4ede-98ba-2cde291a4472",
                        "entry_id": "89e924f1-392c-3c37-89c8-f7dd12968a7f",
                        "tags": [
                            "plural"
                        ],
                        "form": "dispraises"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "18c7398b-a53f-35a3-bb36-3455704972b3",
                        "entry_id": "89e924f1-392c-3c37-89c8-f7dd12968a7f",
                        "glosses": [
                            "Blame; reproach; disapproval; criticism."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "78883835-d006-4e9f-9bbd-86763aeebff0",
                                "sense_id": "18c7398b-a53f-35a3-bb36-3455704972b3",
                                "text": "Their censure did not much affect him; for the good-natured young man was disposed to accept with considerable humility the dispraises of others."
                            },
                            {
                                "example_id": "8e09749e-668d-4278-9cc8-c1650875b0cb",
                                "sense_id": "18c7398b-a53f-35a3-bb36-3455704972b3",
                                "text": "Pierre Petit, in 1683, devoted a long Latin poem to his dis-praise; and Parnell's charming Ode is well known."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8d6b86e7-f7be-38f9-9f46-6260832780f2",
                "word": "dispraise",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "50d414fc-0d14-4e96-baf3-01eeb6b1b289",
                        "entry_id": "8d6b86e7-f7be-38f9-9f46-6260832780f2",
                        "tags": [
