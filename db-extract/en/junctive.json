                        "glosses": [
                            "An element of syntax that serves as a junction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3611e2f0-abc6-46a6-a042-bcf8c75b8639",
                                "sense_id": "412b73eb-4b53-3a50-bd96-d369ad806863",
                                "text": "For junction, translation shifts are calculated in two steps because there is no straightforward equivalence between Chinese and English junctives."
                            },
                            {
                                "example_id": "15f33e34-06e8-44e6-938c-aec09ceea01d",
                                "sense_id": "412b73eb-4b53-3a50-bd96-d369ad806863",
                                "text": "The junctive is not part of either of the two nuclei that it joins together. Just as the mortar that binds two bricks is not part of either, or as the coupling that unites two railcars appears external to both, a junctive remains outside of the two nuclei it unites."
                            }
                        ]
                    }
