                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a602db8f-48fd-4efd-9fcc-6136eb619ada",
                                "sense_id": "4394878f-83e8-3ad0-8c54-5c0c3e7d4c25",
                                "text": "Le réticulocyte est le précurseur de l'érythrocyte."
                            },
                            {
                                "example_id": "e2eefb9a-a3df-46c3-96c3-b0ff32a3257a",
                                "sense_id": "4394878f-83e8-3ad0-8c54-5c0c3e7d4c25",
                                "text": "Le réticulocyte contient un réseau clairsemé de ribosomes."
                            },
                            {
                                "example_id": "01fb80a0-4c50-4fb6-b9a6-7f8f58f293e3",
                                "sense_id": "4394878f-83e8-3ad0-8c54-5c0c3e7d4c25",
                                "text": "Le réticulocyte possède au départ un noyau, un cytoplasme et des mitochondries; mais voilà que le noyau est brutalement condensé, fragmenté et expulsé de la cellule."
                            }
                        ]
                    }
