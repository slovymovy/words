                        "glosses": [
                            "Veel meisjes uit Iran zijn mooie, donkerharige prinsesjes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "177ac200-43b2-480e-b713-528534646451",
                                "sense_id": "30fbffee-2f3a-3f19-87ad-e8f53df9d0fb",
                                "text": "Dagen achter elkaar was er niemand te bekennen, waardoor ik me nog kwetsbaarder voelde, en ik begon bij elke bocht hard te zingen om eventuele beren te waarschuwen dat ik eraan kwam. Ik tikte mijn wandelstokken tegen elkaar en sloeg onverstaanbare wartaal uit. Mijn ogen schoten onzeker alle kanten op, speurend naar kleine bewegingen en donkerharige wezens."
                            }
                        ]
                    }
