        "nl-extract.jsonl": [
            {
                "entry_id": "cf8a98b1-85d1-32cd-9053-dc422b95fc81",
                "word": "onnozelheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "1b75e9b9-f342-4725-8774-a44c4504cbce",
                        "entry_id": "cf8a98b1-85d1-32cd-9053-dc422b95fc81",
