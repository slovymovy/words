                        ],
                        "form": "die Bildungspolitik"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "585a2e8e-a718-3d12-b855-95cf386c62dd",
                        "entry_id": "395cd29c-8a71-390e-a877-ab80e42bafbd",
                        "glosses": [
                            "die das Bildungswesen betreffenden politischen Maßnahmen und Entscheidungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a07c128b-1cd1-42fd-9ab3-0f5551fef9db",
                                "sense_id": "585a2e8e-a718-3d12-b855-95cf386c62dd",
                                "text": "In letzter Zeit spielt die Bildungspolitik in der öffentlichen Diskussion eine größere Rolle als früher."
                            },
                            {
                                "example_id": "b8614a1e-28d4-458b-9bba-df1b6fd4163c",
                                "sense_id": "585a2e8e-a718-3d12-b855-95cf386c62dd",
                                "text": "„Die letzte Regierung initiierte eine Bildungspolitik, die nach und nach die humanistischen und demokratischen Werte der Bildung untergräbt und stattdessen enge, nationalistische und intolerante Werte vermittelt.“"
                            },
                            {
                                "example_id": "e04e5d07-0bde-494d-a315-976db859035d",
                                "sense_id": "585a2e8e-a718-3d12-b855-95cf386c62dd",
                                "text": "„Bildungspolitik macht aber immer noch der Finanzsenator und nicht die Bildungssenatorin.“"
                            },
                            {
                                "example_id": "6c3f2181-3a28-4058-81b5-5747093c20fa",
                                "sense_id": "585a2e8e-a718-3d12-b855-95cf386c62dd",
                                "text": "„Niemand muss für das Scheitern der Bildungspolitik Konsequenzen ziehen, schon gar nicht die Landesbildungsministerinnen und -minister. Kein Rücktritt, keine Entschuldigung, nichts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
