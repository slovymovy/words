                "senses": [
                    {
                        "sense_id": "815935dd-a179-355b-9a79-e12ea3529cb8",
                        "entry_id": "8e859953-b46e-3804-ac92-b072b991a7a0",
                        "glosses": [
                            "Verbindung zwischen den Tasten und den Spielventilen bei der Orgel"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "8e30f1a1-6e2d-4be1-a0ee-00b9da25d4ff",
                                "sense_id": "815935dd-a179-355b-9a79-e12ea3529cb8",
                                "text": "Bei der mechanischen Traktur wurde die Verbindung zwischen Taste und Pfeife mittels langer Stangen und Stäbchen, verbunden mit Winkelstücken, hergestellt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c6234d8e-798a-323f-a3d3-d51de79a4a0c",
                        "entry_id": "8e859953-b46e-3804-ac92-b072b991a7a0",
                        "glosses": [
                            "System zum Ein- und Ausschalten der Register bei der Orgel"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "271c922b-721f-4ad0-ae1f-4de9c947d99c",
                                "sense_id": "c6234d8e-798a-323f-a3d3-d51de79a4a0c",
                                "text": "Auch für das Ein- und Ausschalten der Register (= Pfeifen einer Klangfarbe) wird eine Traktur benötigt, die bei einer mechanischen Og. in Form von Holzstangen gebaut ist."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
