{
    "word_family": [
        "relative",
        "relativity",
        "relate",
        "relation",
        "relationship",
        "related"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "67858075-b7d5-3d57-8186-f95fb2179d16",
                    "sense_definition": "To a certain degree or extent, especially when compared to other things.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exam was <w>relatively</w> easy, so most students finished it on time.",
                            "target_lang_translations": {
                                "ru": "Экзамен был <w>относительно</w> легким, поэтому большинство студентов закончили его вовремя.",
                                "zh": "这次考试<w>比较</w>简单，所以大多数学生都按时完成了。"
                            }
                        },
                        {
                            "text": "We moved to a <w>relatively</w> small town to escape the noise of the city.",
                            "target_lang_translations": {
                                "ru": "Мы переехали в <w>сравнительно</w> небольшой город, чтобы сбежать от городского шума.",
                                "zh": "我们搬到了一个<w>相对</w>小的城镇，以躲避城市的喧嚣。"
                            }
                        },
                        {
                            "text": "Although the car is old, it is in <w>relatively</w> good condition.",
                            "target_lang_translations": {
                                "ru": "Хотя машина старая, она находится в <w>относительно</w> хорошем состоянии.",
                                "zh": "虽然这辆车很旧，但车况<w>相对</w>良好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fairly",
                        "somewhat",
                        "quite",
                        "reasonably",
                        "moderately",
                        "comparatively"
                    ],
                    "antonyms": [
                        "extremely",
                        "completely"
                    ],
                    "common_phrases": [
                        "relatively easy",
                        "relatively small",
                        "relatively new",
                        "relatively low",
                        "relatively speaking"
                    ],
                    "target_lang_definitions": {
                        "ru": "В некоторой степени или мере, особенно по сравнению с другими вещами; довольно.",
                        "zh": "在一定程度上，特别是与他物相比时；相当地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "относительно",
                                "target_lang_sense_clarification": "в некоторой степени, довольно"
                            },
                            {
                                "target_lang_word": "сравнительно",
                                "target_lang_sense_clarification": "по сравнению с другими"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相对",
                                "target_lang_sense_clarification": "表示在一定程度上"
                            },
                            {
                                "target_lang_word": "比较",
                                "target_lang_sense_clarification": "用于形容词前，表示程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1d19b86-7eb4-3cfd-87cb-ea343afb2b7b",
                    "sense_definition": "In a way that is measured or judged by comparison to something else rather than by itself.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company has performed well <w>relatively</w> to its main competitors in the market.",
                            "target_lang_translations": {
                                "ru": "Компания показала хорошие результаты <w>относительно</w> своих основных конкурентов на рынке.",
                                "zh": "与市场上的主要竞争对手相比，该公司的表现<w>相对</w>出色。"
                            }
                        },
                        {
                            "text": "Wages have fallen <w>relatively</w>, even though the actual amount of money paid has increased.",
                            "target_lang_translations": {
                                "ru": "Заработная плата снизилась <w>относительно</w>, хотя фактическая сумма выплачиваемых денег увеличилась.",
                                "zh": "尽管实际支付的金额有所增加，但工资水平<w>相对</w>下降了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "comparatively",
                        "proportionately"
                    ],
                    "antonyms": [
                        "absolutely"
                    ],
                    "common_phrases": [
                        "relatively to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оцениваемый или измеряемый по сравнению с чем-то другим, а не сам по себе.",
                        "zh": "通过与他物比较而非自身来衡量或判断。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "относительно",
                                "target_lang_sense_clarification": "по отношению к чему-либо"
                            },
                            {
                                "target_lang_word": "сравнительно",
                                "target_lang_sense_clarification": "в сравнении, пропорционально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相对",
                                "target_lang_sense_clarification": "表示与他物对比"
                            },
                            {
                                "target_lang_word": "相较",
                                "target_lang_sense_clarification": "表示在比较之下"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}