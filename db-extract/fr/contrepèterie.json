        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c101819c-d056-3e2e-9ba0-2b616a7e24c1",
                "word": "contrepèterie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "98eb7a25-1e44-4b68-bdb7-a8b5c51570a4",
                        "entry_id": "c101819c-d056-3e2e-9ba0-2b616a7e24c1",
                        "tags": [
                            "plural"
                        ],
                        "form": "contrepèteries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cefc3c73-5477-3dcc-8cd7-d754ee1af319",
                        "entry_id": "c101819c-d056-3e2e-9ba0-2b616a7e24c1",
                        "glosses": [
                            "spoonerism, chiefly one that is sexually explicit"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "82928854-bdba-4f5b-a661-7fc7657cb94f",
                                "sense_id": "cefc3c73-5477-3dcc-8cd7-d754ee1af319",
                                "text": "Dans ce bon vieux lycée Ampère sur lequel on peut faire une si charmante contrepèterie et sur les bancs duquel nous usâmes, mon ami Rik Cursat et moi, des fonds de culotte d'autant plus précieux que le tissu était contingenté, dans les années 40, mises à part quelques fortes têtes que nous regardions comme des Martiens, et qui semblaient travailler avec plaisir, nous n'avions pas, nous-mêmes, une inclination particulière pour le collège.",
                                "translation": "At good old Ampère School, whose name makes a charming spoonerism [lycée Ampère (“Ampère School”) > pisser en l'air (“to piss in the air”)], and on whose benches my friend Rik Cursat and I wore out the seats of our trousers – all the more precious because the fabric was rationed – in the 1940s, apart from a few rebels whom we regarded as Martians, and who seemed to take pleasure in working, we ourselves did not have any particular inclination for school.",
                                "english": "At good old Ampère School, whose name makes a charming spoonerism [lycée Ampère (“Ampère School”) > pisser en l'air (“to piss in the air”)], and on whose benches my friend Rik Cursat and I wore out the seats of our trousers – all the more precious because the fabric was rationed – in the 1940s, apart from a few rebels whom we regarded as Martians, and who seemed to take pleasure in working, we ourselves did not have any particular inclination for school."
                            },
                            {
                                "example_id": "d0147f60-b482-40ab-b731-f5beb264929a",
                                "sense_id": "cefc3c73-5477-3dcc-8cd7-d754ee1af319",
                                "text": "Un préalable indispensable à l'art de décrypter les contrepèteries est la connaissance la plus large des mots tabous, ces vocables de salle de garde, substantifique moelle des contrepèteries rabelaisiennes.",
                                "translation": "An essential prerequisite for the art of deciphering spoonerisms is the broadest possible knowledge of taboo words, those mainstays of hospital staff-rooms, the true substance of Rabelaisian spoonerisms.",
                                "english": "An essential prerequisite for the art of deciphering spoonerisms is the broadest possible knowledge of taboo words, those mainstays of hospital staff-rooms, the true substance of Rabelaisian spoonerisms."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
