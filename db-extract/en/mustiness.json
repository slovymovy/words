                "senses": [
                    {
                        "sense_id": "4e29d4b4-00de-34fc-b519-3e798abfed70",
                        "entry_id": "c968045d-621d-32d4-b3fa-5876b4ba4cde",
                        "glosses": [
                            "The characteristic of being musty."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0413dc53-fd49-4498-a542-ab29ae6fa9b4",
                                "sense_id": "4e29d4b4-00de-34fc-b519-3e798abfed70",
                                "text": "But during those two years for some reason or other the house had fallen into premature and rapid decay. With a very few months an air of mustiness began to hang over the once palatial residence of the rich foreign financier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f88b1406-ae60-4a5d-a300-160d9034cbae",
                        "source_entry_id": "c968045d-621d-32d4-b3fa-5876b4ba4cde",
                        "source_sense_id": "4e29d4b4-00de-34fc-b519-3e798abfed70",
                        "source_sense_description": "stale or moldy in odor or taste",
                        "target_lang_word": "Moder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5618ae83-3a20-39f4-8ede-99c2957d64a0",
                                        "entry_id": "3d8ca8cd-122b-3a9c-a875-3b6bd12a2dbf",
                                        "glosses": [
                                            "Ergebnis eines Fäulnisprozesses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e964855-961e-42ce-95db-d91c4ef4b5cb",
                                                "sense_id": "5618ae83-3a20-39f4-8ede-99c2957d64a0",
                                                "text": "„Die Dielenbretter waren voller Trockenfäule gewesen, die elektrischen Leitungen gefährlich und das Badezimmer eine Art Schuppen im hinteren Teil des Hauses und vom Boden bis zur Decke bedeckt mit schwarzem Moder.“"
                                            },
                                            {
                                                "example_id": "d26d8313-6b3e-433c-8ed5-8b578b173090",
                                                "sense_id": "5618ae83-3a20-39f4-8ede-99c2957d64a0",
                                                "text": "„Der Geruch nach Moder stieg aus dem Bereich des Grabes.“"
                                            },
                                            {
                                                "example_id": "1702451c-d621-46e0-95ec-f6f848d59568",
                                                "sense_id": "5618ae83-3a20-39f4-8ede-99c2957d64a0",
                                                "text": "„Die stockende Luft roch wie im Herbst nach Moder.“"
                                            },
                                            {
                                                "example_id": "bf4760a5-07c1-4c24-a216-7ed5d32bc188",
                                                "sense_id": "5618ae83-3a20-39f4-8ede-99c2957d64a0",
                                                "text": "„Die Äcker verödeten, die Niederlassung verfiel, die Männer, zermürbt von Weiberklagen, rosteten mit ihrem Eisen und überließen das kaum geklärte Feld dem Unkraut und Samenflug des Waldes, die Zäune dem Moder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fc4f05ad-93e8-3d42-b9ee-ea673afd993f",
                                        "entry_id": "3d8ca8cd-122b-3a9c-a875-3b6bd12a2dbf",
                                        "glosses": [
                                            "aufgeweichte Erde"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9676464b-bcd9-40d5-8f76-9d8fbc8031c2",
                                                "sense_id": "fc4f05ad-93e8-3d42-b9ee-ea673afd993f",
                                                "text": "Sie ist mit dem Wagen im Moder steckengeblieben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "765cf749-2767-40fc-a8b8-cb34436ef168",
                        "source_entry_id": "c968045d-621d-32d4-b3fa-5876b4ba4cde",
                        "source_sense_id": "4e29d4b4-00de-34fc-b519-3e798abfed70",
