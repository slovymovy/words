{
    "word_family": [
        "stagnation",
        "stagnant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4799249-8135-3342-85d4-399743c7ec11",
                    "sense_definition": "Cesser de progresser, ne pas connaître d'évolution ou demeurer au même niveau.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "evolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis plusieurs mois, les ventes de notre entreprise continuent de <w>stagner</w> malgré nos efforts."
                        },
                        {
                            "text": "Si les négociations de paix <w>stagnent</w>, la situation risque de s'aggraver dans toute la région."
                        }
                    ],
                    "synonyms": [
                        "végéter"
                    ],
                    "common_phrases": [
                        "stagner au même niveau"
                    ]
                },
                {
                    "sense_id": "78f48390-1871-3bd7-8c73-9d335d03efbb",
                    "sense_definition": "Pour un liquide ou l'air, cesser de s'écouler ou de circuler, rester immobile.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liquide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la violente tempête, l'eau de pluie a commencé à <w>stagner</w> dans la cour."
                        },
                        {
                            "text": "Il faut vider les coupelles des plantes pour éviter que l'eau ne <w>stagne</w> trop longtemps."
                        }
                    ],
                    "common_phrases": [
                        "laisser stagner l'eau"
                    ]
                }
            ]
        }
    ]
}