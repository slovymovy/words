                ],
                "senses": [
                    {
                        "sense_id": "d4ad3a84-9e4b-360e-9310-0e869ff8cafa",
                        "entry_id": "225c3ee0-daa0-352f-bdc8-49adcac1825c",
                        "glosses": [
                            "Donner un caractère auriculaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c89bd15-ae80-4a54-b713-04d03307f112",
                                "sense_id": "d4ad3a84-9e4b-360e-9310-0e869ff8cafa",
                                "text": "Dans le Mimismo-phonétisme, il va surtout « auriculariser »."
                            },
                            {
                                "example_id": "2d9a8f14-baf7-4f39-b0d8-4b404187ae4d",
                                "sense_id": "d4ad3a84-9e4b-360e-9310-0e869ff8cafa",
                                "text": "Pourtant mon index pointait et mon petit doigt auricularisé lisait, assemblant les phrases, chuchotant et ponctuant."
                            }
                        ]
                    },
                    {
                        "sense_id": "a40e90ff-831b-3e41-b500-066e40e793fe",
                        "entry_id": "225c3ee0-daa0-352f-bdc8-49adcac1825c",
                        "glosses": [
                            "Confier, dire en confidence, à l’oreille."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "a2816fe6-b350-4bb0-a1ca-2eca26799fad",
                                "sense_id": "a40e90ff-831b-3e41-b500-066e40e793fe",
                                "text": "Je serai donc tout heureux de recueillir de la bouche même de Sa Gracieuse Majesté les confidences qu’elle voudra bien m’auriculariser."
                            },
                            {
                                "example_id": "d2151004-9d2d-4ba2-b03d-3f863ce953a0",
                                "sense_id": "a40e90ff-831b-3e41-b500-066e40e793fe",
                                "text": "D’après les confidences qu’il a bien voulu nous auriculariser, il doit visiter la Belgique, la Hollande, le Danemark, la Suède, la Norvège, la Russie, la Turquie, la Grèce, l’Italie, l’Autriche-Hongrie, la Suisse, l’Allemagne."
                            }
                        ]
                    }
