                    "frequency": "High",
                    "semantic_group_id": "transformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Hexe <w>verwandelte</w> den unhöflichen Prinzen in einen hässlichen Frosch."
                        },
                        {
                            "text": "Im Frühling <w>verwandelt</w> sich die kahle Wiese in ein buntes Blumenmeer."
                        }
                    ],
