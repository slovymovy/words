                ],
                "senses": [
                    {
                        "sense_id": "e1628db1-ae0d-3936-bc29-652f77e8c29f",
                        "entry_id": "6fc6d360-8165-3b51-8c33-05b27f84511b",
                        "glosses": [
                            "die Menschenaffen betreffend, auf die Menschenaffen bezogen, in die Familie der Pongidae gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bccbe16a-8812-4289-86ea-ef45cf7d3d61",
                                "sense_id": "e1628db1-ae0d-3936-bc29-652f77e8c29f",
                                "text": "„Die Molaren sind taurodont; nach Verf. sind sie mehr hominid als pongid […]“"
                            },
                            {
                                "example_id": "c9b31050-6258-4b3d-894d-366f3eb1c39a",
                                "sense_id": "e1628db1-ae0d-3936-bc29-652f77e8c29f",
                                "text": "„„Proconsul\" ist in seinen Gebißmerkmalen eindeutig pongid geprägt, die sich aber mit gewissen protocatarrhinen Merkmalen der Schädelarchitektur zusammen finden.“"
                            },
                            {
                                "example_id": "50b8357d-9b54-4182-8b63-1737fd554353",
                                "sense_id": "e1628db1-ae0d-3936-bc29-652f77e8c29f",
                                "text": "Hürzeler erkannte, wie schon G. Schwalbe, Oreopithecus zunächst als pongid an (was neuerdings auch von Remane, einer unserer erfahrensten Kenner des Primatengebisses, vertreten wird).“"
                            },
                            {
                                "example_id": "bf5d0170-adeb-4f99-9678-afcff604d9fc",
                                "sense_id": "e1628db1-ae0d-3936-bc29-652f77e8c29f",
                                "text": "„In einer späteren, nach meinem Dafürhalten frühen pongiden bzw. subhumanen Evolutionsphase erfolgte die Erwerbung der Orthogradie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
