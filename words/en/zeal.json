    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "46d925e8-f081-3b20-9d94-7f22e67aa6a7",
                    "sense_definition": "Great energy, effort, and enthusiasm in pursuit of a cause, ideal, or objective.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "enthusiasm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She promoted the new environmental campaign with missionary <w>zeal</w>.",
                            "target_lang_translations": {
                                "ru": "Она продвигала новую экологическую кампанию с миссионерским <w>рвением</w>."
                            }
                        },
                        {
                            "text": "His reforming <w>zeal</w> led to major changes across the entire organisation.",
                            "target_lang_translations": {
                                "ru": "Его реформаторский <w>пыл</w> привёл к крупным изменениям во всей организации."
                            }
                        }
                    ],
                    "synonyms": [
                        "ardour",
                        "eagerness",
                        "enthusiasm",
                        "intensity",
                        "passion"
                    ],
                    "antonyms": [
                        "apathy"
                    ],
                    "common_phrases": [
                        "missionary zeal",
                        "reforming zeal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Огромная энергия, энтузиазм и самоотдача в достижении цели, идеала или какого-либо дела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рвение",
                                "target_lang_sense_clarification": "сильное стремление и пыл в работе или деле"
                            },
                            {
                                "target_lang_word": "усердие",
                                "target_lang_sense_clarification": "большое старание и прилежание"
                            },
                            {
                                "target_lang_word": "пыл",
                                "target_lang_sense_clarification": "эмоциональная горячность и страсть"
                            },
                            {
                                "target_lang_word": "запал",
                                "target_lang_sense_clarification": "воодушевление, энтузиазм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8e4d24b-fea7-3bd5-a046-e45458ec1e07",
                    "sense_definition": "A collective term for a group of zebras.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A large <w>zeal</w> gathered near the watering hole at dawn.",
                            "target_lang_translations": {
                                "ru": "Большое <w>стадо</w> зебр собралось у водопоя на рассвете."
                            }
                        },
                        {
                            "text": "The tourists watched a <w>zeal</w> of zebras grazing peacefully on the open plain.",
                            "target_lang_translations": {
                                "ru": "Туристы наблюдали за <w>табуном</w> зебр, мирно пасущихся на открытой равнине."
                            }
                        }
                    ],
                    "synonyms": [
                        "dazzle",
                        "herd"
                    ],
                    "common_phrases": [
                        "zeal of zebras"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирательное название группы (стада) зебр."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стадо",
                                "target_lang_sense_clarification": "группа зебр"
                            },
                            {
                                "target_lang_word": "табун",
                                "target_lang_sense_clarification": "стадо копытных животных, в том числе зебр"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2598a16-82d0-3f99-9f3a-3cddf3c9769a",
                    "sense_definition": "A zealous person; someone showing intense devotion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enthusiasm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was condemned by his critics as a dangerous religious <w>zeal</w>.",
                            "target_lang_translations": {
                                "ru": "Критики осуждали его как опасного религиозного <w>фанатика</w>."
                            }
                        },
                        {
                            "text": "The elder warned the court about trusting an intolerant <w>zeal</w>.",
                            "target_lang_translations": {
                                "ru": "Старейшина предостерёг суд от доверия к нетерпимому <w>фанатику</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "zealot"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used to describe a person"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее обозначение ревностного сторонника, фанатика или фанатично преданного человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фанатик",
                                "target_lang_sense_clarification": "человек, страстно преданный своим убеждениям"
                            },
                            {
                                "target_lang_word": "ревнитель",
                                "target_lang_sense_clarification": "человек, горячо защищающий что-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
