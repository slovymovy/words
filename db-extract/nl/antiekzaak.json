                        "glosses": [
                            "winkel waar men antieke spullen verkoopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79c56ae8-e79b-4107-bc5a-27ce80c9aeb5",
                                "sense_id": "4bbdc114-574a-3c57-b1d3-8711cf311a2b",
                                "text": "A Hard Days Night was de klassieke Beatles-opening na het door een regenbui verlate begin. Save Us volgde en Can't Buy My Love. McCartney bracht het allemaal als de eigenaar van een keurige antiekzaak op het platteland van Sussex, zij het dat het aangebodene hier en daar duidelijk barsten vertoonde. Hij praatte met schorre stem en haalde soms de hoge tonen niet, zoals in Maybe I’m Amazed."
                            },
                            {
                                "example_id": "260a2d98-ea88-4099-98e5-916c07b1bf3d",
                                "sense_id": "4bbdc114-574a-3c57-b1d3-8711cf311a2b",
                                "text": "Een grote brand in Alkmaar, op een industrieterrein. De brand brak rond 01.00 uur vanochtend uit in een antiekzaak op het terrein."
                            }
                        ]
                    }
