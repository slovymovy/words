                    },
                    {
                        "form_id": "32e45087-7f72-484d-a7b0-edc54311c711",
                        "entry_id": "46b385aa-da66-3779-a25f-759e0e10d7b7",
                        "tags": [],
                        "form": "cancelle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f5ecf097-2213-3c5c-8045-ccd46ef097d3",
                        "entry_id": "46b385aa-da66-3779-a25f-759e0e10d7b7",
                        "glosses": [
                            "Clôture de pierre ou de bois séparant le chœur liturgique de la nef."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1206ee9-9fda-4327-8a72-7615acd640e7",
                                "sense_id": "f5ecf097-2213-3c5c-8045-ccd46ef097d3",
                                "text": "À l’intérieur, quatre colonnes corinthiennes et les colonnettes cannelées du chancel supportent le jubé de bois, orné de panneaux en bas-relief polychrome."
                            },
                            {
                                "example_id": "87b786b5-f02d-4b8e-aff5-3ae82bd2205d",
                                "sense_id": "f5ecf097-2213-3c5c-8045-ccd46ef097d3",
                                "text": "Au-dessus du chancel, face à la nef s’élève une grande crucifixion. Les croix du Christ et des larrons se dressent sur des monticules de terre truffés de crânes et d’ossements."
                            },
                            {
                                "example_id": "425a1d17-bf1b-4dce-aa5c-5ba83fb3bbe3",
                                "sense_id": "f5ecf097-2213-3c5c-8045-ccd46ef097d3",
                                "text": "Un chancel séparait désormais les deux groupes. L’accès au chœur n’était autorisé qu’au moment de la communion, y compris pour les femmes."
                            },
                            {
                                "example_id": "d9448321-f2d1-4567-b6c5-3a3bb2eae757",
                                "sense_id": "f5ecf097-2213-3c5c-8045-ccd46ef097d3",
                                "text": "Le chancel est destiné à isoler le chœur ou sanctuaire de la nef. Le chœur est réservé aux clercs, la nef aux fidèles. Ces derniers ne peuvent pénétrer dans le chœur et doivent suivre les offices à travers la clôture."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abd5172c-b3b2-4706-b339-91a23e941a35",
                        "source_entry_id": "46b385aa-da66-3779-a25f-759e0e10d7b7",
                        "source_sense_id": "f5ecf097-2213-3c5c-8045-ccd46ef097d3",
                        "target_lang_word": "chancel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chancel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46107256-1725-3054-90c1-24cb22aeee8f",
                                        "entry_id": "e9331206-c094-31f4-bc95-db94555cf615",
                                        "glosses": [
                                            "The space around the altar in a church, often enclosed, for use by the clergy and the choir. In medieval cathedrals the chancel was usually enclosed or blocked off from the nave by an altar screen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc6c8feb-1b8c-4942-a708-7bc7dfacff11",
                                                "sense_id": "46107256-1725-3054-90c1-24cb22aeee8f",
                                                "text": "The Citizens in their rage, imagining that euery poſt in the Churche had bin one of yᵉ Souldyers, ſhot habbe or nabbe at randon^([sic – meaning random]) uppe to the Roode lofte, and to the Chancell, leauing ſome of theyr arrowes ſticking in the Images."
                                            },
                                            {
                                                "example_id": "beae2074-f2f3-4b9b-a14a-61f2d99af8c4",
                                                "sense_id": "46107256-1725-3054-90c1-24cb22aeee8f",
                                                "text": "Hester Earle and Violet Wayne were moving about the aisle with bundles of wheat-ears and streamers of ivy, for the harvest thanksgiving was shortly to be celebrated, while the vicar stood waiting for their directions on the chancel steps with a great handful of crimson gladioli."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b577069e-f6d8-4370-a024-5096daa4ad4f",
                        "source_entry_id": "46b385aa-da66-3779-a25f-759e0e10d7b7",
