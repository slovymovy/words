                    {
                        "sense_id": "e41d729d-7e4d-3611-99db-def6e0eb3a0c",
                        "entry_id": "340c701a-d3a8-39c0-b8f9-58a7bc091b47",
                        "glosses": [
                            "teren pokryty lodem używany do jazdy na łyżwach dla przyjemności"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4edb7c3-fe86-4706-9457-2e6129bb174c",
                                "sense_id": "e41d729d-7e4d-3611-99db-def6e0eb3a0c",
                                "text": "W Korei miasta urządzają dla mieszkańców ślizgawki na zamarzniętych stawach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8b158a46-bf3d-3276-b865-e69b946e21f0",
                        "entry_id": "340c701a-d3a8-39c0-b8f9-58a7bc091b47",
