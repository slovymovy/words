                    {
                        "sense_id": "34256e4a-b431-31a4-8830-57f9804fb0de",
                        "entry_id": "5eb2efa6-5d0c-3db2-a4aa-c068707e19c5",
                        "glosses": [
                            "een persoon die televisie- of radioprogramma's aankondigt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "669a80c2-525a-43cf-97d2-b3627ad4e0b7",
                                "sense_id": "34256e4a-b431-31a4-8830-57f9804fb0de",
                                "text": "De omroeper is vervangen door een programmagids."
                            }
                        ]
                    },
                    {
                        "sense_id": "271defb4-3a93-3e39-9744-769379fb0493",
                        "entry_id": "5eb2efa6-5d0c-3db2-a4aa-c068707e19c5",
                        "glosses": [
                            "een persoon die iets aan een grote groep mensen vertelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d42e965b-ced5-4c45-bc8e-31d328040ff7",
                                "sense_id": "271defb4-3a93-3e39-9744-769379fb0493",
                                "text": "De omroeper gaf aan dat we alleen door de linker ingang naar binnen konden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab87720a-3e3d-4926-bd52-29d2ad9bd4b8",
                        "source_entry_id": "5eb2efa6-5d0c-3db2-a4aa-c068707e19c5",
                        "target_lang_word": "Ansager",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ansager",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dea0124a-938a-3afb-a18f-7bd42c1cecbf",
                                        "entry_id": "3256aa1b-8207-3d01-b847-5f83cb9e4553",
                                        "glosses": [
                                            "jemand, der etwas ansagt, ankündigt, zum Beispiel in den Medien (Rundfunk, Fernsehen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f06b3529-7a1b-467e-bb92-95d0797074f3",
                                                "sense_id": "dea0124a-938a-3afb-a18f-7bd42c1cecbf",
                                                "text": "„Die Musik untermalte noch immer die Stimme des Ansagers.“"
                                            },
                                            {
                                                "example_id": "25426b68-8018-4bf2-938c-6b5f51c31c42",
                                                "sense_id": "dea0124a-938a-3afb-a18f-7bd42c1cecbf",
                                                "text": "„Ich unterbrach mein Spiel, als ich drinnen die Stimme des Ansagers hörte.“"
                                            },
                                            {
                                                "example_id": "a2ccbdec-3776-4c6b-9d6f-b4a440285ddd",
                                                "sense_id": "dea0124a-938a-3afb-a18f-7bd42c1cecbf",
                                                "text": "„Die Ansager meldeten mit Genugtuung die Zahl der im Kriege Getöteten.“"
                                            },
                                            {
                                                "example_id": "086a93fe-12a5-4de6-899f-84b491abb484",
                                                "sense_id": "dea0124a-938a-3afb-a18f-7bd42c1cecbf",
                                                "text": "„Die Deutschen hatten eine Artillerie, die auf alle wichtigen Punkte der Stadt eingeschossen war, und sobald der Ansager eine Sendung anzusagen begann, eröffneten die Batterien das Feuer auf das Rundfunkgebäude.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84c5913d-406f-4fd2-839b-2c99b8dcf30d",
                        "source_entry_id": "5eb2efa6-5d0c-3db2-a4aa-c068707e19c5",
                        "target_lang_word": "Moderator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moderator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8d4d05f-a760-33de-b6c6-23ada2943941",
                                        "entry_id": "b2efe47e-5bdb-306a-b77f-ab365f4bc076",
                                        "glosses": [
                                            "Person, die eine Diskussion, Veranstaltung oder eine Sendung moderiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "424d1099-68e9-420e-b0eb-0f12731c1630",
                                                "sense_id": "d8d4d05f-a760-33de-b6c6-23ada2943941",
                                                "text": "„Bevor die ARD aber frohgemut in die Fernsehzukunft aufbricht, wird sie Günter Jauch als Moderator einer klassischen Talkshow in Stellung bringen.“"
                                            },
                                            {
                                                "example_id": "b6fb90de-d6cc-4668-82af-bed44f6406ab",
                                                "sense_id": "d8d4d05f-a760-33de-b6c6-23ada2943941",
                                                "text": "„Friedel tat sich dabei weniger als Lehrer hervor, der vor dem Kamin Frontalunterricht gab, sondern eher als Moderator, der uns bei der Lektüre des Lehrbuchs unterstützte.“"
                                            },
                                            {
                                                "example_id": "8657d913-5c51-4c82-a419-78ebbfef7c6b",
                                                "sense_id": "d8d4d05f-a760-33de-b6c6-23ada2943941",
                                                "text": "„Der Moderator hob den Finger.“"
                                            },
                                            {
                                                "example_id": "bb471b3c-95de-4cf7-93da-505b97f8b431",
                                                "sense_id": "d8d4d05f-a760-33de-b6c6-23ada2943941",
                                                "text": "„Ein Moderator mit gelglattem Haar erzählte Witze über Ahmadinedschad.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5b5b69b9-0b3b-3a74-b3b4-1e956663eeec",
                                        "entry_id": "b2efe47e-5bdb-306a-b77f-ab365f4bc076",
                                        "glosses": [
                                            "Material, das die Geschwindigkeit von freien Neutronen mindert"
                                        ],
                                        "tags": [
                                            "Kernphysik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cde01618-20bb-4654-ad14-9e702edc0a29",
                                                "sense_id": "5b5b69b9-0b3b-3a74-b3b4-1e956663eeec",
                                                "text": "„Durch das Einbringen von zusätzlichen Moderatoren kann das Energiespektrum der Neutronen auch zu höheren oder niedrigeren Energien verschoben werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
