                                    },
                                    {
                                        "sense_id": "db3174c9-7a40-3ea8-b318-478a5245f1dd",
                                        "entry_id": "d5807d6b-9b6f-3747-9182-d62f04b37d99",
                                        "glosses": [
                                            "To swallow."
                                        ],
                                        "tags": [
                                            "of fowls and fish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d054f47-6caa-48cf-915f-c294f7d4be1e",
                                                "sense_id": "db3174c9-7a40-3ea8-b318-478a5245f1dd",
                                                "text": "And, to name no more, the common Heron hath its most remarkable Parts adapted to this Service; long Legs for wading; and a long Neck answerable thereto to reach Prey; a wide, extensive Throat to pouch it; long Toes, with strong hooked Talons […]"
                                            },
                                            {
                                                "example_id": "c736996e-f3fc-4494-9261-81d781cd14ea",
                                                "sense_id": "db3174c9-7a40-3ea8-b318-478a5245f1dd",
                                                "text": "[…] but if they shake the line and move, after they have remained still three or four minutes, you may conclude the fish has pouched the bait and feels the hooks, then wind up your slack and strike, but not violently, and always mind to keep the point of your rod a little raised while you are playing and killing your fish […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "250cf477-6570-3408-9c17-e8e3bf960e27",
                                        "entry_id": "d5807d6b-9b6f-3747-9182-d62f04b37d99",
                                        "glosses": [
                                            "To pout."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc7918f3-bdec-4ecf-a186-8b49250ae8a2",
                                                "sense_id": "250cf477-6570-3408-9c17-e8e3bf960e27",
                                                "text": "He pouched his mouth, and reared himself up and swelled; but answered me not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56b4c26c-e9f0-3ba4-bc40-d195dcf824e2",
                                        "entry_id": "d5807d6b-9b6f-3747-9182-d62f04b37d99",
                                        "glosses": [
                                            "To pocket; to put up with."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0833ffb8-95b0-41ce-86f6-31d1fb67f9c2",
                                                "sense_id": "56b4c26c-e9f0-3ba4-bc40-d195dcf824e2",
                                                "text": "And for the value of the gowden piece , it shall never be said I pouched her siller"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
