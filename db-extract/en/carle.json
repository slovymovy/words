                "senses": [
                    {
                        "sense_id": "98f7ddac-7f45-3e23-8a2e-472f6eeed3d4",
                        "entry_id": "df0b87f6-7963-3d99-8d5f-c31b0f8d1c8f",
                        "glosses": [
                            "peasant; fellow"
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "830b9412-dbdd-43e0-8c64-bcb9de79e29c",
                                "sense_id": "98f7ddac-7f45-3e23-8a2e-472f6eeed3d4",
                                "text": "Eh, Mr Henry! but the carle gae him a screed o' doctrine! Ye might hae heard him a mile down the wind—He routed like a cow in a fremd loaning."
                            },
                            {
                                "example_id": "9155096e-91bf-446b-9af3-dbd3d2fb3188",
                                "sense_id": "98f7ddac-7f45-3e23-8a2e-472f6eeed3d4",
                                "text": "Had he instead of on the Doge's throne Stamped the same brand upon a peasant's stool, His blood had gilt the threshold; for the carle Had stabbed him on the instant."
                            },
                            {
                                "example_id": "702f59e6-f648-43fa-92b4-f246b8b414c8",
                                "sense_id": "98f7ddac-7f45-3e23-8a2e-472f6eeed3d4",
                                "text": "Ye may fancy I'm talking like a sour, disappointed auld carle."
                            },
                            {
                                "example_id": "e8eef17c-0a2a-457b-b7f4-3de7f856833b",
                                "sense_id": "98f7ddac-7f45-3e23-8a2e-472f6eeed3d4",
                                "text": "Spake the sad and sorry carle: \"We seek the Land where the days are many: so many that he who hath forgotten how to laugh, may learn the craft again, and forget the days of Sorrow.\""
                            },
                            {
                                "example_id": "7c5436fb-5970-413f-af49-3f2d5360f792",
                                "sense_id": "98f7ddac-7f45-3e23-8a2e-472f6eeed3d4",
                                "text": "I am no sheephearde with a Curre, attending on the flockes:"
                            }
                        ]
                    }
                ],
