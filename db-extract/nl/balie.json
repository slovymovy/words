                    {
                        "translation_id": "b210a092-b587-4b30-bfed-04a054537efa",
                        "source_entry_id": "f8660cfe-a621-3536-8cee-a1d8d0e36414",
                        "source_sense_id": "442930bb-9121-363d-895f-d686302e178e",
