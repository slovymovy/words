                "senses": [
                    {
                        "sense_id": "ee38ea42-50f0-3612-a3b0-1f70c6b7ac8b",
                        "entry_id": "46bead09-47b0-3052-9feb-8f2dc8ed4409",
                        "glosses": [
                            "Schiff, das andere bei ihren Operationen begleitet und unterstützt/entlastet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "447b5eaf-4345-4d12-9eba-1a21b15ebb98",
                                "sense_id": "ee38ea42-50f0-3612-a3b0-1f70c6b7ac8b",
                                "text": "„Alles in allem ist Tender Main ein perfekt auf Uboote zugeschnittenes Begleitschiff, das den gehobenen Ansprüchen der modernen Ubootwaffe gerecht wird.“"
                            },
                            {
                                "example_id": "7790b56e-f40f-4e71-adc9-5eb9775b0fba",
                                "sense_id": "ee38ea42-50f0-3612-a3b0-1f70c6b7ac8b",
                                "text": "„Aber den ganzen Tag über blieben die Begleitschiffe in höchster Alarmbereitschaft, immer wieder wurde U 96 gezwungen, sich auf Distanz zu halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
