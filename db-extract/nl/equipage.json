                                            {
                                                "example_id": "0021bf4b-96b5-415b-a05c-bd9bc8a8941c",
                                                "sense_id": "3bcf8a9f-7082-355b-a8da-2ee78b29a1a5",
                                                "text": "The remainder of the men were employed in unbarreling our Pork and stringing it on poles for convenience of carriage, and carrying our Batteaux from the river to the pond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59196c54-d1d4-33e5-8134-349d961b982e",
                                        "entry_id": "906a4360-afdb-3e5f-b9da-02c9fbd83328",
