                                    {
                                        "sense_id": "b17a54d4-e266-327a-a90f-a3b2d7eaf49b",
                                        "entry_id": "b7b14f38-cb89-3f3c-8a41-8977b344828f",
                                        "glosses": [
                                            "europäischer Staat in den Pyrenäen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "798773ee-bdf0-4465-8b44-361538ffa66d",
                                                "sense_id": "b17a54d4-e266-327a-a90f-a3b2d7eaf49b",
                                                "text": "Sein Vater stammt aus Andorra."
                                            },
                                            {
                                                "example_id": "e037470c-a567-4294-afab-b7a72aed2894",
                                                "sense_id": "b17a54d4-e266-327a-a90f-a3b2d7eaf49b",
                                                "text": "Andorra la Vella ist die Hauptstadt von Andorra."
                                            },
                                            {
                                                "example_id": "2bc9cf46-844e-474d-b700-e3b9bd7c10a4",
                                                "sense_id": "b17a54d4-e266-327a-a90f-a3b2d7eaf49b",
                                                "text": "„Dieser Besuch führt Sie zurück in das Andorra des 19. und 20. Jahrhunderts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f717310c-86d3-4a4e-907d-f1b9044bd58c",
                        "source_entry_id": "36f275b3-5f67-3740-97cf-0a80030cb9b5",
                        "source_sense_id": "4001e1fe-da75-3731-905d-64c74ae73b90",
                        "source_sense_description": "een kleine staat in Europa die grenst aan Frankrijk en Spanje",
                        "target_lang_word": "Andorre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Andorre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85f59652-6fbe-31fe-a588-4ae30f89b63e",
                                        "entry_id": "47f40b53-ff1a-3a11-a972-992842c3ca49",
                                        "glosses": [
                                            "Petit pays des Pyrénées, situé entre l’Espagne et la France et dont la capitale est Andorre-la-Vieille."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d532b92-379b-4c59-9a93-11e4ccffbf3a",
                                                "sense_id": "85f59652-6fbe-31fe-a588-4ae30f89b63e",
                                                "text": "Vers l’an 790, Charlemagne, ayant marché contre les Maures d’Espagne, les défît dans une vallée des Pyrénées, contiguë à celle de l’Andorre, et qui porte encore son nom (vallée de Carol)."
                                            },
                                            {
                                                "example_id": "740e503c-0681-431b-b38c-afb3eb5c5bd0",
                                                "sense_id": "85f59652-6fbe-31fe-a588-4ae30f89b63e",
                                                "text": "Et le meunier-charbonnier sortit, fit claquer dans la serrure une clef grosse comme celle de la mairie d'Andorre, me laissant seul face à mon pensum."
                                            },
                                            {
                                                "example_id": "508cc6b8-8217-4220-867e-8e2bc3c4ca34",
                                                "sense_id": "85f59652-6fbe-31fe-a588-4ae30f89b63e",
                                                "text": "Hier après-midi, une collision frontale entre deux véhicules en Ariège, au niveau de Savignac-les-Ormeaux, près d’Ax-les-Thermes, sur la RN20, une route très fréquentée reliant Toulouse à l’Andorre, a fait six morts, dont deux enfants, et plusieurs blessés, a-t-on appris auprès du parquet de Foix."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
