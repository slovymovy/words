                "senses": [
                    {
                        "sense_id": "dcf38978-83b3-304e-bc45-f6f37bffb2d1",
                        "entry_id": "12a281f7-6553-3cdc-9351-eab57b33dc2a",
                        "glosses": [
                            "мед. вызывающий возникновение злокачественной опухоли, способствующий развитию канцера (рака)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92446149-11c3-4ddf-93d5-90df29bc19a3",
                                "sense_id": "dcf38978-83b3-304e-bc45-f6f37bffb2d1",
                                "text": "Из-за запрета на использование свинца некоторые китайские производители детской бижутерии, поставляемой на рынок США, стали использовать ещё более токсичный и канцерогенный кадмий, сообщает агентство Associated Press со ссылкой на результаты собственного исследования."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dda0c6d3-9b35-45ff-ad7e-aa33de7e8f3f",
