    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "13af4cf9-8d07-3d3b-9294-a506272ec759",
                "word": "mackintosh",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "34d844d3-0670-40b8-ae7e-980764e2cc07",
                        "entry_id": "13af4cf9-8d07-3d3b-9294-a506272ec759",
                        "tags": [
                            "plural"
                        ],
                        "form": "mackintoshes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d69cf18c-f0e1-3bd7-b8ec-713fccc75e7b",
                        "entry_id": "13af4cf9-8d07-3d3b-9294-a506272ec759",
                        "glosses": [
                            "A waterproof long coat made of rubberized cloth."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fef33152-fa17-3eb5-9f51-bd847005b2b7",
                        "entry_id": "13af4cf9-8d07-3d3b-9294-a506272ec759",
                        "glosses": [
                            "Any waterproof coat or raincoat."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2cc7a687-bb90-4b7f-9aa7-bb6607cfed5d",
                                "sense_id": "fef33152-fa17-3eb5-9f51-bd847005b2b7",
                                "text": "c. 1924, A.A. Milne, \"Happiness\", in When We Were Very Young\nJohn had great big waterproof boots on;\nJohn had a great big waterproof hat;\nJohn had a great big waterproof mackintosh --\nAnd that (Said John) is that."
                            },
                            {
                                "example_id": "6c488deb-b253-463a-8c72-88520b3a7460",
                                "sense_id": "fef33152-fa17-3eb5-9f51-bd847005b2b7",
                                "text": "The screeching of brakes, the monotonous blare of motor horns, the clip-clip of shoes on slippery pavements, the rustling of wet mackintoshes were all part of the great metropolis."
                            }
                        ]
                    },
                    {
                        "sense_id": "f11620cf-f96f-311e-bc77-05f4cecd3560",
                        "entry_id": "13af4cf9-8d07-3d3b-9294-a506272ec759",
                        "glosses": [
                            "Waterproof rubberized cloth."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5c4d289-18ee-471a-ad09-7bd5ee1d9f07",
                        "source_entry_id": "13af4cf9-8d07-3d3b-9294-a506272ec759",
                        "source_sense_description": "waterproof coat made of rubberized cloth",
                        "target_lang_word": "макинто́ш",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "макинто́ш",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3ce0fbc0-4c4f-3b5a-a5bf-8bdabda4507b",
                                        "entry_id": "10268ff5-3b18-39eb-9aba-5767f8b73680",
                                        "glosses": [
                                            "плащ, пальто из прорезиненной, непромокаемой ткани"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "996b6984-faff-4a34-8e83-aecd1eb20619",
                                                "sense_id": "3ce0fbc0-4c4f-3b5a-a5bf-8bdabda4507b",
                                                "text": "В мягкой шляпе и тёмно-синем макинтоше сейчас он был похож скорее на праздного гуляку, чем на работника гестапо."
                                            },
                                            {
                                                "example_id": "4c1b7a06-14d7-49ae-92d6-b0df22210f59",
                                                "sense_id": "3ce0fbc0-4c4f-3b5a-a5bf-8bdabda4507b",
                                                "text": "Он прошёл через довольно длинный коридор мимо вешалки, на которой висело множество пальто, макинтошей и шляп."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "913a6311-dfbf-3955-bed9-c85d61ac1521",
                                        "entry_id": "10268ff5-3b18-39eb-9aba-5767f8b73680",
                                        "glosses": [
                                            "ботан. искаж. популярный в Северной Америке сорт яблок, названный в честь его создателя, Джона Макинтоша"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4a60eca-bd66-3e7f-824e-81533d204a10",
                                        "entry_id": "10268ff5-3b18-39eb-9aba-5767f8b73680",
                                        "glosses": [
                                            "комп. разг. собир. название популярного персонального компьютера или семейства персональных компьютеров, спроектированных, разработанных, производимых и продаваемых фирмой Эппл"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9148bec1-c122-4aa5-a0eb-d6fa47443493",
                                                "sense_id": "a4a60eca-bd66-3e7f-824e-81533d204a10",
                                                "text": "— Может, у меня глюки, — проговорил он. — Но, по-моему, это макинтош. // Эмблема яблока подтверждала его слова."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
