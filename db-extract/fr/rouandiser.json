                "senses": [
                    {
                        "sense_id": "c23b7a80-3f0b-33a9-8612-5365a3bdf668",
                        "entry_id": "fb5095fd-796a-3d08-8a2f-f4893f65636e",
                        "glosses": [
                            "Autre orthographe, plus rare, de rwandiser (donner un caractère rwandais à quelque chose)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7d1de7b-1615-48db-97ec-c17498a9f39c",
                                "sense_id": "c23b7a80-3f0b-33a9-8612-5365a3bdf668",
                                "text": "Oubliez-vous le Sénégal, exemple de démocratie, ou préfèreriez-vous imiter François Soudan, ce mercenaire de la plume, pour rouandiser la Guinée?"
                            },
                            {
                                "example_id": "230387e4-149d-450a-860d-4e4693070e3a",
                                "sense_id": "c23b7a80-3f0b-33a9-8612-5365a3bdf668",
                                "text": "J'en appelle à l'Union Européenne, aux Nations Unies, à toutes les Ambassades pour nous aider à protéger la Guinée afin que ce pays qui n'a jamais connu de guerre civile même au pire moment de la révolution de Sékou Touré, ne se Rouandise pas."
                            }
                        ]
                    }
                ],
