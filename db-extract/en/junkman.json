                                        "glosses": [
                                            "jemand, der professionell Schrott kauft und verkauft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f79a111-c85c-4b5e-835e-633ebf352098",
                                                "sense_id": "881976ab-ee54-34d0-a6ff-2b55a64507fa",
                                                "text": "Der Schrotthändler verkaufte seinen Kupferschrott an eine Schmelzhütte."
                                            },
                                            {
                                                "example_id": "32c4b4bd-0038-49ed-b176-8600ab5190ce",
                                                "sense_id": "881976ab-ee54-34d0-a6ff-2b55a64507fa",
                                                "text": "„Mit diesem ungewöhnlichen Fund hatte ein amerikanischer Schrotthändler im mittleren Westen der USA sicher nicht gerechnet.“"
                                            },
                                            {
                                                "example_id": "66bbbac1-4946-445f-bb8f-4d0a1ed961bd",
                                                "sense_id": "881976ab-ee54-34d0-a6ff-2b55a64507fa",
                                                "text": "„Einem gewissenhaften Kassenarzt war es geglückt, einen geizigen Schrotthändler, der aus dem letzten Loch gepfiffen hatte, noch mal auf die Beine zu bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
