                            },
                            {
                                "target_word": "lie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f0630d5-11db-3350-bc4e-b3391287e68c",
                                        "entry_id": "ec342672-c7bd-3c45-83ef-aff56dea9deb",
                                        "glosses": [
                                            "To give false information intentionally with intent to deceive."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61ecd174-167e-48b3-8327-81eb1c8ca4fd",
                                                "sense_id": "8f0630d5-11db-3350-bc4e-b3391287e68c",
                                                "text": "When Pinocchio lies, his nose grows."
                                            },
                                            {
                                                "example_id": "813dd123-902a-453c-b7d4-d206aa875637",
                                                "sense_id": "8f0630d5-11db-3350-bc4e-b3391287e68c",
                                                "text": "If you are found to have lied in court, you could face a penalty."
                                            },
                                            {
                                                "example_id": "17d8bbca-dba7-4e7e-8e2d-7c03fc88f29c",
                                                "sense_id": "8f0630d5-11db-3350-bc4e-b3391287e68c",
                                                "text": "Don't lie to me!"
                                            },
                                            {
                                                "example_id": "749ceeb2-8f1e-416c-899f-87704d9dc753",
                                                "sense_id": "8f0630d5-11db-3350-bc4e-b3391287e68c",
                                                "text": "It is true that the latter had assumed much more of the fault than was rightly his, but if he lied a little he may be excused, for he lied in the service of a woman, and he lied like a gentleman."
                                            },
                                            {
                                                "example_id": "eabacc20-7802-4608-98df-a0bac938bc4c",
                                                "sense_id": "8f0630d5-11db-3350-bc4e-b3391287e68c",
                                                "text": "Lie to get what I came for\nLie to get just what I need\nLie to get what I crave\nLie and smile to get what's mine"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edf8a31e-4501-3363-9b62-16aae9333681",
                                        "entry_id": "ec342672-c7bd-3c45-83ef-aff56dea9deb",
                                        "glosses": [
                                            "To convey a false image or impression."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d9fcaf6-5469-4665-ab7f-59ce811fedd6",
                                                "sense_id": "edf8a31e-4501-3363-9b62-16aae9333681",
                                                "text": "Photographs often lie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fc1bbfc-3956-388f-8276-3c6947f6a9b7",
                                        "entry_id": "ec342672-c7bd-3c45-83ef-aff56dea9deb",
                                        "glosses": [
                                            "To be mistaken or unintentionally spread false information."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57a15a40-5107-4f6f-9d92-172ff5bc1a9a",
                                                "sense_id": "5fc1bbfc-3956-388f-8276-3c6947f6a9b7",
                                                "text": "Sorry, I haven't seen your keys anywhere...wait, I lied! They're right there on the coffee table."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3039d8f-2375-3f04-b8c7-c64a29527d76",
                                        "entry_id": "b750c3f7-d001-3076-93c6-8298966ceba9",
                                        "glosses": [
                                            "An intentionally false statement; an intentional falsehood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c49cbcb3-c3a1-4f3a-aa4f-6c7ecb43a60b",
                                                "sense_id": "e3039d8f-2375-3f04-b8c7-c64a29527d76",
                                                "text": "I knew he was telling a lie by his facial expression."
                                            },
                                            {
                                                "example_id": "ec91dfd8-d69a-483a-8e19-c826e340fb86",
                                                "sense_id": "e3039d8f-2375-3f04-b8c7-c64a29527d76",
                                                "text": "Man everywhere is the born enemy of lies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5091a74-12fe-341b-8e33-efb3135c8a28",
                                        "entry_id": "b750c3f7-d001-3076-93c6-8298966ceba9",
                                        "glosses": [
                                            "A statement intended to deceive, even if literally true."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6bcfaaae-3598-35a3-9886-c19ec9d0ee45",
                                        "entry_id": "b750c3f7-d001-3076-93c6-8298966ceba9",
                                        "glosses": [
                                            "Anything that misleads or disappoints."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "242e5641-5368-4503-aff3-6cff931a4182",
                                                "sense_id": "6bcfaaae-3598-35a3-9886-c19ec9d0ee45",
                                                "text": "Wishing this lie of life was o'er."
                                            },
                                            {
                                                "example_id": "6addc2aa-1afe-487a-862e-0915bcffb2fa",
                                                "sense_id": "6bcfaaae-3598-35a3-9886-c19ec9d0ee45",
                                                "text": "The cake is a lie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9240f540-be58-34b0-9900-998627ed02c4",
                                        "entry_id": "b750c3f7-d001-3076-93c6-8298966ceba9",
                                        "glosses": [
                                            "A liar; a dishonest person."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7326983e-6f6e-4715-b76a-ad9cffe143cd",
                        "source_entry_id": "aef4485e-09b0-35c6-8496-9bb00d527b14",
                        "target_lang_word": "mentira",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mentira",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "687407eb-a7c4-3dc5-86d1-d9ee9ed7bfe8",
                                        "entry_id": "a0450c06-71e5-3764-bf45-ca30d6070f99",
                                        "glosses": [
                                            "Acción o efecto de mentir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df16fbc2-b8fb-45cd-b770-25760b03299d",
                                                "sense_id": "687407eb-a7c4-3dc5-86d1-d9ee9ed7bfe8",
                                                "text": "Mas vosotras non curades synon de afeytarvos e apostarvos vanamente. Mas algunas ay que se escusan, diziendo que lo fazen por sus maridos. E esto es muy grand mentira."
                                            }
                                        ],
