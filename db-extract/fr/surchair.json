                        "glosses": [
                            "Peau tannée d’agneau ayant subi un traitement spécial (nommée aussi peau de chien car lors de leur tannage, elles reposaient une journée dans des excréments de chien)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f5d3cf5-7593-4241-9559-9cc9ae6bee6f",
                                "sense_id": "0d0270e8-89de-384e-a178-04a5e7d7ac0b",
                                "text": "Le chevreau, le castor ou chamois, l’agneau et le surchair, quelquefois improprement appelé peau de chien, et qui n’est que de l’agneau, sont les différentes peaux mises en usage."
                            }
                        ]
                    },
