                                "example_id": "54e11404-d66a-4452-b794-e1cd8efe07ba",
                                "sense_id": "1c6fe1d0-68cb-3a19-9a44-459b12d4323e",
                                "text": "Les pensées finissent par s’autoépuiser."
                            },
                            {
                                "example_id": "1254e17e-5273-4649-b820-51d3d379e44a",
                                "sense_id": "1c6fe1d0-68cb-3a19-9a44-459b12d4323e",
                                "text": "Ils se rencontrent encore dans une constante mise en problème ou énigme du moi qui finit par s’autoépuiser dans une infinie tristesse de soi, et qui conditionne la conversion comme un événement libérateur, cathartique."
                            },
                            {
                                "example_id": "1eca155e-cfea-4e35-bb72-349464fc83db",
                                "sense_id": "1c6fe1d0-68cb-3a19-9a44-459b12d4323e",
                                "text": "Voilà je vais encore réussir à m’autoépuiser"
                            }
                        ]
