                ],
                "translations": [
                    {
                        "translation_id": "6d75541f-d7fc-48f6-8d0a-b7f0ce1698ca",
                        "source_entry_id": "0796858b-5f96-3ac1-a371-3869b66f873f",
                        "source_sense_id": "53849986-817c-3f54-b5b0-bd074d2e2303",
                        "source_sense_description": "antike Hauptstadt von Babylonien",
                        "target_lang_word": "Babylon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Babylon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3618e44-e0e9-3cec-ba67-c005afe9896b",
                                        "entry_id": "5f8172f5-3d89-34ea-99ea-495a79ace5b6",
                                        "glosses": [
                                            "An ancient city, the ancient capital of Babylonia in modern Iraq, built on the banks of the Euphrates."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6793d67f-b0e8-4012-8628-0f11117abc13",
                                                "sense_id": "d3618e44-e0e9-3cec-ba67-c005afe9896b",
                                                "text": "Standing afarre off for the feare of her torment, saying, Alas, alas, that great citie Babylon, that mighty citie: for in one houre is thy iudgement come."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07d6ce2d-9424-3471-a7be-e7ce921f9533",
                                        "entry_id": "5f8172f5-3d89-34ea-99ea-495a79ace5b6",
                                        "glosses": [
                                            "A governate in Iraq."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5033133e-35d8-3e4a-81bc-6a6b2352d1db",
                                        "entry_id": "5f8172f5-3d89-34ea-99ea-495a79ace5b6",
                                        "glosses": [
                                            "Any city of great wealth, luxury and vice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb43436e-4538-4649-ace6-efe013da4aba",
                                                "sense_id": "5033133e-35d8-3e4a-81bc-6a6b2352d1db",
                                                "text": "Mother[…]considered that the exclusiveness of Peter's circle was due not to its distinction, but to the fact that it was an inner Babylon of prodigality and whoredom, from which every Kensingtonian held aloof, except on the conventional tip-and-run excursions in pursuit of shopping, tea and theatres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80cbc85e-70e4-3ca0-bcad-2d06f424884f",
                                        "entry_id": "5f8172f5-3d89-34ea-99ea-495a79ace5b6",
                                        "glosses": [
                                            "Western civilization, seen as corrupt and materialistic, and contrasted with Zion."
                                        ],
                                        "tags": [
                                            "Rastafari"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eeef6bd3-23a6-3d5c-9850-92006aedd6df",
                                        "entry_id": "5f8172f5-3d89-34ea-99ea-495a79ace5b6",
                                        "glosses": [
                                            "The police."
                                        ],
                                        "tags": [
                                            "Jamaica",
                                            "Multicultural-London-English"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "530a2c27-669a-46cc-a89a-5a1887d86f13",
                                                "sense_id": "eeef6bd3-23a6-3d5c-9850-92006aedd6df",
                                                "text": "When I was the first officer on the scene at a nightclub brawl, I was picked up by the throat and strangled by a huge Rastafarian who was trying to kill me. I was losing consciousness when Marlon told him to let me go.\nI remember him saying, ‘She’s alright for Babylon. Put her down.’ He dropped me and I ran to the station with massive bruises around my neck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08099f15-9ed7-3d20-b2b2-76f41fb379e6",
                                        "entry_id": "5f8172f5-3d89-34ea-99ea-495a79ace5b6",
                                        "glosses": [
                                            "An unincorporated community in Fulton County, Illinois, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "575f739f-dcdc-399b-a013-18a598da8f76",
                                        "entry_id": "5f8172f5-3d89-34ea-99ea-495a79ace5b6",
                                        "glosses": [
                                            "A town and village therein, in Suffolk County, Long Island, New York, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f080df79-4534-477b-a64a-5b8876acbcbc",
                        "source_entry_id": "0796858b-5f96-3ac1-a371-3869b66f873f",
                        "source_sense_id": "53849986-817c-3f54-b5b0-bd074d2e2303",
                        "source_sense_description": "antike Hauptstadt von Babylonien",
                        "target_lang_word": "Babylone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Babylone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69797a9e-4dc1-3008-97a0-616a5f235560",
                                        "entry_id": "8aeee7fd-c802-3446-b9bf-927f8d0cffac",
                                        "glosses": [
                                            "Ville antique de Mésopotamie située sur l’Euphrate dans ce qui est aujourd’hui l’Iraq."
                                        ],
                                        "tags": [
                                            "Ancient",
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96259594-802d-47fa-8f4a-772a97129c58",
                                                "sense_id": "69797a9e-4dc1-3008-97a0-616a5f235560",
                                                "text": "L’humanité avait-elle les moyens de prévenir ce désastre de la guerre dans les airs ? Question oiseuse, aussi oiseuse que de demander si elle aurait pu empêcher la décadence qui transforma l’Assyrie et Babylone en des déserts arides."
                                            },
                                            {
                                                "example_id": "cb0763db-0ae1-4abd-8a3c-1e47edf2dd13",
                                                "sense_id": "69797a9e-4dc1-3008-97a0-616a5f235560",
                                                "text": "Pourtant, le Roi des Rois n’est pas heureux. De la tour de son palais, à sept étages, tandis que la nuit tombe, il regarde avec colère la liesse de Babylone, la capitale du monde."
                                            },
                                            {
                                                "example_id": "49ff4e34-7d1b-4eb5-9887-e0f48632c02d",
                                                "sense_id": "69797a9e-4dc1-3008-97a0-616a5f235560",
                                                "text": "Mais à Babylone, en 323, la maladie foudroie le jeune souverain qui meurt à trente-trois ans, tout auréolé de gloire. Alexandre a donné naissance à une monarchie universelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3336273-7805-3b2b-b75e-d602e11d8276",
                                        "entry_id": "8aeee7fd-c802-3446-b9bf-927f8d0cffac",
                                        "glosses": [
                                            "Lieu de désordre et de crimes, le monde profane, la société moderne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b47b843-b6f3-4fec-99c9-71e5e2e91557",
                                                "sense_id": "a3336273-7805-3b2b-b75e-d602e11d8276",
                                                "text": "[…] André, les yeux rouges et mourant de faim, comprit qu’il était arrivé dans la « moderne Babylone »."
                                            },
                                            {
                                                "example_id": "f01a5f57-e7ad-442e-b700-e0a9de9438ad",
                                                "sense_id": "a3336273-7805-3b2b-b75e-d602e11d8276",
                                                "text": "Des millions d’Américains et de touristes étrangers franchissaient les portes de cette Babylone moderne pour venir y pécher en toute connaissance de cause, puis passaient le reste de l’année à se laver de leurs fautes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fe0b3a1-d6a1-480a-88c4-26ea0a996076",
                        "source_entry_id": "0796858b-5f96-3ac1-a371-3869b66f873f",
                        "source_sense_id": "53849986-817c-3f54-b5b0-bd074d2e2303",
