                ],
                "senses": [
                    {
                        "sense_id": "e92e496d-2411-3fbf-b7b8-f018ec187aa1",
                        "entry_id": "49833d35-b693-3a98-b5ec-990dc42b3b1b",
                        "glosses": [
                            "mit Dreck verschmiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33e94116-ec2b-4f94-89e4-6fe8329b3835",
                                "sense_id": "e92e496d-2411-3fbf-b7b8-f018ec187aa1",
                                "text": "„Ihre Beine waren dreckverschmiert und sie hielt das Gerät mit beiden Händen fest.“"
                            },
                            {
                                "example_id": "e9460ca7-ac3f-4640-adf5-84f4c99df4e1",
                                "sense_id": "e92e496d-2411-3fbf-b7b8-f018ec187aa1",
                                "text": "„Ärzte und Krankenschwestern wühlten dreckverschmiert im Schutt nach Toten und Verwundeten.“"
                            },
                            {
                                "example_id": "c99556ed-e339-456d-82e5-22b24470ddd1",
                                "sense_id": "e92e496d-2411-3fbf-b7b8-f018ec187aa1",
                                "text": "„Dreckverschmiert rappelte sie sich schließlich auf und presste die Hände in ihren brennenden Schritt.“"
                            },
                            {
                                "example_id": "938dc62f-2288-4e54-ab94-ebe3286acb4b",
                                "sense_id": "e92e496d-2411-3fbf-b7b8-f018ec187aa1",
                                "text": "„Ich betrachtete die dreckverschmierten Kinder, wie sie Flaschen an den niemals geleerten Mülleimern zerschlugen und um herrenlose Autos herum - denen hartnäckige Gelegenheitsdiebe alles Wertvolle sowie jeden Fetzen Gummi und Stoff geraubt hatten - Katzen und Hunden und sich gegenseitig nachjagten.“"
                            },
                            {
                                "example_id": "e04ef5ff-fbea-4959-af42-9f41e444e089",
                                "sense_id": "e92e496d-2411-3fbf-b7b8-f018ec187aa1",
                                "text": "„Außerdem hatten beide noch keinerlei gesellschaftlichen Status und daher nichts zu verlieren, wenn sie mit dreckverschmierten Genitalien nackt durch die Gegend sprangen.“"
                            },
                            {
                                "example_id": "ddcd7282-5e4a-4582-8696-db8d9f3012b7",
                                "sense_id": "e92e496d-2411-3fbf-b7b8-f018ec187aa1",
                                "text": "„Iqbal-virji kam und wusch sich unter der Pumpe die dreckverschmierten Arme und Hände.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
