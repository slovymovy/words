                ],
                "senses": [
                    {
                        "sense_id": "6ad8c533-270a-3e59-b0f1-154413fef8fd",
                        "entry_id": "5ba18500-b970-3879-ac17-6a9c36c0edd9",
                        "glosses": [
                            "Sämaschine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c79a8921-78d2-47ec-92c5-22aa4677167c",
                                "sense_id": "6ad8c533-270a-3e59-b0f1-154413fef8fd",
                                "text": "„Der Gebrauch der Drille (Säemaschine für Reihensaat). Ehe man anfängt, öhle man die Achse der Drille sowohl als die des Vordergestells, sowie auch die der Trommel.“ (1859)"
                            },
                            {
                                "example_id": "560b1607-0c47-4c3b-a308-fe4919b23f03",
                                "sense_id": "6ad8c533-270a-3e59-b0f1-154413fef8fd",
                                "text": "„Da aber die Drille alle Samenkörner gleich tief in den Boden bringt, so ist es eine wichtige Frage, die rechte Tiefe zu treffen.“ (1864)"
                            },
                            {
                                "example_id": "5c2c0aa8-650f-43af-ae46-352db59bbf06",
                                "sense_id": "6ad8c533-270a-3e59-b0f1-154413fef8fd",
                                "text": "„Wenn die Engländer Runkelrüben in Reihen säen, so brauchen Sie eine Drille.“ (1861)"
                            },
                            {
                                "example_id": "40dbf8fc-8043-4a57-be8f-39e98fedd514",
                                "sense_id": "6ad8c533-270a-3e59-b0f1-154413fef8fd",
                                "text": "„Auf den Rahmen wird eine Drille montiert, deren Sämechanismus vom Packer angetrieben wird (Bild 7). Durch die Anbringung am Schlepper konnten die Wendeschwierigkeiten der Krümeldrille beseitigt werden.“"
                            },
                            {
                                "example_id": "3ec1fb44-1aa4-4e62-9422-7fb6775f66d3",
                                "sense_id": "6ad8c533-270a-3e59-b0f1-154413fef8fd",
                                "text": "„Säemaschinen und Drillen sind Gegenstände, welche in Mecklenburg zu den Seltenheiten gehören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
