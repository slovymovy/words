                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55e20aa6-70d5-4b41-b088-49d62efd8ab7",
                                "sense_id": "426414fe-8236-316e-a613-ea0c1c95d539",
                                "text": "All the kneelers sighed with relief when they were told it was over and they could finally stand up."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d699dba-488c-39bf-ac11-9ea61ad99f66",
