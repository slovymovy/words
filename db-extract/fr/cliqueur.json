                        "glosses": [
                            "Appareil qui émet des clics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "609a13e0-b725-43f5-90d4-e05d21bca254",
                                "sense_id": "4028cef7-7147-3ce1-855a-5afa4fb0755f",
                                "text": "Depuis quelques années, on s’intéresse de plus en plus à une nouvelle technique éducative réputée pour son efficacité : le dressage au cliqueur, ou clicker training."
                            }
                        ]
                    },
