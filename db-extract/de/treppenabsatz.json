                    },
                    {
                        "form_id": "0f8ed7e6-849c-4681-a9f4-233d79483ea0",
                        "entry_id": "68a0efe1-4f2b-39f7-bc17-d9b9b749c3c8",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Treppenabsätze"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "59599a51-c9f7-31b3-b389-33f0346725b0",
                        "entry_id": "68a0efe1-4f2b-39f7-bc17-d9b9b749c3c8",
                        "glosses": [
                            "größere ebene Fläche, die den Verlauf einer Treppe in Abschnitte gliedert und die auch bei geraden Treppen einen Wechsel der Laufrichtung ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f603d2de-3a9a-43ed-900c-f2e9b45ca70e",
                                "sense_id": "59599a51-c9f7-31b3-b389-33f0346725b0",
                                "text": "„Ich öffnete behutsam die Tür, ging zum Treppenabsatz und stieg leise, sehr leise Stufe um Stufe hinunter.“"
                            },
                            {
                                "example_id": "aea9ebff-c61f-455a-a101-50ff2e057f65",
                                "sense_id": "59599a51-c9f7-31b3-b389-33f0346725b0",
                                "text": "„Innerhalb von fünf Minuten schob ich ihn dreimal vom Treppenabsatz fort, schmierte verbrannte Schultern mit Sonnenschutz ein, suchte das Ladekabel, um den drohenden Handyabsturz und das Verschwinden von SpongeBob zu vermeiden, und telefonierte mit der Besitzerin, weil im Pool plötzlich grüne Algen schwammen.“"
                            },
                            {
                                "example_id": "0e541609-fa13-413c-b838-15c4a8dcb592",
                                "sense_id": "59599a51-c9f7-31b3-b389-33f0346725b0",
                                "text": "„Zu dem Seidenmantel Tante Margueritens gehörten auch noch ein Paar seidene Handschuhe, die sie ganz besonders in Ehren hielt und immer erst auf dem obersten Treppenabsatz anzog.“"
                            },
                            {
                                "example_id": "ca6c92bb-78a4-44da-9b8b-1d0e531c1b08",
                                "sense_id": "59599a51-c9f7-31b3-b389-33f0346725b0",
                                "text": "„Auf den Treppenabsätzen standen Eimer mit Sand und Wasser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0306c36d-4e90-4527-b166-0fafc6891792",
                        "source_entry_id": "68a0efe1-4f2b-39f7-bc17-d9b9b749c3c8",
                        "source_sense_id": "59599a51-c9f7-31b3-b389-33f0346725b0",
                        "target_lang_word": "palier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66553b34-7d58-331d-947f-5b31cef4eff7",
                                        "entry_id": "4c571531-b1ec-3b81-920d-32aaafd9aaf9",
                                        "glosses": [
                                            "Organe utilisé en construction mécanique pour supporter et guider, en rotation, des arbres de transmission."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41bbdbf7-119c-475e-9a6e-64f6ca453c3f",
                                                "sense_id": "66553b34-7d58-331d-947f-5b31cef4eff7",
                                                "text": "L’ajustage des parties frottantes demande des précautions, notamment celui des coussinets sur les arbres et essieux. On doit leur donner un peu de jeu, surtout à l’entrée, afin d’éviter le pincement qui se produirait si l’axe venait à chauffer et à se dilater. Ils doivent, par contre, être très-exactement retenus dans leur chape ou palier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8da45032-cdd7-3ece-8506-a348a24096b1",
                                        "entry_id": "4c571531-b1ec-3b81-920d-32aaafd9aaf9",
                                        "glosses": [
                                            "Plate-forme aménagée dans un escalier ou dans une rampe au niveau des étages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "380d3424-c4ba-4aa4-bdb8-412285a1d049",
                                                "sense_id": "8da45032-cdd7-3ece-8506-a348a24096b1",
                                                "text": "Le palier est long et étroit, le mur est tendu d’une imitation de tapisserie à ramages vert sombre où brille le cuivre d’une applique à gaz."
                                            },
                                            {
                                                "example_id": "9797820c-4064-471c-b2c3-0b67e29b103d",
                                                "sense_id": "8da45032-cdd7-3ece-8506-a348a24096b1",
                                                "text": "Il n'est cependant pas fréquent de rencontrer plus de deux cabinets d’aisances pour un même corps de logis ; lorsque c'est le cas, ils sont posés les uns au-dessus des autres, ouvrant sur les paliers de repos des escaliers ou formant saillie au-dessus de la cour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f631608-ba2e-371a-8dce-59157e194063",
                                        "entry_id": "4c571531-b1ec-3b81-920d-32aaafd9aaf9",
                                        "glosses": [
                                            "Parvis d’une demeure modeste."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e494155-5e3a-385c-bb0b-a5a2319bbbf9",
                                        "entry_id": "4c571531-b1ec-3b81-920d-32aaafd9aaf9",
                                        "glosses": [
                                            "Étape, degré."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1c2ddea-f710-484e-b8f2-ec986bdb0cc6",
                                                "sense_id": "0e494155-5e3a-385c-bb0b-a5a2319bbbf9",
                                                "text": "Impôt qui progresse par paliers, par échelons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58e4bf52-0317-3426-8430-2722b0e32f0c",
                                        "entry_id": "4c571531-b1ec-3b81-920d-32aaafd9aaf9",
                                        "glosses": [
                                            "Partie d’une route, d’une voie de chemin de fer qui est horizontale, qui n’offre pas de pente."
                                        ],
