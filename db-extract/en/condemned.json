    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c5140a33-5c5d-3624-b9be-49a2ec27f26f",
                "word": "condemned",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bdeccb03-5715-3f54-a198-46a2d4a5f714",
                        "entry_id": "c5140a33-5c5d-3624-b9be-49a2ec27f26f",
                        "glosses": [
                            "Having received a curse to be doomed to suffer eternally."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "01ffcbbd-cdb5-34bf-95c5-2289ee9aede8",
                        "entry_id": "c5140a33-5c5d-3624-b9be-49a2ec27f26f",
                        "glosses": [
                            "Having been sharply scolded."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "dc5f8daf-07a3-40af-94ee-eb7b242de7fd",
                                "sense_id": "01ffcbbd-cdb5-34bf-95c5-2289ee9aede8",
                                "text": "Kim Jong-il, who has died aged 69, was the general secretary of the Workers party of Korea, and head of the military in the Democratic People's Republic of Korea (DPRK). He was one of the most reclusive and widely condemned national leaders of the late 20th and early 21st century, leaving his country diplomatically isolated, economically broken and divided from South Korea."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb7b754e-bff3-35f6-a359-effd451187ba",
                        "entry_id": "c5140a33-5c5d-3624-b9be-49a2ec27f26f",
                        "glosses": [
                            "Adjudged or sentenced to punishment, destruction, or confiscation."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "dca2fb8d-14be-42ef-980b-8b9558841ff2",
                                "sense_id": "fb7b754e-bff3-35f6-a359-effd451187ba",
                                "text": "I have written 'was' because it seems that Great British Railways, which has already survived a near-death experience when Harper took over as Transport Secretary in the autumn, may well be back in the condemned cell."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb4d6df3-d7ed-3eed-a372-cbbbfd59c147",
                        "entry_id": "c5140a33-5c5d-3624-b9be-49a2ec27f26f",
                        "glosses": [
                            "Officially marked uninhabitable."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ada7e990-18f4-42d1-99f6-f6b05963e395",
                                "sense_id": "eb4d6df3-d7ed-3eed-a372-cbbbfd59c147",
                                "text": "And she also faces the risk and the probability that her home will be condemned"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ccbd985-2f27-41ae-87f7-bb229bda8d3c",
                        "source_entry_id": "c5140a33-5c5d-3624-b9be-49a2ec27f26f",
                        "source_sense_description": "having received a curse to be doomed to suffer eternally",
                        "target_lang_word": "condamné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "condamné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9381cf5-2666-30ca-a7f7-22931a388ed9",
                                        "entry_id": "1c814fc1-2b7d-372d-aaeb-9bad2cd8fbed",
                                        "glosses": [
                                            "Qui est, ou a été, condamné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb58654b-93f2-4482-a92b-b19d2ec339ed",
                                                "sense_id": "d9381cf5-2666-30ca-a7f7-22931a388ed9",
                                                "text": "Portalis, quelque temps après, trouve de l’argent et lance un nouveau journal où il se met à défendre les communards arrêtés et condamnés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d57044fd-d9b1-3309-b6cb-ee9220c492d7",
                                        "entry_id": "1c814fc1-2b7d-372d-aaeb-9bad2cd8fbed",
                                        "glosses": [
                                            "Destiné à mourir sans remède."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b450de40-e6d9-4bf5-8adc-df1443873dc4",
                                                "sense_id": "d57044fd-d9b1-3309-b6cb-ee9220c492d7",
                                                "text": "Faubert, qui avait reçu une balle dans le ventre, dit alors : « Je croyais que les blessés du ventre ne devaient pas boire. » L’étudiant haussa les épaules, répondit : « Mais si, mais si… » Faubert avait compris qu’il était condamné, il mourut dans la nuit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "condamné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c457cb55-6d03-3850-b875-a7037c0ef6f3",
                                        "entry_id": "70c4ec02-6266-326e-88de-e50b35c73b4e",
                                        "glosses": [
                                            "Celui contre qui une peine afflictive ou infamante a été prononcée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fd73cda-ae61-4c43-b282-679d1d2e25e5",
                                                "sense_id": "c457cb55-6d03-3850-b875-a7037c0ef6f3",
                                                "text": "Indépendamment de la précision avec laquelle l’hypothèse du fait non infractionnel est prévue et l'absence de faute, exigée, ce Code est également très clair en n’accordant d’indemnité qu'au condamné reconnu innocent."
                                            },
                                            {
                                                "example_id": "331180cc-68bd-44dd-8507-388f3964183c",
                                                "sense_id": "c457cb55-6d03-3850-b875-a7037c0ef6f3",
                                                "text": "Les avocats du condamné plaidèrent la cause de leur client pendant une heure."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "condamné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea6a860b-c664-32c0-b6bc-525b8fa8465f",
                                        "entry_id": "96407cf0-5a95-32b9-95ab-0da2ddc9c65f",
                                        "glosses": [
                                            "Participe passé masculin singulier de condamner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "953424e3-eb0e-4832-b11d-68a9fb3e92cf",
                                                "sense_id": "ea6a860b-c664-32c0-b6bc-525b8fa8465f",
                                                "text": "La secrétaire d’État américaine Condoleezza Rice a condamné les « velléités hégémoniques » de l’Iran au Proche-Orient et le soutien apporté par le gouvernement iranien à des organisations comme le Hezbollah au Liban et le Hamas dans les territoires palestiniens, ainsi qu’aux talibans en Afghanistan et aux rebelles irakiens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30f31a98-7641-46b9-940b-82c6eafbc5f4",
