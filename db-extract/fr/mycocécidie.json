                        "sense_id": "45a4831d-e775-3524-9610-0e7d88c9ff0c",
                        "entry_id": "8ec25406-ab09-3efd-8f91-684eed945796",
                        "glosses": [
                            "Cécidie provoquée par un champignon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15803d5c-9b8c-4141-8259-b6111ed427f1",
                                "sense_id": "45a4831d-e775-3524-9610-0e7d88c9ff0c",
                                "text": "Hyperplasie ou tumeur provoquée par des invertébrés (zoocécidie) , des champignons (mycocécidie) ou des bactéries (bactériocécidie)."
                            },
                            {
                                "example_id": "fecccbf8-c60f-41b9-a3ca-310367aec643",
                                "sense_id": "45a4831d-e775-3524-9610-0e7d88c9ff0c",
                                "text": "Les mycocécidies sont, le plus souvent, des tuméfactions diffuses, épaississant et déformant l'organe attaqué (par exemple la « hernie » du Chou […]). Quelques mycocécidies sont, cependant, de véritables galles, c'est-à-dire des excroissances nettement délimitées et de forme plus ou moins définies."
                            }
                        ]
                    }
