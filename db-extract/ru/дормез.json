                    {
                        "translation_id": "3d949112-76f2-4a1e-a06e-83eabee44c05",
                        "source_entry_id": "2717a593-3634-3332-bcc8-20d6fb839d38",
                        "source_sense_id": "f5119aba-03be-3917-a30d-064c1cba8da5",
