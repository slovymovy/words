                                        "sense_id": "65dfbd3d-ffd6-36ea-b7bb-05cc4726e8ff",
                                        "entry_id": "b6cfabc0-7007-3b49-997f-b266dd6f2638",
                                        "glosses": [
                                            "A sound or action like liquid hitting a hard surface, or an object falling into a body of water."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bc5019f-5195-4c9a-9b90-5c5faa78f7d4",
                                                "sense_id": "65dfbd3d-ffd6-36ea-b7bb-05cc4726e8ff",
                                                "text": "He heard the plops of rain on the roof."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "290c896d-6153-3eb1-b41b-c9b637f414dc",
