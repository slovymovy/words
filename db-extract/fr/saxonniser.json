                "senses": [
                    {
                        "sense_id": "785b1951-c945-345d-82e7-a2f788d2afc2",
                        "entry_id": "675cccba-ab2a-3e8f-9ad6-6228267de82e",
                        "glosses": [
                            "Donner un caractère saxon à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4535d90-a5c7-488d-8b77-4dd287e62dea",
                                "sense_id": "785b1951-c945-345d-82e7-a2f788d2afc2",
                                "text": "Non : leur geste est d’une inconscience atavique, un atavisme limité et conditionné par les six générations que la conquête a saxonnisées."
                            },
                            {
                                "example_id": "04bf5189-3a9e-480d-a076-db9a3c756082",
                                "sense_id": "785b1951-c945-345d-82e7-a2f788d2afc2",
                                "text": "Que la France cesse d’exercer à la fois toutes ses influences sur les races latines de l’Amérique, et graduellement on les verra se saxonniser à l’instar du Texas et de la Californie."
                            }
                        ]
                    }
