{
    "word_family": [
        "firm",
        "firmness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                    "sense_definition": "In a secure manner so that something does not move, shake, or fall.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "securely",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please close the jar <w>firmly</w> to keep the food fresh.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>плотно</w> закрой банку, чтобы продукты оставались свежими.",
                                "zh": "请把罐子<w>严实地</w>盖好，以保持食物新鲜。"
                            }
                        },
                        {
                            "text": "He gripped the steering wheel <w>firmly</w> while driving on the icy road.",
                            "target_lang_translations": {
                                "ru": "Он <w>крепко</w> сжимал руль, пока ехал по обледенелой дороге.",
                                "zh": "在冰雪路面上开车时，他<w>紧紧地</w>握住方向盘。"
                            }
                        }
                    ],
                    "synonyms": [
                        "securely",
                        "tightly",
                        "steadily",
                        "strongly",
                        "solidly"
                    ],
                    "antonyms": [
                        "loosely",
                        "shakily"
                    ],
                    "common_phrases": [
                        "hold firmly",
                        "close firmly",
                        "attach firmly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Надёжно, крепко; так, чтобы предмет не двигался, не шатался и не падал.",
                        "zh": "以稳固的方式，使物体不会移动、摇晃或掉落。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кре́пко",
                                "target_lang_sense_clarification": "сильно сжимая или фиксируя"
                            },
                            {
                                "target_lang_word": "пло́тно",
                                "target_lang_sense_clarification": "о закрытии крышек, дверей и т.п."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紧紧地",
                                "target_lang_sense_clarification": "指用力抓握或固定"
                            },
                            {
                                "target_lang_word": "严实地",
                                "target_lang_sense_clarification": "指盖子、门窗等关闭得紧密"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01838417-3af3-3d3e-ad25-c74b00daaee7",
                    "sense_definition": "In a way that shows certainty, determination, or authority.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "resolutely",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher spoke <w>firmly</w> to the noisy students to restore order.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>твёрдо</w> заговорил с шумными учениками, чтобы восстановить порядок.",
                                "zh": "老师<w>坚定地</w>对吵闹的学生们说话，以恢复秩序。"
                            }
                        },
                        {
                            "text": "She <w>firmly</w> refused to accept the unfair offer from the buyer.",
                            "target_lang_translations": {
                                "ru": "Она <w>твёрдо</w> отказалась принять несправедливое предложение покупателя.",
                                "zh": "她<w>果断地</w>拒绝接受买方提出的不公平报价。"
                            }
                        }
                    ],
                    "synonyms": [
                        "resolutely",
                        "decidedly",
                        "determinedly"
                    ],
                    "antonyms": [
                        "hesitantly",
                        "weakly",
                        "gently"
                    ],
                    "common_phrases": [
                        "speak firmly",
                        "act firmly",
                        "deal firmly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твёрдо, решительно; показывая уверенность, непреклонность или власть.",
                        "zh": "以表现出确定性、决心或权威的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "твёрдо",
                                "target_lang_sense_clarification": "непреклонно, не отступая"
                            },
                            {
                                "target_lang_word": "реши́тельно",
                                "target_lang_sense_clarification": "без колебаний"
                            },
                            {
                                "target_lang_word": "уве́ренно",
                                "target_lang_sense_clarification": "с чувством правоты или силы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坚定地",
                                "target_lang_sense_clarification": "指态度不容动摇"
                            },
                            {
                                "target_lang_word": "果断地",
                                "target_lang_sense_clarification": "指毫不犹豫地做出决定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f22b492f-6798-37ad-bb54-df9f0890975f",
                    "sense_definition": "In a way that is established, definitive, and unlikely to change.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "definitively",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>firmly</w> believe that honesty is the best policy in life.",
                            "target_lang_translations": {
                                "ru": "Я <w>твёрдо</w> верю, что честность — лучшая политика в жизни.",
                                "zh": "我<w>深信</w>诚实是人生最好的准则。"
                            }
                        },
                        {
                            "text": "The tradition is now <w>firmly</w> established in our local culture.",
                            "target_lang_translations": {
                                "ru": "Эта традиция теперь <w>прочно</w> укоренилась в нашей местной культуре.",
                                "zh": "这一传统如今已在我们当地文化中<w>牢固地</w>扎下了根。"
                            }
                        }
                    ],
                    "synonyms": [
                        "definitively",
                        "unshakeably",
                        "steadfastly"
                    ],
                    "antonyms": [
                        "tentatively"
                    ],
                    "common_phrases": [
                        "firmly believe",
                        "firmly established",
                        "firmly rooted"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основательно, устойчиво; так, что это вряд ли изменится.",
                        "zh": "以一种已确立、明确且不太可能改变的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "твёрдо",
                                "target_lang_sense_clarification": "об убеждениях или вере"
                            },
                            {
                                "target_lang_word": "про́чно",
                                "target_lang_sense_clarification": "об устоявшихся традициях или правилах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "深信",
                                "target_lang_sense_clarification": "指信念坚定"
                            },
                            {
                                "target_lang_word": "牢固地",
                                "target_lang_sense_clarification": "指传统或习惯根深蒂固"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}