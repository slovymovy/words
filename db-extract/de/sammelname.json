                "senses": [
                    {
                        "sense_id": "d2ce0e9d-555c-3ca3-a9fe-396ff3b0b75b",
                        "entry_id": "7a0ea45e-c9f0-321c-82bb-bf60197a9eaf",
                        "glosses": [
                            "Wort, das Gemeinschaften von zusammengehörigen Dingen oder Einzelwesen bezeichnet"
                        ],
                        "tags": [
                            "in semantischer Sicht"
                        ],
                        "examples": [
                            {
                                "example_id": "5e9f939a-49b4-4d68-9756-31159c072832",
                                "sense_id": "d2ce0e9d-555c-3ca3-a9fe-396ff3b0b75b",
                                "text": "Sammelnamen sind häufig von Grundwörtern durch eine Vorsilbe abgeleitet wie beispielsweise das Wort „Gebirge“ mit der Vorsilbe „ge-“ als eine Kette oder zusammengehörige Menge von Bergen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bdc80f2f-f87a-3c08-b9ab-df29a184aa9f",
                        "entry_id": "7a0ea45e-c9f0-321c-82bb-bf60197a9eaf",
                        "glosses": [
                            "sehr häufig vorkommender Familienname wie „Müller“, „Maier“, „Schulze“"
                        ],
                        "tags": [
                            "behördensprachlich",
                            "in standesamtlicher Sicht"
                        ],
                        "examples": [
                            {
                                "example_id": "d30c0620-fdd6-4b0d-b55a-cac86cb5212e",
                                "sense_id": "bdc80f2f-f87a-3c08-b9ab-df29a184aa9f",
                                "text": "„Sammelnamen können gegen Verwechslung und zur besseren Unterscheidung mit einem Zusatz (Wohnort des Trägers, Geburtsname der Mutter) versehen werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
