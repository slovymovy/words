                                    {
                                        "sense_id": "9623ba79-70fd-3f27-ac17-c95c7f64e143",
                                        "entry_id": "e2f842c5-d35b-3381-9c46-6fc7910a3fe0",
                                        "glosses": [
                                            "kleine, einheimische Erdbeerenart (Fragaria vesca) mit aromatischem Geschmack"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4affb109-630f-4e30-aaee-ab19fed975fb",
                                                "sense_id": "9623ba79-70fd-3f27-ac17-c95c7f64e143",
                                                "text": "Walderdbeeren sind eine Delikatesse, aber mühsam zu pflücken."
                                            },
                                            {
                                                "example_id": "d89b2c6e-e5e5-4a61-a733-5fad48b81a37",
                                                "sense_id": "9623ba79-70fd-3f27-ac17-c95c7f64e143",
                                                "text": "„Es roch nach Heu, die Walderdbeeren waren reif.“"
                                            },
                                            {
                                                "example_id": "4480bec8-18bb-4f8b-ac46-9b7bf259da6f",
                                                "sense_id": "9623ba79-70fd-3f27-ac17-c95c7f64e143",
                                                "text": "„Bald fand ich Himbeeren, Walderdbeeren und auch Pilze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
