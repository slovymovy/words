                    {
                        "sense_id": "68dc399e-16fb-31a6-a494-6b93366e8053",
                        "entry_id": "e01020b5-1bdd-3ade-bb8d-f22c1102fc4d",
                        "glosses": [
                            "błąd poznawczy polegający na dopatrywaniu się znanych kształtów w przypadkowych szczegółach"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [],
