                ],
                "senses": [
                    {
                        "sense_id": "abf29444-b7e2-3804-9744-6e04b68bbf91",
                        "entry_id": "9ec186c7-5ca5-3ae8-a5b9-f23d54195c85",
                        "glosses": [
                            "Bereich von stark ausgebildeter Muskelmasse auf der Innenseite der Handfläche, insbesondere unter dem Daumen an der Handwurzel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be815882-d7c8-4f6f-8fa0-e4eae9f7152c",
                                "sense_id": "abf29444-b7e2-3804-9744-6e04b68bbf91",
                                "text": "„Mit einem einzigen Ruck hatte sie den Sporn los, aber in ihrem Handballen klaffte eine häßliche Rißwunde, aus welcher Blut quoll.“"
                            },
                            {
                                "example_id": "1a58e39b-6516-4219-84be-88573f3247a4",
                                "sense_id": "abf29444-b7e2-3804-9744-6e04b68bbf91",
                                "text": "„Er schlug sich mit dem Handballen gegen die Stirn.“"
                            },
                            {
                                "example_id": "38002c65-ecd6-4d91-bcd8-36f1c8899b90",
                                "sense_id": "abf29444-b7e2-3804-9744-6e04b68bbf91",
                                "text": "„Ich hatte plötzlich am linken Handballen ein wenig Scheiße.“"
                            },
                            {
                                "example_id": "d8e30632-7996-4415-bee1-38d76caebb17",
                                "sense_id": "abf29444-b7e2-3804-9744-6e04b68bbf91",
                                "text": "„Mit den Handballen rieb er sich die brennenden Augen, bis in seinem Kopf die Farben tanzten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
