                ],
                "senses": [
                    {
                        "sense_id": "3791ec6c-448a-326b-85b6-c178b27f0560",
                        "entry_id": "9e732ee5-7ac4-3f8f-9bab-5ead636e84aa",
                        "glosses": [
                            "bovenste helft van het menselijk lichaam (dus boven de heup) of het kledingstuk dat dat gedeelte van het lichaam bedekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29ccc0c7-143c-4482-a526-2c9fba110323",
                                "sense_id": "3791ec6c-448a-326b-85b6-c178b27f0560",
                                "text": "Jaarlijks wordt de gemeente overspoeld door toeristen, wanneer in de laatste week van augustus het tomatengevecht Tomatina plaatsvindt. Ongeveer veertigduizend personen doen Buñol dan aan. In 2007 gooiden duizenden jonge mannen met ontbloot bovenlijf 115.000 kilo rijpe tomaten naar elkaar."
                            },
                            {
                                "example_id": "155ec40a-7fce-440b-bb76-ff73ff52ebd1",
                                "sense_id": "3791ec6c-448a-326b-85b6-c178b27f0560",
                                "text": "Binnen een mum van tijd leek het alsof Jochem Hundertmark enkel met zijn bovenlijf onder een douche had gestaan."
                            },
                            {
                                "example_id": "92015a0e-b4f0-4130-b653-80339df83eee",
                                "sense_id": "3791ec6c-448a-326b-85b6-c178b27f0560",
                                "text": "Hij omhelsde haar liefdevol, drukte hun bovenlijven zacht tegen elkaar en fluisterde lieve woordjes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56639ef9-e1c0-416d-9233-2bd52f23073b",
                        "source_entry_id": "9e732ee5-7ac4-3f8f-9bab-5ead636e84aa",
                        "source_sense_id": "3791ec6c-448a-326b-85b6-c178b27f0560",
                        "target_lang_word": "Oberkörper",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oberkörper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5cd450a8-c65b-3182-a75b-8f1c598eb811",
                                        "entry_id": "ff7cc7f7-fd69-3a35-9bfa-377243e2bf48",
                                        "glosses": [
                                            "der Teil des Körpers (Rumpfes) zwischen Hals und Taille"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9365b7d-6056-4710-baa8-5353184f3712",
                                                "sense_id": "5cd450a8-c65b-3182-a75b-8f1c598eb811",
                                                "text": "Bitte machen Sie den Oberkörper frei."
                                            },
                                            {
                                                "example_id": "e17fe0c4-94ba-4981-b06c-ee3bc7ddb2ab",
                                                "sense_id": "5cd450a8-c65b-3182-a75b-8f1c598eb811",
                                                "text": "„Biagio stand im Vorhof der Scheune mit nacktem Oberkörper vor einer mit Wasser gefüllten, weiß emaillierten Blechschüssel und zeigte uns, wie das ging.“"
                                            },
                                            {
                                                "example_id": "1092d0a1-0c51-4d02-8948-3be916f6d99c",
                                                "sense_id": "5cd450a8-c65b-3182-a75b-8f1c598eb811",
                                                "text": "„Tóvó zählte eins, zwei, drei, und während sie seinen Unterarm festhielt, warf er seinen Oberkörper zurück, und ein deutliches Knackgeräusch bewies, dass der Arm wieder im Gelenk saß.“"
                                            },
                                            {
                                                "example_id": "33f53209-8839-4874-90b0-f53621312e9d",
                                                "sense_id": "5cd450a8-c65b-3182-a75b-8f1c598eb811",
                                                "text": "„Dann stimmen sie einen monotonen Gesang an, bei dem sie Oberkörper mit Hals und Kopf rhythmisch bewegen.“"
                                            },
                                            {
                                                "example_id": "5e87b97a-56b0-4534-8c1b-4a262c0e37d4",
                                                "sense_id": "5cd450a8-c65b-3182-a75b-8f1c598eb811",
                                                "text": "„Wie er da mit bloßem Oberkörper steht, erscheint er mir sehr dünn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "48bdf3f4-81c7-35a1-97ac-d15fb135ef4b",
                                        "entry_id": "ff7cc7f7-fd69-3a35-9bfa-377243e2bf48",
                                        "glosses": [
                                            "Obermenge eines Körpers, die ebenfalls ein Körper ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09da71ca-f6b9-4ac3-8bc1-ad9339805ee5",
                                                "sense_id": "48bdf3f4-81c7-35a1-97ac-d15fb135ef4b",
                                                "text": "Ein Kompositum ist der kleinste gemeinsame Oberkörper zweier Körper."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b1f2559-63d3-4722-8e1a-632257fbc160",
                        "source_entry_id": "9e732ee5-7ac4-3f8f-9bab-5ead636e84aa",
