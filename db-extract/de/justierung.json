                "senses": [
                    {
                        "sense_id": "2ac90eac-f7e7-3283-b903-90ec62cf4a6f",
                        "entry_id": "dbe0039c-7ec7-34c6-be5c-8dc4fc6885d3",
                        "glosses": [
                            "das genaue Einstellen, Einrichten, Ausrichten (eines Gerätes, eines Bauteils oder von etwas Ähnlichem) zum Zwecke des bestimmungsgemäßen Gebrauchs"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "d14b0324-a776-46dd-a164-f8db5f92f3d4",
                                "sense_id": "2ac90eac-f7e7-3283-b903-90ec62cf4a6f",
                                "text": "Die richtige Justierung der Satellitenschüssel zu finden, war ein Krampf."
                            },
                            {
                                "example_id": "8e8bb4e0-13f1-4c00-beb6-55bf5f5f4998",
                                "sense_id": "2ac90eac-f7e7-3283-b903-90ec62cf4a6f",
                                "text": "Frau Schmitz ist in unserem Unternehmen unter anderem mit Justierungen bei den Messgeräten betraut."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
