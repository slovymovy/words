                        "entry_id": "7a2774f3-b458-3f54-8c43-d426bedec170",
                        "glosses": [
                            "Glasscheibe in einem Fahrzeug, die nach hinten gerichtet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f700b8df-632c-4773-abf8-3a7e2da614a2",
                                "sense_id": "90dc55b1-1f94-332d-9b67-ff320e3bd868",
                                "text": "„Durchs Heckfenster vom Käfer zeigte Renate auf den Mond und sagte, das sei der Fingernagel Gottes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
