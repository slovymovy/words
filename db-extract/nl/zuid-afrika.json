                                                "sense_id": "e18e8f2d-f768-3d90-9768-7c1ac86c6128",
                                                "text": "In Südafrika liegen zum Beispiel Swasiland und Lesotho."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
