                "senses": [
                    {
                        "sense_id": "f055fab0-14bf-33ca-bd19-3a4ce074298c",
                        "entry_id": "6b096417-204b-376c-8cc6-dcfede25d6c6",
                        "glosses": [
                            "Körper (zum Beispiel aus Tau, Kork oder Kunststoff) zum Schutz der Bordwand beim Anlegen an eine Kaimauer"
                        ],
                        "tags": [
                            "Seewesen"
                        ],
                        "examples": [
                            {
                                "example_id": "b2c2e213-0e98-4884-a8b7-5b2f9632f1e6",
                                "sense_id": "f055fab0-14bf-33ca-bd19-3a4ce074298c",
                                "text": "Hol mal die Fender rein, wie sieht denn das aus!"
                            },
                            {
                                "example_id": "ea25b794-dff8-4ce0-9950-8b38583921a1",
                                "sense_id": "f055fab0-14bf-33ca-bd19-3a4ce074298c",
                                "text": "Fender sollten immer die passende Größe haben."
                            },
                            {
                                "example_id": "06c409ee-bc28-4949-b2cd-68e3984824f0",
                                "sense_id": "f055fab0-14bf-33ca-bd19-3a4ce074298c",
                                "text": "„Damit sie den Polizisten nicht unversehens in die Presse nehmen und ramponieren, hat er sich geschützt: Holzklötze mit Büffelfell umwickelt, altes Tauwerk und ausgediente Pneumatiks baumeln an seiner Seite, und überdies ist er auswattiert mit Schamfiel und Fender.“"
                            },
                            {
                                "example_id": "52578adc-206c-4a23-a6f9-4fb0f5e13fd7",
                                "sense_id": "f055fab0-14bf-33ca-bd19-3a4ce074298c",
                                "text": "„Der Lange bückte sich, legte seine Hand aufs Dollbord und zog das Boot gegen den Fender.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a337556-ff7c-4200-9baa-c38822686f23",
                        "source_entry_id": "6b096417-204b-376c-8cc6-dcfede25d6c6",
                        "source_sense_id": "f055fab0-14bf-33ca-bd19-3a4ce074298c",
                        "target_lang_word": "fender",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fender",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5de405f-c67a-3f9a-9d37-31c7a39e9412",
                                        "entry_id": "9663b740-8df0-3c5d-a3bb-353c11be2d1d",
                                        "glosses": [
                                            "panel of a car which encloses the wheel area, especially the front wheels."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de55e4e1-c447-3eb6-b39f-516fcf966cf4",
                                        "entry_id": "9663b740-8df0-3c5d-a3bb-353c11be2d1d",
                                        "glosses": [
                                            "a shield, usually of plastic or metal, on a bicycle that protects the rider from mud or water"
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b4715a8-8fb2-326e-ae11-30cc457eb529",
                                        "entry_id": "9663b740-8df0-3c5d-a3bb-353c11be2d1d",
                                        "glosses": [
                                            "any shaped cushion-like object normally made from polymers, rubber or wood that is placed along the sides of a boat to prevent damage when moored alongside another vessel or jetty, or when using a lock, etc. Modern variations are cylindrical although older wooden version and rubbing strips can still be found; old tyres are used as a cheap substitute"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd8afe4e-a515-30de-ac95-5a4b7ced1acc",
                                        "entry_id": "9663b740-8df0-3c5d-a3bb-353c11be2d1d",
                                        "glosses": [
                                            "a low metal framework in front of a fireplace, intended to catch hot coals, soot, and ash"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a57dec2-2113-4b34-8b20-d9696445abc6",
                                                "sense_id": "bd8afe4e-a515-30de-ac95-5a4b7ced1acc",
                                                "text": "Now and then he would make a motion with his feet as if he were running quickly backward upstairs, and would tread on the edge of the fender, so that the fire-irons went flying and the buttered-bun dishes crashed against each other in the hearth."
                                            },
                                            {
                                                "example_id": "1d0564cf-6508-415a-9ead-194a91933ac7",
                                                "sense_id": "bd8afe4e-a515-30de-ac95-5a4b7ced1acc",
                                                "text": "Our solid, shiny chairs, our immense, dingy sofas, our heavy mahogany tables and our cast-iron fenders, often bearing the initials of long-dead railway companies, likewise our plaster walls of chocolate and duck-egg green and our hissing gasoliers have their roots deep in our national history."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fender",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b3e4c78-f451-3d64-962e-290b1e4213d8",
                                        "entry_id": "4fd13876-7848-38af-8769-974904a06755",
                                        "glosses": [
                                            "To use fenders to protect the side of a boat"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca0a8b61-f450-4b8a-8c38-3569e9c380aa",
                        "source_entry_id": "6b096417-204b-376c-8cc6-dcfede25d6c6",
                        "source_sense_id": "f055fab0-14bf-33ca-bd19-3a4ce074298c",
                        "target_lang_word": "pare-battage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pare-battage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed21ecda-c5c0-34a4-8374-8a7c9e7d8d5e",
                                        "entry_id": "b8c004c4-f3c6-3a1e-a019-4c38964d8518",
                                        "glosses": [
                                            "Protection utilisée entre un bateau et un quai ou un autre bateau lors d'un amarrage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba31ebfc-cedd-4b06-8b0c-6f6e67496be7",
                                                "sense_id": "ed21ecda-c5c0-34a4-8374-8a7c9e7d8d5e",
                                                "text": "Des pare-battages, sortes de bouées bourrées de liège servant à amortir les chocs et à protéger la coque, pendaient aux deux côtés du glisseur."
                                            },
                                            {
                                                "example_id": "4ad78e72-a244-49f9-a5ae-bc62adc5858d",
                                                "sense_id": "ed21ecda-c5c0-34a4-8374-8a7c9e7d8d5e",
                                                "text": "Quand la voiture fut chargée au ras du sol, Simone se barda de divers paquets, ressembla aussitôt à un bateau de plaisance ceinturé de pare-battages et donna le signal du départ, un peu mélancolique toutefois d’abandonner l’appartement à un homme qui n’avait guère le sens de l’aspirateur et de l’encaustique."
                                            },
                                            {
                                                "example_id": "a0caf663-4d34-432d-946c-fd947932aa9a",
                                                "sense_id": "ed21ecda-c5c0-34a4-8374-8a7c9e7d8d5e",
                                                "text": "Lorsque le bateau s'approchera du ponton flottant, tu positionnes le pare-battage entre le quai et le bateau pour ne pas qu'il touche."
                                            },
                                            {
                                                "example_id": "5a6ab6e7-24dc-472b-b2a7-b961df72be5f",
                                                "sense_id": "ed21ecda-c5c0-34a4-8374-8a7c9e7d8d5e",
                                                "text": "Tenant la gaffe à bout de bras, elle repoussa maladroitement les pare-battages des bateaux arrimés, mais ne réussit pas à attraper l'anneau de la bouée de mouillage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
