            {
                "entry_id": "5e9ccb4d-3c90-3bc0-b3c2-588c4bc84298",
                "word": "glaire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8594c1a3-1061-43e8-9635-34aac526b104",
                        "entry_id": "5e9ccb4d-3c90-3bc0-b3c2-588c4bc84298",
                        "tags": [
                            "plural"
                        ],
                        "form": "glaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "47a71b03-f5e4-3144-ba87-cf246b35fd72",
                        "entry_id": "5e9ccb4d-3c90-3bc0-b3c2-588c4bc84298",
                        "glosses": [
                            "Blanc d’œuf non cuit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "082ad16e-5327-4667-8dc0-98a3f0556b30",
                                "sense_id": "47a71b03-f5e4-3144-ba87-cf246b35fd72",
                                "text": "Le glaire c'est le nom qu'on donne au blanc d'œuf cru et c'est après qu'on a appelé \"glaire\" tout ce qui sortait de certaines muqueuses, tout ce que l'on peut sécréter."
                            }
                        ]
                    },
                    {
                        "sense_id": "05addf1e-b6d0-35c1-be2a-ae69b869e641",
                        "entry_id": "5e9ccb4d-3c90-3bc0-b3c2-588c4bc84298",
                        "glosses": [
                            "Liquide visqueux, inodore, filant comme du blanc d’œuf, sécrété par les muqueuses dans certaines affections."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d51d4c8-94d7-4ec4-b8b2-ba2f3dddb040",
                                "sense_id": "05addf1e-b6d0-35c1-be2a-ae69b869e641",
                                "text": "Comme chaque fois qu’il criait très fort, sa voix s’étrangla sur une toux grasse, venue du fond de ses bronches malades avec un flot de glaires."
                            },
                            {
                                "example_id": "647c6864-d936-465b-9f57-ee0f8a20ca70",
                                "sense_id": "05addf1e-b6d0-35c1-be2a-ae69b869e641",
                                "text": "Avoir l’estomac plein de glaires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbe355b7-66e1-4742-b472-c95e1f62aca0",
                        "source_entry_id": "5e9ccb4d-3c90-3bc0-b3c2-588c4bc84298",
                        "source_sense_description": "Blanc d’œuf",
                        "target_lang_word": "glair",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2347579-2c01-3184-a00d-b3d89cf944c1",
                                        "entry_id": "134b1b67-bf83-318f-9eca-14f3694c82af",
                                        "glosses": [
                                            "Egg white, especially as used in various industrial preparations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "269ea853-a9ee-459e-aaef-d0f26d9edd38",
                                                "sense_id": "e2347579-2c01-3184-a00d-b3d89cf944c1",
                                                "text": "If you beat an egg white until a froth forms on the surface, the clear liquid below the froth is glair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c2f383b-e915-335d-bf67-ccf1495eaafd",
                                        "entry_id": "134b1b67-bf83-318f-9eca-14f3694c82af",
                                        "glosses": [
                                            "Any viscous, slimy substance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cf7492b-5fff-41fd-9093-9a7e34d95c07",
                                                "sense_id": "8c2f383b-e915-335d-bf67-ccf1495eaafd",
                                                "text": "Some rain fell during the past few days but had little effect on the river which remains very low and full of glair."
                                            },
                                            {
                                                "example_id": "83e91ca9-8a53-42f0-8e24-aa28d1d280f9",
                                                "sense_id": "8c2f383b-e915-335d-bf67-ccf1495eaafd",
                                                "text": "She jacked with authority, knowing how to slick the glair over the glans with her thumb when it began to flow, how to pace a shaftlength voluptuous stroke with a whole slide from meatus to os pubis, how to work with a loving will."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bec7ce46-d19c-3527-a30a-bea7da4d8060",
                                        "entry_id": "134b1b67-bf83-318f-9eca-14f3694c82af",
                                        "glosses": [
                                            "A broadsword fixed on a pike; a kind of halberd."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
