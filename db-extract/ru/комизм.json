                                        "sense_id": "a050d8e3-7361-36f3-bae2-fd6e897241cb",
                                        "entry_id": "f004f58c-692d-3673-a80f-ef097275833a",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent de comiquer."
                                        ],
