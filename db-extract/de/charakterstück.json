                "senses": [
                    {
                        "sense_id": "477af636-7eb3-367b-8618-2f967e0aba97",
                        "entry_id": "77802d77-692a-35aa-8416-1238262f763b",
                        "glosses": [
                            "Komposition (oft für das Klavier), das eine lyrische Stimmung/Empfindung wiedergeben soll; die Stimmung wird manchmal bereits im Titel des Stücks angesprochen (beispielsweise Kinderszenen, Der fröhliche Landmann)"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "a03acb3e-b7d5-476f-863d-3106d269f53d",
                                "sense_id": "477af636-7eb3-367b-8618-2f967e0aba97",
                                "text": "„Es ist relativ kurz, an keine spezifische Form gebunden, oft für Klavier, immer aber rein instrumental, und es hat häufig einen poetischen oder bildhaften Titel - das Charakterstück.“"
                            },
                            {
                                "example_id": "2c9b4f88-1d5d-468e-8ccb-5ef918d52f52",
                                "sense_id": "477af636-7eb3-367b-8618-2f967e0aba97",
                                "text": "„Das lyrische Klavierstück der Romantik, das Charakterstück ist ein Beispiel für einen musikalischen Aphorismus. Es ist eine Art Momentaufnahme von Eindrücken, Stimmungen oder Erscheinungen, auskomponiert in komprimierter Form, ohne Umschweife - eine Musik, die gleichsam sofort auf den Punkt kommt.“"
                            },
                            {
                                "example_id": "1ccdfbbf-f3ff-46ed-8965-a68fc6803a0a",
                                "sense_id": "477af636-7eb3-367b-8618-2f967e0aba97",
                                "text": "„Der Pole Frédéric Chopin lotete in seinen Charakterstücken und Tänzen für Klavier bislang unbekannte Gefühlstiefen aus.“"
                            },
                            {
                                "example_id": "17bae3b1-60cd-413f-9f37-672b87276103",
                                "sense_id": "477af636-7eb3-367b-8618-2f967e0aba97",
                                "text": "„Als Pole hat Chopin“ […] „den heimatlichen Tänzen Polonaise und Mazurka ein Denkmal gesetzt. Als Charakterstücke sind sie wie die Walzer nicht zum Tanzen bestimmt. Bei Chopin sind sie stilisierte Tänze für den konzertanten Vortrag.“"
                            },
                            {
                                "example_id": "a35910d4-5396-4d31-817f-21b0716de137",
                                "sense_id": "477af636-7eb3-367b-8618-2f967e0aba97",
                                "text": "„Jean Philippe Rameaus 1741 entstandene Charakterstücke \"Pièces de clavecin en concerts\" sind 5 Suiten mit konzertantem Cembalo.“"
                            },
                            {
                                "example_id": "a265416a-3343-407f-af11-3d1e28a2f662",
                                "sense_id": "477af636-7eb3-367b-8618-2f967e0aba97",
                                "text": "„26 Charakterstücke hat Franz Liszt in den drei Bänden seiner \"Années de pèlerinage\", der \"Pilgerjahre\" genannten Sammlung, vereint.“"
                            },
                            {
                                "example_id": "a564ec49-6cd9-49ab-8a6b-dc06d6e08eba",
                                "sense_id": "477af636-7eb3-367b-8618-2f967e0aba97",
                                "text": "„Auf zwei CDs hat er Sonaten, Rondos, Fantasien und Charakterstücke von Carl Philipp Emanuel Bach eingespielt.“"
                            },
                            {
                                "example_id": "ee9426ee-96e5-44ac-a70a-043003ddcce2",
                                "sense_id": "477af636-7eb3-367b-8618-2f967e0aba97",
                                "text": "[Ernst von Dohnányi:] „Seine Werke wurden in seiner Zeit gern gespielt. Einige seiner 1905 entstanden Charakterstücke eröffnen den Abend.“"
                            },
                            {
                                "example_id": "df37257b-f6b6-4856-81d3-31b3b7e822ba",
                                "sense_id": "477af636-7eb3-367b-8618-2f967e0aba97",
                                "text": "[Vsevolod Petrowitsch Zaderackij:] „In diesen Jahren komponiert er mehrere symphonische Werke und Klavierzyklen. Zum Beispiel die 24 Präludien. Außerdem viele Charakterstücke mit Ähnlichkeit zur Klaviermusik von Erik Satie, aber doch mit einer individuellen modalen Klangsprache.“"
                            },
                            {
                                "example_id": "fff41b1e-08c5-4fbd-93a8-bef796c2eeba",
                                "sense_id": "477af636-7eb3-367b-8618-2f967e0aba97",
                                "text": "[Artur Rubinstein:] „In der Sendung zu hören ist er allerdings mit „O polichinelo“, einem Charakterstück von Heitor Villa-Lobos, aufgenommen bei einem der zehn Konzerte, die er 1961 in der Carnegie Hall gab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
