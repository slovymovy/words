                                "sense_id": "5d8bcc22-52ed-3493-baab-89fcf48f3817",
                                "text": "Boire immodérément."
                            },
                            {
                                "example_id": "5b86c5c1-cae6-4c9f-9e04-a233540e044c",
                                "sense_id": "5d8bcc22-52ed-3493-baab-89fcf48f3817",
                                "text": "« Vous êtes probablement différent des autres, puisque vous ne m’avez pas une seule fois appelée Liz, un diminutif que j’abhorre immodérément. »"
                            }
                        ]
                    }
