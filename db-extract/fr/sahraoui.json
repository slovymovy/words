                "senses": [
                    {
                        "sense_id": "5cc38058-c67e-385f-a1de-d3bd213c169f",
                        "entry_id": "f4f2e029-410e-3984-b3d6-fa2de052cc53",
                        "glosses": [
                            "Relatif au Sahara occidental."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc76e54e-193c-4b9f-bf83-db7430fcb92c",
                                "sense_id": "5cc38058-c67e-385f-a1de-d3bd213c169f",
                                "text": "Ancienne colonie espagnole, le Sahara occidental a été annexé en 1975 par le Maroc et de nombreux coopérants espagnols travaillent dans les camps sahraouis."
                            },
                            {
                                "example_id": "e86d749d-2511-4b06-8446-0d3259dd359f",
                                "sense_id": "5cc38058-c67e-385f-a1de-d3bd213c169f",
                                "text": "Le Front Polisario rejette le plan marocain et réaffirme « le droit du peuple sahraoui à l’autodétermination » via un référendum."
                            },
                            {
                                "example_id": "e7cfd360-f41e-4d0f-9f12-109b80a03f16",
                                "sense_id": "5cc38058-c67e-385f-a1de-d3bd213c169f",
                                "text": "Le secrétaire général du Front Polisario et président de la République arabe sahraouie démocratique (RASD, non reconnue par l’ONU, mais par l’Union africaine) Mohamed Abdelaziz, a appelé l’ONU à «intervenir d’urgence pour mettre fin à la politique d’épuration ethnique que mène le gouvernement marocain»."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
