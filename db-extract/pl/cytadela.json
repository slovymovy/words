                "senses": [
                    {
                        "sense_id": "cabc49da-674f-3691-9b5e-7a9131b3b315",
                        "entry_id": "7944ea6e-0356-3ec1-9b11-ccd5c61a8cc4",
                        "glosses": [
                            "w starszych fortyfikacjach: samodzielna twierdza dominująca nad miastem lub prowincją"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e178d3a-ae88-4e3c-bf5e-74e3c6c1bc46",
                                "sense_id": "cabc49da-674f-3691-9b5e-7a9131b3b315",
                                "text": "Żołnierze perscy schronili się w dwóch nadmorskich cytadelach, zaopatrywanych drogą morską."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d704f339-6dfe-484c-b82a-a110d003d145",
                        "source_entry_id": "7944ea6e-0356-3ec1-9b11-ccd5c61a8cc4",
                        "source_sense_id": "cabc49da-674f-3691-9b5e-7a9131b3b315",
                        "target_lang_word": "citadel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "citadel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5167fa15-8b55-3174-946e-88270552210b",
                                        "entry_id": "7ca5354f-b46c-397f-ba07-582e277e792e",
                                        "glosses": [
                                            "A strong fortress that sits high above a city."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8756243c-00dc-47dd-a8b1-988153eba1a3",
                                                "sense_id": "5167fa15-8b55-3174-946e-88270552210b",
                                                "text": "In the city’s midst the gleaming marble of a thousand steps climbed to the citadel where arose four pinnacles beckoning to heaven, and midmost between the pinnacles there stood the dome, vast, as the gods had dreamed it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54d981e2-6cf3-301b-85bc-7ab97bc45bf2",
                                        "entry_id": "7ca5354f-b46c-397f-ba07-582e277e792e",
                                        "glosses": [
                                            "A stronghold or fortified place."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19249f5d-b11c-4e99-80cd-95395ccd0915",
                                                "sense_id": "54d981e2-6cf3-301b-85bc-7ab97bc45bf2",
                                                "text": "Intrenched within the citadel of our apartment, and cheered by the comfortings of a coal fire, we passed the day in letter-writing, conversation, or gazing from the sheltered security of our windows upon the agitated sea[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2cc60f9-75c8-3845-9f4c-77467712ddf3",
                                        "entry_id": "7ca5354f-b46c-397f-ba07-582e277e792e",
                                        "glosses": [
                                            "An armoured portion of a warship, housing important equipment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a9c5406-188c-4394-b75b-bdfdb4fad6eb",
                                                "sense_id": "f2cc60f9-75c8-3845-9f4c-77467712ddf3",
                                                "text": "Twenty-two of these — eleven per broadside — were on the main deck within a central citadel, essentially an armor-protected box in the middle of the ship. Also within the citadel were four 110-pdr. breech-loaders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a420dfa9-0487-3487-b1a7-ff1100bd54d0",
                                        "entry_id": "7ca5354f-b46c-397f-ba07-582e277e792e",
                                        "glosses": [
                                            "A Salvation Army meeting place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a40e0968-945c-4aca-8760-35971424b863",
                        "source_entry_id": "7944ea6e-0356-3ec1-9b11-ccd5c61a8cc4",
                        "source_sense_id": "cabc49da-674f-3691-9b5e-7a9131b3b315",
                        "target_lang_word": "ciudadela",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ciudadela",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "292ba73d-f4b3-3371-9465-a02b00aa50ae",
                                        "entry_id": "f3b69972-baf4-324a-90b0-f90f95caf825",
                                        "glosses": [
                                            "Recinto fortificado de manera permanente construido para defender o vigilar a una ciudad, o como último refugio para su guarnición."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60e4a17c-ffdc-4151-91ba-cd98b68f4983",
                        "source_entry_id": "7944ea6e-0356-3ec1-9b11-ccd5c61a8cc4",
                        "source_sense_id": "cabc49da-674f-3691-9b5e-7a9131b3b315",
                        "target_lang_word": "Zitadelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zitadelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "179f20a9-a2e4-3ff6-b25e-4e1295b4d514",
                                        "entry_id": "22441565-764c-375e-a490-7e9451a5f9e3",
                                        "glosses": [
                                            "der innere, am stärksten ausgebaute Teil einer Festung oder eine Festung innerhalb einer befestigten Stadt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a5a5ce1-503c-4529-97df-07288800e8f8",
                                                "sense_id": "179f20a9-a2e4-3ff6-b25e-4e1295b4d514",
                                                "text": "In der Zitadelle von Roses ist ein großes historisches Museum untergebracht."
                                            },
                                            {
                                                "example_id": "1542b168-779d-45c6-a8bf-a942f8928511",
                                                "sense_id": "179f20a9-a2e4-3ff6-b25e-4e1295b4d514",
                                                "text": "„Und ohne ein Wort weiter zu sprechen, begann er den Berg emporzusteigen, der sich im Kern der Stadt erhebt und der seit Jahrhunderten eine verwitterte Zitadelle auf seinem Rücken trägt.“"
                                            },
                                            {
                                                "example_id": "5fd5eb85-fa7b-4508-a850-207c9f62306a",
                                                "sense_id": "179f20a9-a2e4-3ff6-b25e-4e1295b4d514",
                                                "text": "„Ohne das notwendige Koffein radelte ich über die Elisabethbrücke und ließ mich am Fuße des Gellértbergs unterhalb der Zitadelle nieder.“"
                                            },
                                            {
                                                "example_id": "9e6deffe-0be2-407b-a5ed-44cbddf07e61",
                                                "sense_id": "179f20a9-a2e4-3ff6-b25e-4e1295b4d514",
                                                "text": "„Am Fuße der Zitadelle verputzen drei Männer in blauen Anzügen eine Lehmmauer.“"
                                            },
                                            {
                                                "example_id": "c17ba88d-a0c6-42e2-983e-1ecf03c6a6f2",
                                                "sense_id": "179f20a9-a2e4-3ff6-b25e-4e1295b4d514",
                                                "text": "„Wir gingen in einer schönen Allee bei der Zitadelle spazieren; dort sah ich eine Menge hübscher Mädchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80934cc3-dd57-432b-be75-6bc003af5da0",
                        "source_entry_id": "7944ea6e-0356-3ec1-9b11-ccd5c61a8cc4",
                        "source_sense_id": "cabc49da-674f-3691-9b5e-7a9131b3b315",
                        "target_lang_word": "цитадель",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "цитадель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dd10ab20-3090-36e4-a117-3102978a7486",
                                        "entry_id": "d653c69d-def6-394d-b4a5-abf96692e855",
                                        "glosses": [
                                            "воен., архит. центральное, наиболее фортифицированное укрепление в крепости или городе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5788f4b5-555d-44cf-9e32-3b5c60401939",
                                                "sense_id": "dd10ab20-3090-36e4-a117-3102978a7486",
                                                "text": "Между цитаделью и городскими строениями находилось открытое незастроенное пространство, которое называлось эспланадой."
                                            },
                                            {
                                                "example_id": "e41efd99-b6a3-4855-8188-5e502cf1a468",
                                                "sense_id": "dd10ab20-3090-36e4-a117-3102978a7486",
                                                "text": "С высоты горы в лощине открывался взору Арзрум со своею цитаделью, с минаретами, с зелёными кровлями, наклеенными одна на другую."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8715d784-4a7c-31d4-b2ea-083c9ccf5a4b",
                                        "entry_id": "d653c69d-def6-394d-b4a5-abf96692e855",
                                        "glosses": [
                                            "перен. оплот, средоточие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23c568c5-04d2-4287-9d15-256e129d7810",
                                                "sense_id": "8715d784-4a7c-31d4-b2ea-083c9ccf5a4b",
                                                "text": "Ведь именно Малый театр, эта цитадель актёрского искусства, весь XX век простоявшая в стороне от режиссёрских исканий, казалась режиссёрам самым крепким орешком."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
