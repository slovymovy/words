                                    {
                                        "sense_id": "fcbb3739-e207-3cc4-9564-dd7a25eefb8d",
                                        "entry_id": "ae1e0de7-d448-3ae6-a976-d691e96dc7b2",
                                        "glosses": [
                                            "Synonyme de grande aunée (espèce de plantes)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6f70ec4-d42d-4b13-863e-c0372ba5ea5b",
                                                "sense_id": "fcbb3739-e207-3cc4-9564-dd7a25eefb8d",
                                                "text": "L'aunée, ou aunée officinale, a une réelle action sur les bronches et permet de lutter contre la toux ou contre d'autres inflammations de l'appareil respiratoire."
                                            },
                                            {
                                                "example_id": "5395cd81-e4c5-4ade-b384-d50a43e9655c",
                                                "sense_id": "fcbb3739-e207-3cc4-9564-dd7a25eefb8d",
                                                "text": "L’Aunée officinale est une plante vivace mesurant de un à deux mètres et dont le nom vient d'hélenion, mot grec tiré d'Elené."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "685a840f-2034-4a46-bc64-d766a2c7b18f",
                        "source_entry_id": "b5f3b7bf-ed27-32fe-a509-6ab62c65b260",
                        "source_sense_id": "d943a525-c505-3b93-b617-a0210e0c9793",
                        "source_sense_description": "Inula helenium",
                        "target_lang_word": "grande aunée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grande aunée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b639bd3-2893-39d8-8d03-6a37f47f37ad",
                                        "entry_id": "6b4c2f6f-b94a-3884-8c6e-272e7c81f18d",
                                        "glosses": [
                                            "Plante vivace de grande taille, aux feuilles alternes, aux capitules de fleurs jaunes, dont la racine est utilisée à des fins aromatiques ou médicinales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05bdc8bc-0084-4388-826d-3c2fe13aa135",
                                                "sense_id": "4b639bd3-2893-39d8-8d03-6a37f47f37ad",
                                                "text": "La plus usitée reste la grande aunée. Son nom botanique, \"Inula\" signifie « je purge ». La liste des propriétés médicinales de cette plante assez commune est impressionnante."
                                            },
                                            {
                                                "example_id": "d25e45b6-8e8c-44c7-bffb-a3881727ecad",
                                                "sense_id": "4b639bd3-2893-39d8-8d03-6a37f47f37ad",
                                                "text": "Si la grande aunée (Inula helenium) se plaît dans votre jardin, il est fort possible que vous n’ayez pas à vous baisser pour admirer ses magnifiques fleurs jaunes. En effet, cette vivace peut atteindre des proportions assez gigantesques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bedc338-46c2-4264-a773-58e69becade4",
                        "source_entry_id": "b5f3b7bf-ed27-32fe-a509-6ab62c65b260",
