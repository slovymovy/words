{
    "word_family": [
        "peaky",
        "peaked"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0aab4362-fe30-31ea-90d9-0d8f18de4342",
                    "sense_definition": "The pointed top of a mountain, hill, or ridge.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_top",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could see the snowy <w>peaks</w> from our hotel window.",
                            "target_lang_translations": {
                                "ru": "Из окна нашего отеля мы видели заснеженные <w>вершины</w>.",
                                "fr": "Nous pouvions voir les <w>pics</w> enneigés depuis la fenêtre de notre hôtel.",
                                "zh": "从酒店窗户可以看到白雪皑皑的<w>山峰</w>。"
                            }
                        },
                        {
                            "text": "It took them three days to climb to the <w>peak</w> of the mountain.",
                            "target_lang_translations": {
                                "ru": "Им потребовалось три дня, чтобы подняться на <w>вершину</w> горы.",
                                "fr": "Il leur a fallu trois jours pour grimper jusqu'au <w>sommet</w> de la montagne.",
                                "zh": "他们花了三天时间才爬到<w>峰顶</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "summit",
                        "top",
                        "pinnacle",
                        "apex"
                    ],
                    "antonyms": [
                        "base",
                        "bottom",
                        "foot"
                    ],
                    "common_phrases": [
                        "mountain peak",
                        "snowy peak",
                        "highest peak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остроконечная вершина горы, холма или хребта.",
                        "fr": "La partie la plus élevée et pointue d'une montagne, d'une colline ou d'une crête.",
                        "zh": "山峰、山丘或山脊的尖顶。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вершина",
                                "target_lang_sense_clarification": "самая верхняя часть горы"
                            },
                            {
                                "target_lang_word": "пик",
                                "target_lang_sense_clarification": "остроконечная вершина"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "pic",
                                "target_lang_sense_clarification": "sommet pointu d'une montagne"
                            },
                            {
                                "target_lang_word": "sommet",
                                "target_lang_sense_clarification": "partie la plus élevée d'une montagne"
                            },
                            {
                                "target_lang_word": "cime",
                                "target_lang_sense_clarification": "partie la plus haute d'une montagne"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "山峰",
                                "target_lang_sense_clarification": "山的高处"
                            },
                            {
                                "target_lang_word": "峰顶",
                                "target_lang_sense_clarification": "山的最顶端"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61406788-240d-3a26-8c21-b78eb9069f8e",
                    "sense_definition": "The point when something is at its highest level, value, strength, or success.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abstract_maximum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete retired when he was at the <w>peak</w> of his career.",
                            "target_lang_translations": {
                                "ru": "Спортсмен ушёл из спорта, когда был на <w>пике</w> своей карьеры.",
                                "fr": "L'athlète a pris sa retraite alors qu'il était au <w>sommet</w> de sa carrière.",
                                "zh": "这位运动员在事业<w>巅峰</w>时期选择了退役。"
                            }
                        },
                        {
                            "text": "Traffic usually reaches a <w>peak</w> around five in the evening.",
                            "target_lang_translations": {
                                "ru": "Движение обычно достигает <w>пика</w> около пяти вечера.",
                                "fr": "La circulation atteint généralement un <w>pic</w> vers dix-sept heures.",
                                "zh": "交通通常在傍晚五点左右达到<w>高峰</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "maximum",
                        "high point",
                        "zenith",
                        "acme",
                        "height",
                        "top",
                        "pinnacle"
                    ],
                    "antonyms": [
                        "low",
                        "trough",
                        "minimum",
                        "nadir"
                    ],
                    "common_phrases": [
                        "at the peak",
                        "reach a peak",
                        "past its peak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Момент, когда что-либо находится на высшем уровне, имеет наибольшую ценность, силу или успех.",
                        "fr": "Le moment ou le point où quelque chose atteint son niveau, sa valeur, sa force ou son succès le plus élevé.",
                        "zh": "某事物达到最高水平、价值、强度或成功的时刻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пик",
                                "target_lang_sense_clarification": "высшая точка развития"
                            },
                            {
                                "target_lang_word": "максимум",
                                "target_lang_sense_clarification": "наибольшее значение"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "pic",
                                "target_lang_sense_clarification": "moment le plus haut d'une évolution"
                            },
                            {
                                "target_lang_word": "sommet",
                                "target_lang_sense_clarification": "degré le plus haut"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巅峰",
                                "target_lang_sense_clarification": "最高点或鼎盛时期"
                            },
                            {
                                "target_lang_word": "高峰",
                                "target_lang_sense_clarification": "最高水平或程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e762779-0c66-3a28-82a4-006c30131eab",
                    "sense_definition": "The sharp or pointed end of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_top",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should beat the cream until it forms stiff <w>peaks</w>.",
                            "target_lang_translations": {
                                "ru": "Вам следует взбивать сливки до образования устойчивых <w>пиков</w>.",
                                "fr": "Vous devez battre la crème jusqu'à ce qu'elle forme des <w>pointes</w> fermes.",
                                "zh": "你应该把奶油打发到出现坚挺的<w>尖端</w>。"
                            }
                        },
                        {
                            "text": "The roof of the old house rises to a sharp <w>peak</w>.",
                            "target_lang_translations": {
                                "ru": "Крыша старого дома сходится в острый <w>пик</w>.",
                                "fr": "Le toit de la vieille maison s'élève en une <w>pointe</w> acérée.",
                                "zh": "老房子的屋顶向上汇聚成一个锐利的<w>尖端</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "point",
                        "tip"
                    ],
                    "common_phrases": [
                        "stiff peaks",
                        "widow's peak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Острый или заострённый конец чего-либо.",
                        "fr": "L'extrémité pointue ou acérée de quelque chose.",
                        "zh": "某物的尖端或锐利末端。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остриё",
                                "target_lang_sense_clarification": "острый конец"
                            },
                            {
                                "target_lang_word": "кончик",
                                "target_lang_sense_clarification": "крайняя часть чего-либо"
                            }
                        ],
                        "fr": [
