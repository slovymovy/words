                            {
                                "example_id": "f5cecbf2-134a-40c7-9706-5bfe6f98810e",
                                "sense_id": "3b2f1cc0-a388-356b-b7f9-b1d2a05bcb8f",
                                "text": "Nous allâmes après le dîner voir la verrerie à Murano. Elle acheta beaucoup de petites breloques, qu’elle nous laissa payer sans façon ; mais elle donna partout des tringueltes beaucoup plus forts que tout ce que nous avions dépensé."
                            },
                            {
                                "example_id": "0f616836-96d4-41a4-b802-a3e0c0a5ec6a",
                                "sense_id": "3b2f1cc0-a388-356b-b7f9-b1d2a05bcb8f",
                                "text": "Alors, j’ai fait comme tout le monte^([sic])... J’ai mis un sou de tringuelte dans leur quête..."
                            }
                        ]
                    }
