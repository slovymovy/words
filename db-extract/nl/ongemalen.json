                "pos": "adj",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "a220274a-3d25-4fe3-b320-1d045a0fd7aa",
                        "entry_id": "0772750c-8bca-36dc-a6cd-1c1dc60150ce",
