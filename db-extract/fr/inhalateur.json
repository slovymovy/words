                "senses": [
                    {
                        "sense_id": "51b7663a-d797-3c96-8828-19ee4f4e37af",
                        "entry_id": "8c7b3cec-f348-39ae-9613-a4a448f5caeb",
                        "glosses": [
                            "Appareil généralement portatif qui sert à inhaler des substances médicamenteuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea9717ad-8d84-4fbe-99a3-8c249630ce8d",
                                "sense_id": "51b7663a-d797-3c96-8828-19ee4f4e37af",
                                "text": "Plusieurs malades, assis, la tête encapuchonnée de serviettes, étaient penchés sur les inhalateurs. Une vapeur qui sentait le menthol et l'eucalyptus emplissait la petite salle chaude et silencieuse, où l’on se voyait à peine."
                            },
                            {
                                "example_id": "26e71b2c-a450-4d3e-9748-d19082ad5000",
                                "sense_id": "51b7663a-d797-3c96-8828-19ee4f4e37af",
                                "text": "Autrefois, on avait un inhalateur en plastique dont les deux parties se déboîtaient toujours et qui laissait des cernes sous les yeux. En éloignant un peu son livre, on pouvait même lire."
                            },
                            {
                                "example_id": "6a3f4d14-b1b3-478e-a28a-91c4ea1fbb0d",
                                "sense_id": "51b7663a-d797-3c96-8828-19ee4f4e37af",
                                "text": "Si vous devez renouveler les inhalations, procurez-vous un inhalateur en pharmacie."
                            }
                        ]
                    }
                ],
