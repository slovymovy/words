                    "frequency": "High",
                    "semantic_group_id": "gaule_antique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les archéologues ont découvert les vestiges d'un ancien village <w>gaulois</w> près de la rivière."
