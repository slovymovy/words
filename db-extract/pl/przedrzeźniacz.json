                        "entry_id": "74663561-800c-3ea6-87ac-7dcadc0e46b9",
                        "glosses": [
                            "Mimidae, północnoamerykański ptak z rzędu wróblowatych potrafiący naśladować usłyszane dźwięki"
                        ],
                        "tags": [],
