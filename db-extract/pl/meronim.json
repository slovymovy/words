                                "target_senses": [
                                    {
                                        "sense_id": "c936e36b-5bd2-3a4f-956c-df7856b47cb4",
                                        "entry_id": "cc700659-3e0d-3558-b917-e881a7794dce",
                                        "glosses": [
                                            "лингв. понятие, в отношении к другому понятию выражающее составную часть последнего"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c73f5620-8780-4943-b66c-4aad99e4a5b9",
                                                "sense_id": "c936e36b-5bd2-3a4f-956c-df7856b47cb4",
                                                "text": "Древнегреческое понятие холоним означает целое, вмещающее в себя иные вещи – части целого. В свою очередь, части целого по отношению к целому называются меронимом (или партонимом)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
