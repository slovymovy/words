{
    "word_family": [
        "beroering",
        "onberoerd",
        "roeren"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "626b39e5-b715-3c0b-a423-eae716fa8e8e",
                    "sense_definition": "iets of iemand fysiek met de hand of een voorwerp aanraken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de beschutting van het struikgewas betraden zij voor het eerst het pad van de liefde en <w>beroerden</w> elkaars lippen.",
                            "target_lang_translations": {
                                "en": "In the shelter of the bushes, they entered the path of love for the first time and <w>touched</w> each other's lips."
                            }
                        },
                        {
                            "text": "Zij durfde de toetsen van de piano nauwelijks te <w>beroeren</w> uit angst een fout te maken.",
                            "target_lang_translations": {
                                "en": "She hardly dared to <w>touch</w> the piano keys for fear of making a mistake."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanraken"
                    ],
                    "common_phrases": [
                        "de toetsen beroeren",
                        "de snaren beroeren"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in een literaire of plechtige context gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to physically touch something or someone with the hand or an object, often in a light or delicate manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "touch",
                                "target_lang_sense_clarification": "to make physical contact with"
                            },
                            {
                                "target_lang_word": "touch lightly",
                                "target_lang_sense_clarification": "to make gentle or delicate contact with"
                            },
                            {
                                "target_lang_word": "brush",
                                "target_lang_sense_clarification": "to touch lightly in passing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5146112e-4416-3d59-b491-e15519a22f28",
                    "sense_definition": "emotionele onrust veroorzaken of iemand diep raken in het gemoed",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De komst van de grote groep motorrijders <w>beroerde</w> de gemoederen in het kleine dorpje.",
                            "target_lang_translations": {
                                "en": "The arrival of the large group of motorcyclists <w>stirred</w> the emotions in the small village."
                            }
                        },
                        {
                            "text": "Zijn woorden over het verleden wisten de harten van het publiek diep te <w>beroeren</w>.",
                            "target_lang_translations": {
                                "en": "His words about the past managed to deeply <w>touch</w> the hearts of the audience."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de gemoederen beroeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause emotional unrest or to affect someone deeply; to stir the emotions"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "touch",
                                "target_lang_sense_clarification": "to affect emotionally or bring about tender feelings"
                            },
                            {
                                "target_lang_word": "stir",
                                "target_lang_sense_clarification": "to cause strong feelings or emotional unrest"
                            },
                            {
                                "target_lang_word": "move",
                                "target_lang_sense_clarification": "to affect someone's feelings deeply"
                            },
                            {
                                "target_lang_word": "affect",
                                "target_lang_sense_clarification": "to produce an emotional response"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}