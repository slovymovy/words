                        "glosses": [
                            "begroeid met bomen; beplant met bomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c6a13a1-4c04-43a1-a7f4-3f40eb51f55b",
                                "sense_id": "608385fc-4716-3247-85e8-c4bea9587090",
                                "text": "Een columnist die iets probeert te voorspellen over de Vuelta is vergelijkbaar met een Amerikaans kind dat geblinddoekt en met een stok in de hand in een bos wordt neergezet met de mededeling dat er ergens op die paar druk beboomde hectaren een beuk staat met een pinata eraan: het kan zijn dat je raak mept, maar met verstand van zaken heeft dat niets te maken."
                            },
                            {
                                "example_id": "a10e46a5-0a0f-4c67-8bc4-559bdaded955",
                                "sense_id": "608385fc-4716-3247-85e8-c4bea9587090",
                                "text": "Tussen Santa Lucia en Fonte Nuova moeten ze een stukje door een beboomd gebied. Het is er donkerder dan op de rest van de route."
                            }
                        ]
                    }
