        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bf71102d-8f73-39d5-80fc-4ed6b1414458",
                    "sense_definition": "iemand een teken geven met de hand of het hoofd om naderbij te komen of iets te doen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gebaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ober zag ons eindelijk en <w>wenkte</w> dat we aan de vrije tafel mochten gaan zitten.",
                            "target_lang_translations": {
                                "en": "The waiter finally saw us and <w>motioned</w> that we could sit at the empty table."
                            }
                        },
                        {
                            "text": "Hij <w>wenkte</w> haar om naderbij te komen zodat hij een geheim kon vertellen.",
                            "target_lang_translations": {
                                "en": "He <w>beckoned</w> her to come closer so he could tell a secret."
                            }
                        }
                    ],
                    "synonyms": [
                        "tekenen",
                        "wenken geven",
                        "lonken"
                    ],
                    "common_phrases": [
                        "iemand naderbij wenken",
                        "iemand binnen wenken"
                    ],
                    "target_lang_definitions": {
                        "en": "To signal someone with a hand or head gesture to come closer or to do something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beckon",
                                "target_lang_sense_clarification": "to signal someone to approach"
                            },
                            {
                                "target_lang_word": "motion",
                                "target_lang_sense_clarification": "to direct someone with a gesture"
                            },
                            {
                                "target_lang_word": "wave over",
                                "target_lang_sense_clarification": "to signal someone to come towards you"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99a9123f-8e70-369d-be30-f15384e780b3",
                    "sense_definition": "door middel van subtiele lichaamsbewegingen of gebaren een waarschuwing of hint geven",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "waarschuwing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen de leraar de klas inkeek, <w>wenkte</w> mijn vriend me snel om te stoppen met praten.",
                            "target_lang_translations": {
                                "en": "When the teacher looked into the classroom, my friend quickly <w>gestured</w> for me to stop talking."
                            }
                        },
                        {
                            "text": "Zij <w>wenkte</w> onopvallend naar de deur om aan te geven dat het tijd was om te vertrekken.",
                            "target_lang_translations": {
                                "en": "She <w>signaled</w> inconspicuously toward the door to indicate it was time to leave."
                            }
                        }
                    ],
                    "synonyms": [
                        "waarschuwen",
                        "seinen"
                    ],
                    "common_phrases": [
                        "onopvallend wenken"
                    ],
                    "target_lang_definitions": {
                        "en": "To give a warning or hint through subtle body movements or gestures."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "signal",
                                "target_lang_sense_clarification": "to convey information via a gesture"
                            },
                            {
                                "target_lang_word": "gesture",
                                "target_lang_sense_clarification": "to use a movement to express a hint"
                            },
                            {
                                "target_lang_word": "motion",
                                "target_lang_sense_clarification": "to suggest an action subtly"
                            }
                        ]
                    }
                }
            ]
        },
        {
