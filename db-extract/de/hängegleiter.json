                ],
                "senses": [
                    {
                        "sense_id": "21d81175-6366-379e-b5ab-870d814119eb",
                        "entry_id": "6ac80cb1-ba1a-3203-a43e-66d2b5107615",
                        "glosses": [
                            "zusammenklappbares motorloses Luftsportgerät aus einem stabilen Hauptgestell mit Aluminiumrohren und segelbespannter Tragfläche, das mittels Gewichtsverlagerung über ein Trapez gesteuert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06561de6-cac1-4f5c-a2ff-5cb89596a9e0",
                                "sense_id": "21d81175-6366-379e-b5ab-870d814119eb",
                                "text": "„Obwohl Otto Lilienthal sein Fluggerät bereits Flugzeug nannte, war es in heutiger Nomenklatur ein Hängegleiter, ein durch Gewichtsverlagerung des Piloten gesteuertes Fluggerät."
                            },
                            {
                                "example_id": "f9b7fec3-9d75-48ad-ab5e-eda281ef00bd",
                                "sense_id": "21d81175-6366-379e-b5ab-870d814119eb",
                                "text": "„Der Hängegleiter wird auch als Drachen, das Gleitsegel auch als Gleitschirm oder Paragleiter bezeichnet.“"
                            },
                            {
                                "example_id": "0b5d81b0-6b02-4bfa-9e1c-7a142eaaca3d",
                                "sense_id": "21d81175-6366-379e-b5ab-870d814119eb",
                                "text": "„Der Hängegleiter, so die amtliche Bezeichnung, ist zu einem ausgereiften Luftfahrtgerät und selbst wieder zum Ausgangspunkt einer neuen Sparte der Luftfahrt geworden.“"
                            },
                            {
                                "example_id": "33dccd02-9423-4806-8424-275cac1329b0",
                                "sense_id": "21d81175-6366-379e-b5ab-870d814119eb",
                                "text": "„An diesem Tag flog der Kalifornier Mike Harker, der als Soldat in Deutschland stationiert war, mit einem Hängegleiter von der Zugspitze.“"
                            },
                            {
                                "example_id": "e971ee75-4869-47fa-b835-7bda01c84012",
                                "sense_id": "21d81175-6366-379e-b5ab-870d814119eb",
                                "text": "„Die besten Hängegleiter erzielen heute Flugleistungen, die an die früher Segelflugzeuge anknüpfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d7ceb9b-7cef-40e3-9c1f-a1484d7abf81",
