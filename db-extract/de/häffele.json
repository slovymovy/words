                ],
                "senses": [
                    {
                        "sense_id": "486f7c1f-369a-3c26-bbad-2ed0cfbbe806",
                        "entry_id": "e8abcd86-28da-3215-a716-c1693954fd83",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ece1b4b0-4dab-42fe-a94b-b5791a544b42",
                                "sense_id": "486f7c1f-369a-3c26-bbad-2ed0cfbbe806",
                                "text": "Die Häffeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a67aa9d0-dc59-43c6-8187-e0f1abaab566",
                                "sense_id": "486f7c1f-369a-3c26-bbad-2ed0cfbbe806",
                                "text": "Herr Häffele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "100cc343-43f7-4ff4-9937-01dcb28f1b2f",
                                "sense_id": "486f7c1f-369a-3c26-bbad-2ed0cfbbe806",
                                "text": "Frau Häffele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1f639761-b7cd-4234-bbfd-b84f841939bd",
                                "sense_id": "486f7c1f-369a-3c26-bbad-2ed0cfbbe806",
                                "text": "Der Häffele trägt nie die Schals, die die Häffele ihm strickt."
                            },
                            {
                                "example_id": "300937c1-173c-4297-b0f5-12563b0a2dff",
                                "sense_id": "486f7c1f-369a-3c26-bbad-2ed0cfbbe806",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Häffele kommt, geht der Herr Häffele.“"
                            },
                            {
                                "example_id": "8ad95eb0-c091-45e0-b0a5-f414ecce1a97",
                                "sense_id": "486f7c1f-369a-3c26-bbad-2ed0cfbbe806",
                                "text": "Häffele kommt und geht."
                            },
                            {
                                "example_id": "ebcadf00-4dcc-4f6c-83bf-ce582ce0200f",
                                "sense_id": "486f7c1f-369a-3c26-bbad-2ed0cfbbe806",
                                "text": "Häffeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
