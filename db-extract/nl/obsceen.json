                        "sense_id": "190d21c6-25f4-370e-8523-77a6560013ad",
                        "entry_id": "ba935c3a-6a30-323b-9648-0778fb36ef0b",
                        "glosses": [
                            "het gevoel van eerbaarheid geweld aandoend, onzedelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcc1561a-8a96-43f4-9cdb-816c00c5302c",
                                "sense_id": "190d21c6-25f4-370e-8523-77a6560013ad",
                                "text": "De dronken man begon obscene taal uit te slaan."
                            },
                            {
                                "example_id": "ab2db438-b346-4578-a1c3-6ed8b5d1c873",
                                "sense_id": "190d21c6-25f4-370e-8523-77a6560013ad",
                                "text": "De uitbetaling van hogere, obscene bonussen, die zich al sinds het herstel van de beurzen in het voorjaar van 2009 aankondigde, is een van de redenen waarom president Obama de grote banken zwaarder wil belasten"
                            }
                        ]
                    }
                ],
