                    "sense_id": "b9ce3659-1bad-3c50-b8e7-59d82e79c9c9",
                    "sense_definition": "urzędowe pismo lub karta potwierdzająca tożsamość lub uprawnienia danej osoby",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pismo_oficjalne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas kontroli na lotnisku policjant poprosił o moje <w>dokumenty</w>.",
