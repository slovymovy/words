                "senses": [
                    {
                        "sense_id": "abc3eaff-653e-3b0c-9234-691479cef205",
                        "entry_id": "dfeee77e-e74c-3af2-b7be-8f9ea10c142f",
                        "glosses": [
                            "Bezeichnung für Frageadverbien und -pronomen, die mit dem Buchstaben (Laut [v]) beginnen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ba5515f-1737-402c-af7d-112403a28ab0",
                                "sense_id": "abc3eaff-653e-3b0c-9234-691479cef205",
                                "text": "Der Satz: \"Wer kommt heute zu Besuch?\" enthält mit \"wer\" ein Fragepronomen als W-Wort."
                            },
                            {
                                "example_id": "feb1e73a-aa1c-473d-a7a1-42732bc96a34",
                                "sense_id": "abc3eaff-653e-3b0c-9234-691479cef205",
                                "text": "Der Satz: \"Wann kommt Peter zu Besuch?\" enthält mit \"wann\" ein Frageadverb als W-Wort."
                            },
                            {
                                "example_id": "46c0099f-13a7-42a9-8dfe-cb5bcbbe47ba",
                                "sense_id": "abc3eaff-653e-3b0c-9234-691479cef205",
                                "text": "W-Wort ist ein gängiger Ausdruck in der Linguistik, der auch in Fachwörterbüchern verzeichnet ist."
                            },
                            {
                                "example_id": "8bb018fa-619e-4fdc-b44e-46a432248584",
                                "sense_id": "abc3eaff-653e-3b0c-9234-691479cef205",
                                "text": "„Es gibt noch diese so genannten »Interrogativpronomen«, auch »W-Wörter« oder »fragende Fürwörter«, »Fragefürwörter« genannt: WER, WELCHE, WAS, WEM, WESSEN...“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
