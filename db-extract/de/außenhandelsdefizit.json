                ],
                "senses": [
                    {
                        "sense_id": "78d87cbd-cc50-3ace-83a5-6fd8d194ebca",
                        "entry_id": "3fc91920-8780-342e-8977-68d32cfe03e7",
                        "glosses": [
                            "der Betrag, um den der Wert der Einfuhren (Importe) den Wert der Ausfuhren (Exporte) einer Volkswirtschaft übersteigt"
                        ],
                        "tags": [
                            "Volkswirtschaftslehre"
                        ],
                        "examples": [
                            {
                                "example_id": "d996a157-716f-4322-ae24-dedf6b48cb39",
                                "sense_id": "78d87cbd-cc50-3ace-83a5-6fd8d194ebca",
                                "text": "Zugleich weitete sich das Außenhandelsdefizit der USA aus, weil die Importe stärker stiegen als die Exporte."
                            },
                            {
                                "example_id": "d217e7cf-9b4e-4207-b8a7-0ed89401d9b0",
                                "sense_id": "78d87cbd-cc50-3ace-83a5-6fd8d194ebca",
                                "text": "Das Außenhandelsdefizit in Österreich hat sich 2005 von rund 1,24 Mrd. auf 1,79 Mrd. Euro erhöht."
                            },
                            {
                                "example_id": "fac7bece-3d45-44fd-8ba9-aa94cbbd67e5",
                                "sense_id": "78d87cbd-cc50-3ace-83a5-6fd8d194ebca",
                                "text": "Nach ersten Schätzungen des Statistischen Amts der Europäischen Gemeinschaften (Eurostat) ergab sich für die Eurozone (EZ13) im Dezember 2007 ein Außenhandelsdefizit von 4,2 Milliarden Euro."
                            },
                            {
                                "example_id": "46ae57c5-6fd3-4c08-9311-a7bba795df1f",
                                "sense_id": "78d87cbd-cc50-3ace-83a5-6fd8d194ebca",
                                "text": "Noch sind die USA als führendes Land der Weltwirtschaft in der Lage, ihre Außenhandelsdefizite mit der eigenen Währung, der Weltleitwährung Dollar, zu bezahlen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
