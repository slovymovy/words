    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2aa0dfcd-e3eb-33e3-acfb-2ae75a1ff911",
                    "sense_definition": "A state of being pleasantly lost in one's thoughts; a daydream.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "daydreaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He fell into a deep <w>reverie</w> while staring out of the window at the falling rain.",
                            "target_lang_translations": {
                                "ru": "Он впал в глубокое <w>забытьё</w>, глядя в окно на падающий дождь."
                            }
                        },
                        {
                            "text": "The loud noise suddenly broke her <w>reverie</w> and brought her back to reality.",
                            "target_lang_translations": {
                                "ru": "Громкий шум внезапно прервал её <w>грёзы</w> и вернул к реальности."
                            }
                        }
                    ],
                    "synonyms": [
                        "daydream",
                        "daydreaming"
                    ],
                    "common_phrases": [
                        "deep reverie",
                        "lost in reverie",
                        "break a reverie"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние приятной погруженности в свои мысли; мечтательность наяву."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грёзы",
                                "target_lang_sense_clarification": "мечты или сновидения наяву"
                            },
                            {
                                "target_lang_word": "забытьё",
                                "target_lang_sense_clarification": "состояние отрешённости от реальности"
                            },
                            {
                                "target_lang_word": "мечтательность",
                                "target_lang_sense_clarification": "склонность к мечтам"
                            },
                            {
                                "target_lang_word": "задумчивость",
                                "target_lang_sense_clarification": "погруженность в раздумья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24acb0e0-0367-31d6-af7e-d820c0b1f228",
                    "sense_definition": "An extravagant or impractical idea or vision of the imagination.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "imagination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect's plans were dismissed as a mere <w>reverie</w> that could never be built.",
                            "target_lang_translations": {
                                "ru": "Планы архитектора были отвергнуты как пустая <w>фантазия</w>, которую невозможно воплотить в жизнь."
                            }
                        },
                        {
                            "text": "His speech was full of strange <w>reveries</w> and numberless extravagancies.",
                            "target_lang_translations": {
                                "ru": "Его речь была полна странных <w>видений</w> и бесчисленных причуд."
                            }
                        }
                    ],
                    "synonyms": [
                        "castle in the air",
                        "castles in Spain"
                    ],
                    "common_phrases": [
                        "private reverie"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
