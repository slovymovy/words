                    "frequency": "VeryLow",
                    "semantic_group_id": "shipping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shipping line decided to make an <w>inducement</w> at the smaller port due to the high volume of exports."
                        },
                        {
                            "text": "Cargo levels were insufficient to justify an <w>inducement</w> at that particular harbor."
                        }
