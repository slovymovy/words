                "senses": [
                    {
                        "sense_id": "997b8a74-5189-3683-bdf1-3453f1cee7bb",
                        "entry_id": "5fd44081-2433-3556-9c03-50139b92eb6a",
                        "glosses": [
                            "od: kukła"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "df7beeec-075c-3f9e-901f-fdb2be5b45dc",
                        "entry_id": "5fd44081-2433-3556-9c03-50139b92eb6a",
                        "glosses": [
                            "lalka teatralna osadzona na kiju i animowana od dołu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48055f29-e3a2-4575-b9ed-9c3dcfde9745",
                                "sense_id": "df7beeec-075c-3f9e-901f-fdb2be5b45dc",
                                "text": "Targany sprzecznościami i różnymi namiętnościami przypominał kukiełkę poruszaną nieznaną ręką."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "1cd6504e-8461-3b8c-804e-28877428e1c2",
                        "entry_id": "5fd44081-2433-3556-9c03-50139b92eb6a",
                        "glosses": [
                            "prosta zabawka, lalka wykonana z gałganów"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "19e70c9f-b294-4633-a255-54c331f56ff1",
                                "sense_id": "1cd6504e-8461-3b8c-804e-28877428e1c2",
                                "text": "W domu zresztą zabawek dla małej nie było – szmaciana kukiełka musiała wystarczyć za wszystko."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "30f206d3-b8d4-3e67-b8d5-b06730826e61",
                        "entry_id": "5fd44081-2433-3556-9c03-50139b92eb6a",
                        "glosses": [
                            "regionalna nazwa różnych rodzajów okrągłych lub podłużnych bułek, czasem ze słodkiego ciasta"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5396e3fd-ebe0-4b6c-85c4-66e643f745b0",
                                "sense_id": "30f206d3-b8d4-3e67-b8d5-b06730826e61",
                                "text": "Na straganie kupiła dziecku słodką kukiełkę i szła dalej, rozglądając się po jarmarku."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e98ebc1-cc72-4777-9d14-4c3b125b8957",
                        "source_entry_id": "5fd44081-2433-3556-9c03-50139b92eb6a",
                        "source_sense_id": "997b8a74-5189-3683-bdf1-3453f1cee7bb",
                        "target_lang_word": "куколка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "куколка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "abc30388-0075-3d4a-9269-6981d3ea6cc9",
                                        "entry_id": "6ba75995-7731-3e15-b474-302b0e6b5845",
                                        "glosses": [
                                            "уменьш.-ласк. к кукла; небольшая кукла"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51a4f600-e67f-438d-8cf8-4fca2a15b02b",
                                                "sense_id": "abc30388-0075-3d4a-9269-6981d3ea6cc9",
                                                "text": "Лиза прижимала к себе пакет с тянучками и белесую куколку размером с мышь, подарок Ники."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c415b0a3-ee83-30cb-8b1b-d72818bf56a7",
                                        "entry_id": "6ba75995-7731-3e15-b474-302b0e6b5845",
                                        "glosses": [
                                            "энтомол. промежуточная стадия развития насекомых, для которых характерно полное превращение (метаморфоз) в течение жизни"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0979bd0f-1dbd-4954-a568-a9240650f699",
                                                "sense_id": "c415b0a3-ee83-30cb-8b1b-d72818bf56a7",
                                                "text": "Куколки бабочек имеют окраску и форму тела не менее разнообразную, чем у гусениц."
                                            },
                                            {
                                                "example_id": "38e5585d-011e-4165-b477-4426f1183060",
                                                "sense_id": "c415b0a3-ee83-30cb-8b1b-d72818bf56a7",
                                                "text": ".. наш сельский врач, милейший доктор Розанов, которому .. я .. оставил на попечение драгоценные синеватые куколки редкой совки (боялся взять их с собой в заграничное путешествие), преспокойно написал мне в Биарриц, что они отлично вылупились .."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a5bb470-d385-321e-9cc1-cccd33bbcdf7",
                                        "entry_id": "6ba75995-7731-3e15-b474-302b0e6b5845",
                                        "glosses": [
                                            "перен., разг. красивая, привлекательная женщина"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eda248dd-ebc3-4bfa-9826-9cb1952ddb4f",
                                                "sense_id": "6a5bb470-d385-321e-9cc1-cccd33bbcdf7",
                                                "text": "Ну, а потом покричали отец с матерью, отлупили для порядка сына вожжами, а сношку ласково ввели в дом, да ещё пожалели, что такая куколка такого дуботола в мужья выбрала."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b153cb57-0a1d-466a-844f-9c5db22cfda5",
                        "source_entry_id": "5fd44081-2433-3556-9c03-50139b92eb6a",
