                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f6ba40c-032e-4b97-8dc9-b090f1dfa6f4",
                        "source_entry_id": "a17c8eec-c9d5-3d74-885f-68bc502007e3",
                        "target_lang_word": "onderwerping",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onderwerping",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "528c9736-5293-3f5b-a8bb-412cfbe0e36b",
                                        "entry_id": "d09f5658-71d9-3761-98f6-f390b9a6455a",
                                        "glosses": [
                                            "erkennen dat iemand anders de baas over je is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "707c8904-ddca-402f-81bb-4c1a131f1404",
                                                "sense_id": "528c9736-5293-3f5b-a8bb-412cfbe0e36b",
                                                "text": "‘Het systeem’ verwachtte van hem dat hij sloeg als een vrouw niet gehoorzaamde. Dat was zijn rol. Maar vaak genoeg zag ik hem stiekem huilen in zijn slaapkamer. Hij was er ook niet gelukkig mee. Het vergt moed om dat te doorbreken. Probeer dat altijd. Niet protesteren is een vorm van onderwerping.”"
                                            },
                                            {
                                                "example_id": "c43b5ef7-8c6f-435a-93b3-48ff56f817cb",
                                                "sense_id": "528c9736-5293-3f5b-a8bb-412cfbe0e36b",
                                                "text": "Dat is het Frankrijk dat Michel Houellebecq schetst in zijn nieuwe roman, Soumission (Vertaald: ‘Onderwerping’ of ‘overgave’, wat ook het Arabische woord ‘islam’ betekent). Na twee termijnen Hollande zijn de presidentsverkiezingen in 2022, tussen Marine Le Pen en de leider van de Moslimbroederschap, Mohammed Ben Abbes, door de laatste gewonnen, met steun van een ‘breed Republikeins front’."
                                            },
                                            {
                                                "example_id": "afa9d0c9-4732-4a24-b87c-9d4e8f16700e",
                                                "sense_id": "528c9736-5293-3f5b-a8bb-412cfbe0e36b",
                                                "text": "Ook in Nederland zien we een lichtelijk sektarische onderwerping aan radicaal-rechtse politieke leiders. Een zekere blonde partijleider en een zelfbenoemde boy wonder die recent in de Tweede Kamer kwam, genieten op kleinere schaal van een gelovige fanbase die vergelijkbaar is met die van Trump."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e8073e5-e2ae-3736-8477-ce4621a6048b",
                                        "entry_id": "d09f5658-71d9-3761-98f6-f390b9a6455a",
                                        "glosses": [
                                            "de verplichting zich te laten leiden door een godheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "550c34ce-e01f-4db3-948f-423666c28fc4",
                                                "sense_id": "8e8073e5-e2ae-3736-8477-ce4621a6048b",
                                                "text": "In alle tijdperken voor het onze heerste de overtuiging dat ons leven voor minstens de helft werd bepaald door goden of geesten, die door middel van gebeden en offers konden worden beïnvloed en die complexe vormen van aanbidding en onderwerping verlangden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
