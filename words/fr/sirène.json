{
    "word_family": [
        "sirénien",
        "sirénomélie"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "09a59c14-9a2f-3bf5-84bb-859bac99a0e7",
                    "sense_definition": "Créature imaginaire du folklore et des contes, représentée avec un buste de femme et une queue de poisson.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "creature_mythologique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La petite <w>sirène</w> nageait paisiblement parmi les poissons multicolores."
                        },
                        {
                            "text": "Dans les contes populaires, la <w>sirène</w> séduit souvent les marins égarés."
                        }
                    ],
                    "common_phrases": [
                        "queue de sirène",
                        "chant de sirène"
                    ]
                },
                {
                    "sense_id": "222b7b8b-4154-3cf2-8bd1-f09d0536586c",
                    "sense_definition": "Appareil sonore puissant produisant un son aigu et modulé pour donner l'alerte ou signaler une urgence.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dispositif_sonore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>sirène</w> des pompiers retentit soudainement dans toute la rue déserte."
                        },
                        {
                            "text": "Dès que la <w>sirène</w> d'alarme retentit, les ouvriers quittent immédiatement l'usine."
                        }
                    ],
                    "synonyms": [
                        "alarme"
                    ],
                    "common_phrases": [
                        "sirène d'alarme",
                        "sirène des pompiers",
                        "sirène de police"
                    ]
                },
                {
                    "sense_id": "2f64f449-615b-3b6a-99b1-cb40544355e7",
                    "sense_definition": "Divinité marine de la mythologie gréco-romaine, mi-femme mi-oiseau, qui charmait les navigateurs par ses chants pour les faire périr.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "creature_mythologique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ulysse s'est fait attacher au mât pour écouter le chant mélodieux des <w>sirènes</w>."
                        },
                        {
                            "text": "Dans l'Antiquité, les <w>sirènes</w> étaient figurées avec des corps d'oiseaux."
                        }
                    ],
                    "common_phrases": [
                        "chant des sirènes"
                    ]
                },
                {
                    "sense_id": "1ed145cd-d98f-346b-a7bd-71f3790b9128",
                    "sense_definition": "Attrait trompeur ou proposition séduisante mais dangereuse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "seduction_trompeuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a refusé de céder aux <w>sirènes</w> de la célébrité facile."
                        },
                        {
                            "text": "L'entrepreneur a su résister aux <w>sirènes</w> du profit à court terme."
                        }
                    ],
                    "common_phrases": [
                        "céder aux sirènes",
                        "écouter les sirènes"
                    ]
                },
                {
                    "sense_id": "860b8e16-5a8c-39ae-b46e-4a2bdd11f39b",
                    "sense_definition": "Femme qui captive ou séduit irrésistiblement par son charme et ses manières.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "seduction_trompeuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette femme politique manipulait ses rivaux comme une redoutable <w>sirène</w>."
                        },
                        {
                            "text": "L'écrivain décrivait son héroïne sous les traits d'une dangereuse <w>sirène</w>."
                        }
                    ],
                    "common_phrases": [
                        "voix de sirène"
                    ]
                },
                {
                    "sense_id": "6fedab38-e8f2-30eb-8188-bb03697c0d7d",
                    "sense_definition": "Figure imaginaire représentée sur des armoiries, généralement avec une queue de poisson et un buste de femme.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blason officiel de la commune comporte une <w>sirène</w> d'argent marinée d'or."
                        },
                        {
                            "text": "On reconnaît facilement cette famille noble grâce à la <w>sirène</w> peinte sur son écusson."
                        }
                    ],
                    "synonyms": [
                        "mélusine",
                        "merlusine"
                    ]
                }
            ]
        }
    ]
}