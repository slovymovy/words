                            {
                                "example_id": "6fef21f7-a979-406b-9394-eb0700c06d31",
                                "sense_id": "f175eac4-a302-379d-a324-469cfec24989",
                                "text": "Het nieuwe magazijn van ECS wordt gebruikt voor de overslag van droog en gekoeld palletgoed. In het magazijn komt een koelcel met zeven laadpoorten. Het gedeelte voor de droge vracht zal 22 laadpoorten tellen."
                            },
