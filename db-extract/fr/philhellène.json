                                        "entry_id": "9d9bde17-6e8f-3a78-a538-0b229aa244f1",
                                        "glosses": [
                                            "A lover of Greece or Greek culture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "614b5d16-5ee7-38bc-8983-115cddab90f2",
                                        "entry_id": "9d9bde17-6e8f-3a78-a538-0b229aa244f1",
                                        "glosses": [
                                            "Specifically, a supporter of Greek independence, especially during the Greek war of independence in 1821-29."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66973954-e21d-4c1c-9f56-3b8601a086ae",
                                                "sense_id": "614b5d16-5ee7-38bc-8983-115cddab90f2",
                                                "text": "Some historians have suggested that modern ‘humanitarian intervention’ began with the philhellenes in Greece in the 1820."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb531519-6117-48ea-88cd-463fc2263e53",
                        "source_entry_id": "2a059c45-34e0-3f61-986e-741624281496",
                        "source_sense_id": "5b01bf56-eb25-39a3-8481-7f474beb1eca",
                        "target_lang_word": "philhellenic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "philhellenic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ee9b9ba-6928-32eb-a4d5-2afeeff61b47",
                                        "entry_id": "1e854706-c170-33a1-b81a-2df204f7f147",
                                        "glosses": [
                                            "Loving Greece or Greek culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea60998e-eed0-465c-bce2-db55cfca3ee8",
                                                "sense_id": "9ee9b9ba-6928-32eb-a4d5-2afeeff61b47",
                                                "text": "These ancient treasures, together with historic photographs of the major excavations, aerial panoramas of splendid sites, old watercolors and lithographs, and 19th-century architectural renderings, are enough to leave a deep impression on anyone with a drop of philhellenic blood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5665d86-b856-3f29-9129-11372953b586",
                                        "entry_id": "1e854706-c170-33a1-b81a-2df204f7f147",
                                        "glosses": [
                                            "Specifically, supportive of Greek national independence."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "911e4434-7ab0-4a13-a19e-c15bb4e1d880",
                                                "sense_id": "c5665d86-b856-3f29-9129-11372953b586",
                                                "text": "In France, where philhellenic sentiment reached a peak at this time, the government was secretly building warships for the Egyptian fleet and even sent French officers as advisors to accompany them when they went into service in 1827."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
