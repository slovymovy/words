                ],
                "senses": [
                    {
                        "sense_id": "9ccb8114-a1b5-3f7c-9b12-f52541eba055",
                        "entry_id": "3ee57bf9-7fec-3a36-96b1-e5d65529159e",
                        "glosses": [
                            "Zustand, der zwei Deutungen beziehungsweise zwei Arten der Interpretation zulässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b732440-5c62-4284-ab28-fcdbbd280692",
                                "sense_id": "9ccb8114-a1b5-3f7c-9b12-f52541eba055",
                                "text": "Die Doppeldeutigkeit seiner Aussage fiel ihm erst im Nachhinein auf."
                            },
                            {
                                "example_id": "eadbeebb-9497-491a-ad18-9062a903a383",
                                "sense_id": "9ccb8114-a1b5-3f7c-9b12-f52541eba055",
                                "text": "„Auch beim Wörtlichnehmen ist es oft das sexuelle Gebiet, auf das sich die Zweideutigkeit des Witzes bezieht.“"
                            },
                            {
                                "example_id": "a7a8b7ab-0531-4748-a7d1-7356a6c40119",
                                "sense_id": "9ccb8114-a1b5-3f7c-9b12-f52541eba055",
                                "text": "„Das Wort ist hebräisch, wird aber jiddisch intoniert, und die linguistische Zweideutigkeit ist beabsichtigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46f15070-49c5-4b87-8f85-94e9e22f638f",
                        "source_entry_id": "3ee57bf9-7fec-3a36-96b1-e5d65529159e",
                        "source_sense_id": "9ccb8114-a1b5-3f7c-9b12-f52541eba055",
                        "source_sense_description": "Zustand, der zwei Deutungen beziehungsweise zwei Arten der Interpretation zulässt",
                        "target_lang_word": "ambiguity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambiguity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aefef315-5542-39eb-887c-cd977f8811a3",
                                        "entry_id": "fe856398-c0d8-3ac5-a71a-62063c91bdf1",
                                        "glosses": [
                                            "The state of being ambiguous; the state of leaving room for more than one interpretation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dba432b-8b82-4b83-bf66-4f9bf56cfaa0",
                                                "sense_id": "aefef315-5542-39eb-887c-cd977f8811a3",
                                                "text": "His speech was made with such great ambiguity that neither supporter nor opponent could be certain of his true position."
                                            },
                                            {
                                                "example_id": "d5592aea-f392-41da-80f7-68466a37aed2",
                                                "sense_id": "aefef315-5542-39eb-887c-cd977f8811a3",
                                                "text": "Whan this ſayd monument diſcouered was / Suche a ſuauite and fragrant odoure / Aſcended from the corps by ſingular grace / Paſſyng all worldly ſwetnes and ſauour / That all there present that day and hour / Suppoſed they had ben / in the felicite / Of erthely paradiſe / without ambiguite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "307b5f88-5d72-3050-b802-d44c87e5efdd",
                                        "entry_id": "fe856398-c0d8-3ac5-a71a-62063c91bdf1",
                                        "glosses": [
                                            "An instance of this state: words or statements that are open to more than one interpretation, explanation or meaning, especially if that meaning cannot be determined from the context."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44f83797-11ca-4ac8-a0a0-d4b938a66e69",
                                                "sense_id": "307b5f88-5d72-3050-b802-d44c87e5efdd",
                                                "text": "If two persons bore the same name, and confusion was likely to be caused, ambiguity was avoided by adding the name of the father[…]"
                                            },
                                            {
                                                "example_id": "c305ed61-1f5b-4e4c-9544-528f661375b9",
                                                "sense_id": "307b5f88-5d72-3050-b802-d44c87e5efdd",
                                                "text": "For people who would rather face a plague of locusts than permit an avoidable ambiguity, this is like having their underwear twisted. You may think we should say to such people, “Get a life.” By all means tell them that. I’m neither making these rules up nor trying to enforce them; my job in this book is to point out to you what seems to be the current state of the language and its speakers.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4684be97-abee-4d88-bb73-3e474a79d818",
                        "source_entry_id": "3ee57bf9-7fec-3a36-96b1-e5d65529159e",
                        "source_sense_id": "9ccb8114-a1b5-3f7c-9b12-f52541eba055",
                        "source_sense_description": "Zustand, der zwei Deutungen beziehungsweise zwei Arten der Interpretation zulässt",
                        "target_lang_word": "ambigüité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambigüité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1614f60-0a72-3329-b06e-129e157ffe21",
                                        "entry_id": "09ef538f-444c-33a0-a598-41297b735595",
                                        "glosses": [
                                            "Variante orthographique de ambiguïté."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dc81172-459c-4862-82b5-afcaedb63dac",
                                                "sense_id": "c1614f60-0a72-3329-b06e-129e157ffe21",
                                                "text": "Ensuite, le démarrage des délais d’établissement du décompte du marché selon l’importance des réserves émises : les conseillers d’état tentent ici de lever toute ambigüité."
                                            }
                                        ]
