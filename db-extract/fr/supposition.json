                                                "sense_id": "708feb96-0a75-3057-ab2a-7ee40ffd92e6",
                                                "text": "His assumption of secretarial duties was timely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7029f88-14ed-3b20-858c-a3f86407efb7",
                                        "entry_id": "8ed82770-be05-34e7-979d-2a23ebc1b427",
                                        "glosses": [
                                            "The act of taking for granted, or supposing a thing without proof; a supposition; an unwarrantable claim."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32cd102b-771f-4725-a691-1ac0c7696e41",
                                                "sense_id": "b7029f88-14ed-3b20-858c-a3f86407efb7",
                                                "text": "Their assumption of his guilt disqualified them from jury duty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aedeaa8-205f-30ca-9dde-e23a9686a283",
                                        "entry_id": "8ed82770-be05-34e7-979d-2a23ebc1b427",
                                        "glosses": [
                                            "The thing supposed; a postulate, or proposition assumed; a supposition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c81435d-bee7-4cbd-a359-dd05de08a1a7",
                                                "sense_id": "6aedeaa8-205f-30ca-9dde-e23a9686a283",
                                                "text": "No doubt a finite evaluative argument must make some unargued evaluative assumptions, just as finite factual arguments must make some unargued factual assumptions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "133271ca-6cc1-3c61-845a-f9355fb5773a",
