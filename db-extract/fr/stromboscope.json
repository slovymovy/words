                        "glosses": [
                            "Variante de stroboscope."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92212131-a295-471d-beb4-a517afd14c68",
                                "sense_id": "35df05d2-6e9e-3816-a53d-a6c89b451939",
                                "text": "Point d'oscilloscope et de stromboscope pour régler la carburation : ceci est “ affaire d'oreille ”, “ Ce sont des intuitifs ” disent les ingénieurs des équipes qui s'affairent à une vingtaine autour des tracteurs de modèles récents."
                            },
                            {
                                "example_id": "839c65aa-ea84-4946-8190-2bf37d1ec612",
                                "sense_id": "35df05d2-6e9e-3816-a53d-a6c89b451939",
                                "text": "…le rythme d'abord saccadé - puis littéralement pulvérisé en effets de stromboscope lors du déménagement final de l'ennui et de l'angoisse - confondus ; 'immobilisation , enfin , …."
                            },
                            {
                                "example_id": "0f068e25-41be-4a07-95ed-5c9f203db6b9",
                                "sense_id": "35df05d2-6e9e-3816-a53d-a6c89b451939",
                                "text": "La boîte est d'inspiration psychédélique, avec métal « skaï » noir et blanc , meubles aux piètements chromés et lumière couplée sur les rythmes de danse ( stromboscope)."
                            },
                            {
                                "example_id": "bf528b27-984b-4877-b15a-c1e634abc56a",
                                "sense_id": "35df05d2-6e9e-3816-a53d-a6c89b451939",
                                "text": "C'est dans cette simple quête au rythme des basses et des stromboscopes, que la jouissance s'épuise."
                            }
                        ]
                    }
