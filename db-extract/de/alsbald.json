        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "9c44daa8-c8c8-3fa6-b331-292ee01c6778",
                "word": "alsbald",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2b8d6258-b4c9-3e2a-9141-336ef1bbe4ab",
                        "entry_id": "9c44daa8-c8c8-3fa6-b331-292ee01c6778",
                        "glosses": [
                            "kurz danach, in Kürze"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "716730c2-ee85-455f-affe-1fdc2df88794",
                                "sense_id": "2b8d6258-b4c9-3e2a-9141-336ef1bbe4ab",
                                "text": "„Die Scheidung ist eingereicht; sie wird alsbald ausgesprochen werden.“"
                            },
                            {
                                "example_id": "d2175838-ac8e-44be-99f3-afb2c4ab39ae",
                                "sense_id": "2b8d6258-b4c9-3e2a-9141-336ef1bbe4ab",
                                "text": "Da gegenwärtig im hiesigen Rechtsstreit noch ein Revisionsverfahren beim Bundesgerichtshof (BGH) anhängig ist, bleibt zu hoffen, dass es in diesem Zusammenhang alsbald höchstrichterliche Klarheit gibt."
                            },
                            {
                                "example_id": "b41a56bf-bcdd-428f-ae15-dfd434678733",
                                "sense_id": "2b8d6258-b4c9-3e2a-9141-336ef1bbe4ab",
                                "text": "„Das etruskische Alphabet wurde alsbald auch von den Venetern übernommen und an die Bedürfnisse der eigenen Sprache angepasst, wie die zahlreichen venetischen Inschriften zeigen.“"
                            },
                            {
                                "example_id": "811c5e74-e42b-483e-8e39-e99da6abd8ad",
                                "sense_id": "2b8d6258-b4c9-3e2a-9141-336ef1bbe4ab",
                                "text": "„Auf frischer Tat betreten wird ein Dieb, wenn er alsbald nach Vollendung der Tat am Tatort oder in dessen Nähe von einer anderen Person wahrgenommen oder bemerkt wird, aber auch dann, wenn er durch schnelles Zuschlagen dem Bemerktwerden zuvorkommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42c49050-e634-497d-b42e-77f6740b210f",
                        "source_entry_id": "9c44daa8-c8c8-3fa6-b331-292ee01c6778",
                        "source_sense_id": "2b8d6258-b4c9-3e2a-9141-336ef1bbe4ab",
                        "source_sense_description": "veraltend: kurz danach, in Kürze",
                        "target_lang_word": "soon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7b7eb68-e050-39c6-b3f8-9cf17a74f364",
                                        "entry_id": "7e2f33f8-1630-3b54-8efc-d1b3502d08c9",
                                        "glosses": [
                                            "Short in length of time from the present."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3173a0e7-5e22-4ea5-911a-bd539f8bd51d",
                                                "sense_id": "d7b7eb68-e050-39c6-b3f8-9cf17a74f364",
                                                "text": "I need the soonest date you have available."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d55979d4-eddd-30b1-aff2-f35dda54dc23",
                                        "entry_id": "7e2f33f8-1630-3b54-8efc-d1b3502d08c9",
                                        "glosses": [
                                            "Early."
                                        ],
                                        "tags": [
                                            "US",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43f4dae0-cab4-4340-a865-86ec92591542",
                                                "sense_id": "d55979d4-eddd-30b1-aff2-f35dda54dc23",
                                                "text": "Late in the evening we arrived at Quincy where we bivouacked for the night and taken a soon start the next morning to march to the arsenal."
                                            },
                                            {
                                                "example_id": "de10cacb-480f-4fe5-84fa-692fc6ea0bd5",
                                                "sense_id": "d55979d4-eddd-30b1-aff2-f35dda54dc23",
                                                "text": "Got up pretty early, ate a soon breakfast, had the sulky and was about to start to Newtown when it commenced raining.."
                                            },
                                            {
                                                "example_id": "3f156422-1ac6-436a-a9a6-b13ef6bdcca3",
                                                "sense_id": "d55979d4-eddd-30b1-aff2-f35dda54dc23",
                                                "text": "They were different from colored folks who had to be out to get a soon start."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8335078-0ca3-36fa-94b7-368247768676",
                                        "entry_id": "7e2f33f8-1630-3b54-8efc-d1b3502d08c9",
                                        "glosses": [
                                            "Used as an alternative to express 'to be going to' in the form 'to be soon to'."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eec91b3-3572-4fc7-9fc0-33cdeb5e75ff",
                                                "sense_id": "b8335078-0ca3-36fa-94b7-368247768676",
                                                "text": "Hurry up, the wedding is soon to start!"
                                            },
                                            {
                                                "example_id": "96e6da7d-c537-4b32-b1c9-71414e58b574",
                                                "sense_id": "b8335078-0ca3-36fa-94b7-368247768676",
                                                "text": "A new shop is soon to be opened in this street."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "soon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64920a44-afc2-371a-a23b-21428d4c888f",
                                        "entry_id": "71c35774-478c-3b06-9285-120a57bd3553",
                                        "glosses": [
                                            "Immediately, instantly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba107ec4-880b-3bbd-a321-325b71af4247",
                                        "entry_id": "71c35774-478c-3b06-9285-120a57bd3553",
                                        "glosses": [
                                            "Within a short time; quickly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "555d5a98-8f4e-4e10-836c-f8b7d11041ee",
                                                "sense_id": "ba107ec4-880b-3bbd-a321-325b71af4247",
                                                "text": "His wife is likely to come too after him, but we just do not know how soon after."
                                            },
                                            {
                                                "example_id": "f2669e72-cf69-4a66-8240-b2d56ba10d59",
                                                "sense_id": "ba107ec4-880b-3bbd-a321-325b71af4247",
                                                "text": "I stumbled along through the young pines and huckleberry bushes. Pretty soon I struck into a sort of path that, I cal'lated, might lead to the road I was hunting for. It twisted and turned, and, the first thing I knew, made a sudden bend around a bunch of bayberry scrub and opened out into a big clear space like a lawn."
                                            },
                                            {
                                                "example_id": "fb1399c9-d019-47de-a189-5f2d81e92d7b",
                                                "sense_id": "ba107ec4-880b-3bbd-a321-325b71af4247",
                                                "text": "Then everybody once more knelt, and soon the blessing was pronounced. The choir and the clergy trooped out slowly,[…], down the nave to the western door.[…]At a seemingly immense distance the surpliced group stopped to say the last prayer."
                                            },
                                            {
                                                "example_id": "1dbfb7b6-6a4e-4005-8caa-86e72479b0bb",
                                                "sense_id": "ba107ec4-880b-3bbd-a321-325b71af4247",
                                                "text": "Manganism has been known about since the 19th century, when miners exposed to ores containing manganese[…]began to totter, slur their speech and behave like someone inebriated. The poisoning was irreversible, and soon ended in psychosis and death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f852e2c8-c2a6-3a36-bea3-11f8e5346b87",
                                        "entry_id": "71c35774-478c-3b06-9285-120a57bd3553",
                                        "glosses": [
                                            "Early."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b5e7563-0256-4adc-a899-17a9c5b43978",
                                                "sense_id": "f852e2c8-c2a6-3a36-bea3-11f8e5346b87",
                                                "text": "How is it that ye are come so soon to day?"
                                            },
                                            {
                                                "example_id": "bd10ade2-b7b4-42b4-9d0c-308e53e73d1e",
                                                "sense_id": "f852e2c8-c2a6-3a36-bea3-11f8e5346b87",
                                                "text": "“Been huntin’ fuh mah mule. Anybody seen ’im?” he asked.\n“Seen ’im soon dis mornin’ over behind de school-house,” Lum said. “’’Bout ten o’clock or so. He musta been out all night tuh be way over dere dat early.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c6f0278-1a57-3172-9a1f-4163191adc56",
                                        "entry_id": "71c35774-478c-3b06-9285-120a57bd3553",
                                        "glosses": [
                                            "Readily; willingly; used with would, or some other word expressing will."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06526372-cf03-4d8d-b562-8d279ecd6668",
                                                "sense_id": "4c6f0278-1a57-3172-9a1f-4163191adc56",
                                                "text": "I would as soon see a river winding through woods or in meadows, as when it is tossed up in so many whimsical figures at Versailles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4dc673a-0400-4609-b0b6-fb4f9cfdcc0e",
                        "source_entry_id": "9c44daa8-c8c8-3fa6-b331-292ee01c6778",
                        "source_sense_id": "2b8d6258-b4c9-3e2a-9141-336ef1bbe4ab",
                        "source_sense_description": "veraltend: kurz danach, in Kürze",
                        "target_lang_word": "afterwards",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afterwards",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c15f2325-5775-3f0b-8967-ad80a354da7f",
                                        "entry_id": "ecb016ed-27f0-37e1-8298-52f53feb9f22",
                                        "glosses": [
                                            "At a later or succeeding time; after that;"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "009ac6a8-4797-4585-a397-b144090d83e8",
                                                "sense_id": "c15f2325-5775-3f0b-8967-ad80a354da7f",
                                                "text": "Another Karadeniz cross led to Cudicini's first save of the night, with the Spurs keeper making up for a weak punch by brilliantly pushing away Christian Noboa's snap-shot.\nTwo more top-class stops followed quickly afterwards, first from Natcho's rasping shot which was heading into the top corner, and then to deny Ryazantsev at his near post."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e72fa174-4edf-4469-8d5d-1ac3181305a8",
                        "source_entry_id": "9c44daa8-c8c8-3fa6-b331-292ee01c6778",
                        "source_sense_id": "2b8d6258-b4c9-3e2a-9141-336ef1bbe4ab",
                        "source_sense_description": "veraltend: kurz danach, in Kürze",
                        "target_lang_word": "at once",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "at once",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06ea4d6c-432a-3bc4-a17a-19f4979ce2d4",
                                        "entry_id": "69f8f84f-8edd-3934-948c-f1ef14e5b8df",
                                        "glosses": [
                                            "In one group; together."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8e22d8c-067f-4baa-bd64-cd32c42387ad",
                                                "sense_id": "06ea4d6c-432a-3bc4-a17a-19f4979ce2d4",
                                                "text": "And they all atonce begane to make excuſe. The fyrſt ſayd vnto him: I have bought a ferme / and I muſt nedes goo and ſe it / I praye the have me excuſed."
                                            },
                                            {
                                                "example_id": "1f905b37-eaee-4b65-b469-0917af10af90",
                                                "sense_id": "06ea4d6c-432a-3bc4-a17a-19f4979ce2d4",
                                                "text": "Those two great champions did attonce pursew / The fearefull damzell with incessany payns [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a6f195c-6c00-3d23-997e-7afe3d953f1a",
                                        "entry_id": "69f8f84f-8edd-3934-948c-f1ef14e5b8df",
                                        "glosses": [
                                            "At the same time; simultaneously; together."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e4eb593-5673-40e6-bb82-78c8011ec62f",
                                                "sense_id": "9a6f195c-6c00-3d23-997e-7afe3d953f1a",
                                                "text": "Can you pat your head and rub your belly at once?\nHe tried to eat four cookies at once."
                                            },
                                            {
                                                "example_id": "8fd9ad29-e2bf-43ba-bf87-49ac73eaadb4",
                                                "sense_id": "9a6f195c-6c00-3d23-997e-7afe3d953f1a",
                                                "text": "The [Washington] Post's proprietor through those turbulent [Watergate] days, Katharine Graham, held a double place in Washington’s hierarchy: at once regal Georgetown hostess and scrappy newshound, ready to hold the establishment to account."
                                            },
                                            {
                                                "example_id": "f0f5dd7c-071c-48a2-9cc6-8e7d41df7f94",
                                                "sense_id": "9a6f195c-6c00-3d23-997e-7afe3d953f1a",
                                                "text": "[T]he book, constructed in short, lucid episodes, can be satisfyingly read as a sequence of provocative talks, at once well informed and vatic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "552397ca-7289-363b-a8c1-5cd4213d0ef1",
                                        "entry_id": "69f8f84f-8edd-3934-948c-f1ef14e5b8df",
                                        "glosses": [
                                            "Immediately; now; right away."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "783646a3-8604-494b-a7e7-ec0659660b36",
                                                "sense_id": "552397ca-7289-363b-a8c1-5cd4213d0ef1",
                                                "text": "Tell the doctor to come at once. She is having a baby."
                                            },
                                            {
                                                "example_id": "de052e0a-985f-44f2-a01f-8fe7f0578c51",
                                                "sense_id": "552397ca-7289-363b-a8c1-5cd4213d0ef1",
                                                "text": "Mr. Cooke at once began a tirade against the residents of Asquith for permitting a sandy and generally disgraceful condition of the roads. So roundly did he vituperate the inn management in particular, and with such a loud flow of words, that I trembled lest he should be heard on the veranda."
                                            },
                                            {
                                                "example_id": "0a639dff-9803-4e48-bdd0-575b4b2b3bd5",
                                                "sense_id": "552397ca-7289-363b-a8c1-5cd4213d0ef1",
                                                "text": "One saint's day in mid-term a certain newly appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.” He at once secured attention by his informal method, and when presently the coughing of Jarvis […] interrupted the sermon, he altogether captivated his audience with a remark about cough lozenges being cheap and easily procurable."
                                            },
                                            {
                                                "example_id": "95014966-2f63-45be-b6a5-3759f5549751",
                                                "sense_id": "552397ca-7289-363b-a8c1-5cd4213d0ef1",
                                                "text": "Sparks from the derailed bogie of the train were first noticed by the signalman at Slough West box, who immediately sent to Slough Middle box the \"Stop and Examine\" signal, followed at once by \"Obstruction Danger\" when he realised that the coach was derailed."
                                            },
                                            {
                                                "example_id": "12eadae3-3e25-40ba-995b-4cb626a419a5",
                                                "sense_id": "552397ca-7289-363b-a8c1-5cd4213d0ef1",
                                                "text": "As soon as Julia returned with a constable, Timothy, who was on the point of exhaustion, prepared to give over to him gratefully. The newcomer turned out to be a powerful youngster, fully trained and eager to help, and he stripped off his tunic at once."
                                            }
                                        ]
