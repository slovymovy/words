{
    "word_family": [
        "pękać",
        "pęk"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1a011f7b-8810-3877-a961-b511c407aed5",
                    "sense_definition": "rozszerzający się znacznie w jednym miejscu, zwykle pośrodku",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kształt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na stole stał <w>pękaty</w> dzbanek pełen świeżego mleka.",
                            "target_lang_translations": {
                                "ru": "На столе стоял <w>пузатый</w> кувшин, полный свежего молока."
                            }
                        },
                        {
                            "text": "Znalazł w piwnicy <w>pękaty</w> słoik z domowymi ogórkami.",
                            "target_lang_translations": {
                                "ru": "Он нашел в подвале <w>пузатую</w> банку с домашними огурцами."
                            }
                        }
                    ],
                    "synonyms": [
                        "beczkowaty",
                        "brzuchaty"
                    ],
                    "common_phrases": [
                        "pękaty dzbanek",
                        "pękaty słoik"
                    ],
                    "target_lang_definitions": {
                        "ru": "имеющий округлую, выпуклую форму, расширяющийся посередине"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пузатый",
                                "target_lang_sense_clarification": "о предметах округлой формы, напоминающих живот"
                            },
                            {
                                "target_lang_word": "бочкообразный",
                                "target_lang_sense_clarification": "о предметах, расширяющихся в средней части"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67c2d3a9-65a2-3634-85f9-1844284cbb41",
                    "sense_definition": "napełniony lub wypchany mocno czymś",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wrócił z podróży z <w>pękatym</w> portfelem pełnym obcej waluty.",
                            "target_lang_translations": {
                                "ru": "Он вернулся из поездки с <w>набитым</w> кошельком, полным иностранной валюты."
                            }
                        },
                        {
                            "text": "Dziecko niosło <w>pękaty</w> plecak wypchany po brzegi zabawkami.",
                            "target_lang_translations": {
                                "ru": "Ребенок нес <w>раздутый</w> рюкзак, набитый до краев игрушками."
                            }
                        }
                    ],
                    "synonyms": [
                        "brzuchaty"
                    ],
                    "common_phrases": [
                        "pękaty portfel",
                        "pękaty plecak"
                    ],
                    "target_lang_definitions": {
                        "ru": "сильно наполненный или набитый чем-либо до краев"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набитый",
                                "target_lang_sense_clarification": "о чем-то, заполненном до отказа"
                            },
                            {
                                "target_lang_word": "раздутый",
                                "target_lang_sense_clarification": "о предмете, который выглядит полным из-за содержимого"
                            }
                        ]
                    }
                }
            ]
        }
    ]
