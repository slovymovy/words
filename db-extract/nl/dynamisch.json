                        "sense_id": "0f31b0fa-65ec-3da6-b8c7-880ac95cfe2e",
                        "entry_id": "6ca37996-2dfc-34a7-88aa-5d113171445a",
                        "glosses": [
                            "de dynamica betreffend"
