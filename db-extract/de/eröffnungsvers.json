                ],
                "senses": [
                    {
                        "sense_id": "af943d00-e0af-39cd-9377-e72ce0efeefe",
                        "entry_id": "b4de00b1-5f7c-3cc4-9519-ceb7f5b1d357",
                        "glosses": [
                            "zu Beginn stehender Vers, insbesondere ein tagesabhängiger Satz zu Beginn der Heiligen Messe; Beginn des Introitus"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "79ab4659-4e2c-4559-9dd7-6f192ef35cb5",
                                "sense_id": "af943d00-e0af-39cd-9377-e72ce0efeefe",
                                "text": "„Der Eröffnungsvers der Messe ist ein in der Praxis eher selten beachtetes liturgisches Element. Er steht programmatisch über der ganzen Feier und weist auf das Festgeheimnis bzw. auf den Leitgedanken des Gottesdienstes hin.“"
                            },
                            {
                                "example_id": "2a43db62-68e8-4f62-8db5-331bf9989918",
                                "sense_id": "af943d00-e0af-39cd-9377-e72ce0efeefe",
                                "text": "„Man kann den Eröffnungsvers mit dem dazugehörigen Psalm aus dem Graduale Romanum beziehungsweise dem Graduale Simplex verwenden oder einen anderen Gesang, der diesem Teil der Feier, dem betreffenden Tag oder der liturgischen Zeit entspricht und dessen Text von der Bischofskonferenz gebilligt ist.“"
                            },
                            {
                                "example_id": "99158b91-2b44-43d1-855f-b9ab104b802c",
                                "sense_id": "af943d00-e0af-39cd-9377-e72ce0efeefe",
                                "text": "„Kann zum Einzug nicht gesungen werden, soll der im Römischen Messbuch vorgesehene Eröffnungsvers von allen oder einigen Gläubigen oder vom Lektor vorgetragen werden, notfalls vom Priester selbst nach der Begrüßung.“"
                            },
                            {
                                "example_id": "f3ce1a4c-6e94-4238-8898-386294962663",
                                "sense_id": "af943d00-e0af-39cd-9377-e72ce0efeefe",
                                "text": "„Es folgt ein Eröffnungsvers mit Begrüßung.“"
                            },
                            {
                                "example_id": "f620dd0e-eb9f-4a0f-bbdb-c4da2ff9bab6",
                                "sense_id": "af943d00-e0af-39cd-9377-e72ce0efeefe",
                                "text": "„In der nach 1970 reformierten ordentlichen Form des römischen Ritus beginnt an Stelle des Introitus das Ordinarium der Tagesliturgie mit einem Eröffnungsvers […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
