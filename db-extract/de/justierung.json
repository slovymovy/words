                            }
                        ]
                    },
                    {
                        "translation_id": "99b5b14b-9eb1-4b68-8c09-4570ecd85878",
                        "source_entry_id": "dbe0039c-7ec7-34c6-be5c-8dc4fc6885d3",
                        "source_sense_id": "2ac90eac-f7e7-3283-b903-90ec62cf4a6f",
                        "target_lang_word": "ajustement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ajustement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5241239-b2ed-358a-98ac-180547d7ca96",
                                        "entry_id": "fca5b15c-a7b2-3572-a36a-d8996c18bce9",
                                        "glosses": [
                                            "Action d’ajuster, de s’ajuster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35757dc4-c8d3-474f-af9f-6a9a0ddac1a3",
                                                "sense_id": "a5241239-b2ed-358a-98ac-180547d7ca96",
                                                "text": "Chargée d’une mission inédite, la CIIVISE a adopté une organisation conforme aux standards institutionnels du genre avec des ajustements résultant du caractère inédit de sa mission."
                                            },
                                            {
                                                "example_id": "25e9e479-280f-420e-b3c6-a82c132890c7",
                                                "sense_id": "a5241239-b2ed-358a-98ac-180547d7ca96",
                                                "text": "Chercher, trouver des ajustements dans quelque affaire."
                                            },
                                            {
                                                "example_id": "b6dbea56-a095-4908-a4dd-cb007aa04413",
                                                "sense_id": "a5241239-b2ed-358a-98ac-180547d7ca96",
                                                "text": "Elle n’est pas belle, elle a besoin d’ajustement."
                                            },
                                            {
                                                "example_id": "ce22ffe1-79fa-4ef9-957b-816483a50b8b",
                                                "sense_id": "a5241239-b2ed-358a-98ac-180547d7ca96",
                                                "text": "Un artiste doit faire concourir l’ajustement à l’aspect général de son œuvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4847ea35-fe2a-30f0-badd-db9146920288",
                                        "entry_id": "fca5b15c-a7b2-3572-a36a-d8996c18bce9",
                                        "glosses": [
                                            "Résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "777c6c06-16d3-4dfb-82f1-02988986cb3b",
                                                "sense_id": "4847ea35-fe2a-30f0-badd-db9146920288",
                                                "text": "L’ajustement de sa maison, de son jardin annonce qu’il a du goût."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebf66a32-112d-3338-b657-6a6dfed48005",
                                        "entry_id": "fca5b15c-a7b2-3572-a36a-d8996c18bce9",
                                        "glosses": [
                                            "Forme abrégée de ajustement automatique d’intonation."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0ee4a03-6aef-3d66-8d72-f56bbeb711fe",
                                        "entry_id": "fca5b15c-a7b2-3572-a36a-d8996c18bce9",
                                        "glosses": [
                                            "Ajustage : réglage, modification d’un instrument de mesure, d’un circuit électronique, etc., pour correspondre aux spécifications (ou résultat de cette opération)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5b08183-244b-4997-a0e8-6b26a1fb16d4",
                                                "sense_id": "b0ee4a03-6aef-3d66-8d72-f56bbeb711fe",
                                                "text": "La plupart des capteurs sont suffisamment linéaires et ne nécessitent qu’un ajustement de la valeur initiale et de l’étendue du signal de sortie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a06411d1-91dc-309b-aaee-58bb6931b3d1",
                                        "entry_id": "fca5b15c-a7b2-3572-a36a-d8996c18bce9",
                                        "glosses": [
                                            "Relation entre les cotes de deux pièces mécaniques d’un assemblage fonctionnel, par exemple un arbre dans un alésage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11fb40fd-a777-4b89-82b1-204f41b7c964",
                                                "sense_id": "a06411d1-91dc-309b-aaee-58bb6931b3d1",
                                                "text": "La combinaison de tolérances H7/g6, pour l’alésage et l’arbre respectivement selon ISO 286, donne un ajustement gras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "641f134d-45c8-3cdf-8079-6abf601e415b",
                                        "entry_id": "fca5b15c-a7b2-3572-a36a-d8996c18bce9",
                                        "glosses": [
                                            "Tempérament, accommodement."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cbd6f7e-8bc4-363f-8db1-d532fbe77a8b",
                                        "entry_id": "fca5b15c-a7b2-3572-a36a-d8996c18bce9",
                                        "glosses": [
                                            "Habillement, parure."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03c195a4-19ce-4ac0-9b10-87f30815d1d4",
                                                "sense_id": "0cbd6f7e-8bc4-363f-8db1-d532fbe77a8b",
                                                "text": "Les soldats se font remarquer par des ajustements singuliers et farouches comme on en prêtait dans le moyen âge aux personnages antiques, orientaux ou juifs, dont on ne connaissait pas le costume."
                                            },
                                            {
                                                "example_id": "d727e7a1-d0da-4bfd-a9ca-208c1cd01c6e",
                                                "sense_id": "0cbd6f7e-8bc4-363f-8db1-d532fbe77a8b",
                                                "text": "À partir de ce moment, je regardai davantage les femmes, mais mon regard n’était plus chaste et, s’attachant sur elles, comme sur des images impures, il allait chercher le sexe et la nudité sous l’ajustement des robes."
                                            },
                                            {
                                                "example_id": "738ed8c3-98ff-448e-bb33-1df4c7c6d01e",
                                                "sense_id": "0cbd6f7e-8bc4-363f-8db1-d532fbe77a8b",
                                                "text": "Son chapeau, son manteau, sa robe, tous ses ajustements étaient d’une élégance délicate, intime, faite pour la joie d’un seul, pour la gaîté d’une maison solidement verrouillée, fermée aux quêteurs de proies impures…"
                                            },
                                            {
                                                "example_id": "7bfb1320-0d12-4989-b788-08a4b08a62e0",
                                                "sense_id": "0cbd6f7e-8bc4-363f-8db1-d532fbe77a8b",
                                                "text": "Les huit jours qui restaient furent employés en préparatifs. Il fallait qu’Anne pût paraître dignement devant ces juges sans indulgence que sont les Bordelaises élégantes. Elle y parvint, aidée sans doute par sa beauté, mais sans que la façon un peu antique de ses ajustements ait fait autre chose que d’ajouter à cette beauté un charme de plus, et non le moindre."
                                            },
                                            {
                                                "example_id": "8d8a1769-a597-424b-9c51-1605046da731",
                                                "sense_id": "0cbd6f7e-8bc4-363f-8db1-d532fbe77a8b",
                                                "text": "On s’accorde généralement à citer les caprices des modes, qui régentent les ajustements et les parures, comme les manifestations les plus caractéristiques organisées contre le bon sens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
