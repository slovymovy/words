    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8ce44fa9-a6f1-3564-97cf-b36c56f3143f",
                    "sense_definition": "A formal judgment or assessment of the value, quality, or nature of something or someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager scheduled a performance <w>appraisal</w> to discuss my progress over the last six months.",
                            "target_lang_translations": {
                                "ru": "Менеджер запланировал <w>аттестацию</w>, чтобы обсудить мои успехи за последние шесть месяцев."
                            }
                        },
                        {
                            "text": "After a careful <w>appraisal</w> of the situation, the committee decided to postpone the project indefinitely.",
                            "target_lang_translations": {
                                "ru": "После тщательной <w>оценки</w> ситуации комитет решил отложить проект на неопределенный срок."
                            }
                        }
                    ],
                    "synonyms": [
                        "assessment",
                        "evaluation",
                        "estimation",
                        "judgment"
                    ],
                    "common_phrases": [
                        "performance appraisal",
                        "critical appraisal",
                        "annual appraisal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальное суждение или анализ качества, ценности или характера кого-либо или чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оценка",
                                "target_lang_sense_clarification": "анализ или суждение"
                            },
                            {
                                "target_lang_word": "аттестация",
                                "target_lang_sense_clarification": "оценка квалификации или работы сотрудника"
                            },
                            {
                                "target_lang_word": "экспертиза",
                                "target_lang_sense_clarification": "профессиональный анализ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd28997b-0692-3cb6-8e3b-bafd02b64450",
                    "sense_definition": "The professional process of determining the financial value of an asset, such as property or jewelry.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "valuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank requires a professional property <w>appraisal</w> before they will approve the mortgage application.",
                            "target_lang_translations": {
                                "ru": "Банк требует профессиональную <w>оценку</w> недвижимости, прежде чем одобрить заявку на ипотеку."
                            }
                        },
                        {
                            "text": "She took the antique ring for an independent <w>appraisal</w> to find out its true market value.",
                            "target_lang_translations": {
                                "ru": "Она отнесла антикварное кольцо на независимую <w>экспертизу</w>, чтобы узнать его истинную рыночную стоимость."
                            }
                        }
                    ],
                    "synonyms": [
                        "valuation",
                        "estimation"
                    ],
                    "common_phrases": [
                        "property appraisal",
                        "independent appraisal",
                        "market appraisal"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in business or legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Профессиональный процесс определения финансовой стоимости актива, такого как недвижимость или ювелирные изделия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оценка",
