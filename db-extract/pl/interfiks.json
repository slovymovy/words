                "senses": [
                    {
                        "sense_id": "254a9e13-cbb0-3457-a11f-b925592cdd03",
                        "entry_id": "15dca818-a8b1-374d-b573-c756676ed9c7",
                        "glosses": [
                            "afiks występujący między dwoma wyrazami, międzyrostek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c09450b1-cda8-468d-9bd6-b42768ac2a9d",
                                "sense_id": "254a9e13-cbb0-3457-a11f-b925592cdd03",
                                "text": "W języku polskim w słowie „prostokąt” interfiksem jest „-o-”."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b233854-725e-4496-8913-1aa86dba7448",
                        "source_entry_id": "15dca818-a8b1-374d-b573-c756676ed9c7",
                        "source_sense_id": "254a9e13-cbb0-3457-a11f-b925592cdd03",
                        "target_lang_word": "interfix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interfix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bf9d5db-375e-3c40-a472-ca7ac4aae7e5",
                                        "entry_id": "a9cbe112-e85b-3491-a15c-4aad55471f08",
                                        "glosses": [
                                            "An empty morph inserted between two morphemes in the process of word formation, such as English -i- and -o-."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68d53974-e31f-42df-a803-6d65a18b9eda",
                                                "sense_id": "9bf9d5db-375e-3c40-a472-ca7ac4aae7e5",
                                                "text": "An empty morph is an interfix if it fulfills all of the following three conditions (Dressier, 1985f)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18e44981-34d1-3f56-a8d8-034d7e7b63d7",
                                        "entry_id": "a9cbe112-e85b-3491-a15c-4aad55471f08",
                                        "glosses": [
                                            "A transfix."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "136d88f7-3226-3182-a67a-299040a763c1",
                                        "entry_id": "a9cbe112-e85b-3491-a15c-4aad55471f08",
                                        "glosses": [
                                            "An association link."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fe28cdc-315e-448b-996b-197ae96ebcc0",
                                                "sense_id": "136d88f7-3226-3182-a67a-299040a763c1",
                                                "text": "LOCANT, n. A number used in the Dyson cipher system for coding the position of substituents of carbon chain, i.e. an interfix."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "interfix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2a956cc-9682-31da-a35f-c54f1c838a69",
                                        "entry_id": "71f33776-359d-381c-9578-68f284783e16",
                                        "glosses": [
                                            "To attach or anchor (two or more parts) together."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb979bd0-360e-4cb0-95a6-b535ced4f629",
                                                "sense_id": "f2a956cc-9682-31da-a35f-c54f1c838a69",
                                                "text": "Generally speaking the article is formed of two pieces which are interfixed for providing a pair of spring urged jaws..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c466a00c-7f52-3935-a661-0889c39ee284",
                                        "entry_id": "71f33776-359d-381c-9578-68f284783e16",
                                        "glosses": [
                                            "To insert (an interfix) between two morphemes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50b2e6fb-fa7b-4005-885c-c9d96f998a9a",
                                                "sense_id": "c466a00c-7f52-3935-a661-0889c39ee284",
                                                "text": "Our goal in the construction of this task was to isolate and highlight the relationship between the interfixed and free forms of the initial constituent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a5e437b-4016-4dce-9932-a97c48d47c6f",
                        "source_entry_id": "15dca818-a8b1-374d-b573-c756676ed9c7",
                        "source_sense_id": "254a9e13-cbb0-3457-a11f-b925592cdd03",
                        "target_lang_word": "interfijo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interfijo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "00bdbb64-16e2-3a59-8867-d08a0207e393",
                                        "entry_id": "9c0c4bcc-d7da-3597-8016-ef8ad06728f9",
                                        "glosses": [
                                            "Referido a un morfo o partícula del idioma: que se intercala al interior de una palabra con efectos fonéticos, sin afectar su significado."
                                        ],
                                        "tags": [
                                            "se emplea más como sustantivo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42228b9a-871f-4cf3-bbb7-0011aaa823a1",
                                                "sense_id": "00bdbb64-16e2-3a59-8867-d08a0207e393",
                                                "text": "Hay una -s- interfija en la palabra \"ensanchar\", pero no en \"enmarcar\": -s- es un interfijo que no aftecta el significado de \"ensanchar\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61a8f177-02cd-4203-8050-a30a03661615",
                        "source_entry_id": "15dca818-a8b1-374d-b573-c756676ed9c7",
                        "source_sense_id": "254a9e13-cbb0-3457-a11f-b925592cdd03",
                        "target_lang_word": "Interfix",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Interfix",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbbbe97b-54c0-3c0e-8245-285d65a1308f",
                                        "entry_id": "028798d4-628a-31a5-a496-b99a6e6e09d1",
                                        "glosses": [
                                            "Affix, also ein grammatisches Morphem, das zwischen zwei Morpheme eingeschoben wird"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2b4abb1-1d9f-467a-bd3b-eb5b4b4cf07c",
                                                "sense_id": "fbbbe97b-54c0-3c0e-8245-285d65a1308f",
                                                "text": "Der Begriff Interfix taucht in etlichen bekannten Fachwörterbüchern nicht auf; er wird auf Fugenelemente und ähnliche Erscheinungen angewendet, unter der Voraussetzung, dass sie keine Bedeutung tragen, was aber durchaus unter Fachleuten umstritten ist."
                                            },
                                            {
                                                "example_id": "d379eee4-35dd-40bc-a6d5-17c245d1d9d2",
                                                "sense_id": "fbbbe97b-54c0-3c0e-8245-285d65a1308f",
                                                "text": "„Aufgrund ihrer einheitlichen Funktion und der Tatsache, daß sie keine Bedeutung tragen, werden diese Elemente mit dem Begriff Interfix zusammengefaßt…“"
                                            },
                                            {
                                                "example_id": "7ee02204-0d06-4d38-ab69-f9273ad5f0d9",
                                                "sense_id": "fbbbe97b-54c0-3c0e-8245-285d65a1308f",
                                                "text": "„Das in /ɡəˈbuʀtstaːk/ - ‚geburtstag‘ auftretende /s/ wird dabei auch als Interfix bezeichnet, das zwischen den zusammengesetzten Bestandteilen steht.“"
                                            },
                                            {
                                                "example_id": "077448a6-e2ba-41e0-aed5-50fe1a6c39ae",
                                                "sense_id": "fbbbe97b-54c0-3c0e-8245-285d65a1308f",
                                                "text": "„Elemente wie das ‚-t-‘ in ‚öffentlich‘ können statt als Fugenelement auch als so genanntes Interfix oder als Bestandteil einer Suffixvariante (‚-tlich‘) interpretiert werden.“"
                                            },
                                            {
                                                "example_id": "f584be1d-18b2-44f3-8640-c973265419c0",
                                                "sense_id": "fbbbe97b-54c0-3c0e-8245-285d65a1308f",
                                                "text": "„Bevor ich mich weiter grammatikalisch mit den untrennbaren Verben beschäftige, habe ich das Bedürfnis, gesellschaftlich über den Begriff »Präfix« und dessen Geschwister Suffix, Zirkumfix, Interfix, Infix und Suprafix zu sprechen. Ihr Überbegriff heißt tatsächlich »Affix«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
