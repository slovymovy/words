                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2bdfa99d-51d5-3e6f-b55a-a3b23046610a",
                                        "entry_id": "5c8e20cc-80fc-36e6-bd4d-e8a71acf5730",
                                        "glosses": [
                                            "geschrieben seiend; in geschriebener Form"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d82077b2-b21e-422f-a5ba-0ef67fa2d2ca",
                                                "sense_id": "2bdfa99d-51d5-3e6f-b55a-a3b23046610a",
                                                "text": "„Der Parteirat hatte am Montag als Bedingung für die Zustimmung der Grünen im Bundestag die schriftliche Zusicherung verlangt, dass das Rentensystem reformiert und die Lohnnebenkosten gesenkt werden.“"
                                            },
                                            {
                                                "example_id": "5dc011ed-cc90-4bb5-ae70-915def4780cc",
                                                "sense_id": "2bdfa99d-51d5-3e6f-b55a-a3b23046610a",
                                                "text": "„Die Verwendung der Schrift und die schriftliche Fixierung sprachlicher Texte haben etwas mit Zivilisation zu tun.“"
                                            },
                                            {
                                                "example_id": "d0037767-b83a-442d-9071-aa41b5e0d359",
                                                "sense_id": "2bdfa99d-51d5-3e6f-b55a-a3b23046610a",
                                                "text": "„Warum fragt man immer nur besorgt, ob sich Jugendliche noch schriftlich ausdrücken können, warum bezieht man diese Frage nicht auch auf Erwachsene?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
