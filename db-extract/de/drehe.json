                ],
                "senses": [
                    {
                        "sense_id": "a365789d-f488-3cd1-97f4-10e8094b7eff",
                        "entry_id": "b182dbb2-f0d2-318a-a2af-0867a250ea50",
                        "glosses": [
                            "nähere Umgebung eines Ortes oder dergleichen"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "bad92731-d818-4cd5-ad39-15eec20bc33d",
                                "sense_id": "a365789d-f488-3cd1-97f4-10e8094b7eff",
                                "text": "„«Kannste mir wohl sagen, wo hier in der Drehe ein Junge wohnt, aus Berlin, so um die Sechzehn? Hier um die Drehe rum muss er wohnen …« »Hier um die Drehe rum wohnen noch viele Berliner!«, antwortet Kuno.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a59916f-c89e-4a69-a8f0-5b419371a043",
                        "source_entry_id": "b182dbb2-f0d2-318a-a2af-0867a250ea50",
                        "source_sense_id": "a365789d-f488-3cd1-97f4-10e8094b7eff",
                        "source_sense_description": "nähere Umgebung eines Ortes oder dergleichen",
                        "target_lang_word": "alentours",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alentours",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9c33f45-50c5-37d0-813b-eb502466485d",
                                        "entry_id": "adb24b9b-35fb-3e24-9bf6-8bb787eb896d",
                                        "glosses": [
                                            "Lieux circonvoisins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4908685-ce8f-4e6e-a010-7b564be15966",
                                                "sense_id": "b9c33f45-50c5-37d0-813b-eb502466485d",
                                                "text": "De qui voulez-vous parler ? car il n’y a ni ours ni loups dans ces alentours, dit le chevalier."
                                            },
                                            {
                                                "example_id": "ccd2ea31-0989-475d-a8a0-2552a4b99a8c",
                                                "sense_id": "b9c33f45-50c5-37d0-813b-eb502466485d",
                                                "text": "En Charente-Maritime, deux spécialités locales subliment ce coquillage : la mouclade, avec une sauce au vin blanc, du pineau, du persil, de l’ail et, selon les recettes, du curry et du jaune d’œuf ; et l’éclade - ou églade -, où les moules sont disposées en spirale sur une planche en bois avant d’être recouvertes d’aiguilles de pin auxquelles on met le feu, ce qui donne un goût fumé à ce plat typique de l’île d’Oléron et des alentours de Royan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "854b378c-2648-3202-a25d-729e5d8affb6",
                                        "entry_id": "adb24b9b-35fb-3e24-9bf6-8bb787eb896d",
                                        "glosses": [
                                            "Entourage."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79800592-4935-40fe-bf65-34fb22676032",
                                                "sense_id": "854b378c-2648-3202-a25d-729e5d8affb6",
                                                "text": "Si vous voulez réussir auprès de ce ministre, assurez-vous de ses alentours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "426cd626-c13a-329f-9a97-103bba186acf",
                                        "entry_id": "adb24b9b-35fb-3e24-9bf6-8bb787eb896d",
                                        "glosses": [
                                            "Ce qui entoure une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e5a5e07-418b-4afa-9afa-11c5a0f288b5",
                                                "sense_id": "426cd626-c13a-329f-9a97-103bba186acf",
                                                "text": "Aux alentours et dans les lointains invisibles, les tintements joyeux des clochettes argentines et les bourdons graves des sonneaux indiquaient à Mimile que les autres petits bergers, ainsi que les bergères de son âge rapatriaient comme lui vers l’abreuvoir et vers l’étable leurs troupeaux repus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "alentours",
                                "target_lang_code": "fr",
                                "target_senses": [
