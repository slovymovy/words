                    "target_lang_definitions": {
                        "ru": "Изогнутый под углом кусок дерева или металла, используемый для опоры частей корабля или здания.",
                        "zh": "一种弯成角度的木质或金属构件，用来支撑船只或建筑的部件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кница",
                                "target_lang_sense_clarification": "в судостроении"
                            },
                            {
                                "target_lang_word": "колено",
                                "target_lang_sense_clarification": "в строительстве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肘板",
                                "target_lang_sense_clarification": "造船、建筑中作支撑的弯曲构件"
                            },
                            {
                                "target_lang_word": "角撑",
                                "target_lang_sense_clarification": "框架角部的支撑件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6e0ec91-420c-34f4-a193-a84200377f93",
                    "sense_definition": "An act of kneeling to show respect or courtesy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loyal subject made a <w>knee</w> before the queen as she entered the room.",
                            "target_lang_translations": {
                                "ru": "Верный подданный преклонил <w>колено</w> перед королевой, когда она вошла в комнату.",
