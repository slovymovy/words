                "senses": [
                    {
                        "sense_id": "b732bc1f-1eca-3653-9d09-5c8ec0327fbd",
                        "entry_id": "2dd2e9bd-9224-3145-8916-b0b9475db619",
                        "glosses": [
                            "altgriechischer Gerichtshof"
                        ],
                        "tags": [
                            "Antike"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "41f5f257-390f-3d4c-985c-62fe32ca64dd",
                        "entry_id": "2dd2e9bd-9224-3145-8916-b0b9475db619",
                        "glosses": [
                            "ein vom Staat autorisiertes Kollegium von Rechtskundigen, das nicht eine Gerichtsbarkeit über einen bestimmten Bezirk ausübt, sondern im Auftrag und auf Ersuchen anderer Gerichte oder auch von Privatpersonen rechtliche Entscheidungen fällt"
                        ],
                        "tags": [
                            "Mittelalter"
                        ],
                        "examples": [
                            {
                                "example_id": "e3e8eb59-8b92-4a13-b737-49c665bcdb12",
                                "sense_id": "41f5f257-390f-3d4c-985c-62fe32ca64dd",
                                "text": "In Deutschland haben im Mittelalter viele juristische Fakultäten als „Dikasterium“ fungiert."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "de48d728-097e-3a23-b39f-016943059661",
                        "entry_id": "2dd2e9bd-9224-3145-8916-b0b9475db619",
                        "glosses": [
                            "jede höhere Ortsbehörde"
                        ],
                        "tags": [
                            "Mittelalter",
                            "frühe Neuzeit"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "6554ee14-fde3-3443-92c7-ad219d1f2055",
                        "entry_id": "2dd2e9bd-9224-3145-8916-b0b9475db619",
                        "glosses": [
                            "eine Behörde der römischen Kurie"
                        ],
                        "tags": [
                            "Katholische Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "3481735d-a30d-457d-bc49-53b0223acf4a",
                                "sense_id": "6554ee14-fde3-3443-92c7-ad219d1f2055",
                                "text": "„Die Römische Kurie besteht aus den Behörden (Dikasterien) des Staatsekretariats, der Kongregationen, der Gerichte, der Räte und Ämter.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a8a7486-e83c-413d-9878-67e41df1880f",
                        "source_entry_id": "2dd2e9bd-9224-3145-8916-b0b9475db619",
                        "source_sense_id": "b732bc1f-1eca-3653-9d09-5c8ec0327fbd",
                        "source_sense_description": "Antike: altgriechischer Gerichtshof",
                        "target_lang_word": "dicastery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dicastery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62272229-291f-3d0b-b156-d1ce68d8b36b",
                                        "entry_id": "9d8ced04-160c-39b6-9924-8f5ca415a6b2",
                                        "glosses": [
                                            "A ministry or department of the Roman Curia of the Holy See, whether administrative or ecclesiastical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11c10702-00a0-4463-a0da-1a43e0e2b301",
                                                "sense_id": "62272229-291f-3d0b-b156-d1ce68d8b36b",
                                                "text": "The dicastery will continue to oversee the appointment of bishops in the mission territories. … There is no longer a distinction between congregations and pontifical councils because all the Vatican’s main departments are now defined as dicasteries."
                                            },
                                            {
                                                "example_id": "4e33ea94-407f-4350-aeec-8403533b4591",
                                                "sense_id": "62272229-291f-3d0b-b156-d1ce68d8b36b",
                                                "text": "The Argentine pontiff summoned him to Rome in 2023 to head the powerful dicastery for bishop appointments—a job that allowed him to build networks across the Catholic leadership."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1e3e41d-fb3c-3d74-a7b6-4aeb11b7edf2",
                                        "entry_id": "9d8ced04-160c-39b6-9924-8f5ca415a6b2",
                                        "glosses": [
                                            "A judicial body of the ancient Athenian state, made up of dicasts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0762664-5fef-4a48-9d3d-0947e323d2a8",
                                                "sense_id": "a1e3e41d-fb3c-3d74-a7b6-4aeb11b7edf2",
                                                "text": "The better cause has conquered; and there is at least this advantage to the Athenian legal system, there will be no appeal nor tedious technicalities before a \"higher court.\" The verdict of the dicastery is final."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
