                        "glosses": [
                            "Qualifie un herbicide ou toute technique de désherbage qui vise à la destruction des dicotylédones adventices."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "0096fdfe-7484-493a-9ea7-61ea48ca7f7c",
                                "sense_id": "9e1e5698-5c8c-3dff-ac3b-47e0bd0c2286",
                                "text": "Sur le plan anti-dicotylédone, BASF met sur la marché le picolinafen. Cette matière active est associée à la pendiméthaline constituant ainsi un herbicide à large spectre antidicotylédone, doté d'effets secondaires sur graminées."
                            }
                        ]
                    }
