                        "source_sense_id": "9ac8c7f8-8cf0-39d0-b9f2-fc45ca776e26",
                        "source_sense_description": "Religion, Politik, speziell Islamismus: sich auf die Taliban beziehend; Taliban-",
                        "target_lang_word": "Talib",
