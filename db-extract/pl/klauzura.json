                    {
                        "translation_id": "c32f80b0-7025-4e5b-9bd5-8c52b32f5820",
                        "source_entry_id": "f2041b79-ba95-375f-8125-1e3b2b86d3df",
                        "source_sense_id": "6061e2d2-a5c7-3c41-a68f-162f027c3f43",
                        "target_lang_word": "Klausur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klausur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cad5808b-3080-39be-913c-6a55d952508f",
                                        "entry_id": "44626e82-b55f-3c88-bdf0-b2c1c1a4cad3",
                                        "glosses": [
                                            "Einsamkeit, Abgeschlossenheit"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a31faa7-b685-4398-bcc0-2842b0bf6149",
                                                "sense_id": "cad5808b-3080-39be-913c-6a55d952508f",
                                                "text": "„Sie hatten, analog zu diesem, eine eigene Generaloberin, die ebenfalls nur dem Papst Gehorsam schuldete, und lebten, wie die Mitglieder des Jesuitenordens, nicht in Klausur.“"
                                            },
                                            {
                                                "example_id": "0b437e00-74b9-41b4-ac89-4ff3c9ec38f0",
                                                "sense_id": "cad5808b-3080-39be-913c-6a55d952508f",
                                                "text": "„Ich wunderte mich sehr über die große Freiheit dieser gottgeweihten Jungfrauen, die ihre Klausur so unschwer verletzen konnten.“"
                                            },
                                            {
                                                "example_id": "88ae9e31-7611-4bb6-b4df-1b1a87d18d3b",
                                                "sense_id": "cad5808b-3080-39be-913c-6a55d952508f",
                                                "text": "„Während der unfreiwilligen Klausur vervollständigten sie ihr Mobiliar, zimmerten Tische und Stühle, die zwar nicht sehr graziös, dafür aber stabil ausfielen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56ad5249-570b-3c1d-b90a-4914a253e7cb",
                                        "entry_id": "44626e82-b55f-3c88-bdf0-b2c1c1a4cad3",
                                        "glosses": [
                                            "abgeschlossener Bereich in einem Kloster, der von Außenstehenden nicht betreten werden darf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7db5b81-845a-4346-956f-3bc6ce759ecf",
                                                "sense_id": "56ad5249-570b-3c1d-b90a-4914a253e7cb",
                                                "text": "„Der Jesuit ließ sich sogar das Essen vor die Klausur bringen; […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0ae42746-bb35-35bd-92da-3f214281816e",
                                        "entry_id": "44626e82-b55f-3c88-bdf0-b2c1c1a4cad3",
                                        "glosses": [
                                            "Prüfungsarbeit, die unter Aufsicht geschrieben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b01dc945-4af9-4580-bf11-2803d586e2c4",
                                                "sense_id": "0ae42746-bb35-35bd-92da-3f214281816e",
                                                "text": "Da Bettina das Studium viel Freude bereitete und ihr das Lernen der Inhalte dementsprechend leicht fiel, bestand sie im fünften Semester alle Klausuren."
                                            },
                                            {
                                                "example_id": "58c3a558-42e6-4d69-aab4-da1478e030f4",
                                                "sense_id": "0ae42746-bb35-35bd-92da-3f214281816e",
                                                "text": "„Aus der Entfernung wirken sie wie Schulkameraden, die vielleicht eine Klausur besprechen.“"
                                            },
                                            {
                                                "example_id": "86363f28-ab03-4d8a-9cbb-f3e76cbd991b",
                                                "sense_id": "0ae42746-bb35-35bd-92da-3f214281816e",
                                                "text": "„Dafür muß er sie bei den Klausuren abschreiben lassen.“"
                                            },
                                            {
                                                "example_id": "8e024c0b-c462-4518-8186-4ce574ec0990",
                                                "sense_id": "0ae42746-bb35-35bd-92da-3f214281816e",
                                                "text": "„Er hielt es für unnütz, mit anderen zusammen zu lernen, wenn jeder am Ende die beste Klausur brauchte, um weiterzukommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e8eb30e8-ef1c-33c3-a985-1f8cd50da91c",
                                        "entry_id": "44626e82-b55f-3c88-bdf0-b2c1c1a4cad3",
                                        "glosses": [
                                            "Tagung unter Ausschluss der Öffentlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d67f2dbf-fb0a-45e5-be19-b125e9527915",
                                                "sense_id": "e8eb30e8-ef1c-33c3-a985-1f8cd50da91c",
                                                "text": "Auf der anstehenden Klausur soll die Neuausrichtung der Partei eingeleitet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
