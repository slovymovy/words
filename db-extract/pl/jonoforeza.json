                        "glosses": [
                            "ruch jonów w cieczy pod wpływem pola elektrycznego"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "89b059e3-04b2-372e-86fe-64ac9d9819ca",
                        "entry_id": "8fddd9b2-3e74-32a2-a65c-bb0261b700f6",
                        "glosses": [
                            "zabieg leczniczy lub kosmetyczny polegający na wprowadzeniu jonów zdysocjowanego leku do organizmu za pomocą prądu stałego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90856a77-ada3-4f41-ab15-f94b3fee7c61",
                                "sense_id": "89b059e3-04b2-372e-86fe-64ac9d9819ca",
                                "text": "Jonoforeza to metoda fizjoterapii polegająca na wprowadzaniu leków do ciała człowieka poprzez jego skórę lub śluzówkę"
                            },
                            {
                                "example_id": "aa92556c-8be5-4a32-8818-3054f321a67c",
                                "sense_id": "89b059e3-04b2-372e-86fe-64ac9d9819ca",
                                "text": "Lista stosowanych środków leczniczych w jonoforezie jest co prawda ograniczona, gdyż nie wszystkie środki ulegają dysocjacji elektrolitycznej, ale w wielu przypadkach jest to metoda bardzo skuteczna"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
