                    {
                        "form_id": "7ecd8ac8-4d0e-4c82-8cfa-829aac8890a7",
                        "entry_id": "849034eb-3e3f-3cd6-a1b3-a909630d94ed",
                        "tags": [
                            "plural"
                        ],
                        "form": "ratons"
                    },
                    {
                        "form_id": "b085c295-89aa-4af8-a669-a9062f491406",
                        "entry_id": "849034eb-3e3f-3cd6-a1b3-a909630d94ed",
                        "tags": [
                            "feminine"
                        ],
                        "form": "ratonne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ec39540e-2ac1-31a7-9a4b-9a22c3b1293e",
                        "entry_id": "849034eb-3e3f-3cd6-a1b3-a909630d94ed",
                        "glosses": [
                            "Petit du rat."
                        ],
                        "tags": [
                            "Glirologie"
                        ],
                        "examples": [
                            {
                                "example_id": "5a33b8b4-cba1-42c8-8d4e-2a80cde7e69e",
                                "sense_id": "ec39540e-2ac1-31a7-9a4b-9a22c3b1293e",
                                "text": "Mais dépita chats, chattes, et chatons,\nEt prisa fort rats, rates, et ratons"
                            },
                            {
                                "example_id": "030e42db-b003-41af-8787-3dbb41a53cf5",
                                "sense_id": "ec39540e-2ac1-31a7-9a4b-9a22c3b1293e",
                                "text": "Un rat disait à son petit raton qui n’avait point d’expérience, et n’avait pas plus de prudence, qu’un écolier n’a de raison : fuyez, fuyez la souricière ; cette machine est meurtrière."
                            }
                        ]
                    },
                    {
                        "sense_id": "cef5e6ec-f1fd-3eef-963c-e434cc9d6add",
                        "entry_id": "849034eb-3e3f-3cd6-a1b3-a909630d94ed",
                        "glosses": [
                            "Mammifère omnivore originaire d’Amérique — raton laveur (Procyon lotor)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d146c35c-5220-4a91-af9a-e5177d6424e1",
                                "sense_id": "cef5e6ec-f1fd-3eef-963c-e434cc9d6add",
                                "text": "Le raton, dit le naturaliste à qui nous avons emprunté la description qu’on vient de lire, est un animal très intelligent et du nombre de ceux qu on peut prendre plaisir à apprivoiser ; il fait mille singeries, joue avec son maître, grimpe sur lui et visite ses poches pour voir s’il n’y trouvera pas quelque friandise. […]. À l’état de liberté, il furète souvent pour chercher le nid de la gélinotte ou de la perdrix et il sait fort bien dans quelles sortes de lieux on peut espérer d’en trouver."
                            }
                        ]
                    },
                    {
                        "sense_id": "122f2d16-5efb-3fa4-a490-bdfb343e66b3",
                        "entry_id": "849034eb-3e3f-3cd6-a1b3-a909630d94ed",
                        "glosses": [
                            "Arabe ou Maghrébin."
                        ],
                        "tags": [
                            "offensive",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "9f910d31-e078-4f81-92b2-4aeccaa30cb0",
                                "sense_id": "122f2d16-5efb-3fa4-a490-bdfb343e66b3",
                                "text": "Quel bavardage : liberté, égalité, fraternité, amour, honneur, patrie, que sais-je ? Cela ne nous empêchait pas de tenir en même temps des discours racistes, sale nègre, sale juif, sale raton."
                            },
                            {
                                "example_id": "9ad0fc53-6b9b-40a9-a5b2-aa124ccf67c5",
                                "sense_id": "122f2d16-5efb-3fa4-a490-bdfb343e66b3",
                                "text": "— Oui, mais un homme qui regardait riait et m’a dit « bien fait pour toi, sale raton, tu ne seras jamais un pescalune ! », je les déteste tous et un jour ils le paieront."
                            },
                            {
                                "example_id": "813097cf-2923-48c8-8140-43055dbdbd84",
                                "sense_id": "122f2d16-5efb-3fa4-a490-bdfb343e66b3",
                                "text": "– Ben ça y est, mon vieux, c’est parti ! Ces sales ratons ont déclenché l’avalanche, et elle va leur retomber sur le coin de la gueule, tu peux me croire… On va enfin pouvoir s’amuser !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1da398d-2983-4078-bbf1-ef54603f428f",
                        "source_entry_id": "849034eb-3e3f-3cd6-a1b3-a909630d94ed",
                        "source_sense_id": "ec39540e-2ac1-31a7-9a4b-9a22c3b1293e",
                        "source_sense_description": "Petit rat",
                        "target_lang_word": "kitten",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kitten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d229322-93f5-3eda-b75b-22f327546dee",
                                        "entry_id": "d3d33ee2-fae4-35b9-b752-eba0d1fff15d",
                                        "glosses": [
                                            "A young cat, especially before sexual maturity (reached at about seven months)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "782afc1b-1675-4ffb-8c30-11176971dde3",
                                                "sense_id": "9d229322-93f5-3eda-b75b-22f327546dee",
                                                "text": "It was supposed to have happened thus: the cat had young kittens, and frequently carried them mice, and other animals its prey, and among the rest a young rat: the kittens, not being hungry, played with it, and when the cat came to give suck to the kittens, the rat likewise sucked her."
                                            },
                                            {
                                                "example_id": "718f44e7-4baf-4f27-a088-8fd01736068c",
                                                "sense_id": "9d229322-93f5-3eda-b75b-22f327546dee",
                                                "text": "To the sounds, however, I paid no attention at first as I was much interested in the subject upon which I was writing; but at length my som Richard burst into my study, exclaiming that the kitten had climbed up to the top of a young ash tree, and could not get down again."
                                            },
                                            {
                                                "example_id": "6a9bad29-435f-4fce-a4e6-b3061bc21238",
                                                "sense_id": "9d229322-93f5-3eda-b75b-22f327546dee",
                                                "text": "Jailing her on Wednesday, magistrate Liz Clyne told Robins: \"You have shown little remorse either for the death of the kitten or the trauma to your former friend Sarah Knutton.\" She was also banned from keeping animals for 10 years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a86edb1-f3d4-30f1-a2c2-b37595c0cc11",
                                        "entry_id": "d3d33ee2-fae4-35b9-b752-eba0d1fff15d",
                                        "glosses": [
                                            "A young rabbit, rat, hedgehog, squirrel, fox, beaver, badger, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b08de13-35cf-4fb5-8e74-4e8a849e2965",
                                                "sense_id": "0a86edb1-f3d4-30f1-a2c2-b37595c0cc11",
                                                "text": "The first move at beaver raising in North Dakota had its starting in the fall of 1874, when a kitten beaver was taken out of Mandan Lake by the writer and given to a little Indian girl who then lived with her guardians at Pretty Point near the present village of Sanger, Oliver county."
                                            },
                                            {
                                                "example_id": "68fd4c8e-9941-4cbb-971e-4ca402c26573",
                                                "sense_id": "0a86edb1-f3d4-30f1-a2c2-b37595c0cc11",
                                                "text": "2009, Kathryn Walker, See How Rabbits Grow, publ. by PowerKiDS press (The Rosen Publishing Group Inc.), page 10.\nRabbit babies are called kittens or kits. The mother prepares a cosy nest for her kittens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0937829b-d9eb-3871-ba3d-ba12f6dc396b",
                                        "entry_id": "d3d33ee2-fae4-35b9-b752-eba0d1fff15d",
                                        "glosses": [
                                            "A moth of the genus Furcula."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cd42439-d37e-4e85-ab79-12c9564f8915",
                                                "sense_id": "0937829b-d9eb-3871-ba3d-ba12f6dc396b",
                                                "text": "Two of these formed cocoons in a manner I have not seen before. They were supplied when full-grown with plenty of rotten willow wood, which I have always found a most suitable material for insects using bark or old wood in forming cocoons such as the kittens, Apatele alni, etc., and most made the usual cycle of cocoons on it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76e1c2f2-ba10-36eb-abaf-baa93773f5e9",
                                        "entry_id": "d3d33ee2-fae4-35b9-b752-eba0d1fff15d",
                                        "glosses": [
                                            "A term of endearment, especially for a woman."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "139dc8d1-73f8-4da7-9413-67d6df59c0fd",
                                                "sense_id": "76e1c2f2-ba10-36eb-abaf-baa93773f5e9",
                                                "text": "Speak only when spoken to, kitten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5694c7f2-1cb2-3197-9388-b2030de8f1a6",
                                        "entry_id": "d3d33ee2-fae4-35b9-b752-eba0d1fff15d",
                                        "glosses": [
                                            "A term of endearment, especially for a woman.",
                                            "A girlfriend."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "kitten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7d07857-a46d-3647-ab5f-201bb160fe66",
                                        "entry_id": "c3bead85-743a-3876-8060-6a671ac9cd5e",
                                        "glosses": [
                                            "To give birth to kittens."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09ec3233-21ef-4dad-a981-d7feb7d80543",
                                                "sense_id": "a7d07857-a46d-3647-ab5f-201bb160fe66",
                                                "text": "A cat about to kitten, must not be spoken of by its name, but called a witch. (Madagascar.)"
                                            },
                                            {
                                                "example_id": "0fe4d9f8-f6cb-4a01-9727-1a0504d6ccae",
                                                "sense_id": "a7d07857-a46d-3647-ab5f-201bb160fe66",
                                                "text": "'Princess the Lady Regina of Alphington is about to kitten. I must be there to support her.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
