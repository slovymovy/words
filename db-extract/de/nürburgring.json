                "senses": [
                    {
                        "sense_id": "45a2f636-5ea4-3caf-b3f1-23f7a638d09b",
                        "entry_id": "00bc4308-8ad8-37d9-9ae1-3574eb21fb48",
                        "glosses": [
                            "Automobil- und Motorradrennstrecke in der Eifel im rheinlandpfälzischen Landkreis Ahrweiler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04224b84-1ad3-4dbb-bb98-4ad73759a696",
                                "sense_id": "45a2f636-5ea4-3caf-b3f1-23f7a638d09b",
                                "text": "Als Namensgeber für den Nürburgring diente die Burgruine Nürburg bzw. die gleichnamige Ortschaft in der Eifel."
                            },
                            {
                                "example_id": "cb61222d-8c80-49e1-9618-05142b24b400",
                                "sense_id": "45a2f636-5ea4-3caf-b3f1-23f7a638d09b",
                                "text": "„1988 riss man nach Testfahrten am Nürburgring noch einmal die bereits fertige Chassis-Konstruktion auf, um dem Feistling die fahrdynamischen Werte des Bayern anzuerziehen.“"
                            },
                            {
                                "example_id": "c9863e6c-5dad-446e-b78d-fec07fe32b62",
                                "sense_id": "45a2f636-5ea4-3caf-b3f1-23f7a638d09b",
                                "text": "„Wer selbst nie versucht hat, auf dem Nürburgring wirklich schnell zu fahren, der kann es sich am ehesten vorstellen wie den Versuch, mit einem Düsenjäger eine Achterbahn abzufliegen: Die Eindrücke rasen so schnell heran, dass kaum Zeit zum Denken bleibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
