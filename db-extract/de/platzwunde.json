                ],
                "senses": [
                    {
                        "sense_id": "457c9047-9fbd-392d-8cfe-6a8d18d32417",
                        "entry_id": "a45ca8eb-5e85-34a1-8c1b-0f425b7d6c7f",
                        "glosses": [
                            "offene Verletzung der Haut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed5208d4-8ad8-4d38-a91b-2c5ab9f77060",
                                "sense_id": "457c9047-9fbd-392d-8cfe-6a8d18d32417",
                                "text": "Er zog sich bei einem Zusammenprall mit einem Mitspieler eine Platzwunde zu."
                            },
                            {
                                "example_id": "1c34d0ec-4cc7-4f58-9935-5dff6e5c72b7",
                                "sense_id": "457c9047-9fbd-392d-8cfe-6a8d18d32417",
                                "text": "„Mein liebster Freund kam mit seiner Frau und ihren beiden Töchtern und fünf Minuten, nachdem sie angekommen waren, stürzte seine Frau aus der Hängematte, überschlug sich und hatte eine klaffende Platzwunde am Hinterkopf.“"
                            },
                            {
                                "example_id": "2c7f09e1-a9a0-4a54-a3d2-3c1bce74c324",
                                "sense_id": "457c9047-9fbd-392d-8cfe-6a8d18d32417",
                                "text": "„Monsieur Morin erzählt mir, er habe damit innerhalb von drei Minuten eine Platzwunde an der Stirn eines jungen Mannes zum Verschwinden gebracht; eine abprallende Kugel hätte diesen so getroffen, daß man glaubte, der Knochen sei gebrochen.“"
                            },
                            {
                                "example_id": "6c0acce8-c0e5-4345-923c-b7daad0c1ddf",
                                "sense_id": "457c9047-9fbd-392d-8cfe-6a8d18d32417",
                                "text": "„Adrienne hielt sich bisweilen die Hand vor die Augen, wenn Blut aus Nasen oder Platzwunden quoll, spähte dann aber zwischen ihren Fingern hindurch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
