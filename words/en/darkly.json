{
    "word_family": [
        "dark",
        "darken",
        "darkness",
        "darkish"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c93e4e71-d329-3be3-aa41-f435e34fd30a",
                    "sense_definition": "With insufficient light for easy discernment or comprehension.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I could only see his silhouette <w>darkly</w> against the evening sky.",
                            "target_lang_translations": {
                                "ru": "Я мог видеть лишь его силуэт, <w>неясно</w> вырисовывающийся на фоне вечернего неба."
                            }
                        },
                        {
                            "text": "The figure moved <w>darkly</w> through the shadows of the hallway.",
                            "target_lang_translations": {
                                "ru": "Фигура <w>незаметно</w> проскользнула сквозь тени в коридоре."
                            }
                        }
                    ],
                    "synonyms": [
                        "obscurely"
                    ],
                    "target_lang_definitions": {
                        "ru": "В условиях недостаточного освещения, затрудняющего восприятие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неясно",
                                "target_lang_sense_clarification": "очертания или формы, которые трудно различить из-за плохого света"
                            },
                            {
                                "target_lang_word": "темно",
                                "target_lang_sense_clarification": "описывает визуальное состояние при отсутствии достаточного света"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e0a099d-5be2-32c5-8bd0-ab833f086bf8",
                    "sense_definition": "With a dark appearance or color.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The walls were painted <w>darkly</w> to create a cozy atmosphere.",
                            "target_lang_translations": {
                                "ru": "Стены были выкрашены в <w>мрачные</w> тона, чтобы создать уютную атмосферу."
                            }
                        },
                        {
                            "text": "The metal was <w>darkly</w> stained after years of exposure to the elements.",
                            "target_lang_translations": {
                                "ru": "Металл <w>сильно</w> потемнел после многих лет воздействия стихии."
                            }
                        }
                    ],
                    "synonyms": [
                        "blackly",
                        "sably"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий темный вид или цвет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мрачно",
                                "target_lang_sense_clarification": "о темных, приглушенных тонах в интерьере или цвете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcee74a4-50aa-325c-9138-8ee211423f06",
                    "sense_definition": "In a manner which is not readily visible or noticeable; inconspicuously.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "secrecy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>darkly</w> slipped out of the room before anyone noticed him.",
                            "target_lang_translations": {
                                "ru": "Он <w>украдкой</w> выскользнул из комнаты, прежде чем кто-либо заметил его."
                            }
                        },
                        {
                            "text": "The spy moved <w>darkly</w> through the crowd to avoid detection.",
                            "target_lang_translations": {
                                "ru": "Шпион <w>скрытно</w> пробирался сквозь толпу, чтобы избежать обнаружения."
                            }
                        }
                    ],
                    "synonyms": [
                        "inconspicuously",
                        "unnoticeably",
                        "covertly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрытно, незаметно, не привлекая внимания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незаметно",
                                "target_lang_sense_clarification": "действуя так, чтобы не быть увиденным"
                            },
                            {
                                "target_lang_word": "скрытно",
                                "target_lang_sense_clarification": "действуя тайно, избегая обнаружения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0057759e-43e2-3ec0-89c2-e4ceeb34e669",
                    "sense_definition": "In a manner which retards or prevents discernment; clandestinely.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "secrecy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>darkly</w> plotted against the king in the basement.",
                            "target_lang_translations": {
                                "ru": "Они <w>тайком</w> плели заговор против короля в подвале."
                            }
                        },
                        {
                            "text": "The conspirators <w>darkly</w> exchanged information in the alleyway.",
                            "target_lang_translations": {
                                "ru": "Заговорщики <w>секретно</w> обменивались информацией в переулке."
                            }
                        }
                    ],
                    "synonyms": [
                        "secretly",
                        "furtively",
                        "stealthily",
                        "surreptitiously"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тайным, закулисным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тайком",
                                "target_lang_sense_clarification": "совершая действия втайне от других"
                            },
                            {
                                "target_lang_word": "украдкой",
                                "target_lang_sense_clarification": "делая что-то тайно, опасаясь быть замеченным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b6cee52-e7ae-38c8-af77-82e55d3816a2",
                    "sense_definition": "In a manner which is difficult to understand, or which retards or prevents understanding.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient prophecy was <w>darkly</w> worded and hard to interpret.",
                            "target_lang_translations": {
                                "ru": "Древнее пророчество было <w>туманно</w> сформулировано, и его было трудно истолковать."
                            }
                        },
                        {
                            "text": "He spoke <w>darkly</w> about his past, leaving us with many questions.",
                            "target_lang_translations": {
                                "ru": "Он <w>загадочно</w> говорил о своем прошлом, оставляя у нас много вопросов."
                            }
                        }
                    ],
                    "synonyms": [
                        "mysteriously",
                        "inscrutably",
                        "vaguely"
                    ],
                    "target_lang_definitions": {
                        "ru": "В манере, которую трудно понять или которая препятствует пониманию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "туманно",
                                "target_lang_sense_clarification": "о неясных, расплывчатых высказываниях"
                            },
                            {
                                "target_lang_word": "загадочно",
                                "target_lang_sense_clarification": "о словах, содержащих тайну или намек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "973faae9-85a1-302c-966d-9cc2111abb51",
                    "sense_definition": "In a manner which tends to produce uncertainty or confusion; bewilderingly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The instructions were <w>darkly</w> written, causing much confusion among the students.",
                            "target_lang_translations": {
                                "ru": "Инструкции были написаны <w>запутанно</w>, что вызвало большое замешательство среди студентов."
                            }
                        },
                        {
                            "text": "He <w>darkly</w> hinted at a secret that left everyone feeling puzzled.",
                            "target_lang_translations": {
                                "ru": "Он <w>непонятно</w> намекнул на секрет, который оставил всех в недоумении."
                            }
                        }
                    ],
                    "synonyms": [
                        "bafflingly",
                        "perplexingly",
                        "puzzlingly"
                    ],
                    "target_lang_definitions": {
                        "ru": "В манере, вызывающей недоумение или замешательство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непонятно",
                                "target_lang_sense_clarification": "о чем-то, что вызывает затруднения при попытке осмыслить"
                            },
                            {
                                "target_lang_word": "запутанно",
                                "target_lang_sense_clarification": "о чем-то, что сбивает с толку из-за сложности изложения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eabc4039-d377-305a-9fec-3761f358dafa",
                    "sense_definition": "In a manner which produces an inward conviction of future misfortune; ominously.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clouds gathered <w>darkly</w> over the valley, signaling a coming storm.",
                            "target_lang_translations": {
                                "ru": "Тучи <w>зловеще</w> сгустились над долиной, предвещая приближение бури."
                            }
                        },
                        {
                            "text": "He looked <w>darkly</w> at the horizon, sensing that trouble was ahead.",
                            "target_lang_translations": {
                                "ru": "Он <w>мрачно</w> смотрел на горизонт, чувствуя, что впереди неприятности."
                            }
                        }
                    ],
                    "synonyms": [
                        "forebodingly",
                        "threateningly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зловеще, предвещая неприятности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зловеще",
                                "target_lang_sense_clarification": "о чем-то, что внушает тревогу или предчувствие беды"
                            },
                            {
                                "target_lang_word": "мрачно",
                                "target_lang_sense_clarification": "о выражении лица или атмосфере, предвещающей плохое"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e172b458-5211-37e7-bcb1-47842f928204",
                    "sense_definition": "In a morbid or sinister manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The film is a <w>darkly</w> comic look at modern life.",
                            "target_lang_translations": {
                                "ru": "Этот фильм — <w>мрачно-комический</w> взгляд на современную жизнь."
                            }
                        },
                        {
                            "text": "He laughed <w>darkly</w> when he heard the bad news.",
                            "target_lang_translations": {
                                "ru": "Он <w>злобно</w> рассмеялся, когда услышал плохие новости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "darkly comic"
                    ],
                    "target_lang_definitions": {
                        "ru": "В болезненной, мрачной или зловещей манере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мрачно",
                                "target_lang_sense_clarification": "о выражении пессимизма или тяжелого настроения"
                            },
                            {
                                "target_lang_word": "злобно",
                                "target_lang_sense_clarification": "о проявлении недоброжелательности или сарказма"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}