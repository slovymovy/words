                    {
                        "translation_id": "080fb092-4058-46aa-8916-d1ed545d1f5a",
                        "source_entry_id": "7a95c7be-ee17-3197-a0eb-834a2b97083e",
                        "target_lang_word": "en toutes lettres",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en toutes lettres",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2f218cc-bb11-3fcc-b74c-1d058647a5d7",
                                        "entry_id": "c6e0b662-fb98-31f4-aab2-e381b86a28b4",
                                        "glosses": [
                                            "En parlant des nombres, notamment des montants, se dit lorsqu’on les écrit avec des mots plutôt qu’avec des chiffres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6de6d9b-4972-4e66-80bd-d678c1f42b4f",
                                                "sense_id": "d2f218cc-bb11-3fcc-b74c-1d058647a5d7",
                                                "text": "Le nombre 588 s’écrit en toutes lettres : cinq-cent-quatre-vingt-huit."
                                            },
                                            {
                                                "example_id": "a3c4f06d-59af-46cb-a5bc-b32d31a664b0",
                                                "sense_id": "d2f218cc-bb11-3fcc-b74c-1d058647a5d7",
                                                "text": "La loi de 1874, dans son article 5, a eu en vue d’empêcher ce genre de fraude en prescrivant que la date du chèque serait inscrite en toutes lettres de la main de celui qui l’aurait écrit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eaa5f9f-8f92-31b4-b4b5-77d45b29494b",
                                        "entry_id": "c6e0b662-fb98-31f4-aab2-e381b86a28b4",
                                        "glosses": [
                                            "Écrit de manière très lisible."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34584035-0d6a-431b-b4ae-0e99be6770fe",
                                                "sense_id": "0eaa5f9f-8f92-31b4-b4b5-77d45b29494b",
                                                "text": "Le jeune homme s’est posté à plusieurs reprises devant le Parlement de Kampala avec une pancarte résumant ses attentes en toutes lettres. Le dimanche, il manifeste à la sortie des églises avec les mêmes messages d’alerte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35b12a28-a9c7-3450-9aad-bacdac0dea99",
                                        "entry_id": "c6e0b662-fb98-31f4-aab2-e381b86a28b4",
                                        "glosses": [
                                            "Clairement ; expressément."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e2f5b1d-45ff-4419-a206-23ab3bb62091",
                                                "sense_id": "35b12a28-a9c7-3450-9aad-bacdac0dea99",
                                                "text": "Cette loi permet aux préfets « d’interdire la circulation des personnes ou des véhicules dans les lieux et aux heures fixés par arrêté ». Même si le mot ne figure pas en toutes lettres dans le texte de loi, il s’agit de la possibilité d’instaurer un couvre-feu."
                                            },
                                            {
                                                "example_id": "ca7ed919-e7e7-42db-87b5-338f051cb75c",
                                                "sense_id": "35b12a28-a9c7-3450-9aad-bacdac0dea99",
                                                "text": "Vous remarquerez toutefois que pour la plupart des antidépresseurs, lorsqu’un site mentionne en toutes lettres le risque suicidaire, celui-ci n’apparaît plus dans la rubrique « effets indésirables » mais dans « précautions d’emploi », où il figure dans un paragraphe spécial intitulé « suicide »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
