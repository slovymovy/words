                "senses": [
                    {
                        "sense_id": "9860a91b-90ac-347f-803a-05224b0cf3d6",
                        "entry_id": "af2d949d-f2b9-3c20-856d-30871dd2b92d",
                        "glosses": [
                            "junge, männliche Person, die sich auffallend viel auf der Straße herumtreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0b029b8-d824-4dbc-b5c3-3550382cf9c4",
                                "sense_id": "9860a91b-90ac-347f-803a-05224b0cf3d6",
                                "text": "„Die Straßenjungens in unserem Viertel hatten zwei Fußballmannschaften: eine christliche und eine jüdische.“"
                            },
                            {
                                "example_id": "aff74fc5-8616-4802-9a19-c0dd00aa7026",
                                "sense_id": "9860a91b-90ac-347f-803a-05224b0cf3d6",
                                "text": "„Auf einem schrillen Pfiff von ihm führte ein Straßenjunge eine Droschke heran und öffnete die Tür.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
