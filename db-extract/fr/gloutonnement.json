        "fr-extract.jsonl": [
            {
                "entry_id": "bbd4fa1d-9e3b-3c11-9324-5eb0140c3a1c",
                "word": "gloutonnement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b0d87597-faa6-3c8f-b742-12543d997b00",
                        "entry_id": "bbd4fa1d-9e3b-3c11-9324-5eb0140c3a1c",
                        "glosses": [
                            "D’une manière gloutonne, voracement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e546ac9-b815-45c1-b1ef-5957b2445c06",
                                "sense_id": "b0d87597-faa6-3c8f-b742-12543d997b00",
                                "text": "Et sa misère sera telle,\nQue mainte assiette et mainte écuelle,\nFaute de meilleur aliment,\nSeront par lui gloutonnement\nEt par ses soldats dévorées."
                            },
                            {
                                "example_id": "68f4495a-9a12-4215-9a93-360dfce9fbff",
                                "sense_id": "b0d87597-faa6-3c8f-b742-12543d997b00",
                                "text": "Les loups mangent gloutonnement."
                            },
                            {
                                "example_id": "cfc1b8d7-d9b3-4f0b-a134-1c9e23d76f3d",
                                "sense_id": "b0d87597-faa6-3c8f-b742-12543d997b00",
                                "text": "À mon tour, je pris une tranche de pain, et si je ne m’étouffai pas comme Joli-Cœur, je dévorai au moins aussi gloutonnement que lui."
                            },
                            {
                                "example_id": "67c6c6f3-8ca8-4b0d-bbc0-80a65c8f7a2c",
                                "sense_id": "b0d87597-faa6-3c8f-b742-12543d997b00",
                                "text": "[…] donner le coup de couteau chirurgical qui libère un Chaperon rouge et une grand-mère trop gloutonnement avalés ne relève pas de la magie mais d’un savoir-faire très ordinaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce3ccad7-1a66-4fb2-b74e-d0098592165c",
                        "source_entry_id": "bbd4fa1d-9e3b-3c11-9324-5eb0140c3a1c",
                        "source_sense_id": "b0d87597-faa6-3c8f-b742-12543d997b00",
                        "target_lang_word": "gluttonously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gluttonously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "770fcbc7-243c-380e-a5f7-bf9de96f64f5",
                                        "entry_id": "f47b14f9-a199-3f77-929a-ad8b08945605",
                                        "glosses": [
                                            "In a gluttonous manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4431b9ce-5a40-4a64-aadb-ec6ebec7100b",
                                                "sense_id": "770fcbc7-243c-380e-a5f7-bf9de96f64f5",
                                                "text": "He opened his lips against her inner, upper leg and her entire body smiled. Smiled in satisfaction. Smiled gluttonously. Smiled and decided, I will take this."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "825fa2e6-5570-44f3-a3b4-b2e12b0ebd68",
                        "source_entry_id": "bbd4fa1d-9e3b-3c11-9324-5eb0140c3a1c",
                        "source_sense_id": "b0d87597-faa6-3c8f-b742-12543d997b00",
                        "target_lang_word": "greedily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greedily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e8d0305-5034-3a93-86a4-e1aaa95dc73a",
                                        "entry_id": "6e87f946-423f-34b4-a6de-398a18255151",
                                        "glosses": [
                                            "In a greedy manner; with keen or ardent desire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "695157db-551c-4f6d-827f-3aa86dc05345",
                                                "sense_id": "3e8d0305-5034-3a93-86a4-e1aaa95dc73a",
                                                "text": "The two dogs greedily devoured the meat."
                                            },
                                            {
                                                "example_id": "a3520986-e13b-4c18-9f71-02ecf4437ba2",
                                                "sense_id": "3e8d0305-5034-3a93-86a4-e1aaa95dc73a",
                                                "text": "I gazed greedily on the gems in the shop window."
                                            },
                                            {
                                                "example_id": "629f2e50-a348-41f0-80e0-9df45e186c6b",
                                                "sense_id": "3e8d0305-5034-3a93-86a4-e1aaa95dc73a",
                                                "text": "There he ordered beer from the adenoidal Chinese manager and drank the afternoon away, greedily swilling bottle after bottle, feeling gradually his adulthood return."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b53ba3b0-6bfc-4547-9c6b-fcf4ef6f4983",
                        "source_entry_id": "bbd4fa1d-9e3b-3c11-9324-5eb0140c3a1c",
                        "source_sense_id": "b0d87597-faa6-3c8f-b742-12543d997b00",
                        "target_lang_word": "voraciously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voraciously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bad979c-bd9b-39de-883e-8ad97ff0b892",
                                        "entry_id": "9fb7716c-9d07-31a9-8e02-ecd2fba4fbff",
                                        "glosses": [
                                            "In a voracious manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2901a8f-42a9-4b30-be26-4f23f3e89d28",
                                                "sense_id": "7bad979c-bd9b-39de-883e-8ad97ff0b892",
                                                "text": "Tsiolkas's Europe, as voraciously predatory as his own undead protagonist, is a far cry from the fount of idealistic humanism dreamed up by generations of both pre- and post-Enlightenment politicians and philosophers, a Europe defined by its durable capacity for civility in an otherwise barbarous world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
