                ],
                "senses": [
                    {
                        "sense_id": "940ddd41-d71e-30b9-9073-f2e7c70fc2d6",
                        "entry_id": "a53142db-218b-3fe4-9c06-6e30a531f692",
                        "glosses": [
                            "Person, die sich mit dem Fahrrad fortbewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3672b9a7-ba9e-446b-b8d4-004cd867e3be",
                                "sense_id": "940ddd41-d71e-30b9-9073-f2e7c70fc2d6",
                                "text": "Wenn es keinen benutzungspflichtigen Radweg gibt dürfen Fahrradfahrer auf der Straße fahren."
                            },
                            {
                                "example_id": "2ed08343-88bf-4848-be3c-5ebf875cb017",
                                "sense_id": "940ddd41-d71e-30b9-9073-f2e7c70fc2d6",
                                "text": "„Und es regnet eigentlich immer über den Fahrradfahrern.“"
                            },
                            {
                                "example_id": "4117303e-b529-40ea-be5c-7c7347b6f41d",
                                "sense_id": "940ddd41-d71e-30b9-9073-f2e7c70fc2d6",
                                "text": "„Manchmal haben uns einige Fahrradfahrer überholt und uns laut gegrüßt, und wir haben dann auch gegrüßt und so getan, als hätten wir sehr gute Laune.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fde2d63c-989c-486a-9e4a-ba6925f9550a",
                        "source_entry_id": "a53142db-218b-3fe4-9c06-6e30a531f692",
                        "source_sense_id": "940ddd41-d71e-30b9-9073-f2e7c70fc2d6",
                        "source_sense_description": "Person, die sich mit dem Fahrrad fortbewegt",
                        "target_lang_word": "bicyclist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bicyclist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "971dd4fb-1093-39ba-a8b7-4a1dfc666121",
                                        "entry_id": "78ea4dd8-3d16-3659-8b6e-f62cbad43391",
                                        "glosses": [
                                            "Rare form of cyclist."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faf80c2b-19ba-44d8-8bdf-d1b7565c8b6b",
                                                "sense_id": "971dd4fb-1093-39ba-a8b7-4a1dfc666121",
                                                "text": "“Yes, that is true, professor. I believe I’ve been guilty of doing so myself; but look here, Miss Eunice,” and he turned suddenly to the professor’s daughter, “they tell me that you are an enthusiastic bicyclist.”"
                                            },
                                            {
                                                "example_id": "0e8ff210-3678-4de6-bb92-d7b41debe5c4",
                                                "sense_id": "971dd4fb-1093-39ba-a8b7-4a1dfc666121",
                                                "text": "Our policemen, of course, will be fitted out with large, twirlable moustaches and small, twirlable rolling-pins, and will be taught to turn their backs on traffic jams, but to blow whistles violently at solitary bicyclists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41b1c65a-71bb-4ab2-ba75-5031cee73a33",
                        "source_entry_id": "a53142db-218b-3fe4-9c06-6e30a531f692",
                        "source_sense_id": "940ddd41-d71e-30b9-9073-f2e7c70fc2d6",
                        "source_sense_description": "Person, die sich mit dem Fahrrad fortbewegt",
                        "target_lang_word": "biker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74635f8f-253e-388c-9d65-49f0e235febc",
                                        "entry_id": "401d2f42-13b1-3c65-9b0d-d9fcb49700eb",
                                        "glosses": [
                                            "A person whose lifestyle is centered on motorcycles, sometimes a member of a motorcycle club."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b07fb8-dc32-4561-a675-758345643199",
                                                "sense_id": "74635f8f-253e-388c-9d65-49f0e235febc",
                                                "text": "Others, mostly behelmeted casual bikers whose enthusiasm for motorcycling is a monthly Sunday morning ride, also took in the gleam of the chrome and outrageous styling, but were confused that it had a Honda badge on it rather than Harley’s winged logo."
                                            },
                                            {
                                                "example_id": "977e5324-5ac7-468a-8796-4f1b30256fa0",
                                                "sense_id": "74635f8f-253e-388c-9d65-49f0e235febc",
                                                "text": "There’s a wonderful sketch of a formidable biker called “Roundhouse,” who is “humongously fat and hasn’t had a haircut since third grade.”"
                                            },
                                            {
                                                "example_id": "7c5c9fe1-878b-439f-ba6f-dd2be809f9f4",
                                                "sense_id": "74635f8f-253e-388c-9d65-49f0e235febc",
                                                "text": "Bikers did what bikers do. They raced around and popped wheelies. The state police were called in to clear the town.\nThe event got big play in Life magazine and inspired the 1953 film “The Wild One,” starring Marlon Brando. His leather jacket and brooding demeanor gave a face to the bad-boy biker image."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dbc6b0c-0ff6-3eac-b7e3-5b07071d9325",
                                        "entry_id": "401d2f42-13b1-3c65-9b0d-d9fcb49700eb",
                                        "glosses": [
                                            "A cyclist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f200aa1d-1ecd-4147-a520-0db31f4edbf1",
                                                "sense_id": "4dbc6b0c-0ff6-3eac-b7e3-5b07071d9325",
                                                "text": "Lots of pockets help with a commute, a storm hood is great if you get caught in a storm on a hike, weight and packability are essential for backpackers and if you’re a climber or biker, you’ll want a helmet-compatible hood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dae500cc-104f-4f9b-8f81-e7ce71f9a602",
                        "source_entry_id": "a53142db-218b-3fe4-9c06-6e30a531f692",
