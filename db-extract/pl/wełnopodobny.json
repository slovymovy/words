                "senses": [
                    {
                        "sense_id": "3e495daa-9b6d-36dc-8bff-75f6359359bb",
                        "entry_id": "e8653240-5c8f-301b-87e8-1a3853d712f4",
                        "glosses": [
                            "podobny do wełny, przypominający wełnę, mający właściwości wełny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d607189-bb05-4927-baa0-417ca7571d05",
                                "sense_id": "3e495daa-9b6d-36dc-8bff-75f6359359bb",
                                "text": "Toga jest suknią fałdzistą z lekkiego czarnego materiału wełnianego lub wełnopodobnego, sięgającą powyżej kostek — około 25 cm od ziemi"
                            },
                            {
                                "example_id": "acff8ff9-710e-402f-aced-7f6e726d36d1",
                                "sense_id": "3e495daa-9b6d-36dc-8bff-75f6359359bb",
                                "text": "Zrezygnuj z kupowanych co miesiąc bawełnianych lub wełnopodobnych szmat, które tak naprawdę niczym się od siebie nie różnią"
                            },
                            {
                                "example_id": "932f2d6c-02a7-4402-96c7-b9cd590ac83d",
                                "sense_id": "3e495daa-9b6d-36dc-8bff-75f6359359bb",
                                "text": "W marketach dostępne są dywaniki ozdobne wykonane z materiałów sztucznych oraz wełnopodobnych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
