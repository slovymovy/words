                                        "examples": [
                                            {
                                                "example_id": "10733b83-80e5-4033-983f-63e8862ef897",
                                                "sense_id": "04e77c16-8a6a-3406-86fe-9cc36163ec56",
                                                "text": "Die Naturwissenschaft arbeitet sehr häufig mit mathematischen Methoden."
                                            },
                                            {
                                                "example_id": "f14f300b-fe68-4aa2-bfc7-a565ef983d4e",
                                                "sense_id": "04e77c16-8a6a-3406-86fe-9cc36163ec56",
                                                "text": "Sie ist mathematisch begabt."
                                            },
                                            {
                                                "example_id": "57795025-df9d-42aa-8ae4-5161aa608289",
                                                "sense_id": "04e77c16-8a6a-3406-86fe-9cc36163ec56",
                                                "text": "„Selbst die wissenschaftlichsten, mathematischsten Erkenntnisse basieren auf Vergleichen und Analogien und oft auf Metaphern […].“"
                                            }
