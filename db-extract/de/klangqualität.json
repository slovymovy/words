                ],
                "senses": [
                    {
                        "sense_id": "66d53d92-f599-3327-8d01-a58e0470d76f",
                        "entry_id": "eab5c874-7a2b-3a72-a72c-a713b6298c25",
                        "glosses": [
                            "Güte von Tönen, Musik oder Sprache"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "dfcec3ca-a806-46a6-9151-6e17413f38da",
                                "sense_id": "66d53d92-f599-3327-8d01-a58e0470d76f",
                                "text": "„Diese ersten Serienschallplatten der Welt waren von so minderwertiger Klangqualität, dass Zettel mit dem vollständigen Text der jeweiligen Aufnahme auf die Plattenrückseite geklebt wurden, damit der Käufer den Inhalt der Platte nachvollziehen konnte.“"
                            },
                            {
                                "example_id": "eb0770b2-0338-49bc-a9fe-80867b0cc03e",
                                "sense_id": "66d53d92-f599-3327-8d01-a58e0470d76f",
                                "text": "„Das verbesserte die Klangqualität und Haltbarkeit der Platten enorm.“"
                            },
                            {
                                "example_id": "cb005f9b-7a22-421a-b966-ee3a926a00c0",
                                "sense_id": "66d53d92-f599-3327-8d01-a58e0470d76f",
                                "text": "„Piezoelektrische Wandler haben typischerweise einen hohen Wirkungsgrad und eine geringe Klangqualität (kaum Tiefenwiedergabe, ausgeprägte Resonanzen).“"
                            },
                            {
                                "example_id": "98d3d93d-cc1c-4f16-ad5f-741df7a3e883",
                                "sense_id": "66d53d92-f599-3327-8d01-a58e0470d76f",
                                "text": "„Diese Lautspecher bieten überraschend erwachsene, geradezu hochklassige Klangqulität, und sie machen optisch richtig was her.“"
                            },
                            {
                                "example_id": "1ab3d166-02ac-4601-9e2d-53c990a94752",
                                "sense_id": "66d53d92-f599-3327-8d01-a58e0470d76f",
                                "text": "[…] „tatsächlich bietet dieses Konzept Klangqualität auf allerhöchstem Niveau.“"
                            },
                            {
                                "example_id": "2c3d4698-d5f7-4774-947d-a3fd9e4fac1e",
                                "sense_id": "66d53d92-f599-3327-8d01-a58e0470d76f",
                                "text": "[Das Audioformat Opus] „ermöglicht besonders hohe Klangqualität und besonders geringe Verzögerung in Übertragungen.“"
                            },
                            {
                                "example_id": "1b2b9907-8309-4435-b119-6719b8bac4ba",
                                "sense_id": "66d53d92-f599-3327-8d01-a58e0470d76f",
                                "text": "„Entscheidend für die Klangqualität ist die Raumkorrektur, mit der der Verstärker Ihre Lautsprecher per Mikrofonmessung an die Raumakustik anpasst.“"
                            },
                            {
                                "example_id": "3bb1f849-ca96-45ef-ab53-4ab81aa7f823",
                                "sense_id": "66d53d92-f599-3327-8d01-a58e0470d76f",
                                "text": "„Mit der Zeit kamen günstigere Geräte auf den Markt und die Klangqualität wurde dank neuer Bandarten und Verfahren viel besser.“"
                            },
                            {
                                "example_id": "684876c3-e460-4766-984a-55e9e6e6341d",
                                "sense_id": "66d53d92-f599-3327-8d01-a58e0470d76f",
                                "text": "„Im Test von Bluetooth-In-Ear-Kopfhörern fällt vor allem die verbesserungsfähige Klangqualität auf.“"
                            },
                            {
                                "example_id": "98a9e1e6-8ffb-47b5-a2c3-855fa837ec1b",
                                "sense_id": "66d53d92-f599-3327-8d01-a58e0470d76f",
                                "text": "„Die Klangqualität ist allerdings mau:“ […]."
                            },
                            {
                                "example_id": "e498345b-b53e-4894-8bc8-56a38a595bcd",
                                "sense_id": "66d53d92-f599-3327-8d01-a58e0470d76f",
                                "text": "„In der Audiotechnik (High Fidelity) werden mit HiRes digitale Musikformate bezeichnet, die eine Abtastrate von mindestens 96 kHz oder eine Samplingtiefe von mindestens 24 Bit haben und damit über den Standard Compact Disc Digital Audio hinausgehen. Musikkonsumenten versprechen sich davon eine höhere Klangqualität.“"
                            },
                            {
                                "example_id": "fc448ecf-bd38-4814-bcc6-b720e5b5954f",
                                "sense_id": "66d53d92-f599-3327-8d01-a58e0470d76f",
                                "text": "[Karina Canellakis (Dirigentin) über Orchester:] „»Alles muss zusammen klingen. Die Intonation muss gut sein, die Klangqualität ist für mich sehr wichtig. Die Farben sind wichtig, das Pianissimo ist leise.«“"
                            },
                            {
                                "example_id": "32fc2441-e0ec-4fb7-a953-a83a79f8725a",
                                "sense_id": "66d53d92-f599-3327-8d01-a58e0470d76f",
                                "text": "[Stradivari Geigen:] „Vielfach wurde versucht, das Geheimnis ihrer Klangqualität wissenschaftlich zu ergründen.“"
                            },
                            {
                                "example_id": "c140be5e-c528-4a6e-a482-89d31d1861bf",
                                "sense_id": "66d53d92-f599-3327-8d01-a58e0470d76f",
                                "text": "[Stradivari Geigen:] „Zu beachten sei auch, dass Stradivari-Instrumente sich in ihrer Klangqualität und -charakteristik erheblich voneinander unterscheiden – einen einheitlichen, durchweg optimalen Stradivari-Klang gebe es gar nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
