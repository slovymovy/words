                "senses": [
                    {
                        "sense_id": "9625f521-0594-323e-98f7-0a4d0d0a0637",
                        "entry_id": "31acbf69-1d4a-3fa2-a95f-7b639ae89b41",
                        "glosses": [
                            "ein Vogel aus der Familie der Fasanenartigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95f29ed2-ab3a-4678-a12d-92e2945e7e3c",
                                "sense_id": "9625f521-0594-323e-98f7-0a4d0d0a0637",
                                "text": "Männliche Goldfasane sind prächtig gefärbt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "831c2f6e-7815-3ac9-adba-307ad58839dd",
                        "entry_id": "31acbf69-1d4a-3fa2-a95f-7b639ae89b41",
                        "glosses": [
                            "Schimpfwort im Dritten Reich für hohe Parteimitglieder und Militärs in Anspielung auf die von ihnen getragenen Orden und Auszeichnungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b73b09c1-a018-4ab2-acd3-3847740ef943",
                                "sense_id": "831c2f6e-7815-3ac9-adba-307ad58839dd",
                                "text": "„Als er den Keller verlassen hat, schwirren die Stimmen wie Fliegen durcheinander, Flüche und Verwünschungen steigen wie Blasen an die Oberfläche, der oder jener weiß plötzlich, wie man mit dem Goldfasan umgehen müßte.“"
                            },
                            {
                                "example_id": "b8208cf6-17c7-46da-91ad-2e17ab8c69b4",
                                "sense_id": "831c2f6e-7815-3ac9-adba-307ad58839dd",
                                "text": "„Ich muß wieder an den Goldfasan denken: Einen solchen Zornanfall wie bei dem Kerl habe ich noch nie gehabt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
