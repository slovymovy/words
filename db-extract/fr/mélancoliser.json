                ],
                "senses": [
                    {
                        "sense_id": "56319813-7925-3989-aba9-89b208b91ce2",
                        "entry_id": "a607cb14-3240-3994-908c-4ee3b86a37e2",
                        "glosses": [
                            "Se laisser aller à la mélancolie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b9d68e1-5084-4528-8d7e-364594e64600",
                                "sense_id": "56319813-7925-3989-aba9-89b208b91ce2",
                                "text": "— Oh ! ne dites pas de pareilles choses ! s’écria la procureuse en éclatant en sanglots.\n— Quelque chose me le dit, continua Porthos en mélancolisant de plus en plus."
                            },
                            {
                                "example_id": "dcf85174-68ef-4da6-87b9-4b2984d79a53",
                                "sense_id": "56319813-7925-3989-aba9-89b208b91ce2",
                                "text": "Mais aujourd’hui nous n’avons pas le temps de mélancoliser ni de jaser."
                            },
                            {
                                "example_id": "e4e46cd8-dad9-4234-a4f3-e6d004d7483b",
                                "sense_id": "56319813-7925-3989-aba9-89b208b91ce2",
                                "text": "Mme Le Normand a bien le droit de mélancoliser sur la décadence des salons et de la causerie."
                            }
                        ]
                    },
                    {
                        "sense_id": "14feff88-c710-3f7b-b0c7-ebbf1b86e831",
                        "entry_id": "a607cb14-3240-3994-908c-4ee3b86a37e2",
                        "glosses": [
                            "Devenir mélancolique."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "c55e245e-281d-4e3d-ab5e-3416a730427a",
                                "sense_id": "14feff88-c710-3f7b-b0c7-ebbf1b86e831",
                                "text": "Pour que l’amour puisse se mélancoliser, il faut bien sûr une déception amoureuse, mais il faut également une prédisposition."
                            },
                            {
                                "example_id": "e1cc2d6a-c929-4b25-b4d1-32230ac05322",
                                "sense_id": "14feff88-c710-3f7b-b0c7-ebbf1b86e831",
                                "text": "Où sont Raynal Billy Dalize\nDont les noms se mélancolisent\nComme des pas dans une église."
                            }
                        ]
                    },
                    {
                        "sense_id": "19152269-abb4-3ec4-a177-8ebd1e2e393e",
                        "entry_id": "a607cb14-3240-3994-908c-4ee3b86a37e2",
                        "glosses": [
                            "Rendre mélancolique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2af52da5-cb6d-42ab-a896-de86933a193b",
                                "sense_id": "19152269-abb4-3ec4-a177-8ebd1e2e393e",
                                "text": "On ne saurait aller plus loin dans cette voie d’attrister et de mélancoliser Don Quichotte."
                            },
                            {
                                "example_id": "f21858ab-3d0e-4a1a-a175-5fe6c491c187",
                                "sense_id": "19152269-abb4-3ec4-a177-8ebd1e2e393e",
                                "text": "Le murmure du vent et même la musique indécise des soldats dont le son arrivait jusqu’à moi mélancolisaient doucement mon cœur."
                            },
                            {
                                "example_id": "f18e9773-0af4-4eee-a7a2-13cf0305077e",
                                "sense_id": "19152269-abb4-3ec4-a177-8ebd1e2e393e",
                                "text": "J’aime beaucoup les cimetières, moi, ça me repose et me mélancolise : j’en ai besoin."
                            }
                        ]
                    }
                ],
