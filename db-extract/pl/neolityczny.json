                                        "sense_id": "a82ba758-6a76-3b09-8b45-fdaf172e3b6c",
                                        "entry_id": "d5c66779-b95e-3e8e-b186-c626c053027f",
                                        "glosses": [
                                            "Alternative spelling of Neolithic."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a5c86fa-ba77-4a70-957c-8eebb58b2940",
                                                "sense_id": "a82ba758-6a76-3b09-8b45-fdaf172e3b6c",
                                                "text": "With this thought in his mind, Challenger gave a contemptuous and condescending consent to the proposal that he should grace with his presence a proceeding which was, in his opinion, more fitted to the stone cabin of a neolithic savage than to the serious attention of one who represented the accumulated culture and wisdom of the human race."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0f33368-3f83-33be-af7b-8b0849571836",
                                        "entry_id": "d5c66779-b95e-3e8e-b186-c626c053027f",
                                        "glosses": [
                                            "hopelessly outdated"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d74c0c6-7b11-4907-a922-cfbbbaa94a59",
                                                "sense_id": "b0f33368-3f83-33be-af7b-8b0849571836",
                                                "text": "What am I supposed to do with this neolithic piece of machinery?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbe7655d-309a-4aea-9b8a-a7c22ea4fba0",
                        "source_entry_id": "2465dcbd-9692-3630-bcb4-43dabf77f5b2",
                        "source_sense_id": "8a68c7f8-1384-3d7f-9206-d9f860c17838",
                        "target_lang_word": "Neolithic",
