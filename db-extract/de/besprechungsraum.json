                "senses": [
                    {
                        "sense_id": "43ac8232-15a6-32f2-8803-e64cf12fb1a1",
                        "entry_id": "8385f0fb-6867-3914-9bc3-b0b7155ff928",
                        "glosses": [
                            "Raum eines Hauses, in dem Besprechungen abgehalten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c3e64cc-cfe7-452b-aaa9-fd14930d63a3",
                                "sense_id": "43ac8232-15a6-32f2-8803-e64cf12fb1a1",
                                "text": "Im Besprechungsraum funktioniert die Klimaanlage derzeit leider nicht."
                            },
                            {
                                "example_id": "3e43baa8-b755-4eb8-903c-a33698faae7b",
                                "sense_id": "43ac8232-15a6-32f2-8803-e64cf12fb1a1",
                                "text": "„Kortüm bittet in den Besprechungsraum.“"
                            },
                            {
                                "example_id": "bcf522ec-a58e-4b4b-b78b-4b38372051c5",
                                "sense_id": "43ac8232-15a6-32f2-8803-e64cf12fb1a1",
                                "text": "„Ich dachte kurz zurück an den klimatisierten Besprechungsraum meines früheren Arbeitsgebers, mit Schnittchen, frischem Obst und Erfrischungsgetränken.“"
                            },
                            {
                                "example_id": "e4718e4e-e99f-403a-bf55-7b469121b3a7",
                                "sense_id": "43ac8232-15a6-32f2-8803-e64cf12fb1a1",
                                "text": "„Um zehn saßen Elma und Sævar am langen Tisch des Besprechungsraums und warteten auf Hörđur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
