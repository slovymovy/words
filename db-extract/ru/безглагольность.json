                "senses": [
                    {
                        "sense_id": "03eeeb8f-d2b5-382b-a1ed-31df279027ce",
                        "entry_id": "d53161be-518e-3b6f-a00b-17ef996fc102",
                        "glosses": [
                            "устар. свойство по значению прилагательного безглагольный, молчаливость; тишина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "226bab1e-7221-4917-b2b8-a17003ebbaae",
                                "sense_id": "03eeeb8f-d2b5-382b-a1ed-31df279027ce",
                                "text": "Я люблю безглагольность зелёных долин, / Зачарованных роскошью лунною…"
                            },
                            {
                                "example_id": "86827ad7-f55c-463d-9f43-6cae89635108",
                                "sense_id": "03eeeb8f-d2b5-382b-a1ed-31df279027ce",
                                "text": "Свободно стало, тихо… «Однако — какая безглагольность!» — думает Игемон, ежась и почёсываясь всюду."
                            },
                            {
                                "example_id": "7c6e9ab9-4840-404b-b4bf-5b41bd493386",
                                "sense_id": "03eeeb8f-d2b5-382b-a1ed-31df279027ce",
                                "text": "Я чувствую Белую Невесту, когда один, в великой безглагольности глубокой ночи, я смотрю на Млечный Путь."
                            }
                        ]
                    }
                ],
