                                    {
                                        "sense_id": "dd4d6379-b4ab-3d61-bd0a-0268b867f89e",
                                        "entry_id": "b05eb9ba-9fe3-38d8-8a70-30f6106ec7f9",
                                        "glosses": [
                                            "The state of presenting as a boy, regardless of one's actual gender identity."
                                        ],
                                        "tags": [
                                            "especially",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a576c91b-73cd-4565-a14d-c13cede082cd",
                                                "sense_id": "dd4d6379-b4ab-3d61-bd0a-0268b867f89e",
                                                "text": "Coordinate term: girlmode"
                                            },
                                            {
                                                "example_id": "a8234ca1-98d0-4498-84c9-9cc9f1d5ff31",
                                                "sense_id": "dd4d6379-b4ab-3d61-bd0a-0268b867f89e",
                                                "text": "I was out in semi-boymode tonight and some drunk Scottish guy walked up to me in the street and said \"Aye pal, you tryna become a lassie?\" I was just like \"Umm I guess\" super embarrassedly, and he said \"ah well good on ya, don't let nae cunt tell you who you are, be yoursel\""
                                            },
                                            {
                                                "example_id": "3d176fe4-1ae1-4161-ac69-5a7a5b251d91",
                                                "sense_id": "dd4d6379-b4ab-3d61-bd0a-0268b867f89e",
                                                "text": "...just been told I look better in boymode..."
                                            },
                                            {
                                                "example_id": "02a6a1e7-6568-4e5a-8e4f-26d79475d6f3",
                                                "sense_id": "dd4d6379-b4ab-3d61-bd0a-0268b867f89e",
                                                "text": "Before I came out as trans I was in boymode at work and this girl came up to me and goes \"You're not fooling anyone\" I was like \"Huh?\" she goes \"You're one of them girls pretending to be a boy. I can see your tits and they're bigger than mine!\" I love accidental validation!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boymode",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67898cf2-bb82-3569-842e-c7634ecdd31b",
                                        "entry_id": "2fc95a1e-0db4-35f0-932d-c85a9a053a11",
                                        "glosses": [
                                            "To present as a boy, regardless of one's actual gender identity."
                                        ],
                                        "tags": [
                                            "especially",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "919ea988-14cb-4cd1-9706-d3b8ad9decb4",
                                                "sense_id": "67898cf2-bb82-3569-842e-c7634ecdd31b",
                                                "text": "Coordinate term: girlmode"
                                            },
                                            {
                                                "example_id": "2d6bbb8f-6452-4217-af8d-4a87ec37e2c9",
                                                "sense_id": "67898cf2-bb82-3569-842e-c7634ecdd31b",
                                                "text": "We are 6 months away from cis girls posting that they're boymoding for not putting on makeup to go to the corner store"
                                            },
                                            {
                                                "example_id": "504dcc6e-a904-4ea8-92a8-700f5cd2011e",
                                                "sense_id": "67898cf2-bb82-3569-842e-c7634ecdd31b",
                                                "text": "you boymode because you feel insecure about your appearance, she boymodes to hijack a boeing 727-100 airplane, demand $200,000 in negotiable american currency and jump out the aft staircase, you are not the same"
                                            },
                                            {
                                                "example_id": "e3d7a4a8-39f3-430d-afce-e5d69e37054f",
                                                "sense_id": "67898cf2-bb82-3569-842e-c7634ecdd31b",
                                                "text": "Living authentically is addictive. So many trans people go full-time sooner than planned. Once they get a taste they can't go back. I boymoded 24/7 my first 15 months on HRT. Then I went out in a skirt ONCE. 4 months later I submitted my petition for legal name and gender change."
                                            },
                                            {
                                                "example_id": "ef439c14-2c95-47fa-8f0c-329dcd7482cb",
                                                "sense_id": "67898cf2-bb82-3569-842e-c7634ecdd31b",
                                                "text": "i dont boymode, i manmode"
                                            },
                                            {
                                                "example_id": "191427f5-73cd-4c0b-9d8e-35cf7ae40784",
                                                "sense_id": "67898cf2-bb82-3569-842e-c7634ecdd31b",
                                                "text": "when you're 6 months on HRT but still trying to boymode"
                                            }
                                        ]
                                    }
                                ]
                            }
