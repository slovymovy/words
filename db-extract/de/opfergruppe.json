                ],
                "senses": [
                    {
                        "sense_id": "dc404e09-6fda-3918-8ac9-cdc4e9385c7d",
                        "entry_id": "7058b52a-f51e-3ff6-b0cc-3510f9d6c17d",
                        "glosses": [
                            "Gemeinschaft von Menschen, deren verbindende Gemeinsamkeit (beispielsweise gleiche Abstammung, Religion, Nationalität, sexuelle/politische Orientierung etc.) sie zu einer Gruppe macht, die ein meist erhebliches Unrecht (beispielsweise Ermordung, Inhaftierung) erleiden mussten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f1fa37a-ad4b-4ec3-8b73-67b7b2115b78",
                                "sense_id": "dc404e09-6fda-3918-8ac9-cdc4e9385c7d",
                                "text": "Genozide seien immer möglich und nicht an eine bestimmte Opfergruppe gebunden – der Holocaust somit wiederholbar."
                            },
                            {
                                "example_id": "69664650-ed10-4476-a57d-4b9ba8085b63",
                                "sense_id": "dc404e09-6fda-3918-8ac9-cdc4e9385c7d",
                                "text": "Während in Berlin das „Denkmal für die ermordeten Juden Europas“ errichtet wird, warnen Kritiker vor einer „Hierarchisierung“ der verschiedenen Opfergruppen: Einige von ihnen geraten dabei aus dem Blickfeld."
                            },
                            {
                                "example_id": "afe7d56b-6600-4d63-9a78-3b0f83c335fb",
                                "sense_id": "dc404e09-6fda-3918-8ac9-cdc4e9385c7d",
                                "text": "In Niedersachsen sind die sowjetischen Kriegsgefangenen die bei weitem größte Opfergruppe der NS-Verbrechen."
                            },
                            {
                                "example_id": "5a9cdea7-3e80-4085-9857-8c53dfab80e7",
                                "sense_id": "dc404e09-6fda-3918-8ac9-cdc4e9385c7d",
                                "text": "Nur sieben der 31 verlegten Steine betreffen die größte Opfergruppe, Menschen jüdischen Glaubens oder Herkunft: drei Frauen aus Wels und vier Mitglieder der Familie Baumann in Aigen im Mühlkreis."
                            },
                            {
                                "example_id": "7c425ae1-288b-4710-87d7-d2603f9e5d2b",
                                "sense_id": "dc404e09-6fda-3918-8ac9-cdc4e9385c7d",
                                "text": "Dass Österreich erst 70 Jahre nach Kriegsende die Opfergruppe der Deserteure und Kriegsdienstverweigerer ehre und sie lange als „Verräter“ abgestempelt habe, sei sehr bedauerlich, sagte Fischer."
                            },
                            {
                                "example_id": "968c8157-7474-483d-bdd7-22bb7e891701",
                                "sense_id": "dc404e09-6fda-3918-8ac9-cdc4e9385c7d",
                                "text": "Sinti und Roma sind eine in Deutschland fast vergessene Opfergruppe."
                            },
                            {
                                "example_id": "70457d95-159e-4ed8-a1f3-d9c0f8e7e50d",
                                "sense_id": "dc404e09-6fda-3918-8ac9-cdc4e9385c7d",
                                "text": "Herero und Nama hatten der Bundesregierung ein Ultimatum bis zum 2. Oktober gestellt, um einen Dialog nicht nur mit der namibischen Regierung, sondern auch mit den Opfergruppen aufzunehmen – es ist ohne Reaktion der deutschen Seite ausgelaufen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
