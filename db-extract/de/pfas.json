                ],
                "translations": [
                    {
                        "translation_id": "dfca8569-074a-4055-858c-dce61e269ed7",
                        "source_entry_id": "d962620a-8e5d-3874-9a1b-e9fd1c56f456",
                        "source_sense_id": "6a8c2c95-8780-39e9-ae79-00c986887971",
                        "source_sense_description": "per- und polyfluorierte Alkylverbindungen",
                        "target_lang_word": "PFAS",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "PFAS",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e84c4311-9141-3536-94e4-f580aa2010a7",
                                        "entry_id": "6365f8c9-96e5-3235-8cab-11cb38b0d435",
                                        "glosses": [
                                            "Acronym of perfluoroalkyl or polyfluoroalkyl substance (“a type of environmental pollutant”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "acronym",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "341ba835-c22e-49ce-998b-71ec5aa6cd3c",
                                                "sense_id": "e84c4311-9141-3536-94e4-f580aa2010a7",
                                                "text": "The US company 3M was the first to manufacture a PFAS commercially – the C8, PFOA."
                                            },
                                            {
                                                "example_id": "0e033b04-41ad-4048-a2e4-ccf5ca173a0c",
                                                "sense_id": "e84c4311-9141-3536-94e4-f580aa2010a7",
                                                "text": "A new study that checked American women’s breast milk for PFAS contamination detected the toxic chemical in all 50 samples tested, and at levels nearly 2,000 times higher than the level some public health advocates advise is safe for drinking water."
                                            },
                                            {
                                                "example_id": "3d24228f-2140-4bee-82fc-ec533a09d6f0",
                                                "sense_id": "e84c4311-9141-3536-94e4-f580aa2010a7",
                                                "text": "After research into foam at the Belgian seaside showing a concentration of per- and polyfluoroalkyl substances (PFAS) – widely used for their waterproofing qualities but difficult to destroy – the Dutch public health institute RIVM measured the coast in Zeeland, north and south Holland in April and August."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "344f0b2a-1058-3beb-984b-060096abfacd",
                                        "entry_id": "6365f8c9-96e5-3235-8cab-11cb38b0d435",
                                        "glosses": [
                                            "Acronym of perfluoroalkyl or polyfluoroalkyl substance (“a type of environmental pollutant”).",
                                            "a perfluoroalkyl substance"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f66523d4-60c6-31fd-a483-275d19652cb7",
                                        "entry_id": "6365f8c9-96e5-3235-8cab-11cb38b0d435",
                                        "glosses": [
                                            "Acronym of perfluoroalkyl or polyfluoroalkyl substance (“a type of environmental pollutant”).",
                                            "a polyfluoroalkyl substance"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f852a1e-66ad-36ae-a0da-3c1857c10346",
