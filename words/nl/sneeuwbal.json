                    "sense_id": "ea71c213-17f3-3962-be72-2af1f2acd8fd",
                    "sense_definition": "een tot een bal samengeperste hoeveelheid sneeuw, vaak gebruikt om mee te gooien",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "winter_pret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen maakten een grote <w>sneeuwbal</w> om de basis van de sneeuwpop te vormen.",
                            "target_lang_translations": {
                                "en": "The children made a large <w>snowball</w> to form the base of the snowman."
                            }
                        },
                        {
                            "text": "Hij gooide een <w>sneeuwbal</w> tegen het raam om de aandacht van zijn vriend te trekken.",
                            "target_lang_translations": {
                                "en": "He threw a <w>snowball</w> against the window to get his friend's attention."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grote sneeuwbal",
                        "sneeuwbal gooien"
                    ],
                    "target_lang_definitions": {
