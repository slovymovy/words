{
    "word_family": [
        "darning"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5801b094-56be-3176-b925-2f4d0487f9c7",
                    "sense_definition": "To repair fabric by stitching with thread or yarn, especially by weaving across a hole.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "repair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>darn</w> these socks again.",
                            "target_lang_translations": {
                                "es": "Necesito <w>zurcir</w> estos calcetines otra vez."
                            }
                        },
                        {
                            "text": "She sat by the fire to <w>darn</w> the holes in her old stockings.",
                            "target_lang_translations": {
                                "es": "Se sentó junto al fuego para <w>zurcir</w> los agujeros de sus medias viejas."
                            }
                        }
                    ],
                    "common_phrases": [
                        "darn socks"
                    ],
                    "target_lang_definitions": {
                        "es": "Reparar una prenda o tejido mediante costuras, especialmente tejiendo hilo sobre un agujero."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "zurcir",
                                "target_lang_sense_clarification": "Término estándar para remendar agujeros en telas de forma sutil."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8a679e2-21f2-31db-801d-870df814f1fb",
                    "sense_definition": "A mild way to express annoyance or anger, used as a substitute for the word damn.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oh <w>darn</w>, I forgot my keys inside the house.",
                            "target_lang_translations": {
                                "es": "Oh, <w>rayos</w>, olvidé mis llaves dentro de la casa."
                            }
                        },
                        {
                            "text": "Don't <w>darn</w> tell me what to do with my own time.",
                            "target_lang_translations": {
                                "es": "No me <w>vengas a</w> decir qué hacer con mi propio tiempo."
                            }
                        }
                    ],
                    "synonyms": [
                        "dang"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a euphemism for a stronger swear word."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Una forma suave de expresar molestia o enfado, usada como sustituto de palabras malsonantes."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "maldita sea",
                                "target_lang_sense_clarification": "Expresión común para denotar frustración leve."
                            },
                            {
                                "target_lang_word": "rayos",
                                "target_lang_sense_clarification": "Eufemismo coloquial para expresar enojo sin usar lenguaje ofensivo."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "b72426cf-54e3-39a7-84ae-91fd2fdc9ccc",
                    "sense_definition": "A mild expression of annoyance or frustration.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Darn</w>, I missed the bus by only a few seconds.",
                            "target_lang_translations": {
                                "es": "<w>Rayos</w>, perdí el autobús por solo unos segundos."
                            }
                        },
                        {
                            "text": "<w>Darn</w>, the computer crashed before I saved my work.",
                            "target_lang_translations": {
                                "es": "<w>Caramba</w>, la computadora se bloqueó antes de que guardara mi trabajo."
                            }
                        }
                    ],
                    "synonyms": [
                        "dammit"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a mild substitute for a stronger expletive."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Expresión suave de molestia o frustración."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "rayos",
                                "target_lang_sense_clarification": "Interjección coloquial para expresar frustración leve."
                            },
                            {
                                "target_lang_word": "caramba",
                                "target_lang_sense_clarification": "Exclamación suave de sorpresa o molestia."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "dfa7fcc5-af7c-3ea6-ae7e-06c31e634e2a",
                    "sense_definition": "Used to emphasize an adjective or adverb, meaning very or extremely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is too <w>darn</w> hot to go outside today.",
                            "target_lang_translations": {
                                "es": "Hace <w>demasiado</w> calor para salir hoy."
                            }
                        },
                        {
                            "text": "The movie was pretty <w>darn</w> good for a low-budget film.",
                            "target_lang_translations": {
                                "es": "La película fue <w>bastante</w> buena para ser de bajo presupuesto."
                            }
                        }
                    ],
                    "synonyms": [
                        "damn"
                    ],
                    "common_phrases": [
                        "too darn hot"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal intensifier."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Usado para enfatizar un adjetivo o adverbio, significando muy o extremadamente."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "malditamente",
                                "target_lang_sense_clarification": "Intensificador coloquial para enfatizar una cualidad."
                            },
                            {
                                "target_lang_word": "tremendamente",
                                "target_lang_sense_clarification": "Adverbio de intensidad para enfatizar un adjetivo."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b3da9c67-70ae-344f-9a34-269760100eb2",
                    "sense_definition": "Used to express annoyance or to emphasize something negative.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Get your <w>darn</w> feet off the table.",
                            "target_lang_translations": {
                                "es": "Quita tus <w>malditos</w> pies de la mesa."
                            }
                        },
                        {
                            "text": "I have a <w>darn</w> good reason to be upset.",
                            "target_lang_translations": {
                                "es": "Tengo una <w>muy</w> buena razón para estar molesto."
                            }
                        }
                    ],
                    "synonyms": [
                        "damn"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Mildly offensive or informal intensifier."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Usado para expresar molestia o para enfatizar algo negativo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "maldito",
                                "target_lang_sense_clarification": "Adjetivo usado para enfatizar molestia o desprecio."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0eb6749b-1ce0-3f49-b31b-f7f614c9a285",
                    "sense_definition": "A very small amount or value, often used in negative expressions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His opinion isn't worth a <w>darn</w> to me.",
                            "target_lang_translations": {
                                "es": "Su opinión no me importa <w>un comino</w>."
                            }
                        },
                        {
                            "text": "I don't care a <w>darn</w> about what they think.",
                            "target_lang_translations": {
                                "es": "No me importa <w>un bledo</w> lo que ellos piensen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "worth a darn"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in idiomatic expressions."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Una cantidad o valor muy pequeño, a menudo usado en expresiones negativas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "un comino",
                                "target_lang_sense_clarification": "Expresión idiomática para indicar que algo no tiene valor."
                            },
                            {
                                "target_lang_word": "un bledo",
                                "target_lang_sense_clarification": "Expresión coloquial para indicar indiferencia o falta de valor."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbf7132e-7c29-3bcd-9b7a-92d9d080e98c",
                    "sense_definition": "A patch or area of fabric that has been repaired by stitching.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "repair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>darn</w> on his sweater was barely visible.",
                            "target_lang_translations": {
                                "es": "El <w>zurcido</w> en su suéter era apenas visible."
                            }
                        },
                        {
                            "text": "She carefully inspected the <w>darn</w> to ensure it would hold.",
                            "target_lang_translations": {
                                "es": "Ella inspeccionó cuidadosamente el <w>zurcido</w> para asegurarse de que aguantaría."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Un parche o área de tela que ha sido reparada mediante costura."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "zurcido",
                                "target_lang_sense_clarification": "El resultado de la acción de zurcir una prenda."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}