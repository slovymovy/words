                "senses": [
                    {
                        "sense_id": "126164cd-83e4-38f9-ad4d-46508c7ca1ab",
                        "entry_id": "f4317b33-a1e4-3ce1-aa78-54fd0ac597fe",
                        "glosses": [
                            "Action vaillante."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3c3af99e-6fba-4865-afbd-144c166e321c",
                                "sense_id": "126164cd-83e4-38f9-ad4d-46508c7ca1ab",
                                "text": "Victoire aurait encore chômé en attendant les blés, si sa force et sa vaillantise ne l’eussent fait embaucher par le maire d’une petite commune des environs, et qui était un paysan."
                            },
                            {
                                "example_id": "43f11112-2a6b-4110-80f3-8c5a7dd565d4",
                                "sense_id": "126164cd-83e4-38f9-ad4d-46508c7ca1ab",
                                "text": "Elle se montra fière de sa vaillantise et, devant tout l’atelier, prit le bras du vieux polisson qui l’avait achetée ! Mais son courage ne fut pas de longue durée ; les nerfs se rebellèrent et, un soir, elle jeta à la porte argent et vieillard, et se résolut à reprendre sa vie d’autrefois."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6c88de5-c070-3bbf-839f-0647a11a1341",
                        "entry_id": "f4317b33-a1e4-3ce1-aa78-54fd0ac597fe",
                        "glosses": [
                            "Action par bravade, fanfaronnade."
                        ],
                        "tags": [
                            "colloquial",
                            "dated",
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "baf12d59-e222-4f98-9145-111bf7200f10",
                                "sense_id": "f6c88de5-c070-3bbf-839f-0647a11a1341",
                                "text": "Déjà fort indisposé, je suis rentré après avoir été un instant à l’Hôtel de ville, et ai fait tout le chemin à pied ; mais c’est une vaillantise qui ne m’a point réussi."
                            }
                        ]
                    }
