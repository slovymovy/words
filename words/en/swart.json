                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheep grazed peacefully across the green <w>swart</w> of the hillside.",
                            "target_lang_translations": {
                                "de": "Die Schafe grasten friedlich auf der grünen <w>Grasnarbe</w> des Berghangs."
                            }
                        },
                        {
                            "text": "Only hardy mosses managed to establish themselves on the thin <w>swart</w> covering the stony soil.",
                            "target_lang_translations": {
                                "de": "Nur widerstandsfähige Moose schafften es, sich auf der dünnen <w>Rasendecke</w> anzusiedeln, die den steinigen Boden bedeckte."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Spelling variant"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Veraltete Schreibweise von sward (Grasnarbe, Rasendecke)."
