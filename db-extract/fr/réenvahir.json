                "senses": [
                    {
                        "sense_id": "eb0fd8a9-39a8-3280-bbd4-f31350e5f2b4",
                        "entry_id": "9dd2505c-439d-3987-9ae4-ef16d9048f87",
                        "glosses": [
                            "Envahir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc8e4d85-7dde-4df7-8fa6-58b744f020b6",
                                "sense_id": "eb0fd8a9-39a8-3280-bbd4-f31350e5f2b4",
                                "text": "Au rappel de cet amour dont elle était follement jalouse, la princesse retrouvait son énergie coutumière en sentant la colère la réenvahir."
                            },
                            {
                                "example_id": "ee8ee7ef-c423-48c6-aaeb-6992704c30fc",
                                "sense_id": "eb0fd8a9-39a8-3280-bbd4-f31350e5f2b4",
                                "text": "Nous reverrions ces masses ennemies que nos conventions antérieures ont rejetées au delà de la Seine, réenvahir nos départements de l’ouest et du midi, Extrait de l’exposé des motifs par le ministre des finances sur le projet de loi relatif à l’emprunt de deux milliards."
                            }
                        ]
                    }
