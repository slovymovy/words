                        ],
                        "form": "das Fleischgericht"
                    },
                    {
                        "form_id": "61284165-0153-4550-a039-9827c32a145e",
                        "entry_id": "789a85a2-e89f-3fd6-b01d-afa1777902f9",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Fleischgerichte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "912ac0b2-c50e-39e8-b1a6-130c04e6f232",
                        "entry_id": "789a85a2-e89f-3fd6-b01d-afa1777902f9",
                        "glosses": [
                            "Speise, die Fleisch enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e91ce28-b2a6-4a8f-8562-569994d0fe4c",
                                "sense_id": "912ac0b2-c50e-39e8-b1a6-130c04e6f232",
                                "text": "Sauerbraten ist im Rheinland ein beliebtes Fleischgericht."
                            },
                            {
                                "example_id": "5f31a7b3-6ded-4b7d-9119-f55c367769d4",
                                "sense_id": "912ac0b2-c50e-39e8-b1a6-130c04e6f232",
                                "text": "„In den Gaststätten, die noch geöffnet hatten, durften sogar dreimal pro Woche, nämlich montags, donnerstags und sonnabends, keine Fleischgerichte angeboten werden.“"
                            },
                            {
                                "example_id": "ff517ee7-2acc-4ef0-8e5a-2a86eb92c256",
                                "sense_id": "912ac0b2-c50e-39e8-b1a6-130c04e6f232",
                                "text": "„Wir erdulden den Hunger, um das Fleischgericht besser zu genießen; wir zögern den Höhepunkt der Lust hinaus, um sie zu steigern; und wir warten mit einer Rache, um sie mörderischer zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc1444e5-19a5-4600-aa4c-122b9b46da73",
                        "source_entry_id": "789a85a2-e89f-3fd6-b01d-afa1777902f9",
                        "source_sense_id": "912ac0b2-c50e-39e8-b1a6-130c04e6f232",
                        "source_sense_description": "Speise, die Fleisch enthält",
                        "target_lang_word": "мясо",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мясо",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "173768ac-3d53-3c11-8f2a-ac4d5b68fa08",
                                        "entry_id": "8c70513b-b998-38b7-9c0b-82d078f7a85d",
                                        "glosses": [
                                            "то же, что плоть; мышечная ткань человека или животного"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82f7f3a5-859b-45ca-afa7-deaa0db7ea4f",
                                                "sense_id": "173768ac-3d53-3c11-8f2a-ac4d5b68fa08",
                                                "text": "Кроме мышечной ткани в состав мяса входят соединительная, жировая и небольшое количество нервной ткани."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "328f02f8-34c3-3b9f-9727-678978fb550f",
                                        "entry_id": "8c70513b-b998-38b7-9c0b-82d078f7a85d",
                                        "glosses": [
                                            "мясо [1] убитых животных как пищевой продукт"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84df239e-aa7e-49c9-aa46-3f09877f3733",
                                                "sense_id": "328f02f8-34c3-3b9f-9727-678978fb550f",
                                                "text": "Когда ученье кончилось, я пожелал увидеть вооружение солдата: ружья, как выше сказано, были духовые, а в сумах, вместо пороху, находились съестные припасы, а именно: один серебряный ящичек с крепким бульоном, вываренным из различных растений и мяс, которого несколько крох достаточно для пропитания целого семейства по крайней мере на месяц…"
                                            },
                                            {
                                                "example_id": "8e0c5ad6-2e85-40d7-bc03-c62a1242d92b",
                                                "sense_id": "328f02f8-34c3-3b9f-9727-678978fb550f",
                                                "text": "Там видны сырые, печёные и вяленые мяса, рыба, раки, слизняки и т. п. дрянь."
                                            },
                                            {
                                                "example_id": "cf6d5200-f489-4fcd-80e9-a89242e758fa",
                                                "sense_id": "328f02f8-34c3-3b9f-9727-678978fb550f",
                                                "text": "Разумеется, рацион должен содержать продукты, богатые железом: мясо, рыбу, яйца."
                                            },
                                            {
                                                "example_id": "b58eb5b8-014b-41ec-bd6f-4f9ca7a79478",
                                                "sense_id": "328f02f8-34c3-3b9f-9727-678978fb550f",
                                                "text": "Цинком богаты говядина, свинина, куриное мясо, субпродукты, яйца, рыба, овсяная крупа, грецкие орехи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12ddf31d-480e-39d9-b858-ae3bff1a1f69",
                                        "entry_id": "8c70513b-b998-38b7-9c0b-82d078f7a85d",
                                        "glosses": [
                                            "кулин. кушанье, приготовленное из такого продукта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32951c3a-8ba4-4b41-9290-d24c8c5818fe",
                                                "sense_id": "12ddf31d-480e-39d9-b858-ae3bff1a1f69",
                                                "text": "Всё было на столе: провесной балычок и копчёная утятина, мясо, вареники, блины с каймаком."
                                            },
                                            {
                                                "example_id": "ebd43337-3017-4c28-b434-fd41c018a60e",
                                                "sense_id": "12ddf31d-480e-39d9-b858-ae3bff1a1f69",
                                                "text": "Как и в оные блаженные дни, на длинном и узком столе расставлено было многое множество разного рода мяс, рыб, закусок, соусов, холодных и разных блюд."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54b1d1bc-cd2d-3e47-a8c3-3011a4a9c326",
                                        "entry_id": "8c70513b-b998-38b7-9c0b-82d078f7a85d",
                                        "glosses": [
                                            "разг. мягкая подкожная часть плодов и ягод, окружающая семя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf6f1bd5-1419-4ad3-ac4d-f6db285be2e9",
                                                "sense_id": "54b1d1bc-cd2d-3e47-a8c3-3011a4a9c326",
                                                "text": "— А что? — переспросил Полозов, пропуская в рот один из тех продольных ломтиков, на которые распадается мясо апельсина."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "887f9418-9271-3cd7-91ad-ab8d3a247c0d",
                                        "entry_id": "8c70513b-b998-38b7-9c0b-82d078f7a85d",
                                        "glosses": [
                                            "перен., разг. то, что составляет основной объём чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9e1dc5a-8177-4184-82a3-aaf8f814ad11",
                                                "sense_id": "887f9418-9271-3cd7-91ad-ab8d3a247c0d",
                                                "text": "Роль «мяса» отведена поправкам в Бюджетный и Налоговый кодексы ― они определят собственную доходную базу регионов и муниципалитетов, за счёт которой и должна финансироваться часть возложенных на них полномочий."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7826e9cc-982b-3ac0-a669-089f82664d5f",
                                        "entry_id": "8c70513b-b998-38b7-9c0b-82d078f7a85d",
                                        "glosses": [
                                            "жарг., пренебр. игроки или болельщики московского «Спартака»"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4d86cec-6255-4d78-8110-49460b025413",
                                                "sense_id": "7826e9cc-982b-3ac0-a669-089f82664d5f",
                                                "text": "Сегодня вечером «мясо» играет."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6154ea6e-243e-3306-bfc5-de41302dea5d",
                                        "entry_id": "8c70513b-b998-38b7-9c0b-82d078f7a85d",
                                        "glosses": [
                                            "комп. жарг. в компьютерных играх — кровопролитное сражение, а также игра, для которой характерны такие сражения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b066af70-71ce-46c3-9889-d3d80d6a5d4c",
                                                "sense_id": "6154ea6e-243e-3306-bfc5-de41302dea5d",
                                                "text": "Квейк — это сплошное мясо."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "207d7959-8400-3d01-89e1-4467027d9f47",
                                        "entry_id": "8c70513b-b998-38b7-9c0b-82d078f7a85d",
                                        "glosses": [
                                            "комп. жарг., пренебр., собир. в компьютерных играх — игроки низкой квалификации"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7601b83-d200-4303-904f-b93244068aa0",
                                                "sense_id": "207d7959-8400-3d01-89e1-4467027d9f47",
                                                "text": "Другими словами, надеюсь, что вы покинете армию онлайнового мяса, дерущегося в виражах на нулевой высоте с одной только целью — пострелять по противнику."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93912bb0-6367-36d5-84aa-cafe91290e31",
                                        "entry_id": "8c70513b-b998-38b7-9c0b-82d078f7a85d",
                                        "glosses": [
                                            "комп. жарг. в компьютерных играх — останки уничтоженных юнитов и игроков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54921c4d-9a9c-4aae-9c1b-05460fb1005b",
                                                "sense_id": "93912bb0-6367-36d5-84aa-cafe91290e31",
                                                "text": "Уровень пустой, только мясо от зомбей валяется."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d26b2155-9c6b-3702-b01f-ef7421af06d6",
                                        "entry_id": "8c70513b-b998-38b7-9c0b-82d078f7a85d",
                                        "glosses": [
                                            "картёж. жарг. в карточных играх — заведомо слабый игрок(и), принимаемые в игру, с целью лёгкого выигрыша у них"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13db4d44-7913-416d-a431-1e1f72ca2c55",
                                                "sense_id": "d26b2155-9c6b-3702-b01f-ef7421af06d6",
                                                "text": "Распишем пулю (сыграем партию в преферанс), если найдём мясо."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b59ea32c-ee44-3756-ba41-32d72f700088",
                                        "entry_id": "8c70513b-b998-38b7-9c0b-82d078f7a85d",
                                        "glosses": [
                                            "жарг. большое количество народа в каком-либо транспорте, намного большее, чем обычно"
                                        ],
                                        "tags": [],
