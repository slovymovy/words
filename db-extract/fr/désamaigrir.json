                        "glosses": [
                            "Rendre moins maigre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30df44b3-c684-4fef-8565-985fa294af5c",
                                "sense_id": "4dacb765-7244-3cac-b711-190d360c6738",
                                "text": "Je n’ai été occupé que du petit ouvrage [Le Roi est mort, vive le Roi!], à le lécher, à le désamaigrir."
                            },
                            {
                                "example_id": "18068434-bce5-4e25-96a0-54b8313dda98",
                                "sense_id": "4dacb765-7244-3cac-b711-190d360c6738",
                                "text": "Le vieil arbre désamaigri, En lui le regret se flétrit, La sérénité reverdoie ;"
                            }
                        ]
                    }
