                        "examples": [
                            {
                                "example_id": "ebb1555a-9911-4cba-9e2e-12f6486274a4",
                                "sense_id": "ca810c72-57e1-3e47-8679-d8bd90c6eceb",
                                "text": "Ze liepen naar de voordeur en belden aan.",
                                "translation": "They walked up to the front door and rang the bell.",
                                "english": "They walked up to the front door and rang the bell."
                            },
                            {
                                "example_id": "40d96f4e-5b0f-460d-8bf3-437e5dc55281",
                                "sense_id": "ca810c72-57e1-3e47-8679-d8bd90c6eceb",
                                "text": "Ik heb mijn sleutels in huis gelaten; kan je de voordeur voor me openen?",
                                "translation": "I left my keys inside; can you open the front door for me?",
                                "english": "I left my keys inside; can you open the front door for me?"
                            },
                            {
                                "example_id": "1d2fc1d7-3057-4be3-9b0d-bcccfff1365e",
                                "sense_id": "ca810c72-57e1-3e47-8679-d8bd90c6eceb",
                                "text": "De voordeur was versierd met kerstkransen.",
                                "translation": "The front door was adorned with Christmas wreaths.",
                                "english": "The front door was adorned with Christmas wreaths."
                            }
                        ]
