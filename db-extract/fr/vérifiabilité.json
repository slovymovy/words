                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verifiability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de68b87b-37e7-3549-8c48-6b386e6e8654",
                                        "entry_id": "fa9ffd0c-fe04-3819-8262-6edfcc348ed1",
                                        "glosses": [
                                            "The state or property of being capable of being verified; confirmability."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da53262c-2f53-4baa-8f55-06ca9c7e700f",
                                                "sense_id": "de68b87b-37e7-3549-8c48-6b386e6e8654",
                                                "text": "Mill distinguished between hypotheses which rest on mere analogy and such as are capable of \"being ultimately brought to the test of actual induction,\" claiming for the latter a verifiability which he denied to the former."
                                            },
                                            {
                                                "example_id": "2134a9cb-433f-4c36-9f9d-c97571f790b5",
                                                "sense_id": "de68b87b-37e7-3549-8c48-6b386e6e8654",
                                                "text": "1973 , James C. McKeown, \"Comparative Application of Market and Cost Based Accounting Models,\" Journal of Accounting Research, vol. 11, no. 1, p. 99,\nThe verifiabilities of the other measurement systems were very similar."
                                            },
                                            {
                                                "example_id": "e0bf98fa-9921-4c3a-b3a2-b600f84d9409",
                                                "sense_id": "de68b87b-37e7-3549-8c48-6b386e6e8654",
                                                "text": "The issues of veracity and verifiability raised by testimony in trials emerge with a vengeance in the context of the Truth and Reconciliation Commission."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
