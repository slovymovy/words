        "fr-extract.jsonl": [
            {
                "entry_id": "228270fe-57a4-373f-ac61-71dd07a070cc",
                "word": "bréviaire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d8d851ba-0281-4e3c-9731-c34026e79f0e",
                        "entry_id": "228270fe-57a4-373f-ac61-71dd07a070cc",
                        "tags": [
                            "plural"
                        ],
                        "form": "bréviaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a30fced5-3a8e-31d0-b012-f485027027a4",
                        "entry_id": "228270fe-57a4-373f-ac61-71dd07a070cc",
                        "glosses": [
                            "Livre contenant les offices que ceux qui sont dans les ordres sacrés sont obligés de dire tous les jours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03e66a14-9717-4fbb-8c07-c4de3a45d054",
                                "sense_id": "a30fced5-3a8e-31d0-b012-f485027027a4",
                                "text": "Quiconque a vu, comme moi, le père Aubry cheminant seul avec son bâton et son bréviaire dans le désert, a une véritable idée du voyageur chrétien sur la terre."
                            },
                            {
                                "example_id": "56491f08-606c-4790-b86a-b3795cceac16",
                                "sense_id": "a30fced5-3a8e-31d0-b012-f485027027a4",
                                "text": "[…] ce visiteur était une espèce de prêtre champêtre qui […] estime qu’une tranche de lard vaut dix pages de son bréviaire."
                            },
                            {
                                "example_id": "117606e2-0738-4fa7-a057-7444d7266247",
                                "sense_id": "a30fced5-3a8e-31d0-b012-f485027027a4",
                                "text": "Et fermant la marche, quelques ecclésiastiques en retard se hâtaient, […], s’interrompant pour rattraper le bréviaire qui glissait sous le bras, […]."
                            },
                            {
                                "example_id": "08f58341-1018-4fae-bed0-32710a897c2c",
                                "sense_id": "a30fced5-3a8e-31d0-b012-f485027027a4",
                                "text": "Ce volume, petit in-32, semblable à un Annuaire du Bureau des Longitudes, est recouvert de drap pelucheux comme un bréviaire de chanoine, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "33481749-b578-34d3-9367-9dcc203e45f3",
                        "entry_id": "228270fe-57a4-373f-ac61-71dd07a070cc",
                        "glosses": [
                            "Ces offices mêmes que disent chaque jour ceux qui y sont obligés."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6bcba290-fc33-4582-bf3b-81d85158b2bc",
                                "sense_id": "33481749-b578-34d3-9367-9dcc203e45f3",
                                "text": "Dire, réciter son bréviaire."
                            },
                            {
                                "example_id": "f0914f94-8142-486b-b2e6-d1de63da96a6",
                                "sense_id": "33481749-b578-34d3-9367-9dcc203e45f3",
                                "text": "Cet homme aurait fait empaler Zadig pour la plus grande gloire du soleil, et en aurait récité le bréviaire de Zoroastre d'un ton plus satisfait."
                            }
                        ]
                    },
                    {
                        "sense_id": "7df265b1-d3f3-3cb2-852b-e87125ee1726",
                        "entry_id": "228270fe-57a4-373f-ac61-71dd07a070cc",
                        "glosses": [
                            "Livre dont on fait sa lecture habituelle."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ec86a5dd-7167-33aa-bec9-05537dd67b76",
                        "entry_id": "228270fe-57a4-373f-ac61-71dd07a070cc",
                        "glosses": [
                            "Livre qui indique une marche à suivre."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b159a791-9aef-42ab-8c74-8ee3a332b652",
                                "sense_id": "ec86a5dd-7167-33aa-bec9-05537dd67b76",
                                "text": "Si nous n'avons pas encore le bréviaire de la révolution que Lucien Herr avait annoncé en 1900, nous savons tout au moins qu'il y a déjà des règlements tout préparés pour assurer le service de la comptabilité dans la société collectiviste […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
