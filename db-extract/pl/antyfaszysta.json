                    {
                        "sense_id": "e3c82b5f-885e-3d8a-a95d-af7a56d251c1",
                        "entry_id": "5ebd483e-e6f7-3131-b72b-e90b29ccf490",
                        "glosses": [
                            "przeciwnik faszyzmu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fa65e28-e96e-4fea-8258-905984d4d935",
                                "sense_id": "e3c82b5f-885e-3d8a-a95d-af7a56d251c1",
                                "text": "Wśród antyfaszystów są komuniści, socjaliści, liberałowie, konserwatyści oraz ludzie wszelkich światopoglądów i ideologii."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c210210-18fb-4203-8f96-c5ff0421a5b7",
                        "source_entry_id": "5ebd483e-e6f7-3131-b72b-e90b29ccf490",
