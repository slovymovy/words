                "senses": [
                    {
                        "sense_id": "12f4f4be-fc0a-3c14-8f1c-9b41bd9fb7a1",
                        "entry_id": "62d91a73-f2d5-38d2-b24d-825aee303c9c",
                        "glosses": [
                            "künstliche Erhöhung, die mit Birken bepflanzt ist, um Nutztiere von den Feldern abzuhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d76f7d7-0f42-4b82-b100-068062d78f83",
                                "sense_id": "12f4f4be-fc0a-3c14-8f1c-9b41bd9fb7a1",
                                "text": "„Ein guter Haushalter kann einen solchen Birkenwall in 4-6jähriger Haue eintheilen, jedes Jahr einen Theil im Frühjahr abtreiben, und alsdann, wo es fehlen sollte, wieder Stangen ankniken.“"
                            },
                            {
                                "example_id": "c016afb9-f050-470a-b7f4-f29949c9bebb",
                                "sense_id": "12f4f4be-fc0a-3c14-8f1c-9b41bd9fb7a1",
                                "text": "„Es ist auch noch Zeit, Birken zu verpflanzen, wenn sie eben ausbrechen; insbesondere wenn ihr Birkenwälle anlegen wollt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
