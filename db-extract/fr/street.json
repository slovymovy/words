                "senses": [
                    {
                        "sense_id": "324d0b96-aa87-3707-a660-ceb6963db678",
                        "entry_id": "36db9775-ac85-3938-828f-187cd159d82d",
                        "glosses": [
                            "Rue."
                        ],
                        "tags": [
                            "Anglicism",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "4f045b6a-1fa3-40bb-ace9-4645cfcc8d4f",
                                "sense_id": "324d0b96-aa87-3707-a660-ceb6963db678",
                                "text": "Dès les premières marches ils rencontrèrent des traces de sang. Au bas du casse-cou, dans la ruelle étroite et sans nom qui redescend dans la street, ils trouvèrent un sanglant et informe pêle-mêle. Le cheval avait été littéralement broyé."
                            },
                            {
                                "example_id": "3a8e7318-a795-4688-b98f-a76f83f88269",
                                "sense_id": "324d0b96-aa87-3707-a660-ceb6963db678",
                                "text": "Nous traversâmes plusieurs de ces rues hautes de Saint-Pierre-Port où l’herbe pousse et nous descendîmes une street assez large qui plonge dans un des quatre ou cinq ravins dont la ville est coupée."
                            },
                            {
                                "example_id": "3c0d3624-9bef-4493-b1a1-3541d8d55094",
                                "sense_id": "324d0b96-aa87-3707-a660-ceb6963db678",
                                "text": "Nous traçons à folle allure. Pour peu que le moteur soit fatigué et bouffe de l'huile, l’échappement doit tracer un sillage bleuté dans les streets."
                            },
                            {
                                "example_id": "54bfa281-d1b8-4c57-9d72-6a2be0b0f236",
                                "sense_id": "324d0b96-aa87-3707-a660-ceb6963db678",
                                "text": "— J’suis marié à la street"
                            }
                        ]
                    }
                ],
