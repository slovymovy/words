                ],
                "senses": [
                    {
                        "sense_id": "9cc3bba9-dad5-3145-b28b-ce53288688d7",
                        "entry_id": "245c2865-80e9-3f73-8777-30c8e44afc01",
                        "glosses": [
                            "Négociation de paix, tractation pour aboutir à la paix (généralement en pluriel)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9886ea76-efb7-4ccc-969e-330a2027290d",
                                "sense_id": "9cc3bba9-dad5-3145-b28b-ce53288688d7",
                                "text": "Über die Rückkehr entlassener Heeresangehöriger des einen Landes, die jenseits der Demarkationslinie des anderen Landes beheimatet sind, kann erst bei den Friedensverhandlungen entschieden werden."
                            },
                            {
                                "example_id": "6c3d02ae-8ae2-4d66-bc81-37d3bca7c119",
                                "sense_id": "9cc3bba9-dad5-3145-b28b-ce53288688d7",
                                "text": "Als Mitglied der ägyptischen Delegation nimmt (Nasser) im selben Monat an den Friedensverhandlungen mit Israel auf der Insel Rhodos teil.",
                                "translation": "En tant que membre de la délégation égyptienne, (Nasser) participe aux négociations de paix avec Israël sur l'île de Rhodes le même mois."
                            }
                        ]
                    }
                ],
