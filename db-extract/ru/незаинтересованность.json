                    }
                ],
                "translations": [
                    {
                        "translation_id": "019aaab1-8abd-4c6f-a27a-01050f0b57eb",
                        "source_entry_id": "2fb59f35-e7cd-329e-8cd0-4c8c2c4725cb",
                        "source_sense_id": "a855f8ee-8277-3553-8a5a-04702a5aa1d5",
                        "target_lang_word": "indifference",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indifference",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8211dc7b-db8d-3724-99de-b6801dc58e8e",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "The state of being indifferent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d345c28b-656b-4d8a-8a21-7e08bc97b6b4",
                                                "sense_id": "8211dc7b-db8d-3724-99de-b6801dc58e8e",
                                                "text": "\"I do not care for them; I would not have them now,\" cried Lady Penrhyn; \"it is only your affection I care for. Do not suppose, for a moment, that I wish for the tables when you do not: oh, no! my only concern was for your indifference. But I am content if you tell me I was mistaken.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a27db88c-7273-307a-8052-46118583ce1b",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "Unbiased impartiality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de990e00-d921-3dc4-9660-7bec3d0ef936",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "Unemotional apathy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe74535a-2673-4243-b1ba-a0c645804ac4",
                                                "sense_id": "de990e00-d921-3dc4-9660-7bec3d0ef936",
                                                "text": "His daughter's indifference towards the sexist group made him wonder if she felt no empathy for the bullied."
                                            },
                                            {
                                                "example_id": "59bc99c5-eb46-4f3c-b268-f80e9563c626",
                                                "sense_id": "de990e00-d921-3dc4-9660-7bec3d0ef936",
                                                "text": "I wish the consequences of this moment for young women punctured the apparent indifference of so many men and boys I saw that day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f444eaa-e3f2-3a51-aa04-1b3a0d65594b",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "A lack of enthusiasm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc199469-40a1-3131-9fcc-60afdb8c26b5",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "Unconcerned nonchalance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24b5fe27-4d36-434c-8cad-fdf51614a63c",
                                                "sense_id": "bc199469-40a1-3131-9fcc-60afdb8c26b5",
                                                "text": "I liked the man for his own sake, and even had he promised to turn out a celebrity it would have had no weight with me. I look upon notoriety with the same indifference as on the buttons on a man's shirt-front, or the crest on his note-paper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f9ba4cb-8ccf-3405-b6f5-330befd59489",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "Self-identity defined through the negation of difference, non-difference."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c41dda57-14d0-4802-9f64-925669bf2cc3",
                                                "sense_id": "9f9ba4cb-8ccf-3405-b6f5-330befd59489",
                                                "text": "\"I call reason absolute reason, or reason insofar as it is conceived as the total indifference of the subjective and objective.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13e41583-6507-4929-b7bc-1ce6e66d13e8",
                        "source_entry_id": "2fb59f35-e7cd-329e-8cd0-4c8c2c4725cb",
                        "source_sense_id": "a855f8ee-8277-3553-8a5a-04702a5aa1d5",
                        "target_lang_word": "uninterest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uninterest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5ab178d-13ab-3e6b-be6f-1e66fb33b609",
                                        "entry_id": "c961f112-21d5-3bfb-826e-00cdf8133af1",
                                        "glosses": [
                                            "Lack of interest; indifference."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1feef662-7d70-4508-b265-39dce7f67ab0",
                                                "sense_id": "a5ab178d-13ab-3e6b-be6f-1e66fb33b609",
                                                "text": "'Yeah,' said my delightful inquisitor, with an attempt at casual indifference or uninterest that to the tutored eye only revealed all the more starkly her rising excitement […]"
                                            },
                                            {
                                                "example_id": "9ebb9ee8-c5ba-42c7-a333-f60671d26ee4",
                                                "sense_id": "a5ab178d-13ab-3e6b-be6f-1e66fb33b609",
                                                "text": "Not many general topics appealed to Sophie, and the question of Wales or being Welsh stood high in her uninterests."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ed29da9-16f6-432c-8524-03471feeed95",
                        "source_entry_id": "2fb59f35-e7cd-329e-8cd0-4c8c2c4725cb",
                        "source_sense_id": "a855f8ee-8277-3553-8a5a-04702a5aa1d5",
                        "target_lang_word": "lack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d24e9c12-373c-3b47-87e9-85b0523c1c96",
                                        "entry_id": "a7df7697-9afb-3150-90f6-c519425718dc",
                                        "glosses": [
                                            "A deficiency or need (of something desirable or necessary); an absence, want, dearth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7b99ee4-fd45-4f0d-aadc-4fe2d2ebcebd",
                                                "sense_id": "d24e9c12-373c-3b47-87e9-85b0523c1c96",
                                                "text": "[…] let his lack of years be no impediment to let him lack a reverend estimation;"
                                            },
                                            {
                                                "example_id": "cb0b79c2-2308-4a43-a757-adbf961b4727",
                                                "sense_id": "d24e9c12-373c-3b47-87e9-85b0523c1c96",
                                                "text": "I went to a shrink, to analyze my dreams. He said it's lack of sex that's bringing me down."
                                            },
                                            {
                                                "example_id": "a9aec3fb-af32-40c1-8854-c3dace553090",
                                                "sense_id": "d24e9c12-373c-3b47-87e9-85b0523c1c96",
                                                "text": "If Moldova harboured even the slightest hopes of pulling off a comeback that would have bordered on miraculous given their lack of quality, they were snuffed out 13 minutes before the break when Oxlade-Chamberlain picked his way through midfield before releasing Defoe for a finish that should have been dealt with more convincingly by Namasco at his near post."
                                            },
                                            {
                                                "example_id": "4d879a7d-f1b2-439d-a7c5-0871f1353192",
                                                "sense_id": "d24e9c12-373c-3b47-87e9-85b0523c1c96",
                                                "text": "More flak was aimed at the Treasury's apparent lack of marketing skills, when it was argued that its idea of how to sell tickets was along the lines of \"you can get two tickets for the price of two\", and it lacks the sales and promotional skills of the train operating companies which are needed to boost revenue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad7357e3-3577-3e1a-bd33-30ecdd6303cc",
                                        "entry_id": "a7df7697-9afb-3150-90f6-c519425718dc",
                                        "glosses": [
                                            "A defect or failing; moral or spiritual degeneracy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ecacf5d-3d03-4dbb-b488-c807cf4e1602",
                                                "sense_id": "ad7357e3-3577-3e1a-bd33-30ecdd6303cc",
                                                "text": "In the old days, to my commonplace and unobserving mind, he gave no evidences of genius whatsoever. He never read me any of his manuscripts, […], and therefore my lack of detection of his promise may in some degree be pardoned."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a9aeb9b-0d7d-3527-9ded-191ebc6de41b",
                                        "entry_id": "25e613a4-d8f2-3ac1-a851-51b9bf2d9ab9",
                                        "glosses": [
                                            "To be without, not to have, to need, to require."
                                        ],
                                        "tags": [
                                            "stative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c16ed48f-951e-4602-9ecf-80849c7dd839",
                                                "sense_id": "2a9aeb9b-0d7d-3527-9ded-191ebc6de41b",
                                                "text": "My life lacks excitement."
                                            },
                                            {
                                                "example_id": "59eecf70-d301-44a7-981a-bba6eb8fda67",
                                                "sense_id": "2a9aeb9b-0d7d-3527-9ded-191ebc6de41b",
                                                "text": "More flak was aimed at the Treasury's apparent lack of marketing skills, when it was argued that its idea of how to sell tickets was along the lines of \"you can get two tickets for the price of two\", and it lacks the sales and promotional skills of the train operating companies which are needed to boost revenue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b71ffc5-78fa-39e8-8f6a-d5be9826a6b8",
                                        "entry_id": "25e613a4-d8f2-3ac1-a851-51b9bf2d9ab9",
                                        "glosses": [
                                            "To be short (of or for something)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a293391-8687-4ac4-861d-7e439b1088e6",
                                                "sense_id": "9b71ffc5-78fa-39e8-8f6a-d5be9826a6b8",
                                                "text": "He'll never lack for company while he's got all that money."
                                            },
                                            {
                                                "example_id": "8a53cbd7-cb33-4721-b50f-a1f19e5e4102",
                                                "sense_id": "9b71ffc5-78fa-39e8-8f6a-d5be9826a6b8",
                                                "text": "Hamlet. What hour now?\nHoratio. I think it lacks of twelve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edf760df-16fe-3d01-9718-e30f582fc519",
                                        "entry_id": "25e613a4-d8f2-3ac1-a851-51b9bf2d9ab9",
                                        "glosses": [
                                            "To be in want."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "561de3d9-fb24-4622-8cce-4e8fcfc2bed4",
                                                "sense_id": "edf760df-16fe-3d01-9718-e30f582fc519",
                                                "text": "The young lions do lack, and suffer hunger […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7740c79-51fc-3d31-a112-59d58f85bb06",
                                        "entry_id": "25e613a4-d8f2-3ac1-a851-51b9bf2d9ab9",
                                        "glosses": [
                                            "To see the deficiency in (someone or something); to find fault with, to malign, reproach."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39c04724-b4ed-499d-ba21-66f17f203045",
                                                "sense_id": "e7740c79-51fc-3d31-a112-59d58f85bb06",
                                                "text": "That is Mede þe Mayde quod she · hath noyed me ful oft / And ylakked my lemman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e141bf08-5849-3f8c-9f52-1c53775dba24",
                                        "entry_id": "25e613a4-d8f2-3ac1-a851-51b9bf2d9ab9",
                                        "glosses": [
                                            "To be off one's guard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "242cbab2-7a57-4b0d-b76c-ac37fea396ee",
                                                "sense_id": "e141bf08-5849-3f8c-9f52-1c53775dba24",
                                                "text": "His opps caught him lacking."
                                            }
                                        ]
                                    }
                                ]
                            },
