                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "c1c42c9d-cd5b-4161-9537-b71c95848211",
                                "sense_id": "0dae2d93-720f-3a10-ae4f-705e50f191a7",
                                "text": "[…]having no regard of me, and never looking upon me but as the scumber of the world."
                            },
                            {
                                "example_id": "346559eb-cddc-497c-9340-5a61db5ea906",
                                "sense_id": "0dae2d93-720f-3a10-ae4f-705e50f191a7",
                                "text": "A human vulture, God sent thee The world's great scavenger to be. To cleanse it of its scumber;"
                            },
                            {
                                "example_id": "b1c4c2dc-73e4-4d1f-83d2-988295109b02",
                                "sense_id": "0dae2d93-720f-3a10-ae4f-705e50f191a7",
                                "text": "[…] the Scumber of the Fox, the Spraints of the Otter[…]"
                            },
                            {
                                "example_id": "99b8b0b6-5cd7-4f9e-b0a5-0168f5ca6808",
                                "sense_id": "0dae2d93-720f-3a10-ae4f-705e50f191a7",
                                "text": "Let’s see, if by your scumber, you are fox!"
                            },
                            {
                                "example_id": "d1077ae1-f93c-4516-91a3-7259a1a4ee2a",
                                "sense_id": "0dae2d93-720f-3a10-ae4f-705e50f191a7",
                                "text": "Someone shouts something and he turns and shouts back, ‘Just going for a scumber, all right? Back in a moment."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
