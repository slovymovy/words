                    },
                    {
                        "translation_id": "d89ac6d0-0906-4561-8a12-47b97393d22e",
                        "source_entry_id": "c213af1c-6104-3ac5-b94a-fc5fece631a1",
                        "source_sense_id": "9b3aa9f2-438b-3806-80e9-88a8a2aeddf9",
                        "source_sense_description": "(Maßnahme zur) Erhöhung der Widerstandskraft oder Stärkung des Immunsystems",
                        "target_lang_word": "induration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "induration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d550d278-4dee-352e-b924-4531f66448b2",
                                        "entry_id": "88789cfc-58fc-3cab-9505-8cf11adc6992",
                                        "glosses": [
                                            "Hardness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "523a0964-3b5c-4766-b355-a47f4556b300",
                                                "sense_id": "d550d278-4dee-352e-b924-4531f66448b2",
                                                "text": "The voice was harder than I had known, and not only in stony reaction to long floods of wholly just selfpity, also roughened with gin and smoke, perhaps also assimilated to New York induration, the hardness of culture as well as of pain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcf713cb-0d28-3383-aa94-12221be06a0b",
                                        "entry_id": "88789cfc-58fc-3cab-9505-8cf11adc6992",
                                        "glosses": [
                                            "An enduring presence; fixity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11c407a1-f0ea-4fb3-8f0c-200d274152df",
                                                "sense_id": "fcf713cb-0d28-3383-aa94-12221be06a0b",
                                                "text": "Even the putatively innocuous whimsical shapes and designs of cakes and pastry, notably in Central Europe, retain to this day the phallic concept, the cryptic induration of the aphrodisiac function."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74f8715b-1753-344d-ab6a-f1c0124c9329",
                                        "entry_id": "88789cfc-58fc-3cab-9505-8cf11adc6992",
                                        "glosses": [
                                            "The process of becoming hard."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "657f8d69-23ba-3a2d-b160-1768cbb8f8a6",
                                        "entry_id": "88789cfc-58fc-3cab-9505-8cf11adc6992",
                                        "glosses": [
                                            "A hardening of an area of the body as a reaction to inflammation, hyperemia, or neoplastic infiltration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49102d62-9c7d-3684-99e8-ac2a9b9b02f3",
                                        "entry_id": "88789cfc-58fc-3cab-9505-8cf11adc6992",
                                        "glosses": [
                                            "An area or part of the body that has undergone such a reaction."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba2a9e20-7870-4dce-9336-05ae94bd5e14",
                                                "sense_id": "49102d62-9c7d-3684-99e8-ac2a9b9b02f3",
                                                "text": "Both erythema and induration appear to be adequate indices of tuberculin sensitivity."
                                            },
                                            {
                                                "example_id": "450b76a0-de7b-406f-b99f-fcf14cf17cbc",
                                                "sense_id": "49102d62-9c7d-3684-99e8-ac2a9b9b02f3",
                                                "text": "The erythema had spread to 20 cm, and the central induration had spread to 9 cm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46754008-af5d-31d1-a520-66d6dcff1a6f",
                                        "entry_id": "88789cfc-58fc-3cab-9505-8cf11adc6992",
                                        "glosses": [
                                            "The quality of nonfriability; the extent to which a rock does not crumble; rock strength."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b081251f-2ba6-4bc5-a12e-c3699ad92ceb",
                                                "sense_id": "46754008-af5d-31d1-a520-66d6dcff1a6f",
                                                "text": "\"Induration is a measure of rock \"strength\" and is defined as the ratio of the measured frame modulus to the maximum frame modulus allowed by the Gassmann-Biot model.\" Spratt, R. S.; Goins, N. R. and Fitch, T. J. (1993) \"Pseudo-shear — The analysis of AVO.\" Castagna, John P. and Backus, Milo M. (eds.) Offset-Dependent Reflectivity — Theory and Practice of AVO Analysis. Series: Investigation in Geophysics volume 8. Tulsa : Society of Exploration Geophysicistspp. 37-56, page 37, isbn 978-1-56080-059-0."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4e92730-f5cc-30c8-888e-812d2eb22206",
                                        "entry_id": "88789cfc-58fc-3cab-9505-8cf11adc6992",
                                        "glosses": [
                                            "The process of the strengthening of rocks by heating, compaction or cementation, or a combination thereof."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2428a94-d117-41df-b739-63e83ff444e8",
                                                "sense_id": "e4e92730-f5cc-30c8-888e-812d2eb22206",
                                                "text": "\"Induration of carbonate rocks proceeds predominately in the early stages (prior to diagenesis) by compaction and expulsion of fluids.\" Whittaker, Alun (1985) Formation Evaluation: Geological Procedures Dordrecht : Springer Verlag page 104, isbn 978-94-010-8861-9."
                                            },
                                            {
                                                "example_id": "7b8e914e-a915-4418-a67a-71f25c841297",
                                                "sense_id": "e4e92730-f5cc-30c8-888e-812d2eb22206",
                                                "text": "\"At a given degree of induration, massive rocks of sandstone, siltstone, and limestone are the strongest, while shaly rocks with more or less parallel, closely spaced separation surfaces created during sedimentation in thin layers are the weakest.\" Committee on Underground Coal Mine Safety (1982) Toward Safer Underground Coal Mines Washington, D.C. : National Academy Press, page 32, isbn 978-0-309-03298-8."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
