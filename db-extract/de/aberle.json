                "senses": [
                    {
                        "sense_id": "7454e3da-effb-38a0-a048-734ac962bdb9",
                        "entry_id": "5d951d44-e26d-3db7-bbac-947c1b805dd2",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname, in Deutschland und Österreich vertreten, der Schwerpunkt des Vorkommens liegt in und um den Schwarzwald herum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66937dae-44ce-4a23-a39f-f4e791ca33ff",
                                "sense_id": "7454e3da-effb-38a0-a048-734ac962bdb9",
                                "text": "Fritz Aberle sitzt zurzeit im Gefängnis."
                            },
                            {
                                "example_id": "2868de8f-39c5-4e15-85f6-d8506f716117",
                                "sense_id": "7454e3da-effb-38a0-a048-734ac962bdb9",
                                "text": "Die Aberles haben einen sehr eigenen Humor."
                            },
                            {
                                "example_id": "6f359557-1117-40a4-872c-0024b2aaecc1",
                                "sense_id": "7454e3da-effb-38a0-a048-734ac962bdb9",
                                "text": "Der Aberle hat eine Vorliebe für das Mettwurstballett, was auf eben diesen Humor hinweist."
                            }
                        ],
