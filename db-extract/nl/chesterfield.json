                                "example_id": "f3b12fae-fcdb-4c5a-849c-bfbb9debb088",
                                "sense_id": "3723ce97-672d-3370-babb-30f0fbfae638",
                                "text": "Als het publiek binnenkomt zit zijn zus Leonore op de chesterfield kransen van laurierblad te vlechten."
                            },
