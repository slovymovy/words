                "senses": [
                    {
                        "sense_id": "3446357d-c60b-3a0a-a4ee-8cea295dc716",
                        "entry_id": "98c58995-7984-31f1-8c01-c29c9c5879aa",
                        "glosses": [
                            "van iets dat het vermoeidheid en spanning doet verminderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cd997eb-1a33-4a71-964c-cbe4dc9a7645",
                                "sense_id": "3446357d-c60b-3a0a-a4ee-8cea295dc716",
                                "text": "Sylvie Meis voelt zich fris en fruitig na een ontspannende douche in een vijfsterrenhotel in Berlijn. La Meis bereidt zich - wachtend op haar goede vriendin en sterrenstyliste Serena Goldenbaum - daar voor op het zogenoemde Dreamball: een liefdadigheidsbal waarvan de opbrengst naar onder andere kankeronderzoek gaat."
                            },
                            {
                                "example_id": "cfa9519c-65c8-4ff6-9f5f-0236f4285d6c",
                                "sense_id": "3446357d-c60b-3a0a-a4ee-8cea295dc716",
                                "text": "Rijden met de Kadjar is niet echt enerverend, maar wel een uiterst ontspannende ervaring. Niet in de laatste plaats door het comfortabele onderstel, het uitstekende zicht rondom en de hoge zitpositie."
                            }
                        ]
                    }
