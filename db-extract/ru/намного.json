                        "source_sense_id": "a4bb9ca7-1047-365a-bfca-4219ec60f4c4",
                        "target_lang_word": "much",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "much",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "589bcf3b-3ef6-3ee8-ad5d-005f6346d668",
                                        "entry_id": "b2f045fb-8cc6-37da-91c5-03b8a98c19b4",
                                        "glosses": [
                                            "A large amount of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f862319-c4c6-4002-b901-63194523b9c8",
                                                "sense_id": "589bcf3b-3ef6-3ee8-ad5d-005f6346d668",
                                                "text": "Do you think I have much chance of catching the train on time?"
                                            },
                                            {
                                                "example_id": "43640354-07b9-4eae-9f41-f99d35a91c37",
                                                "sense_id": "589bcf3b-3ef6-3ee8-ad5d-005f6346d668",
                                                "text": "After much discussion, we decided to set about the task with much enthusiasm."
                                            },
                                            {
                                                "example_id": "2db7e168-80b8-46b5-b837-db6da2a21fb0",
                                                "sense_id": "589bcf3b-3ef6-3ee8-ad5d-005f6346d668",
                                                "text": "Much of literature is concerned with stylistics."
                                            },
                                            {
                                                "example_id": "9604c7bd-856a-436d-ba49-45ceb915a433",
                                                "sense_id": "589bcf3b-3ef6-3ee8-ad5d-005f6346d668",
                                                "text": "As it was, he did nothing with much zeal, but sport; and his time was otherwise trifled away, without benefit from books or anything else."
                                            },
                                            {
                                                "example_id": "93686de4-6c69-4742-a6d3-51013eeb7f09",
                                                "sense_id": "589bcf3b-3ef6-3ee8-ad5d-005f6346d668",
                                                "text": "Unless matters take a nastier turn, neither side has much incentive to compromise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26ecf76f-6618-3e30-95c4-924d9328aee8",
                                        "entry_id": "b2f045fb-8cc6-37da-91c5-03b8a98c19b4",
                                        "glosses": [
                                            "Used to indicate, demonstrate or compare the quantity of something."
                                        ],
                                        "tags": [
                                            "in combinations such as 'as much'"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e227dcd8-b25e-48aa-91f2-e87cc807698d",
                                                "sense_id": "26ecf76f-6618-3e30-95c4-924d9328aee8",
                                                "text": "Add this much water and no more."
                                            },
                                            {
                                                "example_id": "9e842742-bbea-47bc-befe-507f5baec03a",
                                                "sense_id": "26ecf76f-6618-3e30-95c4-924d9328aee8",
                                                "text": "Take as much time as you like."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a2b0d16-f957-34a0-8d06-69293e8d0dd5",
                                        "entry_id": "b2f045fb-8cc6-37da-91c5-03b8a98c19b4",
                                        "glosses": [
                                            "A great number of; many (people)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e839f4aa-0111-498e-b578-37826753da49",
                                                "sense_id": "0a2b0d16-f957-34a0-8d06-69293e8d0dd5",
                                                "text": "ye shall not nede to seke hym soo ferre sayd the Kynge / for as I here saye sir Launcelot will abyde me and yow in the Ioyous gard / and moche peple draweth vnto hym as I here saye"
                                            },
                                            {
                                                "example_id": "4ab5cf3f-c6bc-43ff-9621-8ab568ad276a",
                                                "sense_id": "0a2b0d16-f957-34a0-8d06-69293e8d0dd5",
                                                "text": "When Jesus was come downe from the mountayne, moch people folowed him."
                                            },
                                            {
                                                "example_id": "732b0b2a-c2f5-4e64-9cd1-f2d8f4a29c57",
                                                "sense_id": "0a2b0d16-f957-34a0-8d06-69293e8d0dd5",
                                                "text": "There wasn't much people about that day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d624093-4851-31f8-9197-2df8de7f9c04",
                                        "entry_id": "b2f045fb-8cc6-37da-91c5-03b8a98c19b4",
                                        "glosses": [
                                            "many ( + plural countable noun)."
                                        ],
                                        "tags": [
                                            "Caribbean",
                                            "UK",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80342755-728a-4ed4-83d1-979b4bd30d59",
                                                "sense_id": "8d624093-4851-31f8-9197-2df8de7f9c04",
                                                "text": "They got so much things to say right now, they got so much things to say."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "much",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efb79cb9-5880-3631-91c5-192a02800f3d",
                                        "entry_id": "62d3ae6f-0acb-38ad-80ca-5067271bafd6",
                                        "glosses": [
                                            "Large, great."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9c539a7-b0cb-4ba7-8263-76b408299fc5",
                                                "sense_id": "efb79cb9-5880-3631-91c5-192a02800f3d",
                                                "text": "Thenne launcelot vnbarred the dore / and with his lyfte hand he held it open a lytel / so that but one man myghte come in attones / and soo there came strydyng a good knyghte a moche man and large / and his name was Colgreuaunce / of Gore / and he with a swerd strake at syr launcelot myȝtely and he put asyde the stroke"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "780b80c9-1145-331b-8e33-b24e26755ad3",
                                        "entry_id": "62d3ae6f-0acb-38ad-80ca-5067271bafd6",
                                        "glosses": [
                                            "Long in duration."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "much",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8ac916d-4bb5-3110-9bfa-043a96997554",
                                        "entry_id": "e6ac6306-d246-38a3-9ced-ca36302a682b",
                                        "glosses": [
                                            "To a great extent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25a074c7-77ed-4403-9749-317b01dbbfd3",
                                                "sense_id": "d8ac916d-4bb5-3110-9bfa-043a96997554",
                                                "text": "I don't like melon much, and I don’t much care for milk chocolate either: I find them both much too sweet."
                                            },
                                            {
                                                "example_id": "67114d19-7354-4e59-94c7-85f7925fcd66",
                                                "sense_id": "d8ac916d-4bb5-3110-9bfa-043a96997554",
                                                "text": "However much I eat, I never get fat."
                                            },
                                            {
                                                "example_id": "50ff714a-e64f-4dae-8c62-65ecd0b51ab8",
                                                "sense_id": "d8ac916d-4bb5-3110-9bfa-043a96997554",
                                                "text": "He left her, much to the satisfaction of her other suitor."
                                            },
                                            {
                                                "example_id": "3436fcb5-c6ee-40fb-a5d4-3f301a0c7af2",
                                                "sense_id": "d8ac916d-4bb5-3110-9bfa-043a96997554",
                                                "text": "That boyfriend of yours is much {like - the same as} the others."
                                            },
                                            {
                                                "example_id": "7a63d013-88e1-4932-9d0d-54f5205fccf4",
                                                "sense_id": "d8ac916d-4bb5-3110-9bfa-043a96997554",
                                                "text": "My English was much the worst, and I'm certainly not much good at math either, of that I'm very much aware."
                                            },
                                            {
                                                "example_id": "b5c4a6ae-96ce-4a42-8f7c-304dcd84b12d",
                                                "sense_id": "d8ac916d-4bb5-3110-9bfa-043a96997554",
                                                "text": "Both candidates, who are much of an age, say much the same thing, but the youngest shows much the commoner behavior of the two."
                                            },
                                            {
                                                "example_id": "5ff244c6-8a39-463c-8e66-5822aa77fd90",
                                                "sense_id": "d8ac916d-4bb5-3110-9bfa-043a96997554",
                                                "text": "They stayed together during three dances, went out on to the terrace, explored wherever they were permitted to explore, paid two visits to the buffet, and enjoyed themselves much in the same way as if they had been school-children surreptitiously breaking loose from an assembly of grown-ups."
                                            },
                                            {
                                                "example_id": "05555112-9ef4-4f53-866f-88e616817673",
                                                "sense_id": "d8ac916d-4bb5-3110-9bfa-043a96997554",
                                                "text": "I can’t lie (I miss you much). Watching every day that goes by (I miss you much)."
                                            },
                                            {
                                                "example_id": "68a8040c-0209-4665-98a3-42dc878472b9",
                                                "sense_id": "d8ac916d-4bb5-3110-9bfa-043a96997554",
                                                "text": "Tangling with Ziv, Cameron caught him with a flailing elbow, causing the Israeli defender to go down a little easily. However, the referee was in no doubt, much to the displeasure of the home fans."
                                            },
                                            {
                                                "example_id": "8f7b32db-9017-4bf6-ba02-ac505f322871",
                                                "sense_id": "d8ac916d-4bb5-3110-9bfa-043a96997554",
                                                "text": "From the ground, Colombo’s port does not look like much. Those entering it are greeted by wire fences, walls dating back to colonial times and security posts. For mariners leaving the port after lonely nights on the high seas, the delights of the B52 Night Club and Stallion Pub lie a stumble away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8021857-72a5-3c9d-b4ca-ae6e0dde67d1",
                                        "entry_id": "e6ac6306-d246-38a3-9ced-ca36302a682b",
                                        "glosses": [
                                            "To a great extent.",
                                            "for emphasis or to indicate a great difference"
                                        ],
                                        "tags": [
                                            "with a comparative adjective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "948972f2-e512-4670-9a7c-692472264827",
                                                "sense_id": "b8021857-72a5-3c9d-b4ca-ae6e0dde67d1",
                                                "text": "He is much fatter than I remember him."
                                            },
                                            {
                                                "example_id": "47418b4f-dd09-451e-a688-0d4844873089",
                                                "sense_id": "b8021857-72a5-3c9d-b4ca-ae6e0dde67d1",
                                                "text": "Honestly, I can't stand much more of this."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f02df381-bcbd-350f-bff4-6f1680a3712f",
                                        "entry_id": "e6ac6306-d246-38a3-9ced-ca36302a682b",
                                        "glosses": [
                                            "Often; frequently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76d93082-4b38-45b0-8096-9a75bc8cbc4b",
                                                "sense_id": "f02df381-bcbd-350f-bff4-6f1680a3712f",
                                                "text": "Does he get drunk much?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ddce04e-1f06-33ba-9493-f0d5351c249d",
                                        "entry_id": "e6ac6306-d246-38a3-9ced-ca36302a682b",
                                        "glosses": [
                                            "Used to indicate or compare extent."
                                        ],
                                        "tags": [
                                            "in combinations such as 'as much'"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53f08d25-1d0b-4b0a-8179-3dea6aca1b3f",
                                                "sense_id": "9ddce04e-1f06-33ba-9493-f0d5351c249d",
                                                "text": "I don't like Wagner as much as I like Mozart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9560667b-bf90-343e-b5aa-9643e24fe2a2",
                                        "entry_id": "e6ac6306-d246-38a3-9ced-ca36302a682b",
                                        "glosses": [
                                            "Combining with an adjective or (occasionally) a noun, used in a rhetorical question to mock someone for having the specified quality."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47c4033a-6c68-4db9-beaf-8e7eec050ab7",
                                                "sense_id": "9560667b-bf90-343e-b5aa-9643e24fe2a2",
                                                "text": "Jamie's always preaching about how we need to save a planet when she drives literally everywhere she goes. Like, hypocritical much?"
                                            },
                                            {
                                                "example_id": "16b800e6-d787-469c-a098-2c96a823385e",
                                                "sense_id": "9560667b-bf90-343e-b5aa-9643e24fe2a2",
                                                "text": "The moment you've been waiting for—the lowdown on the Overstock hottie. I talked to her by phone last week. (Jealous much, gentlemen? Ad Report Card talks to all the fine ladies.)"
                                            },
                                            {
                                                "example_id": "0bb474d8-459b-4306-8a3b-86357be32fc0",
                                                "sense_id": "9560667b-bf90-343e-b5aa-9643e24fe2a2",
                                                "text": "Well, on the grounds of this, what if I told you the brand's latest launch goes against the latter and instead, is the first product in an opaque lip crème line? Screaming, crying, throwing up, much?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f4d5899-5195-3a0e-9c1c-0e63b6471273",
                                        "entry_id": "e6ac6306-d246-38a3-9ced-ca36302a682b",
                                        "glosses": [
                                            "Almost."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "much",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "361343e0-6502-3871-88b1-939378a8e67f",
