                        ],
                        "form": "die Hochgebirge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "99aa6b13-f06c-3bd1-a469-18960220f476",
                        "entry_id": "60cc2b22-4f9a-351d-b6e5-5ace0bdeff36",
                        "glosses": [
                            "Berggruppe oder Gebirgszüge, die eine Höhe von über 1500 m erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4eeca737-c484-438b-b468-713b6edbfe9a",
                                "sense_id": "99aa6b13-f06c-3bd1-a469-18960220f476",
                                "text": "In Hochgebirgen gibt es deutliche Zonierungen der Vegetation."
                            },
                            {
                                "example_id": "6bf76398-3008-4f5e-8e9f-c8edc93d1906",
                                "sense_id": "99aa6b13-f06c-3bd1-a469-18960220f476",
                                "text": "„Die auffallendste Stilfigur in dieser Evokation des Hochgebirges ist das Oxymoron, also die enge Verbindung von logisch Widersprüchlichem.“"
                            },
                            {
                                "example_id": "6713f9d9-1ca9-421e-b865-f77991898b2a",
                                "sense_id": "99aa6b13-f06c-3bd1-a469-18960220f476",
                                "text": "„Anden, Rocky Mountains, Altai, Pamir oder Himalaja – zuletzt gingen in den Hochgebirgen jährlich rund 335 Gigatonnen Eis verloren.“"
                            },
                            {
                                "example_id": "a8168b63-e3ae-40b4-bd88-dd05ba8736bb",
                                "sense_id": "99aa6b13-f06c-3bd1-a469-18960220f476",
                                "text": "„Die Flucht vor der Qual der Sinnlosigkeit des täglichen Lebens führt in die menschenfeindlichsten Landschaften der Erde, in das vegetationslose Hochgebirge mit seinem ewigen Eis und Schnee, seinen unsichtbaren Gletscherspalten, seinen abweisenden Wänden und Graten, seinen gefährlichen Steinschlägen und Lawinen, seiner mörderischen Kälte und Hitze, seinen Stürmen und Wetterschlägen.“"
                            },
                            {
                                "example_id": "36586ab3-2c12-4e06-a26e-d2dac16b1f7a",
                                "sense_id": "99aa6b13-f06c-3bd1-a469-18960220f476",
                                "text": "„In Schruns gab es weder Skilifte noch Seilbahnen; nur Holzabfuhrwerke und Viehsteige, die durch verschiedene Täler ins Hochgebirge führten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
