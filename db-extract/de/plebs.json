                ],
                "senses": [
                    {
                        "sense_id": "9f4a59bd-7665-38c3-88a4-5e177cd90f8e",
                        "entry_id": "d745ae6c-301f-32d2-bb49-1ffe50ac9d76",
                        "glosses": [
                            "das gemeine Volk im antiken Rom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de5267c6-36e7-4ebe-ae28-926f50c3a2bd",
                                "sense_id": "9f4a59bd-7665-38c3-88a4-5e177cd90f8e",
                                "text": "„Die Volkstribunen (tribuni plebis) leiteten die Versammlungen der Plebs und schützten die Plebejer vor Übergriffen seitens der Patrizier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9d4d2ae-dda4-4cdf-beda-b9477770f9a5",
