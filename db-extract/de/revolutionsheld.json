                "senses": [
                    {
                        "sense_id": "3537f30b-8b83-33d7-9b3d-519dde0817dd",
                        "entry_id": "9a0c4479-edb5-327e-9fdd-ca85084110e7",
                        "glosses": [
                            "Person, die bei einer Revolution Ruhm erworben hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d57457e-0a96-47e2-a48f-56882cae3c6b",
                                "sense_id": "3537f30b-8b83-33d7-9b3d-519dde0817dd",
                                "text": "„Er würde tot sein oder im Gefängnis oder ein Revolutionsheld, aber all das war eine Verbesserung gegenüber dem glücklich-traurigen, hoffnungsvoll-angstvollen gewöhnlichen Niemand, dem die Onlinewelt dabei zusehen würde, wie er älter wurde, wie er größer wurde, aber im Endeffekt niemals irgendwohin gelangte.“"
                            },
                            {
                                "example_id": "725ba7df-f229-4ffd-98e5-5bdd5e4186e3",
                                "sense_id": "3537f30b-8b83-33d7-9b3d-519dde0817dd",
                                "text": "„Hong spielte, sie sei eine tapfere Soldatin der Volksbefreiungsarmee, und führte Szenen aus dem Leben der Revolutionshelden vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
