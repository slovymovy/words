                "senses": [
                    {
                        "sense_id": "52025297-926b-3a8e-9442-797f896515c5",
                        "entry_id": "21dee084-5f80-3ff3-bf0b-82431077a19b",
                        "glosses": [
                            "On deck."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3db8f3fd-79c9-4686-b325-0d11357ad32f",
                                "sense_id": "52025297-926b-3a8e-9442-797f896515c5",
                                "text": "Dress warmly so that you can stay abovedeck in the fresh air."
                            },
                            {
                                "example_id": "26562469-f2b2-42c0-8812-499fa17be6e0",
                                "sense_id": "52025297-926b-3a8e-9442-797f896515c5",
                                "text": "Abovedeck the air had been black with wind."
                            },
                            {
                                "example_id": "5230e0af-a552-4d61-be7e-e75c678e7bae",
                                "sense_id": "52025297-926b-3a8e-9442-797f896515c5",
                                "text": "I wondered, sir, if you might like to accompany me abovedeck for some fresh air."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "dd720d1c-492c-301f-a2f2-673dd5a7f01b",
                "word": "abovedeck",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fc60b691-7617-3c6f-b9c7-b415c3a03edb",
                        "entry_id": "dd720d1c-492c-301f-a2f2-673dd5a7f01b",
                        "glosses": [
                            "The area on a boat that is abovedeck."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "578c41a9-db63-4d93-8b46-d5d0618f2cc3",
                                "sense_id": "fc60b691-7617-3c6f-b9c7-b415c3a03edb",
                                "text": "It's a good idea to plan these jobs in logical steps, working down from abovedeck to the bilge."
                            },
                            {
                                "example_id": "11434b2c-6bf6-47d0-beee-56c69d7d9a30",
                                "sense_id": "fc60b691-7617-3c6f-b9c7-b415c3a03edb",
                                "text": "The brightness from abovedeck made the shadowed interior all the darker."
                            },
                            {
                                "example_id": "480c2ce9-97a1-41f9-a97c-75f9954aadd1",
                                "sense_id": "fc60b691-7617-3c6f-b9c7-b415c3a03edb",
                                "text": "From abovedeck, shouts could be heard, mingling with the sound of running feet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "118db717-a421-43b5-b3d7-369f308c2935",
                        "source_entry_id": "dd720d1c-492c-301f-a2f2-673dd5a7f01b",
                        "source_sense_id": "fc60b691-7617-3c6f-b9c7-b415c3a03edb",
                        "source_sense_description": "on deck",
                        "target_lang_word": "bovendeks",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bovendeks",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e0284cf5-16e5-356b-b8a7-96f42c2993fa",
                                        "entry_id": "cde091a4-a692-3cdc-9657-a642b5a40c85",
                                        "glosses": [
                                            "boven op het dek van een schip"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9af9c999-77c6-40a7-a85e-84b88e96fc97",
                                                "sense_id": "e0284cf5-16e5-356b-b8a7-96f42c2993fa",
                                                "text": "Sturen geschiedt bovendeks, waar zelfs met gesloten cabrioletkap ruim voldoende stahoogte is. Onder de riante rondzitbank is veel bergruimte en ook de ruime stuurbank die over een behoorlijke lengte verschuifbaar is, beschikt over comfortabele kussens."
                                            },
                                            {
                                                "example_id": "f108b210-3d8f-498e-8a1d-4c4b17dc37d9",
                                                "sense_id": "e0284cf5-16e5-356b-b8a7-96f42c2993fa",
                                                "text": "De Jeanneau 51 oogt niet alleen fraai, maar biedt zowel bovendeks als onderdeks ongekend veel ruimte."
                                            },
                                            {
                                                "example_id": "01d37ef5-e969-4e99-95e4-33fd9e128147",
                                                "sense_id": "e0284cf5-16e5-356b-b8a7-96f42c2993fa",
                                                "text": "Wat ik erg mis is een douche, we zijn net de evenaar door, het is ontzettend warm bovendeks en onderdeks nog veel erger. De ventilator bij ons bed maakt overuren want die kan echt geen minuut uit."
                                            },
                                            {
                                                "example_id": "496ae2dd-845e-4d6f-a1c1-f602aac23923",
                                                "sense_id": "e0284cf5-16e5-356b-b8a7-96f42c2993fa",
                                                "text": "Bovendeks giert de wind en word je kleddernat. Onderdeks zie je geen golven aankomen en kun je onverwachts worden rondgesmeten. In je kooi ben je veilig. Dus pak je alle rust die je kunt krijgen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
