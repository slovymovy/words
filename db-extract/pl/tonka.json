                                    {
                                        "sense_id": "266fb483-2ff4-320e-aafc-f3391e3a3b9b",
                                        "entry_id": "2903a1f0-2b60-3015-83b4-3e2dac79e138",
                                        "glosses": [
                                            "A flavoring or fragrance used in foodstuffs and derived from the tonka bean."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d02b4d86-1ae3-4762-97d8-7fb6d8b5c83e",
                                                "sense_id": "266fb483-2ff4-320e-aafc-f3391e3a3b9b",
                                                "text": "When grated into desserts or infused into syrups, they impart a flavour so transcendent, tonka has been dubbed the most delicious ingredient you’ve never heard of."
                                            },
                                            {
                                                "example_id": "93a052be-efc9-4f72-a3b8-2d2c53932102",
                                                "sense_id": "266fb483-2ff4-320e-aafc-f3391e3a3b9b",
                                                "text": "Her favourite combinations involve pine, boletus mushroom and sake, or celery, tonka and amber ale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25125b6e-2799-4ae1-a70b-4b00e9f3f4ca",
