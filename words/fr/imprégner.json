    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "670875c3-ab09-36ce-b2df-fb2009eeda51",
                    "sense_definition": "Pénétrer intimement toutes les parties d'un corps solide ou poreux, en parlant d'un liquide ou d'une substance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>imprégner</w> un tissu d'huile protectrice pour éviter que l'humidité ne l'abîme."
                        },
                        {
                            "text": "La fumée du feu de bois <w>imprègne</w> rapidement tous les vêtements suspendus dans la pièce."
                        }
                    ],
                    "common_phrases": [
                        "imprégner un tissu",
                        "imprégner d'eau"
                    ]
                },
                {
                    "sense_id": "a1293bba-6bca-37ec-a3fb-2b19d889edd4",
                    "sense_definition": "Pénétrer profondément l'esprit ou la pensée d'idées, de doctrines ou de sentiments.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les étudiants doivent s'<w>imprégner</w> des valeurs de tolérance et de respect durant leur formation."
                        },
                        {
                            "text": "Il a voyagé pendant plusieurs mois pour s'<w>imprégner</w> de l'ambiance et des traditions locales."
                        }
                    ],
                    "common_phrases": [
                        "s'imprégner de la culture",
                        "s'imprégner d'une idée"
                    ]
                },
                {
                    "sense_id": "9807971a-c1fc-3c99-9e9b-387df33ec855",
                    "sense_definition": "Féconder une femelle ou rendre gravide.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce vieux traité de biologie, l'auteur explique comment le mâle réussit à <w>imprégner</w> la femelle."
                        },
                        {
                            "text": "Selon les anciens éleveurs, un seul étalon pouvait <w>imprégner</w> une vingtaine de juments par saison."
                        }
                    ],
                    "synonyms": [
                        "féconder",
                        "inséminer"
                    ],
                    "common_phrases": [
                        "imprégner une femelle"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "terme vieilli dans l'usage général"
                        }
                    ]
                },
                {
                    "sense_id": "ff70472a-d132-313f-a3d8-a352deb8477f",
                    "sense_definition": "Créer un lien d'attachement artificiel et privilégié avec un jeune animal dès sa naissance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ethologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dresseur a passé plusieurs semaines à <w>imprégner</w> un oisillon afin de faciliter le tournage du film."
                        },
                        {
                            "text": "Pour réussir ce documentaire animalier, l'éthologue a dû <w>imprégner</w> le jeune loup dès son premier jour."
                        }
                    ],
                    "common_phrases": [
                        "imprégner un oisillon"
                    ]
                }
            ]
        }
    ]
