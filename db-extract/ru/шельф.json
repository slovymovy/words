                                        "entry_id": "0764d48c-b990-34c2-9916-8826bef167d6",
                                        "glosses": [
                                            "Prolongement du continent sous la surface de la mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38222b31-d572-4931-a577-05e3fa013b0c",
                                                "sense_id": "03653643-c654-3818-986e-8a5170e17a50",
                                                "text": "L’appareil acoustique de Marti, qui quelques jours auparavant, nous avait donné 1600 m., nous indiqua des fonds de 250 mètres ; nous étions donc sur le plateau continental."
                                            }
