                "senses": [
                    {
                        "sense_id": "4d3b911a-7678-32a8-99c4-c2cb9e6d32fd",
                        "entry_id": "fca56bab-c676-377e-adb3-9fa01ffa862d",
                        "glosses": [
                            "Bauen in Steinen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ab531570-2458-4d92-8697-a2d23182ab42",
                                "sense_id": "4d3b911a-7678-32a8-99c4-c2cb9e6d32fd",
                                "text": "„Anderweit kommt das bauliche Material, die durch dasselbe gebotene Gestaltung und Behandlung in Betracht. Holzbau und Steinbau bilden charakteristische Gegensätze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "40d34114-dd7a-3eb3-9305-e9b1b735a6c3",
                        "entry_id": "fca56bab-c676-377e-adb3-9fa01ffa862d",
                        "glosses": [
                            "Bauwerk aus Steinen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9e7d22b-46cc-4cf5-ae78-c17ccd79a609",
                                "sense_id": "40d34114-dd7a-3eb3-9305-e9b1b735a6c3",
                                "text": "„Ihre monumentalen Steinbauten beeindrucken durch bis zu elf Meter hohe Mauern, die ohne Mörtel aus Granitblöcken zusammengefügt sind.“"
                            },
                            {
                                "example_id": "69c2c59b-f3bf-43fe-b54c-aa4a1c5b8f89",
                                "sense_id": "40d34114-dd7a-3eb3-9305-e9b1b735a6c3",
                                "text": "„Der Widerwille der Färinger gegen Steinbauten hatte allerdings auch eine andere, traumatischere Ursache.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
