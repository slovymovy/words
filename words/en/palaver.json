            "senses": [
                {
                    "sense_id": "88d165aa-7893-34fd-ae20-75b10ad4e353",
                    "sense_definition": "Unnecessary fuss, trouble, or complicated, time-consuming activity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "fuss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was such a <w>palaver</w> trying to get a refund from the airline."
                        },
                        {
                            "text": "We did not want any more <w>palaver</w> over such an insignificant issue."
                        }
                    ],
                    "synonyms": [
                        "ado",
                        "bother",
                        "fuss"
                    ],
                    "common_phrases": [
                        "such a palaver",
                        "what a palaver"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal British usage"
                        }
                    ]
                },
                {
