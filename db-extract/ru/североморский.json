                                        "glosses": [
                                            "związany z Morzem Północnym, dotyczący Morza Północnego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa3b2681-dcae-4ec0-862b-977ea5a8ae5e",
                                                "sense_id": "1fa21a19-cfa0-3aff-bd25-533ef495d4e0",
                                                "text": "W 1910 r. stawki frachtowe w żegludze bałtyckiej i północnomorskiej były tak niskie, że statki przewoziły tam ładunki poniżej kosztów własnych"
                                            },
                                            {
                                                "example_id": "5c1e63ef-6589-43a3-bfb4-1cd498aa252a",
                                                "sense_id": "1fa21a19-cfa0-3aff-bd25-533ef495d4e0",
                                                "text": "W roku 1975 Norwegia uzyskała spod północnomorskiego dna około 7 mln t ropy, a Wielka Brytania, która eksploatację swych bezsprzecznie bogatszych złóż rozpoczęła później – 1-2 mln t"
                                            }
