                        "source_sense_id": "da5f2b93-fe64-3baf-a1ca-b38f02035562",
                        "target_lang_word": "icing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "icing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3b19a29-4bf0-3e2a-9a73-aba9a04535b7",
                                        "entry_id": "c5bbb619-07f6-3062-b6a0-c9f631534964",
                                        "glosses": [
                                            "A sweet, often creamy and thick glaze made primarily of sugar, often enriched with ingredients like butter, egg whites, or flavorings, typically used for baked goods."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d393ba8-74d1-43cb-978c-bb9b14510ce1",
                                                "sense_id": "d3b19a29-4bf0-3e2a-9a73-aba9a04535b7",
                                                "text": "THICK FLUFFY ICING\nAt the present time there is a demand for very light fluffy icing that may be piled high on a cake. For beating many of the icings of this variety an electric beater is used, and the syrup is added very slowly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7b57000-f9bf-3a71-bb67-ea28c2e151f7",
                                        "entry_id": "c5bbb619-07f6-3062-b6a0-c9f631534964",
                                        "glosses": [
                                            "A minor violation of ice hockey rules, occurring when a player shoots the puck from his/her side of the red line so that it crosses the goal line on the opponent's side. A team playing short-handed is not penalized for this."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac6ff0b5-f8dd-3c45-aa2c-4cbb35beea95",
                                        "entry_id": "c5bbb619-07f6-3062-b6a0-c9f631534964",
                                        "glosses": [
                                            "The process of forming a layer of ice on a surface."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "511b98bd-4dc4-33df-9621-f0f1616cbae7",
                                        "entry_id": "c5bbb619-07f6-3062-b6a0-c9f631534964",
                                        "glosses": [
                                            "Conditions conducive to the formation of ice on aircraft surfaces."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba8e785d-95e2-4449-97d2-6f8f22fedae3",
                                                "sense_id": "511b98bd-4dc4-33df-9621-f0f1616cbae7",
                                                "text": "The Cessna pilots reported that moderate icing was present between 13,000 and 4,000 feet in the cloud layers."
                                            }
                                        ]
                                    }
                                ]
                            },
