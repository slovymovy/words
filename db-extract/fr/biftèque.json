                        "examples": [
                            {
                                "example_id": "1a708c21-f660-416a-bf08-d33005b1a37c",
                                "sense_id": "585ccd43-acc3-3a4d-8747-060982b51118",
                                "text": "Oui, je ris, mais le rire vaut un biftèque et je n'en manque pas une occasion."
                            },
                            {
                                "example_id": "5cbc3cf5-4ba2-4848-bde5-1985d1c8eb62",
                                "sense_id": "585ccd43-acc3-3a4d-8747-060982b51118",
                                "text": "Mais si l’on n'a pas de biftèque, il vaut mieux encore avoir un topinambour que pas de repas du tout."
                            },
                            {
                                "example_id": "34fcae78-6380-4cf4-9647-83eb1270a5be",
                                "sense_id": "585ccd43-acc3-3a4d-8747-060982b51118",
                                "text": "Je me rends dans une église de banlieue où Lanza del Vasto se recueille. Nous allons déjeuner ensemble dans un bistrot voisin. Il est farouchement végétarien. Il regarde avec horreur le biftèque qui se trouve dans mon assiette et me dit : « Vous mangez des plaies. »"
                            }
                        ]
                    }
