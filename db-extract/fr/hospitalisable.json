                    },
                    {
                        "sense_id": "0f881d9b-edc7-3b83-8d3c-410de170fba0",
                        "entry_id": "946bfa02-ec96-3b1f-a71e-b328e2ff565d",
                        "glosses": [
                            "Qui nécessite une hospitalisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1f67e75-58f1-49d9-aa33-c307df143c0a",
                                "sense_id": "0f881d9b-edc7-3b83-8d3c-410de170fba0",
                                "text": "L’encombrement des hôpitaux de Paris ira toujours en augmentant, parce que la population hospitalisable de Paris va sans cesse en s’accroissant."
                            },
                            {
                                "example_id": "9bd7a843-c4d2-4fb2-9f8e-6bf8e75977f7",
                                "sense_id": "0f881d9b-edc7-3b83-8d3c-410de170fba0",
                                "text": "La pondération entre les régions pour 1997 a été établie à partir du ration francs par habitant hospitalisable et du critère coût de l’activité issu du PMSI."
                            },
                            {
                                "example_id": "f0dcceb1-7870-4243-880d-33af5d46d1a2",
                                "sense_id": "0f881d9b-edc7-3b83-8d3c-410de170fba0",
                                "text": "Quand le patient n’est pas considéré comme \"hospitalisable\", il se retrouve en pleine nature, souvent sans aucune aide, parfois en danger. Le médecin ou le service qui a été à l’origine de l’envoi aux urgences n’est pas toujours informé de ce qu’il est advenu de son patient."
                            }
                        ]
                    }
