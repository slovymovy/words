                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68437918-5ba7-31c3-9cc4-ab3d910b0e10",
                                        "entry_id": "0b8b4520-affd-3241-aecc-7f63aba7f027",
                                        "glosses": [
                                            "праздник, развлечение, праздничное шествие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c60cb24-cedf-4f0a-8dd8-11180c2a3430",
                                                "sense_id": "68437918-5ba7-31c3-9cc4-ab3d910b0e10",
                                                "text": "Народное веселье."
                                            }
                                        ]
