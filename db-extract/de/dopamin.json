                        "target_lang_code": "ja",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c6fbde4f-a0b3-43ec-b66f-e9fac08f2768",
                        "source_entry_id": "5b09cf01-ef7a-35b0-9423-2f956c8d789b",
                        "source_sense_id": "805e3da2-258c-3dd0-8205-d5e9e8c2388b",
                        "source_sense_description": "Biochemie: Neurotransmitter des vegetativen Nervensystemes",
                        "target_lang_word": "dopamine",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dopamine",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "280fb27f-5d26-3f76-b722-02e868d16227",
                                        "entry_id": "c349a198-d0aa-3d39-923b-9bde1f7bbfd9",
                                        "glosses": [
                                            "een catecholamine dat fungeert als neurotransmitter (en soms als hormoon) op verschillende plaatsen in het lichaam van mensen en dieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bb97649-4ee4-48c9-b8b4-7cf9cef40469",
                                                "sense_id": "280fb27f-5d26-3f76-b722-02e868d16227",
                                                "text": "Professor Semir Zeki van de Universiteit van Londen spreekt van vier belangrijke geluksstofjes: de sekshormonen testosteron en oestrogeen en de neurotransmitters dopamine en serotonine."
                                            },
                                            {
                                                "example_id": "afd4e5f6-e876-430d-808a-353693164f30",
                                                "sense_id": "280fb27f-5d26-3f76-b722-02e868d16227",
                                                "text": "Dit wil niet zeggen dat je meteen gelukkig wordt, maar deze stoffen hebben in ieder geval een positieve invloed op het humeur. Vooral serotonine en dopamine dragen bij aan een betere gemoedstoestand. Ondanks dat sommige van onderstaande producten bijdragen aan de aanmaak van deze hormonen, wil dat niet zeggen dat een depressie direct verholpen wordt. Het zijn geen wondermiddelen. Bij serieuze problemen wordt dan ook aangeraden om hulp te zoeken bij mensen in je directe omgeving of bij professionals."
                                            },
                                            {
                                                "example_id": "bb2cdac5-8c1f-44f8-bd66-5d7272e49c89",
                                                "sense_id": "280fb27f-5d26-3f76-b722-02e868d16227",
                                                "text": "Er zijn forse psychologische gevolgen. Treffend is de reactie van een vormalige pornoverslaafde. „Omdat ik mijn hersenen met zoveel dopamine voedde door uren naar porno te kijken, smachtte mijn brein steeds meer naar stimulatie. Alledaagse dingen werden minder stimulerend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60f601a0-febd-498b-821b-13734b1ade66",
                        "source_entry_id": "5b09cf01-ef7a-35b0-9423-2f956c8d789b",
                        "source_sense_id": "805e3da2-258c-3dd0-8205-d5e9e8c2388b",
