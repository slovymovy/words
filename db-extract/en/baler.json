                "senses": [
                    {
                        "sense_id": "62cde988-baae-3589-baae-7d10782bdfc8",
                        "entry_id": "3f64559d-f5c9-3d4c-a03e-caf7b5105374",
                        "glosses": [
                            "A machine for creating bales, e.g., of hay or cotton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cf758c1-b3b2-4cd5-a7bb-9c7340d20026",
                                "sense_id": "62cde988-baae-3589-baae-7d10782bdfc8",
                                "text": "Farmer Jones is in straits because his baler is broken down and he's got three fields of hay ready to bale."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b8f6bc5-c8d1-35c1-82df-a05050d75002",
                        "entry_id": "3f64559d-f5c9-3d4c-a03e-caf7b5105374",
                        "glosses": [
                            "A person who creates bales, either by operating or feeding such a machine, or by creating the bales by hand."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c97acfa0-8a58-4957-a6d2-3e25f58b3812",
                                "sense_id": "5b8f6bc5-c8d1-35c1-82df-a05050d75002",
                                "text": "Hank worked as a baler for Farmer Jones part time, to make ends meet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26a982f0-17f5-4534-99a5-b755829bd4fc",
                        "source_entry_id": "3f64559d-f5c9-3d4c-a03e-caf7b5105374",
