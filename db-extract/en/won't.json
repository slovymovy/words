                                                "sense_id": "6a27d8d0-2fdf-377d-ab1d-8fafd31a1302",
                                                "text": "Nie mam już pieniędzy."
                                            },
                                            {
                                                "example_id": "c735818c-6d9a-4566-bdd6-68a85713d104",
                                                "sense_id": "6a27d8d0-2fdf-377d-ab1d-8fafd31a1302",
                                                "text": "Dlaczego nie umyłeś rąk?"
