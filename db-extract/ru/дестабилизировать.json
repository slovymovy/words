                                        "entry_id": "7282daf8-8a1f-3caf-bd57-8c6ac6751337",
                                        "glosses": [
                                            "etwas, das fest (stabil) ist/steht, aus dem Gleichgewicht bringen, so beeinflussen, dass es zerstört werden könnte oder auseinanderfällt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d1a3864-06c9-4d42-b798-be96cfc19493",
                                                "sense_id": "2075f9dd-a7c9-33b3-859e-f8fea8e265e4",
                                                "text": "Der Bürgerkrieg destabilisierte das Land."
                                            },
                                            {
                                                "example_id": "8b6165e6-ba0e-4cd4-af32-f0bec82c70e1",
                                                "sense_id": "2075f9dd-a7c9-33b3-859e-f8fea8e265e4",
                                                "text": "„Gleichzeitig ging es aber auch darum, die Bevölkerung des jeweils anderen Teils von der Attraktivität der eigenen Staats- und Gesellschaftsform zu überzeugen, den Nachbarn zu unterwandern, zu destabilisieren und schließlich als Sieger im Wettbewerb der Systeme die Wiedervereinigung herbeizuführen.“"
                                            },
                                            {
                                                "example_id": "37983232-7d39-4e30-8e55-fed1aec604c7",
                                                "sense_id": "2075f9dd-a7c9-33b3-859e-f8fea8e265e4",
                                                "text": "[Tschetschenien 1991:] „Moskau erkannte die Republik nicht an und verhängte eine Wirtschaftsblockade, um die Region zu destabilisieren. Die Lebensbedingungen verschlechterten sich rapide.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
