                "senses": [
                    {
                        "sense_id": "030dc2d2-91b1-33fa-b124-e29bf8fd5009",
                        "entry_id": "a01fa3c8-c400-3989-9d22-1bc3a538e592",
                        "glosses": [
                            "geselliger Umtrunk am Nachmittag oder Abend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23a9b97c-530b-449f-b417-585ed5532586",
                                "sense_id": "030dc2d2-91b1-33fa-b124-e29bf8fd5009",
                                "text": "„Das liest man als älterer Mensch besonders gern, am besten bei einem Gläschen Rotwein: Ein paar Dämmerschoppen in der Woche, die eine Halbe zur Mahlzeit oder der Klare zur Verdauung ruinieren nicht die kleinen grauen Zellen, sondern können bei betagten Menschen sogar die schleichende Demenz ausbremsen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "718ec3da-6c6d-4e03-aeca-dba02ae90539",
                        "source_entry_id": "a01fa3c8-c400-3989-9d22-1bc3a538e592",
                        "source_sense_id": "030dc2d2-91b1-33fa-b124-e29bf8fd5009",
                        "source_sense_description": "geselliger Umtrunk am Nachmittag oder Abend",
                        "target_lang_word": "sundowner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sundowner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49ffdae0-b514-33ca-8122-8c3362fbda94",
                                        "entry_id": "99485899-5ef8-3a1f-88cd-5342d3b6b076",
                                        "glosses": [
                                            "An itinerant worker, such as a swagman, who arrives at a farm too late in the day to do any work, but readily accepts food and lodging."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45b3010f-da7d-49c4-83de-cbec669ef9bb",
                                                "sense_id": "49ffdae0-b514-33ca-8122-8c3362fbda94",
                                                "text": "What he saw was not usual in this part of Australia - a sundowner, a bush waif who tramps from north to south or from east to west, never working, cadging rations from the far-flung homesteads and having the ability of the camel to do without water, or find it."
                                            },
                                            {
                                                "example_id": "1284a35a-5be8-4f52-8246-6ff541d75bde",
                                                "sense_id": "49ffdae0-b514-33ca-8122-8c3362fbda94",
                                                "text": "Like the Australian sundowners, some of these trampers were suspected of never wanting to find a job."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e0fabf9-d027-393f-aa24-4759d626e4c4",
                                        "entry_id": "99485899-5ef8-3a1f-88cd-5342d3b6b076",
                                        "glosses": [
                                            "An itinerant worker, a swagman."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d905557c-6471-3c15-b198-e5db14e52991",
                                        "entry_id": "99485899-5ef8-3a1f-88cd-5342d3b6b076",
                                        "glosses": [
                                            "A sea captain who shows harsh discipline by requiring all hands to be on board by sundown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f2b5450-47f6-43de-a050-538f17a0f084",
                                                "sense_id": "d905557c-6471-3c15-b198-e5db14e52991",
                                                "text": "Arrogant, aloof, and suspicious, a “sundowner,” or strict disciplinarian, King inspired respect in many but affection in few."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27288855-32a2-30e3-8b4e-a2b6684e1f90",
                                        "entry_id": "99485899-5ef8-3a1f-88cd-5342d3b6b076",
                                        "glosses": [
                                            "A patient, usually demented, who tends to become agitated in the evening."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b37b732f-4fd2-4466-b75c-b2b54c4c5c58",
                                                "sense_id": "27288855-32a2-30e3-8b4e-a2b6684e1f90",
                                                "text": "These patients may improve by day only to relapse at night (nocturnal delirium or sundowner's syndrome)."
                                            },
                                            {
                                                "example_id": "aaebd0b0-0580-4b8c-b75d-5f13d65ed709",
                                                "sense_id": "27288855-32a2-30e3-8b4e-a2b6684e1f90",
                                                "text": "They generally occur in the evening or at night in the form of \"sundowner\" syndrome, as a result of diminished sensory input and social isolation and/or exposure to an unfamiliar environment (e.g., the hospital)."
                                            },
                                            {
                                                "example_id": "53312388-20c0-48ab-b8a5-3cef9d00c3fd",
                                                "sense_id": "27288855-32a2-30e3-8b4e-a2b6684e1f90",
                                                "text": "“Sundowner′s syndrome” refers to changes in mood and behavior that begin near dusk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0e14af3-7534-317d-ae4a-1212d674ba53",
                                        "entry_id": "99485899-5ef8-3a1f-88cd-5342d3b6b076",
                                        "glosses": [
                                            "A cocktail consumed at sunset, or to signify the end of the day."
                                        ],
                                        "tags": [
                                            "Africa",
                                            "Southern",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80237946-286b-4ba1-9dbe-2a96f099a8c4",
                                                "sense_id": "d0e14af3-7534-317d-ae4a-1212d674ba53",
                                                "text": "The cocktail, the universal “sherry and bitters” and sundowner will have to be retained."
                                            },
                                            {
                                                "example_id": "7df849fb-2562-45ff-87bc-361fbb4f6ca8",
                                                "sense_id": "d0e14af3-7534-317d-ae4a-1212d674ba53",
                                                "text": "Mrs. Lowe-Island […] had imagined the Sports Club as a large shadowy veranda, with native servants standing like willing statues around the walls, plenty of sundowners, and that laughter which is the result of personal comment […]."
                                            },
                                            {
                                                "example_id": "6b50ea58-f33c-45d3-85e9-f464a136c218",
                                                "sense_id": "d0e14af3-7534-317d-ae4a-1212d674ba53",
                                                "text": "Per custom, we capped our drives with a sundowner cocktail party at a scenic vantage point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7f3feef-962e-3f70-bec6-b35d48ec5e18",
                                        "entry_id": "99485899-5ef8-3a1f-88cd-5342d3b6b076",
                                        "glosses": [
                                            "A cocktail party held in the early evening."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2324344b-007c-44da-bbfc-3eef5a89c4cc",
                                                "sense_id": "b7f3feef-962e-3f70-bec6-b35d48ec5e18",
                                                "text": "The Sundowner is basically a cocktail party with a buffet on a riverbank in the bush."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b61967fb-7c3c-36ca-8d81-f3fe99859a3e",
                                        "entry_id": "99485899-5ef8-3a1f-88cd-5342d3b6b076",
                                        "glosses": [
                                            "A physician employed by the government who practises for private fees after his official hours."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8c4d08c-94f4-3e59-bff4-dc55a8d3ebf2",
                                        "entry_id": "99485899-5ef8-3a1f-88cd-5342d3b6b076",
                                        "glosses": [
                                            "Any worker who practises for private fees after official hours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48b641fe-ca0b-440f-ba01-ba11dbdb7f76",
                                                "sense_id": "b8c4d08c-94f4-3e59-bff4-dc55a8d3ebf2",
                                                "text": "These \"sundowners\" hold jobs in other — usually related — trades, and do their servicing nights and weekends."
                                            },
                                            {
                                                "example_id": "67c06eb9-e17e-4ab6-bebc-434fc22680c3",
                                                "sense_id": "b8c4d08c-94f4-3e59-bff4-dc55a8d3ebf2",
                                                "text": "[…] according to Home Furnishings Daily, “Public exposure of the sundowners provides strong support for our campaign for state licensing of TV technicians. […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
