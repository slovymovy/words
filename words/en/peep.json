{
    "word_family": [
        "peeper",
        "peeping"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "544df2ad-dd38-33ad-bbd7-6ad54bc2e8f2",
                    "sense_definition": "A short, soft, high-pitched sound, as made by a baby bird.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby bird made a tiny <w>peep</w> when it was hungry.",
                            "target_lang_translations": {
                                "ru": "Птенец издал крошечный <w>писк</w>, когда проголодался."
                            }
                        },
                        {
                            "text": "We heard a soft <w>peep</w> coming from the nest in the tree.",
                            "target_lang_translations": {
                                "ru": "Мы услышали тихий <w>писк</w>, доносившийся из гнезда на дереве."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий, мягкий, высокий звук, который издают птенцы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "писк",
                                "target_lang_sense_clarification": "протяжный, негромкий звук высокого тона"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbe3a4a4-3995-395c-9057-42daa79a8cef",
                    "sense_definition": "A feeble utterance or complaint.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not want to hear a single <w>peep</w> out of you while I am working.",
                            "target_lang_translations": {
                                "ru": "Я не хочу слышать ни <w>писка</w> от тебя, пока я работаю."
                            }
                        },
                        {
                            "text": "The child did not make a <w>peep</w> during the entire long meeting.",
                            "target_lang_translations": {
                                "ru": "Ребенок не издал ни <w>писка</w> за всё долгое собрание."
                            }
                        }
                    ],
                    "common_phrases": [
                        "not a peep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабое выражение недовольства или жалоба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "писк",
                                "target_lang_sense_clarification": "перен., разг., шутл. плаксиво возмущаться, жаловаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dad2995-fbda-3ffd-b00c-9c99a7e09280",
                    "sense_definition": "A quick look or glimpse, especially a furtive one.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "look",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I took a quick <w>peep</w> inside the room to see if anyone was there.",
                            "target_lang_translations": {
                                "ru": "Я <w>взглянул украдкой</w> в комнату, чтобы проверить, есть ли там кто-нибудь."
                            }
                        },
                        {
                            "text": "She could not resist taking a <w>peep</w> at her birthday presents.",
                            "target_lang_translations": {
                                "ru": "Она не удержалась и <w>взглянула украдкой</w> на свои подарки ко дню рождения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "take a peep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый или украдкой сделанный взгляд."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взгляд украдкой",
                                "target_lang_sense_clarification": "быстрый, скрытный осмотр чего-либо"
                            },
                            {
                                "target_lang_word": "подглядывание",
                                "target_lang_sense_clarification": "действие, связанное с тайным наблюдением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97a075bd-4d2d-33fe-bf51-b431e2966829",
                    "sense_definition": "A person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There were many <w>peeps</w> waiting in line for the concert tickets.",
                            "target_lang_translations": {
                                "ru": "Много <w>людей</w> стояло в очереди за билетами на концерт."
                            }
                        },
                        {
                            "text": "All the <w>peeps</w> in the neighborhood came out for the summer party.",
                            "target_lang_translations": {
                                "ru": "Все <w>ребята</w> из нашего района пришли на летнюю вечеринку."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal usage for people or friends."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек (разговорное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "человек",
                                "target_lang_sense_clarification": "общее обозначение личности"
                            },
                            {
                                "target_lang_word": "ребята",
                                "target_lang_sense_clarification": "разговорное обращение к группе людей"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2fb8786b-88df-3733-81c3-127d54995634",
                    "sense_definition": "To look, especially through a narrow opening, or while trying not to be seen or noticed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "look",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The curious boy <w>peeped</w> through the keyhole to see what was happening.",
                            "target_lang_translations": {
                                "ru": "Любопытный мальчик <w>подглядывал</w> в замочную скважину, чтобы увидеть, что происходит."
                            }
                        },
                        {
                            "text": "She <w>peeped</w> around the corner to make sure the coast was clear.",
                            "target_lang_translations": {
                                "ru": "Она <w>заглянула</w> за угол, чтобы убедиться, что путь свободен."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смотреть, особенно через узкое отверстие или стараясь остаться незамеченным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подглядывать",
                                "target_lang_sense_clarification": "украдкой, тайком наблюдать за кем-либо"
                            },
                            {
                                "target_lang_word": "заглядывать",
                                "target_lang_sense_clarification": "смотреть внутрь чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b5afa98-95c8-30b5-9ff6-efde4423ccf0",
                    "sense_definition": "To begin to appear; to look forth from concealment; to make the first appearance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun began to <w>peep</w> over the horizon as the morning started.",
                            "target_lang_translations": {
                                "ru": "Солнце начало <w>показываться</w> из-за горизонта с началом утра."
                            }
                        },
                        {
                            "text": "Small green leaves started to <w>peep</w> through the soil after the rain.",
                            "target_lang_translations": {
                                "ru": "Маленькие зеленые листочки начали <w>проглядывать</w> сквозь почву после дождя."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинать появляться; показываться из укрытия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "показываться",
                                "target_lang_sense_clarification": "становиться видимым"
                            },
                            {
                                "target_lang_word": "проглядывать",
                                "target_lang_sense_clarification": "появляться, пробиваться сквозь что-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}