                                        "examples": [
                                            {
                                                "example_id": "520a55c7-00ae-4da7-a8bd-3a41b3084b75",
                                                "sense_id": "ecbc2287-78e1-3d7d-a252-6adbaac500fd",
                                                "text": "The ballet dancer representing the swan wore a white tutu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tutu",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e36775b-d628-31fe-ae79-d1405f33ac50",
                                        "entry_id": "e0ff7e1f-8678-3ec9-abaf-bd4c4bf22335",
                                        "glosses": [
                                            "Any of certain members of genus Coriaria of shrubs and trees found in New Zealand, including Coriaria arborea and Coriaria pottsiana, used by the Maori to make a sweetener, but toxic when not properly prepared."
                                        ],
                                        "tags": [
                                            "New-Zealand"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tutu",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0384dbd6-8404-3281-95ee-12db550ec95b",
                                        "entry_id": "d61e3734-9632-3ac7-982e-e8a9362f7290",
                                        "glosses": [
                                            "to fiddle or mess around with something."
                                        ],
                                        "tags": [
                                            "New-Zealand",
                                            "childish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a64dbb9-3e16-49f9-9e82-abfd2f6c0a42",
                                                "sense_id": "0384dbd6-8404-3281-95ee-12db550ec95b",
                                                "text": "\"There were seven dudes here for a week just showing me how to use it and I just wanted them to leave so I could start tutuing with it.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2288c683-32f7-448a-b200-9358eef770a9",
                        "source_entry_id": "cb9753f3-f0f7-36b3-bd26-437effac1726",
                        "source_sense_id": "0bb2c0ea-5bb0-385f-9997-fe67b0e96301",
                        "source_sense_description": "von Balletttänzerinnen getragener kurzer Rock, meist aus Tüll",
                        "target_lang_word": "tutu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tutu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7fc7946b-d746-3a87-a30e-8c4436c3208a",
                                        "entry_id": "4b726af9-dd50-36c6-980c-3df79dfcab23",
                                        "glosses": [
                                            "Cul, derrière, fesses."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02845e40-c138-41f7-8188-132f27b4a484",
                                                "sense_id": "7fc7946b-d746-3a87-a30e-8c4436c3208a",
                                                "text": "Kiki [un chien] se lèche sans cesse le tutu."
                                            },
                                            {
                                                "example_id": "65eb7a2a-b9dd-4ada-a46d-0abe7ab62748",
                                                "sense_id": "7fc7946b-d746-3a87-a30e-8c4436c3208a",
                                                "text": "Faire panpan-tutu, donner une fessée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84b88c87-fe23-3de3-a46a-b495f17e00e1",
                                        "entry_id": "4b726af9-dd50-36c6-980c-3df79dfcab23",
                                        "glosses": [
                                            "Jupe de gaze, tulle, tarlatane ou mousseline, courte et évasée, que portent les danseuses de ballet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06a9c40c-31d1-4b94-8bd1-ee9899f397b9",
                                                "sense_id": "84b88c87-fe23-3de3-a46a-b495f17e00e1",
                                                "text": "Une danseuse en tutu."
                                            },
                                            {
                                                "example_id": "81094794-5196-47df-9325-83af3c946573",
                                                "sense_id": "84b88c87-fe23-3de3-a46a-b495f17e00e1",
                                                "text": "Évocations romantiques sur des airs de Chopin et de Weber, les longs tutus blancs à la Taglioni des Sylphides."
                                            },
                                            {
                                                "example_id": "0b9e54d1-ba0d-4bef-80c7-5d0c30078a6e",
                                                "sense_id": "84b88c87-fe23-3de3-a46a-b495f17e00e1",
                                                "text": "La légèreté transparente des tutus, entourant la fermeté rose des jambes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tutu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4e1c5bd-d987-3ae3-a83a-74cb579e8f48",
                                        "entry_id": "40597f76-7434-31f3-8938-1f392f8a4547",
                                        "glosses": [
                                            "Vin rouge."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae08b631-a18b-4bc7-82ae-45ed5eff2d37",
                                                "sense_id": "e4e1c5bd-d987-3ae3-a83a-74cb579e8f48",
                                                "text": "On le laisse fumer en douce et boire un coup ou deux quand il a trouvé le moyen de se procurer du « tutu ». – Du « tutu » ? – Oui, du pinard !"
                                            },
                                            {
                                                "example_id": "ccae7f18-4058-457b-8cae-af252222cb74",
                                                "sense_id": "e4e1c5bd-d987-3ae3-a83a-74cb579e8f48",
                                                "text": "Ils s’attardent les deux potes, clapant au rythme mesuré du gourmet pour qui chaque bouchée compte ; chaque gorgée de tutu suspend la fuite du temps."
                                            },
                                            {
                                                "example_id": "0ede55b2-24c3-4c96-b1ee-51e724385617",
                                                "sense_id": "e4e1c5bd-d987-3ae3-a83a-74cb579e8f48",
                                                "text": "Ça donne qu’en l’an 2000 on s’envoie plus que du tutu chinois."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tutu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7922b09-14bb-31bd-a3da-c9ea903a052a",
