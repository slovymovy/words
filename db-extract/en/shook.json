                "senses": [
                    {
                        "sense_id": "fd78a397-9bf8-3322-85d7-ec37f115107e",
                        "entry_id": "5c787135-e199-3784-aa7d-310ab2690529",
                        "glosses": [
                            "Shaken up; rattled; shocked or surprised."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6b005a7f-b4de-4526-9f68-f3b4f6804355",
                                "sense_id": "fd78a397-9bf8-3322-85d7-ec37f115107e",
                                "text": "Upon hearing this I am really feeling the pressure. I am shook."
                            },
                            {
                                "example_id": "8795f026-de7a-4610-aa9d-2f59edbf826b",
                                "sense_id": "fd78a397-9bf8-3322-85d7-ec37f115107e",
                                "text": "Immediately, his face flushed: \"How could Katy do that to Britney? I'm SHOOK.\""
                            },
                            {
                                "example_id": "936fadad-7849-469f-bad3-9746ac6f9d2c",
                                "sense_id": "fd78a397-9bf8-3322-85d7-ec37f115107e",
                                "text": "He wrote this long ass thing about how we're the next up and coming thing! I'm shook, I'm like 'What the hell?\" and all the emails started coming in—Interscope, Capitol, Universal, it was this whole spiral."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3f47c0a-94ec-3473-ace4-5f64a1382063",
                        "entry_id": "5c787135-e199-3784-aa7d-310ab2690529",
                        "glosses": [
                            "Emotionally upset or disturbed; scared."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "237b9994-c911-4342-8ae9-f83e3d8ffcc1",
                                "sense_id": "a3f47c0a-94ec-3473-ace4-5f64a1382063",
                                "text": "Crystal was shook when Mr. Wu discovered she was shopping online for panties and bras to pass the time in class."
                            }
                        ]
                    }
                ],
