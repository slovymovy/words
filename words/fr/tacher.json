            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf76e9e0-618a-3842-b768-f556a3869c52",
                    "sense_definition": "Faire une tache sur quelque chose, salir ou souiller.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "salissure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais attention avec la sauce tomate pour ne pas <w>tacher</w> ta chemise blanche."
                        },
                        {
                            "text": "L'enfant a renversé son verre de jus et a <w>taché</w> toute la nappe propre."
                        }
                    ],
                    "synonyms": [
                        "salir",
                        "souiller",
                        "maculer"
                    ],
                    "antonyms": [
                        "nettoyer",
                        "laver"
                    ],
                    "common_phrases": [
                        "tacher ses vêtements",
                        "tacher la nappe",
                        "se tacher facilement"
                    ]
                },
                {
                    "sense_id": "38865df0-de8d-3cf3-8a20-01d3ebba6eb5",
                    "sense_definition": "Ternir moralement, porter atteinte à l'honneur ou à la réputation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce grave scandale financier risque de <w>tacher</w> la réputation de toute l'entreprise."
                        },
                        {
                            "text": "Une seule mauvaise décision a <w>taché</w> son brillant parcours professionnel."
                        }
                    ],
                    "synonyms": [
                        "entacher",
                        "ternir",
                        "flétrir"
                    ],
                    "common_phrases": [
                        "tacher sa réputation",
                        "tacher son honneur"
                    ]
                }
            ]
        }
    ]
