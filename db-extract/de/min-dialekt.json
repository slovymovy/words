                        "glosses": [
                            "Gruppe von Sprachvarianten des Chinesischen, die vor allem in Fujian, Hainan und auf Taiwan gesprochen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad05c2bc-a16e-415d-b135-692a3af9eb00",
                                "sense_id": "9e7a6e57-5806-3254-aa87-66ab67b199e7",
                                "text": "Rund 60 Millionen Menschen sprechen die Min-Dialekte."
                            },
                            {
                                "example_id": "3808367a-de3a-4d24-99c6-517f80caad9e",
                                "sense_id": "9e7a6e57-5806-3254-aa87-66ab67b199e7",
                                "text": "„Der Min-Dialekt ist in verschiedene Untergruppen unterteilt – in Xiamen und Quanzhou hört man den Südlichen Min-Dialekt (Minnan Hua), in Fuzhou hingegen den Östlichen Min-Dialekt (Dong Min).“"
                            }
                        ],
