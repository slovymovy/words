                ],
                "senses": [
                    {
                        "sense_id": "ff50e3be-c328-354b-9323-77ea237613d3",
                        "entry_id": "6af7293f-ed60-32d6-b533-105f21c2b03a",
                        "glosses": [
                            "veel hoop gevend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b53b0e3-1df4-4c84-b4e2-11ea012cc944",
                                "sense_id": "ff50e3be-c328-354b-9323-77ea237613d3",
                                "text": "De tafels zijn hoopvol gedekt voor het diner, maar truckersrestaurant Le Mistral straalt een zekere mismoedigheid uit. Een kapotte ruit is vervangen door een houten schot. Op de parkeerplaats ter grootte van een voetbalveld staat een handjevol vrachtwagens."
                            },
                            {
                                "example_id": "ab16e701-1f11-41d0-98da-f25ad21e9fe7",
                                "sense_id": "ff50e3be-c328-354b-9323-77ea237613d3",
                                "text": "Dat de koorts zakte bij het zieke kind was een hoopvol teken voor de heel bezorgde ouders."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9c62494-2af5-3f2c-8673-6a69b5ea593a",
                        "entry_id": "6af7293f-ed60-32d6-b533-105f21c2b03a",
                        "glosses": [
                            "met veel hoop en vertrouwen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "153a5459-5c0d-45d0-b7da-7de5d53d10d2",
                                "sense_id": "b9c62494-2af5-3f2c-8673-6a69b5ea593a",
                                "text": "Na een kwartier stopte er een oude gedeukte Toyota met een mollige vrouw voorin, die vroeg waar ik naartoe moest. ‘Naar Casa de Luna,’ antwoordde ik hoopvol. ‘Oh, die lui. Dat zou ik niet doen, dat zijn gevaarlijke aso’s. Echte tokkies.’"
                            },
                            {
                                "example_id": "0b853ac4-cb54-4073-85cf-c85b02b7d4de",
                                "sense_id": "b9c62494-2af5-3f2c-8673-6a69b5ea593a",
                                "text": "De jonge ondernemer is hoopvol dat de Italiaanse anti-hennepwet na een juridisch traject zal sneuvelen. Hoogst onzeker is hoelang dat zal duren. En die onzekerheid is bad for business, merkt hij al maanden: \"Investeerders gaan naar landen waar het veiliger is en klanten durven geen bestellingen meer te plaatsen.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b939cd56-7bcb-4bc5-a28a-cc70366d7c4e",
                        "source_entry_id": "6af7293f-ed60-32d6-b533-105f21c2b03a",
                        "target_lang_word": "hoffnungsvoll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoffnungsvoll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3265ca6-e376-399d-985d-00832ff4539d",
                                        "entry_id": "a984a53b-159f-338e-aa6b-3592db8faf30",
                                        "glosses": [
                                            "Hoffnung besitzend; ein positives, gutes Gefühl für die Zukunft habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f468a02-e901-4ba0-b22f-0ea30db4f067",
                                                "sense_id": "e3265ca6-e376-399d-985d-00832ff4539d",
                                                "text": "Er blickt stets hoffnungsvoll in die Zukunft."
                                            },
                                            {
                                                "example_id": "f320de60-23ef-4fdb-a13c-bd19ecf80c31",
                                                "sense_id": "e3265ca6-e376-399d-985d-00832ff4539d",
                                                "text": "Sie ist eine sehr hoffnungsvolle Person und lässt sich durch nichts einschüchtern."
                                            },
                                            {
                                                "example_id": "bc95941f-2054-4fd4-ba4a-b60dfeb26ecb",
                                                "sense_id": "e3265ca6-e376-399d-985d-00832ff4539d",
                                                "text": "Die Eltern ermutigen ihre Kinder dazu, hoffnungvoll zu sein, aber nicht übermutig zu werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b08edb04-220f-34c1-8b3f-ee9a02e1cd5d",
                                        "entry_id": "a984a53b-159f-338e-aa6b-3592db8faf30",
                                        "glosses": [
                                            "mit Aussicht, Hoffnung auf Erfolg oder Gelingen; hohe Erwartungen weckend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0d3f644-9741-4928-a838-60cc0abe915f",
                                                "sense_id": "b08edb04-220f-34c1-8b3f-ee9a02e1cd5d",
                                                "text": "Diese hoffnungsvolle Botschaft erfreute uns."
                                            },
                                            {
                                                "example_id": "3aed1a12-8cab-4045-ae40-62e706a1ee96",
                                                "sense_id": "b08edb04-220f-34c1-8b3f-ee9a02e1cd5d",
                                                "text": "„Die Zulassung von hoffnungsvollen Therapien hat sich dramatisch beschleunigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "072b1942-cb43-44fb-bc70-101d545e4b8f",
                        "source_entry_id": "6af7293f-ed60-32d6-b533-105f21c2b03a",
                        "target_lang_word": "hopeful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hopeful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c564f294-2f93-3456-9459-adf4d5cfde3f",
                                        "entry_id": "3de30b05-a87c-3e76-9a8a-25797306cfba",
                                        "glosses": [
                                            "feeling hope"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3f3449b-9305-409f-bc80-a278188e9c8a",
                                                "sense_id": "c564f294-2f93-3456-9459-adf4d5cfde3f",
                                                "text": "I have been very hopeful."
                                            },
                                            {
                                                "example_id": "91abd2ac-54bd-4d3a-82ac-78edfd827c36",
                                                "sense_id": "c564f294-2f93-3456-9459-adf4d5cfde3f",
                                                "text": "I am hopeful that I will recover from the disease."
                                            },
                                            {
                                                "example_id": "bf105973-ef6d-444f-aef7-555c51db2cfa",
                                                "sense_id": "c564f294-2f93-3456-9459-adf4d5cfde3f",
                                                "text": "Speaking with reporters during a stop in New York, Mr. Biden offered the most hopeful assessment of the hostage talks by any major figure in many days, suggesting that the war might be close to a major turning point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a959e41a-cc49-3abc-9f0b-9963c74fde5b",
                                        "entry_id": "3de30b05-a87c-3e76-9a8a-25797306cfba",
                                        "glosses": [
                                            "inspiring hope"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e378c208-8eba-40a7-a146-858aebfc0b3d",
                                                "sense_id": "a959e41a-cc49-3abc-9f0b-9963c74fde5b",
                                                "text": "It looks hopeful that my father will be able to walk again."
                                            },
                                            {
                                                "example_id": "76d1f13d-c4f5-44e3-811d-28929a609e85",
                                                "sense_id": "a959e41a-cc49-3abc-9f0b-9963c74fde5b",
                                                "text": "The night was further proof that the Democratic Party’s cruel summer had given way to a more hopeful election season."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hopeful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb93b585-6f92-37ed-8ba2-e97c3b12892d",
                                        "entry_id": "c1979f95-a739-3f4e-aa47-696011cf2815",
                                        "glosses": [
                                            "Someone who is hoping for success or victory, especially as a candidate in a political election."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4180adb8-6eb6-48e0-83bf-7e74d47d3fac",
                                                "sense_id": "eb93b585-6f92-37ed-8ba2-e97c3b12892d",
                                                "text": "Several presidential hopefuls are campaigning in New Hampshire this week."
                                            },
                                            {
                                                "example_id": "0afa03cc-e840-41e7-a65a-d28b6cbcf9f8",
                                                "sense_id": "eb93b585-6f92-37ed-8ba2-e97c3b12892d",
                                                "text": "Gov. Ron DeSantis of Florida and several other Republican presidential hopefuls spent Tuesday in New Hampshire, while Mike Pence, the former vice president, was in Iowa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3742a04-7c73-4640-a963-bd75dff3d063",
                        "source_entry_id": "6af7293f-ed60-32d6-b533-105f21c2b03a",
                        "target_lang_word": "prometteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prometteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d433f15-c89b-3d6c-bc36-b093fe4baf83",
                                        "entry_id": "2e20e2a7-a8c2-3a22-9e60-1cca7a5600e8",
                                        "glosses": [
                                            "Qui promet, qui donne à espérer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0b438bb-3984-45d9-9124-4b522f33e060",
                                                "sense_id": "7d433f15-c89b-3d6c-bc36-b093fe4baf83",
                                                "text": "À la fenêtre, le rideau bat comme une aile, le chaud parfum va et vient, comme ta main prometteuse sur mes cheveux, comme ta lèvre ensorcelante sur mon cou, comme ton amour qui mène sa somptueuse galère dans mon cœur palpitant."
                                            },
                                            {
                                                "example_id": "6181380b-bb3a-4be3-857b-ffd2ac06642e",
                                                "sense_id": "7d433f15-c89b-3d6c-bc36-b093fe4baf83",
                                                "text": "Après un début de saison prometteur, ponctué par deux victoires en trois courses, Ferrari n’a fait qu’enchaîner les boulettes et les contre-performances. Au point de devenir la risée du paddock."
                                            },
                                            {
                                                "example_id": "47c292c7-faf1-4766-940e-d1a46fc9c56a",
                                                "sense_id": "7d433f15-c89b-3d6c-bc36-b093fe4baf83",
                                                "text": "C’était un catalogue très complet, avec des sous-parties sur l’air comprimé, le soudage, les échafaudages, le levage et des tas de rubriques prometteuses de cette sorte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prometteur",
                                "target_lang_code": "fr",
                                "target_senses": [
