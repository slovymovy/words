                "senses": [
                    {
                        "sense_id": "6317d50a-2745-3582-8081-59fc5846551f",
                        "entry_id": "7db2dc48-34c9-3dde-89d4-601d972c7336",
                        "glosses": [
                            "Art, wie ein Vorgesetzter/Lehrer seine Mitarbeiter/Schüler führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13dd24a9-b548-4685-b6a7-ec92e8f75f70",
                                "sense_id": "6317d50a-2745-3582-8081-59fc5846551f",
                                "text": "Ein wesentlicher Teil des Lernerfolges der Schüler hängt von der Menschenführung ihres Lehrers ab."
                            },
                            {
                                "example_id": "0156bf7c-6056-4e02-8f4f-298a0a90f056",
                                "sense_id": "6317d50a-2745-3582-8081-59fc5846551f",
                                "text": "„Die Kunst der Menschenführung ist eine große Aufgabe. Wer führen kann, holt aus seinen Mitarbeitern das Beste heraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c3e386ff-8742-3f25-9d86-1cb225d80271",
                        "entry_id": "7db2dc48-34c9-3dde-89d4-601d972c7336",
                        "glosses": [
                            "Fähigkeit eines Vorgesetzten/Lehrers, seine Mitarbeiter/Schüler zu führen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b83af508-a6b0-4688-9f4a-a609aede5fb8",
                                "sense_id": "c3e386ff-8742-3f25-9d86-1cb225d80271",
                                "text": "Sie verfügt über eine gute Menschenführung."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "189171cb-0a83-4b89-a268-2e5e3bf6ab65",
                        "source_entry_id": "7db2dc48-34c9-3dde-89d4-601d972c7336",
                        "source_sense_id": "6317d50a-2745-3582-8081-59fc5846551f",
                        "source_sense_description": "Psychologie: Art, wie ein Vorgesetzter/Lehrer seine Mitarbeiter/Schüler führt",
                        "target_lang_word": "leadership",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leadership",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fbc8828-9e30-30b9-b4f1-061afc474520",
                                        "entry_id": "c4e96239-70c0-32f2-bc6f-3bf20ab0225a",
                                        "glosses": [
                                            "The capacity of someone to lead others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ef5682d-e1a8-410a-85b1-ecd6e0b9067b",
                                                "sense_id": "4fbc8828-9e30-30b9-b4f1-061afc474520",
                                                "text": "Personal leadership is a fundamental of successful government. I do not mean the leadership of the band of good fellows and good schemers who followed President Harding, nor the purely perfunctory party loyalty which has part of the time in part of the country sustained the present Chief Executive. I mean that leadership which, by sheer force of mind, by chain of unanswerable logic, has brought friends and foes alike to enact vitally needed measures of government reform."
                                            },
                                            {
                                                "example_id": "2fd51878-25b5-43a4-b9e5-003cbabaa60c",
                                                "sense_id": "4fbc8828-9e30-30b9-b4f1-061afc474520",
                                                "text": "Shepard: You have a plan?\nAmbassador Udina: The galaxy needs leadership. Real leadership. When a crisis hits, we can't be paralyzed by debate like the old Council.\nAmbassador Udina: The new Council must rule with a single voice. It must be assembled from one species alone -- humanity!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba71bb33-b696-306a-8c12-661218a37f05",
                                        "entry_id": "c4e96239-70c0-32f2-bc6f-3bf20ab0225a",
                                        "glosses": [
                                            "A group of leaders."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcb4e08c-6a9d-4a99-91a4-a122df2ef169",
                                                "sense_id": "ba71bb33-b696-306a-8c12-661218a37f05",
                                                "text": "People who talk about an imminent possibility of war seldom pose this question: What would North Korea’s leadership get from unleashing a war that they are likely to lose in weeks, if not days?"
                                            },
                                            {
                                                "example_id": "33348799-d7ac-4d22-88ec-b0c55eefb88b",
                                                "sense_id": "ba71bb33-b696-306a-8c12-661218a37f05",
                                                "text": "Companies should survey their employees regularly to evaluate the implementation among the leaderships and peers."
                                            },
                                            {
                                                "example_id": "20364dcf-c01b-404d-b973-25cb1d777372",
                                                "sense_id": "ba71bb33-b696-306a-8c12-661218a37f05",
                                                "text": "In stark opposition to what CBS editorial leadership told staff on Monday, Redstone said that she did not believe Dokoupil had violated the network’s editorial standards when he grilled Coates over the contents of his new book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d53f546b-d851-3bf0-9094-74a86c44e8a3",
                                        "entry_id": "c4e96239-70c0-32f2-bc6f-3bf20ab0225a",
                                        "glosses": [
                                            "The office or status of a leader."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4643122-092c-42eb-a470-40d7fe8f45f3",
                        "source_entry_id": "7db2dc48-34c9-3dde-89d4-601d972c7336",
                        "source_sense_id": "6317d50a-2745-3582-8081-59fc5846551f",
                        "source_sense_description": "Psychologie: Art, wie ein Vorgesetzter/Lehrer seine Mitarbeiter/Schüler führt",
                        "target_lang_word": "leadership",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leadership",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66a37881-8c0b-361f-a079-7798fe10247a",
                                        "entry_id": "9b0d19ba-f31d-327f-a6ba-2b8235769429",
                                        "glosses": [
                                            "Autorité exercée par une personne ou groupe de personnes sur un groupe qu’elle ou il représente."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31dc31fc-d762-4df1-b074-d10137471175",
                                                "sense_id": "66a37881-8c0b-361f-a079-7798fe10247a",
                                                "text": "\"Nous sommes mis à l'épreuve, nos institutions, nos leaderships, nous sommes mis à l'épreuve par une citoyenneté qui est plus sûre d'elle, qui exige de plus importants niveaux de participation et d'égalité\", a déclaré le président."
                                            },
                                            {
                                                "example_id": "92f21c70-c94f-4920-bdb7-73a7f2b74ab4",
                                                "sense_id": "66a37881-8c0b-361f-a079-7798fe10247a",
                                                "text": "C’est quelqu’un qui a su faire grandir les entreprises et les équipes avec un leadership de dingue, et une volonté de préserver l’ADN de la boite."
                                            },
                                            {
                                                "example_id": "70e3e5e6-d0bf-4b10-96ad-cf058c5061f0",
                                                "sense_id": "66a37881-8c0b-361f-a079-7798fe10247a",
                                                "text": "Le leadership se définit comme suit : Diriger, motiver et habiliter de manière à ce que la mission soit accomplie avec professionnalisme et éthique, et chercher en même temps à développer ou à améliorer les capacités qui contribuent au succès de la mission."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f05ee534-2aec-408a-885d-5ca7286cb091",
                        "source_entry_id": "7db2dc48-34c9-3dde-89d4-601d972c7336",
                        "source_sense_id": "6317d50a-2745-3582-8081-59fc5846551f",
                        "source_sense_description": "Psychologie: Art, wie ein Vorgesetzter/Lehrer seine Mitarbeiter/Schüler führt",
                        "target_lang_word": "direction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "direction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "677e9e0c-7361-3e75-aad7-08067181cd52",
                                        "entry_id": "2a7bb37e-2040-35ce-8354-35f4b0292162",
                                        "glosses": [
                                            "Action de diriger, de régler l’exécution d’une action, d'administrer un établissement ou de conduire une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d66766d0-ae8e-40e9-bb9d-0c9a7e22400f",
                                                "sense_id": "677e9e0c-7361-3e75-aad7-08067181cd52",
                                                "text": "Être préposé à la direction de certains travaux."
                                            },
                                            {
                                                "example_id": "3eaae2e8-3c24-4fbd-bb91-b277620feb04",
                                                "sense_id": "677e9e0c-7361-3e75-aad7-08067181cd52",
                                                "text": "Prendre la direction d’une affaire."
                                            },
                                            {
                                                "example_id": "ab38a576-6804-4c79-9c86-ca66d766f877",
                                                "sense_id": "677e9e0c-7361-3e75-aad7-08067181cd52",
                                                "text": "On lui a confié la direction de cet établissement, de ce théâtre."
                                            },
                                            {
                                                "example_id": "1e89a5a1-4eaa-4faa-bedd-c2121e5a8440",
                                                "sense_id": "677e9e0c-7361-3e75-aad7-08067181cd52",
                                                "text": "Pendant cinq siècles, sous la direction de ses capitouls et de ses consuls, Montauban fut une courageuse petite démocratie autonome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b59d3c20-d593-3e11-b218-cd4d0d087d2d",
                                        "entry_id": "2a7bb37e-2040-35ce-8354-35f4b0292162",
                                        "glosses": [
                                            "Fonction, poste de directeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3131702-a410-445e-b04e-51d6ca8e901e",
                                                "sense_id": "b59d3c20-d593-3e11-b218-cd4d0d087d2d",
                                                "text": "Être nommé à la direction d’une entreprise."
                                            },
                                            {
                                                "example_id": "1e3c0c4e-781a-46e2-870b-d2e76cc885b4",
                                                "sense_id": "b59d3c20-d593-3e11-b218-cd4d0d087d2d",
                                                "text": "Solliciter, obtenir une direction."
                                            },
                                            {
                                                "example_id": "1cf48769-2a02-41d4-84eb-15bf0c9fcb8c",
                                                "sense_id": "b59d3c20-d593-3e11-b218-cd4d0d087d2d",
                                                "text": "Sous sa direction, les Catalans ont dominé le football espagnol et ont remporté la Coupe d’Europe I pour la première fois en 1992. Cruijff est entré dans l’histoire comme l’un des meilleurs entraîneurs de football de tous les temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5483bae8-4be5-3927-be03-5c5e370185e3",
                                        "entry_id": "2a7bb37e-2040-35ce-8354-35f4b0292162",
                                        "glosses": [
                                            "Personne ou ensemble des personnes qui dirigent."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "906c349b-944f-4a61-932d-750f12d272f9",
                                                "sense_id": "5483bae8-4be5-3927-be03-5c5e370185e3",
                                                "text": "S’adresser à la direction."
                                            },
                                            {
                                                "example_id": "38b65a3e-db0e-4112-9c92-4c775d1a3307",
                                                "sense_id": "5483bae8-4be5-3927-be03-5c5e370185e3",
                                                "text": "La pilule ne passe pas. Ni pour Peggy, salariée chez Haulotte, […], ni pour Anne, cadre dans la tour Total de La Défense. Toutes deux ont télétravaillé à 100 % « sans problème » lors du premier confinement, mais voilà que les directions de ces deux entreprises demandent à leurs effectifs de se rendre dans les bureaux, entre deux et trois jours par semaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f880dd6e-8a84-3515-98ee-894ba6bd8ea7",
                                        "entry_id": "2a7bb37e-2040-35ce-8354-35f4b0292162",
                                        "glosses": [
                                            "Service placé sous l'autorité d’un directeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec24dd87-3c01-4783-a41b-c2333ebb50c4",
                                                "sense_id": "f880dd6e-8a84-3515-98ee-894ba6bd8ea7",
                                                "text": "Direction des douanes."
                                            },
                                            {
                                                "example_id": "9a293fbb-ff58-4045-8ece-a10a7d6d6b52",
                                                "sense_id": "f880dd6e-8a84-3515-98ee-894ba6bd8ea7",
                                                "text": "Direction des services administratifs."
                                            },
                                            {
                                                "example_id": "f8ea76f6-d131-4342-8afa-66df6faa415d",
                                                "sense_id": "f880dd6e-8a84-3515-98ee-894ba6bd8ea7",
                                                "text": "La direction nationale du Parti communiste, dans sa presse clandestine, dans ses tracts, attaquait toujours plutôt Vichy que l’occupant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bcd2d36-eb75-3040-b1c7-241bcd91dd5a",
                                        "entry_id": "2a7bb37e-2040-35ce-8354-35f4b0292162",
                                        "glosses": [
                                            "Ensemble de bureaux où sont installés un directeur et ses collaborateurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19c67925-997c-43ca-b468-e8d44dd87489",
                                                "sense_id": "9bcd2d36-eb75-3040-b1c7-241bcd91dd5a",
                                                "text": "Se rendre à la direction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c6aa86d-f10f-361b-938a-1750f9ab8e3e",
                                        "entry_id": "2a7bb37e-2040-35ce-8354-35f4b0292162",
                                        "glosses": [
                                            "Étendue de la compétence d’un directeur, circonscription qui relève de son autorité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd022973-5452-4f56-b792-492912212871",
                                                "sense_id": "5c6aa86d-f10f-361b-938a-1750f9ab8e3e",
                                                "text": "Dépendre d’une direction."
                                            },
                                            {
                                                "example_id": "2dbd6a7c-68a7-4819-985e-8e41198e0329",
                                                "sense_id": "5c6aa86d-f10f-361b-938a-1750f9ab8e3e",
                                                "text": "Direction collégiale.",
                                                "translation": "Où les décisions sont prises conjointement par plusieurs personnes d’égal pouvoir."
                                            },
                                            {
                                                "example_id": "33dc6482-8d14-4b12-878d-7390e727b03e",
                                                "sense_id": "5c6aa86d-f10f-361b-938a-1750f9ab8e3e",
                                                "text": "Les membres de la direction collégiale assurent collectivement la gestion de l’association et la responsabilité légale auprès des tiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2f8aef2-e7cf-3f90-9799-6af353a22456",
                                        "entry_id": "2a7bb37e-2040-35ce-8354-35f4b0292162",
                                        "glosses": [
                                            "Côté vers lequel une personne ou une chose se dirige, est dirigée ou tournée ; voie suivie pour arriver à un point donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ad7404e-add4-4393-bf3c-d8ef369b10c7",
                                                "sense_id": "e2f8aef2-e7cf-3f90-9799-6af353a22456",
                                                "text": "Et comme cet avorton levait le nez en notre direction, Bob aussitôt se rendit à sa table où tous deux, me parut-il, avaient à parler."
                                            },
                                            {
                                                "example_id": "dda89ea5-da86-4da2-9148-e65624b8dd92",
                                                "sense_id": "e2f8aef2-e7cf-3f90-9799-6af353a22456",
                                                "text": "Nos animaux porteurs, débarrassés de leurs bâts, se sont égaillés parmi les arbres dans la direction d’une vallée boisée qui masque une mare saline."
                                            },
                                            {
                                                "example_id": "e2a2f378-cc27-43c5-ae3d-8901ea49ee36",
                                                "sense_id": "e2f8aef2-e7cf-3f90-9799-6af353a22456",
                                                "text": "Être dans la direction d’un objet."
                                            },
                                            {
                                                "example_id": "e95cd078-ff84-4b0c-b300-5ff073f19054",
                                                "sense_id": "e2f8aef2-e7cf-3f90-9799-6af353a22456",
                                                "text": "Cette fois, ça y est, droit devant nous, après le pont, où il y a embouteillage. Direction : U.S.A."
                                            },
                                            {
                                                "example_id": "e6cc3c2b-c37f-44ff-a693-0aaa56e4cc3e",
                                                "sense_id": "e2f8aef2-e7cf-3f90-9799-6af353a22456",
                                                "text": "Toutes directions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a926f444-a0a5-32b4-810d-527f11832d84",
                                        "entry_id": "2a7bb37e-2040-35ce-8354-35f4b0292162",
                                        "glosses": [
                                            "Orientation donnée à une entreprise, à une action, une politique, etc. ; manière dont elle se développe."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ccde5f4-7cb5-47e2-b390-86bc7f6a0bb0",
                                                "sense_id": "a926f444-a0a5-32b4-810d-527f11832d84",
                                                "text": "Donner à une affaire la direction convenable."
                                            },
                                            {
                                                "example_id": "7373d89d-63f8-4f60-bd56-c3a7361dbfa6",
                                                "sense_id": "a926f444-a0a5-32b4-810d-527f11832d84",
                                                "text": "Mes idées prirent alors une autre direction."
                                            },
                                            {
                                                "example_id": "30bc291f-686a-4642-b10a-5c758b49ff3b",
                                                "sense_id": "a926f444-a0a5-32b4-810d-527f11832d84",
                                                "text": "Bien sûr, il y a encore beaucoup de courage individuel, mais ce ne sont pas ces gens-là qui donnent sa direction à la vie de la société."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c820f614-bf1f-31b7-b439-00b5ce8818c1",
                                        "entry_id": "2a7bb37e-2040-35ce-8354-35f4b0292162",
                                        "glosses": [
                                            "Droite suivant laquelle se déplace ou s’oriente un corps, s’exerce une force."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31cbfc36-781b-40c7-9598-0c4b9e54943e",
                                                "sense_id": "c820f614-bf1f-31b7-b439-00b5ce8818c1",
                                                "text": "Après Saint-Georges-de-Didonne, direction Meschers-sur-Gironde."
                                            },
                                            {
                                                "example_id": "b22fab1e-94b1-414b-bf22-2a4c3cf34461",
                                                "sense_id": "c820f614-bf1f-31b7-b439-00b5ce8818c1",
                                                "text": "Mermoz allait dans son bureau contempler la carte. Il faisait et refaisait les calculs. Oui, selon la direction et la force des vents, il mettrait de vingt à vingt-quatre heures pour aller de Dakar à Natal en avion."
                                            },
                                            {
                                                "example_id": "bca140c1-df65-4f4d-adda-06233398705c",
                                                "sense_id": "c820f614-bf1f-31b7-b439-00b5ce8818c1",
                                                "text": "Cet angle a été adopté, parce qu’on a remarqué que le vent ne souffle pas horizontalement, mais que sa direction plonge ordinairement un peu sur la surface de la terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94cee762-cf1e-355d-8f57-e9d5dd030b5e",
                                        "entry_id": "2a7bb37e-2040-35ce-8354-35f4b0292162",
                                        "glosses": [
                                            "Adopter une bonne, une mauvaise conduite."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "297aef66-124a-440b-80d4-75e6722dc085",
                                                "sense_id": "94cee762-cf1e-355d-8f57-e9d5dd030b5e",
                                                "text": "Prendre une bonne, une mauvaise direction."
                                            },
                                            {
                                                "example_id": "dfdf3efb-bffb-4d42-8470-07646c008b43",
                                                "sense_id": "94cee762-cf1e-355d-8f57-e9d5dd030b5e",
                                                "text": "Détourner quelqu’un de la bonne direction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d40a88e-10f0-327f-b208-ccf865852bf4",
                                        "entry_id": "2a7bb37e-2040-35ce-8354-35f4b0292162",
                                        "glosses": [
                                            "Ensemble des organes qui permettent d'orienter les roues directrices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45012e20-65e3-4dea-a128-78ff550bcf79",
                                                "sense_id": "7d40a88e-10f0-327f-b208-ccf865852bf4",
                                                "text": "La direction de cette voiture a été faussée."
                                            },
                                            {
                                                "example_id": "7197392d-c94a-4a9c-b3d3-44ad9a77d8ea",
                                                "sense_id": "7d40a88e-10f0-327f-b208-ccf865852bf4",
                                                "text": "Le système de direction permet d’orienter les roues directrices selon les desiderata du conducteur"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51169f0f-d0d8-31c4-8853-ad2daec31248",
                                        "entry_id": "2a7bb37e-2040-35ce-8354-35f4b0292162",
                                        "glosses": [
                                            "Fonction de directeur de conscience, qui guide par ses conseils la vie spirituelle d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35aa1c28-8994-4144-a8c7-7143dd560c67",
                                                "sense_id": "51169f0f-d0d8-31c4-8853-ad2daec31248",
                                                "text": "Ce prêtre excellait dans la direction."
                                            },
                                            {
                                                "example_id": "d3348bbe-b3b3-45de-99b1-6d1862ed8747",
                                                "sense_id": "51169f0f-d0d8-31c4-8853-ad2daec31248",
                                                "text": "Action mentale, par laquelle, dans un acte douteux ou mauvais, on dirige son intention vers une bonne fin."
                                            },
                                            {
                                                "example_id": "a70ba9f6-8650-4cd1-964f-0e0035bc230f",
                                                "sense_id": "51169f0f-d0d8-31c4-8853-ad2daec31248",
                                                "text": "Pascal reproche aux casuistes d’effacer beaucoup de péchés par la direction d’intention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "076bef23-4bd7-3ec6-9e5e-57becc98ad23",
                                        "entry_id": "2a7bb37e-2040-35ce-8354-35f4b0292162",
                                        "glosses": [
                                            "Propriété commune à des droites parallèles, ou à des objets portés par des droites parallèles tels que des segments ou des demi-droites, ou propriété d’un vecteur."
                                        ],
                                        "tags": [],
                                        "note": "ne pas confondre « direction » et « sens » en géométrie",
                                        "examples": [
                                            {
                                                "example_id": "884d0a01-ad98-4a28-8565-1311eb7fd099",
                                                "sense_id": "076bef23-4bd7-3ec6-9e5e-57becc98ad23",
                                                "text": "Sur des droites de même direction sont possibles deux sens de parcours, opposés l’un de l’autre."
                                            },
                                            {
                                                "example_id": "1614f7ef-9f48-435f-9db7-e952ed1c99de",
                                                "sense_id": "076bef23-4bd7-3ec6-9e5e-57becc98ad23",
                                                "text": "Un vecteur est caractérisé par sa direction, son sens et sa norme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
