                            {
                                "example_id": "595087f7-d8fb-459c-baef-ef26d0c92a15",
                                "sense_id": "a7ad56ad-1496-3f2b-8442-cb24fa1817c5",
                                "text": "Sie war wegen eines am unteren Ende und der äusseren Seite des Oberarmes sitzenden, mehr als thalergrossen ovalen, mit schalenförmigen gelben Krusten bedeckten Geschwüres mit der Diagnose Rupia zugewiesen worden."
                            },
                            {
                                "example_id": "15d16e55-e78d-4130-aa9f-85793835793f",
                                "sense_id": "a7ad56ad-1496-3f2b-8442-cb24fa1817c5",
                                "text": "Da die Rupia indessen verschwunden war, wurde die Kranke entlassen."
                            }
                        ],
