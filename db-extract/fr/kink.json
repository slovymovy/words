                                        ],
                                        "examples": [
                                            {
                                                "example_id": "358c371e-b1bd-41e9-859d-facfdfb880e0",
                                                "sense_id": "6619cfdf-a7e3-308f-ae3b-133a330e6896",
                                                "text": "\"What do they think you know?\"\n\"No more than I've told you. That he's a kink. He rapes people and kills people and spends too much money and flies grass in.\""
                                            },
