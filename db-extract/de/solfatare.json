                "senses": [
                    {
                        "sense_id": "fd37d191-e41f-36c3-b743-ca262e8e1ef3",
                        "entry_id": "d72a529b-4540-3c34-bc10-fd89ea8cc64e",
                        "glosses": [
                            "über vulkanischem Gebiet aus Erdspalten ausströmende Gase mit einem hohen Anteil an Schwefelwasserstoffverbindungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7419b2d6-d4da-4f33-b3d2-2d8d25f54db6",
                                "sense_id": "fd37d191-e41f-36c3-b743-ca262e8e1ef3",
                                "text": "„Als Solfatare, ‚Schwefelgrube‘, bezeichnet man die nachvulkanischen Stellen, an denen 100-200 °C heißer Wasserdampf und Schwefelwasserstoff ausströmt.“"
                            },
                            {
                                "example_id": "272a809d-2834-4c13-9ac4-b29dd8864b2f",
                                "sense_id": "fd37d191-e41f-36c3-b743-ca262e8e1ef3",
                                "text": "„Beim Betreten der Solfatare bemerkt man zunächst die weisse Färbung des Bodens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "922bd7db-5c33-4ff6-b0ab-e452b52182c9",
                        "source_entry_id": "d72a529b-4540-3c34-bc10-fd89ea8cc64e",
                        "source_sense_id": "fd37d191-e41f-36c3-b743-ca262e8e1ef3",
                        "target_lang_word": "solfatara",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solfatara",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4a2008a-7653-340f-9164-7613be1c5cfd",
                                        "entry_id": "f635a6af-c30e-39eb-8e17-fca8151db405",
                                        "glosses": [
                                            "An area of volcanic activity that gives off sulfurous steam."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3dcfdd7-533f-4725-994e-3cf388a63b26",
                                                "sense_id": "f4a2008a-7653-340f-9164-7613be1c5cfd",
                                                "text": "Under these solfataras, (which, at each eruption from the volcano, emitted greater quantities of hot steams) are several hot wells, close to the high-water mark, which, however, seem not to be in the least sulphureous."
                                            },
                                            {
                                                "example_id": "75474bd6-c925-4630-bcc7-5fd5a6c05527",
                                                "sense_id": "f4a2008a-7653-340f-9164-7613be1c5cfd",
                                                "text": "Holmes calls these active vents solfataras, so evidently we are at the type locality for this kind of thing."
                                            },
                                            {
                                                "example_id": "ec6332bc-591b-41d3-a9d3-ac5469720dd6",
                                                "sense_id": "f4a2008a-7653-340f-9164-7613be1c5cfd",
                                                "text": "Vents that produce steam alone are fumaroles, or solfataras if laden with sulphur; impressive, but rarely exciting, they are more common on drier volcanoes than in hydrothermal basins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1733cc4b-c3c6-4b35-b655-e8819b7ac0a3",
                        "source_entry_id": "d72a529b-4540-3c34-bc10-fd89ea8cc64e",
                        "source_sense_id": "fd37d191-e41f-36c3-b743-ca262e8e1ef3",
                        "target_lang_word": "solfatare",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solfatare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56ca2fca-4020-3555-a9f1-6bd6abcd5d4e",
                                        "entry_id": "71427239-fb7d-3c65-933c-8fd41490c3d6",
                                        "glosses": [
                                            "Terrain d’où se dégagent des vapeurs sulfureuses et où se dépose du soufre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3cb8cd2-12eb-43c7-8e56-87f136b508ac",
                                                "sense_id": "56ca2fca-4020-3555-a9f1-6bd6abcd5d4e",
                                                "text": "Ces solfatares sont le résultat de la décomposition de la lave et d’un agglomérat palagonitique, qui se transforment en une sorte de boue formée d’un mélange de calcaire et de silice ; le soufre se dépose à la surface par sublimation, et forme une croûte dont l’épaisseur varie d’un demi-pouce à plusieurs pieds."
                                            },
                                            {
                                                "example_id": "85c9be17-860f-4001-95b4-9d8b9581e5f4",
                                                "sense_id": "56ca2fca-4020-3555-a9f1-6bd6abcd5d4e",
                                                "text": "J’escaladai l’étroite crevasse et débouchai sur la solfatare du côté ouest du village des hommes-animaux."
                                            },
                                            {
                                                "example_id": "605c6b94-5d92-4e90-a303-c12f9c32dfc9",
                                                "sense_id": "56ca2fca-4020-3555-a9f1-6bd6abcd5d4e",
                                                "text": "Michel descend plus avant, vers des abîmes de perdition qu’il n’imagine que vaguement, puants et dangereux comme des solfatares."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
