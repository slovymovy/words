                    "semantic_group_id": "culinair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De chef serveerde een verfrissend <w>tussengerecht</w> om de smaakpapillen te neutraliseren.",
                            "target_lang_translations": {
                                "zh": "主厨上了一道清爽的<w>间菜</w>，以中和味蕾。"
