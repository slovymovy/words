                ],
                "senses": [
                    {
                        "sense_id": "adf2e22e-6dc2-3d0b-94dd-736a130be9f0",
                        "entry_id": "1d96b274-ce5b-3564-bbc9-217814f61c39",
                        "glosses": [
                            "Celui qui subit la damnation éternelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26b1af69-1969-4214-adaa-f5760579e1f3",
                                "sense_id": "adf2e22e-6dc2-3d0b-94dd-736a130be9f0",
                                "text": "Souffrir comme un damné."
                            }
                        ]
                    },
                    {
                        "sense_id": "0df42755-dcf1-38c8-b44e-736024c8ef70",
                        "entry_id": "1d96b274-ce5b-3564-bbc9-217814f61c39",
                        "glosses": [
                            "Celui qui souffre de maints maux."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "47d3bc68-dd58-4f62-91df-ef64cc81ab28",
                                "sense_id": "0df42755-dcf1-38c8-b44e-736024c8ef70",
                                "text": "Debout ! les damnés de la terre\nDebout ! les forçats de la faim\nLa raison tonne en son cratère :\nC’est l’éruption de la fin […]"
                            },
                            {
                                "example_id": "59264d72-1e01-4962-a8a6-47f5771692fc",
                                "sense_id": "0df42755-dcf1-38c8-b44e-736024c8ef70",
                                "text": "Et bien des fois, descendu dans la nuit des géhennes sociales, j’ai porté aux moribonds la résignation, l’espérance aux désespérés ; bien des fois j’ai changé en cris de joie les lamentations farouches de ces damnés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fc60e8e-5929-4746-afb3-0f8b42c13af5",
                        "source_entry_id": "1d96b274-ce5b-3564-bbc9-217814f61c39",
                        "target_lang_word": "damned",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "damned",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5883e6f0-3392-37b8-b01c-fc305adb8de2",
                                        "entry_id": "d4df231d-361f-3e68-8ef3-72d179151359",
                                        "glosses": [
                                            "Godforsaken."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6811c8ef-0c4c-4771-a85e-fb822ec9d4cc",
                                                "sense_id": "5883e6f0-3392-37b8-b01c-fc305adb8de2",
                                                "text": "You're children of the damned // like candles, watch them burn // burning in the light // you'll burn again tonight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9e12883-4696-33ce-81cf-b502615c7f1d",
                                        "entry_id": "d4df231d-361f-3e68-8ef3-72d179151359",
                                        "glosses": [
                                            "Variant of profane damn, used to express contempt, exasperation, etc. towards someone or something."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e7faea6-5b0c-4f5d-9cfb-51afc0da0ac2",
                                                "sense_id": "d9e12883-4696-33ce-81cf-b502615c7f1d",
                                                "text": "Their damned lawyers can go to hell."
                                            },
                                            {
                                                "example_id": "e3f40b3c-c157-4595-a7cb-d94babc632ae",
                                                "sense_id": "d9e12883-4696-33ce-81cf-b502615c7f1d",
                                                "text": "I can't get this damned thing to work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "050540f7-b921-3d21-9580-4d22131e1c65",
                                        "entry_id": "d4df231d-361f-3e68-8ef3-72d179151359",
                                        "glosses": [
                                            "Ellipsis of I'll be damned."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
