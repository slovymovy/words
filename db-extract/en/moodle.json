                ],
                "senses": [
                    {
                        "sense_id": "bb0014bb-3a15-38a0-a4eb-e68e46dc81dc",
                        "entry_id": "e17311e7-a002-30cf-b3e3-0e80f47243ed",
                        "glosses": [
                            "Alternative form of Moodle."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "858ec2eb-18da-4df1-82ec-edb23db0a0e9",
                                "sense_id": "bb0014bb-3a15-38a0-a4eb-e68e46dc81dc",
                                "text": "Better yet, take advantage of shared drives, moodles, and blogs as online resources."
                            },
                            {
                                "example_id": "5c3ac55f-a4e1-4001-a69e-0ecbb9b203c3",
                                "sense_id": "bb0014bb-3a15-38a0-a4eb-e68e46dc81dc",
                                "text": "We could equally explore the potential of wikis, drupals, moodles and other software for reflecting on performance making."
                            },
                            {
                                "example_id": "f3cb73b9-6794-43d2-8f20-731a37fcb2f1",
                                "sense_id": "bb0014bb-3a15-38a0-a4eb-e68e46dc81dc",
                                "text": "Share what has been created in a binder or consider high-tech collaboration tools such as blogs, wikis, or moodles."
                            },
                            {
                                "example_id": "4c0b3084-7930-4241-8b49-86732afb3f97",
                                "sense_id": "bb0014bb-3a15-38a0-a4eb-e68e46dc81dc",
                                "text": "The institute continuously strives to host training programs for teachers and students to develop and learn course contents using 'moodles' available for teaching and learning activities."
                            },
                            {
                                "example_id": "e15c8b7e-a411-4f06-bf00-1f03c512570a",
                                "sense_id": "bb0014bb-3a15-38a0-a4eb-e68e46dc81dc",
                                "text": "The students do not only use smartphones and social media for entertainment, but they use them for information sharing, content sharing, academic peer group discussion, accessing learning websites and applications, and for accessing moodles."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "671acc71-8c18-356b-a6f5-e965c613da68",
