                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1895cd5f-af74-47b9-a4bb-a5ad720190b1",
                        "entry_id": "424df60a-476f-3e30-8e8b-3a657ef066f8",
                        "tags": [
                            "plural"
                        ],
                        "form": "guérisons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0ff3e5f7-574c-31ba-98e1-e23079a88556",
                        "entry_id": "424df60a-476f-3e30-8e8b-3a657ef066f8",
                        "glosses": [
                            "Action de guérir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c53d7e8-d3b3-4ae5-a39a-93ed5f8ce785",
                                "sense_id": "0ff3e5f7-574c-31ba-98e1-e23079a88556",
                                "text": "Le Dr Aignier déclare au Congrès des monistes (Magdebourg, 6-10 septembre 1912) n'avoir constaté à Lourdes ni guérison ni amélioration véritables."
                            },
                            {
                                "example_id": "fc330ffc-1a07-49c4-ad5e-0f2e70590b27",
                                "sense_id": "0ff3e5f7-574c-31ba-98e1-e23079a88556",
                                "text": "Guérison entière, parfaite, imparfaite."
                            },
                            {
                                "example_id": "1d845bc2-dbf9-4646-a317-ff5e2b3cef0e",
                                "sense_id": "0ff3e5f7-574c-31ba-98e1-e23079a88556",
                                "text": "Il doit sa guérison à tel médecin, à tel remède."
                            },
                            {
                                "example_id": "dad4a813-9497-4cdc-bc25-ae032f070514",
                                "sense_id": "0ff3e5f7-574c-31ba-98e1-e23079a88556",
                                "text": "Il ne pourra partir qu’après sa guérison, qu’après guérison."
                            },
                            {
                                "example_id": "ac1d2a54-94f8-4596-8695-b6d1614de682",
                                "sense_id": "0ff3e5f7-574c-31ba-98e1-e23079a88556",
                                "text": "La guérison de ces sortes de maux, de maladies est lente, est difficile."
                            },
                            {
                                "example_id": "1d8a5213-27d5-47ad-a14e-593c02fba889",
                                "sense_id": "0ff3e5f7-574c-31ba-98e1-e23079a88556",
                                "text": "Ce sont les machines qui, littéralement, enfantent notre monde. Et qui, de cet enfantement, permettent l’émergence d’un nouvel écosystème, d’une nouvelle espèce : depuis un peu moins d’un siècle, vous, moi, tous ceux qui lisent ce livre, doivent leur vie, leurs guérisons, leur agonie, leur bonheur et désespoir de moins en moins aux êtres qui peuplent leur désirs et de plus en plus aux machines qui les veillent calmement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73ece846-b06a-41fc-b441-545c3f448f50",
                        "source_entry_id": "424df60a-476f-3e30-8e8b-3a657ef066f8",
                        "source_sense_id": "0ff3e5f7-574c-31ba-98e1-e23079a88556",
                        "target_lang_word": "Heilung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heilung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a64567ae-000b-37fc-8362-5fa5664b3305",
                                        "entry_id": "d15e27a3-79e4-37ad-bd1d-36b40ffec251",
                                        "glosses": [
                                            "medizinische Maßnahmen zur Überwindung einer körperlichen oder psychischen Krankheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "214505c0-1554-4eea-bbea-a619a69386e8",
                                                "sense_id": "a64567ae-000b-37fc-8362-5fa5664b3305",
                                                "text": "Für die Heilung des Patienten wurden Medikamente verabreicht."
                                            },
                                            {
                                                "example_id": "246a2277-9fc6-4f90-8d9b-d7185e1e2da0",
                                                "sense_id": "a64567ae-000b-37fc-8362-5fa5664b3305",
                                                "text": "„Aus Einsicht kann Wissenschaft Heilung schaffen.“"
                                            },
                                            {
                                                "example_id": "b67e22c2-8a88-44b0-a25c-6cbaa532dc29",
                                                "sense_id": "a64567ae-000b-37fc-8362-5fa5664b3305",
                                                "text": "„Ziel ist nicht, wie Laien oft denken, die vollkommene Heilung von abnormen sexuellen Verlangen wie der Pädophilie, die in der Medizinersprache als Paraphilie zusammengefasst ist.“"
                                            },
                                            {
                                                "example_id": "014a1421-b05a-4a2d-8f8f-f12528b268de",
                                                "sense_id": "a64567ae-000b-37fc-8362-5fa5664b3305",
                                                "text": "„Heilung ist gut, Prophylaxe ist besser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "03b50117-76d4-3f60-af1e-64a416103f1e",
                                        "entry_id": "d15e27a3-79e4-37ad-bd1d-36b40ffec251",
                                        "glosses": [
                                            "der Vorgang der Gesundung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f356a4a-31d3-44bf-8754-a6e5486d3bc8",
                                                "sense_id": "03b50117-76d4-3f60-af1e-64a416103f1e",
                                                "text": "Die Heilung des lungenkranken Patienten machte im trockenen Klima gute Fortschritte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bacee308-76a6-3aef-a7c5-eae6728904a9",
                                        "entry_id": "d15e27a3-79e4-37ad-bd1d-36b40ffec251",
                                        "glosses": [
                                            "Beseitigung eines Verfahrensmangels oder Verfahrensfehlers (Formmangel, Formfehler, Gehörsverletzung, Nichtigkeit, Zustellungsmangel oder dergleichen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5b5904d-1a93-44bd-af1e-eb1e1b603ef6",
                                                "sense_id": "bacee308-76a6-3aef-a7c5-eae6728904a9",
                                                "text": "Eine Heilung von Gehörsverstößen in der gleichen oder einer weiteren Instanz hat die Senatsrechtsprechung des Bundesverfassungsgerichts vor der Einführung der Anhörungsrüge schon als grundsätzlich möglich angesehen, wenn das betreffende Gericht in der Lage ist, das Vorbringen zu berücksichtigen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
