                        "sense_id": "f00721f6-051a-3482-a219-9fbc262b4249",
                        "entry_id": "ce0ed582-dcd9-3573-b30f-badceba32483",
                        "glosses": [
                            "To turn someone into a lunatic."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ab3ed0f1-49a4-46d4-880a-066530139a5a",
                                "sense_id": "f00721f6-051a-3482-a219-9fbc262b4249",
                                "text": "The spiritual disease of the ego which consists in continuously sounding its own note produces madness; and indeed the monotony of it almost lunatizes others also."
                            },
                            {
                                "example_id": "f32d6d46-c62a-46e9-a5f4-0d3402edeb4f",
                                "sense_id": "f00721f6-051a-3482-a219-9fbc262b4249",
                                "text": "He will understand — even if he pretends ignorance, as the idea of being lunatized has never been wholly absent from his mind."
                            }
                        ]
                    }
                ],
