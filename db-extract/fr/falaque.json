                        "sense_id": "8979fcc8-28a2-3068-88b7-efe27fc3f260",
                        "entry_id": "1d0e2de4-4415-36cd-87d5-de55c785fa40",
                        "glosses": [
                            "Bastonnade des pieds, supplice pratiqué en Orient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57666b88-ad61-4f08-a6c0-71e83e9b9c9b",
                                "sense_id": "8979fcc8-28a2-3068-88b7-efe27fc3f260",
                                "text": "La falaque ou bastonnade sur la plante des pieds est pour les moindres crimes : mais quand leurs crimes méritent la mort, il les fait étrangler ou coudre dans un sac & jetter dans quelque lac ou rivière."
                            },
                            {
                                "example_id": "11b44d30-f5d5-408d-a4a5-7d5342819491",
                                "sense_id": "8979fcc8-28a2-3068-88b7-efe27fc3f260",
                                "text": "Souvent on leur donne la falaque, ayant la tête contre terre, et recevant sur leurs pieds élevés en haut et passés dans les trous d’un morceau de bois, des centaines de coups de bâton, ou de cordes poicées, ou de nerfs de bœufs !"
                            }
                        ]
                    }
                ],
