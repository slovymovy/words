                        "examples": [
                            {
                                "example_id": "d92d9b92-05de-4d31-86e5-d7d6ef93e165",
                                "sense_id": "2f243044-e822-33e1-9385-f34d79d2583f",
                                "text": "Les bandes-annonces sont hyper-vendeuses, elles montrent, mais ne racontent pas: les trailers sont plus rapides, contiennent moins de narration et plus d’explosions, montrent des scènes-clé, et contiennent des images tournées juste pour le trailer."
                            },
                            {
                                "example_id": "7e3ca684-a1d9-4647-a29d-3c2bbfd70496",
                                "sense_id": "2f243044-e822-33e1-9385-f34d79d2583f",
                                "text": "Le cinéma nous a présenté une vision hyper-vendeuse des robots sexuels."
                            },
                            {
                                "example_id": "ba9e2cdc-3f43-403e-b233-9c80d423dae5",
                                "sense_id": "2f243044-e822-33e1-9385-f34d79d2583f",
                                "text": "Les billets de Caroline et les tiens sont hyper-vendeurs et donnent envie d’embarquer tout de suite, en larguant sans scrupule boulot et grisaille d’ici."
                            }
                        ]
                    }
