                                        "glosses": [
                                            "Resembling or containing flint; hard like flint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4cac749-3432-4cd9-80b9-2c89db5ac50c",
                                                "sense_id": "201f130c-a58b-37dc-b5f8-07b7b9cc96dd",
                                                "text": "It was late at night and frosty; high above them on the hills the cloppety clop, cloppety clop of a horse's hooves picking their way on the flinty stone track died away in the distance."
                                            }
                                        ]
                                    },
