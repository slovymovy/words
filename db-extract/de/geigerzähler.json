                "senses": [
                    {
                        "sense_id": "c17c9141-87fa-36b9-94bd-979f1dceb1e0",
                        "entry_id": "aa658274-f6de-384f-ba33-67bd93b3731e",
                        "glosses": [
                            "ein Detektor für ionisierende Strahlung, also Alpha-, Beta-, Gamma- und Protonenstrahlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "054b7a59-d5e3-4a1f-abe8-6e9ff19a57da",
                                "sense_id": "c17c9141-87fa-36b9-94bd-979f1dceb1e0",
                                "text": "Mit einem Geigerzähler kann man messen, wie stark die Strahlung ist."
                            },
                            {
                                "example_id": "75a72faf-d052-48ea-8dff-6c53eea4bdab",
                                "sense_id": "c17c9141-87fa-36b9-94bd-979f1dceb1e0",
                                "text": "„Der Mann bemerkte dies, legte den Geigerzähler zurück auf den Holzblock und folgte dem Blick des Hundes.“"
                            },
                            {
                                "example_id": "e63bbbb0-c3d2-4eac-bd3b-97d75d086699",
                                "sense_id": "c17c9141-87fa-36b9-94bd-979f1dceb1e0",
                                "text": "„Der Verkauf von Geigerzählern stieg rasant an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "135a8998-44ac-4ec1-a079-db90c101b5b3",
                        "source_entry_id": "aa658274-f6de-384f-ba33-67bd93b3731e",
                        "source_sense_id": "c17c9141-87fa-36b9-94bd-979f1dceb1e0",
                        "source_sense_description": "ein Detektor für ionisierende Strahlung, also Alpha-, Beta-, Gamma- und Protonenstrahlung",
                        "target_lang_word": "Geiger counter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geiger counter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48a798b5-d014-37ca-92c0-6a0816effee7",
                                        "entry_id": "28daaee3-144f-3406-b796-09fd6ccb0b37",
                                        "glosses": [
                                            "A device designed to detect radioactivity and measure its intensity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "685723ec-8d3a-47dc-88c2-5d5b63de207b",
                                                "sense_id": "48a798b5-d014-37ca-92c0-6a0816effee7",
                                                "text": "Figure 27 shows a Geiger counter, used to detect ionizing radiation. The counter consists of a thin central wire, carrying a positive charge, surrounded by a concentric circular conducting cylinder, carrying an equal negative charge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f4ef385-8263-3ea3-887e-6388e21d4450",
                                        "entry_id": "28daaee3-144f-3406-b796-09fd6ccb0b37",
                                        "glosses": [
                                            "a feature of an RFID reader that emits a sound indicating the signal strength of an RFID tag that is being searched for."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a82b2310-3691-45e2-96e0-ebfd0b400f22",
                                                "sense_id": "8f4ef385-8263-3ea3-887e-6388e21d4450",
                                                "text": "Any Geiger Counter feature can direct a user towards an RFID tagged item or at least point the user in the right direction, depending on how far away the RFID tag is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
