                "senses": [
                    {
                        "sense_id": "c889d899-6251-3984-a2a1-aa59b0abd294",
                        "entry_id": "7e939e8a-e021-37b2-a00d-a794d54f237e",
                        "glosses": [
                            "kroatische Hafenstadt in Dalmatien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78ec9bb2-1da1-4d26-b0ef-d27d2a751512",
                                "sense_id": "c889d899-6251-3984-a2a1-aa59b0abd294",
                                "text": "Split, die zweitgrößte Stadt Kroatiens, wurde 1979 von der UNESCO zum Weltkulturerbe erklärt."
                            },
                            {
                                "example_id": "56b75c25-e714-482b-b166-2b6996c919c3",
                                "sense_id": "c889d899-6251-3984-a2a1-aa59b0abd294",
                                "text": "In Split hat man immer Zeit für einen kava, einen Kaffee. Egal, zu welcher Stunde."
                            },
                            {
                                "example_id": "4beadb42-39ee-40de-a4e9-846084d007a6",
                                "sense_id": "c889d899-6251-3984-a2a1-aa59b0abd294",
                                "text": "Den Touristen erzählt Katja andere Geschichten, von illyrischen Völkern, die sich in der Region ansiedelten, von den Römern, später den kroatischen Stämmen, die im 7. Jahrhundert einfielen, von den Venezianern, die 1420 Split übernahmen und die Westmauer einrissen, damit sich die Stadt ausbreiten konnte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
