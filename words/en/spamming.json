            "senses": [
                {
                    "sense_id": "528c793f-f4c6-3e45-a789-1d7add06438a",
                    "sense_definition": "Present participle and gerund of <w>spam</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "internet_abuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>spamming</w> all her contacts with links to her new website.",
                            "target_lang_translations": {
                                "ru": "Она <w>спамила</w> всем своим контактам ссылками на свой новый сайт."
                            }
                        },
                        {
                            "text": "The user was <w>spamming</w> the chat room with repetitive messages.",
                            "target_lang_translations": {
                                "ru": "Пользователь <w>спамил</w> в чате повторяющимися сообщениями."
                            }
                        }
                    ],
                    "traits": [
