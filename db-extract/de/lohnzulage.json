                        "sense_id": "bfc655db-b673-3959-8694-c71cdd29ffc4",
                        "entry_id": "21ccbc41-0ca9-38b0-91b2-74cbe734f82e",
                        "glosses": [
                            "Aufschlag auf den zuvor gezahlten Lohn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15981e6c-f93b-4920-af4b-83e82adf6295",
                                "sense_id": "bfc655db-b673-3959-8694-c71cdd29ffc4",
                                "text": "„Die königlich-bayerische Regierung machte den moderaten Arbeitervertretern einige Zugeständnisse, vor allem Lohnzulagen und bessere Verpflegung, und am 3. Februar endete der Streik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0469d6d2-a815-42fb-a17d-5dd2bfd646a5",
                        "source_entry_id": "21ccbc41-0ca9-38b0-91b2-74cbe734f82e",
                        "source_sense_id": "bfc655db-b673-3959-8694-c71cdd29ffc4",
                        "source_sense_description": "Aufschlag auf den zuvor gezahlten Lohn",
                        "target_lang_word": "prime",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prime",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3630b56-4fdf-3941-9f8d-6762c254326f",
                                        "entry_id": "c5b95711-075d-3db1-81ba-0121c69f16bc",
                                        "glosses": [
                                            "Premier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a35d96e-b553-416d-afd9-bcd2fecd223e",
                                                "sense_id": "e3630b56-4fdf-3941-9f8d-6762c254326f",
                                                "text": "Ce lui était plaisir que de ne point manquer la sortie de l’étable fumante, dans la prime fraîcheur du matin."
                                            },
                                            {
                                                "example_id": "cf7f8931-34b9-42e8-8f5c-17e2305baedf",
                                                "sense_id": "e3630b56-4fdf-3941-9f8d-6762c254326f",
                                                "text": "Les rives de la Seine le voient, dès la prime aube, indien maussade, pagayant comme Cerf Agile."
                                            },
                                            {
                                                "example_id": "09a360f9-3e83-4989-bb7c-4663bf1c5d9b",
                                                "sense_id": "e3630b56-4fdf-3941-9f8d-6762c254326f",
                                                "text": "Seuls les professionnels ont tout loisir, du prime matin au soir tombant, d'inspecter cinq mille, voire dix mille crins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05d6c8e0-e798-319b-b944-47ae1e1b60fa",
                                        "entry_id": "c5b95711-075d-3db1-81ba-0121c69f16bc",
                                        "glosses": [
                                            "Qui s'emporte facilement."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea8cede3-1360-457b-8377-76a59804a797",
                                                "sense_id": "05d6c8e0-e798-319b-b944-47ae1e1b60fa",
                                                "text": "Il est ben primé, à matin ! On n’est pas capable de lui parler sans qu’il se fâche !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7548d2a8-cb3c-3ab1-85a8-092b95f93b35",
                                        "entry_id": "c5b95711-075d-3db1-81ba-0121c69f16bc",
                                        "glosses": [
                                            "Vif et aiguisé, en parlant d'un regard."
                                        ],
                                        "tags": [
                                            "Acadie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83ef932e-6965-4646-adcc-a9e01bbb997e",
                                                "sense_id": "7548d2a8-cb3c-3ab1-85a8-092b95f93b35",
                                                "text": "Puis elle apparut. Une femme sans âge. Le visage un peu ridé, mais la colonne droite et l’œil prime. Entendez prime dans son sens le plus ancien, vif et aiguisé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prime",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6622391-ffdf-352f-930e-5a395364bc06",
                                        "entry_id": "775d4676-c671-3b63-9ada-04f839057ef8",
                                        "glosses": [
                                            "Première heure canoniale, à 6 heures du matin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cc86ec3-5d11-4333-aa4c-44c1bf9a1378",
                                                "sense_id": "c6622391-ffdf-352f-930e-5a395364bc06",
                                                "text": "Je remplis mes devoirs de chapelain loyalement et sincèrement : deux messes par jour, une le matin, l’autre le soir, primes, complies, vêpres avec Credo et Pater."
                                            },
                                            {
                                                "example_id": "a115e5f9-0ec6-4404-9a50-70a516dc548a",
                                                "sense_id": "c6622391-ffdf-352f-930e-5a395364bc06",
                                                "text": "Les charrettes et les chars étaient là dès potron-minet, voire dès la veille, car le marché était clappé dès prime ; il durait jusqu'à midi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5ee865e-7339-31b2-ae17-5c7aed2c8dc2",
                                        "entry_id": "775d4676-c671-3b63-9ada-04f839057ef8",
                                        "glosses": [
                                            "Première position de l’épée en escrime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed5e8fbb-3673-4a16-8f53-d6e8652d39bd",
                                                "sense_id": "a5ee865e-7339-31b2-ae17-5c7aed2c8dc2",
                                                "text": "Placez vous en garde de prime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f246c806-e7d6-3640-8e9f-9d43951339bc",
                                        "entry_id": "775d4676-c671-3b63-9ada-04f839057ef8",
                                        "glosses": [
                                            "Ce qui prime."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
