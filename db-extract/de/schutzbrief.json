                "senses": [
                    {
                        "sense_id": "a8fd70c9-4b65-3192-8a8f-29f69ad2b59e",
                        "entry_id": "c5f00d6f-ecd1-3711-91d2-f8e9a9edd919",
                        "glosses": [
                            "Dokument, mit dem die ausstellende Macht dem Inhaber ihren Schutz bestätigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dde124da-56a4-4f46-9fde-338456276fc8",
                                "sense_id": "a8fd70c9-4b65-3192-8a8f-29f69ad2b59e",
                                "text": "„In den ersten Jahren stellte die deutsche Regierung kaiserliche Schutzbriefe für private Unternehmen und bestimmte Gebiete aus.“"
                            },
                            {
                                "example_id": "8a0ee57a-94cb-4d73-8890-e2dcf1f77cc1",
                                "sense_id": "a8fd70c9-4b65-3192-8a8f-29f69ad2b59e",
                                "text": "„Aus diesem Grund war es in dieser Gruppe üblich, sich durch Schutzbriefe und Empfehlungsschreiben zu legitimieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7b1164d2-af04-3507-b555-2a95681a9bba",
                        "entry_id": "c5f00d6f-ecd1-3711-91d2-f8e9a9edd919",
                        "glosses": [
                            "Dokument einer Versicherung, dass sie dem Versicherungsnehmer in bestimmten Notfällen festgelegte Leistungen erbringt"
                        ],
                        "tags": [
                            "Versicherungswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "972c38b5-c0bb-4e58-8afc-773a172147e8",
                                "sense_id": "7b1164d2-af04-3507-b555-2a95681a9bba",
                                "text": "Viele Autobesitzer haben einen Schutzbrief für ihr Fahrzeug."
                            },
                            {
                                "example_id": "9e9b29bb-a7be-425f-ac7b-d1198fea12bc",
                                "sense_id": "7b1164d2-af04-3507-b555-2a95681a9bba",
                                "text": "„[1959] wurde […] der Schutzbrief als internationales Reisedokument geschaffen, […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
