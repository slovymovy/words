                    {
                        "translation_id": "7df8b5ed-b7bc-44f6-88b4-cc383514be65",
                        "source_entry_id": "15b5d98e-f602-3c0c-969d-8e979679710e",
                        "source_sense_id": "343b08b4-de54-32c0-a569-7846ed297974",
                        "source_sense_description": "wind instrument",
                        "target_lang_word": "cornet à bouquin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cornet à bouquin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce8dd380-f3f0-3805-998a-566486732d26",
                                        "entry_id": "8274e39f-f3ab-3e94-adeb-1ab7b4c15ddf",
                                        "glosses": [
                                            "instrument de la famille des cuivres en bois ou en corne ayant la particularité de posséder comme le serpent et l'ophicléide des trous, très populaire durant la Renaissance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4aadad1-80a1-427f-886a-87e364d1f143",
                                                "sense_id": "ce8dd380-f3f0-3805-998a-566486732d26",
                                                "text": "Le médium, surtout lorsque l’exécutant n’est pas très habile, rappelle trop les sons du Serpent de Cathédrale et du Cornet à bouquin ; je crois qu’il faut rarement les laisser à découvert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57f82aba-17df-322c-ac2d-96ad364a70c2",
                                        "entry_id": "8274e39f-f3ab-3e94-adeb-1ab7b4c15ddf",
                                        "glosses": [
                                            "Trompe recourbée, qui est faite ordinairement d’une corne."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcba38c5-817b-4a40-8c50-052b837a3174",
                                                "sense_id": "57f82aba-17df-322c-ac2d-96ad364a70c2",
                                                "text": "Quoi ! messieurs, prendre pour modèle une république de paysans ! voulez-vous mener paître les vaches, devenir fabricans de fromages, et avoir pour musique militaire le son du cornet à bouquin ?"
                                            },
                                            {
                                                "example_id": "516ca8a6-7bf3-4822-82aa-f117034d5468",
                                                "sense_id": "57f82aba-17df-322c-ac2d-96ad364a70c2",
                                                "text": "Aux fanfares des cuivres répondaient les mugissements des cornets à bouquin. C'était à se boucher les oreilles […]."
                                            },
                                            {
                                                "example_id": "321e26db-1b6d-46f2-9729-b110a0e3213b",
                                                "sense_id": "57f82aba-17df-322c-ac2d-96ad364a70c2",
                                                "text": "La jeune Euphémie essaya de parler : il ne sortit de sa gorge que des sons rauques comme l’appel que les pâtres de son village tirent de leur cornet à bouquin, le soir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de9b3004-3c79-4907-bfa6-c9486dfb6e10",
                        "source_entry_id": "15b5d98e-f602-3c0c-969d-8e979679710e",
                        "source_sense_id": "343b08b4-de54-32c0-a569-7846ed297974",
                        "source_sense_description": "wind instrument",
                        "target_lang_word": "Zink",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zink",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f1ba9e0-8aea-3114-869a-5eccf95f0230",
                                        "entry_id": "d80fc479-66fe-36e4-a1f7-27bc571e7268",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 30; bläulich-weißes, leicht formbares Metall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "281b2ef6-0652-4258-b283-2d7ca5c0ab96",
                                                "sense_id": "0f1ba9e0-8aea-3114-869a-5eccf95f0230",
                                                "text": "Zink ist ein wichtiges Spurenelement."
                                            },
                                            {
                                                "example_id": "0c549dcd-ee3d-4368-b280-9bddda4a2c82",
                                                "sense_id": "0f1ba9e0-8aea-3114-869a-5eccf95f0230",
                                                "text": "Die 10, 20 und 50 Eurocent-Münzen bestehen aus einer Legierung aus Kupfer, Aluminium, Zink und Zinn."
                                            },
                                            {
                                                "example_id": "f5a00ba4-74d7-47d3-95f1-32b63aa1f10c",
                                                "sense_id": "0f1ba9e0-8aea-3114-869a-5eccf95f0230",
                                                "text": "„Das Zink schützt aktiv und passiv gegen Korrosion, d. h., es bildet einerseits eine Barriere und schützt andererseits auch freiliegende benachbarte Eisenflächen sowie Schichtfehler vor Korrosion, indem es wie eine Opferanode wirkt.“"
                                            },
                                            {
                                                "example_id": "b76b0aba-ef7c-4a6d-9816-7e183fd4a11e",
                                                "sense_id": "0f1ba9e0-8aea-3114-869a-5eccf95f0230",
                                                "text": "„In die nun leere Hülle gießt er das heiße, flüssige Metall, eine Legierung aus Kupfer und anderen Elementen, vor allem Zinn oder Zink.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Zink",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c825e74-c877-315a-a9df-da6f24fb12a6",
                                        "entry_id": "d8f373b8-5416-3b93-a23d-343bbc35143b",
                                        "glosses": [
                                            "historisches Blasinstrument mit einem konischen Rohr aus Holz oder Elfenbein, Grifflöchern und einem angesetzten oder eingedrehten Trompetenmundstück"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d13d4763-2a9f-4b15-8c26-1c5327446dae",
                                                "sense_id": "6c825e74-c877-315a-a9df-da6f24fb12a6",
                                                "text": "Der Zink war ein Sopraninstrument im mittelalterlichen Bläserchor."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
