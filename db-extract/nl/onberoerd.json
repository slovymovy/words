                                        "glosses": [
                                            "Not impaired."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95e15f2c-4450-443d-bb89-aeae49e74ed8",
                                                "sense_id": "8dda3632-ec65-3f51-9652-1be784cb6e95",
                                                "text": "While the United States remained a non-belligerent speeds continued unimpaired, despite the increasingly dense occupation of main-line tracks, but the entry of the U.S.A. into the war in December, 1941, made its effect felt almost immediately."
                                            }
                                        ]
