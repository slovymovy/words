                        "entry_id": "4f64fda5-e87b-3b1f-aec8-3801d41d3314",
                        "glosses": [
                            "het mechanisme dat er voor zorgt dat warmte afgevoerd wordt, het koelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5f2b8ac-8a5c-4d85-8c93-91ea62092ea0",
                                "sense_id": "c8138b82-da7e-35cd-8b5a-04cefee3aa53",
                                "text": "Doordat de koeling van de kernreactor kwam stil te liggen door de aardbeving en de erop volgende vloedgolf, ontstond er een ernstige bedreiging van de omgeving."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c88457d2-2833-4f9a-9fec-1886b2b4110b",
                        "source_entry_id": "4f64fda5-e87b-3b1f-aec8-3801d41d3314",
                        "source_sense_id": "c8138b82-da7e-35cd-8b5a-04cefee3aa53",
                        "target_lang_word": "Kühlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kühlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71f70191-c195-30a4-a3e5-0719c0916fe4",
                                        "entry_id": "40cb7d11-2715-3a28-8c67-70993d034da7",
                                        "glosses": [
                                            "Verringerung der Temperatur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69bed3c6-e441-4a75-8d34-fee2266b5687",
                                                "sense_id": "71f70191-c195-30a4-a3e5-0719c0916fe4",
                                                "text": "Die Kühlung der Brennstäbe ist unbedingt notwendig."
                                            },
                                            {
                                                "example_id": "2a2cf21b-1e7f-4b7b-9f38-331b9b219a64",
                                                "sense_id": "71f70191-c195-30a4-a3e5-0719c0916fe4",
                                                "text": "„Die heute am weitesten verbreitete, schonendste und effektivste Methode zum Haltbarmachen von Nahrungsmitteln ist […] die Kühlung bzw. Tiefkühlung.“"
                                            },
                                            {
                                                "example_id": "86b824b3-ab51-4bb4-be25-36554077a373",
                                                "sense_id": "71f70191-c195-30a4-a3e5-0719c0916fe4",
                                                "text": "„Das war der Platz, an dem Simen Tjing während der Sommermonate Kühlung zu suchen pflegte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
