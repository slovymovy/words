                "senses": [
                    {
                        "sense_id": "cfc7aca6-773a-34fd-8d27-1504fc1acb1d",
                        "entry_id": "0b43fd7b-d8a1-388a-8769-a5401d7c8d23",
                        "glosses": [
                            "to see each other, to meet; to date"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a460fdd3-84c7-468c-a83a-b84d76c83ac4",
                                "sense_id": "cfc7aca6-773a-34fd-8d27-1504fc1acb1d",
                                "text": "за́втра уви́димся",
                                "translation": "we'll meet tomorrow",
                                "english": "we'll meet tomorrow"
                            },
                            {
                                "example_id": "7edcffae-3960-4516-963c-0802cf884dc7",
                                "sense_id": "cfc7aca6-773a-34fd-8d27-1504fc1acb1d",
                                "text": "Они́ тепе́рь ре́дко ви́дятся.",
                                "translation": "They don't see each other often now.",
                                "english": "They don't see each other often now."
                            }
                        ]
                    },
                    {
                        "sense_id": "627b42a5-12a2-3a6a-b748-9e34059bf43b",
                        "entry_id": "0b43fd7b-d8a1-388a-8769-a5401d7c8d23",
                        "glosses": [
                            "to see, to seem"
                        ],
                        "tags": [
                            "impersonal"
                        ],
                        "examples": [
                            {
                                "example_id": "00533a62-1d01-45fa-bffa-1ef03c1277d5",
                                "sense_id": "627b42a5-12a2-3a6a-b748-9e34059bf43b",
                                "text": "ему́ ви́дится",
                                "translation": "he sees; he seems to see; he can see",
                                "english": "he sees; he seems to see; he can see"
                            },
                            {
                                "example_id": "86f24090-459e-45f7-8fa2-18bee3d1f787",
                                "sense_id": "627b42a5-12a2-3a6a-b748-9e34059bf43b",
                                "text": "ему́ приви́делся стра́шный сон",
                                "translation": "he had a terrifying dream",
                                "english": "he had a terrifying dream"
                            }
                        ]
                    },
