                        "sense_id": "ce9ed102-b127-39af-84e9-dd6e94c88ce5",
                        "entry_id": "0811bd3a-5abc-38dd-b61a-6fdaebe65cdb",
                        "glosses": [
                            "Qui peut être encouragé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0043006f-f85e-4476-b767-4dc4cbbd37f9",
                                "sense_id": "ce9ed102-b127-39af-84e9-dd6e94c88ce5",
                                "text": "C’est par la conservation du teillage à la main que nous arriverons à l’emploi de 600 personnes dans la création d’un rouissage manufacturier, et à répandre dans la commune au moins 180.000 fr. par le teillage du lin à la main, industrie encourageable aussi par des primes et exercée en famille, chose importante suivant nos vues."
                            },
                            {
                                "example_id": "79bd2db2-be0e-43d6-9595-233c8d3fc89e",
                                "sense_id": "ce9ed102-b127-39af-84e9-dd6e94c88ce5",
                                "text": "L’homme n’est pas perfectible. Il est influençable, intimidable, dissuadable, encourageable, terrorisable, motivable, organisable, crétinisable, dressable, en un mot éducable. Mais on ne l’améliore pas."
                            }
                        ]
                    },
                    {
                        "sense_id": "a60a0aa3-09de-332e-a114-33eaa1068568",
                        "entry_id": "0811bd3a-5abc-38dd-b61a-6fdaebe65cdb",
                        "glosses": [
                            "Qui mérite des encouragements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96be1dd9-4989-4fd0-ba6e-e0e1e119f1fa",
                                "sense_id": "a60a0aa3-09de-332e-a114-33eaa1068568",
                                "text": "L’œuvre de l’Industriel français qui pousse à l’association des petits contre l’implacable et mortelle concurrence des monopoleurs n’en est pas moins fort encourageable."
                            },
                            {
                                "example_id": "f1c42dbd-a126-4b13-8152-86372071954f",
                                "sense_id": "a60a0aa3-09de-332e-a114-33eaa1068568",
                                "text": "C’est donc un pari, certes moralement encourageable, mais qui n’est pas économiquement déraisonnable."
                            }
                        ]
                    }
