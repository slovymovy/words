                                "target_senses": [
                                    {
                                        "sense_id": "0e88459e-c784-3ea1-bd48-fd7dca978b85",
                                        "entry_id": "ec2c4be0-a38e-36dd-9c37-1e709aa45413",
                                        "glosses": [
                                            "eine Brennerei, die Schnäpse herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed1bc278-e5eb-4214-8868-b25804c425ce",
                                                "sense_id": "0e88459e-c784-3ea1-bd48-fd7dca978b85",
                                                "text": "Bei uns gibt es mehrere Schnapsbrennereien im Ort."
                                            },
                                            {
                                                "example_id": "d6956b13-75d4-48b1-9464-27db5b34d874",
                                                "sense_id": "0e88459e-c784-3ea1-bd48-fd7dca978b85",
                                                "text": "„Diese beiden Gebiete zusammenführend, haben sie aus der anfänglichen Schnapsbrennerei heute einen lieblichen Hofladen in Saalfelden gemacht, der mittlerweile bei einer Umsatzgröße von knapp einer Million Euro liegt.“"
                                            },
                                            {
                                                "example_id": "72d38183-8264-4454-8a27-5916df8b2803",
                                                "sense_id": "0e88459e-c784-3ea1-bd48-fd7dca978b85",
                                                "text": "„Alle Gebäude, vom Wagenschuppen angefangen bis zur Schnapsbrennerei, seien ausbesserungsbedürftig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
