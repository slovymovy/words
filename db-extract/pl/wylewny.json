                        "cross_references": [
                            {
                                "target_word": "mitteilsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c477d38-c1e9-3557-ad78-1d913cf671f0",
                                        "entry_id": "65bbd73c-b761-3734-8e2c-7b73cf3fd35d",
                                        "glosses": [
                                            "so, dass man leicht mit anderen über seine Gedanken und Gefühle spricht oder Auskunft gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d418227b-26c6-4a8e-a13e-5c475fe8d028",
                                                "sense_id": "7c477d38-c1e9-3557-ad78-1d913cf671f0",
                                                "text": "Die Nachbarin erwies sich als sehr mitteilsam, so dass ich nach zehn Minuten schon wusste, wann sie ihren Mann kennengelernt hat und dass sie fünf Kinder und drei Katzen hat."
                                            },
                                            {
                                                "example_id": "f12f5a49-ec8d-42a0-8102-2fbd13f59f55",
                                                "sense_id": "7c477d38-c1e9-3557-ad78-1d913cf671f0",
                                                "text": "„Dänemarks sonst mitteilsamer Hedtoft machte sich schon vor der Konferenz bei den Journalisten mit der Mitteilung unbeliebt, daß sie keinerlei Informationen über Verlauf und Ergebnis der Tagung erhalten würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9bc53c6-993e-4ef5-90df-d0729eaa57e4",
                        "source_entry_id": "8f7229c0-f699-347d-86bc-0a08799f69e5",
                        "source_sense_id": "b685480f-1201-313e-9c5e-1f7c0d64a35f",
                        "target_lang_word": "effusive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effusive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c50d442-8f82-3139-9609-ffd6eb078b52",
                                        "entry_id": "b0b6fc96-94da-3a75-ad56-9c0e71a10116",
                                        "glosses": [
                                            "Gushy; unrestrained, extravagant or excessive (in emotional expression)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28515658-55ef-498d-b7ef-88f6ee5c2594",
                                                "sense_id": "0c50d442-8f82-3139-9609-ffd6eb078b52",
                                                "text": "effusive praise"
                                            },
                                            {
                                                "example_id": "1b628d51-b8f5-4ebc-a293-5fa42f4e7fb9",
                                                "sense_id": "0c50d442-8f82-3139-9609-ffd6eb078b52",
                                                "text": "All week I’ve found myself doing everything I can to distance myself in the crew’s eyes from the bovine herd I’m part of, to somehow unimplicate myself: I eschew cameras and sunglasses and pastel Caribbeanwear; I make a big deal of carrying my own cafeteria tray and am effusive in my thanks for the slightest service."
                                            },
                                            {
                                                "example_id": "6cfc033b-2fb0-4aea-bcea-99a8e4d5b777",
                                                "sense_id": "0c50d442-8f82-3139-9609-ffd6eb078b52",
                                                "text": "While he is reasonably effusive about inter-city travel, he is heavily disparaging of all types of stopping service, including those on otherwise busy main lines. His analysis is not entirely unsound, and he tackles some of the questions head on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d78f48db-0670-3853-9b60-34a7250ed331",
                                        "entry_id": "b0b6fc96-94da-3a75-ad56-9c0e71a10116",
                                        "glosses": [
                                            "Pouring, spilling out freely; overflowing."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c521fb1-5e92-41fe-9e14-2293a73b5e91",
                                                "sense_id": "d78f48db-0670-3853-9b60-34a7250ed331",
                                                "text": "wash'd with the effusive wave"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dfbfa77-737a-3814-86c9-e3e798035a7c",
                                        "entry_id": "b0b6fc96-94da-3a75-ad56-9c0e71a10116",
                                        "glosses": [
                                            "Extrusive; having solidified after being poured out as molten lava."
                                        ],
                                        "tags": [
                                            "of igneous rock"
                                        ],
                                        "examples": []
