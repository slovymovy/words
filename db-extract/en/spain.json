                                "target_senses": [
                                    {
                                        "sense_id": "5c2a3425-6573-3939-8661-f71113df42d6",
                                        "entry_id": "b16bc7ff-d1dd-3441-90db-fbcc0177d5f1",
                                        "glosses": [
                                            "Staat in Südwesteuropa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a34b29ec-9800-4dac-b3e5-8d933d8d31f4",
                                                "sense_id": "5c2a3425-6573-3939-8661-f71113df42d6",
                                                "text": "„Spaniens Himmel breitet seine Sterne // über unsre Schützengräben aus. // Und der Morgen grüßt schon aus der Ferne, // bald geht es zu neuem Kampf hinaus.“"
                                            },
                                            {
                                                "example_id": "bfbe7617-4e69-4686-94a2-bcc5a14c03af",
                                                "sense_id": "5c2a3425-6573-3939-8661-f71113df42d6",
                                                "text": "„Zwar hat die Internationalisierung der Lebensstile auch Spanien voll erfaßt, doch die ungebrochene Existenz des baskischen, katalanischen oder galizischen Nationalismus, die sich auf zum Teil antike, in jedem Falle aber auf mittelalterliche Ursprünge zurückführen lassen, belegen die Persistenz lokaler und regionaler Identitäten …“"
                                            },
                                            {
                                                "example_id": "37f452f0-3b60-45c8-9878-ebbccf8a0463",
                                                "sense_id": "5c2a3425-6573-3939-8661-f71113df42d6",
                                                "text": "„Unter den deutschen Geldhäusern ist nach der Hypo Real Estate (HRE) die DZ Bank am stärksten in Staatsanleihen der schuldengeplagten Länder Portugal, Irland, Griechenland und Spanien (PIGS) engagiert.“"
                                            },
                                            {
                                                "example_id": "055d9ffd-a38b-4951-875f-280cde7cbbe5",
                                                "sense_id": "5c2a3425-6573-3939-8661-f71113df42d6",
                                                "text": "„Um Spanien zum blühendsten aller Königreiche der Erde zu machen, müßte man es erobern, es in seinen Grundfesten erschüttern und fast zerstören; dann würde es nach seiner Wiedergeburt ein Land für glückliche Menschen werden.“"
                                            },
                                            {
                                                "example_id": "42054a32-612f-4218-b4df-d60d0dcd0f44",
                                                "sense_id": "5c2a3425-6573-3939-8661-f71113df42d6",
                                                "text": "„Danach konnte sie sich einfach nicht mehr auf ihren Essay über Spanien konzentrieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
