                        "glosses": [
                            "Action de brunir ou Résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79e369d7-9cad-45bb-ab0a-931fd6700f00",
                                "sense_id": "c7b86349-1c4c-3b37-b5a5-411a8796615d",
                                "text": "Le brunissage de la vaisselle, des ouvrages d’or et d’argent, de l’or appliqué sur la porcelaine."
                            },
                            {
                                "example_id": "51f5280e-db37-45d7-ac73-d8714a507621",
                                "sense_id": "c7b86349-1c4c-3b37-b5a5-411a8796615d",
                                "text": "Le décor extérieur le plus courant est le brunissage, c’est-à-dire le polissage de la surface brute pour en boucher les pores et lui donner une finition lustrée."
                            }
                        ]
                    }
