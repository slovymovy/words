                        "entry_id": "a72fbeeb-9d69-36e7-91f7-766cf3371dc4",
                        "glosses": [
                            "od kaczka"
                        ],
                        "tags": [
                            "augmentative"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3dfa0413-5bb5-39e9-a58e-b8707b334dc6",
                        "entry_id": "a72fbeeb-9d69-36e7-91f7-766cf3371dc4",
                        "glosses": [
                            "o kaczce"
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "828736e3-379c-4db9-affa-22f19294c5e2",
                                "sense_id": "3dfa0413-5bb5-39e9-a58e-b8707b334dc6",
                                "text": "Środkiem drogi dreptała kaczucha z młodymi."
                            },
                            {
                                "example_id": "89300bca-e046-4468-a2a8-155f36c15c0d",
                                "sense_id": "3dfa0413-5bb5-39e9-a58e-b8707b334dc6",
                                "text": "Mało kto pogardzi kaczuchą pieczoną z jabłkami."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "1a068cc5-de9c-3574-b020-920e61b99ff3",
                        "entry_id": "a72fbeeb-9d69-36e7-91f7-766cf3371dc4",
                        "glosses": [
                            "nieduża lokomotywa manewrowa"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8b30fc46-dfa9-4ea7-be72-57308f42c3ec",
                                "sense_id": "1a068cc5-de9c-3574-b020-920e61b99ff3",
                                "text": "Po torze przetoczyła się ociężale kaczucha, popychając dwa wagony."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "ed988e80-f14c-3ee1-9217-1839b64185d0",
                        "entry_id": "a72fbeeb-9d69-36e7-91f7-766cf3371dc4",
                        "glosses": [
                            "citroën 2CV"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "532d05d5-9660-40fa-8c48-b5c43a05e06a",
                                "sense_id": "ed988e80-f14c-3ee1-9217-1839b64185d0",
                                "text": "Popularne kaczuchy produkowano w wersji dla żandarmerii."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "fc638380-8970-3779-8fb8-97394b70bb8d",
                        "entry_id": "a72fbeeb-9d69-36e7-91f7-766cf3371dc4",
                        "glosses": [
                            "dostawczak marki Mercedes"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "aa3ada48-f0a2-4dd5-b9be-05f839f8813c",
                                "sense_id": "fc638380-8970-3779-8fb8-97394b70bb8d",
                                "text": "Mercedesy te nazywano kaczuchami ze względu na wygląd maski."
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "2a4bd793-38b2-3014-80fb-7ff358f350f2",
                        "entry_id": "a72fbeeb-9d69-36e7-91f7-766cf3371dc4",
                        "glosses": [
                            "w żargonie wspinaczkowym: naprężone mięśnie przedramienia"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "ccb7f1da-ede3-4a2b-8710-35d55f9f0560",
                                "sense_id": "2a4bd793-38b2-3014-80fb-7ff358f350f2",
                                "text": "Przysłowiowe kaczuchy instruktora nie robiły na małolatach żadnego wrażenia."
                            }
                        ],
                        "sense_index_json": "\"1.6\""
                    },
                    {
                        "sense_id": "30463cba-6f3d-3fe0-92ac-3842307040bb",
                        "entry_id": "a72fbeeb-9d69-36e7-91f7-766cf3371dc4",
                        "glosses": [
                            "w żargonie narkomanów: butelka do palenia marihuany"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "e000ea66-d931-4d80-a82d-352160308111",
                                "sense_id": "30463cba-6f3d-3fe0-92ac-3842307040bb",
                                "text": "Ćmiła z kaczuchy, aż jej uszami dym leciał."
                            }
                        ],
                        "sense_index_json": "\"1.7\""
                    },
                    {
                        "sense_id": "7031b7a8-f7f4-3dec-ba33-f9112ccd8751",
                        "entry_id": "a72fbeeb-9d69-36e7-91f7-766cf3371dc4",
                        "glosses": [
                            "tylko w lm kaczuchy → taniec wykonywany do popularnej szwajcarskiej piosenki ludowej"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6da2297a-0016-4762-b032-856efc7f7be8",
                                "sense_id": "7031b7a8-f7f4-3dec-ba33-f9112ccd8751",
                                "text": "Popularne „kaczuchy” zatańczone przez Johna Travoltę w San Remo, wywołały falę komentarzy we Włoszech"
                            },
                            {
                                "example_id": "34415380-805b-4299-bf66-16884ef27cae",
                                "sense_id": "7031b7a8-f7f4-3dec-ba33-f9112ccd8751",
                                "text": "Dzieci i rodzice mieli do wykonania zadania związane z podróżami do różnych krajów np. musiały zrobić pizzę, zaprojektować strój do tańca, zatańczyć kaczuchy"
                            }
                        ],
                        "sense_index_json": "\"1.8\""
                    }
