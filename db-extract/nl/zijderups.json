                        "sense_id": "6bed7c13-da72-386c-8189-d190dae8f490",
                        "entry_id": "6a07625c-607e-3d56-a36b-01dbf5af5b9b",
                        "glosses": [
                            "Bombyx mori de larve van de zijdevlinder"
                        ],
                        "tags": [
                            "vlinders"
                        ],
                        "examples": [
                            {
                                "example_id": "c8be029a-ebb6-40e0-807e-f42698d3953a",
                                "sense_id": "6bed7c13-da72-386c-8189-d190dae8f490",
                                "text": "de onderzoekers zijn er voor het eerst in geslaagd om een zijderups zover te krijgen dat hij spinnenzijde maakt. Hierbij hebben ze vezels geproduceerd die maar liefst zes keer sterker zijn dan het materiaal kevlar dat wordt gebruikt in kogelwerende vesten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b62c2a9-4120-451d-abc7-2775195d8c67",
                        "source_entry_id": "6a07625c-607e-3d56-a36b-01dbf5af5b9b",
                        "source_sense_id": "6bed7c13-da72-386c-8189-d190dae8f490",
                        "source_sense_description": "de larve van de zijdevlinder",
                        "target_lang_word": "Seidenraupe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seidenraupe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f7a4c7e-cb39-348d-b38a-54d5759d12cb",
                                        "entry_id": "db950689-6f9a-3519-ab99-1d507bca8c21",
                                        "glosses": [
                                            "Raupe des Seidenspinners (eine Schmetterlingsart), aus dessen Kokon Seide gewonnen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2db73c7-4423-4a0f-b2c7-8d6563e03c86",
                                                "sense_id": "4f7a4c7e-cb39-348d-b38a-54d5759d12cb",
                                                "text": "„Zehn Jahre lebte sie eine bukolische Idylle, fischte, züchtete Seidenraupen und Geflügel.“"
                                            },
                                            {
                                                "example_id": "52f52181-a49c-4c6b-a1cc-c66e66bd522a",
                                                "sense_id": "4f7a4c7e-cb39-348d-b38a-54d5759d12cb",
                                                "text": "„Mit einem Klick ist das neue Putztuch aufgespannt. Und das besteht inzwischen ausschließlich aus Mikrofaser. Weil sie nur halb so dick ist wie der Faden einer Seidenraupe, verhaken sich selbst kleinste Dreckpartikel darin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5f7b483-dd0b-43fd-bc09-82f4b952da14",
                        "source_entry_id": "6a07625c-607e-3d56-a36b-01dbf5af5b9b",
                        "source_sense_id": "6bed7c13-da72-386c-8189-d190dae8f490",
