                        "glosses": [
                            "A member of the family Dasyuridae, comprising carnivorous marsupials."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4472a20d-2857-4087-8501-dadc47a601d9",
                                "sense_id": "ba9a13f2-d3cc-3512-a8b2-f668533f551f",
                                "text": "The Tasmanian Devil and the several species of quolls are by far the largest of the dasyurids, but the group is very diverse, and includes about 30 species of small insect-eaters, some not a lot bigger than a mouse."
                            },
                            {
                                "example_id": "38f0b08a-7d95-4f45-96b2-9790f4ab50df",
                                "sense_id": "ba9a13f2-d3cc-3512-a8b2-f668533f551f",
                                "text": "It was once assumed that dasyurids made little use of visual communications because they are nocturnal."
                            }
                        ]
                    }
