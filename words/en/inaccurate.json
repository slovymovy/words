                    "sense_id": "7ea65ca5-a98a-3b72-a066-49deb757eb81",
                    "sense_definition": "Not correct or exact; containing mistakes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The map was old and <w>inaccurate</w>, so we had trouble finding the location.",
                            "target_lang_translations": {
                                "ru": "Карта была старой и <w>неточной</w>, поэтому нам было трудно найти местоположение.",
                                "nl": "De kaart was oud en <w>onnauwkeurig</w>, waardoor we moeite hadden de locatie te vinden."
                            }
                        },
                        {
                            "text": "It would be <w>inaccurate</w> to say that the project is completely finished.",
                            "target_lang_translations": {
                                "ru": "Было бы <w>неверно</w> утверждать, что проект полностью завершен.",
                                "nl": "Het zou <w>onjuist</w> zijn om te zeggen dat het project helemaal klaar is."
                            }
                        },
                        {
                            "text": "The article was criticized for being factually <w>inaccurate</w> regarding the dates.",
                            "target_lang_translations": {
                                "ru": "Статью критиковали за то, что она была фактически <w>неточной</w> в отношении дат.",
                                "nl": "Het artikel kreeg kritiek omdat het feitelijk <w>onjuist</w> was wat betreft de data."
                            }
                        }
                    ],
                    "synonyms": [
                        "incorrect",
                        "wrong"
                    ],
                    "antonyms": [
                        "accurate"
                    ],
                    "common_phrases": [
                        "factually inaccurate",
                        "historically inaccurate",
                        "inaccurate information",
                        "wildly inaccurate"
                    ],
                    "target_lang_definitions": {
