                                "example_id": "a858c3d4-dada-4f5f-8f70-b39f9004a0d7",
                                "sense_id": "ed873b04-9446-3e19-9a79-a589fb9e9494",
                                "text": "The rumor has two endings... that he yelled so loudly that the light above the table in the room shook or that he was carried out on a stretcher. 'Aaargh! I just Belvedered myself!'"
