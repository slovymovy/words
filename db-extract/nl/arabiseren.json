                "senses": [
                    {
                        "sense_id": "1f3ac22e-6312-3d75-92ec-12a9dfd4bd71",
                        "entry_id": "2423eb1f-13b9-3862-aae5-f604ad74c8b8",
                        "glosses": [
                            "Arabisch maken"
                        ],
                        "tags": [],
