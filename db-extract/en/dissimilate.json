                        ]
                    },
                    {
                        "translation_id": "e644978e-3710-4f6b-8056-1e8a826aca85",
                        "source_entry_id": "6c955d1a-6136-397f-9c30-c7f1e801b1f5",
                        "source_sense_description": "make dissimilar",
                        "target_lang_word": "distinguer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distinguer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8863f375-9aa1-34a7-b660-9a458d2a5076",
                                        "entry_id": "d449052d-a560-39e3-bb9c-6015383c0703",
                                        "glosses": [
                                            "Discerner par l’un des sens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb2c1bc8-5b67-40f5-8714-86c38056101b",
                                                "sense_id": "8863f375-9aa1-34a7-b660-9a458d2a5076",
                                                "text": "Et en même temps une portière de velours violet fleurdelisé d’or se soulevant, le duc distingua dans l’ombre la reine elle-même, […]."
                                            },
                                            {
                                                "example_id": "58ad27b3-c470-45a7-8282-27ad68215b1d",
                                                "sense_id": "8863f375-9aa1-34a7-b660-9a458d2a5076",
                                                "text": "Le jeûne commence au f’jer, à l'heure où l'on parvient à distinguer un fil blanc d'un fil noir."
                                            },
                                            {
                                                "example_id": "a3b345ea-71d9-42e5-a68b-2a4b33b0f021",
                                                "sense_id": "8863f375-9aa1-34a7-b660-9a458d2a5076",
                                                "text": "Cependant, tout de gris habillé pour être moins aisément distingué des choses, Kinkin longeait les murs et les haies, […]."
                                            },
                                            {
                                                "example_id": "31eca64d-cb99-4b0f-af55-89891a9c9e7d",
                                                "sense_id": "8863f375-9aa1-34a7-b660-9a458d2a5076",
                                                "text": "Des hauteurs de Bon-Secours on distingue, dans la brume, la glorieuse cathédrale comme un dreadnought à l’ancre, comme une caravelle fantastique dominant une flotte enfumée."
                                            },
                                            {
                                                "example_id": "ef43c797-0ad4-449f-b779-674bd3650556",
                                                "sense_id": "8863f375-9aa1-34a7-b660-9a458d2a5076",
                                                "text": "À travers les vitres des brasseries et des cafés, on distinguait confusément, un peu partout, la foule des consommateurs gesticulant parmi la fumée des cigarettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11fc0360-86b3-3f4a-88d9-ea7792e66a3d",
                                        "entry_id": "d449052d-a560-39e3-bb9c-6015383c0703",
                                        "glosses": [
                                            "Discerner par l’opération de l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76f891c7-5c05-4289-bedb-72a22b8a223c",
                                                "sense_id": "11fc0360-86b3-3f4a-88d9-ea7792e66a3d",
                                                "text": "Les mimosées diffèrent de papilionacées par leurs fleurs régulières, par le nombre et l'insertion de leurs étamines. Elles se distinguent des schwartziées par leurs feuilles bipennées et l'embryon droit."
                                            },
                                            {
                                                "example_id": "4dd67571-db39-46af-aac7-bb1d35cbc490",
                                                "sense_id": "11fc0360-86b3-3f4a-88d9-ea7792e66a3d",
                                                "text": "Ce sont des harrâba, des soldats dressés à Gibraltar pour servir d’instructeurs à leurs camarades; mais ils se sont empressés d'oublier ce qu'ils avaient appris et ne se distinguent guère des autres troupiers marocains."
                                            },
                                            {
                                                "example_id": "031ff2e1-e0ed-4a2e-96d7-6107d7738d2a",
                                                "sense_id": "11fc0360-86b3-3f4a-88d9-ea7792e66a3d",
                                                "text": "Reste un « savoir-faire » mondain d’adaptation, d’aménagement et de promotion pour le public français ; il est peut-être utile ici de distinguer le « doxosophe » (qui travaille entièrement au sein de la doxa) de l’idéologue (qui fait évoluer une doctrine politique de manière originale)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9a52610-2df3-31be-a577-fcb808409e70",
                                        "entry_id": "d449052d-a560-39e3-bb9c-6015383c0703",
                                        "glosses": [
                                            "Séparer nettement une chose d’une autre selon ce qu’elle a de propre ou de spécial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94722e88-32d9-4244-975c-2a6b0260c687",
                                                "sense_id": "a9a52610-2df3-31be-a577-fcb808409e70",
                                                "text": "Si l’essence humaine est la même chez Socrate et chez Platon, d’où vient ce qui les distingue en les singularisant ?"
                                            },
                                            {
                                                "example_id": "e003e441-ea38-4abb-b4b8-faaa677858d7",
                                                "sense_id": "a9a52610-2df3-31be-a577-fcb808409e70",
                                                "text": "Et s’il y a un judaïsme de rite aschkenazi, avec son caractère propre, qui le distingue nettement du judaïsme sefardi, ce n’est pas d’Allemagne qu’il est originaire, mais bien de France."
                                            },
                                            {
                                                "example_id": "e2aa2e17-ae69-4516-aaba-2eaa8ceb5808",
                                                "sense_id": "a9a52610-2df3-31be-a577-fcb808409e70",
                                                "text": "Ainsi dans les premiers temps du reboisement, beaucoup de reboiseurs ne connaissaient pas la notion d’étage de végétation, ne distinguaient pas la valeur forestière des différents sols. Ils ont eu bien des déboires […]."
                                            },
                                            {
                                                "example_id": "1acb5098-3349-48e9-a545-d951fcb04ae3",
                                                "sense_id": "a9a52610-2df3-31be-a577-fcb808409e70",
                                                "text": "Dans le Nord-Ouest amazonien, par exemple, environ un siècle après l’abattis, il devient à peu près impossible à un botaniste professionnel de distinguer la végétation secondaire de la forêt primaire environnante (Sastre 1975)."
                                            },
                                            {
                                                "example_id": "6d3ec26a-5893-4688-b523-10b093cf9b46",
                                                "sense_id": "a9a52610-2df3-31be-a577-fcb808409e70",
                                                "text": "S'il est un domaine dans lequel la Cinquième a tenu à se distinguer, à nous distinguer du « reste du monde », c'est bien celui de l'action culturelle. La culture comme exception par la place qu'elle tient dans les préoccupations de la République, mais aussi et surtout comme arme de « résistance »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36a97686-dfe4-34e3-9597-886f5882108f",
                                        "entry_id": "d449052d-a560-39e3-bb9c-6015383c0703",
                                        "glosses": [
                                            "Marquer les divers sens qu’une proposition peut avoir."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e451e82-8e40-43d4-bbea-2dff8e0e6d2f",
                                                "sense_id": "36a97686-dfe4-34e3-9597-886f5882108f",
                                                "text": "Je vous accorde le principe; mais, avant de tirer les conséquences, distinguons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0b17c7d-3a24-3653-b25c-28db7e14209b",
                                        "entry_id": "d449052d-a560-39e3-bb9c-6015383c0703",
                                        "glosses": [
                                            "Rendre nettement manifeste ou discernable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be93d1bd-d721-4adb-bd86-ee82b9808542",
                                                "sense_id": "c0b17c7d-3a24-3653-b25c-28db7e14209b",
                                                "text": "Quant au constance rouge et blanc, il a tant de rapport avec les vins de Malvoisie et même avec ceux de la bonne ville de Cette, que je ne sais, en vérité, si on pourrait toujours le distinguer de ces derniers."
                                            },
                                            {
                                                "example_id": "d03f5033-6e86-4639-89ea-ce3345a4c46a",
                                                "sense_id": "c0b17c7d-3a24-3653-b25c-28db7e14209b",
                                                "text": "Lynette se distingue physiquement du reste du groupe : son physique et sa tenue vestimentaire contrastent avec l'apparence des autres femmes dont les coiffures impeccables et les twin-sets de couleur pastel s'imposent comme les codes de la norme des mères au foyer."
                                            },
                                            {
                                                "example_id": "46c48b39-c5fc-45f5-b023-42df56f6c7af",
                                                "sense_id": "c0b17c7d-3a24-3653-b25c-28db7e14209b",
                                                "text": "Distinguer les conditions."
                                            },
                                            {
                                                "example_id": "9a9c98b8-b7b8-4900-9d15-1ceb28c074be",
                                                "sense_id": "c0b17c7d-3a24-3653-b25c-28db7e14209b",
                                                "text": "La nature a distingué les différents êtres par des caractères particuliers."
                                            },
                                            {
                                                "example_id": "d5251d70-762b-499d-ad92-b7718d6195ed",
                                                "sense_id": "c0b17c7d-3a24-3653-b25c-28db7e14209b",
                                                "text": "Distinguer les objets par des noms différents."
                                            },
                                            {
                                                "example_id": "9a73d10c-59bb-4702-ad25-83ffb9c119e3",
                                                "sense_id": "c0b17c7d-3a24-3653-b25c-28db7e14209b",
                                                "text": "Les qualités qui distinguent une chose d’une autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bac81ae8-757a-3aee-8382-1db814b2eb28",
                                        "entry_id": "d449052d-a560-39e3-bb9c-6015383c0703",
                                        "glosses": [
                                            "Élever au-dessus des autres, tirer du commun, rendre remarquable."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62664074-8003-47aa-9169-5303c513dc0a",
                                                "sense_id": "bac81ae8-757a-3aee-8382-1db814b2eb28",
                                                "text": "Les talents qui vous distinguent."
                                            },
                                            {
                                                "example_id": "a8d81cd9-bc9e-4841-a51e-9a8d7232916c",
                                                "sense_id": "bac81ae8-757a-3aee-8382-1db814b2eb28",
                                                "text": "Voilà ce qui distingue ce grand siècle."
                                            },
                                            {
                                                "example_id": "21a73439-bb3f-4524-9c14-74c4c84b301d",
                                                "sense_id": "bac81ae8-757a-3aee-8382-1db814b2eb28",
                                                "text": "Cet écrivain se distingue surtout par la clarté."
                                            },
                                            {
                                                "example_id": "2d6cd4dc-6d71-4788-9770-3b1db20340fa",
                                                "sense_id": "bac81ae8-757a-3aee-8382-1db814b2eb28",
                                                "text": "Son style se distingue par l’élégance."
                                            },
                                            {
                                                "example_id": "5c3fa1ed-51cb-4949-b38a-726c3251b824",
                                                "sense_id": "bac81ae8-757a-3aee-8382-1db814b2eb28",
                                                "text": "Chercher à se distinguer."
                                            },
                                            {
                                                "example_id": "e3b30ed8-26a7-4b4d-a251-6e774a88a816",
                                                "sense_id": "bac81ae8-757a-3aee-8382-1db814b2eb28",
                                                "text": "Se distinguer entre tous ses rivaux."
                                            },
                                            {
                                                "example_id": "6809bf3e-10a2-46e2-ac29-059017557f04",
                                                "sense_id": "bac81ae8-757a-3aee-8382-1db814b2eb28",
                                                "text": "Se distinguer dans une profession."
                                            },
                                            {
                                                "example_id": "9dd63968-50a5-4780-9b82-15a9126baf24",
                                                "sense_id": "bac81ae8-757a-3aee-8382-1db814b2eb28",
                                                "text": "Se distinguer par des mœurs pures, par une conduite irréprochable."
                                            },
                                            {
                                                "example_id": "98b38f3e-9eb2-460a-9805-0735bd387864",
                                                "sense_id": "bac81ae8-757a-3aee-8382-1db814b2eb28",
                                                "text": "Il s’est distingué par sa valeur, par son mérite, par son éloquence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77b64b7e-69e5-37fa-8fc0-8a3b49b98f52",
                                        "entry_id": "d449052d-a560-39e3-bb9c-6015383c0703",
                                        "glosses": [
                                            "Remarquer, préférer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56daee1f-b18f-4e2f-a407-7f9cc4e10cc4",
                                                "sense_id": "77b64b7e-69e5-37fa-8fc0-8a3b49b98f52",
                                                "text": "Il sut bientôt se faire distinguer."
                                            },
                                            {
                                                "example_id": "6c6b1adc-9a31-45c5-a8a6-4f43a079f79f",
                                                "sense_id": "77b64b7e-69e5-37fa-8fc0-8a3b49b98f52",
                                                "text": "Dès qu’il parut à la cour, le prince le distingua d’une manière flatteuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba20bb1b-8564-38c8-bdf1-4fe729df14a9",
                                        "entry_id": "d449052d-a560-39e3-bb9c-6015383c0703",
                                        "glosses": [
                                            "Traiter avec égards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77880b79-3689-46a3-b282-379eaf81b51c",
                                                "sense_id": "ba20bb1b-8564-38c8-bdf1-4fe729df14a9",
                                                "text": "Il aime qu’on le distingue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e8af471-b9b4-4696-9d32-5ce4e8b6ed24",
