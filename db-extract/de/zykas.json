                "senses": [
                    {
                        "sense_id": "2597b030-4d46-35a9-a5e2-0f90b6f5d51d",
                        "entry_id": "472719e1-4fe3-3d25-954e-c2f4ed39dc68",
                        "glosses": [
                            "in tropischen und subtropischen Gebieten vorkommende Pflanze, die an Palmen erinnert und große Zapfen trägt"
                        ],
                        "tags": [],
