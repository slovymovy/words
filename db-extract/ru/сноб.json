                                "target_senses": [
                                    {
                                        "sense_id": "1bc636ae-4a3f-3786-9956-e824875307ce",
                                        "entry_id": "2cd699c9-bc7a-3653-92be-9aaa92e6ece2",
                                        "glosses": [
                                            "osoba, która próbuje zachowywać się tak, jak ktoś z wyższej klasy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d1240f1-ef56-4acb-a8f0-97dcc091d73d",
                                                "sense_id": "1bc636ae-4a3f-3786-9956-e824875307ce",
                                                "text": "Nie bądź takim snobem!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
