                "senses": [
                    {
                        "sense_id": "a80cb510-3bcb-31f0-82d2-2c4a3b8be7d2",
                        "entry_id": "0633d195-7443-3e37-92ed-81818574b13a",
                        "glosses": [
                            "Fortin militaire construit en Afrique du nord et en Amérique par les espagnols."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "214006b4-a26c-4cca-b9df-56615e58b39f",
                                "sense_id": "a80cb510-3bcb-31f0-82d2-2c4a3b8be7d2",
                                "text": "En retour de mes enseignements bénévoles, il m’apprend que son régiment tient garnison au presidio de la laguna de Chapala, distant de quinze à seize lieues sud de Guadalajara; que les presidarios venaient de se révolter et de prendre la clef des champs, […]."
                            },
                            {
                                "example_id": "20a604a8-14af-4dd3-92d7-5f4489df1d9c",
                                "sense_id": "a80cb510-3bcb-31f0-82d2-2c4a3b8be7d2",
                                "text": "Longtemps après la découverte du Nouveau-Monde, les Espagnols fondèrent en Patagonie, en 1710, un Presidio situé sur la rive gauche du Rio-Négro, à sept lieues de son embouchure, et nommé Nuestra senora del Carmen ou bien encore Patagones."
                            },
                            {
                                "example_id": "451505ad-bb22-4cb4-b601-253e56f8543a",
                                "sense_id": "a80cb510-3bcb-31f0-82d2-2c4a3b8be7d2",
                                "text": "Casablanca était transformé en un presidio complétement isolé de son arrière-pays, qui était l'unique raison d’être et le seul moyen d’existence de cette ville exclusivement commerçante."
                            },
                            {
                                "example_id": "b6ab0567-4e70-4a4a-b596-99f08ef3bead",
                                "sense_id": "a80cb510-3bcb-31f0-82d2-2c4a3b8be7d2",
                                "text": "Ces petites colonies sont toujours établies dans des cantons fertiles : bientôt elles ont des grains et du bétail, non-seulement pour leur consommation, mais pour l'approvisionnement des missions et des presidios des alentours."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1c62ba5-4589-34b0-97d5-67ee794029d9",
                        "entry_id": "0633d195-7443-3e37-92ed-81818574b13a",
                        "glosses": [
                            "Travaux forcés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17c2d52c-29ea-4b6e-84eb-ed831cbe1e43",
                                "sense_id": "e1c62ba5-4589-34b0-97d5-67ee794029d9",
                                "text": "Les condamnés au presidio (travaux forcés) balayent la ville et enlèvent les immondices sans quitter les haillons qui les emmaillottent."
                            }
                        ]
                    }
