                        {
                            "text": "Hij rolde een sigaret met een <w>vloei</w> en wat tabak.",
                            "target_lang_translations": {
                                "en": "He rolled a cigarette with a <w>rolling paper</w> and some tobacco."
                            }
                        },
                        {
                            "text": "In de kiosk kocht ze een pakje <w>vloei</w> voor vanavond.",
                            "target_lang_translations": {
                                "en": "At the kiosk, she bought a pack of <w>rolling papers</w> for tonight."
                            }
