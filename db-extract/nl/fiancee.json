                        "examples": [
                            {
                                "example_id": "3b0b4b75-064b-40ec-ac01-b296dab99033",
                                "sense_id": "0b12ec41-6e78-3a88-9229-de458a220be0",
                                "text": "Sinds een week hebben Sylvia en ik een clandestiene intieme relatie. Eindelijk. Ik heb altijd al the hots voor haar gehad. Sylvia is al jaren de beste vriendin van mijn gelegenheidsscharrel Bianca. Sylvia is ook nog steeds de fiancee van Frits."
                            }
