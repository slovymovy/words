                                        "examples": [
                                            {
                                                "example_id": "75dc6a5f-b828-4ed1-8e4b-e590a63b6a86",
                                                "sense_id": "e4a10311-01f6-38ce-8786-f74f8cf9b711",
                                                "text": "Time went back to normal for him; he safetied his own weapon and dropped it, jumping forward."
                                            },
                                            {
                                                "example_id": "022b9653-fd74-4f47-a34f-369c09660fe0",
                                                "sense_id": "e4a10311-01f6-38ce-8786-f74f8cf9b711",
                                                "text": "Osborne lay propped up on one elbow, his pistol cocked, his aim wavering in the general direction the man had gone. Finally he safetied it, stuffed it in the holster on his right hip, and reached for his cell phone in his jacket pocket. But it was gone."
