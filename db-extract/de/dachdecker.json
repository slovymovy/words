                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef43e89f-64db-3cc6-8898-1cd933f94ed6",
                        "entry_id": "e9937725-1829-3e19-ab53-2f3147075b46",
                        "glosses": [
                            "Handwerker, der ein Dach errichtet, die Eindeckung, Abdichtung und Dämmung eines Daches ausführt und Dachfenster und Solarzellen anbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6437a1e0-665b-44a7-91cd-f08b0d838668",
                                "sense_id": "ef43e89f-64db-3cc6-8898-1cd933f94ed6",
                                "text": "Die Dachdecker schafften es, das halbe Dach an einem Tag neu einzudecken."
                            },
                            {
                                "example_id": "74388228-80ac-4e6c-ba2c-56c6b23b917d",
                                "sense_id": "ef43e89f-64db-3cc6-8898-1cd933f94ed6",
                                "text": "„Ludwig Bertini schien seine Aufgabe als Maurer, Maler, Installateur und Dachdecker sehr ernst zu nehmen.“"
                            },
                            {
                                "example_id": "1ac31e26-bf41-488a-9c4b-223a6032e6b2",
                                "sense_id": "ef43e89f-64db-3cc6-8898-1cd933f94ed6",
                                "text": "„Ein Clown, der ans Saufen kommt, steigt rascher ab, als ein betrunkener Dachdecker stürzt.“"
                            },
                            {
                                "example_id": "805df5ea-a61b-4d45-951c-36ca0f23a12b",
                                "sense_id": "ef43e89f-64db-3cc6-8898-1cd933f94ed6",
                                "text": "„Über eine Stunde stehen Dieter und Klaus und schauen dem Dachdecker bei der Arbeit zu.“"
                            },
                            {
                                "example_id": "5c870d40-3b98-4d8e-91e4-bebbd40c2633",
                                "sense_id": "ef43e89f-64db-3cc6-8898-1cd933f94ed6",
                                "text": "„Der Dachdecker hatte ihn für fünfzehn Francs hergegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df571f03-3375-48ed-81a1-9cf655360dd3",
                        "source_entry_id": "e9937725-1829-3e19-ab53-2f3147075b46",
                        "source_sense_id": "ef43e89f-64db-3cc6-8898-1cd933f94ed6",
                        "source_sense_description": "Handwerker, der Dächer deckt",
                        "target_lang_word": "roofer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roofer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20a29289-925e-3e21-9015-34bcc6819acc",
                                        "entry_id": "6f72fd6d-934f-3526-beb4-d84502070263",
                                        "glosses": [
                                            "A craftsman who lays, or repairs roofs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "502278e6-14da-3f74-94af-dfd2bba2cca9",
                                        "entry_id": "6f72fd6d-934f-3526-beb4-d84502070263",
                                        "glosses": [
                                            "A daredevil who performs stunts on tops of skyscrapers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa0ddadc-db57-4ddd-8efd-61b0b5ef4839",
                                                "sense_id": "502278e6-14da-3f74-94af-dfd2bba2cca9",
                                                "text": "Ivan, Kirill and Vasilisa are “roofers,” a loose-knit group of insanely non-acrophobic daredevils who scam and sneak their way to the tops of Russia’s highest buildings."
                                            },
                                            {
                                                "example_id": "472c9a1f-3faf-48f0-83cd-9df0c7d8678e",
                                                "sense_id": "502278e6-14da-3f74-94af-dfd2bba2cca9",
                                                "text": "This year, as part of his annual “Troublemaker Award,” the startup mentor and entrepreneur decided to spotlight a Ukrainian stunt-climber -- or, \"roofer\" -- who struck a blow for his home nation by sticking it to neighboring Russia."
                                            },
                                            {
                                                "example_id": "40353474-d31a-44e4-af22-1dfde3b03119",
                                                "sense_id": "502278e6-14da-3f74-94af-dfd2bba2cca9",
                                                "text": "“There aren’t many places in Latin America for the roofer to get on so our main aim was to climb Christ the Redeemer,” he said."
                                            },
                                            {
                                                "example_id": "df5deebc-cbd8-4362-9f5b-f5f8bee04bf2",
                                                "sense_id": "502278e6-14da-3f74-94af-dfd2bba2cca9",
                                                "text": "Many people say that I don’t look like roofer, which is really good when I try to get into a building which is really good secured. I started roofing two years ago with some friends."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d121908a-b8f4-4b18-9fcf-0bf3c170e90a",
                        "source_entry_id": "e9937725-1829-3e19-ab53-2f3147075b46",
                        "source_sense_id": "ef43e89f-64db-3cc6-8898-1cd933f94ed6",
                        "source_sense_description": "Handwerker, der Dächer deckt",
                        "target_lang_word": "couvreur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "couvreur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad3fcd11-e682-375d-8833-add31cd2d1bd",
                                        "entry_id": "e774f14b-dbac-3440-8f00-f2d4660f7374",
                                        "glosses": [
                                            "Celui qui fait les couvertures des bâtiments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85f8854b-2824-4a5d-8b1c-04ead64f0ee2",
                                                "sense_id": "ad3fcd11-e682-375d-8833-add31cd2d1bd",
                                                "text": "[…], et elle lui fit signe d'attendre qu'elle eût fini de donner à boire à cet affligé, un malheureux couvreur qui s'était cassé les deux bras en tombant d'un toit."
                                            },
                                            {
                                                "example_id": "03929665-08c5-44d0-b553-3a6aea79cec2",
                                                "sense_id": "ad3fcd11-e682-375d-8833-add31cd2d1bd",
                                                "text": "Les archives de Salins font mention, dès 1555, d'un Roqui vigneron. En 1659, des Roqui exercent le métier de couvreurs, de lanterniers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ea41ee6-566e-32ce-96a7-87221e3c4182",
                                        "entry_id": "e774f14b-dbac-3440-8f00-f2d4660f7374",
                                        "glosses": [
                                            "Officier chargé de garder la porte du temple."
                                        ],
