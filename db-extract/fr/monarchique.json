                    {
                        "form_id": "899e1080-cf9e-48a6-8187-7b69f5014d66",
                        "entry_id": "8d69e01f-cf85-3c74-a98e-9dde8d099c73",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "monarchiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "65e04788-12fb-3199-ab11-1d718896213a",
                        "entry_id": "8d69e01f-cf85-3c74-a98e-9dde8d099c73",
                        "glosses": [
                            "Qui a rapport à la monarchie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40987d30-33b9-4a44-b52e-2ea37c19d793",
                                "sense_id": "65e04788-12fb-3199-ab11-1d718896213a",
                                "text": "État, gouvernement, pouvoir monarchique. - Principes, idées monarchiques. - Système monarchique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "030d28b5-56b8-4441-b2b3-0e7486f303ee",
                        "source_entry_id": "8d69e01f-cf85-3c74-a98e-9dde8d099c73",
                        "source_sense_id": "65e04788-12fb-3199-ab11-1d718896213a",
                        "target_lang_word": "monarchisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monarchisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09f9575e-2d9b-3764-b6d9-db4709f7d716",
                                        "entry_id": "3cd7e183-4af7-3710-81ae-bfa7a005824e",
                                        "glosses": [
                                            "in Bezug auf eine Monarchie; von einem Monarchen (ausgehend)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3766aa0-dacb-43af-ae57-238096565a68",
                                                "sense_id": "09f9575e-2d9b-3764-b6d9-db4709f7d716",
                                                "text": "„Man kann annehmen, daß die Mehrheit des gesetzgebenben Körpers damals entschieden monarchisch gesinnt war; es läßt sich also auch annehmen, daß dreiviertel aller Staatsbeamten damals monarchisch gesinnt waren.“"
                                            },
                                            {
                                                "example_id": "6ad168c1-f456-4595-ba46-d70213d8afcf",
                                                "sense_id": "09f9575e-2d9b-3764-b6d9-db4709f7d716",
                                                "text": "„Vom Beginn des Jahrhunderts an hatten die Deutschen unmittelbar vor sich eine Mehrzahl von Staaten, alle souverän, monarchisch und einfach, dazu einige Republiken.“"
                                            },
                                            {
                                                "example_id": "23fd272b-e633-4da1-ab9f-0e91c4fc3042",
                                                "sense_id": "09f9575e-2d9b-3764-b6d9-db4709f7d716",
                                                "text": "„Das monarchische und republikanische Princip standen sich unversöhnlich gegenüber.“"
                                            },
                                            {
                                                "example_id": "0e86d4ed-5a8c-464c-80ff-26ee197c2a84",
                                                "sense_id": "09f9575e-2d9b-3764-b6d9-db4709f7d716",
                                                "text": "„Robertus ist Zeit seines Lebens von streng monarchischer Gesinnung gewesen. Er hielt zwar die sozialistische Republik auch für möglich.“"
                                            },
                                            {
                                                "example_id": "b7bd4e74-516b-460b-ac74-f576fc6ae1f0",
                                                "sense_id": "09f9575e-2d9b-3764-b6d9-db4709f7d716",
                                                "text": "„Wenn aber die gesetzgebende Gewalt die Totalität ist, müßten vielmehr monarchische Gewalt und Regierungsgewalt Momente der gesetzgebenden Gewalt sein.“"
                                            },
                                            {
                                                "example_id": "a6289f9a-9c96-4309-90d1-0cb9fcbd2f0f",
                                                "sense_id": "09f9575e-2d9b-3764-b6d9-db4709f7d716",
                                                "text": "„Auch nach dieser Richtung brachte das Jahr 1848 eine freilich nur geringe Wendung zum Besseren, da dem Kaiser daran lag, die monarchischsten und konservativsten Elemente seines Reiches sich nicht zu entfremden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "245b9061-8d3a-40f1-aa51-5985d1f35b94",
                        "source_entry_id": "8d69e01f-cf85-3c74-a98e-9dde8d099c73",
                        "source_sense_id": "65e04788-12fb-3199-ab11-1d718896213a",
                        "target_lang_word": "monarchical",
