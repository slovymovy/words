                "entry_id": "1538f2e5-3bef-3d39-b1e0-f3315e2c4fb9",
                "word": "uncial",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "be581bc2-d711-3f9e-8644-1044fcdc02ff",
                        "entry_id": "1538f2e5-3bef-3d39-b1e0-f3315e2c4fb9",
                        "glosses": [
                            "Of or relating to a majuscule style of writing with unjoined, rounded letters, originally used in the 4th–9th centuries."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "90dcea8f-50ab-4660-bf43-1d419b61e2ec",
                                "sense_id": "be581bc2-d711-3f9e-8644-1044fcdc02ff",
                                "text": "This, also written in black letter, we found inscribed on a second parchment that was in the coffer, apparently somewhat older in date than that on which was inscribed the mediæval Latin translation of the uncial Greek of which I shall speak presently."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3068db51-a9c7-41a6-9957-2721dba8b259",
                        "source_entry_id": "1538f2e5-3bef-3d39-b1e0-f3315e2c4fb9",
                        "source_sense_id": "be581bc2-d711-3f9e-8644-1044fcdc02ff",
                        "source_sense_description": "of or related to uncial",
                        "target_lang_word": "unzial",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unzial",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eca2f56a-fe4f-3adf-9a42-580012b7230e",
                                        "entry_id": "78d039ea-942e-3a78-b698-9247e2847a0d",
                                        "glosses": [
                                            "mit den Formen einer Unzialschrift oder in einer Unzialschrift geschrieben"
                                        ],
                                        "tags": [
                                            "Typographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3bd0282-f18c-48de-961d-df68577583d2",
                                                "sense_id": "eca2f56a-fe4f-3adf-9a42-580012b7230e",
                                                "text": "„Für die Inschrift ist das Nebeneinander von kapitalen und unzialen Formen kennzeichnend: kapitales U und M, unziales D und E, T einmal kapital, einmal unzial, N einmal kapital, einmal halbunzial, A einmal kapital, einmal pseudounzial mit kapitalem Querbalken, aber unzialem linken Schenkel, was wohl durch die Ligatur bedingt ist.“"
                                            },
                                            {
                                                "example_id": "5832d3c2-104f-41d8-9d4f-dc3998b96b14",
                                                "sense_id": "eca2f56a-fe4f-3adf-9a42-580012b7230e",
                                                "text": "„Das b ist gerade und hat keine Schlinge. Das d ist unzial und hat manchmal eine Schlinge.“"
                                            },
                                            {
                                                "example_id": "842c3b1e-f7b4-4377-aec1-2827ea4067ed",
                                                "sense_id": "eca2f56a-fe4f-3adf-9a42-580012b7230e",
                                                "text": "„D ist unzial mit starken Schwellungen, der Balken nach oben fischschwanzartig auslaufend. Das unziale E ist mit einem senkrechten, leicht durchgewellten Haarstrich geschlossen.“"
                                            },
                                            {
                                                "example_id": "c63166f6-5576-4774-9029-d7c44750e9eb",
                                                "sense_id": "eca2f56a-fe4f-3adf-9a42-580012b7230e",
                                                "text": "„Lediglich das d wird im allgemeinen noch unzial geschrieben und erhält dabei einen schrägen Schaft nach links oben; […]“"
                                            },
                                            {
                                                "example_id": "7b0b0e4e-dca9-4460-892b-14d719e6c618",
                                                "sense_id": "eca2f56a-fe4f-3adf-9a42-580012b7230e",
                                                "text": "„Der Codex Salmasianus ist eine lateinische Handschrift in unzialer Schrift, die heute in Paris aufbewahrt wird (Codex Parisinus Latinus 10318).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
