                "translations": [
                    {
                        "translation_id": "8a9a0cae-d008-4c72-972a-b9df9bf4bd17",
                        "source_entry_id": "39b50fcc-7c8e-36f2-96c3-b1f72425a0a0",
                        "source_sense_description": "final syllable",
                        "target_lang_word": "Endsilbe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Endsilbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7627e6ca-1905-3702-8e04-06d9ad8a9b83",
                                        "entry_id": "e5772e27-1f83-3a33-b192-7f8cb51f82bd",
                                        "glosses": [
                                            "Silbe, die das Wortende bildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a7380fe-838e-45ba-aa8f-7eda6c9ac5e3",
                                                "sense_id": "7627e6ca-1905-3702-8e04-06d9ad8a9b83",
                                                "text": "Im Deutschen sind die Endsilben in der Regel unbetont; Ausnahmen sind Wörter, die nur aus einer Silbe bestehen (z.B. See) oder aus anderen Sprachen entlehnt sind wie z.B. Tattoo ([tɛ'tuː])."
                                            },
                                            {
                                                "example_id": "68602fab-1bbd-4569-92aa-4d85a838cf36",
                                                "sense_id": "7627e6ca-1905-3702-8e04-06d9ad8a9b83",
                                                "text": "„als Varianten wurde der Vokalschwund in unbetonten Endsilben vor Liquida und Nasal genannt…“"
                                            },
                                            {
                                                "example_id": "5e583c81-9516-40f3-afd5-774cf4489d50",
                                                "sense_id": "7627e6ca-1905-3702-8e04-06d9ad8a9b83",
                                                "text": "„Die Unwirklichkeit der Norm kommt unter anderem in den Ausspracheanweisungen für Klusile (…) und für die reduzierten Vokale [ə] und [ɐ] in unbetonten Endsilben zum Ausdruck.“"
                                            },
                                            {
                                                "example_id": "8214b0c8-6425-4dde-9c2e-4440fa4b67ed",
                                                "sense_id": "7627e6ca-1905-3702-8e04-06d9ad8a9b83",
                                                "text": "„In frühneuhochdeutscher Zeit wurde es notwendig, die Nomina agentis durch ein neues sprachliches Mittel zu kennzeichnen, weil es durch die Abschwächung der Endsilben nicht mehr möglich war, diese Semantik in der herkömmlichen Weise auszurichten.“"
                                            },
                                            {
                                                "example_id": "3460ea00-b05b-485a-b937-0c7705cb8541",
                                                "sense_id": "7627e6ca-1905-3702-8e04-06d9ad8a9b83",
                                                "text": "„Daß der Akzent, der in den semitischen Sprachen auf der Endsilbe liegt, von den deutschen Juden ein wenig europäisiert, das heißt auf die zweitletzte Silbe zurückgezogen wurde und daß als Folge davon die Vokale der unbetonten Endsilben klanglich entfärbt wurden, mag dabei noch verständlich sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
