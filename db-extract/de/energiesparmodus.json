                ],
                "senses": [
                    {
                        "sense_id": "33050bfe-91a1-37fa-9166-63bb725870d6",
                        "entry_id": "b2c9e1e3-2e2a-3e33-b402-87631d233fe0",
                        "glosses": [
                            "Betriebsart eines Geräts, bei der versucht wird möglichst wenig Energie zu verbrauchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b17f6f08-1f54-4398-a078-c3874c006e04",
                                "sense_id": "33050bfe-91a1-37fa-9166-63bb725870d6",
                                "text": "„Auch diesmal besteht die Gefahr, dass aus der einstweiligen Pause eine permanente wird: Um im Energiesparmodus die Elektronik vor Schäden zu bewahren, darf sie nicht unter eine Temperatur von -37 Grad Celsius sinken.“"
                            },
                            {
                                "example_id": "b881a9ea-df5d-41a9-ad72-c0d4403b810a",
                                "sense_id": "33050bfe-91a1-37fa-9166-63bb725870d6",
                                "text": "„Seit New Horizons 2015 am Pluto vorbeigeflogen ist, hat sie die meiste Zeit im Energiesparmodus verbracht.“"
                            },
                            {
                                "example_id": "0cea5223-2e9a-41f1-a97d-3ea9f4187110",
                                "sense_id": "33050bfe-91a1-37fa-9166-63bb725870d6",
                                "text": "„Wenn Sie den Computer via Teamviewer in den Energiesparmodus versetzen, kommt Ihnen die Anzeige des Stromverbrauchs in der Mystrom-App zupass.“"
                            },
                            {
                                "example_id": "485f668b-7afb-49df-b263-5d1851f5069d",
                                "sense_id": "33050bfe-91a1-37fa-9166-63bb725870d6",
                                "text": "„Die Energiesparmodi Standby (oder auch „Energie sparen“) und Ruhezustand funktionieren unter Windows nur dann richtig, wenn sehr viele einzelne Komponenten und Treiber sauber zusammenspielen und die Konfiguration des BIOS-Setup und von Windows exakt passt.“"
                            },
                            {
                                "example_id": "5b24f49c-0e21-4169-953a-9b95c2388986",
                                "sense_id": "33050bfe-91a1-37fa-9166-63bb725870d6",
                                "text": "„Zu den besonderen Einstellmöglichkeiten des HTC One M8 zählen die beiden Energiesparmodi, mit denen sich die Akkulaufzeit spürbar verbessern lässt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
