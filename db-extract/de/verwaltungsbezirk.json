                    {
                        "translation_id": "ed823d3c-df16-4b42-bd42-5c87e6075610",
                        "source_entry_id": "f0a6e680-35fd-3740-97f7-0ca6a93c3128",
                        "source_sense_id": "89feec09-a33e-3d31-8a43-f94246aa99f2",
                        "source_sense_description": "Bezirk, der für die Verwaltung zuständig ist",
                        "target_lang_word": "διαμέρισμα",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "διαμέρισμα",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "4f4c6bea-7533-367b-bb70-aea5d2bcc97f",
                                        "entry_id": "5fbe84bc-02bb-36f0-825f-38ee69b75b16",
                                        "glosses": [
                                            "σύνολο δωματίων ενός πολυώροφου κτηρίου, με λειτουργική ενότητα που αποτελούν μία κατοικία"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bafabf87-a8d2-46f2-b7df-115045c0b578",
                                                "sense_id": "4f4c6bea-7533-367b-bb70-aea5d2bcc97f",
                                                "text": "※ Το νέο καθεστώς φορολογίας θα αφορά περισσότερους από 3.500.000 ιδιοκτήτες διαμερισμάτων, μεζονετών, μονοκατοικιών, επαγγελματικών ακινήτων, οικοπέδων, κ.ά. και είναι βέβαιο ότι θα επηρεάσει αρνητικά τις τσέπες των νοικοκυριών. (@tovima.gr)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a976605f-fd1e-348a-8660-635cbb3a60b0",
                                        "entry_id": "5fbe84bc-02bb-36f0-825f-38ee69b75b16",
                                        "glosses": [
                                            "μεγάλη γεωγραφική ενότητα, τμήμα μιας χώρας"
                                        ],
                                        "tags": [
                                            "γεωγραφία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b6c6973-79b3-4e36-9d80-6ea465c1206f",
                                                "sense_id": "a976605f-fd1e-348a-8660-635cbb3a60b0",
                                                "text": "Κατηγορία:Διαμερίσματα στο Βικιλεξικό"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b64d9609-41a1-3ca2-ad8b-0eaa66fa525a",
                                        "entry_id": "5fbe84bc-02bb-36f0-825f-38ee69b75b16",
                                        "glosses": [
                                            "partition: τμήμα της επιφάνειας ενός σκληρού δίσκου, ειδικά διαμορφωμένο για να υποδεχθεί ένα λειτουργικό σύστημα ή δεδομένα και να λειτουργεί σαν να είναι μια (φυσική) ξεχωριστή μονάδα δίσκου"
                                        ],
                                        "tags": [
                                            "πληροφορική"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e98622d1-7e5b-4df7-a622-c98d1d7ef820",
                                                "sense_id": "b64d9609-41a1-3ca2-ad8b-0eaa66fa525a",
                                                "text": "※ Χωρίζοντας ένα δίσκο σε διαμερίσματα, ενώ συνεχίζουμε να έχουμε ένα φυσικό δίσκο το σύστημα τον βλέπει σαν δύο ή περισσότερους δίσκους."
                                            },
                                            {
                                                "example_id": "dc422d7f-5aaa-4835-b34d-e3dfc0bccd55",
                                                "sense_id": "b64d9609-41a1-3ca2-ad8b-0eaa66fa525a",
                                                "text": "※ Ένας άλλος πολύ καλός λόγος για να έχουμε πολλαπλά διαμερίσματα δίσκου είναι αν θέλουμε να εγκαταστήσουμε περισσότερα από ένα λειτουργικά συστήματα."
                                            },
                                            {
                                                "example_id": "37a6dc51-7c76-4f13-be09-23bac6cc40ab",
                                                "sense_id": "b64d9609-41a1-3ca2-ad8b-0eaa66fa525a",
                                                "text": "※ αν χαλάσει σε φυσικό επίπεδο ο δίσκος, όσα διαμερίσματα δίσκου και αν έχουμε δημιουργήσει, θα χαθούν όλα"
                                            },
                                            {
                                                "example_id": "19940b61-696e-4d05-ba30-b189560b3626",
                                                "sense_id": "b64d9609-41a1-3ca2-ad8b-0eaa66fa525a",
                                                "text": "※ Το διαμέρισμα δίσκου ουσιαστικά είναι ένας εικονικός διαχωρισμός του δίσκου σε δύο ή περισσότερα κομμάτια. Όμως, και τα δύο κομμάτια δεν παύουν να είναι μέρος του ίδιου δίσκου. Αυτό σημαίνει πως αν ο δίσκος χαλάσει, τα δεδομένα όλων των partitions θα χαθούν."
                                            },
                                            {
                                                "example_id": "53b2f50f-a827-4526-b0a1-453be8cf00d7",
                                                "sense_id": "b64d9609-41a1-3ca2-ad8b-0eaa66fa525a",
                                                "text": "※ εάν έχουμε μία μονάδα σκληρού δίσκου και δημιουργήσουμε δύο διαμερίσματα, μπορούμε να εγκαταστήσουμε το λειτουργικό σύστημα και τις εφαρμογές στο πρώτο διαμέρισμα, και να αποθηκεύσουμε τα δεδομένα μας στο δεύτερο διαμέρισμα"
                                            },
                                            {
                                                "example_id": "6d3acee7-d629-4688-895d-9f1ac399b43d",
                                                "sense_id": "b64d9609-41a1-3ca2-ad8b-0eaa66fa525a",
                                                "text": "υπώνυμα: εκκινήσιμο διαμέρισμα, ενεργό διαμέρισμα"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
