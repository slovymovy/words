                                        "glosses": [
                                            "eine Legierung aus Gold und Silber"
                                        ],
                                        "tags": [
                                            "Betonung nur auf der 2. Silbe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c222caa9-c826-4e6c-a8ce-43943b46a428",
                                                "sense_id": "65f3d67b-6c69-32e0-b3f2-a896fb27e3cf",
                                                "text": "Ursprünglich hielt man Elektron für ein eigenständiges Metall."
                                            }
