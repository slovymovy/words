                                "target_senses": [
                                    {
                                        "sense_id": "55d1844a-0229-3fc7-b973-090df168ae67",
                                        "entry_id": "f76889d2-e565-351a-994d-2e5346318798",
                                        "glosses": [
                                            "etwas zum zweiten oder mehrfachen Male, erneut tun, durchführen, stattfinden lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e042845-4e6c-42cd-9b95-57b2035db342",
                                                "sense_id": "55d1844a-0229-3fc7-b973-090df168ae67",
                                                "text": "Wiederhole deine Prüfung."
                                            },
                                            {
                                                "example_id": "91ecac02-e667-4680-8dfc-a73227f6f20a",
                                                "sense_id": "55d1844a-0229-3fc7-b973-090df168ae67",
                                                "text": "„Um Übertragungsfehler zu vermeiden, wiederholten die Deutschen ihren Nachrichtenschlüssel (drei zufällig gewählte Buchstaben), natürlich durch den Tagesschlüssel codiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "10e6cd0f-0f60-3d77-a8cd-6c10a18da3dc",
                                        "entry_id": "f76889d2-e565-351a-994d-2e5346318798",
                                        "glosses": [
                                            "etwas zum zweiten oder mehrfachen Male, erneut tun, durchführen, stattfinden lassen",
                                            "etwas Gelerntes zum Zwecke der Übung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "f68cc906-1230-395d-bdaa-65dd1dd4b762",
                                        "entry_id": "f76889d2-e565-351a-994d-2e5346318798",
                                        "glosses": [
                                            "etwas zum zweiten oder mehrfachen Male, erneut aussprechen, sagen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c43f2a9a-fe8b-4b91-a507-e888bfc9b0ab",
                                                "sense_id": "f68cc906-1230-395d-bdaa-65dd1dd4b762",
                                                "text": "Großmütter wiederholen sich gern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "44a793bf-7352-39a9-9383-2520eac0d2e4",
                                        "entry_id": "f76889d2-e565-351a-994d-2e5346318798",
                                        "glosses": [
                                            "erneut geschehen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b14b1285-935a-468a-8286-8dca1b88520b",
                                                "sense_id": "44a793bf-7352-39a9-9383-2520eac0d2e4",
                                                "text": "Die Ereignisse wiederholen sich."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "wiederholen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6d0176d-ae61-3b4f-8fa8-9530f76e41d2",
                                        "entry_id": "5ce3efa3-a47e-3340-b7f5-7cf7c6331f3a",
                                        "glosses": [
                                            "etwas oder jemanden an den ursprünglichen Ort zurückholen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60475fe1-a79a-4e42-b5a0-59400ea06a61",
                                                "sense_id": "c6d0176d-ae61-3b4f-8fa8-9530f76e41d2",
                                                "text": "Die Vergangenheit wiederzuholen gelingt nie, sie zu wiederholen gelingt, indem die Vergangenheit zur Dominante einer Zeit wird."
                                            },
                                            {
                                                "example_id": "4044d271-6cc9-4c55-aca7-58ecd0d5a2ae",
                                                "sense_id": "c6d0176d-ae61-3b4f-8fa8-9530f76e41d2",
                                                "text": "„Die Franzosen habe sich ihre Freiheit wiedergeholt,“ so Le Pen."
                                            },
                                            {
                                                "example_id": "8a8e69ba-83a3-4e2c-a60e-ca9dbd0375b2",
                                                "sense_id": "c6d0176d-ae61-3b4f-8fa8-9530f76e41d2",
                                                "text": "Daher ließ sie einen ihrer Handschuhe in den Zwinger der Löwen fallen, die in der größten Raserei waren; dann bat sie Herrn de Lorge, ihn wiederzuholen, wenn er sie wirklich so sehr liebe, wie er sage."
                                            },
                                            {
                                                "example_id": "34fd45ba-ef00-4ab6-84c0-9c3aaf2cdafe",
                                                "sense_id": "c6d0176d-ae61-3b4f-8fa8-9530f76e41d2",
                                                "text": "Sie schrieb mehrere Briefe, kündigte auch an, sich das Geld bei dem Verwalter und Elektriker wiederzuholen."
                                            },
                                            {
                                                "example_id": "788fb108-d3c2-4e0a-b90c-371721673d10",
                                                "sense_id": "c6d0176d-ae61-3b4f-8fa8-9530f76e41d2",
                                                "text": "Er reiste nun nach Rom zu Augustus, um die Söhne wiederzuholen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
