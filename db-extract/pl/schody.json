                            },
                            {
                                "target_word": "stairs",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e21a312-f748-3528-8728-8bbe8f52dfa0",
                                        "entry_id": "18504e19-57ff-3104-b0b9-30d9c29f742a",
                                        "glosses": [
                                            "A contiguous set of steps connecting two floors."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e851281c-c169-4977-a820-5ddad4502358",
                                                "sense_id": "6e21a312-f748-3528-8728-8bbe8f52dfa0",
                                                "text": "There're two cats at the top of the stairs."
                                            },
                                            {
                                                "example_id": "369298e8-44e9-432e-9234-3bd9a05ec74e",
                                                "sense_id": "6e21a312-f748-3528-8728-8bbe8f52dfa0",
                                                "text": "At length, one night, when the company by ſome accident broke up much ſooner than ordinary, ſo that the candles were not half burnt out, ſhe was not able to reſiſt the temptation, but reſolved to have them ſome way or other. Accordingly, as ſoon as the hurry was over, and the ſervants, as ſhe thought, all gone to ſleep, ſhe ſtole out of her bed, and went down ſtairs, naked to her ſhift as ſhe was, with a deſign to ſteal them […]"
                                            },
                                            {
                                                "example_id": "3576d415-2704-44d6-a3f2-4f1394add0d5",
                                                "sense_id": "6e21a312-f748-3528-8728-8bbe8f52dfa0",
                                                "text": "We tiptoed into the house, up the stairs and along the hall into the room where the Professor had been spending so much of his time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffcaf38f-4e7d-4467-a01d-495b54cf0e9d",
                        "source_entry_id": "f8ab2aa9-1171-3d7a-9ef2-9b1d2ebc517d",
                        "source_sense_id": "c67baad4-ea69-339f-8d98-5d10b9680f89",
