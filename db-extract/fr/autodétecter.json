                ],
                "senses": [
                    {
                        "sense_id": "e9b69eb6-abb8-320e-a3ea-dd53fbd03a8a",
                        "entry_id": "47949b99-8200-3b50-8cc9-59d85e7d1696",
                        "glosses": [
                            "Détecter automatiquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "995859d7-368e-4720-ba13-4ca6d80a76be",
                                "sense_id": "e9b69eb6-abb8-320e-a3ea-dd53fbd03a8a",
                                "text": "Mplayer essaye d’autodétecter certains trucs à l’exécution, et se serait emmêlé les pinceaux ?!"
                            },
                            {
                                "example_id": "05e1ce17-5ef0-4908-8f72-e71d5d75b2dd",
                                "sense_id": "e9b69eb6-abb8-320e-a3ea-dd53fbd03a8a",
                                "text": "Normalement il te faut régler ton FSB (front side bus) à 133 MHz et laisser le BIOS autodétecter le coeff à appliquer pour ton processeur."
                            },
                            {
                                "example_id": "181a2657-983d-4964-a1f9-e7d28557e7c7",
                                "sense_id": "e9b69eb6-abb8-320e-a3ea-dd53fbd03a8a",
                                "text": "“ Il faut que les réseaux apprennent à se débrouiller tout seuls. Ils devront s’autodétecter, s’auto-organiser, s’autoconfigurer, s’auto-optimiser mais aussi s’autoréparer et analyser eux-mêmes leurs vulnérabilités ”, précise Olivier Audouin, directeur opérationnel du laboratoire commun."
                            }
                        ]
                    }
