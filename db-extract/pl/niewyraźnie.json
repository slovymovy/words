                                                "sense_id": "e215901d-6594-3bf9-9839-ec2b93ff1171",
                                                "text": "In welcher Beziehung sie zu ihm stand, war ihr selber noch sehr unklar."
                                            },
                                            {
                                                "example_id": "b6a97390-f160-448f-89c6-8cef108b9c76",
                                                "sense_id": "e215901d-6594-3bf9-9839-ec2b93ff1171",
                                                "text": "Seine Gefühle für sie waren ihm völlig unklar."
                                            }
