                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7cd47a8-b5c1-4b13-a484-4f4ef9e72beb",
                        "source_entry_id": "62f1c6be-7fd8-3165-862d-6edd9366e781",
                        "source_sense_id": "8b997730-480a-3825-a7f2-a527369f0608",
                        "target_lang_word": "Atlantik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atlantik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a821e95e-7688-30e1-9c43-f99241ca5c6c",
                                        "entry_id": "7d794cc7-232e-3814-bf05-e0517d9c9597",
                                        "glosses": [
                                            "Ozean zwischen Afrika, Europa, Nordamerika und Südamerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fda425c-2da5-4314-b584-e3a9b06bcb3b",
                                                "sense_id": "a821e95e-7688-30e1-9c43-f99241ca5c6c",
                                                "text": "Mit der Beherrschung des Atlantiks begann die Globalisierung."
                                            },
                                            {
                                                "example_id": "5fb1d6c9-0137-47e0-8bb3-2f39dffc7bca",
                                                "sense_id": "a821e95e-7688-30e1-9c43-f99241ca5c6c",
                                                "text": "„Sechs Wochen waren damals auf dem Atlantik eine lange Zeit, wenn die nächsten sechs Stunden oder gar sechs Minuten ihnen die Katastrophe bringen konnten.“"
                                            },
                                            {
                                                "example_id": "4db842d5-063f-44e6-acbf-54df2295373b",
                                                "sense_id": "a821e95e-7688-30e1-9c43-f99241ca5c6c",
                                                "text": "„Seit Jahrzehnten schon schaffte man ständig Nachschub über den Atlantik und den Indischen Ozean in die älteren Kolonien.“"
                                            },
                                            {
                                                "example_id": "1c3ba32b-48f4-4694-933a-e92b9663a853",
                                                "sense_id": "a821e95e-7688-30e1-9c43-f99241ca5c6c",
                                                "text": "„Während der kurzen Regenzeit wird das Tal von mitreißenden Regenfluten überschwemmt, die sich donnernd in den Atlantik ergießen.“"
                                            },
                                            {
                                                "example_id": "1a7ff1c2-305a-484a-8046-b109084b1d7a",
                                                "sense_id": "a821e95e-7688-30e1-9c43-f99241ca5c6c",
                                                "text": "„Die Sterne wanderten langsam in ihren gekrümmten Bögen über den Himmel, und der Andere trieb unmerklich im Atlantik nirgendwohin.“"
                                            },
                                            {
                                                "example_id": "5de052f7-9819-4109-8241-5b22c6ee4c28",
                                                "sense_id": "a821e95e-7688-30e1-9c43-f99241ca5c6c",
                                                "text": "„An den immergrünen Hängen der erkalteten Vulkane grasen die schönsten Kühe des Atlantik und dort befindet sich Europas einzige Teeplantage.“"
                                            }
                                        ],
