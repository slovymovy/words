                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_person",
                    "name_type": "historical_name",
                    "examples": [
                        {
                            "text": "Field Marshal <w>Haig</w> commanded the British forces on the Western Front.",
                            "target_lang_translations": {
                                "ru": "Фельдмаршал <w>Хейг</w> командовал британскими войсками на Западном фронте."
                            }
                        },
                        {
                            "text": "Historians continue to debate the military decisions made by General <w>Haig</w>.",
                            "target_lang_translations": {
                                "ru": "Историки продолжают спорить о военных решениях, принятых генералом <w>Хейгом</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "General Haig",
                        "Field Marshal Haig"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дуглас Хейг, 1-й граф Хейг (1861–1928), британский военачальник периода Первой мировой войны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хейг",
                                "target_lang_sense_clarification": "британский фельдмаршал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "401ab6b7-57ae-35bb-a1ca-242667537463",
                    "sense_definition": "Alternative spelling of <w>Hayk</w>, the legendary patriarch and founder of the Armenian nation.",
