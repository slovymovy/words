                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cd8070a3-68e8-41e9-a555-3ec4e9353811",
                        "source_entry_id": "f09c6820-65dd-3d49-b997-797ba824d032",
                        "source_sense_id": "7984e6d8-7f9e-3b6a-b2b3-9e7d8524d45b",
                        "target_lang_word": "Kreischen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kreischen",
