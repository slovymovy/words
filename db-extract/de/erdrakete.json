                "senses": [
                    {
                        "sense_id": "60656cc9-b6ea-3ed6-b903-038014e409aa",
                        "entry_id": "da6b05a0-474c-3719-bab6-bd11f5649ddc",
                        "glosses": [
                            "ein pneumatisch betriebener Verdrängungshammer zum grabenlosen Verlegen von Kurz- und Langrohren bis DN 200"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f54281d4-aabb-47d2-bdf9-8ffd17da9521",
                                "sense_id": "60656cc9-b6ea-3ed6-b903-038014e409aa",
                                "text": "„Dabei wird die sogenannte Erdrakete durch den Druck eines Baukompressors angetrieben aus einem Keller oder im Freien aus einer kleinen Startgrube in eine gewünschte Richtung gelenkt und schießt unter einzelnen Schlägen zielgenau unter Strassen, Bahndämmen und Gärten hindurch, um Ver- und Entsorgungsleitungen bis zu 200 mm zu verlegen.“"
                            },
                            {
                                "example_id": "36cd9b6c-737a-46dd-9256-fbd3fe92a1ad",
                                "sense_id": "60656cc9-b6ea-3ed6-b903-038014e409aa",
                                "text": "„Erdraketen bzw. Bodendurchschlagsraketen arbeiten im Prinzip wie ein Presslufthammer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
