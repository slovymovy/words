                ],
                "senses": [
                    {
                        "sense_id": "897739b9-9c1f-3d5d-8e7d-f022316d4e0d",
                        "entry_id": "0292d453-a88c-38ae-ba73-ab190ec31ca4",
                        "glosses": [
                            "Qui est composé de chondrite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdc58f6c-69c2-4137-b8de-2a2a498ea235",
                                "sense_id": "897739b9-9c1f-3d5d-8e7d-f022316d4e0d",
                                "text": "Les météorites chondrites ou pierreuses représentent 80 % de celles qui percutent la Terre."
                            },
                            {
                                "example_id": "5e442d4c-8390-4e7a-a836-cf89bd87324c",
                                "sense_id": "897739b9-9c1f-3d5d-8e7d-f022316d4e0d",
                                "text": "Pour tester cette hypothèse, les chercheurs ont analysé l'\"empreinte\" isotopique de morceaux de ces d’astéroïdes qui ont pris la forme de météorites chondrites carbonées riches en eau une fois parvenue à la surface terrestre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af3d5407-cd89-4923-bedb-3b4662aceced",
                        "source_entry_id": "0292d453-a88c-38ae-ba73-ab190ec31ca4",
                        "source_sense_id": "897739b9-9c1f-3d5d-8e7d-f022316d4e0d",
                        "source_sense_description": "1. (Astronomie, Géologie) Qui est composé de chondrite",
                        "target_lang_word": "chondritisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chondritisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6654c32e-65f1-31fc-9f9c-f331441fc80b",
                                        "entry_id": "e529509a-508c-35ac-abc1-0aae7cd43966",
                                        "glosses": [
                                            "den Aufbau oder die Struktur des Chondrits betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d0d4620-cab8-4660-9c4e-267a0d42c5c7",
                                                "sense_id": "6654c32e-65f1-31fc-9f9c-f331441fc80b",
                                                "text": "Ihr Pauschalchemismus ist dementsprechend extrem gegenüber der normalen chondritischen Zusammensetzung fraktioniert."
                                            },
                                            {
                                                "example_id": "778d2ac9-3ded-410c-81ac-72331de0eebf",
                                                "sense_id": "6654c32e-65f1-31fc-9f9c-f331441fc80b",
                                                "text": "Er [der Meteorit von Lanzenkirchen] zeigt eine ausgeprägte hell-dunkel Struktur von hellen chondritischen Knollen in dunkler Matrix."
                                            },
                                            {
                                                "example_id": "fc2bf9df-b818-4f54-a1f4-99f0cc0dae07",
                                                "sense_id": "6654c32e-65f1-31fc-9f9c-f331441fc80b",
                                                "text": "Innerhalb der großen Bruchstücke liegen exzentrisch knollenartige, hellgraue Partien mit ausgesprochen chondritischem Charakter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "aaf84ddb-0c69-3b7a-9f8d-57bace8be8cc",
