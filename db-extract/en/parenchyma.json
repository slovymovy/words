                "word": "parenchyma",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c42bca8f-d548-4cb4-a899-95c00a7d7009",
                        "entry_id": "45e35487-2b77-3a3d-9c31-42bd207befdf",
                        "tags": [
                            "plural"
                        ],
                        "form": "parenchymas"
                    },
                    {
                        "form_id": "8ce4f441-b1f3-43d8-a3ab-79d9d22b102e",
                        "entry_id": "45e35487-2b77-3a3d-9c31-42bd207befdf",
                        "tags": [
                            "plural"
                        ],
                        "form": "parenchymata"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe0fde0d-6f36-3c65-9cb8-8133e151d603",
                        "entry_id": "45e35487-2b77-3a3d-9c31-42bd207befdf",
                        "glosses": [
                            "The functional tissue of an organ as distinguished from the connective and supporting tissue."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "831d4326-e711-42c2-b584-df0bd84693fc",
                                "sense_id": "fe0fde0d-6f36-3c65-9cb8-8133e151d603",
                                "text": "Previously blood and air had been thought to mingle freely in the fleshy parenchyma of the lungs, but the microscope now revealed the membranous alveoli at the ends of the tracheo-bronchial ramifications."
                            }
                        ]
                    },
                    {
                        "sense_id": "aea1b4c2-cb5f-370c-bc05-3d4adc7bb7c8",
                        "entry_id": "45e35487-2b77-3a3d-9c31-42bd207befdf",
                        "glosses": [
                            "The cellular tissue, typically soft and succulent, found chiefly in the softer parts of leaves, pulp of fruits, bark and pith of stems, etc."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e65e3e2a-7609-3b98-b21f-95b319fa4f9d",
                        "entry_id": "45e35487-2b77-3a3d-9c31-42bd207befdf",
                        "glosses": [
                            "Cellular tissue lying between the body wall and the organs of invertebrate animals lacking a coelom, such as flatworms."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f0e72f29-01f3-492c-b74c-7c7770b5804b",
                                "sense_id": "e65e3e2a-7609-3b98-b21f-95b319fa4f9d",
                                "text": "[I]n a Sponge, the Parenchyma, it seems, is but a kind of mucous gelly, which is very easily and cleerly wash'd away."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "719c9a30-828a-440a-88ee-a19fa5dc5f2a",
                        "source_entry_id": "45e35487-2b77-3a3d-9c31-42bd207befdf",
                        "source_sense_description": "functional part of an organ, as opposed to supporting tissue",
                        "target_lang_word": "parenchym",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5d4ad7e0-e53d-4bb9-923f-5ca04324e569",
                        "source_entry_id": "45e35487-2b77-3a3d-9c31-42bd207befdf",
                        "source_sense_description": "functional part of an organ, as opposed to supporting tissue",
                        "target_lang_word": "parenchyme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parenchyme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9cabe4b-b9ac-31e5-bb8a-734a91815a3c",
                                        "entry_id": "fead7c0c-1c88-3f07-a696-943cad466c76",
                                        "glosses": [
                                            "Tissu végétal constitué de cellules vivantes peu spécialisées, jouant un rôle de remplissage, de photosynthèse, de stockage ou de cicatrisation, présent dans tous les organes des plantes."
                                        ],
                                        "tags": [
                                            "Anatomie végétale",
                                            "Histologie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bb7aeb8-9cbe-49c3-9701-8c3b99d19497",
                                                "sense_id": "b9cabe4b-b9ac-31e5-bb8a-734a91815a3c",
                                                "text": "Une chenille qui prélève une tranche de parenchyme dans une feuille de cerisier est-elle malhonnête ?"
                                            },
                                            {
                                                "example_id": "5ab262de-c20e-4dfc-b0ee-f87c56c91c30",
                                                "sense_id": "b9cabe4b-b9ac-31e5-bb8a-734a91815a3c",
                                                "text": "Il disséquait les plantes avec la même adresse que les animaux, et, dégageant entièrement leurs vaisseaux de la pulpe ou parenchyme, il montrait à découvert ce qui faisait leur vie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cabae7ca-6d1b-3730-b4a4-857a0dafdd10",
                                        "entry_id": "fead7c0c-1c88-3f07-a696-943cad466c76",
                                        "glosses": [
                                            "Tissu spongieux constitutif de certains viscères, tels que le foie, le rein, etc."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c9c7054-6f0e-482b-be00-4b688aa4c865",
                                                "sense_id": "cabae7ca-6d1b-3730-b4a4-857a0dafdd10",
                                                "text": "L'estomac du chien ne digère proprement que le parenchyme ou la partie animale de l'os."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b317470a-a947-469d-aca4-e4602377456c",
                        "source_entry_id": "45e35487-2b77-3a3d-9c31-42bd207befdf",
                        "source_sense_description": "functional part of an organ, as opposed to supporting tissue",
                        "target_lang_word": "Parenchym",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parenchym",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "098a6962-35a1-3f5c-bf58-bc97f47e07e7",
                                        "entry_id": "c0963071-2db6-3dba-9fd6-3fe1c196a704",
                                        "glosses": [
                                            "menschliches oder tierisches Gewebe eines Organs, das dessen Funktion ermöglicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7d91da5-e5cd-4e74-95ec-5e8742d75141",
                                                "sense_id": "098a6962-35a1-3f5c-bf58-bc97f47e07e7",
                                                "text": "Die unsrige [Folgerung] ist die, dass die Hemisphären des großen Gehirns und namentlich ihre Corticalsubstanz und alles ungefaserte Parenchym die Bedeutung eines Ernährungsorgans für das Nervenprinzip der Sinneswerkzeuge haben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b127ac3-611f-3a9f-b16c-7b8845553926",
                                        "entry_id": "c0963071-2db6-3dba-9fd6-3fe1c196a704",
                                        "glosses": [
                                            "pflanzliches Grundgewebe aus dünnwandigen, polyedrischen Zellen mit annähernd gleichen Durchmessern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fa2181a-3a60-4585-978b-e0632ccec1ee",
                                                "sense_id": "8b127ac3-611f-3a9f-b16c-7b8845553926",
                                                "text": "Die darin behandelte Zellenlehre hat durch ihn manche Erweiterung erfahren. Die noch heute giltigen Namen für die verschiedenen Habitusformen des Zellgewebes, wie Merenchym, Parenchym, Prosenchym etc. rühren von ihm her; […]"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
