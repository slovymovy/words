                    {
                        "translation_id": "8d3cb8b6-ae35-4e26-848c-be600d181d5b",
                        "source_entry_id": "b3e8bbdf-fd69-3156-9a11-ee9fccf9d4b0",
                        "source_sense_id": "2111c9fe-ca34-369f-8c48-0f6c24bf8259",
