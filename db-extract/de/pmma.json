                    {
                        "translation_id": "00623e92-c577-44b5-a838-4b2110784739",
                        "source_entry_id": "8dac2095-f8e4-3d7b-8728-519b0fd64642",
                        "source_sense_id": "98fca00c-202c-3056-bd32-aa81b1d3e391",
                        "target_lang_word": "poly",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poly",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17eee9cb-9b39-3636-8dbc-c304cc7c4cc6",
                                        "entry_id": "72ae318d-e459-3ce2-8137-933dbf11d0f8",
                                        "glosses": [
                                            "Polycopié."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "338288c0-5ec0-49e1-a9b2-34e9c6d9f1a8",
                                                "sense_id": "17eee9cb-9b39-3636-8dbc-c304cc7c4cc6",
                                                "text": "Finis les artistes de tout poil pour nous faire comprendre les chiffons de Boltanski, finies les nuits blanches, finis les polys qu’il fallait faire réciter à Fanny."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poly",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "abdc070e-2adf-3f17-814b-fd4250960bb4",
                                        "entry_id": "f86fe35a-da93-3e05-b69f-25f00940c9ff",
                                        "glosses": [
                                            "Synonyme de polymultipliée."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "885794e2-6138-499f-a9ac-948efa44d4ad",
                                                "sense_id": "abdc070e-2adf-3f17-814b-fd4250960bb4",
                                                "text": "Eh quoi ! La simple et vulgaire bicyclette qu’on fabrique à la grosse, à très bas prix et qu’on vend relativement fort cher allait être détrônée par la nouvelle venue à prix de revient élevé ! La mono succomberait devant la poly !"
                                            },
                                            {
                                                "example_id": "0111832a-4fad-471a-aa0b-e29018e7c3d6",
                                                "sense_id": "abdc070e-2adf-3f17-814b-fd4250960bb4",
                                                "text": "C’est le duel mono-poly, poly-mono. Les uns, monoïstes à tous crions, ne veulent entendre parier que de la seule mono, légère, idéale, selon eux; les autres, polyxionnistes enragés, prétendant réfuter les idées des monoïstes, entendent prouver que, seule, la poly permet de faire du cyclotourisme. Et le duel continue, continue… Erreur, erreur! Les uns et les autres ont raison."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poly",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3904057-cf8f-30c9-a5f3-e0b27f4c7c37",
                                        "entry_id": "4135ac78-6a94-38dd-8f2e-438a2e1df526",
                                        "glosses": [
                                            "Polyvalente, école secondaire publique au Québec."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc40b8b0-c8cd-4e62-9a14-3b0e7d3151b4",
                                                "sense_id": "a3904057-cf8f-30c9-a5f3-e0b27f4c7c37",
                                                "text": "Je ne l'ai pas vue à la poly aujourd'hui."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poly",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c19a3876-7830-38c2-a46f-f7025f631419",
                                        "entry_id": "eac2c877-bb57-30d6-bcce-c6f8c6e5ec70",
                                        "glosses": [
                                            "Qui pratique le polyamour, qui vit en même temps plusieurs relations amoureuses."
                                        ],
                                        "tags": [
                                            "Abréviation"
                                        ],
                                        "examples": []
                                    }
                                ]
