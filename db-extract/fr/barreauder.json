                "senses": [
                    {
                        "sense_id": "1993b976-68fd-35ce-bc7a-84c057ead720",
                        "entry_id": "e567b82f-2aec-3d30-8fd3-5b774787c39e",
                        "glosses": [
                            "Garnir de barres, de barreaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea2d306b-fcb7-4af6-83af-97b76cb60ed8",
                                "sense_id": "1993b976-68fd-35ce-bc7a-84c057ead720",
                                "text": "Mais maintenant nous sommes partis, ce dos de banquette est plus épais que le mur qui m’a blessée, les portières sont barreaudées ; et je ne retrouve, dans le balancement souple de la voiture qui roule et roule, que des impressions antérieures à ce qui était, récemment, ma vie."
                            },
                            {
                                "example_id": "ac1f5aa7-6feb-4a70-ad95-054c91a95f2f",
                                "sense_id": "1993b976-68fd-35ce-bc7a-84c057ead720",
                                "text": "Il suffit que le locataire du rez-de-chaussée ait l’idée de barreauder son balcon et toute la chaîne en verticale se met en branle."
                            }
                        ]
                    }
