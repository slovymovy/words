                        ],
                        "form": "den Mahlstrom"
                    },
                    {
                        "form_id": "79d947ed-fc4f-48b2-ab8e-09e639f091e4",
                        "entry_id": "0080cf8d-8a72-383f-a50f-505426684e20",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Mahlströme"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1690c912-8f52-328f-96af-6bf62e24c6dd",
                        "entry_id": "0080cf8d-8a72-383f-a50f-505426684e20",
                        "glosses": [
                            "Ausgleichströmung des Meeres in Norwegen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "16f57d97-a788-4443-a9a5-3efe7635e917",
                                "sense_id": "1690c912-8f52-328f-96af-6bf62e24c6dd",
                                "text": "Der Mahlstrom ist ein Gezeitenstrom in Norwegen."
                            },
                            {
                                "example_id": "932e865d-1da7-41b2-9a4d-fbaa55e01662",
                                "sense_id": "1690c912-8f52-328f-96af-6bf62e24c6dd",
                                "text": "Jön i Hestba trieb nach Osten über den Fjord, und beinahe wäre auch er in den Mahlstrom getrieben, aber mit Gottes Gnade trieb das Schiff nach Osten ins Meer, und er segelte nach Norwegen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cf7e6df7-7854-344d-a3a8-d3cdbc110346",
                        "entry_id": "0080cf8d-8a72-383f-a50f-505426684e20",
                        "glosses": [
                            "ein reißender Fluss mit vielen Verwirbelungen"
                        ],
                        "tags": [
                            "im übertragenen Sinn"
                        ],
                        "examples": [
                            {
                                "example_id": "31731723-3927-4e16-aa10-85badb9e1411",
                                "sense_id": "cf7e6df7-7854-344d-a3a8-d3cdbc110346",
                                "text": "Viele kamen im Mahlstrom des Lebens an diesem Punkt vorbei."
                            },
                            {
                                "example_id": "e1198885-fedd-4159-bdf1-9549bcb51535",
                                "sense_id": "cf7e6df7-7854-344d-a3a8-d3cdbc110346",
                                "text": "Denn falls der Mahlstrom der „Irrtümlichkeit“ alle unsere Setzungen und Hypothesen verschlingt, kann sich auch die Behauptung der faktischen Existenz eines solchen Strudels nicht über Wasser halten."
                            },
                            {
                                "example_id": "94ff7614-a3d8-4976-a965-c933358d1983",
                                "sense_id": "cf7e6df7-7854-344d-a3a8-d3cdbc110346",
                                "text": "„Gullfoss sieht tatsächlich aus wie ein Mahlstrom, ein tödlicher Strudel, in dem jedes Leben vernichtet werden kann.“"
                            },
                            {
                                "example_id": "eaf20638-b2fc-4601-beee-8d2b5e9f5eb1",
                                "sense_id": "cf7e6df7-7854-344d-a3a8-d3cdbc110346",
                                "text": "„Der pazifische Konflikt, der schon seit 1931 im Gange war, und der europäische Orlog verschmolzen zu einem einzigen, den ganzen Globus umschlingenden, verschlingenden Mahlstrom der Gewalt.“"
                            },
                            {
                                "example_id": "a024eb87-bdb8-4392-98dd-a28b9d424ef7",
                                "sense_id": "cf7e6df7-7854-344d-a3a8-d3cdbc110346",
                                "text": "„Die meisten zogen weiter nach New York und wurden von dem großen Mahlstrom der Seeleute verschluckt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba2ed535-5028-4ee8-880a-97a33d767af6",
                        "source_entry_id": "0080cf8d-8a72-383f-a50f-505426684e20",
                        "source_sense_id": "1690c912-8f52-328f-96af-6bf62e24c6dd",
                        "source_sense_description": "Ausgleichströmung des Meeres in Norwegen",
                        "target_lang_word": "maelstrom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maelstrom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "860d4a67-b0a2-3886-a952-0d061ad5a1aa",
                                        "entry_id": "090d7402-9f0b-33fe-b81f-2cf59778d76c",
                                        "glosses": [
                                            "A large and violent whirlpool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d939bff-dda7-4348-843b-82b07db7339d",
                                                "sense_id": "860d4a67-b0a2-3886-a952-0d061ad5a1aa",
                                                "text": "To his right fell a gleaming sheet of water, and below it was a maelstrom, that made one giddy by its terrific gyrations."
                                            },
                                            {
                                                "example_id": "38dc513c-b954-4a8f-800a-d717fa04fb51",
                                                "sense_id": "860d4a67-b0a2-3886-a952-0d061ad5a1aa",
                                                "text": "The falukah plunged over a waterfall and was almost submerged, was caught again in a maelstrom and went twirling on in the blackness."
                                            },
                                            {
                                                "example_id": "f1e3b733-5111-455c-8116-a6acedbb9a19",
                                                "sense_id": "860d4a67-b0a2-3886-a952-0d061ad5a1aa",
                                                "text": "A hulking shape burst through the doorway and hurtled down the corridor, leaving a maelstrom of air currents in his wake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad1d223d-04d0-391e-8bd6-7115c766fe4a",
                                        "entry_id": "090d7402-9f0b-33fe-b81f-2cf59778d76c",
                                        "glosses": [
                                            "A chaotic or turbulent situation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c036151-0922-47ef-870e-de5075e8fc11",
                                                "sense_id": "ad1d223d-04d0-391e-8bd6-7115c766fe4a",
                                                "text": "It was of Jean Paul's doing: some single billow in that vast World-Mahlstrom of Humour, with its heaven-kissing coruscations, which is now, alas, all congealed in the frost of death!"
                                            },
                                            {
                                                "example_id": "678c1225-4eb2-418c-b380-837fda59c714",
                                                "sense_id": "ad1d223d-04d0-391e-8bd6-7115c766fe4a",
                                                "text": "He escaped at last, dizzy from the maelstrom of conflicting emotions that had caught and whirled him."
                                            },
                                            {
                                                "example_id": "2b0e4ec4-86bf-4a57-9cc0-dc0809b40179",
                                                "sense_id": "ad1d223d-04d0-391e-8bd6-7115c766fe4a",
                                                "text": "The terminal station, Richmond, is managed by South West Trains, heirs to the London & South Western Railway, and here the District fades into a railway maelstrom, since Richmond is not only on the Waterloo-Reading line but is also the westerly terminus of the London Overground."
                                            },
                                            {
                                                "example_id": "be23758a-d77e-48cf-b645-154fdc85d5d2",
                                                "sense_id": "ad1d223d-04d0-391e-8bd6-7115c766fe4a",
                                                "text": "Setting our sights back on King's Landing, where the Last War will be waged, makes a lot of sense, even if it does feel a bit anticlimactic after last week's deadly, blustery maelstrom."
                                            },
                                            {
                                                "example_id": "67e7651c-3c25-4a80-bf74-756ac444e08f",
                                                "sense_id": "ad1d223d-04d0-391e-8bd6-7115c766fe4a",
                                                "text": "Five, he has no idea what else could be out there. For example, if British doctrine was anything like his own, then even at this moment, dozens of British destroyers might be swarming towards him, about to envelop his forces in a maelstrom of torpedoes, and the first thing he'd know about it is when things start exploding! (Well, even more than they already are now.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d976eefb-6afb-4c65-a535-9c47bcaa7d86",
                        "source_entry_id": "0080cf8d-8a72-383f-a50f-505426684e20",
                        "source_sense_id": "1690c912-8f52-328f-96af-6bf62e24c6dd",
                        "source_sense_description": "Ausgleichströmung des Meeres in Norwegen",
                        "target_lang_word": "maelström",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maelström",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cbb4e0d-05e0-3a0d-8d46-c19331482049",
                                        "entry_id": "6976aadd-eff9-30e9-b9e8-634a119ae7d4",
                                        "glosses": [
                                            "Variante de maëlstrom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d12c8369-8bc9-487c-825b-b01a8b517477",
                                                "sense_id": "9cbb4e0d-05e0-3a0d-8d46-c19331482049",
                                                "text": "Paris est un maelström où tout se perd, et tout disparaît dans ce nombril du monde comme dans le nombril de la mer."
                                            },
                                            {
                                                "example_id": "284bd92a-0f7d-4830-8942-69863fe310c9",
                                                "sense_id": "9cbb4e0d-05e0-3a0d-8d46-c19331482049",
                                                "text": "Au milieu de ce maelström des hautes sphères financières, les entreprises font le gros dos."
                                            },
                                            {
                                                "example_id": "b767666a-0f87-4338-9ec1-224e4ade4b65",
                                                "sense_id": "9cbb4e0d-05e0-3a0d-8d46-c19331482049",
                                                "text": "Et, je vous en ai parlé, j’ai l’intention d’écrire un livre sur votre itinéraire au sein du maelström de la gauche et de l’ultragauche : ce sera un document passionnant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
