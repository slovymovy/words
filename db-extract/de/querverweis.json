                "senses": [
                    {
                        "sense_id": "e34f4b3a-65d1-30d2-8b39-e5788b1b1875",
                        "entry_id": "4f2e6835-a0c8-3133-95a0-9542b09806fd",
                        "glosses": [
                            "Bezugnahme auf eine Stelle im gleichen oder einem anderen Werk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db642913-614d-497c-860b-f60b8d28cf1f",
                                "sense_id": "e34f4b3a-65d1-30d2-8b39-e5788b1b1875",
                                "text": "„ In die Anmerkungen gehören Quellenbelege (je nach Zitierweise), Hinweise auf weiterführende Literatur (vgl. dazu…), Querverweise innerhalb der eigenen Arbeit (s. Kap. 1.2.2.) und ergänzende oder vertiefende Informationen und Zitate, die nicht in den unmittelbaren Zusammenhang des Textes passen.“"
                            },
                            {
                                "example_id": "09e17cb2-98cd-4aa2-b821-7e9d7f8037ac",
                                "sense_id": "e34f4b3a-65d1-30d2-8b39-e5788b1b1875",
                                "text": "„Ein Querverweis in einem Klauselwerk oder ein Verweis auf Preislisten führt an sich noch nicht zur Intransparenz im Sinn von § 6 Abs 3 KSchG.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
