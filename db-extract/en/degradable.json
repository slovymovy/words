                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abbaubar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "813860aa-3e87-367e-a871-256ddf7f6675",
                                        "entry_id": "b678a278-d4e3-3173-833a-9fc9a61366dd",
                                        "glosses": [
                                            "zum nochmaligen Abbau oder zur Zerlegung geeignet"
                                        ],
                                        "tags": [
                                            "von Stoffen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a600e472-6939-4569-adbf-e2ca1369d58e",
                                                "sense_id": "813860aa-3e87-367e-a871-256ddf7f6675",
                                                "text": "Kunststoffe erweisen sich als kaum abbaubar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3cddb2ac-3821-3458-b84b-a3c85dd5ccea",
                                        "entry_id": "b678a278-d4e3-3173-833a-9fc9a61366dd",
                                        "glosses": [
                                            "an ihrer Lagerstätte wirtschaftlich gewinnbar"
                                        ],
                                        "tags": [
                                            "von Bodenschätzen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31443abc-171a-46e7-a6c5-d500a618c1cb",
                                                "sense_id": "3cddb2ac-3821-3458-b84b-a3c85dd5ccea",
                                                "text": "Es handelt sich um eine abbaubare Lagerstätte."
                                            },
                                            {
                                                "example_id": "98687b47-891f-41cb-9109-28dafbd5dea2",
                                                "sense_id": "3cddb2ac-3821-3458-b84b-a3c85dd5ccea",
                                                "text": "„Manche Grundmaterialien sind nur noch in Restvorkommen abbaubar.“"
                                            },
                                            {
                                                "example_id": "b67eef23-8529-4d0f-b55b-c61064e37337",
                                                "sense_id": "3cddb2ac-3821-3458-b84b-a3c85dd5ccea",
                                                "text": "„Metallurgische Testarbeiten im Jahre 2007 bestätigten, dass ein hochgradiges Vanadium-Eisen-Konzentrat bei Nutzung üblicher Techniken abbaubar wäre.“"
                                            },
                                            {
                                                "example_id": "bf4c062a-46a8-4c43-9098-fc7daeac4725",
                                                "sense_id": "3cddb2ac-3821-3458-b84b-a3c85dd5ccea",
                                                "text": "„Laut ihrer Studie, welche die Forscher auch dem Deutschen Bundestag vorgelegt haben, seien die bekannten und in wirtschaftlich vertretbarem Rahmen abbaubaren Kohlevorkommen also deutlich kleiner als bislang angenommen.“"
                                            },
                                            {
                                                "example_id": "fa1b9c17-03c2-4774-9eb3-02e50ef0730e",
                                                "sense_id": "3cddb2ac-3821-3458-b84b-a3c85dd5ccea",
                                                "text": "„Leicht abbaubares Öl wird knapp, der Rohstoff wird auf lange Sicht teurer werden.“"
                                            },
                                            {
                                                "example_id": "2a5c86e9-2b1d-46bb-bb72-c9bde91d7c2d",
                                                "sense_id": "3cddb2ac-3821-3458-b84b-a3c85dd5ccea",
                                                "text": "„Bei Kilopreisen zwischen 40 und 80 Dollar pro Kilogramm wären weltweit noch gut 1,2 Millionen Tonnen Uran gesichert und rentabel abbaubar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
