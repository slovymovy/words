                    }
                ],
                "translations": [
                    {
                        "translation_id": "de9a7025-00d8-4a42-9c25-f579ab1abd1a",
                        "source_entry_id": "5d58272a-c649-3f6c-bc9a-48fc0c46024d",
                        "source_sense_id": "5e7e7678-cad4-3ad7-9479-cb9268ad8cfb",
                        "target_lang_word": "enema",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enema",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68b96d9b-e9da-32fc-9436-49b495bcdc56",
                                        "entry_id": "8d4e8064-6448-3d72-82d2-4f81ef99a2f7",
                                        "glosses": [
                                            "An injection of fluid into the large intestine by way of the rectum, usually for medical purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcaf0226-12bd-44cb-87c9-ae95c0917820",
                                                "sense_id": "68b96d9b-e9da-32fc-9436-49b495bcdc56",
                                                "text": "To the distensile enema of simple tepid water, no valid objection can be urged."
                                            },
                                            {
                                                "example_id": "35410d8e-8fcc-4f13-8cff-604123cbfe7d",
                                                "sense_id": "68b96d9b-e9da-32fc-9436-49b495bcdc56",
                                                "text": "[…] It is further neglected by a mental dependence upon cathartics or enemata to produce the stimulation. Defecalgesiophobia is a common cause for neglecting the act."
                                            },
                                            {
                                                "example_id": "5b5b520b-1dc5-48d6-8bc2-203ff106ba94",
                                                "sense_id": "68b96d9b-e9da-32fc-9436-49b495bcdc56",
                                                "text": "Iatrogenic poisoning can result from the use of magnesium in the treatment of hypertension or of toxemia of pregnancy; deaths have been reported from the use of magnesium sulfate enemas in megacolon and from oral administration for purging."
                                            },
                                            {
                                                "example_id": "21942ded-7e54-4b20-b310-b36546d5fb03",
                                                "sense_id": "68b96d9b-e9da-32fc-9436-49b495bcdc56",
                                                "text": "But alcohol enemas are no laughing matter, experts say. […] Using an alcohol enema involves placing a small tube into someone’s rectum and pouring alcohol into the colon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a84f631-7d4b-362b-93ab-80b30574e907",
                                        "entry_id": "8d4e8064-6448-3d72-82d2-4f81ef99a2f7",
                                        "glosses": [
                                            "The fluid so injected."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "670a2d35-5ced-3f4b-bd72-2c58df4003d6",
                                        "entry_id": "8d4e8064-6448-3d72-82d2-4f81ef99a2f7",
                                        "glosses": [
                                            "A device for administering such an injection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "enema",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc4f2ad5-c883-3c45-8024-1323801998e1",
                                        "entry_id": "540b95ab-d070-3e03-8b49-30aed29a3e75",
                                        "glosses": [
                                            "To administer an enema."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "839bdb73-d730-41b7-b823-043c3f88b0f6",
                                                "sense_id": "bc4f2ad5-c883-3c45-8024-1323801998e1",
                                                "text": "It's common to enema before anal sex."
                                            },
                                            {
                                                "example_id": "b8d0f011-53ee-4000-a6fe-82cdc4965db5",
                                                "sense_id": "bc4f2ad5-c883-3c45-8024-1323801998e1",
                                                "text": "It would take simpler souls with little or no training to do the yeoman work of enemaing and puking the sick people of the community."
                                            },
                                            {
                                                "example_id": "c0d820b2-3d9a-4d02-ac38-628d74949771",
                                                "sense_id": "bc4f2ad5-c883-3c45-8024-1323801998e1",
                                                "text": "\"So, there I was, shaved and enemaed, in the labor room with my husband."
                                            },
                                            {
                                                "example_id": "fe13b1f1-23f1-4013-a897-0f20ec0b60c7",
                                                "sense_id": "bc4f2ad5-c883-3c45-8024-1323801998e1",
                                                "text": "I got out of the hospital after my last suicide attempt — the one where I tried to enema myself to death with hot buttered rum"
                                            },
                                            {
                                                "example_id": "f10152ae-e8b9-455a-844d-7aa83624f035",
                                                "sense_id": "bc4f2ad5-c883-3c45-8024-1323801998e1",
                                                "text": "Shower and she enemas herself and I put towels on the bed, which in retrospect weren't enough because her enema spilt over onto the sheets"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "683e5d93-d845-465d-993a-40c7d8e0b57b",
                        "source_entry_id": "5d58272a-c649-3f6c-bc9a-48fc0c46024d",
                        "source_sense_id": "5e7e7678-cad4-3ad7-9479-cb9268ad8cfb",
                        "target_lang_word": "lavement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lavement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fa0dca0-ea00-32c0-80a6-30bdd853482e",
                                        "entry_id": "ee076bb8-fbe1-3fc0-9bf6-243fa19ec84a",
                                        "glosses": [
                                            "Action de laver."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed4dbe8d-a0d4-304e-af67-56c1792d3836",
                                        "entry_id": "ee076bb8-fbe1-3fc0-9bf6-243fa19ec84a",
                                        "glosses": [
                                            "Ancien signe d’hospitalité des peuples d’Orient et devenu acte liturgique dans le langage de l’église."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b55626c-aaf6-4b67-976c-92818a23cac2",
                                                "sense_id": "ed4dbe8d-a0d4-304e-af67-56c1792d3836",
                                                "text": "Le lavement des pieds."
                                            },
                                            {
                                                "example_id": "d95f7b74-f461-4217-9150-07826266b81d",
                                                "sense_id": "ed4dbe8d-a0d4-304e-af67-56c1792d3836",
                                                "text": "Le lavement des mains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc716a23-8714-3df5-b1e9-8535bff00f87",
                                        "entry_id": "ee076bb8-fbe1-3fc0-9bf6-243fa19ec84a",
                                        "glosses": [
                                            "Acte médical qui consiste à introduire un liquide (qui est en suite expulsé ou aspiré) dans une cavité ou une lumière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af008212-5d6c-4dca-b7a1-77391eca5e0f",
                                                "sense_id": "dc716a23-8714-3df5-b1e9-8535bff00f87",
                                                "text": "Lavement intestinal, lavement vaginal, lavement auriculaire, lavement des sinus, etc."
                                            },
                                            {
                                                "example_id": "2cb7ddbe-9b40-444c-ab20-a518cc9fe9ae",
                                                "sense_id": "dc716a23-8714-3df5-b1e9-8535bff00f87",
                                                "text": "Vous l'utiliserez par voie externe, sous forme de lavement vaginal (avec une poire vaginale)."
                                            },
                                            {
                                                "example_id": "4654c02b-4620-445d-a8ca-5f3cacacdbd7",
                                                "sense_id": "dc716a23-8714-3df5-b1e9-8535bff00f87",
                                                "text": "La première chose que j'ai vue dedans, c'est sa poire de lavement nasal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "960fdb5f-fbee-3d18-b5d3-1537a7266c77",
                                        "entry_id": "ee076bb8-fbe1-3fc0-9bf6-243fa19ec84a",
                                        "glosses": [
                                            "Acte médical qui consiste à introduire un liquide (qui est en suite expulsé ou aspiré) dans une cavité ou une lumière.",
                                            "Liquide que l’on introduit par l’anus pour laver les intestins, les soigner ou pour procéder à des examens radiologiques ou visuels. On dit plutôt aujourd’hui « lavage d’intestin », et il peut être alors remplacé par une solution à boire la veille d’un examen comme la coloscopie par exemple."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b49f6ec-6ea4-4f81-b2f6-b433e7eb892e",
                                                "sense_id": "960fdb5f-fbee-3d18-b5d3-1537a7266c77",
                                                "text": "M. Hardwick admet aussi que ni les lavements ni les autres remèdes ne peuvent désengaîner l’intestin, et qu’il n’y a de guérison possible que par l’adhérence des deux séreuses intestinales qui viennent en contact, et l’évacuation de la partie invaginée."
                                            },
                                            {
                                                "example_id": "b7c1ca30-c214-4977-b986-dca17763a542",
                                                "sense_id": "960fdb5f-fbee-3d18-b5d3-1537a7266c77",
                                                "text": "Un jour, à Meyrignac, j’administrai avec une poire en caoutchouc un simulacre de lavement à ma cousine Jeanne dont la souriante passivité incitait au sadisme : je ne retrouve aucun autre souvenir qui s’apparente à celui-ci."
                                            },
                                            {
                                                "example_id": "75ba77c0-fbd9-422e-a25e-71a75cb118b5",
                                                "sense_id": "960fdb5f-fbee-3d18-b5d3-1537a7266c77",
                                                "text": "Le docteur T. déchiffrait mal les clichés communiqués par le docteur D. et on devait le lendemain procéder à une nouvelle radio des intestins : « On me fera un lavement au baryte : c’est douloureux : » me dit maman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bd840b2-f663-378c-8a0f-b52b0ce8d458",
                                        "entry_id": "ee076bb8-fbe1-3fc0-9bf6-243fa19ec84a",
                                        "glosses": [
                                            "Personne ennuyeuse dont la conversation vous vide littéralement."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4c8a6dc-dca4-4357-af20-d481123e3bdf",
                                                "sense_id": "2bd840b2-f663-378c-8a0f-b52b0ce8d458",
