                ],
                "senses": [
                    {
                        "sense_id": "e1101448-2ecf-308a-b56b-128753f7ac50",
                        "entry_id": "994db5d6-4e24-3f57-9fcf-1d001c49b10d",
                        "glosses": [
                            "o ciemnym kolorze skóry"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f58ecf7-6edd-468e-b54a-c3e711bb1916",
                                "sense_id": "e1101448-2ecf-308a-b56b-128753f7ac50",
                                "text": "W kościołach indiańskich Chrystus jest ciemnoskóry, wychudzony, kolana i ramiona otwierają się warstwami w zastygłą ranę"
                            },
                            {
                                "example_id": "eb9403e7-2e8e-4fac-8a1b-3a5774700928",
                                "sense_id": "e1101448-2ecf-308a-b56b-128753f7ac50",
                                "text": "Początkowo sprawa wyglądała na żart gazety i autoreklamę ciemnoskórej, zamieszkałej w Londynie rosyjskiej fotomodelki Angeli Ermakowej"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0eb23f4-5653-445c-8305-b88c8be3a1a9",
                        "source_entry_id": "994db5d6-4e24-3f57-9fcf-1d001c49b10d",
                        "source_sense_id": "e1101448-2ecf-308a-b56b-128753f7ac50",
                        "target_lang_word": "темнокожий",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "темнокожий",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "53f46724-0dba-377d-8d5b-42285df6169f",
                                        "entry_id": "9aaa65c3-6777-3e2c-9320-305aacbbafe4",
                                        "glosses": [
                                            "с кожей темноватого, смуглого цвета"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34b42e39-cfb6-40c4-9ce5-d5852d499d67",
                                                "sense_id": "53f46724-0dba-377d-8d5b-42285df6169f",
                                                "text": "То есть это человек смуглый, темнокожий, но скорее с арабскими, чем с негритянскими чертами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "048f1c24-2cc6-3010-877c-15a6d67c543d",
                                        "entry_id": "9aaa65c3-6777-3e2c-9320-305aacbbafe4",
                                        "glosses": [
                                            ": относящийся к представителям одной из рас или одного из антропологических типов, характеризующихся тёмным цветом кожи (о человеке)"
                                        ],
                                        "tags": [
                                            "только в полной форме"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bd98204-96ae-4864-bcc7-c2e84107943d",
                                                "sense_id": "048f1c24-2cc6-3010-877c-15a6d67c543d",
                                                "text": "Советские антропологи получили богатое наследство, украшенное именами основоположника русской антропологии А. П. Богданова, знаменитого путешественника — исследователя темнокожих народов и борца за их освобождение от колониального рабства Н. Н. Миклухо-Маклая, основателя русской физиологической школы И. М. Сеченова, прославленного биолога и борца за дарвинизм К. А. Тимирязева и многих других."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "темнокожий",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "eca770b2-1f92-3198-9117-8ade311857cb",
                                        "entry_id": "69415952-95b5-36e2-9657-5b3bb2a20bd7",
                                        "glosses": [
                                            "тот, кто имеет кожу смуглого цвета"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c82534fd-565a-435b-a13a-d05ade4d87e1",
                                                "sense_id": "eca770b2-1f92-3198-9117-8ade311857cb",
                                                "text": "Я сказал, что никакой неприязни к темнокожим в моей повести нет."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c26f297a-b1a6-3ca0-abb1-245291dddaf6",
                                        "entry_id": "69415952-95b5-36e2-9657-5b3bb2a20bd7",
                                        "glosses": [
                                            "тот, кто относится к представителям одной из рас или одного из антропологических типов, характеризующихся тёмным цветом кожи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d6d4364-a5b4-48b7-9b2b-f5c9b572f52f",
                                                "sense_id": "c26f297a-b1a6-3ca0-abb1-245291dddaf6",
                                                "text": "А английские буржуи завладали Индией, почти половиной мира, и угнетают всяких чернокожих и темнокожих."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
