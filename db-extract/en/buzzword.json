                                    {
                                        "sense_id": "d271d24b-de42-3942-8bb5-9abed0f072f0",
                                        "entry_id": "acaa3cdc-d3ba-3597-aa59-5c1775a6bdc5",
                                        "glosses": [
                                            "een woord dat een tijd lang in de mode is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "829a8bda-bf6f-4284-8fae-e138c365f076",
                                                "sense_id": "d271d24b-de42-3942-8bb5-9abed0f072f0",
                                                "text": "De DNA-test is het nieuwe modewoord in de wielersport."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf7fc3fb-ffde-43e8-9e54-e3390a7b4cc4",
                        "source_entry_id": "6f30d678-def5-3b43-b66e-bad12ab17dc7",
                        "source_sense_id": "1a8da57d-1469-3a43-ac49-bcce582073f7",
                        "source_sense_description": "word drawn from or imitative of technical jargon",
                        "target_lang_word": "Modewort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Modewort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41941fe2-efe4-3e33-a285-f82f44156aa3",
                                        "entry_id": "803376ef-43f5-3ee5-94c8-f3e48d3b412d",
                                        "glosses": [
                                            "Wort, das zeitweise häufig gebraucht wird, also „in Mode“ ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9fd146c-335e-4c04-a4e2-7367bbcb4520",
                                                "sense_id": "41941fe2-efe4-3e33-a285-f82f44156aa3",
                                                "text": "„Mitunter werden Neologismen auch zu Modewörtern, d.h. Wörtern, die eine Zeit lang sehr häufig benutzt werden, um dann in den allgemeinen Wortschatz überzugehen oder zu verschwinden.“"
                                            },
                                            {
                                                "example_id": "3e6d21c9-c081-4b57-a479-eace15838212",
                                                "sense_id": "41941fe2-efe4-3e33-a285-f82f44156aa3",
                                                "text": "Der Ausdruck Modewort bedeutet vor allem, dass es sich im fraglichen Fall um ein Wort handelt, von dem man glaubt, dass es über kurz oder lang wieder verschwinden wird."
                                            },
                                            {
                                                "example_id": "dcfec7cd-4c4e-4925-8bdd-3be51c4a9f4f",
                                                "sense_id": "41941fe2-efe4-3e33-a285-f82f44156aa3",
                                                "text": "Ein Modewort, das sich als solches herausgestellt hat, ist das Verb „wuppen“: Es bedeutete, dass man sich um etwas kümmern und das damit verbundene Problem lösen müsse, und ist aus dem Sprachgebrauch (völlig?) verschwunden."
                                            },
                                            {
                                                "example_id": "e0f7231b-a038-421b-83c0-89ea6c186dbc",
                                                "sense_id": "41941fe2-efe4-3e33-a285-f82f44156aa3",
                                                "text": "„Fast in jedem Zeitalter gibt es Wörter und Wendungen, die von bestimmten Kreisen, seltener von der ganzen Sprachgemeinschaft eine Zeitlang mit besonderer Vorliebe gebraucht werden und die man deshalb als Modewörter bezeichnet hat.“"
                                            },
                                            {
                                                "example_id": "7b567efc-c242-474a-b521-dcfc8ebdf76f",
                                                "sense_id": "41941fe2-efe4-3e33-a285-f82f44156aa3",
                                                "text": "„Aber erst die Gegenwart hat eine solche Fülle von Modewörtern bereitgestellt, daß man Abhandlungen in Klischees schreiben kann."
                                            },
                                            {
                                                "example_id": "77ced2f1-e3e4-474a-92d1-f047e7db24c6",
                                                "sense_id": "41941fe2-efe4-3e33-a285-f82f44156aa3",
                                                "text": "„Ebenso ausgeprägt ist die beinahe durchgängig zu findende Kritik an der Verwendung sogenannter Modewörter.“"
                                            },
                                            {
                                                "example_id": "317b1c26-917c-4fb6-9e15-25ab2a0245e3",
                                                "sense_id": "41941fe2-efe4-3e33-a285-f82f44156aa3",
                                                "text": "„Sowohl 1940 als auch 1999 sind einige Lexeme nicht anzutreffen, die heute allgemein bekannt sind, oft sogar als Modewörter bezeichnet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5099c161-b6f3-48e4-92e8-82c5e5a24349",
                        "source_entry_id": "6f30d678-def5-3b43-b66e-bad12ab17dc7",
                        "source_sense_id": "1a8da57d-1469-3a43-ac49-bcce582073f7",
                        "source_sense_description": "word drawn from or imitative of technical jargon",
                        "target_lang_word": "sinnentleertes Modewort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "dcf8387a-4d24-4d36-a3e5-5fbd7fdd9e61",
                        "source_entry_id": "6f30d678-def5-3b43-b66e-bad12ab17dc7",
                        "source_sense_id": "1a8da57d-1469-3a43-ac49-bcce582073f7",
                        "source_sense_description": "word drawn from or imitative of technical jargon",
                        "target_lang_word": "Schlagwort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlagwort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64b42749-fdd2-3e62-885c-57d1d6597d1d",
                                        "entry_id": "4f10d456-9d27-3d33-ab36-c1c623781c60",
                                        "glosses": [
                                            "weithin bekannte, griffige Formulierung einer Idee oder Vorstellung, die vor allem in der gesellschaftlichen oder politischen Auseinandersetzung oder auch in der Werbung als programmatisch oder vorbildlich hingestellt werden soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bbd70c0-3583-4a50-8753-67de7fb8ab21",
                                                "sense_id": "64b42749-fdd2-3e62-885c-57d1d6597d1d",
                                                "text": "Die Schlagworte der Französischen Revolution waren „Freiheit, Gleichheit, Brüderlichkeit“."
                                            },
                                            {
                                                "example_id": "c0840907-21cc-4e85-bc4e-68b28bcdd711",
                                                "sense_id": "64b42749-fdd2-3e62-885c-57d1d6597d1d",
                                                "text": "„Bald wiederum ist das Schlagwort eine Augenblicksschöpfung, eine rednerische Entgleisung, ein Witzwort, ein Spitzname, eine kräftige Verwünschung, eine blendende Phrase, bald eine wohlausgesonnene Losung, ein zündendes Programmwort, eine Parteibezeichnung, ein origineller Titel, eine Herausforderung oder Versprechung.“"
                                            },
                                            {
                                                "example_id": "6ce59e38-ff70-44c7-abce-c0232e318f40",
                                                "sense_id": "64b42749-fdd2-3e62-885c-57d1d6597d1d",
                                                "text": "„Eine ähnliche Rolle spielen die Schlagwörter, Ausdrücke, die durch den Beiklang eines bestimmten Gefühlstones mehr bedeuten als die bloße durch sie bezeichnete Vorstellung.“"
                                            },
                                            {
                                                "example_id": "0a324824-0b92-4ca8-a166-05daf77193af",
                                                "sense_id": "64b42749-fdd2-3e62-885c-57d1d6597d1d",
                                                "text": "„Unter Schlagwort werden solche Wörter verstanden, die in einer bestimmten Zeit politische Leitsätze, Losungen und Ziele ausdrücken und oftmals starken Gefühlswert haben.“"
                                            },
                                            {
                                                "example_id": "58e6b862-2cf2-4827-acdc-4ba135edf38f",
                                                "sense_id": "64b42749-fdd2-3e62-885c-57d1d6597d1d",
                                                "text": "„»Diskriminierung« ist das Stichwort, das uns weiterhelfen kann: Mit diesem Schlagwort können wir auf die Hilfe der Medien hoffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "11de68d3-dbf1-3b3f-bf22-3260067568e0",
                                        "entry_id": "4f10d456-9d27-3d33-ab36-c1c623781c60",
                                        "glosses": [
                                            "abgegriffene, formelhafte und daher nicht mehr überzeugende Äußerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56f42839-809c-4e0b-b252-e8d84e1c3bc9",
                                                "sense_id": "11de68d3-dbf1-3b3f-bf22-3260067568e0",
                                                "text": "Er hat nichts Neues mehr zu sagen, stattdessen redet er nur noch in Schlagworten."
                                            },
                                            {
                                                "example_id": "350028b7-56a0-49d1-b5c8-c32a68a87246",
                                                "sense_id": "11de68d3-dbf1-3b3f-bf22-3260067568e0",
                                                "text": "„Aber keines dieser Schlagworte brachte mich weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c611e9c1-7d9d-3145-bb46-b2bf97f335d6",
                                        "entry_id": "4f10d456-9d27-3d33-ab36-c1c623781c60",
                                        "glosses": [
                                            "ein einzelnes, eine Sache charakterisierendes Wort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a41372c9-7abf-47b6-b97f-9e5726f5bb84",
                                                "sense_id": "c611e9c1-7d9d-3145-bb46-b2bf97f335d6",
                                                "text": "In guten Bibliotheken wird die Literatur auch durch Schlagworte erschlossen."
                                            },
                                            {
                                                "example_id": "fa0c9a49-9e98-4fb4-8d49-d9a8faf4e522",
                                                "sense_id": "c611e9c1-7d9d-3145-bb46-b2bf97f335d6",
                                                "text": "„Die folgenden, nach Schlagwörtern alphabetisch geordneten Hinweise gelten für Satz- und Textverarbeitungssysteme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
