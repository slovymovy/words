                                "example_id": "f9366eec-bc37-4ace-823f-7f62ec345c05",
                                "sense_id": "93af5249-65f4-3c14-aa10-ee1a6917a577",
                                "text": "Les communistes furieusement antihitlériens ont cessé de l’être pour devenir antibritanniques puis sont redevenus antihitlériens à partir de juin 1941."
                            },
                            {
                                "example_id": "50fde8d8-b9b7-4c84-8cb0-272669f08521",
                                "sense_id": "93af5249-65f4-3c14-aa10-ee1a6917a577",
                                "text": "La propagande antibritannique des Frères devient alors moins virulente, car trop coûteuse."
                            },
