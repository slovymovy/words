                    },
                    {
                        "translation_id": "389ecdd2-05fa-461d-8f2e-08d92a1b5176",
                        "source_entry_id": "ad3c1848-f303-389c-bd46-6192465541e1",
                        "source_sense_id": "02c6d4f3-6da2-3e44-8854-1cd2a7766b6d",
                        "source_sense_description": "not deviating",
                        "target_lang_word": "indéfectible",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indéfectible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79afe81f-210a-3636-ac1e-0865dc556537",
                                        "entry_id": "91e22d5e-c5ae-3f09-ad89-9e53874b8650",
                                        "glosses": [
                                            "Qui ne peut défaillir, cesser d’être."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46b44bd5-12ab-4a0c-9041-432d53fd9369",
                                                "sense_id": "79afe81f-210a-3636-ac1e-0865dc556537",
                                                "text": "L’Eglise, elle est indéfectible, elle est suradmirable, elle est immense…"
                                            },
                                            {
                                                "example_id": "d5fdd614-b277-4ec9-8f86-43c38ec25618",
                                                "sense_id": "79afe81f-210a-3636-ac1e-0865dc556537",
                                                "text": "En sa qualité d'ami indéfectible, le Grand Mestre se trouve placé sous la sauvegarde personnelle de la reine régente."
                                            },
                                            {
                                                "example_id": "c5aba9c7-d989-4f4b-8aa8-7fb075534d29",
                                                "sense_id": "79afe81f-210a-3636-ac1e-0865dc556537",
                                                "text": "Debout en face de Léna, Preeti noue à son poignet un rakhi, un petit cordon tressé. Selon la tradition, il est considéré comme sacré et matérialise le lien entre elles, désormais indéfectible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "259f78d2-99ce-48c9-963f-06ab7f3a71ad",
                        "source_entry_id": "ad3c1848-f303-389c-bd46-6192465541e1",
                        "source_sense_id": "02c6d4f3-6da2-3e44-8854-1cd2a7766b6d",
                        "source_sense_description": "not deviating",
                        "target_lang_word": "inébranlable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inébranlable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8da523fa-b2ff-3e09-a84e-ebfffab79a52",
                                        "entry_id": "0422b31d-ddc8-3004-b47f-31025a13ba2e",
                                        "glosses": [
                                            "Qui ne peut être ébranlé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c2b8692-71fb-4d63-b071-8f42bf8e05c3",
                                                "sense_id": "8da523fa-b2ff-3e09-a84e-ebfffab79a52",
                                                "text": "Une masse inébranlable."
                                            },
                                            {
                                                "example_id": "f1305b0c-9554-49b3-9a0c-7a7f61c779b6",
                                                "sense_id": "8da523fa-b2ff-3e09-a84e-ebfffab79a52",
                                                "text": "Ce roc demeure inébranlable contre la violence des vagues."
                                            },
                                            {
                                                "example_id": "a34dcfe3-9296-46c4-8d57-b26719a9aa7d",
                                                "sense_id": "8da523fa-b2ff-3e09-a84e-ebfffab79a52",
                                                "text": "Leurs bataillons semblaient inébranlables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bafeb4a9-2648-314c-a657-81da1568245c",
                                        "entry_id": "0422b31d-ddc8-3004-b47f-31025a13ba2e",
                                        "glosses": [
                                            "Qui est constant, ferme, qui ne se laisse pas abattre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d03bb3ed-23c9-4b11-9fa5-bef4be5fb38d",
                                                "sense_id": "bafeb4a9-2648-314c-a657-81da1568245c",
                                                "text": "Mais c'est toujours en vain qu'ils somment les Charitois de chasser leur garnison: leurs menaces armées n'ont pas plus d'effet que leurs menaces écrites : toutes leurs démarches viennent se briser contre une inébranlable résolution."
                                            },
                                            {
                                                "example_id": "ac975d81-0645-4e1f-96b0-d1c21b47a474",
                                                "sense_id": "bafeb4a9-2648-314c-a657-81da1568245c",
                                                "text": "Il peut sembler au premier abord que les capitalistes, […], n’ont pas besoin d’exprimer leur haine des prolétaires ni même de l’éprouver tant leur position présente semble inébranlable et indépassable si on n’accorde pas une importance exagérée au lot inévitable des grèves sporadiques, des émeutes populaires et coups de colère en apparence sans lendemain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48c91227-ca58-37e5-83df-f41c0916b9ab",
                                        "entry_id": "0422b31d-ddc8-3004-b47f-31025a13ba2e",
                                        "glosses": [
                                            "Qu’on ne peut faire changer de dessein, d’opinion, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b95aacd-a2e4-43dd-a2a1-e353f1e70df4",
                                                "sense_id": "48c91227-ca58-37e5-83df-f41c0916b9ab",
                                                "text": "Oui, enfin, je pars avec la conviction très nette et désormais inébranlable de la fausseté absolue et du danger croissant que fait courir à la cause française votre système d'administration."
                                            },
                                            {
                                                "example_id": "0913bf7c-bf4c-4a34-b2a2-a1a33d633c70",
                                                "sense_id": "48c91227-ca58-37e5-83df-f41c0916b9ab",
                                                "text": "Là encore, la maxime populaire est judicieuse : qui veut noyer son chien l'accuse de la rage. Et ce, d'autant plus que dans un monde d’inébranlables convictions, Sarkozy fait figure d’exception en ce qu'il semble faire sienne la profonde et humble idée de Montaigne sur la « branloire perpétuelle » qu'est notre humaine condition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23ba9e0b-cd47-311c-a49b-76449b1d99b5",
                                        "entry_id": "0422b31d-ddc8-3004-b47f-31025a13ba2e",
                                        "glosses": [
                                            "Qui est solidement établi et indiscutable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cc5f4a1-714a-4703-98a1-6ec7ff135488",
                                                "sense_id": "23ba9e0b-cd47-311c-a49b-76449b1d99b5",
                                                "text": "Tout devient inébranlable pour tout ce que l’on résout entièrement selon le mode multiple en accord avec ce qui apparaît."
                                            },
                                            {
                                                "example_id": "1e6a691b-8b90-4bc4-83f0-b4f76fa1d453",
                                                "sense_id": "23ba9e0b-cd47-311c-a49b-76449b1d99b5",
                                                "text": "Fresnel meurt phtisique à trente-neuf ans en 1827, paraissant avoir établi sur des bases inébranlables la théorie ondulatoire de la lumière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
