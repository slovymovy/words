                "senses": [
                    {
                        "sense_id": "d5c426a4-57fe-34c6-99d4-197b539ecc4a",
                        "entry_id": "65b58158-6cff-3490-8e0d-c7a478f3815d",
                        "glosses": [
                            "verdeckt operierender Agent/Ermittler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77f45d7c-3f13-449d-a6aa-c1958e795747",
                                "sense_id": "d5c426a4-57fe-34c6-99d4-197b539ecc4a",
                                "text": "„Er wusste, dass unerfahrene Undercoveragenten häufig den Fehler machten, sich zu abwegige Geschichten auszudenken.“"
                            },
                            {
                                "example_id": "2ed14491-196f-468d-9583-a763813f26ed",
                                "sense_id": "d5c426a4-57fe-34c6-99d4-197b539ecc4a",
                                "text": "„Und im Laufe seiner Doppeltätigkeit als Fotograf und Undercoveragent lernt Baruch Vega viele wichtige Bosse der kolumbianischen Kartelle kennen.“"
                            },
                            {
                                "example_id": "40f13ab5-9b73-4a09-a3cc-56c12f8aa0fc",
                                "sense_id": "d5c426a4-57fe-34c6-99d4-197b539ecc4a",
                                "text": "„›Unserer Einschätzung nach verfügen sie nicht über genügend Undercoveragenten hier, um eine größere Geheimoperation aufzuziehen, und selbst wenn, kann es ihnen nicht gelingen, uns hier in diesem Safe House aufzuspüren.‹“"
                            },
                            {
                                "example_id": "f2e8f8e4-d29e-42c9-a9b1-f52691e8ddda",
                                "sense_id": "d5c426a4-57fe-34c6-99d4-197b539ecc4a",
                                "text": "„‹Wir haben keine Dienststelle in Teheran, und einen inoffiziellen Undercoveragenten will ich wirklich nicht reinschicken.›“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
