                        "examples": [
                            {
                                "example_id": "768169f8-8896-419a-96be-7e32322d63b4",
                                "sense_id": "eca1b23a-b06e-3de1-b192-fc2fb6aa1549",
                                "text": "„Wenn sie abends mit ihrem Bruder im Bett liegt, dürfen sie sich zwei Rollen für sich ausdenken, um die wir dann eine Abenteuererzählung spinnen, die den Tag einfängt und die Nacht willkommen heißt.“"
                            },
                            {
                                "example_id": "73afc49e-27a1-4f64-9b59-29b5bdc87f0b",
                                "sense_id": "eca1b23a-b06e-3de1-b192-fc2fb6aa1549",
                                "text": "„Der in Bombay geborene Literaturnobelpreisträger Kipling (1865-1936) war 1894 mit seiner Sammlung phantastischer Abenteuererzählungen „Das Dschungelbuch“ weltbekannt geworden.“"
                            }
                        ],
