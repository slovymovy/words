{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "df672dd5-56df-3cef-be7e-f4768919f214",
                    "sense_definition": "A woman's shoe with a very high, thin, tapering heel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "footwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She walked carefully across the cobblestones in her black <w>stilettos</w>.",
                            "target_lang_translations": {
                                "cs": "Opatrně kráčela po kočičích hlavách ve svých černých <w>botách na jehlách</w>."
                            }
                        },
                        {
                            "text": "Wearing a pair of sharp <w>stilettos</w> made her feel confident at the gala.",
                            "target_lang_translations": {
                                "cs": "Díky páru ostrých <w>lodiček na jehlovém podpatku</w> se na slavnostním večeru cítila sebejistě."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pair of stilettos",
                        "wear stilettos"
                    ],
                    "target_lang_definitions": {
                        "cs": "Dámská bota s velmi vysokým a tenkým jehlovým podpatkem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bota na jehlách",
                                "target_lang_sense_clarification": "dámská lodička s tenkým podpatkem"
                            },
                            {
                                "target_lang_word": "lodička na jehlovém podpatku",
                                "target_lang_sense_clarification": "dámská obuv"
                            },
                            {
                                "target_lang_word": "jehlový podpatek",
                                "target_lang_sense_clarification": "samotný tenký podpatek (často v metonymickém užití)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdda839b-2c65-3b9f-9895-23ea8d33bc61",
                    "sense_definition": "A small dagger with a narrow, pointed blade primarily used for stabbing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The assassin kept a slender <w>stiletto</w> hidden inside his coat.",
                            "target_lang_translations": {
                                "cs": "Vrah měl uvnitř kabátu schovaný štíhlý <w>stilet</w>."
                            }
                        },
                        {
                            "text": "Museum visitors admired the antique <w>stiletto</w> displayed in the weapons exhibit.",
                            "target_lang_translations": {
                                "cs": "Návštěvníci muzea obdivovali starožitný <w>stilet</w> vystavený v expozici zbraní."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sharp stiletto"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malá dýka s úzkou, špičatou čepelí určená především k bodání."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "stilet",
                                "target_lang_sense_clarification": "úzká bodná dýka"
                            },
                            {
                                "target_lang_word": "bodná dýka",
                                "target_lang_sense_clarification": "chladná zbraň"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f137eea8-4960-3280-b28b-90e392ed3fa5",
                    "sense_definition": "A rapier or similar thrusting sword.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The duelist drew his <w>stiletto</w> swiftly to parry the opponent's strike.",
                            "target_lang_translations": {
                                "cs": "Duelant rychle vytasil svůj <w>rapír</w>, aby vykryl úder protivníka."
                            }
                        },
                        {
                            "text": "He preferred fencing with a lightweight <w>stiletto</w> rather than a heavy sword.",
                            "target_lang_translations": {
                                "cs": "Při šermu dával přednost lehkému <w>kordíku</w> před těžkým mečem."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically to refer to a rapier."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Kord, rapír nebo podobná lehká bodná zbraň."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rapír",
                                "target_lang_sense_clarification": "historická bodná zbraň"
                            },
                            {
                                "target_lang_word": "kordík",
                                "target_lang_sense_clarification": "bodná sečná zbraň"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00bdfabc-fc12-351c-a757-ffb25d8df16b",
                    "sense_definition": "A pointed, sharp-tipped tool resembling a small dagger, such as an awl for piercing holes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor used a small <w>stiletto</w> to pierce neat eyelets in the fabric.",
                            "target_lang_translations": {
                                "cs": "Krejčí použil malé <w>šídlo</w>, aby do látky prorazil úhledná očka."
                            }
                        },
                        {
                            "text": "She punched through the heavy leather strap using a pointed <w>stiletto</w>.",
                            "target_lang_translations": {
                                "cs": "Špičatým <w>bodcem</w> prorazila silný kožený řemínek."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Špičatý nástroj připomínající malou dýku, například šídlo k propichování děr."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šídlo",
                                "target_lang_sense_clarification": "nástroj na propichování děr"
                            },
                            {
                                "target_lang_word": "bodec",
                                "target_lang_sense_clarification": "špičatý nástroj"
                            },
                            {
                                "target_lang_word": "průbojník",
                                "target_lang_sense_clarification": "nástroj na dírky v textilu či kůži"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd41dbd4-143b-3529-9e5b-220ee313f873",
                    "sense_definition": "A beard trimmed into a sharp, narrow, pointed form.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The courtier wore a fashionable <w>stiletto</w> on his chin during the festival.",
                            "target_lang_translations": {
                                "cs": "Dvořan měl během slavnosti na bradě módní <w>špičatý vous</w>."
                            }
                        },
                        {
                            "text": "Portraits from the era often depicted men sporting a sharp <w>stiletto</w>.",
                            "target_lang_translations": {
                                "cs": "Portréty z té doby často zobrazovaly muže s ostrou <w>brádkou do špičky</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bodkin beard",
                        "pique-devant"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historically referred to a sharply pointed beard style."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vousy zastřižené do úzké, ostré špičky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "špičatý vous",
                                "target_lang_sense_clarification": "střih vousů do špičky"
                            },
                            {
                                "target_lang_word": "bradka do špičky",
                                "target_lang_sense_clarification": "střih vousů"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fb69d226-2cd4-37f3-acab-57ac5c59d1b6",
                    "sense_definition": "To stab, attack, or kill someone with a stiletto dagger.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spy feared that rival agents might <w>stiletto</w> him in the dark alley.",
                            "target_lang_translations": {
                                "cs": "Špion se bál, že by ho v temné uličce mohli nepřátelští agenti <w>probodnout stiletem</w>."
                            }
                        },
                        {
                            "text": "He attempted to <w>stiletto</w> the guard before escaping the compound.",
                            "target_lang_translations": {
                                "cs": "Pokusil se strážného <w>ubodat dýkou</w>, než z areálu uprchl."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Bodnout, napadnout nebo zabít někoho stiletem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "probodnout stiletem",
                                "target_lang_sense_clarification": "napadnout dýkou"
                            },
                            {
                                "target_lang_word": "ubodat dýkou",
                                "target_lang_sense_clarification": "zranit či usmrtit bodnou zbraní"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}