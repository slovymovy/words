        "fr-extract.jsonl": [
            {
                "entry_id": "79ba3fe0-45a5-3ef5-ab27-9df36b517273",
                "word": "carafon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "86292fce-e047-4c02-8337-2a16e9edc15e",
                        "entry_id": "79ba3fe0-45a5-3ef5-ab27-9df36b517273",
                        "tags": [
                            "plural"
                        ],
                        "form": "carafons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "da0a99fd-c9c6-3526-8c66-16b474045867",
                        "entry_id": "79ba3fe0-45a5-3ef5-ab27-9df36b517273",
                        "glosses": [
                            "Petite carafe qui contient du vin ou des liqueurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b3cfae4-9b6f-42a7-bfcc-bbab33f43dd8",
                                "sense_id": "da0a99fd-c9c6-3526-8c66-16b474045867",
                                "text": "une bonne mesure d’eau-de-vie dans un carafon"
                            },
                            {
                                "example_id": "386d5207-bc86-4e8e-8f77-de2a882661b4",
                                "sense_id": "da0a99fd-c9c6-3526-8c66-16b474045867",
                                "text": "Deux tasses de café, s’il vous plaît, pour m’sieur et pour moi, et un carafon d’eau-de-vie, mais de la bonne, de la meilleure."
                            },
                            {
                                "example_id": "ee80aa96-6fd3-46fd-bd1e-b96dbe652610",
                                "sense_id": "da0a99fd-c9c6-3526-8c66-16b474045867",
                                "text": "Par bonheur on se battit. Il s’éleva une querelle entre une volaille jaune et une volaille rouge, entre des nouveaux et des anciens de Saint-Cyr, et les carafons se mirent à voler."
                            },
                            {
                                "example_id": "12756e48-25cd-473c-81ec-5b0eb25a7d79",
                                "sense_id": "da0a99fd-c9c6-3526-8c66-16b474045867",
                                "text": "Je marchandais une bête. Bon. On me disait : « Entre donc, on verra ça à table. » J’entrais. Sur la table il y avait le carafon. Et quand je revenais à la maison, ma femme disait : « Tu as encore bu ; tu n’as pas honte ? »"
                            }
                        ]
                    },
                    {
                        "sense_id": "72c2547a-2f49-367e-a901-63280625ceae",
                        "entry_id": "79ba3fe0-45a5-3ef5-ab27-9df36b517273",
                        "glosses": [
                            "Très petite carafe de restaurateur, contenant à peu près le quart d’une bouteille."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f9083aa3-38f7-38df-a612-b876b06431ef",
                        "entry_id": "79ba3fe0-45a5-3ef5-ab27-9df36b517273",
                        "glosses": [
                            "Quantité de vin qu’elle peut contenir."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5d58ae8b-5d04-39ff-a346-3695b0827509",
                        "entry_id": "79ba3fe0-45a5-3ef5-ab27-9df36b517273",
                        "glosses": [
                            "Personnalité, caractère."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "705813e1-725c-4cb2-b381-c201db91429c",
                                "sense_id": "5d58ae8b-5d04-39ff-a346-3695b0827509",
                                "text": "Eh, bien, tu as le même carafon que ton père !"
                            }
                        ]
                    },
                    {
                        "sense_id": "53ea9aa1-ba9b-3ad3-a1ec-a33920483f91",
                        "entry_id": "79ba3fe0-45a5-3ef5-ab27-9df36b517273",
                        "glosses": [
                            "Tête."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "1c59a068-8bd0-42ad-b119-24f9c90b54e7",
                                "sense_id": "53ea9aa1-ba9b-3ad3-a1ec-a33920483f91",
                                "text": "Ce financier (AOC Listrac), se prend sur le carafon un charitable « même si la technique permet d’améliorer les choses, il ne possède pas un grand terroir »."
                            },
                            {
                                "example_id": "35a814d5-bc0a-4067-b0a2-a6627f8ffb66",
                                "sense_id": "53ea9aa1-ba9b-3ad3-a1ec-a33920483f91",
                                "text": "Peut-être qu'il avait goûté aussi de l'asile psychiatrique. … Ça me semblait pas excessif que cette aventure extraordinaire lui ait fêlé le carafon."
                            }
                        ]
                    }
                ],
