                "senses": [
                    {
                        "sense_id": "b1d1e85b-a7c5-3232-968c-d813a6eb4776",
                        "entry_id": "5abfe866-f3f1-342e-8292-e96a2149f99b",
                        "glosses": [
                            "lapta (Russian bat and ball game)"
                        ],
                        "tags": [
                            "no-genitive",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "d5f6cbb0-caad-4df3-9520-07c5f2623381",
                                "sense_id": "b1d1e85b-a7c5-3232-968c-d813a6eb4776",
                                "text": "В лапте́ нужны́: нахо́дчивость, глубо́кое дыха́ние, ве́рность свое́й па́ртии, внима́тельность, изворо́тливость, бы́стрый бег, ме́ткий глаз, твёрдость уда́ра руки́ и ве́чная уве́ренность в том, что тебя́ не победя́т.",
                                "translation": "Aleksandr I. Kuprin",
                                "english": "Aleksandr I. Kuprin"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
