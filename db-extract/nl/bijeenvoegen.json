        "nl-extract.jsonl": [
            {
                "entry_id": "1572b7d6-8456-38ce-9af1-63f106861a9e",
                "word": "bijeenvoegen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6aa0a903-1eaa-3851-86d6-6b9eb3dd96ec",
                        "entry_id": "1572b7d6-8456-38ce-9af1-63f106861a9e",
                        "glosses": [
                            "met elkaar verenigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c53bdbf1-f8f7-441e-8337-4fbd19942dc9",
                                "sense_id": "6aa0a903-1eaa-3851-86d6-6b9eb3dd96ec",
                                "text": "Als we deze beide geschiedschrijvingen bijeenvoegen, zoals de nieuwste historici doen, dan krijgen we de geschiedenis van monarchen en schrijvers, maar niet de geschiedenis van het leven der volkeren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfa95084-131d-4c52-8f48-d8974ca3741f",
                        "source_entry_id": "1572b7d6-8456-38ce-9af1-63f106861a9e",
                        "source_sense_id": "6aa0a903-1eaa-3851-86d6-6b9eb3dd96ec",
                        "source_sense_description": "met elkaar verenigen",
                        "target_lang_word": "put together",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "put together",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24bd7bab-af22-3061-a6fd-8574cc71eba5",
                                        "entry_id": "0ca4d4d2-3bf4-3a9b-b3a8-217411ccf16d",
                                        "glosses": [
                                            "To assemble, construct, build, or formulate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69510c8a-87cc-4c15-8927-aa4ef46fe308",
                                                "sense_id": "24bd7bab-af22-3061-a6fd-8574cc71eba5",
                                                "text": "If you try to put together the model kit yourself, be careful not to break any of the pieces."
                                            },
                                            {
                                                "example_id": "45ef7494-9e58-4136-a365-e4c1b5efdac7",
                                                "sense_id": "24bd7bab-af22-3061-a6fd-8574cc71eba5",
                                                "text": "We'll need to put together a plan if we want to get this project finished."
                                            },
                                            {
                                                "example_id": "59c62534-ef4c-4fd6-a7a7-c741f18289a0",
                                                "sense_id": "24bd7bab-af22-3061-a6fd-8574cc71eba5",
                                                "text": "Alan Pardew's current squad has been put together with a relatively low budget but the resolve and unity within the team is priceless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7933c88e-9e92-3c41-8a39-722d57f24c6c",
                                        "entry_id": "0ca4d4d2-3bf4-3a9b-b3a8-217411ccf16d",
                                        "glosses": [
                                            "To gather one's thoughts and come to conclusions."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edbb45a4-6120-4423-be26-2a7737b2e755",
                                                "sense_id": "7933c88e-9e92-3c41-8a39-722d57f24c6c",
                                                "text": "They were drunk and slow and she was quick to her boot and quick with the blade and she had sliced one across the arm and the other across the cheek before either could put together what was happening."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "put together",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f56b9fe-2410-3199-b635-49b58a3e33cd",
                                        "entry_id": "5ea4c788-9169-3d06-9b44-ced1cd893abd",
                                        "glosses": [
                                            "In total."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "497c615a-a6d7-4ce4-93f0-6243bd4eaedf",
                                                "sense_id": "7f56b9fe-2410-3199-b635-49b58a3e33cd",
                                                "text": "Alaska has more land than Texas and Oklahoma put together."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14ccf035-bdaf-3ed7-93ae-a292f0d021b9",
                                        "entry_id": "5ea4c788-9169-3d06-9b44-ced1cd893abd",
                                        "glosses": [
                                            "Stable and sound psychologically and hence in other respects; competent and responsible."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53127837-6bfc-4a9e-a4da-94ac69f41142",
                                                "sense_id": "14ccf035-bdaf-3ed7-93ae-a292f0d021b9",
                                                "text": "Today, Bessy is still unmarried but she is well put together. She has bought two new cars since the divorce, she now owns her home, two of her children have college degrees, one is certified in medical assisting, […]"
                                            },
                                            {
                                                "example_id": "b79d30d1-c268-4b1e-bbec-447d8ded3848",
                                                "sense_id": "14ccf035-bdaf-3ed7-93ae-a292f0d021b9",
                                                "text": "I had the impression that she is well put together and has good ego-strength. She is aware of her tendency to be overly self-critical, is working on it and making some progress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
