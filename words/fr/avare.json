                },
                {
                    "sense_id": "5bb49942-860c-3964-a998-1c8e55831160",
                    "sense_definition": "Qui dispense quelque chose avec parcimonie ou retenue, qui n'accorde pas facilement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "retenue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur est particulièrement <w>avare</w> de compliments envers ses employés les plus dévoués.",
                            "target_lang_translations": {
                                "en": "The director is particularly <w>stingy</w> with compliments towards his most devoted employees.",
                                "ru": "Директор особенно <w>скуп</w> на похвалу своим самым преданным сотрудникам.",
                                "de": "Der Direktor ist gegenüber seinen treuesten Mitarbeitern besonders <w>geizig</w> mit Komplimenten.",
                                "es": "El director es especialmente <w>avaro</w> de elogios con sus empleados más entregados.",
                                "zh": "经理对最忠心的员工格外<w>吝啬</w>于称赞。"
                            }
                        },
                        {
                            "text": "Ce chercheur renommé reste toujours très <w>avare</w> de son temps.",
                            "target_lang_translations": {
                                "en": "This renowned researcher is always very <w>stingy</w> with his time.",
                                "ru": "Этот известный исследователь всегда очень <w>скуп</w> на своё время.",
                                "de": "Dieser renommierte Forscher ist mit seiner Zeit immer sehr <w>geizig</w>.",
                                "es": "Este renombrado investigador es siempre muy <w>avaro</w> de su tiempo.",
                                "zh": "这位知名研究者对自己的时间总是十分<w>吝啬</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "parcimonieux"
                    ],
                    "antonyms": [
                        "généreux"
                    ],
                    "common_phrases": [
                        "avare de compliments",
                        "avare de paroles",
                        "avare de son temps"
                    ],
                    "target_lang_definitions": {
                        "en": "Giving something sparingly or with restraint, and not granting it readily.",
                        "ru": "Тот, кто отмеряет что-либо скупо и сдержанно, не склонен легко это давать.",
                        "de": "Jemand, der etwas sparsam oder zurückhaltend gibt und es nicht leicht gewährt.",
                        "es": "Que da algo con moderación o reserva y no lo concede con facilidad.",
                        "zh": "对某物给予得很少或有所保留，不轻易给予。"
                    },
                    "translations": {
