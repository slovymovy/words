                "entry_id": "16545f2b-31ec-3a08-b836-48bc8a20993c",
                "word": "courant-jet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "70afebc1-bb81-4f8b-80b8-5a79b6219896",
                        "entry_id": "16545f2b-31ec-3a08-b836-48bc8a20993c",
                        "tags": [
                            "plural"
                        ],
                        "form": "courants-jets"
                    },
                    {
                        "form_id": "d367584d-6812-4298-a46c-5a481da292ad",
                        "entry_id": "16545f2b-31ec-3a08-b836-48bc8a20993c",
                        "tags": [],
                        "form": "courant jet"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d714320-b6d5-350c-b3e7-ebd8196457c4",
                        "entry_id": "16545f2b-31ec-3a08-b836-48bc8a20993c",
                        "glosses": [
                            "courant d’air rapide et confiné que l’on trouve dans l’atmosphère de certaines planètes telles que la Terre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96cf773b-2bc5-46b3-9acb-b8038efaf7d0",
                                "sense_id": "8d714320-b6d5-350c-b3e7-ebd8196457c4",
                                "text": "Après Noël, le courant-jet d’altitude semble descendre plus au sud sur l’Atlantique."
                            },
                            {
                                "example_id": "a98e963f-05a9-4a84-999b-46d67f751838",
                                "sense_id": "8d714320-b6d5-350c-b3e7-ebd8196457c4",
                                "text": "Le courant-jet est un fort vent qui ceinture l’hémisphère Nord, aux latitudes tempérées. Comme on le montre régulièrement dans les bulletins météo, il sépare les masses d’air froides de l’Arctique et les masses d’air chaudes des tropiques."
                            },
                            {
                                "example_id": "4c24fd9f-c218-42a2-b508-c319ceb201ea",
                                "sense_id": "8d714320-b6d5-350c-b3e7-ebd8196457c4",
                                "text": "C’est un phénomène qu’on connaît bien au-dessus des Montagnes rocheuses, aux États-Unis, reprend M. Quinet. Mais il y a peu de chance que ce soit ça au-dessus du Pacifique. Il s’agirait plutôt ici du phénomène des courants-jets."
                            },
                            {
                                "example_id": "0a6442c5-7c75-43ca-ae60-0cee52a24172",
                                "sense_id": "8d714320-b6d5-350c-b3e7-ebd8196457c4",
                                "text": "Cependant, la position et la configuration du courant-jet moyen données par ces cartes sont évidemment, dans bien des cas, assez éloignées des positions et configurations des « jets » mis en évidence dans les situations réelles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45229943-7602-4ea0-abc6-9457aa42830a",
                        "source_entry_id": "16545f2b-31ec-3a08-b836-48bc8a20993c",
                        "source_sense_id": "8d714320-b6d5-350c-b3e7-ebd8196457c4",
                        "target_lang_word": "Jetstream",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jetstream",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "37ba9e37-be3f-3ea7-8993-112e74b0f192",
                                        "entry_id": "3a92b611-42af-3095-a4c3-488acdbfec4f",
                                        "glosses": [
                                            "starke Windströmung im Bereich der oberen Troposphäre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd54761d-976f-4f89-8b65-27e2a29eaee5",
                                                "sense_id": "37ba9e37-be3f-3ea7-8993-112e74b0f192",
                                                "text": "„Die Jetstreams in der oberen Troposphäre bzw. Stratosphäre lassen sich den Forschern zufolge nicht als Quelle erneuerbarer Energien nutzen.“"
                                            },
                                            {
                                                "example_id": "79b933cf-4959-4489-b8d1-4ffc92b959af",
                                                "sense_id": "37ba9e37-be3f-3ea7-8993-112e74b0f192",
                                                "text": "„Die Potsdamer Forscher haben sich auf die Teile des Jetstreams konzentriert, die besonders schnell ziehen und ungefähr im Wochenrhythmus abwechselnd dominante Hoch- und Tiefdruckgebiete über Europa schieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
