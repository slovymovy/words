                        "entry_id": "49b356cd-d478-3a9e-9051-db1770e395f3",
                        "glosses": [
                            "Any member of the family Anhingidae, waterbirds with long necks."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c1d6845-7c97-4da8-8161-5d4c5c0c4500",
                                "sense_id": "5819df69-dba6-389f-9a5b-ccea17733cfe",
                                "text": "Aquatic birds of various kinds are very numerous, such as geese, darters (Flotus melanogaster), scissor-bills (Rhynchops nigra), adjutants (Leptoptilos argala), pelicans, cormorants, cranes (Grus antigone, in Burmese gyoja), whimbrels, plovers, and ibises."
                            },
                            {
                                "example_id": "9c4956bc-c355-4c6e-be68-05d9ceaf781a",
                                "sense_id": "5819df69-dba6-389f-9a5b-ccea17733cfe",
