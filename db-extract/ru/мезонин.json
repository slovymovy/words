                "senses": [
                    {
                        "sense_id": "66f238c6-8c48-334b-8723-61fba7904370",
                        "entry_id": "89406e56-fd7a-31f1-8b69-b7c5b1c05395",
                        "glosses": [
                            "истор. надстройка над срединной частью дома, часто имеет балкон"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd83003e-5f84-4911-a1a9-24840273d6c7",
                                "sense_id": "66f238c6-8c48-334b-8723-61fba7904370",
                                "text": "Нас поселили в бане, а мезонин, застеклённую веранду и беседку уже заняли более многочисленные читатели воронежской и ставропольской читален."
                            }
                        ]
                    },
                    {
                        "sense_id": "48965ea3-b078-3ba8-965f-f5b8cd4e1818",
                        "entry_id": "89406e56-fd7a-31f1-8b69-b7c5b1c05395",
                        "glosses": [
                            "антресольный этаж"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c960237c-b0a9-4e38-9ec5-06db8f6effc6",
                        "source_entry_id": "89406e56-fd7a-31f1-8b69-b7c5b1c05395",
                        "source_sense_description": "надстройка над срединной частью дома",
                        "target_lang_word": "attic storey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d6386af8-fe1b-4297-a591-a3695cb1deb8",
                        "source_entry_id": "89406e56-fd7a-31f1-8b69-b7c5b1c05395",
                        "source_sense_description": "антресольный этаж",
                        "target_lang_word": "mezzanine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mezzanine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1efd731-7172-3033-be28-5c5084347050",
                                        "entry_id": "d3941c5b-7430-3c54-ad2b-d694b27b9487",
                                        "glosses": [
                                            "An intermediate floor or storey in between the main floors of a building; specifically, one that is directly above the ground floor which does not extend over the whole floorspace of the building, and so resembles a large balcony overlooking the ground floor; an entresol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79615205-c5ed-4910-8773-cf2b08b0a87d",
                                                "sense_id": "d1efd731-7172-3033-be28-5c5084347050",
                                                "text": "On our way to the top floor, we stopped at the mezzanine."
                                            },
                                            {
                                                "example_id": "90d09dd4-277a-4f54-b191-518534d576c5",
                                                "sense_id": "d1efd731-7172-3033-be28-5c5084347050",
                                                "text": "[W]ater closet on mezzanine provided with opaque singlepane oblong window, tipup seat, bracket lamp, brass tierod brace, armrests, footstool and artistic oleograph on inner face of door: […]"
                                            },
                                            {
                                                "example_id": "6da118b2-ba30-4612-9517-0f2458226cda",
                                                "sense_id": "d1efd731-7172-3033-be28-5c5084347050",
                                                "text": "In these sheds, individual products rest on short racks, so they can be reached more easily by employees who pick and box orders. In order to fit more racks, companies put in several mezzanine levels. As a result, the sheds rise taller: 21 metres, compared to B2B’s 15 metres."
                                            },
                                            {
                                                "example_id": "5ddb63de-edcc-46d6-80a4-de83c98f0590",
                                                "sense_id": "d1efd731-7172-3033-be28-5c5084347050",
                                                "text": "On arrival at Birmingham New Street, I make my way upstairs to the mezzanine to get shots of an almost deserted concourse, polka-dotted with social distancing circles like some strange board-game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88da8686-d6c4-31d4-ab5f-25b0697dabb4",
                                        "entry_id": "d3941c5b-7430-3c54-ad2b-d694b27b9487",
                                        "glosses": [
                                            "An apartment, room, etc., on such an intermediate floor."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e752e9fe-40e4-3bc5-8cac-5b3f898f3282",
                                        "entry_id": "d3941c5b-7430-3c54-ad2b-d694b27b9487",
                                        "glosses": [
                                            "The lowest balcony in an auditorium, cinema, theatre, etc.; the dress circle."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72ae3fb8-548f-3dc5-a3b0-6d211faa2fa1",
                                        "entry_id": "d3941c5b-7430-3c54-ad2b-d694b27b9487",
                                        "glosses": [
                                            "Additional flooring laid over a floor to bring it up to some height or level."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e15ca32a-fe4c-3f5d-910b-2a38ab334d4e",
                                        "entry_id": "d3941c5b-7430-3c54-ad2b-d694b27b9487",
                                        "glosses": [
                                            "In full mezzanine window: a small window at the height of a mezzanine floor (sense 1.1) or an attic, used to light these floors."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9bb3d6fc-7b7e-3ee4-bae0-86a6f2c35994",
                                        "entry_id": "d3941c5b-7430-3c54-ad2b-d694b27b9487",
                                        "glosses": [
                                            "A floor under the stage, from which contrivances such as traps are worked."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mezzanine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9064170-99f1-3eb5-a93d-9d201b11239b",
                                        "entry_id": "ba017224-16aa-3150-9670-1b51c5e9fe53",
                                        "glosses": [
                                            "Characteristic of or relating to high-interest loans which have no collateral, and are regarded as intermediate in nature, ranking above equity but below secured loans."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf99e356-d172-41fb-97a6-eb12a257f5e4",
                                                "sense_id": "f9064170-99f1-3eb5-a93d-9d201b11239b",
                                                "text": "This new vehicle funded the purchases of these tranches by issuing fixed-income interests to investors who were seeking high returns and who were willing to believe that by repackaging mezzanine tranches in MBS structures, some tranches could be designated as safe enough to obtain a AAA or AA rating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a001e9ab-bece-3020-ba51-64de7da47b02",
                                        "entry_id": "ba017224-16aa-3150-9670-1b51c5e9fe53",
                                        "glosses": [
                                            "Fulfilling an intermediate or secondary function."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "680a7310-80b3-423c-a5da-b2b13a810eb0",
                                                "sense_id": "a001e9ab-bece-3020-ba51-64de7da47b02",
                                                "text": "To make interconnections easier, we added a mezzanine PCB."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mezzanine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52f661d4-984e-3996-ba32-8d56ba90ee64",
                                        "entry_id": "8a7f0e46-a290-3ab8-b3d4-4a3563bdf197",
                                        "glosses": [
                                            "To fit (a building or other place) with a mezzanine floor."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89f79897-87c9-4335-94a3-35c848aef006",
                        "source_entry_id": "89406e56-fd7a-31f1-8b69-b7c5b1c05395",
                        "source_sense_description": "антресольный этаж",
                        "target_lang_word": "entresol",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entresol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e57aea9-63ae-37ae-ae8a-e4004e76d7e6",
                                        "entry_id": "273fa299-090b-3115-9c6d-79151928b87b",
                                        "glosses": [
                                            "A mezzanine; an intermediate floor in a building, typically resembling a balcony; most often, the floor immediately above the ground floor and below a higher floor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8fdbb0d-33cd-43a6-a42f-99cbbdae2612",
                                                "sense_id": "1e57aea9-63ae-37ae-ae8a-e4004e76d7e6",
                                                "text": "The late lord in autumn filled Castlewood with company, who drank claret till midnight: the present man buries himself in a hut on a Scotch mountain, and passes November in two or three closets in an entresol at Paris, where his amusements are a dinner at a cafe and a box at a little theatre."
                                            },
                                            {
                                                "example_id": "dc274b12-5028-439f-ad5f-372aa8475973",
                                                "sense_id": "1e57aea9-63ae-37ae-ae8a-e4004e76d7e6",
                                                "text": "This idea, however, was luckily all before him again from the moment he crossed the threshold of the little entresol of the Quartier Marbœuf into which she had gathered, as she said, picking them up in a thousand flights and funny little passionate pounces, the makings of a final nest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
