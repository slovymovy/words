                    {
                        "sense_id": "42ee108e-2ca2-350d-b659-6efa93f18f37",
                        "entry_id": "66228909-2f71-3962-b75c-5e14e60c8914",
                        "glosses": [
                            "Wein, der im Italien der römischen Antike (Kampanien) angebaut und produziert wurde"
                        ],
                        "tags": [
                            "römische Antike"
                        ],
                        "examples": [
                            {
                                "example_id": "047f2ac4-2c33-478c-87c9-645a8979a2a4",
                                "sense_id": "42ee108e-2ca2-350d-b659-6efa93f18f37",
                                "text": "„Hier gedeihen auch die edelsten Weine Italiens (Massiker, Falerner).“"
                            },
                            {
                                "example_id": "0ff68113-cd6b-415b-9a3a-bf86a330f9f6",
                                "sense_id": "42ee108e-2ca2-350d-b659-6efa93f18f37",
                                "text": "„Die große Region an der malerischen Westküste rund um Neapel war bereits im antiken Rom für feine Weine hoch geschätzt. Namen wie Massiker, Surrentiner und vor allem Falerner tauchen in der antiken Literatur immer wieder auf und wurden in den höchsten Tönen gepriesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
