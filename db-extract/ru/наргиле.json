                                        "sense_id": "ad4ab993-56d0-31b1-972f-24c9c8bd6437",
                                        "entry_id": "b8e686da-b420-3ee5-98f0-79e79ecd9de5",
                                        "glosses": [
                                            "fajka wodna popularna na muzułmańskim Wschodzie"
                                        ],
                                        "tags": [],
