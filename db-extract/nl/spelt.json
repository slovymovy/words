                "senses": [
                    {
                        "sense_id": "e9b23ffc-19b0-3c9a-9e9a-29028dfc4bb6",
                        "entry_id": "5118714c-5f91-3a2f-8736-80b267b926ca",
                        "glosses": [
                            "grove tarwesoort Triticum spelta"
                        ],
                        "tags": [
                            "wikidata: spelt"
                        ],
                        "examples": [
                            {
                                "example_id": "edb907b4-92a9-4793-89f5-91bde26f8b74",
                                "sense_id": "e9b23ffc-19b0-3c9a-9e9a-29028dfc4bb6",
                                "text": "Van spelt evenwel hoort ge zelden of nooit spreken; de naam is wel bekend bij de natuurvrienden door flora's en lectuur; maar gezien, behalve dan op een plaatje, is de spelt maar door weinigen; en dan nog meest in het buitenland."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2354c23-9766-3d56-a95c-fb1c7ed9f534",
                        "entry_id": "5118714c-5f91-3a2f-8736-80b267b926ca",
                        "glosses": [
                            "bepaald gewas Triticum spelta dat door boeren wordt verbouwd"
                        ],
                        "tags": [
                            "graan"
                        ],
                        "examples": [
                            {
                                "example_id": "d95105fc-2ab3-40a4-9408-89a649332030",
                                "sense_id": "f2354c23-9766-3d56-a95c-fb1c7ed9f534",
                                "text": "Op hun zeven akkers verbouwen ze tarwe, gerst en spelt."
                            }
                        ]
                    },
                    {
                        "sense_id": "b437c409-9f37-30ad-961d-bc9aa3e4f0ff",
                        "entry_id": "5118714c-5f91-3a2f-8736-80b267b926ca",
                        "glosses": [
                            "zaden van Triticum spelta gebruikt voor het maken van gerechten, brood en gebak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86e1d16b-a223-4805-aa1f-5783d9e20557",
                                "sense_id": "b437c409-9f37-30ad-961d-bc9aa3e4f0ff",
                                "text": "Spoel de spelt goed af. Doe hem in een pan, schenk er water bij tot hij onderstaat en breng het water aan de kook. Laat de spelt ongeveer twintig minuten sudderen, tot hij beetgaar is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
