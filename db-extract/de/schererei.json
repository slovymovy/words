                                        "entry_id": "9db61fa6-298b-3233-979a-3f5b9233c3d0",
                                        "glosses": [
                                            "Trouble, bother, unwanted annoyances or problems."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2bc05a8-64b8-4d94-b636-79232dc176a3",
                                                "sense_id": "d68de153-2e7d-3d9b-8728-97aa1375d0a3",
                                                "text": "I went through a lot of hassle to be the first to get a ticket."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec29faf2-8ce1-3baa-9719-103714143efe",
                                        "entry_id": "9db61fa6-298b-3233-979a-3f5b9233c3d0",
                                        "glosses": [
                                            "A fight or argument."
                                        ],
                                        "tags": [
