                "senses": [
                    {
                        "sense_id": "61933c8f-aa81-3240-9803-924594125119",
                        "entry_id": "81e2308a-8b65-3b20-a9ea-b1a461c9ea43",
                        "glosses": [
                            "Personne qui fait preuve d’euroscepticisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22920597-c7c1-4416-96b7-968b53f32741",
                                "sense_id": "61933c8f-aa81-3240-9803-924594125119",
                                "text": "Le « non » a été fêté par tous les eurosceptiques britanniques."
                            },
                            {
                                "example_id": "e406090c-01a7-40b1-874d-48dbc6bbd0b4",
                                "sense_id": "61933c8f-aa81-3240-9803-924594125119",
                                "text": "Naturellement, les eurosceptiques les plus pervers apprécient le traité de Nice : n’est-il pas une assurance rêvée contre l’Europe ?"
                            },
                            {
                                "example_id": "9c5f1794-2578-48d2-82a4-0343bf8c658f",
                                "sense_id": "61933c8f-aa81-3240-9803-924594125119",
                                "text": "Mais, même si Jupiter, en martelant le contraire, ne s’embarrasse pas de ce genre de pudeurs, la plus que probable coalition forcée d’Angela Merkel avec les eurosceptiques du FDP va forcément refroidir les ardeurs du refondateur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17963c59-c356-4a48-a465-79f914d4d263",
                        "source_entry_id": "81e2308a-8b65-3b20-a9ea-b1a461c9ea43",
                        "source_sense_id": "61933c8f-aa81-3240-9803-924594125119",
                        "target_lang_word": "Euroskeptiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
