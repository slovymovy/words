                                            {
                                                "example_id": "cd2438d9-d737-4cb4-8ebd-9c68f48ba1b5",
                                                "sense_id": "fd16c183-802f-3d07-a506-56a735694a6a",
                                                "text": "Si l’élection avait lieu aujourd’hui dans Marie-Victorin, il est impossible de déterminer qui sortirait vainqueur au terme de la bataille dans ce château fort péquiste."
                                            },
                                            {
                                                "example_id": "df16edfe-be04-4215-87e6-7de30a06e055",
                                                "sense_id": "fd16c183-802f-3d07-a506-56a735694a6a",
