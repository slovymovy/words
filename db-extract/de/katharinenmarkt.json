                "senses": [
                    {
                        "sense_id": "978cc9ea-dc1f-3d72-b71f-b358e026b597",
                        "entry_id": "1583d677-5c1d-3337-9688-ce8af1d2595c",
                        "glosses": [
                            "ein am oder um den Katharinentag, dem Gedenktag der Heiligen Katharina, dem 25. November, abgehaltener Markt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bc7761d-7144-4cb5-b951-0b7f5d065361",
                                "sense_id": "978cc9ea-dc1f-3d72-b71f-b358e026b597",
                                "text": "„Am Wochenende haben die Seelbacher und dazu wieder viele Tausend Besucher aus der Region gefeiert: Es war Katharinenmarkt, der inoffizielle Feiertag der Seelbacher!“"
                            },
                            {
                                "example_id": "07585733-1a5e-4d86-ab9e-cbccf705840a",
                                "sense_id": "978cc9ea-dc1f-3d72-b71f-b358e026b597",
                                "text": "„Ein besonderes Augenmerk habe man dann auf den Steinauer Katharinenmarkt gelegt, um möglichen Racheakten entgegenzuwirken, was auch gelungen sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
