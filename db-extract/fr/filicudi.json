                        "glosses": [
                            "Île de la mer Tyrrhénienne faisant partie de l'archipel des îles Éoliennes, au nord de la Sicile."
                        ],
                        "tags": [
                            "Îles"
                        ],
                        "examples": [
                            {
                                "example_id": "035f5356-af59-4f46-bce1-98505506a9a0",
                                "sense_id": "bf8535f7-c0fb-33b8-b9c6-bd3ec8ab8a22",
                                "text": "Elle avait longé longtemps la côte africaine, puis des îles étaient apparues à bâbord : la delle Saline, la Filicudi."
                            },
                            {
                                "example_id": "10dddc44-f8c4-47b3-b279-dd92697a3775",
                                "sense_id": "bf8535f7-c0fb-33b8-b9c6-bd3ec8ab8a22",
                                "text": "Filicudi est une des îles éoliennes les plus sauvages, remarquable pour ses vestiges du néolithique et ses réserves naturelles."
                            },
                            {
                                "example_id": "d024e4ec-3114-4d7b-b528-66e0bf90ed9f",
                                "sense_id": "bf8535f7-c0fb-33b8-b9c6-bd3ec8ab8a22",
                                "text": "Minicroisières aux îles Éoliennes, départ de Milazzo et débarquement à Vulcano, Lipari, Stromboli, Filicudi, Alicudi, Panarea, Salina."
                            }
                        ]
                    }
