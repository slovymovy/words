                    }
                ],
                "senses": [
                    {
                        "sense_id": "ddd2c957-c4a6-3637-8a17-ba9afa95f5ad",
                        "entry_id": "6943abc6-513d-3fc3-8018-2adf574ebdd9",
                        "glosses": [
                            "Personne ayant les symptômes de la cyclothymie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acaaa9ae-3f14-4edd-9fa6-a520942f0ae7",
                                "sense_id": "ddd2c957-c4a6-3637-8a17-ba9afa95f5ad",
                                "text": "Je l’ai déjà indiqué ; un cyclothymique est soigné d’habitude par son médecin habituel ; plus rarement il va consulter un médecin neurologique, et ce n’est qu’exceptionnellement qu’il s’adresse à un psychiatre."
                            },
                            {
                                "example_id": "721995d9-1eae-438e-8d36-6fe47fe164e1",
                                "sense_id": "ddd2c957-c4a6-3637-8a17-ba9afa95f5ad",
                                "text": "[…]; sa mère est une cyclothymique avérée passant, sans motifs apparents, d’un sentiment profond d’ennui à celui d’une gaîté plus ou moins exubérante."
                            }
                        ]
                    }
                ],
