                                    {
                                        "sense_id": "8ea4d297-2492-3a23-8699-a7f9b3e66be1",
                                        "entry_id": "b3ca3007-0bdc-3092-9357-3b88b5bdace0",
                                        "glosses": [
                                            "Lying flat, face-down."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c388da2-0647-4b9f-a997-71ba6c799683",
                                                "sense_id": "8ea4d297-2492-3a23-8699-a7f9b3e66be1",
                                                "text": "Prostrate fall / Before him reverent, and there confess / Humbly our faults."
                                            },
                                            {
                                                "example_id": "c7579552-1ec3-461d-9b6d-2bda7fe59515",
                                                "sense_id": "8ea4d297-2492-3a23-8699-a7f9b3e66be1",
                                                "text": "Finally almost the whole world was combined against the evil-doers, who are now prostrate before us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f124ea72-dbc5-39a6-9423-c73b3131b738",
                                        "entry_id": "b3ca3007-0bdc-3092-9357-3b88b5bdace0",
                                        "glosses": [
                                            "Emotionally devastated."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47013da3-de40-3858-ad2f-ac75682232f8",
                                        "entry_id": "b3ca3007-0bdc-3092-9357-3b88b5bdace0",
                                        "glosses": [
                                            "Physically incapacitated from environmental exposure or debilitating disease."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "632ee869-a4e0-45b2-b69b-24ff23079380",
                                                "sense_id": "47013da3-de40-3858-ad2f-ac75682232f8",
                                                "text": "He was prostrate from the extreme heat."
                                            }
                                        ]
                                    },
