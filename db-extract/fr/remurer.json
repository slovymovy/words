                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3f688c4-7317-4b68-8b85-701782ddf589",
                                "sense_id": "07cdd828-8801-3e4e-b3be-22bf05da16ca",
                                "text": "Élisabeth, qui ne voulait pas renouveler la mémoire de ce forfait, fit remurer la porte et défendit de parler jamais de la découverte qu'on venait de faire."
                            },
                            {
                                "example_id": "e9185789-00bf-4a86-8374-98a6a502f800",
                                "sense_id": "07cdd828-8801-3e4e-b3be-22bf05da16ca",
                                "text": "« Rien, je pensais à Gavryl », laisse-t-il tomber avant de se remurer dans son silence."
                            }
                        ]
                    }
