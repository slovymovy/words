                ],
                "senses": [
                    {
                        "sense_id": "f67b32dd-6374-32da-bc74-cc43ed1a7238",
                        "entry_id": "ca0c662b-4a5a-3e0e-b588-0a6b7803dfef",
                        "glosses": [
                            "längere Zeit andauernder Trockenheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab181b67-2944-446d-80ca-f173232972d0",
                                "sense_id": "f67b32dd-6374-32da-bc74-cc43ed1a7238",
                                "text": "„Das somalische Volk leidet derzeit nicht nur unter einer sehr harten Dürreperiode.“"
                            },
                            {
                                "example_id": "9e8522e3-5873-48d1-a4c8-6f9fa92cb226",
                                "sense_id": "f67b32dd-6374-32da-bc74-cc43ed1a7238",
                                "text": "„Seit knapp sechs Jahren leidet Australien unter einer Dürreperiode, die als schlimmste in der Geschichte gilt.“"
                            },
                            {
                                "example_id": "0fc6e09a-3f56-44fd-a8f6-e7c98ad72685",
                                "sense_id": "f67b32dd-6374-32da-bc74-cc43ed1a7238",
                                "text": "„Als Mugabe geboren wurde, betrieben die Bewohner des Landes bereits seit Jahrhunderten eine gemischte Wirtschaft aus Anbau und Viehzucht. So konnten sie Dürreperioden überbrücken, wenn die Ernte unzureichend war oder ganz ausfiel, zumal man die Tierherden im Notfall auf entferntere, besser bewässerte Weiden treiben konnte.“"
                            },
                            {
                                "example_id": "b94d78d5-3baa-411e-b6d5-a5a220f423a7",
                                "sense_id": "f67b32dd-6374-32da-bc74-cc43ed1a7238",
                                "text": "„Afghanistan wird häufig von lang anhaltenden Dürreperioden und Hungersnöten heimgesucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
