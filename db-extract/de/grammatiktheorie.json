                    {
                        "sense_id": "d43e1a2f-5727-30e7-92b6-89b68a5aed4f",
                        "entry_id": "51f63ed2-9b2c-3e0f-adbd-f1cdd1092d85",
                        "glosses": [
                            "auf bestimmten Vorannahmen beruhendes Konzept zur Entwicklung einer Grammatik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6a91f43-2c47-45c3-8dd8-b4320e627099",
                                "sense_id": "d43e1a2f-5727-30e7-92b6-89b68a5aed4f",
                                "text": "„Der Spracherwerb von Kindern ist bekanntlich ein wichtiger Prüfstein für den explanativen Gehalt einer jeden Grammatiktheorie.“"
                            },
                            {
                                "example_id": "1e5ee1a5-99d3-43c1-91b4-74b4a3326f6b",
                                "sense_id": "d43e1a2f-5727-30e7-92b6-89b68a5aed4f",
                                "text": "„Wenngleich es schon länger her war, daß er sich mit Grammatiktheorie beschäftigt hatte, waren ihm die Schwierigkeiten der einzelnen Vorschläge doch noch geläufig, und zweimal glückten ihm Einwände, welche die anderen überraschten und beeindruckten, so daß selbst Millar die Brauen hob und widerwillig nickte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
