                "translations": [
                    {
                        "translation_id": "29324bce-50ef-4559-844d-7efbdb2ea6c3",
                        "source_entry_id": "0fc62bf5-1a7e-3dd8-97ac-c4a28655de9b",
                        "source_sense_id": "fe0433b5-d4aa-3ef5-bab5-36c5f23aecbd",
                        "target_lang_word": "reproduction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reproduction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccd2a9be-cf33-36f7-b4f4-f7617ef449d5",
                                        "entry_id": "19145655-2a1d-39a4-850e-f76eaf19220b",
                                        "glosses": [
                                            "The act of reproducing new individuals biologically."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2d0ad7b-44e8-4115-bb4c-e3b621614b9c",
                                                "sense_id": "ccd2a9be-cf33-36f7-b4f4-f7617ef449d5",
                                                "text": "Many genes with reproductive roles also have antibacterial and immune functions, which indicate that the threat of microbial attack on the sperm or egg may be a major influence on rapid evolution during reproduction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00f4bd42-a2ef-38d3-95ed-121fd097e566",
                                        "entry_id": "19145655-2a1d-39a4-850e-f76eaf19220b",
                                        "glosses": [
                                            "The act of making copies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae883699-3fb8-464c-932b-2c025835ada0",
                                                "sense_id": "00f4bd42-a2ef-38d3-95ed-121fd097e566",
                                                "text": "Unauthorized reproduction of this article is prohibited."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d4af2a3-2fc3-399f-b7d4-c141ddcda236",
                                        "entry_id": "19145655-2a1d-39a4-850e-f76eaf19220b",
                                        "glosses": [
                                            "A copy of something, as in a piece of art; a duplicate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "812f2049-a191-4ff7-acdf-eac7d76fd67e",
                                                "sense_id": "5d4af2a3-2fc3-399f-b7d4-c141ddcda236",
                                                "text": "Jim was proud of the Rembrandt reproduction he owned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfe2b41f-7e79-3d27-a270-963ce4e04ef0",
                                        "entry_id": "19145655-2a1d-39a4-850e-f76eaf19220b",
                                        "glosses": [
                                            "A method for reproducing a bug or problem."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca9ae5a8-3e56-40ea-add1-922400c65da9",
                                                "sense_id": "bfe2b41f-7e79-3d27-a270-963ce4e04ef0",
                                                "text": "Could you file a bug at on the issue tracker with a minimum reproduction so that we can investigate?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca4705ae-474d-46f5-aee2-efdf78e38e3a",
                        "source_entry_id": "0fc62bf5-1a7e-3dd8-97ac-c4a28655de9b",
                        "source_sense_id": "fe0433b5-d4aa-3ef5-bab5-36c5f23aecbd",
                        "target_lang_word": "Vermehrung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vermehrung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c9103bc-72ca-357f-9fbe-1bbef4984cc8",
                                        "entry_id": "153da013-1c74-3b47-9a79-8d8199b6fc8e",
                                        "glosses": [
                                            "Wachstum, die Erzeugung von Identischem aus Vorhandenem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa17ff25-e65b-4a9e-bb13-e9dcb7a28683",
                                                "sense_id": "5c9103bc-72ca-357f-9fbe-1bbef4984cc8",
                                                "text": "Die Vermehrung des Eigenkapitals ist oberstes Gebot."
                                            },
                                            {
                                                "example_id": "ba606496-ed3f-46a0-9d88-c3756a14642b",
                                                "sense_id": "5c9103bc-72ca-357f-9fbe-1bbef4984cc8",
                                                "text": "Leider hat die Entscheidung des Gerichts zu einer Vermehrung des Leides bei den Betroffenen geführt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "df056277-6e4f-330c-895d-8dd5bd9b909a",
                                        "entry_id": "153da013-1c74-3b47-9a79-8d8199b6fc8e",
                                        "glosses": [
                                            "Fortpflanzung der Lebewesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d9920fc-176c-43d1-b8b1-210468fe5c7f",
                                                "sense_id": "df056277-6e4f-330c-895d-8dd5bd9b909a",
                                                "text": "In der Biologie unterscheidet man zwischen ungeschlechtlicher Vermehrung und geschlechtlicher Fortpflanzung."
                                            },
                                            {
                                                "example_id": "baf05eac-597a-49fd-b0d1-10f9ba17d43b",
                                                "sense_id": "df056277-6e4f-330c-895d-8dd5bd9b909a",
                                                "text": "Die vegetative und generative Vermehrung von Pflanzen, ist das Ziel vieler Gärtner."
                                            },
                                            {
                                                "example_id": "90fb8ee6-6228-4303-b92b-ecb430932d41",
                                                "sense_id": "df056277-6e4f-330c-895d-8dd5bd9b909a",
                                                "text": "Die Vermehrung von Kaninchen ist sehr einfach."
                                            },
                                            {
                                                "example_id": "b72c5a44-80fc-4222-ab1d-f57160810b5f",
                                                "sense_id": "df056277-6e4f-330c-895d-8dd5bd9b909a",
                                                "text": "„Fest steht nun jedoch, dass die Vermehrung der Menschheit durch den Vorstoß ins All nicht gehemmt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
