        "fr-extract.jsonl": [
            {
                "entry_id": "d11fe0b3-0a3a-3b8a-bd7e-0c084438a29b",
                "word": "polyneuropathie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c064f6e4-9673-4e72-bcf9-15a582c0406c",
                        "entry_id": "d11fe0b3-0a3a-3b8a-bd7e-0c084438a29b",
                        "tags": [
                            "plural"
                        ],
                        "form": "polyneuropathies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d6668609-eedb-3747-8a1b-078e53178c16",
                        "entry_id": "d11fe0b3-0a3a-3b8a-bd7e-0c084438a29b",
                        "glosses": [
                            "Atteinte d’une grande quantité de nerfs périphériques dans l’organisme, par le biais de la myéline ou des axones."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31006e60-4476-43d4-bd0c-1c66d6917d8c",
                                "sense_id": "d6668609-eedb-3747-8a1b-078e53178c16",
                                "text": "Il était chargé de remplir d’herbicides les réservoirs d’avions de fumigation depuis des années. Il s’est arrêté à partir du moment où il souffrait d’une polyneuropathie toxique sévère. Depuis, il est devenu un symbole de la lutte contre le glyphosate dans son pays."
                            },
                            {
                                "example_id": "a7c2f1ef-93d9-4606-a117-c77f1d311102",
                                "sense_id": "d6668609-eedb-3747-8a1b-078e53178c16",
                                "text": "Le traitement de la polyneuropathie toxique alcoolique associe l’administration parentérale de vitamines, surtout B1 en cas de carence, et un sevrage alcoolique complet, associé à un régime riche en protéines."
                            },
                            {
                                "example_id": "e763dab0-3f22-423e-beff-53f72e6ea2d8",
                                "sense_id": "d6668609-eedb-3747-8a1b-078e53178c16",
                                "text": "Le diagnostic étiologique des polyneuropathies axonales est un exercice difficile devant s’appuyer principalement sur un interrogatoire rigoureux et une analyse des corrélations électro-cliniques."
                            }
                        ]
                    }
                ],
