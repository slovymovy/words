{
    "word_family": [
        "effusion",
        "effuse"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0c50d442-8f82-3139-9609-ffd6eb078b52",
                    "sense_definition": "Showing or expressing feelings of gratitude, pleasure, or approval in an unrestrained or heartfelt manner.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave an <w>effusive</w> welcome to all the guests who arrived at her party.",
                            "target_lang_translations": {
                                "ru": "Она устроила <w>бурный</w> прием всем гостям, пришедшим на её вечеринку."
                            }
                        },
                        {
                            "text": "The critics were <w>effusive</w> in their praise for the young actor's brilliant performance.",
                            "target_lang_translations": {
                                "ru": "Критики были <w>щедры на похвалы</w> блестящей игре молодого актера."
                            }
                        }
                    ],
                    "synonyms": [
                        "gushy"
                    ],
                    "common_phrases": [
                        "effusive praise",
                        "effusive thanks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий чувства благодарности, радости или одобрения с чрезмерной пылкостью, несдержанно или восторженно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экспансивный",
                                "target_lang_sense_clarification": "несдержанно проявляющий эмоции"
                            },
                            {
                                "target_lang_word": "бурный",
                                "target_lang_sense_clarification": "очень эмоциональный, восторженный"
                            },
                            {
                                "target_lang_word": "несдержанный",
                                "target_lang_sense_clarification": "чрезмерно эмоциональный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d78f48db-0670-3853-9b60-34a7250ed331",
                    "sense_definition": "Pouring or spilling out freely.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>effusive</w> water flooded the basement after the pipe burst.",
                            "target_lang_translations": {
                                "ru": "<w>Хлынувшая</w> вода затопила подвал после прорыва трубы."
                            }
                        },
                        {
                            "text": "The river was <w>effusive</w> during the heavy spring rains.",
                            "target_lang_translations": {
                                "ru": "Река <w>выходила из берегов</w> во время сильных весенних дождей."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or poetic context."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обильно вытекающий, льющийся или переливающийся через край (в книжном или устаревшем контексте)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переполняющий",
                                "target_lang_sense_clarification": "выходящий из берегов, изливающийся"
                            },
                            {
                                "target_lang_word": "льющийся через край",
                                "target_lang_sense_clarification": "обильно вытекающий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dfbfa77-737a-3814-86c9-e3e798035a7c",
                    "sense_definition": "Relating to igneous rock that has solidified after being poured out as molten lava.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Basalt is a common type of <w>effusive</w> rock found near volcanoes.",
                            "target_lang_translations": {
                                "ru": "Базальт — распространенный тип <w>эффузивной</w> породы, встречающейся вблизи вулканов."
                            }
                        },
                        {
                            "text": "The geologist studied the <w>effusive</w> deposits left by the ancient eruption.",
                            "target_lang_translations": {
                                "ru": "Геолог исследовал <w>эффузивные</w> отложения, оставшиеся после древнего извержения."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к магматическим горным породам, образовавшимся при застывании лавы на поверхности Земли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эффузивный",
                                "target_lang_sense_clarification": "геологический термин, излившийся"
                            },
                            {
                                "target_lang_word": "вулканический",
                                "target_lang_sense_clarification": "связанный с излиянием лавы"
                            },
                            {
                                "target_lang_word": "излившийся",
                                "target_lang_sense_clarification": "о магматической породе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}