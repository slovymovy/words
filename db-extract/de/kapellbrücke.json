                "senses": [
                    {
                        "sense_id": "db867e46-e86c-3324-99fd-103fd6220d69",
                        "entry_id": "94d5d1b5-7659-330f-83ea-5d95c9e9a5e5",
                        "glosses": [
                            "Holzbrücke mit Überdachung und Kirchenbildern, wie in einer Kapelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea2cb562-76fc-405c-add6-06b9116fadc4",
                                "sense_id": "db867e46-e86c-3324-99fd-103fd6220d69",
                                "text": "„Die weltberühmte Kapellbrücke ist das Wahrzeichen von Luzern und die älteste Holzbrücke Europas.“"
                            },
                            {
                                "example_id": "f5f27cea-8646-418f-a1a1-4da6d567bd58",
                                "sense_id": "db867e46-e86c-3324-99fd-103fd6220d69",
                                "text": "„Damit ist sie länger als die Luzerner Kapellbrücke, die 202,9 Meter (mit Vordächern 204,7 Meter) lang ist.“"
                            },
                            {
                                "example_id": "393f91af-08a5-4cf8-b94d-9c47ed1da4b5",
                                "sense_id": "db867e46-e86c-3324-99fd-103fd6220d69",
                                "text": "„Dieser Längenrekord dürfte die Luzerner ärgern, denn die Kapellbrücke über die Reuss misst 80 Zentimeter weniger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
