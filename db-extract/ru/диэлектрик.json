                                        "entry_id": "ece3f3fb-c5c9-3270-8f99-09041de93b42",
                                        "glosses": [
                                            "elektrisch schwach- oder nichtleitende Substanz, in der die vorhandenen Ladungsträger nicht frei beweglich sind"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
