                "senses": [
                    {
                        "sense_id": "72655867-c098-3b31-84f5-6e7fef8df2f8",
                        "entry_id": "870362b5-4a8a-3ec1-b6de-dc24ca74492f",
                        "glosses": [
                            "Femme décédée ; défunte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cafc8cd-61e8-4829-92d7-09bdd05cd2af",
                                "sense_id": "72655867-c098-3b31-84f5-6e7fef8df2f8",
                                "text": "Mercy de sa douce main, arrangea les cheveux épars et disposa les vêtements froissés de la morte."
                            }
                        ]
                    },
                    {
                        "sense_id": "6738d67e-f827-36d7-9420-4f9039c69fd7",
                        "entry_id": "870362b5-4a8a-3ec1-b6de-dc24ca74492f",
                        "glosses": [
                            "Cadavre, dépouille mortelle."
                        ],
                        "tags": [
                            "euphemism"
                        ],
                        "examples": [
                            {
                                "example_id": "6425360f-19e4-4a01-85f8-de047ce89ce3",
                                "sense_id": "6738d67e-f827-36d7-9420-4f9039c69fd7",
                                "text": "On a enseveli la morte dans sa tombe."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "09ad97e9-a1ad-3f51-b60d-99ff2fee683d",
                "word": "morte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "714b4bab-20fd-4acb-aae1-d225c9345770",
                        "entry_id": "09ad97e9-a1ad-3f51-b60d-99ff2fee683d",
                        "tags": [
                            "plural"
                        ],
                        "form": "mortes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9fba32e8-8b5a-3356-b867-34364039489a",
                        "entry_id": "09ad97e9-a1ad-3f51-b60d-99ff2fee683d",
                        "glosses": [
                            "Petit étang se formant dans un bras mort d’une rivière ou d’un fleuve."
                        ],
                        "tags": [
                            "Franche-Comté",
                            "Lorraine"
                        ],
                        "examples": [
                            {
                                "example_id": "367f7eda-6a67-413a-bbd5-1b7e85031c2f",
                                "sense_id": "9fba32e8-8b5a-3356-b867-34364039489a",
                                "text": "Ils débouchèrent dans les « mortes ». Une étendue d’eau profonde et mystérieuse s’ouvrait là, qui paraissait plus étrange au sortir de la grande rivière pleine de mouvement, du glissement clair des eaux."
                            },
                            {
                                "example_id": "0feb4f3f-709e-4faf-a0a8-099e0f7e59e1",
                                "sense_id": "9fba32e8-8b5a-3356-b867-34364039489a",
                                "text": "Il y avait dans la prairie plusieurs de ces trous d’eau profonde et tranquille, qu’on appelait des mortes et qui jalonnaient l’ancien lit du fleuve."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "42da88ff-39e7-3f93-aa7f-3345c439d816",
                "word": "morte",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cdec816e-0ce1-38ea-996f-d345f9a4dfaf",
                        "entry_id": "42da88ff-39e7-3f93-aa7f-3345c439d816",
                        "glosses": [
                            "Participe passé féminin singulier de mourir."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "28bb47ec-5c1c-4d8f-b4a0-3c4f241d5da9",
                                "sense_id": "cdec816e-0ce1-38ea-996f-d345f9a4dfaf",
                                "text": "Ecchymoses des muscles antérolatéraux et de leurs gaines aponévrotiques, ruptures du chef antérieur du sterno-cléido-mastoïdien, manchon ecchymotique péricarotidien, spume, exophtalmie et lividités : il ne fait aucun doute que la victime est morte par pendaison !"
                            }
                        ]
                    }
                ],
