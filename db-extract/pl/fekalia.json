                "senses": [
                    {
                        "sense_id": "1bcf1d19-1364-3561-bb4e-ce767f12b696",
                        "entry_id": "c8391960-806c-3ba9-800c-a0c3fbb4c888",
                        "glosses": [
                            "odchody ludzkie gromadzące się w kanalizacji i szambach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e57bef5-e4f9-44ca-ad64-8f275ac0b28f",
                                "sense_id": "1bcf1d19-1364-3561-bb4e-ce767f12b696",
                                "text": "Pojemnik na fekalia, łóżko, stół, na którym miały powstawać rewolucyjne teorie, wieszak, krzesło i plansze – wszystko powędrowało do magazynów Muzeum Podhalańskiego przy ul. Sobieskiego."
                            },
                            {
                                "example_id": "9b1aedec-080d-49b9-a489-ed7dca08125f",
                                "sense_id": "1bcf1d19-1364-3561-bb4e-ce767f12b696",
                                "text": "U sąsiada fekalia wypłynęły z muszli i wanny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86bf046d-4482-47fc-9d26-c09f3c24b745",
                        "source_entry_id": "c8391960-806c-3ba9-800c-a0c3fbb4c888",
                        "source_sense_id": "1bcf1d19-1364-3561-bb4e-ce767f12b696",
                        "target_lang_word": "faeces",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faeces",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a757bd70-34e5-355b-a9db-f70436013eb7",
                                        "entry_id": "0676776b-bfb1-3efd-8e5c-b72240a03b22",
                                        "glosses": [
                                            "Alternative spelling of feces."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "alt-of",
                                            "alternative",
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcf0bb1f-68a7-484f-9e8f-5e923b310546",
                                                "sense_id": "a757bd70-34e5-355b-a9db-f70436013eb7",
                                                "text": "This paper reports on ingestion of soil by dairy cows using titanium analysis of faeces by the X-ray fluorescence technique, and gives the range of soil intakes of a year on both an individual and a herd basis."
                                            },
                                            {
                                                "example_id": "25706708-96f6-4d03-9f7c-dec6f49982b0",
                                                "sense_id": "a757bd70-34e5-355b-a9db-f70436013eb7",
                                                "text": "The fact that dogs have a well developed sense of smell suggests that they might be able to use the odour of faeces as a means of communicating."
                                            },
                                            {
                                                "example_id": "7b68b0b3-be42-4f4e-845c-5ae39be351e6",
                                                "sense_id": "a757bd70-34e5-355b-a9db-f70436013eb7",
                                                "text": "Urine and faeces are complete fertilizers of high quality with low levels of contaminants such as heavy metals. Urine is rich in nitrogen, while faeces are rich in phosphorous, potassium and organic matter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0caabce1-5f18-4295-9c8d-5b3d6d996ed3",
                        "source_entry_id": "c8391960-806c-3ba9-800c-a0c3fbb4c888",
                        "source_sense_id": "1bcf1d19-1364-3561-bb4e-ce767f12b696",
                        "target_lang_word": "night soil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "night soil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33718e1a-f380-3627-92ba-d65fbb229963",
                                        "entry_id": "2f4e5026-8f6a-32bd-ae11-9210f7ae6f81",
                                        "glosses": [
                                            "Human faeces."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9c34df8-3a9d-454e-a7d5-d130ac5fb79e",
                                                "sense_id": "33718e1a-f380-3627-92ba-d65fbb229963",
                                                "text": "There, the night soil along with the community refuse is filled in trenches for composting and subsequent use in agriculture."
                                            },
                                            {
                                                "example_id": "6fb97e31-9681-449e-b5ef-4162efaf5221",
                                                "sense_id": "33718e1a-f380-3627-92ba-d65fbb229963",
                                                "text": "The flow of nitrogen from night-soil in rural China is valuable, whereas human excrement in an urban center is a pollution problem."
                                            },
                                            {
                                                "example_id": "ca6649b3-c555-4b22-bee6-82ec1e634937",
                                                "sense_id": "33718e1a-f380-3627-92ba-d65fbb229963",
                                                "text": "Time for the local night soil man to appear. He left the inn to find the night man who serviced the place."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "553ce0da-c4d5-471a-81c3-9fb9a4825fe9",
                        "source_entry_id": "c8391960-806c-3ba9-800c-a0c3fbb4c888",
