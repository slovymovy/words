{
    "word_family": [
        "give",
        "giver",
        "giving"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d0f00be-f90a-38c9-8e56-9271a414a2de",
                    "sense_definition": "Something that is given away or handed out for free.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "free_item",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The T-shirt was a <w>giveaway</w> from the company that sells the software.",
                            "target_lang_translations": {
                                "ru": "Эта футболка была <w>бесплатным подарком</w> от компании, продающей программное обеспечение."
                            }
                        },
                        {
                            "text": "These <w>giveaway</w> bags cost tens of thousands of dollars but are meant as a thank you.",
                            "target_lang_translations": {
                                "ru": "Эти <w>подарочные</w> сумки стоят десятки тысяч долларов, но предназначены в качестве благодарности."
                            }
                        }
                    ],
                    "synonyms": [
                        "freebie",
                        "gift"
                    ],
                    "common_phrases": [
                        "promotional giveaway",
                        "free giveaway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что раздается или выдается бесплатно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бесплатный подарок",
                                "target_lang_sense_clarification": "вещь, полученная даром"
                            },
                            {
                                "target_lang_word": "халява",
                                "target_lang_sense_clarification": "разговорное обозначение бесплатного предмета"
                            },
                            {
                                "target_lang_word": "промо-товар",
                                "target_lang_sense_clarification": "предмет для продвижения бренда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a537581e-2400-38f5-938a-98d0c4233577",
                    "sense_definition": "An event or competition at which things are given away for free.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "free_item",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Following the feast the tables were cleared making room for the <w>giveaway</w>.",
                            "target_lang_translations": {
                                "ru": "После пиршества столы убрали, освободив место для <w>раздачи подарков</w>."
                            }
                        },
                        {
                            "text": "I entered the online <w>giveaway</w> to win a new smartphone.",
                            "target_lang_translations": {
                                "ru": "Я принял участие в онлайн-<w>розыгрыше</w>, чтобы выиграть новый смартфон."
                            }
                        }
                    ],
                    "common_phrases": [
                        "online giveaway",
                        "holiday giveaway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мероприятие или конкурс, на котором вещи раздаются бесплатно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "розыгрыш",
                                "target_lang_sense_clarification": "конкурс с призами"
                            },
                            {
                                "target_lang_word": "гивэвэй",
                                "target_lang_sense_clarification": "заимствование, часто используемое в соцсетях"
                            },
                            {
                                "target_lang_word": "раздача",
                                "target_lang_sense_clarification": "процесс бесплатного распределения вещей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77637f45-96ac-3767-ba37-715cfd6c9e07",
                    "sense_definition": "An indicator or clue that makes something obvious or apparent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indicator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frosting in his beard was a <w>giveaway</w> that he had been munching the cake.",
                            "target_lang_translations": {
                                "ru": "Глазурь в его бороде была <w>уликой</w>, выдававшей то, что он жевал торт."
                            }
                        },
                        {
                            "text": "A manner that is too self-assured and controlling is a dead <w>giveaway</w> of his true intentions.",
                            "target_lang_translations": {
                                "ru": "Слишком самоуверенная и властная манера поведения — это явный <w>признак</w>, выдающий его истинные намерения."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "dead giveaway",
                        "real giveaway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Признак или улика, которые делают что-то очевидным или явным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улика",
                                "target_lang_sense_clarification": "то, что выдает правду"
                            },
                            {
                                "target_lang_word": "предательский признак",
                                "target_lang_sense_clarification": "деталь, раскрывающая секрет"
                            },
                            {
                                "target_lang_word": "подсказка",
                                "target_lang_sense_clarification": "явный намек на что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d22023b-a833-39ba-aaa1-5d43dcf7bead",
                    "sense_definition": "The act of giving something away for free, often in a way that seems wasteful or excessive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "free_item",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nothing kills profits like product <w>giveaway</w> during a slow season.",
                            "target_lang_translations": {
                                "ru": "Ничто так не убивает прибыль, как <w>раздача</w> товаров в низкий сезон."
                            }
                        },
                        {
                            "text": "Critics argued that the new policy was a colossal <w>giveaway</w> of public resources.",
                            "target_lang_translations": {
                                "ru": "Критики утверждали, что новая политика была колоссальным <w>разбазариванием</w> государственных ресурсов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "product giveaway",
                        "colossal giveaway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт бесплатной раздачи чего-либо, часто воспринимаемый как расточительный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздаривание",
                                "target_lang_sense_clarification": "процесс отдачи ресурсов безвозмездно"
                            },
                            {
                                "target_lang_word": "уступка",
                                "target_lang_sense_clarification": "передача прав или ресурсов за бесценок"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2262c7f0-ef8e-335c-a5ca-4ab63fa90a11",
                    "sense_definition": "Extremely low in price; very cheap.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cheap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old trucks were sold at <w>giveaway</w> prices after their war roles ceased.",
                            "target_lang_translations": {
                                "ru": "Старые грузовики были проданы по <w>бросовым</w> ценам после того, как их роль в войне закончилась."
                            }
                        },
                        {
                            "text": "You can find great furniture at <w>giveaway</w> rates if you shop at the end of the month.",
                            "target_lang_translations": {
                                "ru": "Вы можете найти отличную мебель по <w>смехотворным</w> ценам, если будете делать покупки в конце месяца."
                            }
                        }
                    ],
                    "common_phrases": [
                        "giveaway price",
                        "giveaway rate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно низкий по цене; очень дешевый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросовый",
                                "target_lang_sense_clarification": "о крайне низкой цене"
                            },
                            {
                                "target_lang_word": "смехотворный",
                                "target_lang_sense_clarification": "о цене, которая кажется нереально низкой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}