{
    "word_family": [
        "geeky",
        "geekery",
        "geekiness",
        "geekdom",
        "geekspeak"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e700dcd-a662-3743-917b-1654dac8e61a",
                    "sense_definition": "A person who is intensely interested in a particular field or hobby and often having limited or nonstandard social skills.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "enthusiast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was a complete computer <w>geek</w> in high school, but I get out a lot more now.",
                            "target_lang_translations": {
                                "ru": "В старших классах я был полным компьютерным <w>гиком</w>, но сейчас я гораздо чаще выбираюсь в свет."
                            }
                        },
                        {
                            "text": "Most famous actors are really theater <w>geeks</w> at heart.",
                            "target_lang_translations": {
                                "ru": "Большинство знаменитых актеров в душе настоящие театральные <w>фанатики</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "nerd",
                        "anorak",
                        "otaku"
                    ],
                    "common_phrases": [
                        "computer geek",
                        "theater geek",
                        "total geek"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который страстно увлечен определенной областью или хобби, часто обладающий ограниченными или нестандартными социальными навыками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гик",
                                "target_lang_sense_clarification": "увлеченный фанат"
                            },
                            {
                                "target_lang_word": "фанатик",
                                "target_lang_sense_clarification": "страстно преданный делу"
                            },
                            {
                                "target_lang_word": "помешанный",
                                "target_lang_sense_clarification": "сильно увлеченный чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1ff8fe4-05ea-3449-a35c-8b58b4aba8ec",
                    "sense_definition": "An expert in a technical field, particularly one having to do with computers.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "enthusiast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My laptop is locked up again, so I really need a <w>geek</w> to fix it.",
                            "target_lang_translations": {
                                "ru": "Мой ноутбук снова завис, так что мне очень нужен какой-нибудь <w>компьютерщик</w>, чтобы его починить."
                            }
                        },
                        {
                            "text": "The community of radio amateurs prefigured the <w>geek</w> community that was to inhabit Silicon Valley later.",
                            "target_lang_translations": {
                                "ru": "Сообщество радиолюбителей предвосхитило сообщество <w>гиков</w>, которое позже заселило Кремниевую долину."
                            }
                        }
                    ],
                    "synonyms": [
                        "hacker",
                        "tech guru"
                    ],
                    "common_phrases": [
                        "tech geek",
                        "computer geek"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эксперт в технической области, особенно в сфере компьютеров и технологий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гик",
                                "target_lang_sense_clarification": "технологический энтузиаст"
                            },
                            {
                                "target_lang_word": "компьютерщик",
                                "target_lang_sense_clarification": "специалист по компьютерам"
                            },
                            {
                                "target_lang_word": "технарь",
                                "target_lang_sense_clarification": "человек с техническим складом ума"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e1ca5ab-7d12-30d0-93d1-f2e5b7ebc82b",
                    "sense_definition": "An unfashionable or socially undesirable person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Why do you hang around with them when they are just <w>geeks</w>?",
                            "target_lang_translations": {
                                "ru": "Почему ты с ними тусуешься, они же просто <w>чудаки</w>?"
                            }
                        },
                        {
                            "text": "You ought to ditch the two <w>geeks</w> you are in the car with now and get in with us.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит бросить этих двух <w>ботаников</w>, с которыми ты сейчас в машине, и пойти к нам."
                            }
                        }
                    ],
                    "synonyms": [
                        "dork",
                        "loser"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as a mild insult"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Немодный или социально непривлекательный человек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чудак",
                                "target_lang_sense_clarification": "странный человек"
                            },
                            {
                                "target_lang_word": "чудик",
                                "target_lang_sense_clarification": "нелепый человек"
                            },
                            {
                                "target_lang_word": "ботаник",
                                "target_lang_sense_clarification": "социально неловкий интеллектуал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cee884e2-976e-3cac-b978-b451548f66ad",
                    "sense_definition": "The subculture of geeks; an esoteric subject of interest that is marginal to the social mainstream.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "culture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Is it the ultimate triumph of the Bill Gates era, in which <w>geek</w> is the new cool?",
                            "target_lang_translations": {
                                "ru": "Неужели это окончательный триумф эры Билла Гейтса, в которой быть <w>гиком</w> — это круто?"
                            }
                        },
                        {
                            "text": "It is my job to stay on top of the latest and coolest in <w>geek</w> that is out there.",
                            "target_lang_translations": {
                                "ru": "Моя работа — быть в курсе всего самого нового и крутого в мире <w>гик-культуры</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Субкультура гиков; специфическая область интересов, находящаяся вне социального мейнстрима."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гик-культура",
                                "target_lang_sense_clarification": "сообщество и интересы гиков"
                            },
                            {
                                "target_lang_word": "гиковство",
                                "target_lang_sense_clarification": "образ жизни или увлечения гика"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "656523d0-5bf6-32df-a907-0e9ac7f5a7cf",
                    "sense_definition": "A look or a quick glance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Have a <w>geek</w> at this new gadget I just bought.",
                            "target_lang_translations": {
                                "ru": "Взгляни <w>глазком</w> на этот новый гаджет, который я только что купил."
                            }
                        },
                        {
                            "text": "Then he says let us have a <w>geek</w> at some of the elephant pictures instead.",
                            "target_lang_translations": {
                                "ru": "Затем он говорит: давай лучше <w>посмотрим</w> на фотографии слонов."
                            }
                        }
                    ],
                    "synonyms": [
                        "gander",
                        "dekko",
                        "butcher’s"
                    ],
                    "common_phrases": [
                        "have a geek"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily British or Australian dialect"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Взгляд или быстрый просмотр чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взгляд",
                                "target_lang_sense_clarification": "быстрый осмотр"
                            },
                            {
                                "target_lang_word": "глазок",
                                "target_lang_sense_clarification": "взглянуть одним глазком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0efe4ade-7b91-36c7-b6c9-ec16287ee25d",
                    "sense_definition": "A carnival performer specializing in bizarre and unappetizing behavior.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "performer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I once saw a <w>geek</w> bite the head off a live chicken at the fair.",
                            "target_lang_translations": {
                                "ru": "Я однажды видел на ярмарке, как <w>фрик</w> откусил голову живой курице."
                            }
                        },
                        {
                            "text": "You hand in your ticket and you go watch the <w>geek</w> perform his strange act.",
                            "target_lang_translations": {
                                "ru": "Ты отдаешь билет и идешь смотреть, как <w>артист</w> исполняет свой странный номер."
                            }
                        }
                    ],
                    "synonyms": [
                        "freak"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical carnival context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Цирковой артист, специализирующийся на странных и отталкивающих трюках."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фрик",
                                "target_lang_sense_clarification": "цирковой уродец или странный артист"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c38b2ddd-c8b2-339a-bba8-1efb713ca9bd",
                    "sense_definition": "To enthusiastically engage in geek-like or nerdy interests.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had an amazing time wandering around the convention and <w>geeking</w> out over the costumes.",
                            "target_lang_translations": {
                                "ru": "Мы отлично провели время, бродя по конвенту и <w>фанатея</w> от костюмов."
                            }
                        },
                        {
                            "text": "They spent the whole evening <w>geeking</w> about the new software update.",
                            "target_lang_translations": {
                                "ru": "Они весь вечер <w>ботанили</w> по поводу нового обновления ПО."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geek out"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used with 'out'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "С энтузиазмом заниматься типичными для гиков делами или обсуждать их."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гиковать",
                                "target_lang_sense_clarification": "фанатеть от чего-то специфического"
                            },
                            {
                                "target_lang_word": "ботанить",
                                "target_lang_sense_clarification": "углубляться в технические детали"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99206451-d91c-3932-bff8-10d927197bd9",
                    "sense_definition": "To be nervous or hyperactive due to being under the influence of a mood-altering drug.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "drug_use",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guy in the corner was <w>geeking</w> hard after taking something.",
                            "target_lang_translations": {
                                "ru": "Парень в углу жестко <w>торчал</w> после того, как что-то принял."
                            }
                        },
                        {
                            "text": "They know I <w>geek</w> a lot when I am on those pills.",
                            "target_lang_translations": {
                                "ru": "Они знают, что меня сильно <w>колбасит</w>, когда я на этих таблетках."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "drug culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нервничать или проявлять гиперактивность под воздействием психоактивных веществ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торчать",
                                "target_lang_sense_clarification": "быть под кайфом"
                            },
                            {
                                "target_lang_word": "колбаситься",
                                "target_lang_sense_clarification": "быть в состоянии наркотического возбуждения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83defa65-60fb-3fc6-80db-a7f223cb1786",
                    "sense_definition": "To look, peep, or stare about intently.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will <w>geek</w> through the window to see if they are home.",
                            "target_lang_translations": {
                                "ru": "Я <w>загляну</w> в окно, чтобы проверить, дома ли они."
                            }
                        },
                        {
                            "text": "He was always <w>geeking</w> round after things that did not concern him.",
                            "target_lang_translations": {
                                "ru": "Он всегда <w>высматривал</w> вещи, которые его не касались."
                            }
                        }
                    ],
                    "synonyms": [
                        "look"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "West Country English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пристально смотреть, подглядывать или высматривать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глазеть",
                                "target_lang_sense_clarification": "пристально смотреть"
                            },
                            {
                                "target_lang_word": "подглядывать",
                                "target_lang_sense_clarification": "смотреть украдкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3312e8a-3b0d-322f-a488-f6d9e29108bd",
                    "sense_definition": "To perform bizarre and unpleasant feats as part of a carnival.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "performer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Geeking</w> was among the first carnival acts to be outlawed in the early 20th century.",
                            "target_lang_translations": {
                                "ru": "<w>Выступления фриков</w> были одними из первых карнавальных номеров, запрещенных в начале 20-го века."
                            }
                        },
                        {
                            "text": "He made a living <w>geeking</w> for crowds at the traveling circus.",
                            "target_lang_translations": {
                                "ru": "Он зарабатывал на жизнь, <w>показывая трюки</w> толпам в бродячем цирке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical carnival context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять странные и неприятные трюки в рамках карнавального шоу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выступать",
                                "target_lang_sense_clarification": "в роли циркового фрика"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}