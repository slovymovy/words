            "senses": [
                {
                    "sense_id": "fc0ee412-4638-3187-b67e-99ce9b1f8bb9",
                    "sense_definition": "форма именительного падежа единственного числа женского рода местоимения <w>ваш</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Где сейчас находится <w>ваша</w> машина?",
                            "target_lang_translations": {
                                "en": "Where is <w>your</w> car right now?",
                                "de": "Wo befindet sich gerade <w>eure</w> / <w>Ihre</w> Maschine?"
                            }
                        },
                        {
                            "text": "Это <w>ваша</w> книга или библиотечная?",
                            "target_lang_translations": {
                                "en": "Is this <w>your</w> book or the library's?",
                                "de": "Ist das <w>eure</w> / <w>Ihre</w> Buch oder das aus der Bibliothek?"
                            }
                        },
                        {
                            "text": "Если <w>ваша</w> взяла, то делайте, как знаете.",
                            "target_lang_translations": {
                                "en": "If <w>yours</w> has won out, then do as you see fit.",
                                "de": "Wenn <w>ihr</w> gewonnen habt, dann macht, wie ihr denkt."
                            }
                        }
                    ],
                    "antonyms": [
                        "моя",
                        "наша",
                        "их"
                    ],
                    "common_phrases": [
                        "ваша честь",
                        "ваша правда",
                        "ваша взяла",
                        "воля ваша"
                    ],
                    "target_lang_definitions": {
                        "en": "feminine singular form of the possessive pronoun \"your\"",
                        "de": "Femininum Singular Form des Possessivpronomens \"euer\" oder \"Ihr\" (höflich)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "your",
                                "target_lang_sense_clarification": "possessive determiner"
                            },
                            {
                                "target_lang_word": "yours",
                                "target_lang_sense_clarification": "possessive pronoun"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "eure",
                                "target_lang_sense_clarification": "Possessivpronomen für die zweite Person Plural (informell)"
                            },
                            {
                                "target_lang_word": "Ihre",
                                "target_lang_sense_clarification": "Possessivpronomen für die höfliche Anrede (formell)"
                            }
                        ]
                    }
                }
            ]
        },
