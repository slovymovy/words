                "senses": [
                    {
                        "sense_id": "8761ac79-78c8-3ac5-a9a2-f4c077df0e9f",
                        "entry_id": "a4c0962e-dcbe-3960-9aea-71791b2e0432",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26b06537-f350-43c4-a86f-d5a0f5dd45ac",
                                "sense_id": "8761ac79-78c8-3ac5-a9a2-f4c077df0e9f",
                                "text": "Frau Macdonald ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "511cb9be-d049-4454-89c1-669eb45800ac",
                                "sense_id": "8761ac79-78c8-3ac5-a9a2-f4c077df0e9f",
                                "text": "Herr Macdonald wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2b120d18-055f-45a2-ba47-b995e3477f9b",
                                "sense_id": "8761ac79-78c8-3ac5-a9a2-f4c077df0e9f",
                                "text": "Die Macdonalds fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "ce289afd-e313-4445-8b9f-a61e2b29d996",
                                "sense_id": "8761ac79-78c8-3ac5-a9a2-f4c077df0e9f",
                                "text": "Der Macdonald trägt nie die Pullover, die die Macdonald ihm strickt."
                            },
                            {
                                "example_id": "317efac6-c1d5-4ef9-966c-41252b98186d",
                                "sense_id": "8761ac79-78c8-3ac5-a9a2-f4c077df0e9f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Macdonald kommt, geht der Herr Macdonald.“"
                            },
                            {
                                "example_id": "9d7df555-bcd9-41e7-b0c9-ca61fba0760d",
                                "sense_id": "8761ac79-78c8-3ac5-a9a2-f4c077df0e9f",
                                "text": "Macdonald kommt und geht."
                            },
                            {
                                "example_id": "7270fd7e-664a-4664-83fb-dfca295b0c59",
                                "sense_id": "8761ac79-78c8-3ac5-a9a2-f4c077df0e9f",
                                "text": "Macdonalds kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
