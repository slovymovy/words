                        "examples": [
                            {
                                "example_id": "e653c7f9-8ace-428b-b153-83e51d0d5f19",
                                "sense_id": "2569d0f7-4db6-345f-8d3c-a228bc08ca02",
                                "text": "Régulièrement, les deux « livrovores » se retrouvaient là pour échanger sur leurs dernières lectures et philosopher."
                            },
                            {
                                "example_id": "3b8fff6e-7efe-4243-bbd2-072e2695857b",
                                "sense_id": "2569d0f7-4db6-345f-8d3c-a228bc08ca02",
                                "text": "Pleine lune, parasite cérébral, réincarnation sataniste du marquis de Sade ou extraterrestre livrovore en chaleur, personnellement je m’en contrefous."
                            },
                            {
                                "example_id": "afb5c5af-96c6-4147-8ecd-646917c6d055",
                                "sense_id": "2569d0f7-4db6-345f-8d3c-a228bc08ca02",
                                "text": "Juste derrière, une immense bibliothèque recouvre tout un pan de mur. Le « livrovore » que je suis ne peut s’empêcher de s’en approcher."
                            }
                        ]
                    }
