                ],
                "senses": [
                    {
                        "sense_id": "9b1909fb-1826-3d3d-889d-e6439a4bb4e6",
                        "entry_id": "12b0c615-af46-3950-9b5f-d28ac19df700",
                        "glosses": [
                            "Lyophilisation sous vide à basse température."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f86b7ae0-28ad-4f3b-93e3-83417bda3934",
                                "sense_id": "9b1909fb-1826-3d3d-889d-e6439a4bb4e6",
                                "text": "On examine une méthode de cryodessiccation des produits carnés en morceau dans une machine permettant d’éliminer les effets marginaux et d’abaisser la durée de dessiccation."
                            },
                            {
                                "example_id": "8729d6d2-291b-46b2-a092-3e6fa2474f3e",
                                "sense_id": "9b1909fb-1826-3d3d-889d-e6439a4bb4e6",
                                "text": "Comme il est très compliqué de lyophiliser ce qui est très gras, très sucré ou très salé, les produits qui on subi ce que l’on appelait autrefois la « cryodessiccation » affichent, pour la plupart, un bon profil nutritionnel. — (« Congélation : Passe-moi le gel ! », Malbouffe, le dico, Les Dossiers du Canard enchaîné nᵒ 147, avril 2018, page 24)"
                            },
                            {
                                "example_id": "7c6affd2-e11e-454f-9e50-cae3380c0ea8",
                                "sense_id": "9b1909fb-1826-3d3d-889d-e6439a4bb4e6",
                                "text": "C’est ainsi qu’a été développée, dès 1906 par les Français Arsène d’Arsonval et Frédéric Bordas, une nouvelle méthode de conservation : la lyophilisation ou cryodessication."
                            }
                        ]
                    }
                ],
