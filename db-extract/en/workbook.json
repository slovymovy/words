        "fr-extract.jsonl": [
            {
                "entry_id": "92bb3bd6-dfab-38f4-831e-a284b299fa8d",
                "word": "workbook",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d29eba6d-e4d2-4687-b575-c11b74813c35",
                        "entry_id": "92bb3bd6-dfab-38f4-831e-a284b299fa8d",
                        "tags": [
                            "plural"
                        ],
                        "form": "workbooks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a56418f8-0eee-3cc6-83cc-e03b200ad17a",
                        "entry_id": "92bb3bd6-dfab-38f4-831e-a284b299fa8d",
                        "glosses": [
                            "Cahier de travail, contenant des leçons, des exercices, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "069770c4-aa5a-468a-b26c-79f0ac9070fa",
                                "sense_id": "a56418f8-0eee-3cc6-83cc-e03b200ad17a",
                                "text": "Workbooks are a teacher, parent or educator's favorite tool! These printable, thematic educational materials help kids focus their learning on related skills within a subject of study. Professionally designed and written, these workbooks contain many pages of resources, quizzes, visual aids, charts and characters to enhance kids' learning experience.",
                                "translation": "Les cahiers de travail sont l’outil préféré d’un enseignant, parent ou éducateur ! Ces supports pédagogiques thématiques imprimables aident les enfants à concentrer leur apprentissage sur les compétences connexes au sein d’un sujet d'étude. Conçus et écrits de manière professionnelle, ces cahiers contiennent de nombreuses pages de ressources, de quiz, d’aides visuelles, de graphiques et de personnages pour améliorer l’expérience d’apprentissage des enfants."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc8049e1-4b81-3e32-9fee-61007b8fc882",
                        "entry_id": "92bb3bd6-dfab-38f4-831e-a284b299fa8d",
                        "glosses": [
                            "Cahier de travail, contenant des notes, des actions, des tâches faites ou à faire."
                        ],
                        "tags": [
                            "Travail"
                        ],
                        "note": "De plus en plus sous forme informatique",
                        "examples": [
                            {
                                "example_id": "d370c5f4-ba62-42aa-a9df-0023d9d1db9a",
                                "sense_id": "dc8049e1-4b81-3e32-9fee-61007b8fc882",
                                "text": "Skanska is aiming to address this by replacing the traditional [Microsoft] Excel spreadsheet with a new ISO 19650-compliant [digital] Information Management Workbook.",
                                "translation": "Skanska vise à résoudre ce problème en remplaçant la feuille de calcul [Microsoft] Excel traditionnelle par un nouveau cahier de travail [informatisé] de gestion de l’information conforme à la norme ISO 19650."
                            }
                        ]
                    },
                    {
                        "sense_id": "574e4913-d25f-3ed4-a9fe-1ef36bdecde2",
                        "entry_id": "92bb3bd6-dfab-38f4-831e-a284b299fa8d",
                        "glosses": [
                            "Classeur : document d’un tableur pouvant contenir plusieurs feuilles de calcul, ainsi que des graphiques et des macros."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6636723e-773c-4d8c-9291-f7f2bce801ef",
                                "sense_id": "574e4913-d25f-3ed4-a9fe-1ef36bdecde2",
                                "text": "I imported a large Excel workbook that consists of dozens of sheets, and Calc did the job without any hiccups. I also worked on the same workbook, added a few pivot tables, and recorded a few macros. The overall stability of the system remained robust, even with several applications running in the background.",
                                "translation": "J’ai importé un grand classeur Excel composé de dizaines de feuilles, et Calc a fait le travail sans aucun problème. J’ai également travaillé sur le même classeur, ajouté quelques tableaux croisés dynamiques et enregistré quelques macros. La stabilité globale du système est restée robuste, même avec plusieurs applications en cours d’exécution en arrière-plan."
                            }
                        ]
                    }
                ],
