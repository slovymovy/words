                                "target_senses": [
                                    {
                                        "sense_id": "3402b009-ff44-3cd8-93ce-dcec231789f1",
                                        "entry_id": "14c5c296-59b9-3d32-a561-467d78883450",
                                        "glosses": [
                                            "Werkzeug mit einer festen und einer beweglichen Backe zum Fixieren mehrerer Objekte aneinander"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24ee3295-54ab-4b7e-b61f-f851a43dd7eb",
                                                "sense_id": "3402b009-ff44-3cd8-93ce-dcec231789f1",
                                                "text": "Zum Trocknen werden die verleimten Teile in eine Schraubzwinge gespannt."
                                            },
                                            {
                                                "example_id": "72fc527a-54ad-48c0-aad0-58e8510b62ae",
                                                "sense_id": "3402b009-ff44-3cd8-93ce-dcec231789f1",
                                                "text": "„Mein Kopf wurde behutsam gelagert, dann sanft und doch entschieden mit Schraubzwingen fixiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
