                                        "entry_id": "a8c4e9bd-48e2-3af6-bb5e-f63f14a7f7e1",
                                        "glosses": [
                                            "Género musical folclórico típico de Argentina y Uruguay, de ritmo lento, tono nostálgico, que se canta acompañado de guitarra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4cc430e-60de-464e-955d-f9a63e85f9f1",
                                                "sense_id": "b4df47fd-3230-3ee7-b126-745ee2645ad2",
                                                "text": "El origen de la milonga es muy discutido. Es muy parecida al tango, pero más rapida y menos melancólica."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5dc54ea8-15c3-32a2-85d3-e49f5e6fdb45",
                                        "entry_id": "a8c4e9bd-48e2-3af6-bb5e-f63f14a7f7e1",
                                        "glosses": [
                                            "Engaño, mentira, cuento."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff61f466-975b-4d36-8259-4bdc7090828e",
                                                "sense_id": "5dc54ea8-15c3-32a2-85d3-e49f5e6fdb45",
                                                "text": "Vamos, lo de siempre, milonga tras milonga."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
