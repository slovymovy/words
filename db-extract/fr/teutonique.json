                    }
                ],
                "senses": [
                    {
                        "sense_id": "7cad9be4-92b2-3292-942b-dd71c5ca8114",
                        "entry_id": "55fe94ed-ebd5-33c9-b7e3-ff8d3d5ce2d2",
                        "glosses": [
                            "Qui a rapport, qui appartient aux anciens Teutons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "534913a8-a3c7-463e-9293-5555c3c8a203",
                                "sense_id": "7cad9be4-92b2-3292-942b-dd71c5ca8114",
                                "text": "Il […] présidait les grandes assemblées de la nation franke, suivies de ces festins traditionnels parmi la race teutonique, où des sangliers et des daims entiers étaient servis tout embrochés, et où des tonneaux défoncés occupaient les quatre coins de la salle."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0020271-90eb-3c73-99e7-fee65a8b8181",
                        "entry_id": "55fe94ed-ebd5-33c9-b7e3-ff8d3d5ce2d2",
                        "glosses": [
                            "Allemand."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2b0cf117-b168-357a-9c51-8e3a68b3a9c2",
                        "entry_id": "55fe94ed-ebd5-33c9-b7e3-ff8d3d5ce2d2",
                        "glosses": [
                            "Qualifiait un ordre religieux militaire fondé par des seigneurs allemands à l’époque des croisades."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "705f8e6f-3932-3931-b783-5024b5b1090c",
                        "entry_id": "55fe94ed-ebd5-33c9-b7e3-ff8d3d5ce2d2",
                        "glosses": [
                            "Qualifiait la Hanse, confédération de plusieurs villes d’Allemagne et du Nord de l'Europe, unies ensemble, au Moyen Âge, pour leur commerce et leur défense."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17fba5d2-1646-4db0-a25b-5a8b25abade1",
                        "source_entry_id": "55fe94ed-ebd5-33c9-b7e3-ff8d3d5ce2d2",
                        "target_lang_word": "Teutonic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teutonic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2109162-1fbf-31d6-86e2-56e7f34e0e00",
                                        "entry_id": "f80b4489-359b-36fe-8ba6-d749868fffae",
                                        "glosses": [
                                            "Relating to the ancient Germanic people, the Teutons."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5e0652b-b539-3ff7-b4ca-67b6ef04061f",
                                        "entry_id": "f80b4489-359b-36fe-8ba6-d749868fffae",
                                        "glosses": [
                                            "Having qualities that are regarded as typical of German people."
                                        ],
                                        "tags": [
                                            "dated",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb8153b9-7df3-4bea-93d4-676d65b95bc0",
                                                "sense_id": "c5e0652b-b539-3ff7-b4ca-67b6ef04061f",
                                                "text": "Teutonic exactitude"
                                            },
                                            {
                                                "example_id": "0435e293-1c52-4bdd-b4a8-882a9028aa28",
                                                "sense_id": "c5e0652b-b539-3ff7-b4ca-67b6ef04061f",
                                                "text": "He waited and waited, in the faith that Schinkel was dealing with them in his slow, categorical Teutonic way, and only objurgated the cabinetmaker for having in the first place paltered with his sacred trust.[…]"
                                            },
                                            {
                                                "example_id": "f4b8792c-ab8c-4fd2-8b8a-db0839c0f0aa",
                                                "sense_id": "c5e0652b-b539-3ff7-b4ca-67b6ef04061f",
                                                "text": "Sure, the map says it’s Italy, but after walking through the centuries-old market at Piazza Erbe (Obstplatz) and seeing one too many suspiciously Teutonic-looking locals munching wurst, you might think you’ve crossed the Austrian border."
                                            },
                                            {
                                                "example_id": "56502a1e-3a1c-447b-a884-bd82dd6ffc91",
                                                "sense_id": "c5e0652b-b539-3ff7-b4ca-67b6ef04061f",
                                                "text": "My disorderliness was anathema to his Teutonic soul. “Here, I will write it down. Oh, you are so chaotic. Hand me the telephone.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e14aa996-4fd1-35cc-96e6-60b105691f89",
                                        "entry_id": "f80b4489-359b-36fe-8ba6-d749868fffae",
                                        "glosses": [
                                            "Relating to the Germanic branch of the Indo-European language family."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
