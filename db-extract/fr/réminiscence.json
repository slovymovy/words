                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86453291-d839-4de4-994f-6682c300867f",
                        "source_entry_id": "f05b0647-a076-30ef-a571-aab204844d4f",
                        "target_lang_word": "Erinnerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erinnerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9714d18-b407-3584-8b3f-79017f4c6b17",
                                        "entry_id": "8ad01e89-5227-3d6f-84bd-941b81e230dd",
                                        "glosses": [
                                            "die Fähigkeit, Vergangenes im Gedächtnis zu behalten; die Summe aller Erinnerungen [2] eines Menschen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8474f77-40b1-4e9b-8afd-fac4385ad32a",
                                                "sense_id": "f9714d18-b407-3584-8b3f-79017f4c6b17",
                                                "text": "Mein Vater wird langsam alt, seine Erinnerung lässt ihn immer öfter im Stich."
                                            },
                                            {
                                                "example_id": "9f5a7e76-9f50-4fcf-9979-6bfac7d02c39",
                                                "sense_id": "f9714d18-b407-3584-8b3f-79017f4c6b17",
                                                "text": "„Er hielt die Erinnerung für die lebenerhaltende Kraft der Menschen und Planeten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7f6feb56-7dea-3b84-a340-f87fe63cfb04",
                                        "entry_id": "8ad01e89-5227-3d6f-84bd-941b81e230dd",
                                        "glosses": [
                                            "ein bestimmter Gedanke, der durch die Fähigkeit [1] verblieben ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84bd9513-0611-4a17-a9b7-649e86fea245",
                                                "sense_id": "7f6feb56-7dea-3b84-a340-f87fe63cfb04",
                                                "text": "„Von allen meinen Erinnerungen, von all den unzähligen Empfindungen meines Lebens war die bedrückendste die Erinnerung an den einzigen Mord, den ich begangen habe.“"
                                            },
                                            {
                                                "example_id": "6fb6cdd0-add8-446b-94bf-d1b3aed71925",
                                                "sense_id": "7f6feb56-7dea-3b84-a340-f87fe63cfb04",
                                                "text": "„Erinnerung ist im Deutschland der fünfziger Jahre ein unangenehmer Störfaktor für die Neudemokraten, die gerade beginnen, das Land mit dem gleichen Eifer aufzubauen, mit dem sie es wenige Jahre zuvor zerstört hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "63fdadb1-7753-3f6b-ac3b-1705e8b6e785",
                                        "entry_id": "8ad01e89-5227-3d6f-84bd-941b81e230dd",
                                        "glosses": [
                                            "die Erinnerung [2] an ein bestimmtes Ereignis oder eine bestimmte Person; oft in Form eines Denkmals oder Ähnlichem manifestiert"
                                        ],
                                        "tags": [
                                            "konkret"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3aea6ec0-d5f2-44ba-ac38-df4947132836",
                                                "sense_id": "63fdadb1-7753-3f6b-ac3b-1705e8b6e785",
                                                "text": "„Erst seit 1951 trägt die Straße ihren heutigen Namen, in Erinnerung an die Berliner Schneiderin Käthe Niederkirchner, die 1933 als Kommunistin Deutschland verlassen musste und zehn Jahre später als sowjetische Agentin zurückkam, in Berlin festgenommen und Ende September 1944 im KZ Ravensbrück hingerichtet wurde.“"
                                            },
                                            {
                                                "example_id": "6e8f99eb-ea06-4d96-b001-4b25b2caeb82",
                                                "sense_id": "63fdadb1-7753-3f6b-ac3b-1705e8b6e785",
                                                "text": "„Trotz des scharfen Windes – da weht noch etwas anderes: Sie nennen es hier den Rhöngeist, und sie meinen damit den nie zu Ende geträumten Traum vom Fliegen, die Zähigkeit, die Leidenschaft und die Erinnerung an die Pionierzeit des Segelflugs.“"
                                            },
                                            {
                                                "example_id": "ab7d8411-fcc0-40ad-8919-3bac635bcbd9",
                                                "sense_id": "63fdadb1-7753-3f6b-ac3b-1705e8b6e785",
                                                "text": "„Erwachsenen Menschen ist es nur eine gewisse Weile erlaubt, in süßen Erinnerungen zu schwelgen, und bald wandte sich der Geschäftsführer seinem eigentlichen Thema zu.“"
                                            },
                                            {
                                                "example_id": "393f4f7c-ae8a-4f3e-b516-218e3b7ad473",
                                                "sense_id": "63fdadb1-7753-3f6b-ac3b-1705e8b6e785",
                                                "text": "„Die Londoner Psychologin Julia Shaw hat ihr eine falsche Erinnerung eingepflanzt.“"
                                            },
                                            {
                                                "example_id": "0a0ac7a8-82ce-4cd9-b666-01a02b689084",
                                                "sense_id": "63fdadb1-7753-3f6b-ac3b-1705e8b6e785",
                                                "text": "„Die Gäste erhalten goldene Medaillen zur Erinnerung an das Ereignis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "85faa058-c35c-34f4-8fb3-66516b1bde07",
                                        "entry_id": "8ad01e89-5227-3d6f-84bd-941b81e230dd",
                                        "glosses": [
                                            "ein Text oder Zeichen mit dem Zweck, die Erinnerung [1] wieder aufzufrischen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c88501d2-6cb1-4554-9314-ea77afa56b6f",
                                                "sense_id": "85faa058-c35c-34f4-8fb3-66516b1bde07",
                                                "text": "Danke für die Erinnerung, Milch mitzubringen. Ich hätte nicht mehr daran gedacht."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c2ba0b13-2800-300b-bed1-cd0e86c1443c",
                                        "entry_id": "8ad01e89-5227-3d6f-84bd-941b81e230dd",
                                        "glosses": [
                                            "ohne Plural ein Rechtsbehelf, der innerhalb derselben Instanz zu einer gerichtlichen Überprüfung einer Maßnahme führt, die ein Gerichtsbeamter oder ein ersuchter oder beauftragter Richter getroffen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "075ec474-24e4-4337-a3f4-b33dca7fe947",
                                                "sense_id": "c2ba0b13-2800-300b-bed1-cd0e86c1443c",
                                                "text": "Gegen die Weigerung des Gerichtsvollziehers, einen Vollstreckungsauftrag zu übernehmen, kann sich der Vollstreckungsgläubiger gemäß § 766 Abs. 2 ZPO mittels Erinnerung zu Wehr setzen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c30aaa29-3b8d-412b-acff-f71790d9e2e1",
                        "source_entry_id": "f05b0647-a076-30ef-a571-aab204844d4f",
