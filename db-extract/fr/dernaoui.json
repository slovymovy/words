                        "glosses": [
                            "Relatif à la ville libyenne de Derna et à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc282441-1953-4319-ab5f-9d1b061b1565",
                                "sense_id": "49064085-77f6-3468-9aa9-1d41feef6edc",
                                "text": "[…]; bâts de mulet, brodés d'or et d'argent; selle et étriers dernaoui, étriers karoui; mors de fer pour chevaux et mulets;[…]."
                            },
                            {
                                "example_id": "412fcc88-c109-4558-97d1-b096b450c429",
                                "sense_id": "49064085-77f6-3468-9aa9-1d41feef6edc",
                                "text": "Curieusement, les magasins à Derna offrent les derniers cris de la mode, bien avant la capitale, mais l'État n'y offre pas même les besoins essentiels de l'homme dernaoui tels que l'eau, l'électricité et les soins médicaux."
                            }
