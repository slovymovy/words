                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aa45de52-5fbb-37eb-80f4-b8e4ebcad2f1",
                        "entry_id": "968d281a-b674-39c9-9a44-c40786aec3ee",
                        "glosses": [
                            "wie im Elysium, äußerst erfreulich"
                        ],
                        "tags": [
                            "figurative",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "6db438dc-35a1-43e7-b92d-9693a21c0ceb",
                                "sense_id": "aa45de52-5fbb-37eb-80f4-b8e4ebcad2f1",
                                "text": "„In diesem elysischen Reich wohnte ich nicht als Fremder, denn jeder Anblick und jedes Geräusch waren mir vertraut; so war es unzählige Äonen der Ewigkeit zuvor gewesen, und so würde es in ebenso vielen künftigen Ewigkeiten sein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
