    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8825f9a8-7174-3e0e-936c-4438370854c3",
                    "sense_definition": "Demanding strict obedience to authority and limiting personal freedom; dictatorial or tyrannical.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "political_governance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country suffered for decades under an <w>authoritarian</w> regime that banned free speech."
                        },
                        {
                            "text": "Many citizens fled abroad to escape the harsh rules of the <w>authoritarian</w> government."
                        }
                    ],
                    "antonyms": [
                        "democratic",
                        "liberal"
                    ],
                    "common_phrases": [
                        "authoritarian regime",
                        "authoritarian state",
                        "authoritarian government"
                    ]
                },
                {
                    "sense_id": "88e64a05-c112-3d36-b519-259fddfa3f99",
                    "sense_definition": "Favouring or enforcing strict obedience to authority rather than individual freedom, especially regarding personal temperament or ideology.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "psychology_attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Psychologists conducted extensive research on the <w>authoritarian</w> personality and its social effects."
                        },
                        {
                            "text": "His <w>authoritarian</w> upbringing led him to expect absolute compliance from his subordinates."
                        }
                    ],
                    "synonyms": [
                        "bossy"
                    ],
                    "common_phrases": [
                        "authoritarian personality"
                    ]
                },
                {
                    "sense_id": "a01d0cb9-8241-3304-a001-094b5a4ae058",
                    "sense_definition": "Tending to impose one's demands upon others in a domineering or bossy manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personal_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager took an <w>authoritarian</w> approach, refusing to listen to suggestions from staff."
                        },
                        {
                            "text": "Her <w>authoritarian</w> style alienated many colleagues who preferred open collaboration."
                        }
                    ],
                    "synonyms": [
                        "arrogant",
                        "commanding",
                        "haughty",
                        "imperious"
                    ],
                    "antonyms": [
                        "servile",
                        "humble",
                        "modest"
                    ],
                    "common_phrases": [
                        "authoritarian approach",
                        "authoritarian style"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e0c0e5e1-a244-3ade-a863-b990cf8285be",
                    "sense_definition": "A person who demands strict obedience from others and enforces rigid control.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "ruler_or_controller",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The aging dictator was a ruthless <w>authoritarian</w> who eliminated all political opponents."
                        },
                        {
                            "text": "Her father was an unyielding <w>authoritarian</w> who demanded total compliance at home."
                        }
                    ]
                },
                {
                    "sense_id": "22dfc5d0-c501-35c5-9997-4a841bf0de32",
                    "sense_definition": "A person who supports or blindly submits to strong centralized authority.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "follower_of_authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As an unquestioning <w>authoritarian</w>, he defended every directive issued by the ruling party."
                        },
                        {
                            "text": "The survey identified key beliefs held by the committed <w>authoritarian</w> in modern society."
                        }
                    ]
                }
            ]
        }
    ]
