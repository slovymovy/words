                        "entry_id": "334e8f7f-b59f-3b93-acf7-f0dd3bb729db",
                        "glosses": [
                            "The Church of Scotland."
                        ],
                        "tags": [
                            "British",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f8994dea-8f0a-4c92-8f42-a06722501abe",
                                "sense_id": "a969ae47-59e4-3f1a-98d7-87d69f39fecc",
                                "text": "I suspect that members of the Church of Scotland who stop going, stop thinking of themselves as part of the Kirk much more readily."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c586e36-1809-3a7c-93ad-b82b4fd2da29",
                        "entry_id": "334e8f7f-b59f-3b93-acf7-f0dd3bb729db",
                        "glosses": [
                            "A habitational surname from Middle English."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "92990e2f-3a08-46bc-b325-14bb2f8da569",
                                "sense_id": "0c586e36-1809-3a7c-93ad-b82b4fd2da29",
                                "text": "One Nation, a new 501(c)4 linked to the Karl-Rove-backed American Crossroads super PAC, is spending more than $1.9 million on print, radio and digital ads highlighting the efforts of Illinois Sen. Mark Kirk, North Carolina Sen. Richard Burr, New Hampshire Sen. Kelly Ayotte, Ohio Sen. Rob Portman and Pennsylvania Sen. Pat Toomey to pass the “doc fix” legislation that realigned payments to Medicare providers with inflation."
                            },
                            {
                                "example_id": "10a11c6f-9a09-4526-9e53-e5b80278202e",
                                "sense_id": "0c586e36-1809-3a7c-93ad-b82b4fd2da29",
                                "text": "It had been 2,836 days since Chris Kirk last won on the PGA Tour. Yet after securing his first victory in over seven years on Sunday, that was not the first milestone the American golfer had on his mind."
                            },
                            {
                                "example_id": "8045384e-4fea-4087-b8b5-e6686890a713",
                                "sense_id": "0c586e36-1809-3a7c-93ad-b82b4fd2da29",
                                "text": "Recently, the Kirks appeared with their children on Fox and Friends in the weeks prior to the shooting."
                            }
                        ]
                    },
                    {
                        "sense_id": "ddf0ed8c-cfd9-3ec5-bb39-45e5156b8202",
                        "entry_id": "334e8f7f-b59f-3b93-acf7-f0dd3bb729db",
                        "glosses": [
                            "A male given name transferred from the surname."
                        ],
                        "tags": [
