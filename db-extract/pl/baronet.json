                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baronnet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63d65a27-c7cd-3e2e-8c2d-ced250b49f0b",
                                        "entry_id": "ba056b68-3ea8-3c88-b37e-e1bf02967117",
                                        "glosses": [
                                            "Titre en Angleterre qui vient immédiatement au-dessus de chevalier et au-dessous de baron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfff7c5c-ab6e-4760-a951-08f700767278",
                                                "sense_id": "63d65a27-c7cd-3e2e-8c2d-ced250b49f0b",
                                                "text": "Le titre de baronnet est héréditaire, mais il ne confère pas le droit d’entrer à la Chambre des lords."
                                            },
                                            {
                                                "example_id": "93352665-5eaf-4482-bad0-73c1281c777f",
                                                "sense_id": "63d65a27-c7cd-3e2e-8c2d-ced250b49f0b",
                                                "text": "Diverses considérations de politique coloniale, et des services importants rendus dans une circonstance périlleuse aux Européens d’Agra par Jean-Jacques Langévol, qui s’était fait naturaliser sujet britannique, conduisirent le gouverneur général de la province de Bengale à demander et obtenir pour l’époux de la Bégum le titre de baronnet."
                                            },
                                            {
                                                "example_id": "4db28776-7ad7-4953-b19a-fb951b08cf3a",
                                                "sense_id": "63d65a27-c7cd-3e2e-8c2d-ced250b49f0b",
                                                "text": "« Une très vieille famille… La branche aînée a le titre de baronnet depuis le temps des Tudors. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e37a3b49-3350-4cd3-996e-be50d992fc1f",
                        "source_entry_id": "8bbf284d-f5fb-31d6-9b9b-1c143b580743",
                        "source_sense_id": "5f7f31b5-ca92-3a02-b108-d11d504e36ae",
                        "target_lang_word": "Baronet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baronet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a40ad7a-4287-3ae8-863d-bbd2b44b6e1f",
                                        "entry_id": "b40d6497-1ca1-3a82-b868-e430d54197fa",
                                        "glosses": [
                                            "Adelstitel in Großbritannien, der von Monarchen an Bürgerliche verliehen werden kann"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca3ab885-f46f-44d0-9475-b251e4056046",
                                                "sense_id": "1a40ad7a-4287-3ae8-863d-bbd2b44b6e1f",
                                                "text": "„Gull wurde 1872 in Anerkennung der Tatsache, dass er dem Prinzen von Wales das Leben gerettet hatte, zum Baronet erhoben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5c5b49ab-6094-3471-852e-1e24cd1ba26b",
                                        "entry_id": "b40d6497-1ca1-3a82-b868-e430d54197fa",
                                        "glosses": [
                                            "Träger des Adelstitels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fcd715d-9e5a-44d9-83e7-14f70b9a1d3b",
                                                "sense_id": "5c5b49ab-6094-3471-852e-1e24cd1ba26b",
                                                "text": "„Der neue Baronet fasste den Entschluss, das Geheimnis, falls irgend möglich, zu lüften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
