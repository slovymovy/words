        "fr-extract.jsonl": [
            {
                "entry_id": "0fae1bc0-6d03-3847-909a-1c7efae1b925",
                "word": "seigneuriage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5bed1558-5163-4cd9-ac9f-36a8980f0e58",
                        "entry_id": "0fae1bc0-6d03-3847-909a-1c7efae1b925",
                        "tags": [
                            "plural"
                        ],
                        "form": "seigneuriages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4c37d040-75da-3743-8a68-672667bd0d27",
                        "entry_id": "0fae1bc0-6d03-3847-909a-1c7efae1b925",
                        "glosses": [
                            "Droit, privilège de battre monnaie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e454560d-3ad9-4572-83bd-fb6dc788c430",
                                "sense_id": "4c37d040-75da-3743-8a68-672667bd0d27",
                                "text": "Le seigneuriage était initialement le prix de l'opération de façonnage du métal en pièces et tout propriétaire d'or ou d'argent pouvait l'apporter à l'atelier de frappe et restait propriétaire des pièces ainsi fabriquées."
                            },
                            {
                                "example_id": "f812d5c0-3b3d-4b35-b416-f8b4415af769",
                                "sense_id": "4c37d040-75da-3743-8a68-672667bd0d27",
                                "text": "On appelle brassage les taxes prélevées lors de la frappe, à titre de paiement des frais d’outillage et de main-d’œuvre, et seigneuriage le supplément perçu à titre d’impôt."
                            },
                            {
                                "example_id": "acde287d-f7a4-45b1-b9b3-88181da6a8d4",
                                "sense_id": "4c37d040-75da-3743-8a68-672667bd0d27",
                                "text": "En vertu de leur droit de seigneuriage, ils abaissaient tout simplement le titre ou le poids de leurs monnaies tout en leur conservant le cours légal."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d48bd4a-5fcf-3b3c-b586-fa1ed4ad3290",
                        "entry_id": "0fae1bc0-6d03-3847-909a-1c7efae1b925",
                        "glosses": [
                            "Revenu qui découle, pour l'émetteur, de l'émission d'une monnaie."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "809d6dd5-09d6-4ca7-9a20-851d7b5f9431",
                                "sense_id": "6d48bd4a-5fcf-3b3c-b586-fa1ed4ad3290",
                                "text": "Les revenus du seigneuriage permettent au gouvernement de financer une partie de ses dépenses sans avoir à percevoir de taxes ou d'impôts."
                            },
                            {
                                "example_id": "b75c90f9-c8c7-484b-8add-a6e2a4e23bf1",
                                "sense_id": "6d48bd4a-5fcf-3b3c-b586-fa1ed4ad3290",
                                "text": "Comme ce poids a été calculé pour être représentatif de l’importance économique des pays membres, chacun d’eux reçoit donc une fraction du seigneuriage européen qui correspond à son poids relatif au sein de l'UEM."
                            },
                            {
                                "example_id": "580a3175-a040-48ad-8143-091c11ec0f52",
                                "sense_id": "6d48bd4a-5fcf-3b3c-b586-fa1ed4ad3290",
                                "text": "Cette prise de pouvoir est le résultat normal octroyé par les avantages dus au transfert du seigneuriage, suite à la privatisation de la création de la monnaie bancaire. La chose n’a été possible que par une volonté politique de la communauté internationale qui a mis fin au Gold-exchange standard et a imposé aux pays de contracter les dettes publiques auprès du fameux « marché »."
                            },
                            {
                                "example_id": "637d70a3-cb6e-4c93-a9e2-81dc164040e5",
                                "sense_id": "6d48bd4a-5fcf-3b3c-b586-fa1ed4ad3290",
                                "text": "Pour les banques centrales de nombreux pays émergents et en développement, le seigneuriage est la principale source de recettes et une garantie majeure d’indépendance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74996476-a19b-4450-a3ea-6c14a31bcfac",
                        "source_entry_id": "0fae1bc0-6d03-3847-909a-1c7efae1b925",
                        "target_lang_word": "seigniorage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seigniorage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "961e22fe-41dd-32ed-9add-7528d18645dc",
                                        "entry_id": "e932b227-ab98-3bbd-aeb1-9feecefb2655",
                                        "glosses": [
                                            "All the revenue obtained by a feudal lord from his vassals."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fb8a54b-25f6-41bd-b689-e0e70951a650",
                                                "sense_id": "961e22fe-41dd-32ed-9add-7528d18645dc",
                                                "text": "I will tell you. First, he comes regularly to take his rights of seigniorage, his rents, his taxes, his fourths of all the produce of his vineyards and arable lands on our Côte d'Or."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53670bda-8ec8-3162-86ab-ae646c8f8a8f",
                                        "entry_id": "e932b227-ab98-3bbd-aeb1-9feecefb2655",
                                        "glosses": [
                                            "The revenue obtained directly by minting coin (difference between face value and cost of metal)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc35c62d-64bd-4446-81a8-18d8567cc86b",
                                                "sense_id": "53670bda-8ec8-3162-86ab-ae646c8f8a8f",
                                                "text": "If Government, however, throws the expense of coinage, as is reasonable, upon the holder, by making a charge to cover the expense (which is done by giving back rather less in coin than has been received in bullion, and is called levying a seigniorage), the coin will rise, to the extent of the seigniorage, above the value of the bullion."
                                            },
                                            {
                                                "example_id": "62ee3170-3d9d-45ab-8572-40d2b96ed9f6",
                                                "sense_id": "53670bda-8ec8-3162-86ab-ae646c8f8a8f",
                                                "text": "The old kingly prerogative of altering the coinage was taken away, the unit of the currency was declared definite and unchangeable, and the seigniorage on minting was abolished."
                                            },
                                            {
                                                "example_id": "2fea4786-6ddf-47ca-a050-0a7e20e7f287",
                                                "sense_id": "53670bda-8ec8-3162-86ab-ae646c8f8a8f",
                                                "text": "As a result of the lower than expected production, the mint has halved the amount it provides to government coffers through seigniorage, which is the difference between the face value of a coin sold to the banks and its cost of production."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfc843ca-1f36-35c9-9e57-7bff7e2193b3",
                                        "entry_id": "e932b227-ab98-3bbd-aeb1-9feecefb2655",
                                        "glosses": [
                                            "The revenue obtained by the difference between interest earned on securities acquired in exchange for bank notes and the costs of producing and distributing those notes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
