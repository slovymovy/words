                ],
                "senses": [
                    {
                        "sense_id": "a4b81ba3-3f64-3b17-a074-7d21d95fe09d",
                        "entry_id": "eebdb141-4896-37cd-8ca3-da553680a707",
                        "glosses": [
                            "jemand, der unter Androhung von Gewalt/Anwendung von Gewalt in fremdes Hoheitsgebiet eindringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5842afa4-9ae9-43b1-bf13-4c9355bde38b",
                                "sense_id": "a4b81ba3-3f64-3b17-a074-7d21d95fe09d",
                                "text": "„Nur wenige Tage später siegen die Invasoren südlich von York über das Heer der Regionalfürsten.“"
                            },
                            {
                                "example_id": "ecf5f92e-4124-48e9-98c5-135a805eb284",
                                "sense_id": "a4b81ba3-3f64-3b17-a074-7d21d95fe09d",
                                "text": "„Viele Einheimische übernehmen Sprache und Religion der Invasoren, die die Region fortan dominieren (auch wenn sich manche Stämme von der Vorherrschaft lösen können).“"
                            },
                            {
                                "example_id": "b6c191c9-442c-47c7-854b-1376713da0c0",
                                "sense_id": "a4b81ba3-3f64-3b17-a074-7d21d95fe09d",
                                "text": "„Die Einnahme der Städte hat den Invasoren nichts gebracht.“"
                            },
                            {
                                "example_id": "d3bede0b-d6e8-41eb-8d58-3ea61eb4975b",
                                "sense_id": "a4b81ba3-3f64-3b17-a074-7d21d95fe09d",
                                "text": "„Um ihr Überleben zu sichern, musste sie sukzessive ihren Hausrat verkaufen, später sogar bei den verhassten britischen Invasoren Geld leihen.“"
                            },
                            {
                                "example_id": "39e88aa6-19a0-4817-a600-64c52d52b8fd",
                                "sense_id": "a4b81ba3-3f64-3b17-a074-7d21d95fe09d",
                                "text": "„Dabei kam Orissa die Struktur seiner Landschaft zugute, die es für Invasoren recht unzugänglich macht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d69c3ecf-87f9-3e82-be5b-1e10534bb8a8",
                        "entry_id": "eebdb141-4896-37cd-8ca3-da553680a707",
                        "glosses": [
                            "jemand/etwas, der/das an einem Ort unerwünscht massenhaft auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e45d5da-1c2a-4968-8211-a5c5368e09f0",
                                "sense_id": "d69c3ecf-87f9-3e82-be5b-1e10534bb8a8",
                                "text": "Der aus dem Kaukasus stammende Riesenbärenklau ist ein Invasor in Deutschland, der wegen seiner Giftigkeit bekämpft wird."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
