                ],
                "senses": [
                    {
                        "sense_id": "c6a46a08-7f0c-3a94-910c-77bb8d2d2000",
                        "entry_id": "1868fa91-5b87-3754-bed2-c1050844fbfa",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b93dd2a0-aed1-4c99-9d4a-1d87a7d4eeb4",
                                "sense_id": "c6a46a08-7f0c-3a94-910c-77bb8d2d2000",
                                "text": "Frau Wäckerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0103c74e-7e78-48dc-bdb7-16848792ce7b",
                                "sense_id": "c6a46a08-7f0c-3a94-910c-77bb8d2d2000",
                                "text": "Herr Wäckerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1b4ef08a-e05d-4bf6-b70b-2c3bbbf7d1f8",
                                "sense_id": "c6a46a08-7f0c-3a94-910c-77bb8d2d2000",
                                "text": "Die Wäckerles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "01101f9d-0b7b-4c56-a53b-8b79da0298c9",
                                "sense_id": "c6a46a08-7f0c-3a94-910c-77bb8d2d2000",
                                "text": "Der Wäckerle trägt nie die Schals, die die Wäckerle ihm strickt."
                            },
                            {
                                "example_id": "a48ecadf-57e3-400a-8a20-b216bb329135",
                                "sense_id": "c6a46a08-7f0c-3a94-910c-77bb8d2d2000",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wäckerle kommt, geht der Herr Wäckerle.“"
                            },
                            {
                                "example_id": "e8810b87-7e31-4ef9-ae05-8547e5139caa",
                                "sense_id": "c6a46a08-7f0c-3a94-910c-77bb8d2d2000",
                                "text": "Wäckerle kommt und geht."
                            },
                            {
                                "example_id": "2793621e-4758-4836-98d8-04d47c31c246",
                                "sense_id": "c6a46a08-7f0c-3a94-910c-77bb8d2d2000",
                                "text": "Wäckerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
