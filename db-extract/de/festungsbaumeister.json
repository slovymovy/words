                "senses": [
                    {
                        "sense_id": "63dd022d-57f3-3e24-a007-7db2d167747b",
                        "entry_id": "da39145c-f1f3-3f34-82ca-d601e2603172",
                        "glosses": [
                            "einer Festung zugeteilter Baumeister, welcher der Kriegsbaukunst mächtig ist und den Festungsbau vorantreibt"
                        ],
                        "tags": [
                            "Berufsbezeichnung"
                        ],
                        "examples": [
                            {
                                "example_id": "a55e51cc-a979-4be5-b3f7-91259ee6691c",
                                "sense_id": "63dd022d-57f3-3e24-a007-7db2d167747b",
                                "text": "„Sébastien Le Prestre, Seigneur de Vauban war ein französischer General, Festungsbaumeister Ludwigs XIV. und Marschall von Frankreich.“"
                            },
                            {
                                "example_id": "f192a8f9-1842-4b9f-aaf0-738b8911c434",
                                "sense_id": "63dd022d-57f3-3e24-a007-7db2d167747b",
                                "text": "„1577 wurde Irmisch als Nachfolger des Grafen Lynar zum Kurfürstlichen Festungsbaumeister ernannt, leitete ab1579 die Umbauten der Dresdner Münze und am Wilschner Tor sowie den Bau des Stallhofes (1586-1591) und die Anlage des kleinen Schlosshofes der Residenz mit zweigeschossigem Torhaus und Laubengang.“"
                            },
                            {
                                "example_id": "bfa7439b-4b4d-4ab8-bec3-ad46dc4db363",
                                "sense_id": "63dd022d-57f3-3e24-a007-7db2d167747b",
                                "text": "„Beim Bau der einen Burgbastei in Nürnberg 1538 bis 1545 war er dem Malteser Festungsbaumeister Antonio Fazuni untergeordnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
