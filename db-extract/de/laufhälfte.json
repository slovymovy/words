                "senses": [
                    {
                        "sense_id": "401dabf9-5e38-3cad-ac7d-fdd68c77d01c",
                        "entry_id": "56b7297b-0d3f-39a9-9150-6e8df727f592",
                        "glosses": [
                            "einer der beiden ungefähr gleich langen Abschnitte einer Laufstrecke/Laufeinheit"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "d3b7ac38-d5c8-478e-a9ef-83811f2d669e",
                                "sense_id": "401dabf9-5e38-3cad-ac7d-fdd68c77d01c",
                                "text": "„In seinem Lauf gelang es ihm dennoch, aufbauend auf einem gelungenen Start und einer guten ersten Laufhälfte, das Tempo auch im zweiten Abschnitt des Rennens hoch zu halten, Mit seinem Signaturmove, dem perfekten Zieleinlauf, schnappte er seinem Konkurrenten mit einem winzigen Hundertstel den Treppchenplatz weg und wurde Dritter in 11,43s und trotz spürbaren Gegenwinds.“"
                            },
                            {
                                "example_id": "a16a47c1-26cf-45fd-9713-a63e9c919bdc",
                                "sense_id": "401dabf9-5e38-3cad-ac7d-fdd68c77d01c",
                                "text": "„Erfahrungswerte zeigen, dass die besten Zeiten mit einer leicht schnelleren oder gleich schnellen zweiten Laufhälfte erzielt werden.“"
                            },
                            {
                                "example_id": "5b93e0a8-88af-4707-a2cc-ad2febfdfc6e",
                                "sense_id": "401dabf9-5e38-3cad-ac7d-fdd68c77d01c",
                                "text": "„Auf der zweiten Laufhälfte pendelte sich Blummenfelts Pace dann bei 3:50 Minuten pro Kilometer ein, ehe er kurz vor dem Ziel noch mal die Geschwindigkeit steigerte.“"
                            },
                            {
                                "example_id": "23a2d25b-6fbd-4985-91c6-b272d7abf816",
                                "sense_id": "401dabf9-5e38-3cad-ac7d-fdd68c77d01c",
                                "text": "„Da habe ich es mit dir, lieber einen holprigen Beginn und eine gute zweite Laufhälfte!“"
                            },
                            {
                                "example_id": "8fc4092f-57d5-431a-b716-6fb505cdb712",
                                "sense_id": "401dabf9-5e38-3cad-ac7d-fdd68c77d01c",
                                "text": "„Ab der zweiten Laufhälfte merkte man dann jedoch, warum der New York Marathon sich nicht als bestzeitentauglich erweist (wenn man es darauf anlegt).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
