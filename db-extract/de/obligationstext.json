                "senses": [
                    {
                        "sense_id": "3300ee81-3376-3c01-8ddc-7bc0e808dd13",
                        "entry_id": "5721d2be-761a-3a8c-8b29-266c2366f0ff",
                        "glosses": [
                            "Text, dessen hauptsächliche Textfunktion darin besteht, dass der Sprecher/ Schreiber sich auf eine zukünftige Handlung oder Unterlassung festlegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc262e82-18fe-4662-ab51-a16317ce0ca1",
                                "sense_id": "3300ee81-3376-3c01-8ddc-7bc0e808dd13",
                                "text": "Auftragsbestätigungen sind Obligationstexte, da ihre Hauptfunktion darin besteht, dass der Auftragnehmer die Durchführung der vereinbarten Leistung zusagt."
                            },
                            {
                                "example_id": "39f6b4a1-7cf9-49b0-b708-2fb96db163c6",
                                "sense_id": "3300ee81-3376-3c01-8ddc-7bc0e808dd13",
                                "text": "„Seine Anwendung führt zur Unterscheidung der folgenden fünf Textklassen: …- Obligationstexte (Vertrag, Garantieschein, Gelöbnis)…“"
                            },
                            {
                                "example_id": "e465e9fd-a871-452f-9ed7-e59d03574186",
                                "sense_id": "3300ee81-3376-3c01-8ddc-7bc0e808dd13",
                                "text": "„Man könnte aufgrund des offiziellen Charakters einer mündlichen Prüfung, der durch die Protokollführung noch verschärft wird, von einem Obligationstext sprechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
