                            {
                                "target_word": "ironing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24e8d78b-55bb-3597-9973-7bb35e2edc4f",
                                        "entry_id": "4724947d-bd7e-35f3-b039-826c845b96bb",
                                        "glosses": [
                                            "The act of pressing clothes with an iron, such as a steam iron."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddedbecf-dfe0-4ea9-890e-dfcf96d73236",
                                                "sense_id": "24e8d78b-55bb-3597-9973-7bb35e2edc4f",
                                                "text": "I hate ironing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc992696-fcca-39f6-9187-fd7992d2f4e6",
                                        "entry_id": "4724947d-bd7e-35f3-b039-826c845b96bb",
                                        "glosses": [
                                            "Laundry that has been washed and is ready to be ironed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ee13768-9938-49b3-b940-3680038f3a16",
                                                "sense_id": "fc992696-fcca-39f6-9187-fd7992d2f4e6",
                                                "text": "I really should make a start on the ironing soon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d77e494-b505-37fc-94d8-40225a6e3560",
                                        "entry_id": "4724947d-bd7e-35f3-b039-826c845b96bb",
                                        "glosses": [
                                            "Laundry that has recently been ironed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1607915b-baf7-4592-98b3-89cc4077f4ff",
                                                "sense_id": "8d77e494-b505-37fc-94d8-40225a6e3560",
                                                "text": "I really should put the ironing away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ca05974-b166-401c-97cf-8abecbc395c0",
                        "source_entry_id": "877040ae-e165-3a48-afe2-fed80b49ce80",
                        "source_sense_id": "97eb3c77-9fc8-3fbb-989b-d607115d0c97",
                        "target_lang_word": "room",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd08f56c-27f0-3ba4-b8c9-448d27afae49",
                                        "entry_id": "8c8ab532-fae5-3247-a2cb-cffb31a3dfa6",
                                        "glosses": [
                                            "An opportunity or scope (to do something)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aac3b0c5-f618-4b36-a862-6197fa1e0172",
                                                "sense_id": "dd08f56c-27f0-3ba4-b8c9-448d27afae49",
                                                "text": "Thou lorde whiche knowest the hertes of all men, shewe whether thou hast chosen of these two, that the one maye take the roume of this ministracion, and apostleshippe from the which Judas by transgression fell, that he myght goo to his awne place."
                                            },
                                            {
                                                "example_id": "a4e902a3-53cc-42ae-b004-cfe9e1854601",
                                                "sense_id": "dd08f56c-27f0-3ba4-b8c9-448d27afae49",
                                                "text": "Nor shalt thou give me room to doubt whether it be necessity or love, that inspires this condescending impulse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85cb6b7f-68a4-3185-b7f5-183be51ad69d",
                                        "entry_id": "8c8ab532-fae5-3247-a2cb-cffb31a3dfa6",
                                        "glosses": [
                                            "Space for something, or to carry out an activity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29cb2f52-e5d0-4b8a-a01c-f54e0a61c29b",
                                                "sense_id": "85cb6b7f-68a4-3185-b7f5-183be51ad69d",
                                                "text": "He explains they have enough room to stand and lie down, points out the \"little cup to brush our teeth\", and the place where they pray."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cb75cbc-b5a7-3d05-b9d2-3c125257f20c",
                                        "entry_id": "8c8ab532-fae5-3247-a2cb-cffb31a3dfa6",
                                        "glosses": [
                                            "A particular portion of space."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d230d00-2ce5-4d2c-b6f6-a69bdb901a29",
                                                "sense_id": "1cb75cbc-b5a7-3d05-b9d2-3c125257f20c",
                                                "text": "If he have but twelve pence in his purse, he will give it for the best room in a playhouse."
                                            },
                                            {
                                                "example_id": "ebd81fcd-47f9-4b32-986b-1a2d34593bbc",
                                                "sense_id": "1cb75cbc-b5a7-3d05-b9d2-3c125257f20c",
                                                "text": "When thou art bidden of any man to a wedding, sit not down in the highest room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "987711b4-2699-372b-9ab4-9ec313caa687",
                                        "entry_id": "8c8ab532-fae5-3247-a2cb-cffb31a3dfa6",
                                        "glosses": [
                                            "Sufficient space for or to do something."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f819db7-6373-4a69-93f9-bdece3028a84",
                                                "sense_id": "987711b4-2699-372b-9ab4-9ec313caa687",
                                                "text": "There was no prince in the empire who had room for such an alliance."
                                            },
                                            {
                                                "example_id": "c194608d-f9bc-476a-a16a-c486b4495541",
                                                "sense_id": "987711b4-2699-372b-9ab4-9ec313caa687",
                                                "text": "There are major disagreements within the Coalition and politicians always want to retain room for manoeuvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d431be2-b9e1-35d1-815c-218382d52580",
                                        "entry_id": "8c8ab532-fae5-3247-a2cb-cffb31a3dfa6",
                                        "glosses": [
                                            "A space between the timbers of a ship's frame."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4733c19-2295-3699-8457-a7940c5ced1f",
                                        "entry_id": "8c8ab532-fae5-3247-a2cb-cffb31a3dfa6",
                                        "glosses": [
                                            "A place; a stead."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a82aed4-a2ca-4293-919c-e47645e0152b",
                                                "sense_id": "f4733c19-2295-3699-8457-a7940c5ced1f",
                                                "text": "For this purpose I have shown that no acquisitions of guilt can compensate the loss of that solid inward comfort of mind, which is the sure companion of innocence and virtue; nor can in the least balance the evil of that horror and anxiety which, in their room, guilt introduces into our bosoms."
                                            },
                                            {
                                                "example_id": "566ba0de-d996-4fe4-a599-68ac5ee24503",
                                                "sense_id": "f4733c19-2295-3699-8457-a7940c5ced1f",
                                                "text": "A ram was accepted as a vicarious sacrifice in room of the royal victim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "230137f4-c0fe-3041-b3ce-8420211d5d89",
                                        "entry_id": "8c8ab532-fae5-3247-a2cb-cffb31a3dfa6",
                                        "glosses": [
                                            "A separate part of a building, enclosed by walls, a floor and a ceiling."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd87d96c-380b-475f-bc34-21d1654f50e9",
                                                "sense_id": "230137f4-c0fe-3041-b3ce-8420211d5d89",
                                                "text": "Miss Bingley made no answer, and soon afterwards she got up and walked about the room."
                                            },
                                            {
                                                "example_id": "dc98e71b-718d-45c1-8b65-3c21c24a007f",
                                                "sense_id": "230137f4-c0fe-3041-b3ce-8420211d5d89",
                                                "text": "He looked round the poor room, at the distempered walls, and the bad engravings in meretricious frames, the crinkly paper and wax flowers on the chiffonier; and he thought of a room like Father Bryan's, with panelling, with cut glass, with tulips in silver pots, such a room as he had hoped to have for his own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5310b731-438f-30dd-8f42-287444d915bd",
                                        "entry_id": "8c8ab532-fae5-3247-a2cb-cffb31a3dfa6",
                                        "glosses": [
                                            "(One's) bedroom."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f09b22d-4063-4fd8-8259-d468a0d90f97",
                                                "sense_id": "5310b731-438f-30dd-8f42-287444d915bd",
                                                "text": "Go to your room!"
                                            },
                                            {
                                                "example_id": "128ff04a-1c92-432b-a83f-e468abef11b8",
                                                "sense_id": "5310b731-438f-30dd-8f42-287444d915bd",
                                                "text": "She was so mad she wouldn't speak to me for quite a spell, but at last I coaxed her into going up to Miss Emmeline's room and fetching down a tintype of the missing Deacon man."
                                            },
                                            {
                                                "example_id": "a2b5ea28-19f2-4258-8d34-73e1164c2094",
                                                "sense_id": "5310b731-438f-30dd-8f42-287444d915bd",
                                                "text": "‘No. I only opened the door a foot and put my head in. The street lamps shine into that room. I could see him. He was all right. Sleeping like a great grampus. Poor, poor chap.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e393f70f-6634-37eb-aa8d-e0585fd169d7",
                                        "entry_id": "8c8ab532-fae5-3247-a2cb-cffb31a3dfa6",
                                        "glosses": [
                                            "A set of rooms inhabited by someone; one's lodgings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e01ad3d6-37df-3aca-a4a5-36118a3b5d16",
                                        "entry_id": "8c8ab532-fae5-3247-a2cb-cffb31a3dfa6",
                                        "glosses": [
                                            "The people in a room."
                                        ],
                                        "tags": [
                                            "countable",
                                            "metonymically",
                                            "singular",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4257fa2-811a-426a-8fb4-267435f76298",
                                                "sense_id": "e01ad3d6-37df-3aca-a4a5-36118a3b5d16",
                                                "text": "The room was on its feet."
                                            },
                                            {
                                                "example_id": "02970404-7cd0-4a40-9c97-6a971ccf93f3",
                                                "sense_id": "e01ad3d6-37df-3aca-a4a5-36118a3b5d16",
                                                "text": "He was good at reading rooms."
                                            },
                                            {
                                                "example_id": "9f2d1e16-367e-4884-be87-cc46ea9b6de1",
                                                "sense_id": "e01ad3d6-37df-3aca-a4a5-36118a3b5d16",
                                                "text": "It was fun to watch her work the room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d08e8835-2b3f-3ce2-8576-a6ac1ee29bb9",
                                        "entry_id": "8c8ab532-fae5-3247-a2cb-cffb31a3dfa6",
                                        "glosses": [
                                            "An area for working in a coal mine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2519ea00-f182-3fda-8a29-ebd1ea653842",
                                        "entry_id": "8c8ab532-fae5-3247-a2cb-cffb31a3dfa6",
                                        "glosses": [
                                            "A portion of a cave that is wider than a passage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58a2f62c-e141-39f2-8d58-931cc9c69821",
                                        "entry_id": "8c8ab532-fae5-3247-a2cb-cffb31a3dfa6",
                                        "glosses": [
                                            "An IRC or chat room."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea22144e-0e75-41a1-8163-3835a3650700",
                                                "sense_id": "58a2f62c-e141-39f2-8d58-931cc9c69821",
                                                "text": "Some users may not be able to access the AOL room."
                                            },
                                            {
                                                "example_id": "edcd29cc-982c-47fc-958b-d275501d5f8c",
                                                "sense_id": "58a2f62c-e141-39f2-8d58-931cc9c69821",
                                                "text": "Here in the room we are as one / Together you and me, together you and me / Hours connect / As we switch on"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfbd597b-c62e-3645-b1e6-a0e7dad706e8",
                                        "entry_id": "8c8ab532-fae5-3247-a2cb-cffb31a3dfa6",
                                        "glosses": [
                                            "A place or position in society; office; rank; post, sometimes when vacated by its former occupant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3867bb3-63c0-444a-b6df-d9278ad41de6",
                                                "sense_id": "dfbd597b-c62e-3645-b1e6-a0e7dad706e8",
                                                "text": "When ſhee that rules in Rhamnis golden gates, […]\nShall make me ſolely Emperour of Aſia,\nThen ſhall your meeds and vallours be aduaunſt\nTo roomes of honour and Nobilitie."
                                            },
                                            {
                                                "example_id": "a6ec28ec-bd71-4cef-8d92-4ce31b559c3e",
                                                "sense_id": "dfbd597b-c62e-3645-b1e6-a0e7dad706e8",
                                                "text": "Let Bianca take her sister's room."
                                            },
                                            {
                                                "example_id": "89c5ac68-efe4-44ce-b0ad-0414d30e68e5",
                                                "sense_id": "dfbd597b-c62e-3645-b1e6-a0e7dad706e8",
                                                "text": "When he heard that Archelaus did reign in Judea in the room of his father Herod."
                                            },
                                            {
                                                "example_id": "09f39725-825b-435d-94bf-9c0348f9ed1a",
                                                "sense_id": "dfbd597b-c62e-3645-b1e6-a0e7dad706e8",
                                                "text": "Neither that I look for a higher room in heaven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18fa3f1b-276c-3d35-af78-d9a26adac1cd",
                                        "entry_id": "8c8ab532-fae5-3247-a2cb-cffb31a3dfa6",
                                        "glosses": [
                                            "A quantity of furniture sufficient to furnish one room."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d597cfc2-8268-42bf-9e3e-9f3af08434b5",
                                                "sense_id": "18fa3f1b-276c-3d35-af78-d9a26adac1cd",
                                                "text": "“I understand you need some furniture and can’t get no credit.” I liked to fell over. He say, “I’ll give you all the credit you want, but you got to pay the interest on it.” I told him, “Give me three rooms worth and charge whatever you want.”"
                                            }
                                        ]
                                    }
