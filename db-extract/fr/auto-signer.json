                ],
                "senses": [
                    {
                        "sense_id": "5cb85732-3090-3ffe-a978-8c24e8fe3607",
                        "entry_id": "cb57012a-4a3a-3a30-b765-1c644a0d689f",
                        "glosses": [
                            "Signer un certificat soi-même, sans passer par une autorité de certification."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b96bf57-697a-4116-b81b-ab2216814de9",
                                "sense_id": "5cb85732-3090-3ffe-a978-8c24e8fe3607",
                                "text": "Ce tutoriel a pour but de vous apprendre à auto-signer vos certificats SSL pour vos pages web."
                            },
                            {
                                "example_id": "8ddabbaa-30c4-4231-bc31-12b64755e72e",
                                "sense_id": "5cb85732-3090-3ffe-a978-8c24e8fe3607",
                                "text": "La solution pour contourner le problème consiste à auto-signer l’archive."
                            },
                            {
                                "example_id": "9385a552-9628-49a8-b15d-44cfec091d1b",
                                "sense_id": "5cb85732-3090-3ffe-a978-8c24e8fe3607",
                                "text": "Par conséquent, si vous souhaitez auto-signer des mises à jour au moyen d’un certificat généré par l’outil ADT, conservez en lieu sûr le certificat d’origine."
                            }
                        ]
                    },
