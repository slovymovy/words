                        ],
                        "examples": [
                            {
                                "example_id": "18c475a6-2801-4a94-841f-540c8e5c2860",
                                "sense_id": "16e074e6-1cc9-39be-b707-8f6d865c105f",
                                "text": "Je pourrais continuer comme ça en pouahsie ça va plus vite que de pondre de vile prose et l’on peut tirer à la ligne en faisant son petit Xanrof"
                            },
                            {
                                "example_id": "291169ea-dca8-4ded-85fd-c03a4016258a",
                                "sense_id": "16e074e6-1cc9-39be-b707-8f6d865c105f",
                                "text": "Ce que Flaubert appelle le pohétique, Cohen le dénonce plus violemment encore dans la pouahsie, terme qui se réfère aux représentations stéréotypées de la passion comme à un discours poétique obligé : c’est la corvée de l’« exégèse lyrique », des « mammifères amoureux à langage articulé », qui rappelle la « corvée » stendhalienne."
                            }
                        ]
