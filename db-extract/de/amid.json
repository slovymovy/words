                "senses": [
                    {
                        "sense_id": "d88a59ce-8aea-3100-89d0-cf4890acee72",
                        "entry_id": "49513c70-7256-3210-be9e-19a9a22d8527",
                        "glosses": [
                            "Composé issu de la réaction de condensation entre un acide et une amine : amide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce9d9a78-9d60-4722-852a-81bcdf308a08",
                                "sense_id": "d88a59ce-8aea-3100-89d0-cf4890acee72",
                                "text": "Kovalente Amide zahlen zu den wichtigen durch Kondensationreaktionen gebildeten Verbindungen.",
                                "translation": "Les amides comptent parmi les composés importants issus de réactions de condensation."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8736bd2-de76-3702-bdf7-c4239638b910",
                        "entry_id": "49513c70-7256-3210-be9e-19a9a22d8527",
                        "glosses": [
                            "Ion amidure, base conjuguée de l'ammoniac, et ses sels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a7cfef8-1d35-4f3a-a0d8-41702699465a",
                                "sense_id": "f8736bd2-de76-3702-bdf7-c4239638b910",
                                "text": "Ein Beispiel eines ionischen Amids ist das Natriumamid, das in der organischen Chemie als starke Base angewandt wird.",
                                "translation": "Un exemple d'amidure est l'amidure de sodium, qui est utilisé en chimie organique comme base forte."
                            }
                        ]
                    }
                ],
