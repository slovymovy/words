                "senses": [
                    {
                        "sense_id": "e74cfe1d-24f2-3564-8e2c-51fe14f119f1",
                        "entry_id": "f147ff0a-0886-3413-82c4-0da1cc81bdc2",
                        "glosses": [
                            "A very high mountain. Specifically, one of the Alps, the highest chain of mountains in Europe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d89e09bc-c69e-4cd5-ad41-4e0d9bafad72",
                                "sense_id": "e74cfe1d-24f2-3564-8e2c-51fe14f119f1",
                                "text": "Nor breath of Vernal Air from ſnowy Alp."
                            },
                            {
                                "example_id": "9b4b564e-cde0-4a49-9e35-169b92005eec",
                                "sense_id": "e74cfe1d-24f2-3564-8e2c-51fe14f119f1",
                                "text": "Hills peep o'er Hills, and Alps on Alps ariſe!"
                            },
                            {
                                "example_id": "b43381da-a422-4537-8830-e41a67f0ff02",
                                "sense_id": "e74cfe1d-24f2-3564-8e2c-51fe14f119f1",
                                "text": "There is a great alp of sand, one hundred metres high, between the pines and the ocean, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "4ae58dc8-886b-3915-8704-48e8162647a4",
                        "entry_id": "f147ff0a-0886-3413-82c4-0da1cc81bdc2",
                        "glosses": [
                            "An alpine meadow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "953bb6a4-39bf-4ada-b518-2240cf1668ee",
                                "sense_id": "4ae58dc8-886b-3915-8704-48e8162647a4",
                                "text": "At the alp of Khyarkuti, a wide flat at the junction of several glens[…]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61d3f327-0407-444b-9889-611ffef33f44",
                        "source_entry_id": "f147ff0a-0886-3413-82c4-0da1cc81bdc2",
                        "source_sense_description": "very high mountain",
                        "target_lang_word": "Alm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00c86969-dccb-322d-abff-9f80e1ee52c5",
                                        "entry_id": "310b9d74-ba2d-3f49-955a-b7c05bb645d9",
                                        "glosses": [
                                            "Bergweide oder Bergwiese, auf der im Sommer Weidewirtschaft, gegebenenfalls auch Gastronomie und Bewirtung betrieben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91227d3a-c9e0-4d19-a449-8022ed1e5b49",
                                                "sense_id": "00c86969-dccb-322d-abff-9f80e1ee52c5",
                                                "text": "Der Hirte führte seine Schafe und Lämmer auf die Alm hinaus, um sie grasen zu lassen."
                                            },
                                            {
                                                "example_id": "594fc3de-20d7-4f60-ae03-24ee986dba84",
                                                "sense_id": "00c86969-dccb-322d-abff-9f80e1ee52c5",
                                                "text": "„Da gab's dann bald mehr Diskos als Kühe in den Dörfern, in den Landgasthöfen sprudelten die Whirlpools, und die Sennerinnen wurden mit dem Paragleiter auf die Alm geflogen.“"
                                            },
                                            {
                                                "example_id": "ab4cd08b-4efc-4aec-9170-3db8ab8d6705",
                                                "sense_id": "00c86969-dccb-322d-abff-9f80e1ee52c5",
                                                "text": "„Mit zwei Wanderstöcken in den Fäusten spaziert sie an einem Sommertag im Jahr 2020 bedächtig über grüne Almen zur Wallfahrtskapelle Maria Birkenstein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
