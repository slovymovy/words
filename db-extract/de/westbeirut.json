                ],
                "senses": [
                    {
                        "sense_id": "dfdcd7a1-8a68-3dd6-a053-62fdabec8847",
                        "entry_id": "a1f5afa8-4db0-3705-b334-c4e3d488fdea",
                        "glosses": [
                            "westliche Stadtteile von Beirut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "299d4ef3-5b3e-402c-b9da-585200687844",
                                "sense_id": "dfdcd7a1-8a68-3dd6-a053-62fdabec8847",
                                "text": "„Mitten in diesem zweiten Telefonat erklang von einer nahe gelegenen Moschee der Gebetsruf des Muezzins, der von einem halben Dutzend anderer Minarette in Westbeirut aus wiederholt wurde.“"
                            },
                            {
                                "example_id": "ddd54908-6827-4068-9c89-a8619ea44a26",
                                "sense_id": "dfdcd7a1-8a68-3dd6-a053-62fdabec8847",
                                "text": "„Für die Palästinenser begann der Krieg jedoch zwei Jahre zuvor, am 10. April 1973, mit der Ermordung dreier PLO-Führer in ihren Häusern in Westbeirut durch israelische Kommandos unter der Führung von Ehud Barak (dem späteren israelischen Premierminister).“"
                            },
                            {
                                "example_id": "ff5e0f41-d8b8-4698-873b-a3a2fa560354",
                                "sense_id": "dfdcd7a1-8a68-3dd6-a053-62fdabec8847",
                                "text": "„Rapp lenkte sich von seinem Ärger ab, indem er Karten von Westbeirut studierte, sich in Geheimdienst-Berichte vertiefte und nach einer Möglichkeit forschte, ein ähnliches Desaster wie bei früheren Lösegeld-Verhandlungen zu verhindern.“"
                            },
                            {
                                "example_id": "ec1c488d-b519-44a9-9931-4496f957dc9a",
                                "sense_id": "dfdcd7a1-8a68-3dd6-a053-62fdabec8847",
                                "text": "„Die zahlenmäßig stark angewachsenen Fedayin erlaubten sich nun, die ihnen durch das Kairo-Abkommen gewährten Freiheiten nach Belieben auszulegen, und dehnten ihre Aktivitäten auch auf dafür nicht vorgesehene Gebiete wie etwa Westbeirut aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
