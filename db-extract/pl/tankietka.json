                        ]
                    },
                    {
                        "translation_id": "1f964f4a-a5eb-4cb0-b134-db2e96e79892",
                        "source_entry_id": "c4e47197-3d06-3ae4-8682-54649216802b",
                        "source_sense_id": "08b8d84a-4b28-3bd9-9380-b0f340d931f9",
                        "target_lang_word": "chenillette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chenillette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b444f58-e7ce-3c84-bbab-baa503eb9f28",
                                        "entry_id": "18c173e8-fabb-3d43-b240-cc30c7db299c",
                                        "glosses": [
                                            "Plante fourragère de la famille des Fabacées (ou Légumineuses), ainsi nommée parce qu’elle produit une gousse roulée sur elle-même et de la figure d’une chenille. Genre Scorpiurus L."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd61d6d5-50e8-4757-92f1-9485afd665cd",
                                                "sense_id": "2b444f58-e7ce-3c84-bbab-baa503eb9f28",
                                                "text": "Chenillette (Scorpiurus), Queue de scorpion, Vermiculaire, Chenille muriquée, Scorpionne. Petites plantes annuelles, herbacées, voisines des Luzernes (Medicago), que l’on sème sur place terreautée, et que l’on cultive pour la bizarrerie de leurs fruits, qui sont hérissés, écailleux, sillonnés, et imitent parfaitement une chenille, quelquefois un limaçon ou un ver. On les met dans la salade pour surprendre les personnes qui ne connaissent pas ces singulières plantes. Les graines sont très difficiles à extraire des gousses ; il faut déchirer celles-ci pour parvenir à extraire celles-là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab2ff386-559b-3263-8b38-b636f31019b7",
                                        "entry_id": "18c173e8-fabb-3d43-b240-cc30c7db299c",
                                        "glosses": [
                                            "Segment de base d'une chenille de véhicule."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "334ff34f-11fa-3a99-8f7f-1e2e459f0036",
                                        "entry_id": "18c173e8-fabb-3d43-b240-cc30c7db299c",
                                        "glosses": [
                                            "Genre de véhicule de combat chenillé légèrement armé et blindé ressemblant à un petit char, aux dimensions avoisinant celles d'une voiture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67a14b15-6b89-3baa-93b2-e1d8e947e66f",
                                        "entry_id": "18c173e8-fabb-3d43-b240-cc30c7db299c",
                                        "glosses": [
                                            "Dameuse."
                                        ],
                                        "tags": [
                                            "Sports d’hiver"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c94b70e3-de1b-4af4-9fd6-cfe2a6ae8efd",
                                                "sense_id": "67a14b15-6b89-3baa-93b2-e1d8e947e66f",
                                                "text": "Un homme de Saguenay qui a passé la dernière décennie à mettre au point une chenillette électrique pourra finalement commencer à récolter bientôt les fruits de son labeur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
