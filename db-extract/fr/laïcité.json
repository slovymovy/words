                    {
                        "translation_id": "3b17776d-f091-4b6a-b843-47aa720e1db3",
                        "source_entry_id": "79a7728a-474c-35d8-8d19-aa0deea1c74b",
                        "target_lang_word": "светскость",
                        "target_lang_code": "ru",
