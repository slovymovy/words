{
    "word_family": [
        "wooden",
        "woody",
        "woodland",
        "woodsy",
        "woodless",
        "woodwork",
        "woodcut"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "13088882-8d72-347b-be7b-392571c75af1",
                    "sense_definition": "A dense collection of trees covering a relatively small area; a small forest.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nature_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went for a long walk in the <w>woods</w> behind our house.",
                            "target_lang_translations": {
                                "ru": "Мы отправились на долгую прогулку в <w>лес</w> за нашим домом.",
                                "zh": "我们在屋后的<w>树林</w>里走了很长一段路。"
                            }
                        },
                        {
                            "text": "The cabin is hidden deep in the <w>woods</w>, far from the main road.",
                            "target_lang_translations": {
                                "ru": "Хижина спрятана глубоко в <w>лесу</w>, вдалеке от главной дороги.",
                                "zh": "小屋隐藏在<w>树林</w>深处，远离主路。"
                            }
                        },
                        {
                            "text": "Although the situation improved, we are not out of the <w>woods</w> yet.",
                            "target_lang_translations": {
                                "ru": "Хотя ситуация улучшилась, мы еще не вне <w>опасности</w>.",
                                "zh": "虽然情况有所好转，但我们还没有脱离<w>危险</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "forest",
                        "grove",
                        "woodland",
                        "copse"
                    ],
                    "antonyms": [
                        "clearing",
                        "meadow",
                        "plain",
                        "field"
                    ],
                    "common_phrases": [
                        "in the woods",
                        "out of the woods",
                        "neck of the woods",
                        "walk in the woods"
                    ],
                    "target_lang_definitions": {
                        "ru": "Густое скопление деревьев, покрывающее относительно небольшую территорию; небольшой лес.",
                        "zh": "指覆盖面积相对较小的茂密树木群；小森林。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лес",
                                "target_lang_sense_clarification": "пространство, поросшее деревьями"
                            },
                            {
                                "target_lang_word": "роща",
                                "target_lang_sense_clarification": "небольшой, обособленный лес"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "树林",
                                "target_lang_sense_clarification": "指成片的树木"
                            },
                            {
                                "target_lang_word": "森林",
                                "target_lang_sense_clarification": "指大面积的树木覆盖区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "341bcb92-6fbd-37b5-8e5e-8577bf5694c5",
                    "sense_definition": "Plural form of <w>wood</w> (the hard fibrous material of trees), referring to different types or varieties.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "material_types",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter used a combination of dark and light <w>woods</w> for the table.",
                            "target_lang_translations": {
                                "ru": "Плотник использовал сочетание темных и светлых <w>пород дерева</w> для стола.",
                                "zh": "木匠用了深色和浅色两种<w>木材</w>来制作这张桌子。"
                            }
                        },
                        {
                            "text": "Exotic <w>woods</w> like mahogany and teak are often used in luxury furniture.",
                            "target_lang_translations": {
                                "ru": "Экзотические <w>сорта древесины</w>, такие как красное дерево и тик, часто используются в элитной мебели.",
                                "zh": "像红木和柚木这类名贵<w>木料</w>常被用于高档家具。"
                            }
                        }
                    ],
                    "synonyms": [
                        "timbers",
                        "timber"
                    ],
                    "common_phrases": [
                        "hard woods",
                        "soft woods",
                        "exotic woods"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова wood (древесина), обозначающее различные её виды или сорта.",
                        "zh": "wood（木材）的复数形式，指不同种类或品种的木材。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "породы дерева",
                                "target_lang_sense_clarification": "различные виды древесных растений как материал"
                            },
                            {
                                "target_lang_word": "сорта древесины",
                                "target_lang_sense_clarification": "разновидности древесного материала"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "木材",
                                "target_lang_sense_clarification": "指作为材料的木头"
                            },
                            {
                                "target_lang_word": "木料",
                                "target_lang_sense_clarification": "指用于制作家具等的木材种类"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d30d5fe4-a160-335e-b1f3-d611e8679c55",
                    "sense_definition": "A topographic surname derived from Middle English.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "surname_group",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Woods</w> has been our neighbor for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Вудс</w> был нашим соседом более двадцати лет.",
                                "zh": "<w>伍兹</w>先生做我们的邻居已经二十多年了。"
                            }
                        },
                        {
                            "text": "Tiger <w>Woods</w> is one of the most famous golfers in history.",
                            "target_lang_translations": {
                                "ru": "Тайгер <w>Вудс</w> — один из самых известных гольфистов в истории.",
                                "zh": "泰格·<w>伍兹</w>是历史上最著名的高尔夫球手之一。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия топонимического происхождения.",
                        "zh": "源自中古英语的地形姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Вудс",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伍兹",
                                "target_lang_sense_clarification": "常见的英语姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a686aa2-be29-3154-80c7-9b524a05278a",
                    "sense_definition": "A place name used for various communities in the United States, Canada, and Australia.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "place_group",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small community of <w>Woods</w> during their road trip through Oregon.",
                            "target_lang_translations": {
                                "ru": "Они посетили небольшое поселение <w>Вудс</w> во время своего путешествия по Орегону.",
                                "zh": "他们在俄勒冈州公路旅行时参观了<w>伍兹</w>这个小社区。"
                            }
                        },
                        {
                            "text": "The map shows a town called <w>Woods</w> near the river.",
                            "target_lang_translations": {
                                "ru": "На карте показан город под названием <w>Вудс</w> у реки.",
                                "zh": "地图上显示河边有一个叫<w>伍兹</w>的城镇。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Географическое название, используемое для различных населенных пунктов.",
                        "zh": "用于美国、加拿大和澳大利亚等地名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Вудс",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伍兹",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0e5ab4ef-ce6d-3ffb-9078-0ec13774f79c",
                    "sense_definition": "Third-person singular simple present indicative form of <w>wood</w> (to supply with wood or cover with trees).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>woods</w> the fire every hour to keep the cabin warm.",
                            "target_lang_translations": {
                                "ru": "Он <w>подкладывает дрова</w> в огонь каждый час, чтобы в хижине было тепло.",
                                "zh": "他每小时都给火堆<w>添加木柴</w>，以保持小屋温暖。"
                            }
                        },
                        {
                            "text": "The forestry service <w>woods</w> the barren hillside to prevent erosion.",
                            "target_lang_translations": {
                                "ru": "Лесная служба <w>засаживает лесом</w> пустынный склон, чтобы предотвратить эрозию.",
                                "zh": "林业部门在贫瘠的山坡上<w>植树造林</w>以防止水土流失。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "third-person singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма глагола wood (снабжать дровами или засаживать лесом).",
                        "zh": "动词 wood 的第三人称单数形式（意为供应木材或植树造林）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "засаживает лесом",
                                "target_lang_sense_clarification": "покрывает территорию деревьями"
                            },
                            {
                                "target_lang_word": "снабжает дровами",
                                "target_lang_sense_clarification": "обеспечивает топливом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "添加木柴",
                                "target_lang_sense_clarification": "指为火堆补充燃料"
                            },
                            {
                                "target_lang_word": "植树造林",
                                "target_lang_sense_clarification": "指在土地上种植树木"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}