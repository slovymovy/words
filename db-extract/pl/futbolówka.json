                    },
                    {
                        "translation_id": "27d2a70b-51c6-4414-a957-a31d63540c60",
                        "source_entry_id": "f8b310d8-60c9-3e1f-b0f1-875877e070ff",
                        "source_sense_id": "1efa9747-2c6b-3b15-a3c7-585abc6edd0b",
                        "target_lang_word": "Fußball",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fußball",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e965ce52-25d8-3aa1-83bb-1a957bff28e9",
                                        "entry_id": "f894ae3f-fdbd-3292-8da2-f80345b7b8ea",
                                        "glosses": [
                                            "eine beliebte Mannschaftssportart, welche mit 22 Spielern und einem Ball gespielt wird"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f275a799-4372-4c10-808d-6a21d70618a9",
                                                "sense_id": "e965ce52-25d8-3aa1-83bb-1a957bff28e9",
                                                "text": "Er spielt für sein Leben gern Fußball."
                                            },
                                            {
                                                "example_id": "2b6947f8-c9c6-4ae8-949e-8dab090bd995",
                                                "sense_id": "e965ce52-25d8-3aa1-83bb-1a957bff28e9",
                                                "text": "Die deutsche Frauen-Nationalmannschaft ist 2009 das siebente Mal Fußball-Europameister geworden."
                                            },
                                            {
                                                "example_id": "82f39a1c-09ec-4f3a-9e1c-e60239abf9f3",
                                                "sense_id": "e965ce52-25d8-3aa1-83bb-1a957bff28e9",
                                                "text": "„Beim Fußball braucht das Genie die Mannschaft, und die wiederum ist ohne den Funken der Genialität des Einzelnen am Ende aufgeschmissen.“"
                                            },
                                            {
                                                "example_id": "7e82a108-8d4e-4793-8c64-e2deab72e780",
                                                "sense_id": "e965ce52-25d8-3aa1-83bb-1a957bff28e9",
                                                "text": "„Fußball ist keine Religion, da seine Regeln nicht auf übermenschliche Gebote zurückgehen.“"
                                            },
                                            {
                                                "example_id": "a6014a49-458e-4934-8476-bf82b79bb118",
                                                "sense_id": "e965ce52-25d8-3aa1-83bb-1a957bff28e9",
                                                "text": "„Ich nahm an diesen Runden teil, obwohl mich Fußball überhaupt nicht interessierte.“"
                                            },
                                            {
                                                "example_id": "bcdb68f1-71c4-4b4a-9097-437735e514cd",
                                                "sense_id": "e965ce52-25d8-3aa1-83bb-1a957bff28e9",
                                                "text": "„Jedenfalls kam Ögmundur über das Thema Fußball mit jedem ins Gespräch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "18b2c1f2-1d69-3af3-b9c2-68924ead1ceb",
                                        "entry_id": "f894ae3f-fdbd-3292-8da2-f80345b7b8ea",
                                        "glosses": [
                                            "Ball zur Ausübung des Sportes [1]; Spielgerät"
                                        ],
                                        "tags": [
                                            "Freizeit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83658f61-5296-4786-b95b-cfb1bb808d08",
                                                "sense_id": "18b2c1f2-1d69-3af3-b9c2-68924ead1ceb",
                                                "text": "Und der Fußball landet im Tor!"
                                            },
                                            {
                                                "example_id": "5eb48adf-2fbc-4139-aeb7-528c019f8c25",
                                                "sense_id": "18b2c1f2-1d69-3af3-b9c2-68924ead1ceb",
                                                "text": "Der Spieler trat den Fußball weit in die Zuschauermenge hinein."
                                            },
                                            {
                                                "example_id": "4b10c07a-e113-4eba-9256-a6b956d91c77",
                                                "sense_id": "18b2c1f2-1d69-3af3-b9c2-68924ead1ceb",
                                                "text": "„Hätte die Erde die Größe eines Fußballs, wäre die Biosphäre nicht dicker als ein Blatt Papier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
