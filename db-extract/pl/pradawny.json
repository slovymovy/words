                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1aa92cd-3df2-4f99-8ccf-eddb48ae51d3",
                        "source_entry_id": "87718775-e5b2-3f32-b353-02b88e45cb58",
                        "source_sense_id": "44e94851-300d-3df1-a332-7d81f113f703",
                        "target_lang_word": "urzeitlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urzeitlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad4abbdc-585d-358d-b630-c04e9958a745",
                                        "entry_id": "90327f43-ccf5-37e8-bb9b-40eef4b868db",
                                        "glosses": [
                                            "die Urzeit betreffend, aus ihr stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c50b007-983a-47fb-b2e4-cda229753e3c",
                                                "sense_id": "ad4abbdc-585d-358d-b630-c04e9958a745",
                                                "text": "„Kaum ein Mythos ist so alt wie der von der urzeitlichen Sintflut, die im Alten Testament ausführlich beschrieben ist.“"
                                            },
                                            {
                                                "example_id": "83bf05d6-12f8-41ec-bd42-836b27cfdf87",
                                                "sense_id": "ad4abbdc-585d-358d-b630-c04e9958a745",
                                                "text": "„Erdöl […] ist ein sogenannter fossiler Brennstoff: Es entstand vor mehr als 100, teilweise sogar vor über 250 Millionen Jahren durch die äußerst langsam ablaufende Zersetzung von urzeitlichem organischem Material wie Pflanzen, Plankton oder Mikroorganismen unter Druck und unter Ausschluss von Sauerstoff […].“"
                                            },
                                            {
                                                "example_id": "bd68fa8b-d1aa-4e0d-be33-bfbdab67bb06",
                                                "sense_id": "ad4abbdc-585d-358d-b630-c04e9958a745",
                                                "text": "„Seitdem Forscher in den fossilen Überresten urzeitlicher Tiere flügelartige, sogar mit Federn ausgestattete Extremitäten fanden - mit denen ihre Eigner allerdings kaum zum Fliegen imstande waren -, brennt der wissenschaftliche Streit über die Entstehung des Vogelflugs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
