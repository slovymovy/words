                        "examples": [
                            {
                                "example_id": "89e63f9c-8fd1-4af4-82bd-fc07ab1a927d",
                                "sense_id": "59810fc8-ca42-37a4-91f7-42c846cee59d",
                                "text": "Bij Halt voeren de jongeren 8 tot 12 uur gesprekken, waar hun ouders ook bij zijn. Ook moeten ze leeropdrachten maken over bijvoorbeeld alcohol, groepsdruk en ID-fraude. Ook moeten ze hun excuses aanbieden, aan bijvoorbeeld iemand van de horecabond, waardoor ze inzien wat ID-fraude voor gevolgen voor de horeca heeft."
                            },
                            {
                                "example_id": "f9f8a206-3890-4928-8016-1af5695caa45",
                                "sense_id": "59810fc8-ca42-37a4-91f7-42c846cee59d",
                                "text": "Horecabond Koninklijke Horeca Nederland (KHN) heeft nu een nieuw protocol opgesteld, wat privacywaakhond AP heeft goedgekeurd. Ondernemers kunnen straks gasten die zich hebben misdragen laten registreren in een centrale database. Zij kunnen dan maximaal twee jaar geweigerd worden door andere zaken in hetzelfde uitgaansgebied, in tegenstelling tot de vijf jaar in het oude systeem."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a9b0a1f-238a-332f-804a-088a07fc1a92",
                        "entry_id": "54bc5a49-349b-3cf0-82f7-df7120d4cfc5",
                        "glosses": [
                            "vakbond voor horecapersoneel"
                        ],
