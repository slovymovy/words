                    {
                        "sense_id": "74ea2942-0252-34e8-ab5c-a4e0b213f404",
                        "entry_id": "5318d2a2-f811-3211-b5c5-44ef61b08e28",
                        "glosses": [
                            "lichamelijk letsel, beschadiging van het lichaam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8ebf35b-8ae6-4078-9e20-4b609a6515b9",
                                "sense_id": "74ea2942-0252-34e8-ab5c-a4e0b213f404",
                                "text": "Het slachtoffer overleed ter plaatse aan zijn verwondingen."
                            }
                        ]
                    },
                    {
                        "sense_id": "db977bdc-4fe5-3361-8613-0aee677b47f6",
                        "entry_id": "5318d2a2-f811-3211-b5c5-44ef61b08e28",
                        "glosses": [
                            "het verwonden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d4ec73e-e7be-4846-9381-0b0c7476bac6",
                                "sense_id": "db977bdc-4fe5-3361-8613-0aee677b47f6",
                                "text": "Hij raakte besmet door verwonding aan een gebruikte naald."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0716343b-bb03-40a3-bc5d-1c1e984e667d",
                        "source_entry_id": "5318d2a2-f811-3211-b5c5-44ef61b08e28",
                        "source_sense_id": "74ea2942-0252-34e8-ab5c-a4e0b213f404",
                        "source_sense_description": "lichamelijk letsel",
                        "target_lang_word": "Verwundung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verwundung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c65a09a3-1ad8-3ecf-b407-92da15b85424",
                                        "entry_id": "3967f36b-d658-30ed-86a7-1b00591e73a4",
                                        "glosses": [
                                            "Aktion, bei der ein körperlicher Schaden entsteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41b6e1fb-681d-4651-bc38-748ca29b4c1a",
                                                "sense_id": "c65a09a3-1ad8-3ecf-b407-92da15b85424",
                                                "text": "Die Verwundung erfolgte im Zweikampf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35c07b60-e7fb-3100-9f59-db9aac39c366",
                                        "entry_id": "3967f36b-d658-30ed-86a7-1b00591e73a4",
                                        "glosses": [
                                            "im Krieg erlittene Verletzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e87b6716-1117-40b9-8e60-64ed1c79ffab",
                                                "sense_id": "35c07b60-e7fb-3100-9f59-db9aac39c366",
                                                "text": "Die Soldaten wurden nach ihrer Verwundung ins Heimatland zurückgeflogen."
                                            },
                                            {
                                                "example_id": "93da79e0-d019-4394-b68d-517cea93be98",
                                                "sense_id": "35c07b60-e7fb-3100-9f59-db9aac39c366",
                                                "text": "„Eine Verwundung gelte dann als schwer, wenn der Soldat dadurch für längere Zeit dienstunfähig sei - etwa ein Schuss ins Bein.“"
                                            },
                                            {
                                                "example_id": "79c8b52b-4eed-45d5-ae81-0a6e909e2fb0",
                                                "sense_id": "35c07b60-e7fb-3100-9f59-db9aac39c366",
                                                "text": "„Auch Verwundungen oder Todesfälle werden nicht nach Hause gemeldet.“"
                                            },
                                            {
                                                "example_id": "494882c0-b5c7-41d4-9374-d5ac3ddd4b2b",
                                                "sense_id": "35c07b60-e7fb-3100-9f59-db9aac39c366",
                                                "text": "„Natascha gewahrte den Eindruck, den die Nachricht von Nikolais Verwundung auf Sonja machte, und jetzt erst begriff sie, wieviel Trauriges doch in dem Inhalt des eingetroffenen Briefes lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94681919-c7af-44e5-8d90-ab6a8bf507fc",
                        "source_entry_id": "5318d2a2-f811-3211-b5c5-44ef61b08e28",
                        "source_sense_id": "74ea2942-0252-34e8-ab5c-a4e0b213f404",
                        "source_sense_description": "lichamelijk letsel",
                        "target_lang_word": "Verletzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verletzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b75477ea-7ddc-3440-b188-b905e5dbb55f",
                                        "entry_id": "2a5a2490-5b86-385a-8cfe-f39ab89b127a",
                                        "glosses": [
                                            "eine Beschädigung von Gewebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91166979-0281-4914-acc6-3ea838d69718",
                                                "sense_id": "b75477ea-7ddc-3440-b188-b905e5dbb55f",
                                                "text": "„Bei den von mir untersuchten Wagnissportarten Bergsteigen, Fallschirmspringen, Gleitschirm-, Drachen-, Segelfliegen und Bungeespringen wird – gemessen an der Anzahl der Einzelaktionen, der Betätigungsdauer und der Schwere der Verletzungen – ein Gefährdungslevel unterschritten, der in anderen gesellschaftlichen Bereichen (z.B. dem Straßenverkehr) und in Volkssportarten (Fußball, Abfahrtski) allgemein toleriert wird.“"
                                            },
                                            {
                                                "example_id": "43baee43-193d-45a1-b6b7-5bde7cfec572",
                                                "sense_id": "b75477ea-7ddc-3440-b188-b905e5dbb55f",
                                                "text": "Ich habe mir gestern eine Verletzung der Milz zugezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "64e1679e-531f-3126-a052-77a50681a514",
                                        "entry_id": "2a5a2490-5b86-385a-8cfe-f39ab89b127a",
                                        "glosses": [
                                            "das Übertreten eines Gebotes, einer Grenze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e952727-0649-45db-914d-094ff0f1efb3",
                                                "sense_id": "64e1679e-531f-3126-a052-77a50681a514",
                                                "text": "Es war eine schwere Verletzung der Aufsichtspflicht."
                                            },
                                            {
                                                "example_id": "b0c6ccb7-14cc-48a6-9b19-d9a5ae287a67",
                                                "sense_id": "64e1679e-531f-3126-a052-77a50681a514",
                                                "text": "„Wir glauben kaum nötig zu haben, unsern Lesern die Tatsache zu bestätigen, die der Squire soeben erzählte und die, wie wir wissen, genau dahin ging, daß der berühmte Sieger wirklich zu dieser Geldstrafe wegen Verletzung der Habeascorpusakte während seines Oberbefehls verurteilt wurde: eine Strafe, der er sich auch willig unterzog.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "739e3e8e-a523-4c92-a6ee-1270adaefd52",
                        "source_entry_id": "5318d2a2-f811-3211-b5c5-44ef61b08e28",
                        "source_sense_id": "74ea2942-0252-34e8-ab5c-a4e0b213f404",
                        "source_sense_description": "lichamelijk letsel",
                        "target_lang_word": "injury",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "injury",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca60a8ba-439a-3659-a4ed-b1a6fdebd589",
                                        "entry_id": "b03b68aa-5b39-3de5-8b4e-caee450f34fd",
                                        "glosses": [
                                            "Damage to the body of a living thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d881574b-745c-4761-ba88-a369f841f0d6",
                                                "sense_id": "ca60a8ba-439a-3659-a4ed-b1a6fdebd589",
                                                "text": "The passenger sustained a severe injury in the car accident."
                                            },
                                            {
                                                "example_id": "bad00ff5-d366-4560-8eb9-5b01cf170aa6",
                                                "sense_id": "ca60a8ba-439a-3659-a4ed-b1a6fdebd589",
                                                "text": "He got a shoulder injury in the nets three days before the match."
                                            },
                                            {
                                                "example_id": "f26e7d62-2470-4b86-9ed9-1b8c71c2966b",
                                                "sense_id": "ca60a8ba-439a-3659-a4ed-b1a6fdebd589",
                                                "text": "Whether you need to recover from a stressful day, a strenuous workout or even an injury or surgery, restorative yoga may be just the thing for you."
                                            },
                                            {
                                                "example_id": "de62401f-9efc-4700-af95-907c6e74017b",
                                                "sense_id": "ca60a8ba-439a-3659-a4ed-b1a6fdebd589",
                                                "text": "Soft tissue injuries are the bane of any physically active person. They are the most common injuries in sport, can be difficult to heal and often reoccur, according to Sports Medicine Australia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e25a621-09c5-370b-9835-34a3c7cf17c6",
                                        "entry_id": "b03b68aa-5b39-3de5-8b4e-caee450f34fd",
                                        "glosses": [
                                            "Other forms of damage sustained by a living thing, e.g. psychologically."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd78b5b2-f952-37dd-88fa-22ef22ef0b17",
                                        "entry_id": "b03b68aa-5b39-3de5-8b4e-caee450f34fd",
                                        "glosses": [
                                            "The violation of a person's reputation, rights, property, or interests."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85a9ed25-bb33-4923-8cfe-ee07bab601c7",
                                                "sense_id": "fd78b5b2-f952-37dd-88fa-22ef22ef0b17",
                                                "text": "Slander is an injury to the character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43fd8eb1-68cc-3430-8d21-b3b24adfe98a",
                                        "entry_id": "b03b68aa-5b39-3de5-8b4e-caee450f34fd",
