                "senses": [
                    {
                        "sense_id": "9b81a6d1-adf6-3d0e-a8fd-6ff974c0e3bf",
                        "entry_id": "940cf569-d7cd-3e35-bec5-89bb851bde57",
                        "glosses": [
                            "Tout ce qui excède le nu de l’architecture d'un ouvrage."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "22e7b686-db9e-3947-892a-68e0cb83c300",
                        "entry_id": "940cf569-d7cd-3e35-bec5-89bb851bde57",
                        "glosses": [
                            "Corps de maçonnerie qui est en saillie sur la face d’un bâtiment."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "1b8a1533-1e12-4621-966f-84384617dac4",
                                "sense_id": "22e7b686-db9e-3947-892a-68e0cb83c300",
                                "text": "Sur le parc, la façade se distingue de celle sur la cour par un avant-corps de cinq croisées à colonnes au-dessus duquel se voit un magnifique fronton."
                            },
                            {
                                "example_id": "7b501ba9-3276-416f-a449-2b7a43e7b598",
                                "sense_id": "22e7b686-db9e-3947-892a-68e0cb83c300",
                                "text": "Marly, avec ses pilastres, ses architraves, ses avant-corps, fut décoré extérieurement à fresque avec des sculptures imitées et des rondes bosses factices."
                            }
                        ]
                    },
                    {
                        "sense_id": "5dd7c145-d676-3b91-8cf7-412df05e8241",
                        "entry_id": "940cf569-d7cd-3e35-bec5-89bb851bde57",
                        "glosses": [
                            "(Mécanique des fluides) La partie d'un corps qui est devant son maître-couple, par opposition à l'arrière-corps. La séparation d'un corps se fait aussi parfois en avant-corps, corps médian et arrière-corps."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8f3bd3d-d455-43ac-b421-25bdec9b4643",
                        "source_entry_id": "940cf569-d7cd-3e35-bec5-89bb851bde57",
                        "target_lang_word": "forebody",
                        "target_lang_code": "en",
