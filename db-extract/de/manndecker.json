                        "entry_id": "1a6293b7-3a41-367c-93e0-8fbaa8f40645",
                        "glosses": [
                            "Sport, Fußball: Spieler, der einen Gegenspieler auf engstem Raum bewacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4bbf9f4-6ac4-4bb4-9716-639d10297c4c",
                                "sense_id": "fd881af4-7804-3cdc-9b73-b15bfe569a31",
                                "text": "„…doch Schiedsrichter Babak Rafati (Hannover) ließ zurecht weiterlaufen, weil der Dortmunder Manndecker klar den Ball gespielt hatte“."
                            },
                            {
                                "example_id": "af11bbb7-ac0f-4b24-9772-0ec52394e55e",
                                "sense_id": "fd881af4-7804-3cdc-9b73-b15bfe569a31",
                                "text": "„Die Dänen bangen nun aber um ihren Manndecker Simon Kjaer, der sich möglicherweise sogar schwerer verletzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
