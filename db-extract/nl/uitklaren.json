                "senses": [
                    {
                        "sense_id": "03b7b5ca-b520-3726-82ee-684406a25a18",
                        "entry_id": "dd4777a7-d3e4-3864-b08f-08fe588d8576",
                        "glosses": [
                            "iets ophelderen wat eerst onduidelijk was, een raadsel oplossen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "218e5626-8aee-40c0-9f24-5fefd982568d",
                                "sense_id": "03b7b5ca-b520-3726-82ee-684406a25a18",
                                "text": "Maar het onderzoek kon niet uitklaren hoe de zanger/gitarist aan het (verkeerde) product was geraakt."
                            },
                            {
                                "example_id": "ac5d7584-9094-463c-aa7e-7ef3de46a73b",
                                "sense_id": "03b7b5ca-b520-3726-82ee-684406a25a18",
                                "text": "Al maanden zegt men in het Europees parlement dat interne kwesties van de lidstaten intern moeten opgelost worden, om Catalonië niet te noemen. Wel, dan van twee dingen één. Dan moet Duitsland dit ook maar intern uitklaren.’"
                            },
                            {
                                "example_id": "21fdd00e-786d-4bc1-a787-12888b037209",
                                "sense_id": "03b7b5ca-b520-3726-82ee-684406a25a18",
                                "text": "Maar in werkelijkheid huur je dat liedje voor eigen gebruik en je hebt er het raden naar met er met je licentie gebeurt na je dood. Daar kwam ook Bruce Willis achter en de Hollywoodster wil dat nu voor ons allen laten uitklaren."
                            }
                        ]
                    },
                    {
                        "sense_id": "fdfb8f5c-e755-3ebc-a5ec-0ee54afa3db4",
                        "entry_id": "dd4777a7-d3e4-3864-b08f-08fe588d8576",
                        "glosses": [
                            "helderder worden van het weer; minder bewolkt worden; zonniger worden"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0e576e54-2fc5-309f-9442-f0bf664d6fe2",
                        "entry_id": "dd4777a7-d3e4-3864-b08f-08fe588d8576",
                        "glosses": [
                            "lading voorzien van de vereiste export papieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a8ecc2d-f9aa-4ae7-a9d9-4642689f1ace",
                                "sense_id": "0e576e54-2fc5-309f-9442-f0bf664d6fe2",
                                "text": "De Hotlo staat ondertussen nog altijd op de Braziliaanse werf BrasFELS. Eigenaar Noble Drilling gaat nu proberen de machine te laten uitklaren, nadat de exporteur een verkeerde procedure had gevolgd. Als alles meezit kan de motor eind maart op een transportschip worden geladen. In dat geval arriveert de gigant eind april in de Rotterdamse haven."
                            },
                            {
                                "example_id": "9eb0b022-d7a4-43d1-b0d1-d5e74004c0a0",
                                "sense_id": "0e576e54-2fc5-309f-9442-f0bf664d6fe2",
                                "text": "Dag van vertrek. In de ochtend al vroeg in de weer met het uitklaren van het schip bij de douane en immigratie. Bemanningslijsten worden verstuurd naar verschillende instanties en alle paspoorten krijgen een stempel."
                            }
                        ]
                    }
