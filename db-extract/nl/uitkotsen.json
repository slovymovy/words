        "nl-extract.jsonl": [
            {
                "entry_id": "783650b0-5ec3-3638-8675-1b8498772f34",
                "word": "uitkotsen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "75e66349-3a9b-3291-98cf-fa54e805ab86",
                        "entry_id": "783650b0-5ec3-3638-8675-1b8498772f34",
                        "glosses": [
                            "iets wat men gegeten of gedronken heeft via de mond het lichaam doen verlaten"
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fa7241ed-8fdd-4d26-8b33-e04db47a6f5c",
                                "sense_id": "75e66349-3a9b-3291-98cf-fa54e805ab86",
                                "text": "Een PVV'er in Noord-Holland zat dronken achter het stuur, een Limburgse partijgenoot noemde een PvdA'er een 'stuk uitgekotst halalvlees'. Anderen vertrokken vanwege bonje over de partijkoers, zoals in Noord-Brabant, Friesland, Gelderland en Drenthe."
                            },
                            {
                                "example_id": "f37e02ee-941f-4344-9814-060363167311",
                                "sense_id": "75e66349-3a9b-3291-98cf-fa54e805ab86",
                                "text": "Zij heeft zich als reactie teruggetrokken in de badkamer, ze kotste het eten en de drank uit."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec87dd31-1b98-39d7-89e6-8d19f5ee23ab",
                        "entry_id": "783650b0-5ec3-3638-8675-1b8498772f34",
                        "glosses": [
                            "aan iets of iemand een zo grote hekel hebben, dat men er niets meer mee te maken wil hebben"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d8554609-a95c-4730-b8bd-54fbf18239df",
                                "sense_id": "ec87dd31-1b98-39d7-89e6-8d19f5ee23ab",
                                "text": "De eens zo gevierde Amerikaan werd vervolgens uitgekotst door de wielerwereld, al klonk het bij sommigen dat Armstrong niets anders deed dan de rest van zijn generatiegenoten."
                            },
                            {
                                "example_id": "6d67f16e-3b1b-470a-82cc-1256ffdbc613",
                                "sense_id": "ec87dd31-1b98-39d7-89e6-8d19f5ee23ab",
                                "text": ",,Ik heb haar een brief geschreven om te vragen of zij aan dit filmplan mee wilde werken. Maar ze zat toen midden in die rechtszaak en mocht niets zeggen. Ik was zeer benieuwd hoe ze dit allemaal had ondergaan. Ze werd toen helemaal uitgekotst door de media."
                            },
                            {
                                "example_id": "7bb31e4a-1286-405c-ad9a-b33387ff7e82",
                                "sense_id": "ec87dd31-1b98-39d7-89e6-8d19f5ee23ab",
                                "text": "Volgens O. zijn pedofielen gevoelig voor de verlokkingen van die wereld, omdat het de enige plek is waar zij niet worden uitgekotst. Het is ook een gevaarlijke plek, aldus O., wegens het ontbreken van regels, remmingen en gevolgen. Robert M. werd in mei veroordeeld tot 18 jaar cel en tbs. De rechtbank doet in de zaak tegen O. en zijn medeverdachte uitspraak op 23 juli."
                            }
                        ]
                    }
                ],
