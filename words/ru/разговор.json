                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У нас состоялся очень серьёзный <w>разговор</w>.",
                            "target_lang_translations": {
                                "en": "We had a very serious <w>conversation</w>.",
                                "nl": "We hadden een heel serieus <w>gesprek</w>.",
                                "pl": "Przeprowadziliśmy bardzo poważną <w>rozmowę</w>.",
                                "de": "Wir hatten ein sehr ernstes <w>Gespräch</w>.",
                                "fr": "Nous avons eu une <w>conversation</w> très sérieuse.",
                                "it": "Abbiamo avuto una <w>conversazione</w> molto seria.",
                                "cs": "Měli jsme velmi vážný <w>rozhovor</w>.",
                                "tr": "Çok ciddi bir <w>konuşma</w> yaptık.",
                                "es": "Tuvimos una <w>conversación</w> muy seria.",
                                "zh": "我们进行了一次非常严肃的<w>谈话</w>。"
                            }
                        },
                        {
                            "text": "Мы продолжили наш <w>разговор</w> уже на улице.",
                            "target_lang_translations": {
                                "en": "We continued our <w>conversation</w> outside.",
                                "nl": "We zetten ons <w>gesprek</w> buiten voort.",
                                "pl": "Kontynuowaliśmy naszą <w>rozmowę</w> już na ulicy.",
                                "de": "Wir haben unser <w>Gespräch</w> draußen fortgesetzt.",
                                "fr": "Nous avons poursuivi notre <w>conversation</w> dans la rue.",
                                "it": "Abbiamo continuato la nostra <w>conversazione</w> fuori.",
                                "cs": "Pokračovali jsme v našem <w>rozhovoru</w> už na ulici.",
                                "tr": "<w>Konuşmamıza</w> dışarıda devam ettik.",
                                "es": "Continuamos nuestra <w>conversación</w> ya en la calle.",
                                "zh": "我们在街上继续了我们的<w>交谈</w>。"
                            }
                        }
