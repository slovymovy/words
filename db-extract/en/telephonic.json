                                        "entry_id": "1fc18e00-95ae-358b-a851-bd09b3abfcff",
                                        "glosses": [
                                            "Qui a trait à la téléphonie, définie comme l’art de faire porter au loin les sons, et plus particulièrement le son de la voix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d733cbbe-2b70-4bd6-a909-67987cceff0f",
                                                "sense_id": "6acf2bd0-45f3-3f45-a85d-91cf13d613dc",
                                                "text": "C’est prodigieux comme la voix se répercute dans ce salon, je ferai faire des expériences téléphoniques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
