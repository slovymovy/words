                                "sense_id": "7dc336a0-e611-30c2-b5da-e2abc8079246",
                                "text": "La carline est acaule."
                            },
                            {
                                "example_id": "b7baca53-f7d2-4e5d-8a3b-a53f0e5807e8",
                                "sense_id": "7dc336a0-e611-30c2-b5da-e2abc8079246",
                                "text": "La mandragore, le cyclamen sont des plantes acaules."
                            },
                            {
                                "example_id": "0ee761bb-2282-4a1d-b5b2-0da6ccd9e5af",
                                "sense_id": "7dc336a0-e611-30c2-b5da-e2abc8079246",
                                "text": "Le cirse acaule, outre les inconvénients habituels des chardons, présente celui d'avoir des racines traçantes."
                            }
                        ]
                    }
