                        ]
                    },
                    {
                        "translation_id": "c2b7f045-04d5-4277-bd38-63bda6ff4597",
                        "source_entry_id": "488014dc-100d-37e6-b564-0ddc5cef80fe",
                        "source_sense_id": "f7a8cc23-7f10-34ab-8bea-8b2a7c24da63",
                        "target_lang_word": "formalistico",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "41368952-dc87-487e-8c6b-4424d499d3a4",
                        "source_entry_id": "488014dc-100d-37e6-b564-0ddc5cef80fe",
                        "source_sense_id": "f7a8cc23-7f10-34ab-8bea-8b2a7c24da63",
                        "target_lang_word": "formalistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "formalistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "896509d7-a3d0-389e-9c72-9d9d782f6b55",
                                        "entry_id": "d6d20733-4f61-3f24-b977-4194e3ec7058",
                                        "glosses": [
                                            "eine festgelegte Art und Weise/Form überbetonend und genau beachtend, sich auf Formalismen beziehend"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac3ef34d-e9dd-4311-ba37-3a8d32911922",
                                                "sense_id": "896509d7-a3d0-389e-9c72-9d9d782f6b55",
                                                "text": "„Die moderne Musik stieß in den fünfziger Jahren auf den Widerstand der ideologischen Dogmatiker. Sie wurde als „formalistisch“ denunziert und teilweise verboten.“"
                                            },
                                            {
                                                "example_id": "c034a627-67e6-48fc-a9a7-f55ace213fba",
                                                "sense_id": "896509d7-a3d0-389e-9c72-9d9d782f6b55",
                                                "text": "„Die formalistische Betrachtung von Kunst betont Qualitäten wie z. B. Komposition, Farbe, Linien und Textur.“"
                                            },
                                            {
                                                "example_id": "b456fa0d-2e8f-46f1-adc4-dc042c2bd488",
                                                "sense_id": "896509d7-a3d0-389e-9c72-9d9d782f6b55",
                                                "text": "„Die formalistischen Ideen des 19. Jh. dienten der Modernen Malerei als Impuls, sich freier zu entfalten und auf die ästhetische Wirkung von Form und Struktur zu konzentrieren.“"
                                            },
                                            {
                                                "example_id": "4b08d9bb-40cc-4f6d-851a-4d74d42a6705",
                                                "sense_id": "896509d7-a3d0-389e-9c72-9d9d782f6b55",
                                                "text": "„Gemäß der formalistischen Kunsttheorie sind für ein Kunstwerk keine inhaltlichen, sondern bestimmte formale Aspekte entscheidend.“",
                                                "translation": "abwertend:"
                                            },
                                            {
                                                "example_id": "4a15ce2f-d3f0-4740-a9d5-83d90da99a17",
                                                "sense_id": "896509d7-a3d0-389e-9c72-9d9d782f6b55",
                                                "text": "„Nachdem die Musik von Dmitrij Schostakowitsch 1936 in einem Zeitungsartikel als \"formalistisch\" und \"volksfeindlich\" gebrandmarkt wurde, musste der junge Komponist in der stalinistischen Sowjetunion um sein Leben bangen.“"
                                            },
                                            {
                                                "example_id": "752336c1-5da7-472d-9a4a-6a10dc882304",
                                                "sense_id": "896509d7-a3d0-389e-9c72-9d9d782f6b55",
                                                "text": "„Béla Bartóks Cantata profana, das Anfang der 50er Jahre aus dem Programm genommen worden war, weil es zu dekadent und formalistisch sei, ließ Kegel im Herbst 1963 wiedererklingen.“"
                                            },
                                            {
                                                "example_id": "b9fa3417-65fc-49e6-9873-81fae6ad538b",
                                                "sense_id": "896509d7-a3d0-389e-9c72-9d9d782f6b55",
                                                "text": "„Die Gesundheitsdirektion wimmelte sie ab mit einer formalistischen Antwort.“"
                                            },
                                            {
                                                "example_id": "6d4efcd1-05a8-4be2-92aa-b83de66087e8",
                                                "sense_id": "896509d7-a3d0-389e-9c72-9d9d782f6b55",
                                                "text": "„In Teilen der Verwaltung mache sich die Tendenz bemerkbar, «das informelle Schlichtungsverfahren durch formalistische Einreden zu verkomplizieren».“"
                                            },
                                            {
                                                "example_id": "8a7da53a-ddc5-4ab2-941e-3a7ef105f1c3",
                                                "sense_id": "896509d7-a3d0-389e-9c72-9d9d782f6b55",
                                                "text": "„Trotz neuer Gesetze musste Altman sechs Jahre um die Bilder kämpfen. Die Regierung in Wien verweigerte die Rückgabe der «österreichischen Mona Lisa», wie das Gemälde im Film genannt wird, aus formalistischen Gründen.“"
                                            },
                                            {
                                                "example_id": "928f2976-c55e-4702-b6c1-54a1fb5d200a",
                                                "sense_id": "896509d7-a3d0-389e-9c72-9d9d782f6b55",
                                                "text": "[Polnischer Wahlkampf 2023:] „Rund 15.000 Eltern haben einen Protestbrief gegen die Kürzung der Deutschstunden veröffentlicht. Viele haben dem Minister zusätzlich Briefe mit Fragen nach der Zukunft des Deutschunterrichts geschickt. Sie bekamen formalistische Antworten.“"
                                            },
                                            {
                                                "example_id": "4bda2145-400d-4df7-8e62-cc91a3a484c9",
                                                "sense_id": "896509d7-a3d0-389e-9c72-9d9d782f6b55",
                                                "text": "„Aber es haben auch viele zugestimmt, die vom gesunden Menschenverstand her das beurteilen, und da muss ich sagen, das ist vielleicht manchmal wichtiger, bedeutsamer, humaner, sozialer als der formalistische Formelkram.“"
                                            },
                                            {
                                                "example_id": "cbef6baa-1a1f-4b39-8206-010a172c3ae6",
                                                "sense_id": "896509d7-a3d0-389e-9c72-9d9d782f6b55",
                                                "text": "„Wenig hilfreich ist dagegen das Argument der Vereinten Nationen, die Uruguay vorwerfen, gegen bestehende Verträge und die Betäubungsmittel-Konvention zu verstoßen. Diese formalistische und weltfremde Kritik hat den Kampf gegen die schwarzen Märkte der Drogendealer keinen Zentimeter weitergebracht.“"
                                            },
                                            {
                                                "example_id": "5a80d700-251f-4fdc-8118-21bcffe8c063",
                                                "sense_id": "896509d7-a3d0-389e-9c72-9d9d782f6b55",
                                                "text": "„Die BaFin hat die Prospekte von P&R genehmigt, hat nicht einmal die formalistischen Dinge eingehalten, formalistische Dinge wie z.B. das Alter eines Containers, steht in diesen Prospekten nicht drin. Die BaFin sagt immer, ja wir müssen ja nicht inhaltlich prüfen, wir prüfen nur formalistisch, aber sie prüfen nicht mal formalistisch.“"
                                            },
                                            {
                                                "example_id": "ff4416f0-9b1c-47a6-960a-e5aa6e0f3fae",
                                                "sense_id": "896509d7-a3d0-389e-9c72-9d9d782f6b55",
                                                "text": "„Der den Konservativen nahestehende BBC-Chef Tim Davie setzt zudem ein sehr formalistisches Programm im Zeichen der \"Ausgewogenheit\" um, dass nach Meinung vieler BBC-Mitarbeitenden die redaktionelle Unabhängigkeit beschneidet und zu einseitig auf die Vorwürfe von konservativer Seite, die BBC berichte zu linksliberal, eingeht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
