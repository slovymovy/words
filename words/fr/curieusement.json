                    "frequency": "VeryLow",
                    "semantic_group_id": "soin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le musée expose un coffret médiéval en bois d'ébène <w>curieusement</w> sculpté."
                        },
                        {
                            "text": "Ce manuscrit ancien présente des lettrines peintes et <w>curieusement</w> enluminées à l'or fin."
