                                "sense_id": "6e6aacd4-a57c-388a-83e5-f41d7fc0b281",
                                "text": "a birdlike song; birdlike eyes"
                            },
                            {
                                "example_id": "f96356ec-d576-4972-88c9-eb487f3796dd",
                                "sense_id": "6e6aacd4-a57c-388a-83e5-f41d7fc0b281",
                                "text": "Once or twice I heard a faint pitter-patter like the feet of the dog going hither and thither on the sand far below me, and there were more bird-like sounds, but that was all."
                            },
                            {
                                "example_id": "c89e5fe3-f2e7-49df-8678-2ca881577e37",
                                "sense_id": "6e6aacd4-a57c-388a-83e5-f41d7fc0b281",
                                "text": "Frail, birdlike wrists and no muscle anywhere on his tiny frame."
                            }
                        ]
                    }
