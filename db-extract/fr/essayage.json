                        "glosses": [
                            "Action d’essayer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84807e6c-4bd2-4611-b2ab-47ee6a50e1bb",
                                "sense_id": "3324b178-7e7c-3979-934b-2fa02ea0bcfb",
                                "text": "[…] et en passant près de la guillotine, je remarquai sur la plate-forme le bourreau entouré d'un petit groupe de curieux. Il faisait pour eux l’essayage."
                            },
                            {
                                "example_id": "92a71f72-b859-47a5-8f1f-815efcc09b55",
                                "sense_id": "3324b178-7e7c-3979-934b-2fa02ea0bcfb",
                                "text": "Quand on songe au mal que donne l'essayage d'une pauvre petite paire de gants."
                            },
                            {
                                "example_id": "6def9ae7-9361-4198-ae3e-091edb1adf27",
                                "sense_id": "3324b178-7e7c-3979-934b-2fa02ea0bcfb",
                                "text": "Je n'ai plus une minute depuis que je suis là … Les essayages, vous comprenez! Je n'avais plus rien à me mettre! …"
                            }
                        ]
                    }
                ],
