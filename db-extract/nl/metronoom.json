                                    {
                                        "sense_id": "833c2ad2-8480-32dd-9d3c-eeb4bafa524c",
                                        "entry_id": "c0e43fa3-3166-3e57-8e85-a6a7b268f876",
                                        "glosses": [
                                            "Gerät, das durch lautes Ticken dem Musiker das eingestellte Tempo vorgibt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d9eaa7c-93dd-4359-a241-46cee62b0a41",
                                                "sense_id": "833c2ad2-8480-32dd-9d3c-eeb4bafa524c",
                                                "text": "„40 Jahre, in denen der sonnengegerbte Mann einem so gleichmäßigen Arbeitsrhythmus folgen sollte, als steuerte ihn ein Metronom...“"
                                            },
                                            {
                                                "example_id": "fcf16342-03ac-44f6-ad8b-7d94d96df0e7",
                                                "sense_id": "833c2ad2-8480-32dd-9d3c-eeb4bafa524c",
                                                "text": "„Jedenfalls, solange die Komponisten so freundlich waren, ihre entsprechenden Angaben mit dem Hinweis zu versehen, auf welchen Wert das Metronom zu stellen sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "953a2833-7908-42d2-8a4d-7e10484c8b16",
                        "source_entry_id": "58c0a1b9-655c-3d83-ab24-c2486c19173f",
                        "source_sense_id": "787618c6-fdf7-3959-81b5-6f6e83a2ff62",
                        "target_lang_word": "metronome",
                        "target_lang_code": "en",
