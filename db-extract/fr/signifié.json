                                        "sense_id": "6f800b52-9d30-3813-a4eb-1cc6cdf0cdd9",
                                        "entry_id": "c351fab3-0778-33a1-80d6-a27cd172771e",
                                        "glosses": [
                                            "das, was die Sache ausmacht; die Substanz; das, woraus sich eine Sache zusammensetzt ( Inhalt des Buches, des Vortrages, der Veranstaltung)"
                                        ],
                                        "tags": [
                                            "oft abstrakt und übertragen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5918390a-a8e3-49a5-a724-d6de441ce40e",
                                                "sense_id": "6f800b52-9d30-3813-a4eb-1cc6cdf0cdd9",
                                                "text": "In diesem Programm finden Sie den Inhalt des Theaterstücks kurz beschrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0276cce3-a4a5-3b16-8f0a-54e7948daa59",
                                        "entry_id": "c351fab3-0778-33a1-80d6-a27cd172771e",
                                        "glosses": [
                                            "philosophische Kategorie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1195b21-2bf3-40e0-b89a-e7f9a04ac66c",
                                                "sense_id": "0276cce3-a4a5-3b16-8f0a-54e7948daa59",
                                                "text": "Der Zusammenhang zwischen Inhalt und Form."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4995393d-8762-31a9-86b2-98032226f93f",
                                        "entry_id": "c351fab3-0778-33a1-80d6-a27cd172771e",
                                        "glosses": [
                                            "das Innere einer Sache, eines Dinges; die Füllung; Dinge, die in einem Behältnis sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5df6f17-16c8-429d-b4c6-0f6847bda88d",
                                                "sense_id": "4995393d-8762-31a9-86b2-98032226f93f",
                                                "text": "Der Inhalt der Flasche bestand nur aus Öl."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e49a8d87-1a4d-3f58-8611-973468e4678e",
                                        "entry_id": "c351fab3-0778-33a1-80d6-a27cd172771e",
                                        "glosses": [
                                            "eine von mehreren Bezeichnungen für die Bedeutung sprachlicher Zeichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e062a37-1350-437b-88e8-c1adeed0bf7d",
                                                "sense_id": "e49a8d87-1a4d-3f58-8611-973468e4678e",
                                                "text": "„Kraft der konstitutiven Semioseakte »vertritt« eine materielle Struktur (von Nervenimpulsen, Lauten, Linien, Bewegungen, Objekten) - als ‚Ausdruck‘ - eine immaterielle Information - Inhalt/‚Bedeutung‘ und macht diese dadurch mental verfügbar sowie mitteilbar…“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "336c7963-26ab-4b25-98ea-962043ce8629",
                        "source_entry_id": "27abab0a-3758-306b-ae3b-44ec5a1db43e",
                        "source_sense_id": "fdd8ff86-eec5-3240-9e3e-c55cc31426c5",
                        "source_sense_description": "Linguistik: Bedeutung des sprachlichen Zeichens",
                        "target_lang_word": "Signifié",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Signifié",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0c276b2-179d-3373-9c96-9db216fc11b0",
                                        "entry_id": "c5a203ba-a2e7-3b45-85f4-10f8ad383254",
                                        "glosses": [
                                            "Bedeutung des sprachlichen Zeichens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94dc6808-20b8-43ad-8f00-5b59e70e943a",
                                                "sense_id": "f0c276b2-179d-3373-9c96-9db216fc11b0",
                                                "text": ": Sprachliche Zeichen (signes) haben zwei Seiten und bestehen aus Signifié (Bedeutung) und Signifiant (Laut- oder Buchstabenfolge). Signifié ist in dieser französischen Form ein gängiger Begriff in der Linguistik und wird meistens klein geschrieben verwendet."
                                            },
                                            {
                                                "example_id": "7c3e0f99-ccda-47e7-acbb-5374045d4f7a",
                                                "sense_id": "f0c276b2-179d-3373-9c96-9db216fc11b0",
                                                "text": "„Saussure zeichnet ein anderes Modell, in dem deutlicher wird, daß das Zeichen (signe) aus dem Zeichenkörper (signifiant: Bezeichnendes) und der Bedeutung (signifié: Bezeichnetes) besteht und daß der Sachverhalt (chose) das Nichtsprachliche ist.“"
                                            },
                                            {
                                                "example_id": "28576d1a-adb2-4a07-b878-66bbd73a3907",
                                                "sense_id": "f0c276b2-179d-3373-9c96-9db216fc11b0",
                                                "text": "„Saussure suchte seine Terminologie zu verbessern, und da er das ganze Zeichen als signe linguistique, also als sprachliches Zeichen, gefaßt hatte, schien ihm nun ein vom Verbum signifier abgeleitetes Begriffspaar, und zwar signifiant für die Lautung und signifié für den geistigen Inhalt, angemessener.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e357a12a-467d-4442-a7a9-337b3e039a8d",
                        "source_entry_id": "27abab0a-3758-306b-ae3b-44ec5a1db43e",
                        "source_sense_id": "fdd8ff86-eec5-3240-9e3e-c55cc31426c5",
                        "source_sense_description": "Linguistik: Bedeutung des sprachlichen Zeichens",
                        "target_lang_word": "Signifikat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Signifikat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8194e89-761a-34fa-9450-aa8624f7ee69",
                                        "entry_id": "5d5afe52-0d95-359b-868e-15d199759bc0",
                                        "glosses": [
                                            "Bedeutung des sprachlichen Zeichens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed68653c-2d14-4029-93e2-d9b8ffc9ac6b",
                                                "sense_id": "a8194e89-761a-34fa-9450-aa8624f7ee69",
                                                "text": "Ein sprachliches Zeichen vereint in sich zwei Seiten: den sinnlich wahrnehmbaren Ausdruck, die Buchstaben- oder Lautfolge (Signifikant), und die damit verbundene Bedeutung, das Signifikat. \"Hut\" z.B. besteht aus der Folge von 3 Buchstaben bzw. Lauten (Signifikant) und der damit verbundenen Bedeutung \"Art von Kopfbedeckung\" (Signifikat)."
                                            },
                                            {
                                                "example_id": "4aab15d2-363d-45a5-810a-ca055cd74ce4",
                                                "sense_id": "a8194e89-761a-34fa-9450-aa8624f7ee69",
                                                "text": "„Saussure hat für Sprachzeichen eine bilaterale (zweiseitige) Ausdrucks- und Inhaltsstruktur angenommen, deren Zweiseitigkeit er durch die Termini Signifikant (»signifiant«) und Signifikat (»signifié«) angegeben hat.“"
                                            },
                                            {
                                                "example_id": "287090a3-8535-4434-a160-d86d8db22134",
                                                "sense_id": "a8194e89-761a-34fa-9450-aa8624f7ee69",
                                                "text": "„Solange die Eindeutigkeit des Signifikats gewährleistet ist, ist unwesentlich, in welcher konkreten Form sich geschriebene Zeichen ihrer Repräsentationsaufgabe entledigen.“"
                                            },
                                            {
                                                "example_id": "f506826b-4342-4757-be55-3298df5dfc3f",
                                                "sense_id": "a8194e89-761a-34fa-9450-aa8624f7ee69",
                                                "text": "„Werden nun z. B. in Wörterbüchern sprachliche Zeichen - Wort-Zeichen - fixiert, so erscheinen sie als bilaterale Einheiten, denn dem Formativ, dem verallgemeinerten Zeichenkörper, auch Signifikant, wird eine Bedeutung zugeschrieben - auch Signifikat."
                                            },
                                            {
                                                "example_id": "1686a438-e607-4fca-8d9d-fe5f7b84d463",
                                                "sense_id": "a8194e89-761a-34fa-9450-aa8624f7ee69",
                                                "text": "„Wie die Konstruktion des Signifikanten, so war auch diejenige des Signifikates schon in einer rein praxisorientierten Wissenschaftsphase, wenn auch in weniger systematischer Form, gang und gäbe.“"
                                            },
                                            {
                                                "example_id": "9d7b7c9d-c6e4-4629-aa69-a31bafda07ae",
                                                "sense_id": "a8194e89-761a-34fa-9450-aa8624f7ee69",
                                                "text": "„Indem der Signifikant ›Volk‹ in einen bislang ungebräuchlichen außersprachlichen Kontext und sprachlichen Kontext gestellt wird, entsteht ein neues Signifikat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
