                                "sense_id": "b0ec4bea-aa07-335c-b901-5df827a0a90f",
                                "text": "Вот же он!"
                            },
                            {
                                "example_id": "5db84323-42f2-44f6-bcdd-b477de72505f",
                                "sense_id": "b0ec4bea-aa07-335c-b901-5df827a0a90f",
                                "text": "Что же вы не сообщили свой адрес?"
                            },
                            {
                                "example_id": "fe4c3295-1858-4b38-a621-eed0b193e014",
                                "sense_id": "b0ec4bea-aa07-335c-b901-5df827a0a90f",
                                "text": "Я же не знал, что так будет."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b63ec5e-bdd4-319d-b852-2da3f02a0049",
                        "entry_id": "d30860f3-dc54-39b9-8d50-7966f55cd970",
                        "glosses": [
                            "служит для обозначения тождества, одинаковости"
                        ],
                        "tags": [
                            "частица"
                        ],
                        "examples": [
                            {
                                "example_id": "14333001-2aac-4286-9860-12def898ef8d",
                                "sense_id": "7b63ec5e-bdd4-319d-b852-2da3f02a0049",
                                "text": "Такая же ерунда."
                            },
                            {
                                "example_id": "b92b829a-cfa8-4e17-be50-1421a2d6bf8d",
                                "sense_id": "7b63ec5e-bdd4-319d-b852-2da3f02a0049",
                                "text": "Это тот же самый человек."
                            },
                            {
                                "example_id": "a1a5241f-8cef-4a41-93f1-9eeb32ef8805",
                                "sense_id": "7b63ec5e-bdd4-319d-b852-2da3f02a0049",
                                "text": "Это то же, что вы видели в магазине."
                            }
                        ]
                    }
                ],
