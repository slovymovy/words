                "senses": [
                    {
                        "sense_id": "3614f613-ed8f-3d1e-8da6-4098e7a464cf",
                        "entry_id": "de33845f-731a-3847-9f67-2e8a15c21110",
                        "glosses": [
                            "Syphilis"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "2c4da8c1-2c68-4a08-9add-afc426432a54",
                                "sense_id": "3614f613-ed8f-3d1e-8da6-4098e7a464cf",
                                "text": "„Wer weiß, wer der rechte Papst ist? Benedikt heißt der eine: der Gesegnete: er ist mit der Franzosenkrankheit gesegnet. Innozenz, der Unschuldige, heißt der zweite. Er ist unschuldig wie eine Landsknechthure.“"
                            },
                            {
                                "example_id": "c628e279-80ec-4d5f-aa1b-2f08dcb58596",
                                "sense_id": "3614f613-ed8f-3d1e-8da6-4098e7a464cf",
                                "text": "„Die Syphilis hat sich seit dem 16. Jahrhundert als Franzosenkrankheit seuchenartig in Westeuropa ausgebreitet […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b53f5205-0a93-4492-bff7-2be3bd14afe1",
                        "source_entry_id": "de33845f-731a-3847-9f67-2e8a15c21110",
                        "source_sense_id": "3614f613-ed8f-3d1e-8da6-4098e7a464cf",
