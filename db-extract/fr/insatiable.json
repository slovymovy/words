                                        "glosses": [
                                            "nicht zufriedenzustellen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73193981-494d-4717-8e91-e2e452f6a425",
                                                "sense_id": "ed5a70da-2102-37bc-8fff-5927a0cac6af",
                                                "text": "„Papst Franziskus hat an Heiligabend Maßlosigkeit und die Ungleichheiten auf der Welt beklagt. \"Der Mensch ist gierig und unersättlich geworden\" […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
