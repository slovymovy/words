                        "examples": [
                            {
                                "example_id": "b595e204-f714-4d6d-9fde-65f4fd5f9b54",
                                "sense_id": "c728644e-84ec-39f3-bf52-5afe8cd05a83",
                                "text": "Polito won een OBIE Award in 1980 voor zijn theaterwerk en kreeg in 2005 een Maverick Spirit Event Award voor zijn oeuvre op het witte doek en op televisie. Vier jaar geleden kreeg hij de prijs voor beste acteur in de korte film Anti-muse."
                            },
                            {
                                "example_id": "341eab87-4296-488c-8143-e0d0a35d2bd7",
                                "sense_id": "c728644e-84ec-39f3-bf52-5afe8cd05a83",
                                "text": "Ik speel nu twee keer per jaar in zo'n DeLaMar-productie en voor de rest houd ik theaterwerk bijna allemaal af."
