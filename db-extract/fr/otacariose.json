                            {
                                "example_id": "8b93a71d-ac21-424b-8205-d51e8b9fe45e",
                                "sense_id": "fcf7553e-b143-30f1-91f8-f3cafaf5071a",
                                "text": "Le diagnostic d’otacariose est confirmé par la mise en évidence d’otodectes dans le cérumen grâce aux examens otoscopique et microscopique."
                            }
                        ]
