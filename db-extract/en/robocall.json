                        "entry_id": "190eeaee-a465-32bd-ae52-d7cbf5aaa1d3",
                        "glosses": [
                            "An automated phone call, commonly for telemarketing purposes, that uses both an autodialer and a recorded message."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "09dc8ae1-beca-4a76-aac7-8a860c99cd66",
                                "sense_id": "2bfc05eb-ca87-3931-8ca9-281eac726e36",
                                "text": "The e-mailers are upset about “robocalls”—pre-recorded, automated phone calls containing anti-Democratic political messages."
                            },
                            {
                                "example_id": "35d13564-9ab0-4c95-9424-811a94d04e93",
                                "sense_id": "2bfc05eb-ca87-3931-8ca9-281eac726e36",
                                "text": "Rand Paul’s presidential campaign has drafted in his father, libertarian icon Ron Paul, to directly attack Republican rival Ted Cruz in a robocall in Iowa, the first time the former presidential candidate has gone on the offensive on his son’s behalf."
                            },
                            {
                                "example_id": "2fc74e30-3d02-4cbe-a615-c54e8e2712cf",
                                "sense_id": "2bfc05eb-ca87-3931-8ca9-281eac726e36",
                                "text": "Things are at least as bad on mobile phones, which were the lucky recipients of 48 billion robocalls in the United States alone last year."
                            }
                        ]
                    }
