                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53e92fee-7f54-4b18-98cf-0791fd634471",
                                                "sense_id": "cc154599-cfd3-3485-bf5b-7d0230aff582",
                                                "text": "On November 11th we commemorate the fallen with a march."
                                            },
                                            {
                                                "example_id": "c28b2db7-4049-4923-aaff-eff96689738b",
                                                "sense_id": "cc154599-cfd3-3485-bf5b-7d0230aff582",
                                                "text": "On the anniversary of Korczak's murder, Israel commemorated him with a special postal issue. As a stamp collector and philatelic columnist, it pleased me greatly when other countries followed Israel's example in honoring him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30ea67c9-6e56-3e63-a15a-8a1819304ade",
                                        "entry_id": "5cfe3f15-d42f-39f5-9f6e-747308f96328",
                                        "glosses": [
                                            "To serve as a memorial to someone or something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05734d3a-82a3-42b5-88fb-3fbc8e5b611b",
                                                "sense_id": "30ea67c9-6e56-3e63-a15a-8a1819304ade",
                                                "text": "The cenotaph commemorates the fallen."
                                            }
                                        ]
                                    }
