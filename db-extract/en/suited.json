        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e9103557-491d-3532-9b51-238d763fedf9",
                "word": "suited",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0f0af956-9118-4e73-8e77-4a061947256f",
                        "entry_id": "e9103557-491d-3532-9b51-238d763fedf9",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more suited"
                    },
                    {
                        "form_id": "804882c8-b606-47ca-988e-2496ef753de5",
                        "entry_id": "e9103557-491d-3532-9b51-238d763fedf9",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most suited"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e4492001-7654-3621-87dd-c3766263f83e",
                        "entry_id": "e9103557-491d-3532-9b51-238d763fedf9",
                        "glosses": [
                            "Suitable."
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a53d576b-b65c-4e3b-bafa-f55c531fd965",
                                "sense_id": "e4492001-7654-3621-87dd-c3766263f83e",
                                "text": "Particular Forms suited to particular occasions, I have endeavour’d to provide in this Treatise, for general ones, Morning and Evening, you may use these which follow."
                            },
                            {
                                "example_id": "f371b426-4e89-49d3-8357-0364685ab007",
                                "sense_id": "e4492001-7654-3621-87dd-c3766263f83e",
                                "text": "In saying that London is more suited to me than Birmingham, I mean more suited to me as a missioner; therefore it would absorb my time in mission etc work, while Birmingham does not."
                            },
                            {
                                "example_id": "d0999d72-5e11-44db-8ec8-9a957d51aab4",
                                "sense_id": "e4492001-7654-3621-87dd-c3766263f83e",
                                "text": "So I heard AM radio. It seemed to me very suited for the road."
                            }
                        ]
                    },
                    {
                        "sense_id": "7de1f87c-5d59-351c-878b-2205a66b1cd6",
                        "entry_id": "e9103557-491d-3532-9b51-238d763fedf9",
                        "glosses": [
                            "Having the specified kind or number of suits."
                        ],
                        "tags": [
                            "in-compounds"
                        ],
                        "examples": [
                            {
                                "example_id": "76fa2652-1e87-4a7a-82ec-9a5f67c6294d",
                                "sense_id": "7de1f87c-5d59-351c-878b-2205a66b1cd6",
                                "text": "a three-suited hand"
                            }
                        ]
                    },
                    {
                        "sense_id": "fd4c1e96-a040-36e8-8a71-571b410a56d1",
                        "entry_id": "e9103557-491d-3532-9b51-238d763fedf9",
                        "glosses": [
                            "Of the same suit."
                        ],
                        "tags": [
                            "of two or more cards"
                        ],
                        "examples": [
                            {
                                "example_id": "1c7e8405-bfa4-4773-be9f-5dfd04456fc1",
                                "sense_id": "fd4c1e96-a040-36e8-8a71-571b410a56d1",
                                "text": "Brunson has ace-king suited in the small blind"
                            }
                        ]
                    },
                    {
                        "sense_id": "f5bc5615-b9c5-3f14-b06b-4d10ffae93f3",
                        "entry_id": "e9103557-491d-3532-9b51-238d763fedf9",
                        "glosses": [
                            "Wearing a suit."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7417a3b1-ad1c-472e-ba9d-7df28df68325",
                                "sense_id": "f5bc5615-b9c5-3f14-b06b-4d10ffae93f3",
                                "text": "Skull-caps and alchemical paraphernalia surrounded the seventeenth-century quack, whereas his nineteenth-century equivalent might appear top-hatted and suited, evidently a person of learning and ‘quality’."
                            },
                            {
                                "example_id": "1787e787-2914-4dd3-9064-5a5054d5275e",
                                "sense_id": "f5bc5615-b9c5-3f14-b06b-4d10ffae93f3",
                                "text": "“Them?” I pointed to a couple of top-hatted, suited men leaning against a building farther down the street."
                            },
                            {
                                "example_id": "f2d46cbc-5af0-42bb-b96f-480747ec8df4",
                                "sense_id": "f5bc5615-b9c5-3f14-b06b-4d10ffae93f3",
                                "text": "One of the black-suited drivers nodded at his compatriots and slowly walked up to one of the men on the firing line."
                            }
                        ]
                    }
                ],
