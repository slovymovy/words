                ],
                "senses": [
                    {
                        "sense_id": "a2bc3bd5-fab8-3e54-ba14-5aa808f4cd72",
                        "entry_id": "085d0abb-ae06-3124-9e49-f7314e7954d7",
                        "glosses": [
                            "Herstellung/Gewinnung von elektrischer Energie, die in einen elektrischen Strom umgewandelt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a28d310-6552-4f5b-9fe6-7bd8d2808857",
                                "sense_id": "a2bc3bd5-fab8-3e54-ba14-5aa808f4cd72",
                                "text": "„An den Außenseiten der acht äußeren Inseln war jeweils ein Ausleger befestigt, an dessen Ende Windräder zur Stromgewinnung aufragten.“"
                            },
                            {
                                "example_id": "c1106fc1-4d34-41b5-8557-d80c614e2ca1",
                                "sense_id": "a2bc3bd5-fab8-3e54-ba14-5aa808f4cd72",
                                "text": "„Der Kanton Solothurn leistet im Vergleich zu den Bergkantonen nur einen kleinen Beitrag zur Stromgewinnung aus Wasserkraft.“"
                            },
                            {
                                "example_id": "603908ba-dce6-4cae-b710-3743f566ca36",
                                "sense_id": "a2bc3bd5-fab8-3e54-ba14-5aa808f4cd72",
                                "text": "„Das linke Wiesenufer wurde dagegen durch die über 200 Stauseen stark verändert, die unter Stalin zur Stromgewinnung angelegt wurden.“"
                            },
                            {
                                "example_id": "f68eae0e-522d-4ea1-8b94-1a551115faf9",
                                "sense_id": "a2bc3bd5-fab8-3e54-ba14-5aa808f4cd72",
                                "text": "„Die liegen heutzutage meistens trocken, denn das Wasser wird zur Stromgewinnung abgezweigt.“"
                            },
                            {
                                "example_id": "219a41db-7524-4ee0-b49c-a3703c06ba32",
                                "sense_id": "a2bc3bd5-fab8-3e54-ba14-5aa808f4cd72",
                                "text": "„Ziel der Arbeit ist ein Variantenstudium der möglichen Stromgewinnungen mit Einbezug der Randbedingungen vor Ort sowie den rechtlichen Randbedingungen (Wasserbau- WBG und Gewässerschutzgesetzt GSchG).“"
                            },
                            {
                                "example_id": "3abc286d-edfc-4bcf-ba6a-4a6962109c93",
                                "sense_id": "a2bc3bd5-fab8-3e54-ba14-5aa808f4cd72",
                                "text": "„Der Preis für Atomstrom liegt derzeit bei etwa 5,8 Cent/kWh. Ein Preis, der nicht marktfähig ist, weil er weit über den Gestehungskosten anderer Stromgewinnungen liegt.“"
                            },
                            {
                                "example_id": "a9ff91a2-825d-4087-aa48-4bfd0f03e56f",
                                "sense_id": "a2bc3bd5-fab8-3e54-ba14-5aa808f4cd72",
                                "text": "„Gleichzeitig bedeutet das auch den Rückgang herkömmlicher Stromgewinnungen, wie zum Beispiel der Kernkraft. Dies hat vor allem sicherheitstechnische sowie umweltschonende Gründe.“"
                            },
                            {
                                "example_id": "b7d43d1b-bfbc-4984-aa03-a0fc9d38221d",
                                "sense_id": "a2bc3bd5-fab8-3e54-ba14-5aa808f4cd72",
                                "text": "„Aufgrund der dauernden Vorstöße gewähre das Badenwerk nun für Stromgewinnungen aus Wasserkraft, Biomasse und Solarthermie über das Green Pricing hinaus, das er für nicht ausreichend halte, weitere Zuschüsse.“"
                            },
                            {
                                "example_id": "5b2d3de5-d938-4d1f-9b97-1346eb484b92",
                                "sense_id": "a2bc3bd5-fab8-3e54-ba14-5aa808f4cd72",
                                "text": "„Wirklich ausgelastet wäre auch hier die Strecke erst im Mischverkehr (großer Umweg der Köflacher Kohle nach Westen) geworden, der bei einer Elektrifizierung in Kombination mit den neuen leistungsfähigeren Elektrolokomotiven unter Ausnützung von neuen Stromgewinnungen aus Wasserkraftwerken am Koralm-Osthang trotz 23 Promille Längsachsenneigung aber mit 250m-Radien deutlich leistungsfähiger gewesen wäre als eine Semmeringtrasse, auch wenn diese elektrifiziert worden wäre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
