                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b05d546-6bb1-4fa3-93e6-718178e96fc7",
                                                "sense_id": "35da1a76-333e-3513-8478-089c35385cd8",
                                                "text": "His header for the goal followed a perfect corner kick."
                                            },
