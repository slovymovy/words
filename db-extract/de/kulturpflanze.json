                                            {
                                                "example_id": "a25f51ac-6b27-4f5a-b2f2-1d33e3e4f245",
                                                "sense_id": "d0cedede-4158-34f2-a083-dd47a2bb895b",
                                                "text": "This indicates to the engraver that the subject may be cropped to yield the size desired, but it is advisable that the position for the crop also be determined and marked, else some essential feature of the copy may be cut off by arbitrary cropping to get the required size."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4877e70-af82-351c-80a1-fbd13a233b53",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "A short haircut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a05fd2c3-6375-41e6-ae8f-0c5cd1c9c954",
                                                "sense_id": "a4877e70-af82-351c-80a1-fbd13a233b53",
                                                "text": "She went from a ponytail to a crop."
                                            },
                                            {
                                                "example_id": "773d8932-218f-4159-8e48-37e91ab77759",
                                                "sense_id": "a4877e70-af82-351c-80a1-fbd13a233b53",
                                                "text": "Eton crop"
                                            },
                                            {
                                                "example_id": "a0d63286-5c8e-4112-a4b7-dba9351d24b0",
                                                "sense_id": "a4877e70-af82-351c-80a1-fbd13a233b53",
                                                "text": "From an inner pocket he produces a costly Ramillies Wig, shakes it out in a brisk Cloud of scented Litharge, and claps it on, with a minimum of fuss, over his ascetic’s Crop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95f40e7c-64cc-35d8-b828-a668affad3cb",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "A pouch-like part of the alimentary tract of some birds (and some other animals), used to store food before digestion or for regurgitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49613a9b-a0f2-41cf-a998-bcdf2596adce",
                                                "sense_id": "95f40e7c-64cc-35d8-b828-a668affad3cb",
                                                "text": "A little bird sat on the edge of her nest;\nHer yellow-beaks slept as sound as tops;\nThat day she had done her very best,\nAnd had filled every one of their little crops."
                                            },
                                            {
                                                "example_id": "5188b635-7b46-4188-968f-47eda5fdfb4a",
                                                "sense_id": "95f40e7c-64cc-35d8-b828-a668affad3cb",
                                                "text": "The bird gave a gulp, and I felt the stone pass along its gullet and down into its crop."
                                            },
                                            {
                                                "example_id": "1c3d13d6-631b-4e65-934b-d56a71395a0c",
                                                "sense_id": "95f40e7c-64cc-35d8-b828-a668affad3cb",
                                                "text": "As the wildebeest shrinks, the circle of sated birds lounging in the short grass expands. With bulging crops, the vultures settle their heads atop folded wings and slide their nictitating membranes shut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2824a59a-c8a4-3733-96fa-55dc3b661b73",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "The foliate part of a finial."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d414fcba-3249-321f-8314-9fa3805d3d68",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "The head of a flower, especially when picked; an ear of corn; the top branches of a tree."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b3e0b22-c2d6-3707-8598-464b410b1b47",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "Tin ore prepared for smelting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d14b54c-02ff-3953-94bd-d87c637b52af",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "An outcrop of a vein or seam at the surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "405b480b-7794-3053-9cce-419dca56111d",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "An entire oxhide."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6efbc688-2f85-32c7-a3f4-8e7e0b12c305",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "Marijuana."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16c5c45e-0242-4997-b072-24549289cb1f",
                                                "sense_id": "6efbc688-2f85-32c7-a3f4-8e7e0b12c305",
                                                "text": "Cops, come and try to snatch my crops / These pigs wanna blow my house down"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55ddab2e-6dee-3f24-a35f-f08a44c9f421",
                                        "entry_id": "57c29e87-4eea-3681-b3dd-7c26ee931fd4",
                                        "glosses": [
                                            "To remove the top end of something, especially a plant."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3999bc4-52ac-40db-8d96-d06d7f606698",
                                                "sense_id": "55ddab2e-6dee-3f24-a35f-f08a44c9f421",
                                                "text": "I will crop off from the top of his young twigs a tender one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "396e4fd4-123f-300d-a1c4-ec6c25d9570a",
                                        "entry_id": "57c29e87-4eea-3681-b3dd-7c26ee931fd4",
                                        "glosses": [
                                            "To mow, reap or gather."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d85482c-95bb-3955-a919-07759aba235b",
                                        "entry_id": "57c29e87-4eea-3681-b3dd-7c26ee931fd4",
                                        "glosses": [
                                            "To cut (especially hair or an animal's tail or ears) short."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "daebfadd-04ac-3b1c-bd8f-a3ad9e9766c1",
                                        "entry_id": "57c29e87-4eea-3681-b3dd-7c26ee931fd4",
                                        "glosses": [
                                            "To remove the outer parts of a photograph or other image, typically in order to frame the subject better."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42675528-3d7e-49b3-972f-652ff6a30e14",
                                                "sense_id": "daebfadd-04ac-3b1c-bd8f-a3ad9e9766c1",
                                                "text": "Reduce to six inches wide and crop to eight inches high."
                                            },
                                            {
                                                "example_id": "907b9cfe-b6cf-4b77-8f89-75be5558ea3f",
                                                "sense_id": "daebfadd-04ac-3b1c-bd8f-a3ad9e9766c1",
                                                "text": "You'll see that when you enlarge a subject to many times its normal size, and then crop the photo so there is nothing in proportion to be recognized, all resemblance to the original can be hidden."
                                            },
                                            {
                                                "example_id": "90cf4538-c9b0-4c54-9716-0ad5004a8adc",
                                                "sense_id": "daebfadd-04ac-3b1c-bd8f-a3ad9e9766c1",
                                                "text": "Crop the photo for emphasis and composition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eb10fe7-7c09-37fe-879e-eaf3db56d2e7",
                                        "entry_id": "57c29e87-4eea-3681-b3dd-7c26ee931fd4",
                                        "glosses": [
                                            "To yield harvest."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af75f9eb-942f-37e1-9553-f63995714fdd",
                                        "entry_id": "57c29e87-4eea-3681-b3dd-7c26ee931fd4",
                                        "glosses": [
                                            "To cause to bear a crop."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e1d9687-4f15-48a3-ab56-b780b0c4b452",
                                                "sense_id": "af75f9eb-942f-37e1-9553-f63995714fdd",
                                                "text": "to crop a field"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90c5a242-adbd-363d-9b9f-587925f7b190",
                                        "entry_id": "57c29e87-4eea-3681-b3dd-7c26ee931fd4",
                                        "glosses": [
                                            "To beat with a crop, or riding-whip."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f065a37-6ec4-4f4e-889b-b138749b3b93",
                                                "sense_id": "90c5a242-adbd-363d-9b9f-587925f7b190",
                                                "text": "She cropped the horse into a comfortable canter and enjoyed the familiar rhythm and bounce of the horse's stride."
                                            }
                                        ]
                                    }
                                ]
                            }
