                                    {
                                        "sense_id": "bb85ee01-f04e-3bfc-9960-f20bfa6b3ab6",
                                        "entry_id": "225b136b-947d-30d1-9430-390947326d72",
                                        "glosses": [
                                            "państwo w Europie ze stolicą w Kijowie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37f1e210-a509-4dba-9995-a04f9fdbdc47",
                                                "sense_id": "bb85ee01-f04e-3bfc-9960-f20bfa6b3ab6",
                                                "text": "Ukraina jest dużym krajem europejskim."
                                            },
                                            {
                                                "example_id": "afe8e9a8-4af5-46be-aed3-80e0fd3637b3",
                                                "sense_id": "bb85ee01-f04e-3bfc-9960-f20bfa6b3ab6",
                                                "text": "Wojna na Ukrainie to jedno z najstraszliwszych wydarzeń XXI wieku."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "452de7c3-4630-4c1b-be20-3a903e1e5ce7",
                        "source_entry_id": "7de0df52-65e6-3260-9474-b3152919a796",
                        "source_sense_id": "5d4ee853-e94a-39f6-a18b-7221955921f7",
                        "source_sense_description": "country in Eastern Europe",
                        "target_lang_word": "Украи́на",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Украи́на",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a660f59d-f14f-3899-a0e7-a2a7b3420777",
                                        "entry_id": "1e56e1ac-5d75-3353-86ff-2629e7078998",
                                        "glosses": [
                                            "государство в Восточной и частично Центральной Европе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9a5703e-296f-4680-80d6-1b8bcdb25cb9",
                                                "sense_id": "a660f59d-f14f-3899-a0e7-a2a7b3420777",
                                                "text": "Недавно финляндские социал-демократы потребовали объявления полной независимости Финляндии, теперь полную автономию Украины провозгласила Рада, завтра, вероятно, потребуют того же ряд других народностей."
                                            },
                                            {
                                                "example_id": "b062b8c0-2041-4079-b6a5-1e2929f5838e",
                                                "sense_id": "a660f59d-f14f-3899-a0e7-a2a7b3420777",
                                                "text": "Рада объявила Украину «самостийной», и большевики шли на Киев, чтобы вновь покорить и, главное, чтобы разграбить Украину."
                                            },
                                            {
                                                "example_id": "7ccd7a96-fabc-4832-9679-c805326c6e00",
                                                "sense_id": "a660f59d-f14f-3899-a0e7-a2a7b3420777",
                                                "text": "На Украине разогнана Рада, декреты её аннулированы, выбран гетманом Скоропадский, помещик. Выбирал же его император Вильгельм. Стала Украина державой с германской ориентировкой. И Скоропадский ездил к Вильгельму в Берлин на приём."
                                            },
                                            {
                                                "example_id": "b247784b-a98a-41dd-afc3-8cb50ea68646",
                                                "sense_id": "a660f59d-f14f-3899-a0e7-a2a7b3420777",
                                                "text": "Далее мы видели, что некогда существовал особый специально западнорусский литературный язык и что этот язык после соединения Украины с Великоруссией прекратил своё самостоятельное существование."
                                            },
                                            {
                                                "example_id": "60c3487a-f189-4396-8f4f-51aadef180cf",
                                                "sense_id": "a660f59d-f14f-3899-a0e7-a2a7b3420777",
                                                "text": "Шли разговоры о деревне, я представлял в лицах мужиков, помещиков, рассказывал о жизни своей в Полтаве, об увлечении толстовством, а он о жизни на Луге в имении Линтваревых; оба мы восхищались Малороссией (тогда так называлась Украина)."
                                            },
                                            {
                                                "example_id": "aef37a91-5de9-4045-b025-bb8caa67b079",
                                                "sense_id": "a660f59d-f14f-3899-a0e7-a2a7b3420777",
                                                "text": "Можно поздравить украинцев и всех жителей других национальностей Украины с великим событием — подтверждением подавляющим большинством во всех регионах Акта независимости Украинского государства."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
