                        "examples": [
                            {
                                "example_id": "9fc88829-2d2f-42d2-bee3-31df3d4462c0",
                                "sense_id": "6d8758e3-be40-3dd7-b90c-715ba875961c",
                                "text": "Non, tu ne m’as rien donné, juste l’impression d’un peu d’importance à tes yeux en m’intégrant dans ta vie ultra-organisée, ultra-gérée, ultra-remplie…"
                            },
                            {
                                "example_id": "e9efc7d1-3d86-4c68-b67a-5fb2c415ee5d",
                                "sense_id": "6d8758e3-be40-3dd7-b90c-715ba875961c",
                                "text": "Cela n’a pas l’air d’être l’avis de Yolande qui lance des regards horrifiés vers les murs de la pièce couverts de rayonnages ultra-remplis."
                            },
                            {
                                "example_id": "84af55b6-bbc5-4a86-b47f-a4588a1ea0a0",
                                "sense_id": "6d8758e3-be40-3dd7-b90c-715ba875961c",
                                "text": "Ainsi, nous vivons dans une temporalité maximisée, ultra-remplie."
                            }
                        ]
                    }
