                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4b6008b9-d025-4be5-8453-8520c45f615a",
                                "sense_id": "cb4da6b1-d53a-3be4-9b21-4f08d8e257e8",
                                "text": "\"Inter-Ministerial\" Conference on the 30th of September 2013 Palais d’Egmont-Brussels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9ad228a-6583-46a8-b20e-3418b340e1b8",
                        "source_entry_id": "c3e946f6-0e91-3302-a071-e742a1d41045",
