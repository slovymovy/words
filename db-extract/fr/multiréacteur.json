                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68719cb2-7fb3-4bc5-87d1-38e97315f87c",
                                "sense_id": "164e4667-3e25-31f8-b772-c3e6d220eb41",
                                "text": "Le Concorde est le seul multiréacteur de ligne encore en service dont les trains d'atterrissage sont implantés tout près des moteurs."
                            },
                            {
                                "example_id": "9fec57e2-7a55-4c24-85dd-3811bc813acd",
                                "sense_id": "164e4667-3e25-31f8-b772-c3e6d220eb41",
                                "text": "Pour les appareils militaires à réaction, seront mises au point de nouvelles techniques de ravitaillement en vol, en vue d’augmenter l’autonomie des chasseurs et même des multiréacteurs."
                            }
                        ]
                    }
