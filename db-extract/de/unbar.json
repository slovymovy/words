                        "examples": [
                            {
                                "example_id": "32c21524-472e-4d66-9b16-d7d3d27e9eee",
                                "sense_id": "612450e5-a70a-3719-9063-41ae2a052a3b",
                                "text": "Bei der Kreditkartenzahlung erfolgt der Zahlungsvorgang unbar."
                            },
                            {
                                "example_id": "6152e5ed-57db-4eed-80ec-ade0e4f781e7",
                                "sense_id": "612450e5-a70a-3719-9063-41ae2a052a3b",
                                "text": "„Die Landesregierungen werden ermächtigt, durch Rechtsverordnung zu bestimmen, in welchen Fällen Zahlungen an Gerichte und Justizbehörden der Länder unbar zu leisten sind.“"
                            }
