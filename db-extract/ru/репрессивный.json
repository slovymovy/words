                        "form": "репресси́внее"
                    },
                    {
                        "form_id": "9247c663-b130-4e33-8e5f-007a65fecfbe",
                        "entry_id": "e3b12a3c-8f19-3ec8-a00c-6e39b8b5c23e",
                        "tags": [
                            "comparative"
                        ],
                        "form": "репресси́вней"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1e3293cb-bd1b-3500-89f5-b1eda779b096",
                        "entry_id": "e3b12a3c-8f19-3ec8-a00c-6e39b8b5c23e",
                        "glosses": [
                            "книжн. связанный, соотносящийся по значению с существительным репрессия, являющийся репрессией; карательный, служащий для подавления кого-либо или чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f74b8dc-7e62-4163-be43-be25f16658ea",
                                "sense_id": "1e3293cb-bd1b-3500-89f5-b1eda779b096",
                                "text": "На мой взгляд, репрессивные меры, изначально предполагающие в каждом машинисте и помощнике потенциального нарушителя, помогут ма́ло."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61d01c52-41eb-4d12-8432-4eede53b3990",
                        "source_entry_id": "e3b12a3c-8f19-3ec8-a00c-6e39b8b5c23e",
                        "source_sense_id": "1e3293cb-bd1b-3500-89f5-b1eda779b096",
                        "target_lang_word": "repressive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repressive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91408b2f-528c-31b7-a402-e1868ba21f99",
                                        "entry_id": "596729d4-237f-3b25-ab33-d31319eea900",
                                        "glosses": [
                                            "Serving to repress or suppress; oppressive"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "213324ba-9da5-426a-a28b-d17a74211af7",
                                                "sense_id": "91408b2f-528c-31b7-a402-e1868ba21f99",
                                                "text": "Human law is indeed repressive, but repressive on moral principles comprehensively applied to the whole community, and commanding the approval of the moral sense of the governed"
                                            },
                                            {
                                                "example_id": "3903cbae-5b10-44c4-b85a-6a5c58a82798",
                                                "sense_id": "91408b2f-528c-31b7-a402-e1868ba21f99",
                                                "text": "First, the classical rule forbids any unilateral right to use force to overthrow a regime on the sole grounds that it is repressive in character."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3785da6e-f436-4ca4-85f2-23103c450749",
                        "source_entry_id": "e3b12a3c-8f19-3ec8-a00c-6e39b8b5c23e",
                        "source_sense_id": "1e3293cb-bd1b-3500-89f5-b1eda779b096",
                        "target_lang_word": "répressif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "répressif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f48fd599-1530-3867-865d-d8979a85a8e5",
                                        "entry_id": "023a0eb7-ec68-3bce-b5de-ad2a157fa885",
                                        "glosses": [
                                            "Qui réprime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6217bdf-d360-4151-aa70-58aa8794564d",
                                                "sense_id": "f48fd599-1530-3867-865d-d8979a85a8e5",
                                                "text": "Des lois répressives furent édictées ; c’est ainsi qu’on défendit d’entrer et de mettre en vente en France des étoffes des Indes, de la Chine et du Levant, aussi bien de soie pure que mêlée d’argent ou d’or, neuves ou vieilles, à peine de confiscation et de 3.000 livres d’amende."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
