                        "entry_id": "7a03481e-b276-3abc-b23d-e224afdf75fa",
                        "glosses": [
                            "To convert into ontological entities or express in ontological terms."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "381b309b-4b92-4b62-afd4-c34738805790",
                                "sense_id": "c3a54116-0eaf-3b22-84e0-aa6ba50d714b",
                                "text": "H. Richard's refusal to ontologize evil is theologically correct."
                            },
                            {
                                "example_id": "e4ef1e84-80f9-4804-9a57-bbaab220f2c7",
                                "sense_id": "c3a54116-0eaf-3b22-84e0-aa6ba50d714b",
                                "text": "To use Carol Adams's language, to shoot an elk in a “hunting” preserve is to ontologize it as a trophy."
                            },
                            {
                                "example_id": "2069fe35-46a7-411d-ab01-23f66162ce60",
                                "sense_id": "c3a54116-0eaf-3b22-84e0-aa6ba50d714b",
                                "text": "The second option, to ontologize the definition of politics, is an alluring choice, particularly if one finds the “normative grounds” complaints plausible and meaningful."
                            }
                        ]
                    }
