{
    "word_family": [
        "pleb",
        "plebe",
        "plebeianism"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1220f7e7-3bf0-3c8c-afd3-ddbd92ac4148",
                    "sense_definition": "Relating to or characteristic of the common people, as opposed to the nobility or upper class.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "common_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician often spoke about his <w>plebeian</w> roots to appeal to ordinary working-class voters."
                        },
                        {
                            "text": "Despite his sudden wealth, he retained his simple and <w>plebeian</w> tastes in food and clothing."
                        }
                    ],
                    "antonyms": [
                        "noble",
                        "aristocratic",
                        "patrician"
                    ],
                    "common_phrases": [
                        "plebeian origins",
                        "plebeian tastes"
                    ]
                },
                {
                    "sense_id": "a6a5aee5-bd49-36a4-9961-550f18a8a9ca",
                    "sense_definition": "Crude, vulgar, or lacking refined taste or sophistication.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "common_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic dismissed the popular blockbuster as entertainment for audiences with <w>plebeian</w> sensibilities."
                        },
                        {
                            "text": "She looked down on commercial television shows, claiming they were entirely too <w>plebeian</w> for her."
                        }
                    ],
                    "antonyms": [
                        "aristocratic",
                        "patrician"
                    ]
                },
                {
                    "sense_id": "c9082b48-d14b-38dc-baf9-8463e304e998",
                    "sense_definition": "Belonging or relating to the plebs, the ordinary citizens of ancient Rome who were not patricians.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ancient_rome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the Roman Republic, the tribunes were elected to protect <w>plebeian</w> rights from patrician overreach."
                        },
                        {
                            "text": "A long political struggle took place before <w>plebeian</w> citizens could serve as high-ranking magistrates."
                        }
                    ],
                    "antonyms": [
                        "patrician"
                    ],
                    "common_phrases": [
                        "plebeian tribunes"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a0f2dc8f-cdcc-3d9a-a7a5-9fade928670a",
                    "sense_definition": "A member of the lower or working classes, especially one regarded as coarse or uncultured.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "common_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The aristocrat treated anyone outside his social circle as an ignorant <w>plebeian</w>."
                        },
                        {
                            "text": "He refused to see himself as a <w>plebeian</w>, striving endlessly to enter elite society."
                        }
                    ],
                    "synonyms": [
                        "commoner",
                        "pleb",
                        "plebe",
                        "peasant",
                        "nobody"
                    ],
                    "antonyms": [
                        "aristocrat",
                        "patrician"
                    ],
                    "common_phrases": [
                        "mere plebeian"
                    ]
                },
                {
                    "sense_id": "9eb0ffec-c0a6-37d7-b620-5560283da1d1",
                    "sense_definition": "In ancient Rome, an ordinary citizen who was not a patrician.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ancient_rome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Any Roman <w>plebeian</w> could seek assistance from a tribune if treated unfairly by a magistrate."
                        },
                        {
                            "text": "Early Roman law strictly forbade marriage between a patrician and a <w>plebeian</w>."
                        }
                    ],
                    "synonyms": [
                        "pleb",
                        "commoner"
                    ],
                    "antonyms": [
                        "patrician"
                    ]
                }
            ]
        }
    ]
}