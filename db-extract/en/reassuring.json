                                                "sense_id": "bb7423b8-c868-3679-ab87-3c509225b526",
                                                "text": "Nouvelle rassurante."
                                            },
                                            {
                                                "example_id": "20727f2e-98b2-4c45-88a8-82ba171ce128",
                                                "sense_id": "bb7423b8-c868-3679-ab87-3c509225b526",
                                                "text": "Avis rassurant."
                                            },
                                            {
                                                "example_id": "19d74a8e-b515-414c-81be-2d7bfb069ba6",
                                                "sense_id": "bb7423b8-c868-3679-ab87-3c509225b526",
                                                "text": "Ce n’est pas rassurant, ce n’est guère rassurant."
                                            },
                                            {
                                                "example_id": "b8e3fd56-8e65-4cfd-846c-bee1a1eb7006",
                                                "sense_id": "bb7423b8-c868-3679-ab87-3c509225b526",
                                                "text": "Les nouvelles sont plus rassurantes pour Cyril Baille, le pilier, blessé aux adducteurs, qui n’aura finalement pas besoin de chirurgie."
                                            }
                                        ]
                                    }
