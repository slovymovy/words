                "entry_id": "133da415-e5cb-32f4-8a74-d5ae31e6ea8c",
                "word": "bézouka",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f3b0dd85-6863-417d-a9b1-da1f14bd02e7",
                        "entry_id": "133da415-e5cb-32f4-8a74-d5ae31e6ea8c",
                        "tags": [
