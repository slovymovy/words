                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>glimlach</w> altijd als ik aan mijn vakantie denk.",
                            "target_lang_translations": {
                                "ru": "Я всегда <w>улыбаюсь</w>, когда думаю о своем отпуске.",
                                "en": "I always <w>smile</w> when I think of my vacation.",
                                "pl": "Zawsze się <w>uśmiecham</w>, kiedy myślę o moich wakacjach.",
                                "de": "Ich <w>lächle</w> immer, wenn ich an meinen Urlaub denke.",
                                "fr": "Je <w>souris</w> toujours quand je pense à mes vacances.",
                                "it": "Io <w>sorrido</w> sempre quando penso alle mie vacanze.",
