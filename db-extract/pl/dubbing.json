                        "entry_id": "931fd2fb-4936-3e98-82b4-2a0434df5e15",
                        "glosses": [
                            "dialogi przetłumaczone z obcego języka, przygotowane w postprodukcji i zastępujące oryginalną ścieżkę dialogową w filmie, serialu lub grze komputerowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1881bcc8-9597-4f3f-b22f-c3d84cbdacdd",
                                "sense_id": "ffa3dc8b-1374-3c3c-b7ba-371fb70e64ff",
                                "text": "Dubbing do tego filmu zyskał aprobatę krytyków."
                            },
                            {
                                "example_id": "12bb7df3-1813-4d6e-8912-5bdd0807788a",
                                "sense_id": "ffa3dc8b-1374-3c3c-b7ba-371fb70e64ff",
                                "text": "Ten film jest z dubbingiem czy z napisami?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
