                        "glosses": [
                            "To type using a typewriter."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "539dd0d7-d982-4da9-b2f8-21fb893192ce",
                                "sense_id": "121efffa-8ba5-3e9f-bb26-80d883636e47",
                                "text": "1925, William Frederick Book, Learning to Typewrite: With a Discussion of the Psychology and Pedagogy of Skill, The Gregg pub. co.,\nThese facts are set forth for learning to typewrite in Part II of this book."
                            },
                            {
                                "example_id": "b04784d4-de63-41f5-96bc-39e0dc477cc5",
                                "sense_id": "121efffa-8ba5-3e9f-bb26-80d883636e47",
                                "text": "1935, New Jersey Secondary School Teachers' Association, Lord Dufferin School. Old Boys Association, Yearbook, page 215,\nIF THE businessman discovers that his new office worker cannot spell, typewrite, compute percentage or punctuate properly, he is immediately confronted with a series of in-training problems."
                            },
                            {
                                "example_id": "86c59a14-0f2a-4430-9690-03bc7638fa03",
                                "sense_id": "121efffa-8ba5-3e9f-bb26-80d883636e47",
                                "text": "1944, Robert Luther Duffus, The Innocents at Cedro: A Memoir of Thorsein Veblen and Some Others, The Macmillan company, page 71,\nI began to typewrite copy letters for him, and I have never been long free from the typewriter since."
                            },
                            {
                                "example_id": "28c6b433-9655-4c8c-97fd-cc10aa0ecb77",
                                "sense_id": "121efffa-8ba5-3e9f-bb26-80d883636e47",
                                "text": "1994, Kas Mazurek and Margret A. Winzer, Comparative Studies in Special Education, Gallaudet University Press, page 193,\nThird, a major barrier for blind and physically handicapped children is removed by permitting them to typewrite their answers during public examinations."
                            }
                        ]
                    }
