                    }
                ],
                "translations": [
                    {
                        "translation_id": "acc8aaaa-88e1-4d35-b30d-e6a02997b099",
                        "source_entry_id": "f03e1d02-a373-314d-ad83-abb91433e837",
                        "source_sense_id": "e99dd752-1bdc-3779-88b7-32780d270bf9",
                        "target_lang_word": "interpreter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interpreter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92b02343-3609-3c7a-8f86-0dc7ef79eb40",
                                        "entry_id": "f6b128f0-d70f-396a-b2bb-08d56bfa85e2",
                                        "glosses": [
                                            "A person or thing that interprets the meaning of something for another, particularly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12b32904-d316-4275-bb4e-fabef37d7f3b",
                                                "sense_id": "92b02343-3609-3c7a-8f86-0dc7ef79eb40",
                                                "text": "... an interpreter of dreams ..."
                                            },
                                            {
                                                "example_id": "3f690f18-6177-4c5f-8118-bfb5fd30290c",
                                                "sense_id": "92b02343-3609-3c7a-8f86-0dc7ef79eb40",
                                                "text": "[…] the Priest or Medicine-man […] early appeared on the plantation and found his function as the healer of the sick, the interpreter of the Unknown […] and the one who rudely but picturesquely expressed the longing, disappointment, and resentment of a stolen and oppressed people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e14bc1d-a18c-304b-a534-33d0d62eb576",
                                        "entry_id": "f6b128f0-d70f-396a-b2bb-08d56bfa85e2",
                                        "glosses": [
                                            "A person or thing that interprets the meaning of something for another",
                                            "A person or thing that translates direct speech or signing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dededb7-f2e1-4336-b277-d68b88b8bb0f",
                                                "sense_id": "5e14bc1d-a18c-304b-a534-33d0d62eb576",
                                                "text": "A Japanese man who is tried before a German court is assisted by an interpreter in making oral statements."
                                            },
                                            {
                                                "example_id": "d9f2aa5b-2846-4cab-96d2-53c5d6b89d3e",
                                                "sense_id": "5e14bc1d-a18c-304b-a534-33d0d62eb576",
                                                "text": "... [[when you ſallie vpon him, ſpeake what terrible Language you will: though you vnderſtand it not your ſelues, no matter: for we must not ſeeme to vnderſtand him, vnleſſe ſome one among vs, whom wee must produce for an Interpreter."
                                            },
                                            {
                                                "example_id": "336b2375-01c3-4201-b1fd-981fca1edd4a",
                                                "sense_id": "5e14bc1d-a18c-304b-a534-33d0d62eb576",
                                                "text": "I had many Acquaintance among Persons of the best Fashion, and being always attended by my Interpreter, the Conversation we had was not disagreeable."
                                            },
                                            {
                                                "example_id": "3dbd722c-5517-49c4-b90c-bbf80b8c9e97",
                                                "sense_id": "5e14bc1d-a18c-304b-a534-33d0d62eb576",
                                                "text": "I can understand German as well as the maniac that invented it, but I talk it best through an interpreter."
                                            },
                                            {
                                                "example_id": "6acfe70d-b0ed-44cf-b40e-153ff36911ae",
                                                "sense_id": "5e14bc1d-a18c-304b-a534-33d0d62eb576",
                                                "text": "Once in the classroom the interpreter might inform the deaf person of various auditory information occurring in the environment such as: The teacher has a strong accent. Your hearing aid is making a noise. The fire alarm has gone off!"
                                            },
                                            {
                                                "example_id": "d5057ad2-c0f5-46f7-8bee-33e8ec0348ff",
                                                "sense_id": "5e14bc1d-a18c-304b-a534-33d0d62eb576",
                                                "text": "So began my career as our family’s official interpreter. From then on, I would fill in our blanks, our silences, stutters, whenever I could. I code switched. I took off our language and wore my English, like a mask, so that others would see my face, and therefore yours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66885418-6f61-39e6-aee4-ea403e915c36",
                                        "entry_id": "f6b128f0-d70f-396a-b2bb-08d56bfa85e2",
                                        "glosses": [
                                            "A person or thing that interprets the meaning of something for another",
                                            "Synonym of translator, one who translates various forms of texts."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea2f97a8-6d13-31fa-b85b-f619b4531b03",
                                        "entry_id": "f6b128f0-d70f-396a-b2bb-08d56bfa85e2",
                                        "glosses": [
                                            "A person or thing that interprets the meaning of something for another",
                                            "Synonym of commentator, one who explains laws or scripture."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8df43bbf-5e9e-4da2-ae83-1748a772e3e4",
                                                "sense_id": "ea2f97a8-6d13-31fa-b85b-f619b4531b03",
                                                "text": "... the holy fathers interpretours of holy scrypture ..."
                                            },
                                            {
                                                "example_id": "067a685a-fb23-47ea-943b-e1e85d88d13a",
                                                "sense_id": "ea2f97a8-6d13-31fa-b85b-f619b4531b03",
                                                "text": "Then said Christian to the Interpreter,\n Expound this matter more fully to me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "243db4ea-9275-31f4-a806-c119f800282a",
                                        "entry_id": "f6b128f0-d70f-396a-b2bb-08d56bfa85e2",
                                        "glosses": [
                                            "A person or thing that interprets the meaning of something for another",
                                            "Synonym of emissary, particularly in reference to Hermes or angels as messengers between humans and the divine."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b2bcaae-269b-3f36-89a4-49d60beeaf24",
                                        "entry_id": "f6b128f0-d70f-396a-b2bb-08d56bfa85e2",
                                        "glosses": [
                                            "A person or thing that interprets the meaning of something for another",
                                            "Synonym of guide, one who explains a thing, person, or group of people."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3801de86-dbfa-46ca-9f4d-c8389e12fe0d",
                                                "sense_id": "5b2bcaae-269b-3f36-89a4-49d60beeaf24",
                                                "text": "At the historic site, there are a number of interpreters who demonstrate ancient crafts."
                                            },
                                            {
                                                "example_id": "14a724f0-0cfb-4041-9332-39fa94708d15",
                                                "sense_id": "5b2bcaae-269b-3f36-89a4-49d60beeaf24",
                                                "text": "A severe interpreter might say that the mere facts of their relation to each other, the melancholy position of this woman who depended on his will, made a standing banquet for his delight in dominating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d0f553e-61bf-3fc9-bcfe-003160b7a3e9",
                                        "entry_id": "f6b128f0-d70f-396a-b2bb-08d56bfa85e2",
                                        "glosses": [
                                            "A person or thing that interprets the meaning of something for another",
                                            "A thing that, figuratively speaking, performs a similar role explaining, revealing, or clarifying."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bc57b3f-2611-41f9-b737-1ef812f998f7",
                                                "sense_id": "2d0f553e-61bf-3fc9-bcfe-003160b7a3e9",
                                                "text": "Leo. ... theſe thy offices\n (So rarely kind) are as Interpreters\n Of my behind-hand ſlackneſſe."
                                            },
                                            {
                                                "example_id": "6a2cf0af-7d24-4b13-85d9-d1039acf2cdc",
                                                "sense_id": "2d0f553e-61bf-3fc9-bcfe-003160b7a3e9",
                                                "text": "Flowers are the interpreters of love in India, painting in the most vivid but in the softest colours speaking in the sweetest sighs: while each blossom that fades is a mournful remembrancer either of blighted hopes or departed pleasures."
                                            },
                                            {
                                                "example_id": "80850cf9-d707-4acb-bb6f-6440abb805be",
                                                "sense_id": "2d0f553e-61bf-3fc9-bcfe-003160b7a3e9",
                                                "text": "... the modern drama—the strongest and most far-reaching interpreter of our deep-felt dissatisfaction ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "333328a5-95a0-34eb-b30d-659045820c54",
                                        "entry_id": "f6b128f0-d70f-396a-b2bb-08d56bfa85e2",
                                        "glosses": [
                                            "A person or thing that interprets the meaning of something for another",
                                            "Synonym of synonymy, the use of one term to explain another."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rhetoric"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5cc4b2db-58b3-3563-b173-abdd199a051e",
                                        "entry_id": "f6b128f0-d70f-396a-b2bb-08d56bfa85e2",
                                        "glosses": [
                                            "A person or thing that interprets the meaning of something for another",
                                            "Synonym of dictionary or glossary, a book that explains uncommon terms."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f574cec-1927-360f-a8c3-5bcc1ad0d65b",
                                        "entry_id": "f6b128f0-d70f-396a-b2bb-08d56bfa85e2",
                                        "glosses": [
                                            "A person or thing that interprets the meaning of something for another",
                                            "A machine that reads the pattern of holes on a punch card and prints its meaning along the top of the card."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "800cd680-a77d-3bce-8bd7-30373f518d97",
                                        "entry_id": "f6b128f0-d70f-396a-b2bb-08d56bfa85e2",
                                        "glosses": [
                                            "A person or thing that interprets the meaning of something for another",
                                            "An analyst of reconnaissance photographs."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc8a62eb-7b0b-372f-a086-9b1527a8b09b",
                                        "entry_id": "f6b128f0-d70f-396a-b2bb-08d56bfa85e2",
                                        "glosses": [
                                            "A person or thing that interprets the meaning of something for another",
                                            "A program that converts commands into machine language in real time rather than compiling it in advance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7021441b-d0b4-48fb-9f55-05a64c97bdb0",
                                                "sense_id": "dc8a62eb-7b0b-372f-a086-9b1527a8b09b",
                                                "text": "Programs written in BASIC are usually run through an interpreter rather than a compiler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8948cfb6-d9bd-3d52-b003-6ee1e8d9e6d6",
                                        "entry_id": "f6b128f0-d70f-396a-b2bb-08d56bfa85e2",
                                        "glosses": [
                                            "A person or thing that interprets the meaning of something for another",
                                            "A performer who presents a piece of art in a distinct style, particularly so as to make older works relevant to their audience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9f7c676-5a12-467a-aaf5-5eee884a3c44",
                                                "sense_id": "8948cfb6-d9bd-3d52-b003-6ee1e8d9e6d6",
                                                "text": "... one of the foremost interpreters of Beethoven's piano works ..."
                                            }
                                        ]
                                    }
                                ]
                            }
