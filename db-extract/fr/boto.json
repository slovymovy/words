                "senses": [
                    {
                        "sense_id": "c8d6cd72-6dbf-38ce-9858-6b903ed09082",
                        "entry_id": "31e3055c-cd9e-3012-8369-b889d05389b8",
                        "glosses": [
                            "Espèce de dauphin d’eau douce des bassins de l’Amazone et de l’Orénoque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e519111b-4bff-4bd6-bdd9-a7fbd2ce7825",
                                "sense_id": "c8d6cd72-6dbf-38ce-9858-6b903ed09082",
                                "text": "Le menu du boto se compose d'une cinquantaine d’espèces de poissons dont la taille ne dépasse pas les 30 centimètres. Mais le dauphin se nourrit également de tortues et de crabes."
                            },
                            {
                                "example_id": "18998f08-9e5f-4483-a56c-b9ad6be84fdb",
                                "sense_id": "c8d6cd72-6dbf-38ce-9858-6b903ed09082",
                                "text": "Aussi énigmatique que fascinant, le boto est un dauphin exceptionnel vivant en Amazonie."
                            },
                            {
                                "example_id": "34427ab9-5284-44cf-a079-62c86af090c5",
                                "sense_id": "c8d6cd72-6dbf-38ce-9858-6b903ed09082",
                                "text": "Au Brésil, on connaît des dauphins roses. … Les populations les appellent des botos."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
