                    {
                        "translation_id": "22e5aec1-3812-4640-adec-b5d338cfcb69",
                        "source_entry_id": "bb252d9e-6887-3e6c-aebe-bf7fd8309338",
                        "source_sense_description": "dominate",
                        "target_lang_word": "beherrschen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beherrschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44216c45-32d6-38a4-90c5-e745be670c42",
                                        "entry_id": "100fd704-0766-3c8f-aab4-cf60b1f2be1e",
                                        "glosses": [
                                            "Macht über jemand oder etwas ausüben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a432ca22-24be-4298-a652-e5bee62d4f76",
                                                "sense_id": "44216c45-32d6-38a4-90c5-e745be670c42",
                                                "text": "Der Terror beherrscht viele Regionen der Erde."
                                            },
                                            {
                                                "example_id": "bb0fec6a-312f-454d-beb1-536a328d336f",
                                                "sense_id": "44216c45-32d6-38a4-90c5-e745be670c42",
                                                "text": "„Mit dem Partisanenführer Tito, der bereits große Teile Jugoslawiens beherrschte, hatte der sowjetische Diktator verabredet, daß die Rote Armee zu ihm und dann gemeinsam weiter westwärts durchstoßen werde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db54cff1-27ec-39c8-816e-472a992a6664",
                                        "entry_id": "100fd704-0766-3c8f-aab4-cf60b1f2be1e",
                                        "glosses": [
                                            "etwas sehr gut können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d17826c5-431c-4e6e-a215-ef363c2fa504",
                                                "sense_id": "db54cff1-27ec-39c8-816e-472a992a6664",
                                                "text": "Es ist gut, wenn man Fremdsprachen beherrscht."
                                            },
                                            {
                                                "example_id": "3bba1be8-2fbc-456c-a97f-398dfe8cfd28",
                                                "sense_id": "db54cff1-27ec-39c8-816e-472a992a6664",
                                                "text": "„Nach einem halben Jahre beherrschte Mirko sämtliche Geheimnisse der Schachtechnik,“ […]."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2c7c076d-c9c9-384f-9c6c-5330ebefda3f",
                                        "entry_id": "100fd704-0766-3c8f-aab4-cf60b1f2be1e",
                                        "glosses": [
                                            "prägendes Merkmal sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d998bdb3-4168-43a6-b801-d24b19bfa477",
                                                "sense_id": "2c7c076d-c9c9-384f-9c6c-5330ebefda3f",
                                                "text": "Die Zugspitze beherrscht als hoher Berg ihre Umgebung."
                                            },
                                            {
                                                "example_id": "70c9ff96-9d83-4607-9d96-bf5a1f0f6727",
                                                "sense_id": "2c7c076d-c9c9-384f-9c6c-5330ebefda3f",
                                                "text": "„Hier war alles beherrscht vom würzigen Rauch der Wachskerzen, vom Ledergeruch, der dem Riemzeug und den Stiefeln der Soldaten entströmte und vom Naphtalinduft der Kaftane oder der so selten ans Tageslicht geförderten Contouche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "50893caa-7780-3ed9-b8db-342e85fed70c",
                                        "entry_id": "100fd704-0766-3c8f-aab4-cf60b1f2be1e",
                                        "glosses": [
                                            "sich zurückhalten, zusammenreißen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8999eac-9cd0-4148-b7af-d7285bb86c02",
                                                "sense_id": "50893caa-7780-3ed9-b8db-342e85fed70c",
                                                "text": "In diesem Kreis muss man sich sehr beherrschen, um nicht ausfällig zu werden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
