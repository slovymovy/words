    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "56a28796-c837-3c2f-8e53-f1c4be969309",
                "word": "internecine",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "36c56d79-7500-3043-b68a-c0f21f9d984d",
                        "entry_id": "56a28796-c837-3c2f-8e53-f1c4be969309",
                        "glosses": [
                            "Mutually destructive; most often applied to warfare."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bce3ecd8-7a09-4ab2-bf27-50aa2cc90be8",
                                "sense_id": "36c56d79-7500-3043-b68a-c0f21f9d984d",
                                "text": "Internecine strife in Gaza claimed its most senior victim yesterday when militants assassinated one of the most hated security chiefs there."
                            }
                        ]
                    },
                    {
                        "sense_id": "87abdfeb-ee57-39e9-b848-facf765723da",
                        "entry_id": "56a28796-c837-3c2f-8e53-f1c4be969309",
                        "glosses": [
                            "Characterized by struggle within a group, usually applied to an ethnic or familial relationship."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b3e48afb-c80d-40bb-b35a-89b00e59f2c3",
                                "sense_id": "87abdfeb-ee57-39e9-b848-facf765723da",
                                "text": "The Mongol people were plagued by internecine conflict until Genghis Khan unified them by focusing their aggression outwards on other peoples."
                            },
                            {
                                "example_id": "0b9433d0-98f9-4cf0-b261-426dd0e6b1bb",
                                "sense_id": "87abdfeb-ee57-39e9-b848-facf765723da",
                                "text": "During the year of my engagement — 1869 — while I was out on the lecture platform, the daily letter that came for me generally brought me news from the front — by which expression I refer to the internecine war that was always going on in a friendly way between these two orthographists about the spelling of words."
                            },
                            {
                                "example_id": "4b26e989-d720-40a4-994a-e3e8176801b8",
                                "sense_id": "87abdfeb-ee57-39e9-b848-facf765723da",
                                "text": "Having survived “The Long Night,” Daenerys will now be turning her attention back to the problem that originally vexed her: Cersei Lannister. It will be interesting to see how the show tries to raise the stakes of an internecine squabble between competing monarchs when compared to an existential threat to humanity’s very existence, but this series has always excelled when it goes deep on the machinations of political chicanery."
                            }
                        ]
                    }
                ],
