                                        "entry_id": "e11357cf-2abe-3369-8a0f-2257cb1a6556",
                                        "glosses": [
                                            "Thermoplast, aus Amiden bestehendes Polymer, das bei der Kunstfaserherstellung Verwendung findet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdfc166e-8876-49a5-bd58-503cd7df59c7",
                                                "sense_id": "49e0472a-d5c4-32d4-9f5e-111feea03767",
                                                "text": "Nylon war die erste Polyamid-Faser."
                                            },
                                            {
                                                "example_id": "875ca67b-dd81-43d6-99cf-b31c7560a60e",
                                                "sense_id": "49e0472a-d5c4-32d4-9f5e-111feea03767",
                                                "text": "„Die Bezeichnung Polyamide wird üblicherweise als Bezeichnung für synthetische, technisch verwendbare thermoplastische Kunststoffe verwendet und grenzt diese Stoffklasse damit von den chemisch verwandten Proteinen ab.“"
                                            }
                                        ],
