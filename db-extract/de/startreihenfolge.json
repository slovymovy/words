                        "glosses": [
                            "Reihenfolge, in der die Teilnehmer eines Wettbewerbs an den Start gehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2afe38a0-7016-4065-88bf-5c6bc50c519a",
                                "sense_id": "f0fdc660-3d32-3407-a2f3-6161366dfc33",
                                "text": "„Es war erwartet worden, dass der Weltrat den von der WRC-Kommission vorgebrachten Plänen zur Startreihenfolge entweder zustimmt oder aber diese im letzten Moment noch kippen lässt.“"
                            },
                            {
                                "example_id": "a0bc42b8-4d9e-4438-b9f1-620658763a90",
                                "sense_id": "f0fdc660-3d32-3407-a2f3-6161366dfc33",
                                "text": "„Die European Broadcasting Union (EBU) hat am Freitag die Startreihenfolge für das Finale des Eurovision Song Contests in Malmö bekannt gegeben.“"
                            }
                        ],
