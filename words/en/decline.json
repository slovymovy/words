{
    "word_family": [
        "declension",
        "declinable",
        "declination",
        "decliner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5eca0726-ddba-37a6-8dc0-685ff72ecdcd",
                    "sense_definition": "To politely refuse an offer, invitation, or request.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "refusal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had to <w>decline</w> the invitation to the party because I already had other plans.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось <w>отклонить</w> приглашение на вечеринку, так как у меня уже были другие планы."
                            }
                        },
                        {
                            "text": "On reflection I think I will <w>decline</w> your generous offer for the new position.",
                            "target_lang_translations": {
                                "ru": "Поразмыслив, я думаю, что <w>откажусь</w> от вашего щедрого предложения о новой должности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "decline an invitation",
                        "decline an offer",
                        "politely decline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливо отказаться от предложения, приглашения или просьбы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклонить",
                                "target_lang_sense_clarification": "предложение или приглашение"
                            },
                            {
                                "target_lang_word": "отказаться",
                                "target_lang_sense_clarification": "от чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f0c3d63-67b1-3bd2-8ae8-8fd9e034b05a",
                    "sense_definition": "To decrease in quantity, value, or amount.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "decrease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The value of the dollar has <w>declined</w> rapidly since the beginning of the year.",
                            "target_lang_translations": {
                                "ru": "Стоимость доллара стремительно <w>снизилась</w> с начала года."
                            }
                        },
                        {
                            "text": "Experts predict that the population will <w>decline</w> over the next decade.",
                            "target_lang_translations": {
                                "ru": "Эксперты прогнозируют, что численность населения <w>сократится</w> в течение следующего десятилетия."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rapidly decline",
                        "decline in value"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшаться в количестве, стоимости или объеме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снижаться",
                                "target_lang_sense_clarification": "о показателях или стоимости"
                            },
                            {
                                "target_lang_word": "сокращаться",
                                "target_lang_sense_clarification": "о количестве или численности"
                            },
                            {
                                "target_lang_word": "падать",
                                "target_lang_sense_clarification": "о курсе валют или спросе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65549dba-3336-31ed-ad43-1f1316f6d024",
                    "sense_definition": "To become weaker or worse in condition or health.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deterioration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient's health began to <w>decline</w> noticeably after the surgery.",
                            "target_lang_translations": {
                                "ru": "Здоровье пациента начало заметно <w>ухудшаться</w> после операции."
                            }
                        },
                        {
                            "text": "Standards of living often <w>decline</w> during periods of economic instability.",
                            "target_lang_translations": {
                                "ru": "Уровень жизни часто <w>снижается</w> в периоды экономической нестабильности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "health declined",
                        "standards decline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться слабее или хуже по состоянию или здоровью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухудшаться",
                                "target_lang_sense_clarification": "о здоровье или стандартах"
                            },
                            {
                                "target_lang_word": "ослабевать",
                                "target_lang_sense_clarification": "терять силы"
                            },
                            {
                                "target_lang_word": "приходить в упадок",
                                "target_lang_sense_clarification": "о состоянии дел или экономики"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0be5fde4-e3f7-318e-9068-1ae47ba57b50",
                    "sense_definition": "To inflect a word for case, number, or gender; to recite the <w>declension</w> of a word.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Latin class, students must learn how to <w>decline</w> various nouns and adjectives.",
                            "target_lang_translations": {
                                "ru": "На уроках латыни студенты должны научиться <w>склонять</w> различные существительные и прилагательные."
                            }
                        },
                        {
                            "text": "The teacher asked the student to <w>decline</w> the word for king in all its forms.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил ученика <w>просклонять</w> слово «король» во всех его формах."
                            }
                        }
                    ],
                    "synonyms": [
                        "declense"
                    ],
                    "common_phrases": [
                        "decline a noun"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять слово по падежам, числам или родам; перечислять формы слова."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склонять",
                                "target_lang_sense_clarification": "изменять по падежам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7762403c-2863-39ab-9ee5-6c700fe0a25e",
                    "sense_definition": "To reject a penalty against the opposing team in sports.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team chose to <w>decline</w> the penalty because they preferred the result of the play.",
                            "target_lang_translations": {
                                "ru": "Команда решила <w>отклонить</w> штраф, так как результат розыгрыша их устраивал больше."
                            }
                        },
                        {
                            "text": "The coach decided to <w>decline</w> the fifteen-yard penalty to keep the current field position.",
                            "target_lang_translations": {
                                "ru": "Тренер решил <w>отказаться</w> от пятнадцатиъярдового штрафа, чтобы сохранить текущую позицию на поле."
                            }
                        }
                    ],
                    "common_phrases": [
                        "decline the penalty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отказаться от штрафа против команды соперника в спорте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклонить",
                                "target_lang_sense_clarification": "штраф или пенальти"
                            },
                            {
                                "target_lang_word": "отказаться",
                                "target_lang_sense_clarification": "от применения штрафа"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "38067a0d-854c-394e-8221-caf6e4a7ed7d",
                    "sense_definition": "A reduction or diminution of activity, prevalence, or quantity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "decrease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city is facing a significant population <w>decline</w> as people move to the suburbs.",
                            "target_lang_translations": {
                                "ru": "Город сталкивается со значительным <w>сокращением</w> населения, так как люди переезжают в пригороды."
                            }
                        },
                        {
                            "text": "Retailers have seen a <w>decline</w> in footfall since the new mall opened.",
                            "target_lang_translations": {
                                "ru": "Ритейлеры заметили <w>спад</w> посещаемости с момента открытия нового торгового центра."
                            }
                        }
                    ],
                    "common_phrases": [
                        "population decline",
                        "economic decline",
                        "sharp decline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение или уменьшение активности, распространенности или количества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спад",
                                "target_lang_sense_clarification": "экономический или в активности"
                            },
                            {
                                "target_lang_word": "снижение",
                                "target_lang_sense_clarification": "цен или показателей"
                            },
                            {
                                "target_lang_word": "сокращение",
                                "target_lang_sense_clarification": "численности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca01e6f1-9d5e-34b2-ba20-d551d6d89671",
                    "sense_definition": "A deterioration of condition; a weakening or worsening.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deterioration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has experienced a sudden <w>decline</w> in his health over the last month.",
                            "target_lang_translations": {
                                "ru": "За последний месяц он столкнулся с внезапным <w>ухудшением</w> здоровья."
                            }
                        },
                        {
                            "text": "Many citizens are worried that educational standards are on the <w>decline</w>.",
                            "target_lang_translations": {
                                "ru": "Многие граждане обеспокоены тем, что образовательные стандарты находятся в <w>упадке</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the decline",
                        "decline in health"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ухудшение состояния; ослабление или деградация."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упадок",
                                "target_lang_sense_clarification": "сил или нравов"
                            },
                            {
                                "target_lang_word": "ухудшение",
                                "target_lang_sense_clarification": "здоровья или ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4930b13d-029d-3752-a825-a9086696b52d",
                    "sense_definition": "A sloping downward, such as a hill or road.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "slope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After taking a right from that turn a steep <w>decline</w> will come into view.",
                            "target_lang_translations": {
                                "ru": "После поворота направо откроется вид на крутой <w>спуск</w>."
                            }
                        },
                        {
                            "text": "The cyclists had to be careful while navigating the sharp <w>decline</w> of the mountain road.",
                            "target_lang_translations": {
                                "ru": "Велосипедистам приходилось быть осторожными, преодолевая резкий <w>склон</w> горной дороги."
                            }
                        }
                    ],
                    "antonyms": [
                        "incline"
                    ],
                    "common_phrases": [
                        "steep decline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наклон вниз, например, холма или дороги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спуск",
                                "target_lang_sense_clarification": "наклонная поверхность"
                            },
                            {
                                "target_lang_word": "склон",
                                "target_lang_sense_clarification": "гора или холм"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
