                ],
                "senses": [
                    {
                        "sense_id": "528bc32f-616c-3711-9d8e-9ef003bd9b8b",
                        "entry_id": "afdb24e8-9620-35b3-96a2-eae4789dcf52",
                        "glosses": [
                            "A bold outlaw, especially one from southern portions of the Wild West."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a0964a6-7c76-462e-9434-c00b2c0a2c78",
                                "sense_id": "528bc32f-616c-3711-9d8e-9ef003bd9b8b",
                                "text": "The kind of persons who excite or give signal to such revolutions — students, young men of letters […], or fierce and justly bankrupt desperadoes, acting everywhere on the discontent of the millions and blowing it into flame, — might give rise to reflections as to the character of our epoch."
                            },
                            {
                                "example_id": "3e94a772-08b3-488d-a8f7-7d7e2eec50a6",
                                "sense_id": "528bc32f-616c-3711-9d8e-9ef003bd9b8b",
                                "text": "Surely this was the face of a desperado."
                            }
                        ]
                    },
                    {
                        "sense_id": "26b95109-6f81-3f83-8793-da6f22154316",
                        "entry_id": "afdb24e8-9620-35b3-96a2-eae4789dcf52",
                        "glosses": [
                            "A person in desperate circumstances or who is at the point of desperation, such as a down-and-outer, an addict, etc."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b24aba8e-0d35-419e-bf41-537c0c42d984",
                                "sense_id": "26b95109-6f81-3f83-8793-da6f22154316",
                                "text": "The shortstops and desperados were not permitted to play in this marker crap game."
                            }
                        ]
                    },
                    {
                        "sense_id": "491064e5-2379-36f8-bd37-2d23ddf2280b",
                        "entry_id": "afdb24e8-9620-35b3-96a2-eae4789dcf52",
                        "glosses": [
                            "A person who is desperately in love or is desperate for a romantic or sexual relationship."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1c557ab7-14a0-3c8e-8eda-2b2b8829b0cf",
                        "entry_id": "afdb24e8-9620-35b3-96a2-eae4789dcf52",
                        "glosses": [
                            "A piece that seems determined to give itself up, typically to bring about stalemate or perpetual check."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2ba2261-0f7b-41de-bfe5-1a10d96b5f50",
                        "source_entry_id": "afdb24e8-9620-35b3-96a2-eae4789dcf52",
                        "source_sense_description": "bold outlaw",
                        "target_lang_word": "desperado",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desperado",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d166cdd-b8c3-3467-8682-bf4e0daaa930",
                                        "entry_id": "4b03dd77-226c-3253-9795-91b8302ed864",
                                        "glosses": [
                                            "Personne qu’une situation sans issue pousse à des actes désespérés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58baec90-8b96-4af9-af57-4c180fc7e5f5",
                                                "sense_id": "1d166cdd-b8c3-3467-8682-bf4e0daaa930",
                                                "text": "Me voyant seul, ils avaient naturellement conclu que j’avais mangé les autres, et me prenaient pour un desperado armé, tout près à me défendre."
                                            },
                                            {
                                                "example_id": "dbd3771b-8412-4a4a-b0b9-1921fa370ba2",
                                                "sense_id": "1d166cdd-b8c3-3467-8682-bf4e0daaa930",
                                                "text": "À l’époque tumultueuse des pionniers, bien des hors-la-loi, renégats, desperados et voleurs de grands chemins ont laissé leur nom couleur de sang dans les annales de l’ouest…"
                                            },
                                            {
                                                "example_id": "f9358d7b-cc33-4ff9-81a3-36355a97a08e",
                                                "sense_id": "1d166cdd-b8c3-3467-8682-bf4e0daaa930",
                                                "text": "Ainsi, en pleine crise sanitaire, alors que les perspectives économiques sont catastrophiques, certains ont encore le goût du risque chevillé au corps. Ces desperados de la Bourse sont des tradeurs particuliers à la recherche de sensations fortes et de gains exceptionnels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3437251-a812-4fd3-b13d-9146aa8923ef",
                        "source_entry_id": "afdb24e8-9620-35b3-96a2-eae4789dcf52",
                        "source_sense_description": "bold outlaw",
                        "target_lang_word": "desperado",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desperado",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "122552ea-425d-3df8-9062-85ff45e28d60",
                                        "entry_id": "c787f3e8-a8c4-3a62-b209-74bf62696ab7",
                                        "glosses": [
                                            "Forajido sin escrúpulos."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ae1414a-76fe-45bc-81b8-572c3c8ecdc4",
                                                "sense_id": "122552ea-425d-3df8-9062-85ff45e28d60",
                                                "text": "La película arranca con la violenta huida de la cárcel y un fallido y sangriento asalto a un banco que lanza por las polvorientas carreteras del sur de Texas a dos 'desperados' armados y de negro, los hermanos Seth y Richie Gecko (Clooney y Tarantino), que en los primeros 15 minutos destrozan una gasolinera y dejan 19 civiles muertos."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "desperado",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "cfd04deb-bd11-384e-a81e-ddcdbfe2dc6a",
                                        "entry_id": "89a025a5-b2f3-35a3-85c0-70484358f219",
                                        "glosses": [
                                            "Participio de desperar."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fccb0e7-7ceb-4227-9de6-72ca6014bdf8",
                                                "sense_id": "cfd04deb-bd11-384e-a81e-ddcdbfe2dc6a",
                                                "text": "Quando ovo Servante la oración complida,\ncerca era de gallos, media noche trocida;\nadurmióse un poco, cansado sin medida,\nera ya desperado de salud e de vida."
                                            },
                                            {
                                                "example_id": "f815d2cc-1819-4ee0-92a7-9cd67dbd9584",
                                                "sense_id": "cfd04deb-bd11-384e-a81e-ddcdbfe2dc6a",
                                                "text": "Sabed que mi padre me casó con un viejo como vuestro marido, calvo, flojo como un niño, y no me dio a un joven que me demandaba siendo doncella, el cual se fue desperado, que yo voy por el mundo a buscallo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
