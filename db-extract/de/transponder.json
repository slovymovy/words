                "senses": [
                    {
                        "sense_id": "2f2cecb5-0def-364a-9590-fb38bb9e8b06",
                        "entry_id": "04525c0e-f157-380c-8707-328c29a453f7",
                        "glosses": [
                            "elektronisches Gerät, das Funksignale empfangen und automatisch beantworten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f001d8d1-5c94-4ab5-8934-9fb8066c075b",
                                "sense_id": "2f2cecb5-0def-364a-9590-fb38bb9e8b06",
                                "text": "„Das ist jenes Band, auf dem die Transponder ziviler Flugzeuge mit der Flugsicherung Kontakt halten.“"
                            },
                            {
                                "example_id": "ce98ef3c-e623-4338-a1e1-4f05369fa8ef",
                                "sense_id": "2f2cecb5-0def-364a-9590-fb38bb9e8b06",
                                "text": "„Nato-Generalsekretär Jens Stoltenberg hatte Moskau mehrfach scharf kritisiert, weil russische Kampfflugzeuge ohne eingeschaltete Transponder an den Nato-Grenzen flögen und damit den zivilen Luftverkehr gefährdeten.“"
                            },
                            {
                                "example_id": "bc4f7a29-67bd-46ed-9d7c-4808951d5c12",
                                "sense_id": "2f2cecb5-0def-364a-9590-fb38bb9e8b06",
                                "text": "„Chigurh fing das Signal des Transponders auf, als er über die hochgelegene Fahrbahn der Devil's River Bridge knapp westlich von Del Rio kam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
