                "senses": [
                    {
                        "sense_id": "32f5ac1e-c147-3732-a067-bd2d8b22492c",
                        "entry_id": "f37d460d-b18d-3026-ad54-ebd1cfae0cf6",
                        "glosses": [
                            "das bedrängende Nachstellen nach Flüchtlingen die einen Staat verlassen oder in einen Staat fliehen möchten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f362b008-748d-499e-ab2d-ea8346188652",
                                "sense_id": "32f5ac1e-c147-3732-a067-bd2d8b22492c",
                                "text": "„Das Wegschaffen der Juden hat ihnen das Gefühl gegeben, daß sie nun alle unsicher sind, und sie reagieren sehr scharf. Geschürt wurden die alarmierenden Berichte über die Flüchtlingsjagd allerdings vom Dänischen Pressedienst in Stockholm. Selbst am Morgen dieses 8. Oktober verbreitete er noch, daß die Deutschen den dänischen Juden mit allen zur Verfügung stehenden Mitteln nachsetzten.“"
                            },
                            {
                                "example_id": "36d7f5c2-5350-47fb-80be-a4ab673f77c0",
                                "sense_id": "32f5ac1e-c147-3732-a067-bd2d8b22492c",
                                "text": "„Hunde für die Flüchtlingsjagd setzt die ostzonale Grenzpolizei an der Berliner Mauer ein.“"
                            },
                            {
                                "example_id": "3ca0067c-bc7f-43f0-8374-2e736add2ae9",
                                "sense_id": "32f5ac1e-c147-3732-a067-bd2d8b22492c",
                                "text": "„Auf Flüchtlingsjagd: Die Grenze zwischen Mexiko und den USA ist wohl eine der am besten bewachten. Doch den Bewohnern auf der amerikanischen Seite ist das nicht gut genug: Eine Grenzmiliz der Bewohner macht sich selbst auf die Suche nach illegalen Flüchtlingen.“"
                            },
                            {
                                "example_id": "5966a988-9e5f-4c0d-9b8a-40a0ef0287d8",
                                "sense_id": "32f5ac1e-c147-3732-a067-bd2d8b22492c",
                                "text": "„Wer heutzutage vom Prager Hauptbahnhof verreisen will, fällt vor allem eines auf: selbst die Anzahl der Rucksacktouristen, die hier jeden Sommer her strömen, verblasst vor der momentanen Polizeipräsenz. Tschechien ist auf Flüchtlingsjagd. Knapp 1.000 illegale Migranten hat die Polizei in Prag, um Brünn und auf den Transitstrecken nach Deutschland und Österreich gefasst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
