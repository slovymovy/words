                "senses": [
                    {
                        "sense_id": "6022f6ec-3b27-36b1-a948-ec68c711fb5c",
                        "entry_id": "e7acb311-3111-30b0-bbc9-46ac62495c94",
                        "glosses": [
                            "festgelegte Abfolge von Bewegungen und Techniken, die einen stilisierten Kampf gegen einen oder mehrere imaginäre Gegner darstellt"
                        ],
                        "tags": [
                            "Kampfkunst",
                            "speziell Budo"
                        ],
                        "examples": [
                            {
                                "example_id": "1be1629f-c341-46a2-8dc2-c0c01d29018c",
                                "sense_id": "6022f6ec-3b27-36b1-a948-ec68c711fb5c",
                                "text": "„In der Kata drückt sich zudem die Besonderheit eines Karatestils aus. Die in diesem Buch enthaltenen Katas gehören zum Fundament des Shotokan Karate.“"
                            },
                            {
                                "example_id": "589670b5-5557-40c5-9a42-c258cf54ae2b",
                                "sense_id": "6022f6ec-3b27-36b1-a948-ec68c711fb5c",
                                "text": "„Man studierte eine Kata mindestens drei Jahre lang, bevor man sich der nächsten zuwandte.“"
                            },
                            {
                                "example_id": "e4481318-3051-4c49-8f9f-8d5ba8d22ff9",
                                "sense_id": "6022f6ec-3b27-36b1-a948-ec68c711fb5c",
                                "text": "„Sie können auch gleich Katas oder Formen aus dem Karate erlernen, um Spannungen abzubauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93722a63-278c-40f6-bf26-8ee90191ddf0",
                        "source_entry_id": "e7acb311-3111-30b0-bbc9-46ac62495c94",
                        "source_sense_id": "6022f6ec-3b27-36b1-a948-ec68c711fb5c",
                        "target_lang_word": "kata",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kata",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc32000b-79d6-319b-a631-d90e31656ee6",
                                        "entry_id": "0a349524-54c5-364d-ac0d-9265f46d8c0f",
                                        "glosses": [
                                            "Any of a sequence of positions and movements used in many martial arts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89e22813-f2bc-4bf2-b02f-79e9ca5c2398",
                                                "sense_id": "bc32000b-79d6-319b-a631-d90e31656ee6",
                                                "text": "judo kata"
                                            },
                                            {
                                                "example_id": "69185625-5254-4a4f-980f-31e171b31134",
                                                "sense_id": "bc32000b-79d6-319b-a631-d90e31656ee6",
                                                "text": "About fifty kata, or \"formal exercises,\" are practiced at the present time, some having been passed down from generation to generation, others having been developed fairly recently."
                                            },
                                            {
                                                "example_id": "7d019275-4f39-4e53-9d6d-cccd06cc5587",
                                                "sense_id": "bc32000b-79d6-319b-a631-d90e31656ee6",
                                                "text": "Katas are a series of motions, such as punches, strikes, and kicks, arranged in a specific pattern. The pattern allows the motions to flow into one another. A student must learn a new kata to advance to each new belt level."
                                            },
                                            {
                                                "example_id": "1b2ae568-c9de-42d9-94c7-7ad9c65b63a8",
                                                "sense_id": "bc32000b-79d6-319b-a631-d90e31656ee6",
                                                "text": "When the competitor's name is called, she stands on the designated line, bows to the panel of judges, and announces the name of the kata she will perform.[…]She then performs the kata. When she is finished, her opponent performs her kata. At the end of the second kata, both return to the mat area to await the decision of the judging panel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc3bac36-f329-3a61-9312-287fc2db729d",
                                        "entry_id": "0a349524-54c5-364d-ac0d-9265f46d8c0f",
                                        "glosses": [
                                            "A short programming exercise to improve one's skills through practice and repetition."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e30bfd8-e905-42a5-9ba1-9316eb01618c",
                                                "sense_id": "cc3bac36-f329-3a61-9312-287fc2db729d",
                                                "text": "These kata will give you the C# syntax for inheritance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kata",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f67ab0b-be9b-3540-8c37-7b6c7039a583",
                                        "entry_id": "835698d8-90ef-3cf0-8842-551bf57d64dc",
                                        "glosses": [
                                            "Ellipsis of kata thermometer."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a64d22fe-6c3d-35cc-b41d-cf792d7f1a14",
                                        "entry_id": "835698d8-90ef-3cf0-8842-551bf57d64dc",
                                        "glosses": [
                                            "A drop (in temperature)."
                                        ],
