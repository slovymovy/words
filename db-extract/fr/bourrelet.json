                        "form": "bourrelets"
                    },
                    {
                        "form_id": "a5646a9e-8434-4f6d-8884-1da8a6527184",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "tags": [],
                        "form": "bourlet"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "616f1874-d0d7-353d-9481-68aea1e8a4ac",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "glosses": [
                            "Coiffure en forme de couronne et remplie de bourre, permettant de porter une charge sur la tête."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5fa52709-b68d-31fa-994a-f40e8c1a7431",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "glosses": [
                            "Coussin rempli de bourre ou de crin, fait en rond et vide par le milieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87015713-724b-4561-a338-e1b298424bda",
                                "sense_id": "5fa52709-b68d-31fa-994a-f40e8c1a7431",
                                "text": "Bourrelet de cuir."
                            },
                            {
                                "example_id": "bfbb751c-03d9-49a8-84f6-2c4914b1fab0",
                                "sense_id": "5fa52709-b68d-31fa-994a-f40e8c1a7431",
                                "text": "Bourrelet à bassin."
                            },
                            {
                                "example_id": "dcecb7cb-841c-42ff-bec6-28816bd1690e",
                                "sense_id": "5fa52709-b68d-31fa-994a-f40e8c1a7431",
                                "text": "Bourrelet d’enfant, espèce de bandeau rembourré dont on entoure quelquefois la tête des enfants pour empêcher qu’ils ne se blessent quand ils tombent."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a3f9154-2118-3b1c-87bd-8dc9c7660660",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "glosses": [
                            "Rond d’étoffe qui est au haut du chaperon que les docteurs, les licenciés et certains magistrats portent sur l’épaule."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cbc51051-97b9-3ba6-baec-8b14c8b4c691",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "glosses": [
                            "Sorte de gaine étroite et longue, faite de toile et remplie de bourre ou de crin, qu’on adapte aux bords des portes et des fenêtres qui joignent mal, pour empêcher l’air froid et humide de pénétrer dans les appartements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca10f65e-9487-4f20-b212-67df16a14206",
                                "sense_id": "cbc51051-97b9-3ba6-baec-8b14c8b4c691",
                                "text": "Bientôt la courte chaleur qui broussaillait dans la cheminée ne se fit plus sentir et Ruys retrouva le froid de l’extérieur qui passait sous la porte dont il avait négligé de replacer le bourrelet de protection."
                            },
                            {
                                "example_id": "36299ce6-8783-4db8-90cb-697d8d415ef3",
                                "sense_id": "cbc51051-97b9-3ba6-baec-8b14c8b4c691",
                                "text": "De sa main valide il sort l’ours en peluche qu’il installe sur le prie-Dieu, le renard empaillé, la poêle, la bassine en émail écaillée, le paquet de bourrelets pour portes, assemblés sous le plastique transparent en un amas de serpents morts gris-blanc sale, le cadre de chaise longue que tient peine une toile bayadère fendue."
                            }
                        ]
                    },
                    {
                        "sense_id": "31703855-7e68-3621-a183-7098f845a7aa",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "glosses": [
                            "Renflement circulaire qui se forme quelquefois à la tige ou aux rameaux d’un végétal ligneux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f95bc40f-146e-47f9-b13b-d5f74a99ac55",
                                "sense_id": "31703855-7e68-3621-a183-7098f845a7aa",
                                "text": "Il se développe un bourrelet à l’endroit de la greffe."
                            }
                        ]
                    },
                    {
                        "sense_id": "67f42882-8cfb-3ceb-8061-d6e7a02150af",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "glosses": [
                            "Renflement circulaire d’une pièce métallique quand on en a roulé une extrémité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9186c8e3-6ff4-4182-976c-dd80de457fd8",
                                "sense_id": "67f42882-8cfb-3ceb-8061-d6e7a02150af",
                                "text": "Le 8 × 27 mm est une cartouche à bourrelet utilisé par le revolver Mle 1892 8 mm."
                            }
                        ]
                    },
                    {
                        "sense_id": "9be91574-0ef7-3203-80d6-c9186fb23b61",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "glosses": [
                            "Garniture de protection contre les chocs en forme de boudin disposée devant ou autour d’une embarcation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1365b3b0-3d02-4a0c-bb84-dbe31ce6ec35",
                                "sense_id": "9be91574-0ef7-3203-80d6-c9186fb23b61",
                                "text": "Bourrelet de défense."
                            }
                        ]
                    },
                    {
                        "sense_id": "af993543-4da6-3afa-a81e-9de38c4d7b26",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "glosses": [
                            "Boudin ou joue de la partie intérieure d’une roue, qui assure le guidage sur la voie ferrée."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "07fda828-96e0-342b-a6c1-ebd86eacc841",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "glosses": [
                            "Épaisseur ; renflement."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "7dfd4cb7-0e8b-41a6-957a-85e382c9a084",
                                "sense_id": "07fda828-96e0-342b-a6c1-ebd86eacc841",
                                "text": "[…] et il replia ensuite jusqu’au haut des cuisses, en quintuple bourrelet, son pantalon."
                            },
                            {
                                "example_id": "d78b04e0-d9f2-42aa-9da4-a5e486d3cb62",
                                "sense_id": "07fda828-96e0-342b-a6c1-ebd86eacc841",
                                "text": "La planche, debout contre le pilier, était fixée par le bas à une sorte de bourrelet en fer qui faisait le tour du pilier. Ce bourrelet pouvait former une saillie d'environ vingt centimètres, et pour le moment semblait être le soubassement du pilier."
                            },
                            {
                                "example_id": "343ae5c0-f05f-46b4-a213-2e3857d79593",
                                "sense_id": "07fda828-96e0-342b-a6c1-ebd86eacc841",
                                "text": "Ce bourrelet s'étend, sans discontinuité, de l'Ouest, qui est à notre gauche, à l'Est qui est à notre droite, en passant derrière Doulaize, village qui est en face de nous."
                            }
                        ]
                    },
                    {
                        "sense_id": "d68f9264-6beb-3c2d-b9cb-0176ab187644",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "glosses": [
                            "Anneau fibro-cartilagineux disposé sur le pourtour de cavités articulaires pour en faciliter les mouvements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd1e711f-5ef1-4164-9bc0-545178a5e1ab",
                                "sense_id": "d68f9264-6beb-3c2d-b9cb-0176ab187644",
                                "text": "Bourrelet glénoïdien de l’articulation de l’épaule, bourrelet cotyloïdien de l’articulation de la hanche..."
                            }
                        ]
                    },
                    {
                        "sense_id": "695a5581-47fa-33e4-8118-3e9d60c692fe",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "glosses": [
                            "Masse de chair (bourrelet de chair) formant une épaisseur entre deux plis chez les personnes obèses."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "68aeb4ef-da78-3ff6-9d3f-39555d06644c",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "glosses": [
                            "Enflure qui survient au niveau des reins chez une personne hydropique."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1922c6da-b03a-3605-9285-1cd5249ad16b",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "glosses": [
                            "Épaisseur, renflement formé par le tissu adipeux, d'un corps humain ; poignée d’amour"
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "2cf79981-11cb-4516-a061-3de3e73916cc",
                                "sense_id": "1922c6da-b03a-3605-9285-1cd5249ad16b",
                                "text": "C’était un gros homme, court et tassé, très étrange. Il avait un ventre énorme, qui croulait en bourrelets flasques sur des cuisses presque maigres."
                            },
                            {
                                "example_id": "7e13cd64-6064-4026-84b8-b62cf5f4dc2e",
                                "sense_id": "1922c6da-b03a-3605-9285-1cd5249ad16b",
                                "text": "Elle était hideuse ainsi. On voyait derrière ses lèvres relevées, débarrassées de rouge, décolorées et molles, ses dents malpropres ; un bourrelet de graisse saillait sous le menton."
                            },
                            {
                                "example_id": "a632bef2-a7ad-47c6-ac20-353826af6a4c",
                                "sense_id": "1922c6da-b03a-3605-9285-1cd5249ad16b",
                                "text": "Le charme de Pomme c’est qu’elle était autre, sauf l’érotisme stéréotypé du petit bourrelet entre la jupe et le pull."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb0cb7b5-5d32-31b0-bbf8-28ccd09e3eb2",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "glosses": [
                            "Épaisseur, renflement d'une partie du corps d'un animal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b11149f-82ce-4a01-84ae-51e13001076f",
                                "sense_id": "fb0cb7b5-5d32-31b0-bbf8-28ccd09e3eb2",
                                "text": "La partie antérieure de la mâchoire supérieure des ruminants est dépourvue de dents; un bourrelet dur les remplace. Lorsqu’ils pâturent, ils mordent les plantes entre ce bourrelet et les dents de la mâchoire inférieure."
                            }
                        ]
                    },
                    {
                        "sense_id": "57d5b8ed-89f8-3425-ad68-357e57f20dfa",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "glosses": [
                            "Gonflement de la jambe à la partie supérieure du sabot d'un ongulé : le bourrelet périoplique."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "69b57dcc-3ec1-38d5-bcba-1cc34bba05de",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "glosses": [
                            "Renflement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "519da26a-f401-40da-8884-989ff506a1da",
                                "sense_id": "69b57dcc-3ec1-38d5-bcba-1cc34bba05de",
                                "text": "Les pauvres morts d’à côté, sous leurs petits bourrelets de terre, en étaient attristés dans les nuits."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0d66017-ec5f-3405-8989-b950b111dde0",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "glosses": [
                            "Meuble représentant le bourrelet du même nom dans les armoiries. Habituellement utilisé comme ornement extérieur (voir torque), il est parfois utilisé comme figure de l’écu."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7d5a42ef-7f7c-49ac-9bac-9c3515a7720c",
                                "sense_id": "c0d66017-ec5f-3405-8989-b950b111dde0",
                                "text": "De gueules au lion d’or, armé et lampassé d’azur et denté d’argent, issant d’un bourrelet du second et du premier, qui est de la commune de Langenhagen de Basse-Saxe en Allemagne → voir illustration « armoiries avec un bourrelet »"
                            }
                        ]
                    },
                    {
                        "sense_id": "4db0b2ce-1cd7-3b49-92ff-5fa0879e11df",
                        "entry_id": "048483f0-eadd-3fba-b47c-e08b295fde9d",
                        "glosses": [
                            "Sur un filet de pêche, partie destinée à maintenir le filet en contact avec le fond de la mer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec37fd6d-bcc5-4329-88ab-e4549b78d9bf",
                                "sense_id": "4db0b2ce-1cd7-3b49-92ff-5fa0879e11df",
                                "text": "Un exemple avec le bourrelet, qui permet de maintenir le filet en contact avec le fond : l’abrasion est certes assez superficielle, mais plus profonde (5 cm) sur les fonds sableux, et plus encore sur les fonds vaseux."
                            },
                            {
                                "example_id": "d4862de4-bb83-433c-ab90-cff2cb6c69bd",
                                "sense_id": "4db0b2ce-1cd7-3b49-92ff-5fa0879e11df",
                                "text": "Un bourrelet fixé sur la partie avant de la nappe inférieure maintient le chalut en contact avec le fond."
                            }
                        ]
                    }
                ],
