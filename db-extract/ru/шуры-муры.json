                        "form": "шу́ры-му́ры"
                    },
                    {
                        "form_id": "8962a551-2357-408e-8f80-bdba33c9c2d7",
                        "entry_id": "b5948c17-9835-3d00-b72d-79ee8259d757",
                        "tags": [
