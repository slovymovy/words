                                    },
                                    {
                                        "sense_id": "34eefeaa-9e06-3cf1-8842-fc6218097459",
                                        "entry_id": "56a6e257-30ea-39ea-91e5-8b2004e983c9",
                                        "glosses": [
                                            "Clothing to be worn in the morning or daytime, as opposed to the evening; now (specifically), a man's formal suit consisting of a (usually) dark grey morning coat, waistcoat and striped trousers accompanied with a top hat, white shirt and tie or cravat."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "670bec61-37f9-472d-8529-292f9bcb195c",
                                                "sense_id": "34eefeaa-9e06-3cf1-8842-fc6218097459",
                                                "text": "Morning dress can be worn up to 5:00 pm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df49e3da-8cdc-468d-9471-c96ffa51b7ad",
                        "source_entry_id": "af018ee5-d813-3e13-8dde-c25799c6ac59",
                        "target_lang_word": "morning coat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morning coat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91a4bbc7-ee5a-338b-b769-bacee25f2575",
                                        "entry_id": "ef3659f7-d36e-32e8-bee0-2b920b4d25f3",
                                        "glosses": [
                                            "A man's formal coat worn as the principal item in morning dress, it also used for royal ascot and weddings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1153d7ae-9d47-4a32-9b66-cd0131dd8ee4",
                                                "sense_id": "91a4bbc7-ee5a-338b-b769-bacee25f2575",
                                                "text": "Behind him a group of men in starched high collars and black morning-coats and striped trousers stood about in attitudes of stern pensiveness, frowning at their fingernails, or gazing fixedly out of the window."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f0f94e1-d94b-405f-ba12-e80ca74a6d60",
                        "source_entry_id": "af018ee5-d813-3e13-8dde-c25799c6ac59",
                        "target_lang_word": "jaquette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jaquette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "688a3382-cf90-3e9a-9bdc-195c408a9055",
                                        "entry_id": "cd1ee34d-323a-33c1-8686-ae73802d4212",
                                        "glosses": [
                                            "Robe que portaient les petits garçons."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2bbfdc65-32d6-3dde-87c3-075fb453943f",
                                        "entry_id": "cd1ee34d-323a-33c1-8686-ae73802d4212",
                                        "glosses": [
                                            "Sorte d’habillement d’homme, serré à la taille, fendu dans le bas du dos, et qui descend généralement jusqu’aux genoux. Vêtement de jour, il est porté dans les mariages et les grandes courses hippiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36a3cfbb-8f9c-44a0-8f21-8daa2a9754bb",
                                                "sense_id": "2bbfdc65-32d6-3dde-87c3-075fb453943f",
                                                "text": "Il ne portait sur lui qu'une fine jaquette et, comme un croc de lumière, attendait dans l'ombre qu'un de ces garçonnets, dont toute volupté passait par la candeur et qu'on voyait errer à la morsure du soir, vint se perdre à sa portée ; là, le Marquis l'empoignait et beaucoup disparurent ainsi. — (Anonyme, Une autre histoire, 1703)"
                                            },
                                            {
                                                "example_id": "867cf78d-5e31-4966-83d9-017724cd2b60",
                                                "sense_id": "2bbfdc65-32d6-3dde-87c3-075fb453943f",
                                                "text": "Son costume se composait d’une tunique verte, […] ; cette jaquette pendait sans être boutonnée par-dessus un pourpoint collant et de couleur écarlate, serrant le corps."
                                            },
                                            {
                                                "example_id": "6fab0bec-6214-4021-a52e-98021dba8bf9",
                                                "sense_id": "2bbfdc65-32d6-3dde-87c3-075fb453943f",
                                                "text": "Il avait une cravache à la main, des houseaux aux jambes ; une jaquette courte faisait saillir son torse vigoureux."
                                            },
                                            {
                                                "example_id": "1b85b83d-9b31-45ac-b6ac-35433860a1ae",
                                                "sense_id": "2bbfdc65-32d6-3dde-87c3-075fb453943f",
                                                "text": "Il avait mis, dans sa désolation, des bottines vernies, le gilet de velours, et il hésitait maintenant à s’asseoir sur le coussin, ne sachant s’il devait user de préférence le fond de son pantalon ou les basques de sa jaquette."
                                            },
                                            {
                                                "example_id": "821f0f7f-e3ef-4035-831c-3c2cb6482661",
                                                "sense_id": "2bbfdc65-32d6-3dde-87c3-075fb453943f",
                                                "text": "Chaque matin, elle lui aidait encore à passer sa jaquette et à nouer sa cravate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18a580f1-19ec-3d36-a065-4208ef0ac7b1",
                                        "entry_id": "cd1ee34d-323a-33c1-8686-ae73802d4212",
                                        "glosses": [
                                            "Veste de femme ajustée à la taille."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78b77a49-c129-4b82-b46c-12793a87dd13",
                                                "sense_id": "18a580f1-19ec-3d36-a065-4208ef0ac7b1",
                                                "text": "Elle a achevé de s’habiller. Elle a mis une jaquette de la couleur de sa jupe, laissant voir largement son corsage de lingerie dont le haut est transparent et rosé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "177f385a-7e0c-3d3b-a038-84361a184394",
                                        "entry_id": "cd1ee34d-323a-33c1-8686-ae73802d4212",
                                        "glosses": [
                                            "Jaque rembourrée portée sous la cotte de mailles ; gambison. ^([2])"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d5d2dfe-4a38-423d-910a-2609d6fa8a00",
                                                "sense_id": "177f385a-7e0c-3d3b-a038-84361a184394",
                                                "text": "Cent-vingt archers de guet […] portant la jaquette à longs plis"
                                            },
                                            {
                                                "example_id": "4670f967-dc78-4606-8344-05d03306e423",
                                                "sense_id": "177f385a-7e0c-3d3b-a038-84361a184394",
                                                "text": "Le duc alors revêtit sa jaquette, qui était en chaînons de mailles si souples que la trame d’acier n’était guère plus épaisse que du velours : puis il passa par-dessus son jacques des chausses et un pourpoint gris et argent, qui étaient ses couleurs favorites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e99a59bf-eb5d-3ceb-9b6f-644310a7df92",
                                        "entry_id": "cd1ee34d-323a-33c1-8686-ae73802d4212",
                                        "glosses": [
                                            "Couverture protégeant un livre relié ou broché ^([2]), un CD, DVD ou blu-ray. Note : Elle ne doit pas être confondue avec la couverture rempliée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32a73d05-e847-4a79-89c7-40053300e694",
                                                "sense_id": "e99a59bf-eb5d-3ceb-9b6f-644310a7df92",
                                                "text": "Non seulement le livre d’art envahit la montre avec sa « jaquette » illustrée, mais les autres publications prennent exemple sur lui."
                                            },
                                            {
                                                "example_id": "80ac142c-25fa-4262-a867-8a797c313819",
                                                "sense_id": "e99a59bf-eb5d-3ceb-9b6f-644310a7df92",
                                                "text": "Sur cette jaquette, on voit une fille attachée à un arbre, et un garçon doit la sauver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "095e9b03-4ebd-3223-b8b2-bbca6aff76b3",
                                        "entry_id": "cd1ee34d-323a-33c1-8686-ae73802d4212",
                                        "glosses": [
                                            "Homosexualité masculine ^([2])."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78106ca4-522a-4b31-8866-1ac006e4139a",
                                                "sense_id": "095e9b03-4ebd-3223-b8b2-bbca6aff76b3",
                                                "text": "Êtes-vous un homo ? Êtes-vous une pédale, une tapette, une folle, une chochotte, un empaffé, un de la jaquette, une tantouse ?"
                                            },
                                            {
                                                "example_id": "9f35adeb-e8b1-4a13-a97f-94f896480f48",
                                                "sense_id": "095e9b03-4ebd-3223-b8b2-bbca6aff76b3",
                                                "text": "Henri III […] était de la jaquette flottante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db12a6fc-7a5c-3869-821b-52a82d2697c7",
                                        "entry_id": "cd1ee34d-323a-33c1-8686-ae73802d4212",
                                        "glosses": [
                                            "Chemise de nuit."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d6c409c-0467-4134-ade0-f8b88f9f3520",
                                                "sense_id": "db12a6fc-7a5c-3869-821b-52a82d2697c7",
                                                "text": "C’est l’heure de mettre votre jaquette et d’aller vous coucher."
                                            },
