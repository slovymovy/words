                                "target_senses": [
                                    {
                                        "sense_id": "8af07d4d-7d4c-364d-8d0a-be39a1167c6e",
                                        "entry_id": "cf35bd79-c5ad-3d6d-b541-5862cb796bff",
                                        "glosses": [
                                            "het commercieel exploiteren van de populariteit van een merk of van bekende personen, zoals filmsterren, entertainers en sporthelden, evenals van figuren uit films, stripverhalen, games en televisieprogramma's"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af1cf8af-1fe9-467a-83e0-8afd656b99ea",
                                                "sense_id": "8af07d4d-7d4c-364d-8d0a-be39a1167c6e",
                                                "text": "De tournee door Australië in 2008 was op zich verlieslijdend: de opbouw van het podium alleen al was peperduur doordat er 500 werknemers voor nodig waren. Dit verlies werd echter meer dan gecompenseerd door de latere verkoop van dvd’s, cd’s en merchandising."
                                            },
                                            {
                                                "example_id": "f596f667-34a2-44f3-a09d-7b4c1e37f181",
                                                "sense_id": "8af07d4d-7d4c-364d-8d0a-be39a1167c6e",
                                                "text": "Die middag zijn er verder optredens van Anhangerschapband, The Marshalls en De Kisjeskearls. Ook is er een marktje met Normaal-merchandising en worden er boeken verkocht."
                                            },
                                            {
                                                "example_id": "2a3c96f4-ae61-4772-b88a-553d2900fe86",
                                                "sense_id": "8af07d4d-7d4c-364d-8d0a-be39a1167c6e",
                                                "text": "Opmerkelijk is verder dat van de omzet 'slechts' 612 miljoen afkomstig is van auto's en onderdelen. Ruim 125 miljoen is geboekt onder het kopje ‘sponsorship, commercial and brand'. Lees: merchandising, oftewel petjes, miniatuurauto's en kleding."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
