                    {
                        "sense_id": "7b9ccd48-a51d-3c3e-9a0b-d3182c9646a8",
                        "entry_id": "984ff5e2-bf7a-3ec1-84f3-99b3e5a3f6bc",
                        "glosses": [
                            "The condition of being equipollent; equality of power, force, signification, or application."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "00b91602-f26f-4814-838f-f726ddcb81f7",
                                "sense_id": "7b9ccd48-a51d-3c3e-9a0b-d3182c9646a8",
                                "text": "Thus it was that I beheld, as never before, the awful unreality called evil. The equipollence of God brought to light another glorious proposition, — man’s perfectibility and the establishment of the kingdom of heaven on earth."
                            }
                        ]
                    },
                    {
                        "sense_id": "401ed50b-6163-34ea-a536-92e608577083",
                        "entry_id": "984ff5e2-bf7a-3ec1-84f3-99b3e5a3f6bc",
                        "glosses": [
                            "Sameness of signification of two or more propositions which differ in language."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
