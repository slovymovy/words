                                        "entry_id": "2a1e372f-7b5a-39d2-b1e2-f5a4344f0bf4",
                                        "glosses": [
                                            "To break in (a horse, etc.), especially for military purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de12bfad-4c83-4442-aac1-0d4e4b1efb66",
                                                "sense_id": "b9c24c33-46b4-3d0a-b336-502d97a480e5",
                                                "text": "To Rough Horses, a word in familiar use among the dragoons to signify the act of breaking in horses, so as to adapt them to military purposes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b323c93-4bab-3b35-8bf9-550ef13d0a54",
                                        "entry_id": "2a1e372f-7b5a-39d2-b1e2-f5a4344f0bf4",
