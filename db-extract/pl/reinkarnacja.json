                                                "sense_id": "b5b69418-74f6-3f8f-a80a-f8f1d8914724",
                                                "text": "He is believed to be the reincarnation of Jesus."
                                            },
                                            {
                                                "example_id": "7bca8e11-2b44-46b0-8dc1-e6df78aafbb2",
                                                "sense_id": "b5b69418-74f6-3f8f-a80a-f8f1d8914724",
                                                "text": "Do you believe in reincarnation?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcad60ab-0ac2-36b2-8d19-9a6d89cac6ee",
                                        "entry_id": "9e7753c7-3fb4-303c-bba8-b2dafa322bd9",
                                        "glosses": [
                                            "A fresh embodiment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5400168-c597-477a-a7d2-242ea544e64c",
                                                "sense_id": "bcad60ab-0ac2-36b2-8d19-9a6d89cac6ee",
                                                "text": "Kibbutz life is a present-day reincarnation of pioneer days' morality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "787ee970-b2e3-36c3-b984-41a25677f6ed",
