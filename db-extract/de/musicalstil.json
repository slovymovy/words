                            {
                                "example_id": "33292fb9-cace-444f-8dea-7eca3bb57841",
                                "sense_id": "30b13768-8b61-3b0c-9dcb-0ac18a2b70f2",
                                "text": "„Wenn man von einer Singstimme spricht, muss man unterscheiden zwischen einer im Opern-, Operetten- oder Musicalstil ausgebildeten Stimme und dem Gesang etwa einer Schlagersängerin, die meist keine längere Ausbildung genossen hat.“"
                            },
                            {
                                "example_id": "7cd677b4-8b0b-4535-9e8b-25ae9b1725be",
                                "sense_id": "30b13768-8b61-3b0c-9dcb-0ac18a2b70f2",
                                "text": "„Every Sperm is Sacred aus dem Film The Meaning of Life der britischen Comedy-Truppe Monty Python ist zunächst im Musicalstil gehalten.“"
                            }
                        ],
