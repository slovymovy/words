                    "frequency": "Middle",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Forscher wollen tief in bisher völlig unerforschte Regionen des Regenwaldes <w>vorstoßen</w>."
                        },
                        {
                            "text": "Mit diesem wichtigen Sieg konnte die Mannschaft überraschend bis ins Halbfinale des Turniers <w>vorstoßen</w>."
                        }
                    ],
                    "synonyms": [
                        "vordringen",
                        "vorrücken"
                    ],
                    "antonyms": [
                        "zurückfallen"
                    ],
                    "common_phrases": [
