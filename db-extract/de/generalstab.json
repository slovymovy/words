                                "target_senses": [
                                    {
                                        "sense_id": "24067bf9-28ba-38e8-b2df-ba6adbfb5185",
                                        "entry_id": "d034835a-8116-35ce-b05e-7d3e0fde9798",
                                        "glosses": [
                                            "A group of officers in charge of an army under the control of the commander-in-chief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79aaa185-7f82-4a4b-9db7-f1ac2ab722a3",
                                                "sense_id": "24067bf9-28ba-38e8-b2df-ba6adbfb5185",
                                                "text": "Meronyms: staff officer, chief of staff"
                                            },
                                            {
                                                "example_id": "cac78ee1-555e-431b-8380-0e51bdcd7d51",
                                                "sense_id": "24067bf9-28ba-38e8-b2df-ba6adbfb5185",
                                                "text": "It was at most but a vague hint dropped by a certain notorious Parisienne in a jealous mood that had caused suspicion to rest upon the lieutenant. But general staffs are jealous of their secrets, and treason so serious a thing that even a hint of it may not be safely neglected."
                                            }
                                        ]
                                    }
                                ]
