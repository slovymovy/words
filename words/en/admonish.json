{
    "word_family": [
        "admonishment",
        "admonition",
        "admonitory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8bb2e48b-6dd1-3d45-b622-e77df35f11b5",
                    "sense_definition": "To firmly reprimand or express disapproval to someone for their behavior or faults.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "scold",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher had to gently <w>admonish</w> the students for talking loudly during the presentation.",
                            "target_lang_translations": {
                                "de": "Der Lehrer musste die Schüler sanft <w>ermahnen</w>, weil sie während der Präsentation laut redeten."
                            }
                        },
                        {
                            "text": "Her supervisor did not hesitate to publicly <w>admonish</w> her for arriving late again.",
                            "target_lang_translations": {
                                "de": "Ihr Vorgesetzter zögerte nicht, sie öffentlich dafür zu <w>rügen</w>, dass sie wieder zu spät kam."
                            }
                        }
                    ],
                    "synonyms": [
                        "reprimand",
                        "chide"
                    ],
                    "common_phrases": [
                        "gently admonish",
                        "sternly admonish"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden wegen seines Verhaltens oder Fehlverhaltens bestimmt tadeln oder zurechtweisen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ermahnen",
                                "target_lang_sense_clarification": "jemanden bestimmend zur Ordnung rufen"
                            },
                            {
                                "target_lang_word": "rügen",
                                "target_lang_sense_clarification": "offiziell oder nachdrücklich tadeln"
                            },
                            {
                                "target_lang_word": "abmahnen",
                                "target_lang_sense_clarification": "formell ein Fehlverhalten rügen"
                            },
                            {
                                "target_lang_word": "zurechtweisen",
                                "target_lang_sense_clarification": "jemandem sein Fehlverhalten vorhalten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fb14fae-244f-300d-b136-6d137468b91d",
                    "sense_definition": "To warn or give cautious advice to someone against potential danger or misconduct.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "warn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The park ranger would always <w>admonish</w> hikers against leaving the marked trails at night.",
                            "target_lang_translations": {
                                "de": "Der Parkranger <w>warnte</w> Wanderer stets davor, nachts die markierten Wege zu verlassen."
                            }
                        },
                        {
                            "text": "Doctors continue to <w>admonish</w> patients to avoid unnecessary exposure to the cold.",
                            "target_lang_translations": {
                                "de": "Ärzte <w>ermahnen</w> Patienten weiterhin dazu, sich nicht unnötig der Kälte auszusetzen."
                            }
                        }
                    ],
                    "synonyms": [
                        "caution",
                        "warn",
                        "advise",
                        "counsel"
                    ],
                    "common_phrases": [
                        "admonish against"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden vor einer drohenden Gefahr oder vor Fehlverhalten warnen oder ihm vorsorglich raten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "warnen",
                                "target_lang_sense_clarification": "auf eine Gefahr aufmerksam machen"
                            },
                            {
                                "target_lang_word": "ermahnen",
                                "target_lang_sense_clarification": "eindringlich zu Vorsicht oder richtigem Verhalten anhalten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b58e8dfe-6bf5-3911-ab34-8cc35be09dd1",
                    "sense_definition": "To earnestly urge, direct, or instruct someone to take a particular course of action.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "instruct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leader sought to <w>admonish</w> his followers to remain calm during the crisis.",
                            "target_lang_translations": {
                                "de": "Der Anführer versuchte, seine Anhänger dazu zu <w>ermahnen</w>, während der Krise ruhig zu bleiben."
                            }
                        },
                        {
                            "text": "Ancient texts often <w>admonish</w> readers to pursue wisdom and practice moderation.",
                            "target_lang_translations": {
                                "de": "Antike Texte <w>halten</w> Leser oft dazu <w>an</w>, nach Weisheit zu streben und Mäßigung zu üben."
                            }
                        }
                    ],
                    "synonyms": [
                        "exhort",
                        "urge"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden eindringlich dazu drängen oder anweisen, eine bestimmte Handlung vorzunehmen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ermahnen",
                                "target_lang_sense_clarification": "eindringlich zu etwas auffordern"
                            },
                            {
                                "target_lang_word": "beschwören",
                                "target_lang_sense_clarification": "inständig und nachdrücklich bitten"
                            },
                            {
                                "target_lang_word": "anhalten",
                                "target_lang_sense_clarification": "zu einer Handlungsweise bewegen oder auffordern"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}