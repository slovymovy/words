{
    "word_family": [
        "debutante"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6c8fc363-9253-3821-824f-c54112e37ce5",
                    "sense_definition": "A performer's first public appearance in sports, arts, or another professional field.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "first_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young athlete scored a goal during his <w>debut</w> for the national team.",
                            "target_lang_translations": {
                                "ru": "Молодой спортсмен забил гол во время своего <w>дебюта</w> в сборной.",
                                "tr": "Genç atlet, milli takımdaki <w>ilk maçında</w> bir gol attı."
                            }
                        },
                        {
                            "text": "She was very nervous before making her acting <w>debut</w> on the big stage.",
                            "target_lang_translations": {
                                "ru": "Она очень нервничала перед своим актерским <w>дебютом</w> на большой сцене.",
                                "tr": "Büyük sahnede oyunculuk <w>debütünü yapmadan</w> önce çok heyecanlıydı."
                            }
                        }
                    ],
                    "synonyms": [
                        "first appearance",
                        "premiere",
                        "introduction"
                    ],
                    "antonyms": [
                        "retirement",
                        "final appearance"
                    ],
                    "common_phrases": [
                        "make a debut",
                        "professional debut",
                        "acting debut",
                        "team debut"
                    ],
                    "target_lang_definitions": {
                        "ru": "Первое публичное выступление исполнителя в спорте, искусстве или другой профессиональной сфере.",
                        "tr": "Bir göstericinin spor, sanat veya başka bir profesyonel alandaki ilk halka açık performansı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дебют",
                                "target_lang_sense_clarification": "первое выступление"
                            },
                            {
                                "target_lang_word": "первое выступление",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "debüt",
                                "target_lang_sense_clarification": "ilk sahneye çıkış veya maç"
                            },
                            {
                                "target_lang_word": "ilk çıkış",
                                "target_lang_sense_clarification": "genel anlamda ilk performans"
                            },
                            {
                                "target_lang_word": "ilk maç",
                                "target_lang_sense_clarification": "sporda ilk müsabaka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e69e8ec-33e4-3c05-8039-d46871a0fa7b",
                    "sense_definition": "The first public presentation of a creative work, such as a film, album, or product.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "first_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band played several songs from their <w>debut</w> album at the concert.",
                            "target_lang_translations": {
                                "ru": "Группа сыграла несколько песен со своего <w>дебютного</w> альбома на концерте.",
                                "tr": "Grup, konserde <w>çıkış</w> albümlerinden birkaç şarkı çaldı."
                            }
                        },
                        {
                            "text": "Critics wrote positive reviews after the film's global <w>debut</w>.",
                            "target_lang_translations": {
                                "ru": "Критики написали положительные отзывы после мирового <w>дебюта</w> фильма.",
                                "tr": "Eleştirmenler, filmin dünya çapındaki <w>ilk gösteriminden</w> sonra olumlu yorumlar yazdı."
                            }
                        }
                    ],
                    "synonyms": [
                        "launch",
                        "release",
                        "premiere",
                        "unveiling"
                    ],
                    "common_phrases": [
                        "debut album",
                        "market debut",
                        "directorial debut",
                        "official debut"
                    ],
                    "target_lang_definitions": {
                        "ru": "Первая публичная презентация творческой работы, например фильма, альбома или продукта.",
                        "tr": "Film, albüm veya ürün gibi yaratıcı bir çalışmanın halka açık ilk sunumu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дебют",
                                "target_lang_sense_clarification": "о творческой работе"
                            },
                            {
                                "target_lang_word": "премьера",
                                "target_lang_sense_clarification": "о фильме или спектакле"
                            },
                            {
                                "target_lang_word": "презентация",
                                "target_lang_sense_clarification": "о продукте"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çıkış",
                                "target_lang_sense_clarification": "albüm veya eser için"
                            },
                            {
                                "target_lang_word": "galası",
                                "target_lang_sense_clarification": "film veya oyun için"
                            },
                            {
                                "target_lang_word": "ilk gösterim",
                                "target_lang_sense_clarification": "sinema/tiyatro"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0059e8ca-634a-334c-8035-1ae97d93eaa3",
                    "sense_definition": "The first formal appearance of a young woman in upper-class society.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "social_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her formal <w>debut</w> was attended by many influential families in the city.",
                            "target_lang_translations": {
                                "ru": "Ее официальный <w>дебют</w> посетили многие влиятельные семьи города.",
                                "tr": "Onun resmi <w>sosyeteye takdimine</w> şehirdeki birçok nüfuzlu aile katıldı."
                            }
                        },
                        {
                            "text": "She spent months learning to dance for her society <w>debut</w>.",
                            "target_lang_translations": {
                                "ru": "Она потратила месяцы, учась танцевать для своего светского <w>дебюта</w>.",
                                "tr": "Sosyete <w>debütü</w> için aylarca dans etmeyi öğrendi."
                            }
                        }
                    ],
                    "synonyms": [
                        "coming out"
                    ],
                    "common_phrases": [
                        "society debut",
                        "make her debut"
                    ],
                    "target_lang_definitions": {
                        "ru": "Первый официальный выход молодой девушки в высшее общество.",
                        "tr": "Genç bir kadının yüksek sosyeteye ilk resmi katılımı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "первый выезд в свет",
                                "target_lang_sense_clarification": "традиционный термин"
                            },
                            {
                                "target_lang_word": "дебют",
                                "target_lang_sense_clarification": "светский"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sosyeteye takdim",
                                "target_lang_sense_clarification": "geleneksel sosyete tanıştırması"
                            },
                            {
                                "target_lang_word": "debüt",
                                "target_lang_sense_clarification": "sosyeteye ilk çıkış"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7234113f-fe48-3bde-96dd-8c747fac1140",
                    "sense_definition": "A celebration of a woman's eighteenth birthday, marking her coming of age.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "social_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a beautiful gown for her eighteenth birthday <w>debut</w>.",
                            "target_lang_translations": {
                                "ru": "Она надела красивое платье на <w>празднование совершеннолетия</w> в честь своего восемнадцатилетия.",
                                "tr": "On sekizinci yaş günü <w>reşit olma partisi</w> için güzel bir elbise giydi."
                            }
                        },
                        {
                            "text": "The family planned a lavish party to celebrate her <w>debut</w> with friends.",
                            "target_lang_translations": {
                                "ru": "Семья запланировала пышную вечеринку, чтобы отпраздновать ее <w>совершеннолетие</w> с друзьями.",
                                "tr": "Aile, onun <w>reşit olmasını</w> arkadaşlarıyla kutlamak için görkemli bir parti planladı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eighteenth birthday debut"
                    ],
                    "target_lang_definitions": {
                        "ru": "Празднование восемнадцатилетия девушки, знаменующее её совершеннолетие.",
                        "tr": "Bir kadının reşit olmasını simgeleyen on sekizinci yaş günü kutlaması."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "празднование совершеннолетия",
                                "target_lang_sense_clarification": "общий смысл"
                            },
                            {
                                "target_lang_word": "бал совершеннолетия",
                                "target_lang_sense_clarification": "торжество"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "reşit olma partisi",
                                "target_lang_sense_clarification": "18. yaş günü kutlaması"
                            },
                            {
                                "target_lang_word": "18 yaş balosu",
                                "target_lang_sense_clarification": "özel yaş kutlama balosu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a6ce588b-524e-3136-b176-3ef7c570bafd",
                    "sense_definition": "To make a first formal public appearance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_appear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new television series <w>debuted</w> last night to mixed reviews.",
                            "target_lang_translations": {
                                "ru": "Новый телесериал <w>дебютировал</w> вчера вечером и получил неоднозначные отзывы.",
                                "tr": "Yeni televizyon dizisi dün gece <w>ekrana geldi</w> ve farklı tepkiler aldı."
                            }
                        },
                        {
                            "text": "The electric car <w>debuted</w> at the international auto show.",
                            "target_lang_translations": {
                                "ru": "Электромобиль <w>дебютировал</w> на международном автосалоне.",
                                "tr": "Elektrikli otomobil uluslararası oto fuarında <w>görücüye çıktı</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "premiere",
                        "open",
                        "launch"
                    ],
                    "common_phrases": [
                        "debut at number one",
                        "debut on screen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Впервые официально выступить или появиться на публике.",
                        "tr": "İlk kez resmi olarak halkın karşısına çıkmak veya yayınlanmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дебютировать",
                                "target_lang_sense_clarification": "выступать впервые"
                            },
                            {
                                "target_lang_word": "выйти на экраны",
                                "target_lang_sense_clarification": "о фильме/шоу"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "debüt yapmak",
                                "target_lang_sense_clarification": "ilk kez sahneye/sahaya çıkmak"
                            },
                            {
                                "target_lang_word": "görücüye çıkmak",
                                "target_lang_sense_clarification": "ilk kez sergilenmek veya yayınlanmak"
                            },
                            {
                                "target_lang_word": "yayına girmek",
                                "target_lang_sense_clarification": "dizi veya yayın için"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35ed82d6-f50a-3264-9c24-1fc719184161",
                    "sense_definition": "To introduce something to the public for the first time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_introduce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technology company <w>debuted</w> its latest smartphone model yesterday.",
                            "target_lang_translations": {
                                "ru": "Технологическая компания <w>представила</w> свою новейшую модель смартфона вчера.",
                                "tr": "Teknoloji şirketi dün en son akıllı telefon modelini <w>tanıttı</w>."
                            }
                        },
                        {
                            "text": "The designer <w>debuted</w> a new collection during fashion week.",
                            "target_lang_translations": {
                                "ru": "Дизайнер <w>презентовал</w> новую коллекцию во время недели моды.",
                                "tr": "Tasarımcı moda haftasında yeni bir koleksiyonu <w>görücüye çıkardı</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "unveil",
                        "launch",
                        "introduce",
                        "premiere"
                    ],
                    "antonyms": [
                        "withdraw",
                        "retire"
                    ],
                    "common_phrases": [
                        "debut a new product",
                        "debut a song"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представить что-либо публике впервые.",
                        "tr": "Bir şeyi kamuoyuna ilk kez sunmak veya tanıtmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представить",
                                "target_lang_sense_clarification": "показать публике"
                            },
                            {
                                "target_lang_word": "презентовать",
                                "target_lang_sense_clarification": "устроить презентацию"
                            },
                            {
                                "target_lang_word": "выпустить",
                                "target_lang_sense_clarification": "о товаре"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tanıtmak",
                                "target_lang_sense_clarification": "ilk kez kamuoyuna sunmak"
                            },
                            {
                                "target_lang_word": "piyasaya sürmek",
                                "target_lang_sense_clarification": "ürün lansmanı yapmak"
                            },
                            {
                                "target_lang_word": "görücüye çıkarmak",
                                "target_lang_sense_clarification": "koleksiyon veya ürün sunmak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}