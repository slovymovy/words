        "fr-extract.jsonl": [
            {
                "entry_id": "77ef16e8-2e0d-3932-9cd6-545a7a499c77",
                "word": "stalagmite",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "93f2564d-59f0-4252-83db-8118fa33098a",
                        "entry_id": "77ef16e8-2e0d-3932-9cd6-545a7a499c77",
                        "tags": [
                            "plural"
                        ],
                        "form": "stalagmites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7df4204c-c924-3236-9cf1-f2932fd8e14f",
                        "entry_id": "77ef16e8-2e0d-3932-9cd6-545a7a499c77",
                        "glosses": [
                            "Concrétion analogue à celle de la stalactite, mais qui se forme sur le sol des cavités souterraines où tombent goutte à goutte les mêmes eaux chargées de sels calcaires, siliceux, etc."
                        ],
                        "tags": [
                            "Spéléologie"
                        ],
                        "examples": [
                            {
                                "example_id": "3399b12d-324a-4aa0-8c8d-047ebd1ab84f",
                                "sense_id": "7df4204c-c924-3236-9cf1-f2932fd8e14f",
                                "text": "Don Teodoro ouvre la procession, chaque personne doit contourner une grande stalagmite ruisselant d’eau par la gauche."
                            },
                            {
                                "example_id": "b53ffc3c-1da7-44cf-9e57-045d9389560e",
                                "sense_id": "7df4204c-c924-3236-9cf1-f2932fd8e14f",
                                "text": "La grande salle des fêtes du Palais du Trocadéro, hier encore salle du Théâtre Populaire. Lieu funèbre s’il en fut : l’immense vaisseau poussiéreux et glacial, les grandes orgues en stalagmites bêtes du fond de l’estrade, l’écho qui faisait de cet endroit l’un des plus détestables de Paris au point de vue acoustique […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52d72a31-56eb-4025-a4aa-a0f591220551",
                        "source_entry_id": "77ef16e8-2e0d-3932-9cd6-545a7a499c77",
                        "source_sense_id": "7df4204c-c924-3236-9cf1-f2932fd8e14f",
                        "target_lang_word": "Tropfstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tropfstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "37c3980c-23a1-3333-b6fe-bb205013cb3f",
                                        "entry_id": "eba21337-07f3-3043-b3cd-c951c95dd3d8",
                                        "glosses": [
                                            "durch tropfendes Wasser entstandene Steine"
                                        ],
                                        "tags": [
                                            "Gestein"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29b8f35b-909f-48bf-bb80-1e907bb30f17",
                                                "sense_id": "37c3980c-23a1-3333-b6fe-bb205013cb3f",
                                                "text": "Die Tropfsteine in der Tropfsteinhöhle sind einzigartig."
                                            },
                                            {
                                                "example_id": "a5ea00f7-7702-4ce8-b124-3f48c8a0ff60",
                                                "sense_id": "37c3980c-23a1-3333-b6fe-bb205013cb3f",
                                                "text": "„Wenn Sickerwasser mit gelöstem Calciumhydrogencarbonat von der Decke einer solchen Höhle tropft, entstehen allmählich Tropfsteine:“ […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b589aec1-a263-4c4b-bad5-11cf614e7310",
                        "source_entry_id": "77ef16e8-2e0d-3932-9cd6-545a7a499c77",
                        "source_sense_id": "7df4204c-c924-3236-9cf1-f2932fd8e14f",
                        "target_lang_word": "Stalagmit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stalagmit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79c70971-1564-38ad-8540-686f507af58c",
                                        "entry_id": "eaa341c2-e3ab-340c-ad97-d84addc676b4",
                                        "glosses": [
                                            "Tropfstein, der vom Boden nach oben wächst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df42138a-8d42-4dfb-bcaf-9830d49589c4",
                                                "sense_id": "79c70971-1564-38ad-8540-686f507af58c",
                                                "text": "In der Tropfsteinhöhle befinden sich große Stalagmiten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18b4ae0d-c89e-47ed-80d9-18272269e85b",
                        "source_entry_id": "77ef16e8-2e0d-3932-9cd6-545a7a499c77",
                        "source_sense_id": "7df4204c-c924-3236-9cf1-f2932fd8e14f",
                        "target_lang_word": "stalagmite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stalagmite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f791bf3e-7328-31ef-8749-a94190259258",
                                        "entry_id": "ed2939a6-bff0-35ad-a93c-1ef8a1be4265",
                                        "glosses": [
                                            "A secondary mineral deposit of calcium carbonate or other mineral, in shapes similar to icicles, that lies on the ground of a cave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5040d334-0aa2-4118-83ac-6cceddd77624",
                                                "sense_id": "f791bf3e-7328-31ef-8749-a94190259258",
                                                "text": "In one place, near at hand, a stalagmite had been slowly growing up from the ground for ages, builded by the water-drip from a stalactite overhead."
                                            },
                                            {
                                                "example_id": "d699b336-0b37-439c-aaab-b0444d42b515",
                                                "sense_id": "f791bf3e-7328-31ef-8749-a94190259258",
                                                "text": "Molten roofing north, lead dripping down south, stand like those immobilized columns of arctic water west, stalagmites, monked and housed or stamped and dudleyed east, in school texts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f96629c5-1f3e-46de-8b24-8b607d8eddb4",
                        "source_entry_id": "77ef16e8-2e0d-3932-9cd6-545a7a499c77",
