                "translations": [
                    {
                        "translation_id": "11d94a0c-0e01-4226-aa85-e456bc81b020",
                        "source_entry_id": "d0c43e3c-b5d3-3914-a164-d771219bab2e",
                        "source_sense_id": "730ebcff-06a6-3d4b-a495-9d38b131f4a2",
                        "source_sense_description": "veraltet: Instrument, um eine passende Tür zu öffnen; Schlüssel",
                        "target_lang_word": "Schlüssel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlüssel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4795ec1-1367-37b8-a023-12edaa1c7218",
                                        "entry_id": "c84d959c-b9b0-3db4-af97-708692ddaac7",
                                        "glosses": [
                                            "Gegenstand zum Schließen und Öffnen eines Schlosses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de5c5a3e-a7fc-4d05-b052-85de31fc636e",
                                                "sense_id": "c4795ec1-1367-37b8-a023-12edaa1c7218",
                                                "text": "Ich finde meine Schlüssel nicht."
                                            },
                                            {
                                                "example_id": "a8a36e7b-0763-4631-95ec-88523a379380",
                                                "sense_id": "c4795ec1-1367-37b8-a023-12edaa1c7218",
                                                "text": "„An Helenas Schlüsselbund hing manchmal der verrostete Schlüssel und erinnerte daran, daß es noch ein anderes und besonderes Schloß gab.“"
                                            },
                                            {
                                                "example_id": "ed2ec66d-f688-4901-8824-7581888847c6",
                                                "sense_id": "c4795ec1-1367-37b8-a023-12edaa1c7218",
                                                "text": "„Er schnappte es sich und knallte mir einen Schlüssel hin.“"
                                            },
                                            {
                                                "example_id": "150044a8-88ff-47dc-b40a-805749004031",
                                                "sense_id": "c4795ec1-1367-37b8-a023-12edaa1c7218",
                                                "text": "„Aus seiner Hosentasche holt Schneider einen Schlüssel und schließt das Badehaus auf.“"
                                            },
                                            {
                                                "example_id": "3e7456e9-6712-44af-b0e8-36ecf67c689a",
                                                "sense_id": "c4795ec1-1367-37b8-a023-12edaa1c7218",
                                                "text": "„Er klingelte, obwohl er einen Schlüssel für ihr Appartement hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "107d13ef-c19a-348b-b820-7adf80dc68f1",
                                        "entry_id": "c84d959c-b9b0-3db4-af97-708692ddaac7",
                                        "glosses": [
                                            "Gegenstand zum Schließen und Öffnen eines Schlosses",
                                            "in der Heraldik Darstellungselement im Wappenschild, symbolisiert Aufgeschlossenheit"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "1b897fc0-510b-3b73-9e79-3119eff8c0aa",
                                        "entry_id": "c84d959c-b9b0-3db4-af97-708692ddaac7",
                                        "glosses": [
                                            "Gegenstand zum Schließen und Öffnen eines Schlosses",
                                            "Symbol des Apostels Simon Petrus"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "f2a0cf28-aba4-31ae-8f30-ecd3f63ec68a",
                                        "entry_id": "c84d959c-b9b0-3db4-af97-708692ddaac7",
                                        "glosses": [
                                            "kurz für Notenschlüssel"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7758b17f-9a3d-4eb1-b6fb-9cba8d76db99",
                                                "sense_id": "f2a0cf28-aba4-31ae-8f30-ecd3f63ec68a",
                                                "text": "Schau dir an, in welchem Schlüssel das Lied notiert ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c46cb0c4-1cec-3e7f-9c27-44e2d696ae8c",
                                        "entry_id": "c84d959c-b9b0-3db4-af97-708692ddaac7",
                                        "glosses": [
                                            "Information, um eine Nachricht zu verschlüsseln oder zu entschlüsseln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31808b05-24ad-4df0-a1cb-2fe486ad84a0",
                                                "sense_id": "c46cb0c4-1cec-3e7f-9c27-44e2d696ae8c",
                                                "text": "Ich brauche einen Schlüssel, um die Nachricht zu verstehen."
                                            },
                                            {
                                                "example_id": "2eb3318f-8049-40bc-b94c-3ee162ef8f3d",
                                                "sense_id": "c46cb0c4-1cec-3e7f-9c27-44e2d696ae8c",
                                                "text": "„Der Schlüssel ist demgegenüber die Angabe, wie denn nun ein Klartext konkret in einen Geheimtext übersetzt werden soll."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8caabefe-0540-304d-9a77-26bca64b7766",
                                        "entry_id": "c84d959c-b9b0-3db4-af97-708692ddaac7",
                                        "glosses": [
                                            "Werkzeug zum Anziehen oder Lösen von Schrauben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e012ee84-426f-4051-8b08-470a12544449",
                                                "sense_id": "8caabefe-0540-304d-9a77-26bca64b7766",
                                                "text": "Reich mir bitte mal den Schlüssel, ich muss noch eine Schraube anziehen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "b3f9c334-26b9-353c-9b72-3afe544f4b90",
                                        "entry_id": "c84d959c-b9b0-3db4-af97-708692ddaac7",
                                        "glosses": [
                                            "kurz für Datenbankschlüssel – eindeutige Kennzeichnung von Datensätzen"
                                        ],
                                        "tags": [
                                            "Datenbanken"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44e6536e-e17a-421b-b321-a719d2c19d02",
                                                "sense_id": "b3f9c334-26b9-353c-9b72-3afe544f4b90",
                                                "text": "„Ein Schlüssel ist eine Menge von Attributen (also eines oder mehrere), die eine Datenzeile (Tupel) einer Tabelle eindeutig identifiziert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "47e12a2e-05e5-323c-9cac-0a64bb7a72f9",
                                        "entry_id": "c84d959c-b9b0-3db4-af97-708692ddaac7",
                                        "glosses": [
                                            "Mittel, um ein Ziel zu erreichen oder ein Problem zu lösen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd12ae8c-0851-46d9-af1d-a22e619d3dc6",
                                                "sense_id": "47e12a2e-05e5-323c-9cac-0a64bb7a72f9",
                                                "text": "„Argelander vermutet den Schlüssel für die Sozialprobleme in der schon sehr früh aufgetretenen Leidenschaft für den Flugsport.“"
                                            },
                                            {
                                                "example_id": "fb1cc5a8-e381-4a5f-8615-36bf349153be",
                                                "sense_id": "47e12a2e-05e5-323c-9cac-0a64bb7a72f9",
                                                "text": "Wenn er wüsste, worin der Schlüssel zur Lösung des Problems liegt, ihm wäre wohler zumute."
                                            },
                                            {
                                                "example_id": "d4c9dce6-b244-41ed-ba67-0e58fbb76bce",
                                                "sense_id": "47e12a2e-05e5-323c-9cac-0a64bb7a72f9",
                                                "text": "Wissen ist der Schlüssel zum Erfolg: Was ein Landwirt gelernt hat, kann ihm keiner mehr nehmen."
                                            },
                                            {
                                                "example_id": "00eff062-68c4-4bac-a7cb-beea2c8ce2c9",
                                                "sense_id": "47e12a2e-05e5-323c-9cac-0a64bb7a72f9",
                                                "text": "Innenpolitisch am wichtigsten war heute aber die Ankündigung, mehr in den Wohnungsbau investieren zu wollen. Das Thema gilt als Schlüssel, um Wahlen zu gewinnen - oder zu verlieren."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "bf72c7cb-5de8-3387-93fb-cdb57602c9c4",
                                        "entry_id": "c84d959c-b9b0-3db4-af97-708692ddaac7",
                                        "glosses": [
                                            "Lösungen zu gestellten Fragen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55303454-b67f-42c2-82fb-4576d9ed985d",
                                                "sense_id": "bf72c7cb-5de8-3387-93fb-cdb57602c9c4",
                                                "text": "Ein sehr gutes Buch mit Prüfungsfragen und Antworten zur Jägerprüfung, im Anhang gibt es einen Schlüssel zur Wissensüberprüfung."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "b20c0de3-29e7-3dfe-ab54-d482f2327bf1",
                                        "entry_id": "c84d959c-b9b0-3db4-af97-708692ddaac7",
                                        "glosses": [
                                            "Schema, wie (Geld- oder Personal-)Mittel zugewiesen, aufgeteilt, verteilt oder aufgegliedert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e2d2150-d5e8-407e-90d0-f5cbb294d3a9",
                                                "sense_id": "b20c0de3-29e7-3dfe-ab54-d482f2327bf1",
                                                "text": "Die Betriebskosten werden nach einem festgelegten Schlüssel auf die einzelnen Mietparteien verteilt."
                                            },
                                            {
                                                "example_id": "8578aa08-f222-4a8d-93cf-6d4e45b67d8b",
                                                "sense_id": "b20c0de3-29e7-3dfe-ab54-d482f2327bf1",
                                                "text": "Es gibt keinen festen Schlüssel z.B. pro 11 Kinder muß 1 Erzieher da sein."
                                            },
                                            {
                                                "example_id": "6df58ca7-4caf-407a-be46-065988b48758",
                                                "sense_id": "b20c0de3-29e7-3dfe-ab54-d482f2327bf1",
                                                "text": "„Zudem ist die Einwohnerzahl der Provinzen der Schlüssel für die föderalen Zuwendungen aus dem jährlichen nationalen Steueraufkommen sowie für die Quotenaufteilung zum Zugang in den Staatsdienst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18f997e4-f9a8-42cf-b5b2-fa2c5ecc39ad",
                        "source_entry_id": "d0c43e3c-b5d3-3914-a164-d771219bab2e",
                        "source_sense_id": "54990dd6-b2ec-385c-a6ce-528d9fb2db1f",
                        "source_sense_description": "Türklopfer",
                        "target_lang_word": "Türklopfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Türklopfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2fe124fe-880e-3acd-b0b0-9efae0a155df",
                                        "entry_id": "3c86a4cb-fc11-362b-a49d-05cf35cd7c00",
                                        "glosses": [
                                            "eine an einer waagerechten Achse hängende massive, meist metallene Vorrichtung, um besonders an alten Türen anzuklopfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e866def4-81b2-4775-9552-f05376df5d15",
                                                "sense_id": "2fe124fe-880e-3acd-b0b0-9efae0a155df",
                                                "text": "Es gibt reich verzierte, in Bauernhäusern aber auch sehr einfach gestaltete Türklopfer."
                                            },
                                            {
                                                "example_id": "73304edc-70ef-41cd-8475-b76347dda73a",
                                                "sense_id": "2fe124fe-880e-3acd-b0b0-9efae0a155df",
                                                "text": "„Die Tür war aus grünem Holz und hatte einen Türklopfer.“"
                                            },
                                            {
                                                "example_id": "bcf1b03d-2f56-481b-9101-8f2269cf1d7d",
                                                "sense_id": "2fe124fe-880e-3acd-b0b0-9efae0a155df",
                                                "text": "„In der Mitte der Tür befand sich ein großer Türklopfer aus Messing in Gestalt einer Fledermaus.“"
                                            },
                                            {
                                                "example_id": "4644fe01-30f5-4fbe-9937-ef8b1ccc3376",
                                                "sense_id": "2fe124fe-880e-3acd-b0b0-9efae0a155df",
                                                "text": "„Das Haus, in dem die Frauen wohnen, hat einen Türklopfer aus Kupfer und eine Katzenklappe, die mit breitem Paketband zugeklebt ist.“"
                                            },
                                            {
                                                "example_id": "7ca4a35c-943e-437b-b5b2-848df1482f95",
                                                "sense_id": "2fe124fe-880e-3acd-b0b0-9efae0a155df",
                                                "text": "„Ihr Kinn wirkt so spitz wie der Türklopfer für die Frauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
