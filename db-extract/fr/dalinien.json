                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c929cde-39f4-494f-b06e-872a9bc9df54",
                                "sense_id": "c09f8537-f8d6-31f0-b23a-baf3c96e6df3",
                                "text": "Nous retrouvons l’image phobique d’un insecte parent, sur le plan de l’imaginaire dalinien et surréaliste : la mante religieuse."
                            },
                            {
                                "example_id": "431e8555-d074-4c95-a31f-6d4aae417b6a",
                                "sense_id": "c09f8537-f8d6-31f0-b23a-baf3c96e6df3",
                                "text": "Considérent le phénomène dalinien comme un élément majeur de l’internationalisation du surréalisme, nous souhaitons en définir les limites chronologiques […]."
                            }
                        ]
