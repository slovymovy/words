            {
                "entry_id": "6da1b19d-d59d-38cf-a726-716d41f81f57",
                "word": "contempteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "99a2754f-dab7-46a4-a86e-3d14370e0ddb",
                        "entry_id": "6da1b19d-d59d-38cf-a726-716d41f81f57",
                        "tags": [
