                "senses": [
                    {
                        "sense_id": "c0037e5d-955e-3378-af22-587227c83d04",
                        "entry_id": "daf824b4-28e3-32f4-8af4-a0df2d81416b",
                        "glosses": [
                            "vreemd, duister, geheim, vaag, onduidelijk, donker, somber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3874ed6e-ff78-490d-b9e4-f381e398a4ad",
                                "sense_id": "c0037e5d-955e-3378-af22-587227c83d04",
                                "text": "Wim Slabbinck staat niet alleen met zijn overtuiging. De Wereldgezondheidsorganisatie (bepaald geen obscure parenclub in Sodom of Gomorra) heeft het over seksuele rechten, die ze expliciet niet enkel ziet als het uitblijven van discriminatie, dwang of soa’s. Het gaat onder meer over ‘de vrijheid om al dan niet seksueel actief te zijn’ en ‘de mogelijkheid om genotvolle seksuele ervaringen te hebben’."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b36c08e-a49c-33e0-b7d2-fc93bbdcea4a",
                        "entry_id": "daf824b4-28e3-32f4-8af4-a0df2d81416b",
                        "glosses": [
                            "met weinig aanzien, ongunstig bekend staand"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "81f03029-5521-35a1-83dd-aefe15f91551",
                        "entry_id": "daf824b4-28e3-32f4-8af4-a0df2d81416b",
                        "glosses": [
                            "niet beroemd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7178de14-70d6-464a-b1d4-8b361dadee4d",
                                "sense_id": "81f03029-5521-35a1-83dd-aefe15f91551",
                                "text": "Je doet, zoals vaker bij deeltjes in deze serie, de ene ontdekking na de andere. People Make The World Go Round van The Chosen Few is zo'n reggae-soulnummer dat meteen op repeat gaat, net als het heerlijke disconummer Disco Dancer van Kiki Gyan. Niet alles is obscuur."
                            }
                        ]
                    },
                    {
                        "sense_id": "49a719ed-b1ca-3543-8754-55fe427834cb",
                        "entry_id": "daf824b4-28e3-32f4-8af4-a0df2d81416b",
                        "glosses": [
                            "illegaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "663931b2-7cb8-4b1b-bffd-d1909e7b269f",
                                "sense_id": "49a719ed-b1ca-3543-8754-55fe427834cb",
                                "text": "De Pool eiste dat de agent van de vrouw 300.000 dollar (circa 260.000 euro) betaalde. Als betaling uitbleef, zou de vrouw via een obscure internetsite te koop worden aangeboden, dreigde de ontvoerder."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33be41d7-69d8-4f50-a18c-1872600608dc",
                        "source_entry_id": "daf824b4-28e3-32f4-8af4-a0df2d81416b",
                        "source_sense_id": "81f03029-5521-35a1-83dd-aefe15f91551",
                        "source_sense_description": "niet beroemd",
                        "target_lang_word": "obscure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obscure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e936537c-148c-3186-b6ce-42ef25c72b5b",
                                        "entry_id": "b5173eb8-8a9c-3666-9aae-7a558b7ac0bb",
                                        "glosses": [
                                            "Dark, faint or indistinct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f52a31e4-e506-4e5f-83da-6a867e652863",
                                                "sense_id": "e936537c-148c-3186-b6ce-42ef25c72b5b",
                                                "text": "I found myself in an obscure wood."
                                            },
                                            {
                                                "example_id": "80f78826-7635-481c-b253-a146cc55d903",
                                                "sense_id": "e936537c-148c-3186-b6ce-42ef25c72b5b",
                                                "text": "His lamp shall be put out in obscure darkness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "975642dc-ad4c-38ba-9891-d087f33ede38",
                                        "entry_id": "b5173eb8-8a9c-3666-9aae-7a558b7ac0bb",
                                        "glosses": [
                                            "Hidden, out of sight or inconspicuous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "594e984f-21c6-4663-92ee-88fa0c497965",
                                                "sense_id": "975642dc-ad4c-38ba-9891-d087f33ede38",
                                                "text": "The obscure bird / Clamoured the livelong night."
                                            },
                                            {
                                                "example_id": "ae7221c6-9278-4aee-8f83-6f63c769d033",
                                                "sense_id": "975642dc-ad4c-38ba-9891-d087f33ede38",
                                                "text": "the obscure corners of the earth"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bafb3799-a95b-3bd7-9ff5-c94f8dea69d1",
                                        "entry_id": "b5173eb8-8a9c-3666-9aae-7a558b7ac0bb",
                                        "glosses": [
                                            "Difficult to understand; abstruse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c7c1230-3b69-416d-9fb7-10a20d4e100b",
                                                "sense_id": "bafb3799-a95b-3bd7-9ff5-c94f8dea69d1",
                                                "text": "an obscure passage or inscription; The speaker made obscure references to little-known literary works."
                                            },
                                            {
                                                "example_id": "bd430aa8-c31d-4256-b8af-223422358aab",
                                                "sense_id": "bafb3799-a95b-3bd7-9ff5-c94f8dea69d1",
                                                "text": "The lock was of a kind that Watt could not pick. Watt could pick simple locks, but he could not pick obscure locks."
                                            },
                                            {
                                                "example_id": "b0a234c4-ea2d-4fdb-92fd-4049917d5652",
                                                "sense_id": "bafb3799-a95b-3bd7-9ff5-c94f8dea69d1",
                                                "text": "The yawning gap in neuroscientists’ understanding of their topic is in the intermediate scale of the brain’s anatomy. Science has a passable knowledge of how individual nerve cells, known as neurons, work. It also knows which visible lobes and ganglia of the brain do what. But how the neurons are organised in these lobes and ganglia remains obscure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16ba7433-edb9-3db3-b216-5fa5bc9c312a",
                                        "entry_id": "b5173eb8-8a9c-3666-9aae-7a558b7ac0bb",
                                        "glosses": [
                                            "Not well-known."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f32bc8df-6893-4be9-a81a-3c120e7ee50b",
                                                "sense_id": "16ba7433-edb9-3db3-b216-5fa5bc9c312a",
                                                "text": "Of all the medical monsters Peter Hotez could have set out to slay, the Yale University researcher could not have chosen a more wily and obscure villain than the hookworm."
                                            },
                                            {
                                                "example_id": "85b334e2-3f35-4fa4-8eff-5840b84829ed",
                                                "sense_id": "16ba7433-edb9-3db3-b216-5fa5bc9c312a",
                                                "text": "i need to be REALLY careful to not use any obscure words. otherwise my tweets might end up on a wiktionary page"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a025120-5d0c-3d01-9470-9d940165cd58",
                                        "entry_id": "b5173eb8-8a9c-3666-9aae-7a558b7ac0bb",
                                        "glosses": [
                                            "Unknown or uncertain; unclear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6ac2ed5-66f7-4b34-9e0c-6ea2d570509b",
                                                "sense_id": "1a025120-5d0c-3d01-9470-9d940165cd58",
                                                "text": "The etymological roots of the word \"blizzard\" are obscure and open to debate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "obscure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4e53eec-9ce0-31b7-a52c-8e6e47940aa1",
                                        "entry_id": "9110aaa7-a50c-3c43-a8db-6a22bb28763c",
                                        "glosses": [
                                            "To render obscure; to darken; to make dim; to keep in the dark; to hide; to make less visible, intelligible, legible, glorious, beautiful, or illustrious."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15124648-7e57-4cc9-a9e5-85182f096888",
                                                "sense_id": "e4e53eec-9ce0-31b7-a52c-8e6e47940aa1",
                                                "text": "They are all couched in a pit hard by Herne's oak, with obscured lights."
                                            },
                                            {
                                                "example_id": "161a56cf-90e5-434c-91ff-de3af0184da0",
                                                "sense_id": "e4e53eec-9ce0-31b7-a52c-8e6e47940aa1",
                                                "text": "c. 1688', William Wake, Preparation for Death\nThere is scarce any duty which has been so obscured in the writings of learned men as this."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15ca2574-1fa6-3ed4-94a7-b8676c2ec85a",
                                        "entry_id": "9110aaa7-a50c-3c43-a8db-6a22bb28763c",
                                        "glosses": [
                                            "To hide, put out of sight etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07e4eb45-40e0-4a9c-9cb1-ce17c9e74f22",
                                                "sense_id": "15ca2574-1fa6-3ed4-94a7-b8676c2ec85a",
                                                "text": "It has been little altered over the years save for the addition of a platform awning which rather obscures the arcaded entrance to the booking hall."
                                            },
                                            {
                                                "example_id": "c23ba67c-70cf-4a28-9ab9-3a6efa300fb4",
                                                "sense_id": "15ca2574-1fa6-3ed4-94a7-b8676c2ec85a",
                                                "text": "But Richmond[…]appeared to lose himself in his own reflections. Some pickled crab, which he had not touched, had been removed with a damson pie; and his sister saw, peeping around the massive silver epergne that almost obscured him from her view, that he had eaten no more than a spoonful of that either."
                                            },
                                            {
                                                "example_id": "523441a3-9dd7-49c7-94b8-7214d283c19c",
                                                "sense_id": "15ca2574-1fa6-3ed4-94a7-b8676c2ec85a",
                                                "text": "However, many people—including railwaymen—are only beginning to realise how great is the amount of civil engineering work necessary to achieve adequate clearances for high-voltage overhead equipment under bridges and tunnels; what is involved in the re-signalling needed to permit the increased throughput of traffic (in some places it is unavoidable, to afford better sighting of signals obscured by overhead electrical gear); [...]."
                                            },
                                            {
                                                "example_id": "69be713e-bea5-40ff-8df1-55024ad5fd9b",
                                                "sense_id": "15ca2574-1fa6-3ed4-94a7-b8676c2ec85a",
                                                "text": "I realized that the purpose of writing is to inflate weak ideas, obscure poor reasoning, and inhibit clarity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf2505e0-e512-393e-8a04-57cb849a8e93",
                                        "entry_id": "9110aaa7-a50c-3c43-a8db-6a22bb28763c",
                                        "glosses": [
                                            "To conceal oneself; to hide."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a82829b-4989-4518-8e9a-8a253b62988a",
                                                "sense_id": "bf2505e0-e512-393e-8a04-57cb849a8e93",
                                                "text": "How! There's bad news. / I must obscure, and hear it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
