                "entry_id": "7176623c-19a3-3979-b213-5bad1876412b",
                "word": "badinage",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "459d8e8c-73df-4788-a7f5-44382c3d1792",
                        "entry_id": "7176623c-19a3-3979-b213-5bad1876412b",
                        "tags": [
                            "plural"
                        ],
