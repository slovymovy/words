                "senses": [
                    {
                        "sense_id": "4f9127f2-61ba-3c56-83de-15b0133b759f",
                        "entry_id": "b6526066-1142-36b6-a071-f57664d9d20a",
                        "glosses": [
                            "die Gesamtheit der Pfeifen einer Orgel"
                        ],
                        "tags": [
                            "Orgelbau"
                        ],
                        "examples": [
                            {
                                "example_id": "a9b3b2fa-c1ff-442d-b771-040098fe7f05",
                                "sense_id": "4f9127f2-61ba-3c56-83de-15b0133b759f",
                                "text": "„Die Orgel […], das größte und volltönendste Tonwerkzeug, zugleich Tasten- und Blasinstrument, hauptsächlich beim christl.[ichen] Gottesdienst verwendet, besteht aus dem Windwerk (Bälge, Kanäle, Windkasten, Pfeifenstöcke und Kanzellen), dem Regierwerk (Klaviatur, Manual und Pedal) und dem Pfeifwerk (Labial- und Zungenpfeifen).“"
                            },
                            {
                                "example_id": "1007e23f-70bf-45b9-bdd7-ec7e3f053506",
                                "sense_id": "4f9127f2-61ba-3c56-83de-15b0133b759f",
                                "text": "„Das Pfeifwerk der Orgel in der katholischen Kirche hat ein Unbekannter zwischen Sonntag, 14. Oktober, 14 Uhr, und Sonntag, 28. Oktober, 11.30 Uhr, mutwillig beschädigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
