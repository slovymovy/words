                "senses": [
                    {
                        "sense_id": "0ce62090-9b01-3670-a0a8-2a51cd675a57",
                        "entry_id": "4cb82085-121c-3bdb-a7b0-5486a78556cb",
                        "glosses": [
                            "bronstig loeien"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "37c586b5-33b0-40ad-8aa8-fa9a9eef5e53",
                                "sense_id": "0ce62090-9b01-3670-a0a8-2a51cd675a57",
                                "text": "In de paartijd gingen de elanden altijd burlen"
                            },
                            {
                                "example_id": "93a378ff-c6e2-46a4-b924-a6c0271c5c6d",
                                "sense_id": "0ce62090-9b01-3670-a0a8-2a51cd675a57",
                                "text": "Sinds eind september is de jaarlijkse bronst (paringstijd) weer aangebroken bij de edelherten. Tijdens de volgende weken denken de mannetjes alleen nog maar aan hun toekomstige nageslacht. Ze doen nu dan ook heel erg hun best om de vrouwtjes (hindes) te imponeren met dominant gedrag en luid burlen (brullen of diep loeien). Soms ontstaan er tussen twee concurrenten ook helse gevechten die zelfs al eens een dodelijke afloop kennen voor een van de bekoorders."
                            }
                        ]
                    }
