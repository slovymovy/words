                    {
                        "form_id": "d074c0d2-2588-4c49-a429-f932fef142a8",
                        "entry_id": "5089d0f5-8e13-303e-80f3-f823e20d060f",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "раце́ях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "87b55e69-a218-3bc0-a11e-6091dc27a39e",
                        "entry_id": "5089d0f5-8e13-303e-80f3-f823e20d060f",
                        "glosses": [
                            "устар., неодобр. длинное скучное назидательное рассуждение, наставление, проповедь, поучение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e2ea17c-f5c5-4cec-8be7-e7de6350e0ec",
                                "sense_id": "87b55e69-a218-3bc0-a11e-6091dc27a39e",
                                "text": "Нет-с, не тут-то было! Началась рацея! Боже, чего тут не было!"
                            }
                        ]
                    },
                    {
                        "sense_id": "4433cc7e-feb9-329e-8c70-1618a81b00f9",
                        "entry_id": "5089d0f5-8e13-303e-80f3-f823e20d060f",
                        "glosses": [
                            "устар. жанр семинаристского творчества, песня и вирши, близкие псальмам и кантам (на Украине)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c53efe8a-c749-493b-a589-e0734fea0f28",
                                "sense_id": "4433cc7e-feb9-329e-8c70-1618a81b00f9",
                                "text": "Маменьке к именинам такую рацею соорудил, что мы только рты разинули: и из мифологии там у него, и музы летают, так что даже, знаешь, видна эта… как бишь её?"
                            }
                        ]
                    },
                    {
                        "sense_id": "a5d54269-4fb8-3860-91ba-18ba34f37d17",
                        "entry_id": "5089d0f5-8e13-303e-80f3-f823e20d060f",
                        "glosses": [
                            "устар. устное пояснение раёшника к картинкам райка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c14ab33-b0e2-47bb-bb8d-d4802770114d",
                                "sense_id": "a5d54269-4fb8-3860-91ba-18ba34f37d17",
                                "text": "Перед этим «presepio» на небольшой эстраде стоит девочка, лет десяти, в шляпке и салопе, и, размахивая ручками, читает заученную наизусть рацею толпящемуся у ног ее народу: она говорит и указывает на представляемое в той капелле."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1379690-8983-46ce-9785-1c24a69ba215",
                        "source_entry_id": "5089d0f5-8e13-303e-80f3-f823e20d060f",
                        "source_sense_description": "длинное скучное назидательное рассуждение, наставление",
                        "target_lang_word": "oracja",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oracja",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "c71e017e-877b-33a7-8b70-74976b6945a8",
                                        "entry_id": "fb5aef96-1e24-3fbd-b5ef-f8e806c4c12e",
                                        "glosses": [
                                            "kwieciste przemówienie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb9db81e-e07f-43de-8c5c-878e50a2f129",
                                                "sense_id": "c71e017e-877b-33a7-8b70-74976b6945a8",
                                                "text": "Tekst oracji, którą wygłosił prezes, wyszedł spod pióra jego asystentki."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "806cc121-c29c-3d4f-8d69-561a8a222c50",
                                        "entry_id": "fb5aef96-1e24-3fbd-b5ef-f8e806c4c12e",
                                        "glosses": [
                                            "perora moralizatorska, mówka"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43bbc511-b96f-4eb3-bc0c-f939e2a8bcf2",
                                                "sense_id": "806cc121-c29c-3d4f-8d69-561a8a222c50",
                                                "text": "Na apelu nie obyło się bez oracji dyrektorki."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "1ab29d8c-a05f-39d1-a113-c7ce1f5ef78b",
                                        "entry_id": "fb5aef96-1e24-3fbd-b5ef-f8e806c4c12e",
                                        "glosses": [
                                            "typ modlitwy wieńczącej część liturgii lub nabożeństwa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b33262b6-282a-4f41-a9ea-aaa2e4c95bbb",
                                                "sense_id": "1ab29d8c-a05f-39d1-a113-c7ce1f5ef78b",
                                                "text": "Przewodniczący liturgii wybrał orację z uroczystości Zesłania Ducha Świętego."
                                            },
                                            {
                                                "example_id": "72b9fc6b-e557-48c4-b26e-560fbb2a4735",
                                                "sense_id": "1ab29d8c-a05f-39d1-a113-c7ce1f5ef78b",
                                                "text": "Po oracji usiedliśmy w ławkach od strony ambony."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
