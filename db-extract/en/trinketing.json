                        "examples": [
                            {
                                "example_id": "41c9263c-169c-4a2b-97e4-852b6b3b0a9e",
                                "sense_id": "aeb19b48-a48c-397c-b83e-09a2dbdbd900",
                                "text": "Methinks yon baubles are more fitting meed\nThan this same goddess here, so great in awe.\nGladly, we trow, ye'd give a larger price\nThan these poor trinketings, to keep your Freia\nAnd have her in your halls. So let it be."
                            }
