                "translations": [
                    {
                        "translation_id": "664416ff-04a4-4591-b49d-4662ce44cb9d",
                        "source_entry_id": "acb7d0dc-0d0a-3a7a-a2ef-3de1c6f06188",
                        "source_sense_id": "1a119a29-c7f5-32a4-87d0-58f98b70a077",
                        "source_sense_description": "interstellaire gas- en stofwolken die worden beschouwd als de geboorteplaats van de sterren",
                        "target_lang_word": "Nebel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nebel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d69e116-b8bc-37ec-a4b8-9bf0fa8b705c",
                                        "entry_id": "fbbab747-1146-3dc7-8ed0-4afe10947595",
                                        "glosses": [
                                            "Gemisch fein verteilter Flüssigkeitströpfchen, meistens Wassertröpfchen, und/oder Eiskristalle in Gasen, meist in der Luft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2923ccb0-ff1d-4a18-b762-581932b516c1",
                                                "sense_id": "8d69e116-b8bc-37ec-a4b8-9bf0fa8b705c",
                                                "text": "Nebel mit Sichtweiten unter 50 Meter behindert den Verkehr."
                                            },
                                            {
                                                "example_id": "0ca57965-e353-491d-8518-58bbfc0b5913",
                                                "sense_id": "8d69e116-b8bc-37ec-a4b8-9bf0fa8b705c",
                                                "text": "„Hinter den Ofen gebannt,",
                                                "translation": "Es will zum Nebel zerfließen.“"
                                            },
                                            {
                                                "example_id": "3de94b9c-4a8d-46db-b783-e1102eba20f4",
                                                "sense_id": "8d69e116-b8bc-37ec-a4b8-9bf0fa8b705c",
                                                "text": "„Nebel verbreiten sich, umhüllen den Hintergrund, auch die Nähe, nach Belieben.“"
                                            },
                                            {
                                                "example_id": "02b007c1-fe6d-4d10-a2ae-0c77dca29bf9",
                                                "sense_id": "8d69e116-b8bc-37ec-a4b8-9bf0fa8b705c",
                                                "text": "Der Nebel über dem Chalet lichtete sich nur langsam."
                                            },
                                            {
                                                "example_id": "8199f9d0-27f4-47b0-bbdf-56943f901deb",
                                                "sense_id": "8d69e116-b8bc-37ec-a4b8-9bf0fa8b705c",
                                                "text": "„Wir fahren schweigend durch dichten Nebel, der das Scheinwerferlicht des Wagens schluckt.“"
                                            },
                                            {
                                                "example_id": "25ca5b72-f673-4078-bc8d-4e61e9ce6892",
                                                "sense_id": "8d69e116-b8bc-37ec-a4b8-9bf0fa8b705c",
                                                "text": "„In den Tälern des Siebengebirges, wir sind sicher, hängt der Nebel tief.“"
                                            },
                                            {
                                                "example_id": "fae4fc10-9d3f-40aa-a1c0-cabcec6b1faf",
                                                "sense_id": "8d69e116-b8bc-37ec-a4b8-9bf0fa8b705c",
                                                "text": "„Am Morgen kroch Nebel aus den Wäldern und hinderte die Sonne am Aufgehen, sie marschierten in eine Nebelwand, ungewiss das Ziel, ungewiss das Ende.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b406e404-062e-3d70-afd7-e3ab53c57ca0",
                                        "entry_id": "fbbab747-1146-3dc7-8ed0-4afe10947595",
                                        "glosses": [
                                            "flächenhaft leuchtendes Objekt am Himmel; heute meist speziell eine interstellare Wolke aus Gas und Staub"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47a2c0ce-1b29-44c4-a3c0-d6490ac6db44",
                                                "sense_id": "b406e404-062e-3d70-afd7-e3ab53c57ca0",
                                                "text": "Bei klarem Sternenhimmel sind nachts am Firmament auch Nebel zu beobachten, so z. B. gelegentlich der Orionnebel, einer der bekannten Sternennebel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "633def98-1e03-3771-b87f-048c7ab1f5b0",
                                        "entry_id": "fbbab747-1146-3dc7-8ed0-4afe10947595",
                                        "glosses": [
                                            "durch die Weltorganisation für Meteorologie (WMO) standardisierte Wettererscheinung mit Sichtminderung unter 1000 m"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daf62956-0cb5-42d6-976d-f74b4f282ef1",
                                                "sense_id": "633def98-1e03-3771-b87f-048c7ab1f5b0",
                                                "text": "Bei Sichtweiten unter 1000 m sprechen die Meteorologen von Nebel und verwenden in den Wetterkarten entsprechende Symbole."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Nebel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de00cef1-a548-3b1c-a3f2-02d1f098ea73",
                                        "entry_id": "2aa15fe4-92cc-3e3a-8721-28fa0a4dac9b",
                                        "glosses": [
                                            "eine Gemeinde auf der Nordseeinsel Amrum (Deutschland)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b43022cc-52be-4b2b-ba01-5b81344f3f9f",
                                                "sense_id": "de00cef1-a548-3b1c-a3f2-02d1f098ea73",
                                                "text": "Nebel ist ein ruhiges Plätzchen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Nebel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b62a0b91-1cd2-3789-a5d2-fc8d5c9b887d",
                                        "entry_id": "cb18f750-d155-3bc2-a053-e9dfb0e84da9",
                                        "glosses": [
                                            "ein Fluss in Mecklenburg-Vorpommern, (Deutschland)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fdb4037-d2d5-4a0f-b0b3-936f787cb3d8",
                                                "sense_id": "b62a0b91-1cd2-3789-a5d2-fc8d5c9b887d",
                                                "text": "Die Nebel wird oft nicht nur als das schönste Flüsschen in Mecklenburg bezeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Nebel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f36ae87-ef55-3d68-89b6-a8e7c2756ea8",
                                        "entry_id": "eafdf4f9-7e9a-31f2-a873-c0b5c1f8e89d",
                                        "glosses": [
                                            "ein deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1041e9c3-3c8c-46cf-a9fa-77bd959f71e5",
                                                "sense_id": "3f36ae87-ef55-3d68-89b6-a8e7c2756ea8",
                                                "text": "Wenn wir Nebels zu Besuch einladen, können Schillings nicht auch noch kommen, das würde nicht gut ausgehen!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
