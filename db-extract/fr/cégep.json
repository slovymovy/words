                "senses": [
                    {
                        "sense_id": "82046e31-e574-38b9-b8e5-84ceaee433f4",
                        "entry_id": "63a0b08a-ad75-3e4c-a45e-38a7ed492a9f",
                        "glosses": [
                            "Établissement d’enseignement collégial où est offerte une formation technique et pré-universitaire."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "note": "Le cégep fait suite au secondaire ; on y entre donc vers 17 ans si on n’a pas redoublé au primaire et au secondaire",
                        "examples": [
                            {
                                "example_id": "931aed08-13bb-4ca7-808f-1050db42980b",
                                "sense_id": "82046e31-e574-38b9-b8e5-84ceaee433f4",
                                "text": "Simon va réussir ses examens, cela va le revaloriser, et au cégep, il se sentira traité en adulte."
                            },
                            {
                                "example_id": "1b2968c1-eccf-4fa1-872d-d4a8a690b8a5",
                                "sense_id": "82046e31-e574-38b9-b8e5-84ceaee433f4",
                                "text": "Pour ne plus avoir de « danke schön » à dire au Führer familial, dès la fin du cégep, il avait fait une croix gammée sur les études universitaires et était rentré dans la police."
                            },
                            {
                                "example_id": "fc3ccd7b-4069-4195-8a32-14313ec739d2",
                                "sense_id": "82046e31-e574-38b9-b8e5-84ceaee433f4",
                                "text": "«Quand j’ai fait mon cégep il y a 25 ans, il n’y avait pas de Netflix, pas de YouTube, pas cette immersion constante dans le bagage culturel et linguistique anglo-saxon. […]»."
                            }
                        ]
                    }
