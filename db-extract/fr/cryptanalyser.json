                "senses": [
                    {
                        "sense_id": "1e476be1-8f3d-3688-b492-9b3023dcc7ca",
                        "entry_id": "2ed8267d-0feb-3609-809b-46c944820f9d",
                        "glosses": [
                            "Analyser (quelque chose qui est crypté) en vue de le décrypter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca95355f-987f-4e6d-9830-6f7d2e9a0ae7",
                                "sense_id": "1e476be1-8f3d-3688-b492-9b3023dcc7ca",
                                "text": "On évalue la sécurité d’un système en fonction du nombre d’opérations élémentaires (une somme de 2 bits par exemple) nécessaire a priori pour cryptanalyser (ou casser) le système par les meilleures attaques connues."
                            },
                            {
                                "example_id": "5cde877a-9002-4d13-a228-100d0e40d4a0",
                                "sense_id": "1e476be1-8f3d-3688-b492-9b3023dcc7ca",
                                "text": "Dans les sciences humaines, de nombreuses recherches tournent autour de la quête de ce relief intérieur qui permettrait de décrypter et/ou de cryptanalyser notre identité symbolique et émotionnelle."
                            }
                        ]
                    }
