                "senses": [
                    {
                        "sense_id": "a6ace613-76b3-3487-8796-ef0ef6235dc9",
                        "entry_id": "64ec0140-b793-3a54-b50f-040b69c31474",
                        "glosses": [
                            "essbare Frucht des tropischen Nierenbaums/Cashewbaums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54d6a75f-88c7-441d-9a54-41a2fc0626cb",
                                "sense_id": "a6ace613-76b3-3487-8796-ef0ef6235dc9",
                                "text": "Cashewnüsse sind reich an Mineralstoffen."
                            },
                            {
                                "example_id": "29d8ee59-5423-4ea0-ad49-590b9c5bcd3f",
                                "sense_id": "a6ace613-76b3-3487-8796-ef0ef6235dc9",
                                "text": "„Mit den Zähnen riss Chigurh die Plastiktüte Cashewnüsse auf, schüttelte sich ein Drittel des Inhalts auf den Handteller und begann zu essen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd8a3a1f-3763-420c-9268-6534420dc8f3",
                        "source_entry_id": "64ec0140-b793-3a54-b50f-040b69c31474",
                        "source_sense_id": "a6ace613-76b3-3487-8796-ef0ef6235dc9",
                        "source_sense_description": "essbare Frucht des tropischen Nierenbaums/Cashewbaums",
                        "target_lang_word": "cashew nut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cashew nut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6d8a464-53ef-33ff-98d6-f6c4ecac707e",
                                        "entry_id": "b8b41196-61c5-3881-af64-1f7ddfc9b187",
                                        "glosses": [
                                            "The seed of the cashew tree, often viewed as a nut in the culinary sense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3decc5d-e8ef-4152-9609-cb1b176c64e0",
                                                "sense_id": "e6d8a464-53ef-33ff-98d6-f6c4ecac707e",
                                                "text": "Cashew nut is made up of a fruit in which the kernel is embedded. The real fruit of the cashew is commonly a nut. It is a kidney- or heart-shaped achene, in any normal variety."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b3936c0-982a-4c8a-b94e-fa40f00e19ff",
                        "source_entry_id": "64ec0140-b793-3a54-b50f-040b69c31474",
                        "source_sense_id": "a6ace613-76b3-3487-8796-ef0ef6235dc9",
                        "source_sense_description": "essbare Frucht des tropischen Nierenbaums/Cashewbaums",
                        "target_lang_word": "cashew",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cashew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7714356-fa19-31a4-aac7-a335ce2f081f",
                                        "entry_id": "36018b7b-7696-3901-b624-36eb8ce272d9",
                                        "glosses": [
                                            "A tree, Anacardium occidentale, native to northeastern Brazil, now widely grown in tropical climates for its cashew nuts and cashew apples."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70eccadc-75af-4dc3-87b8-bedf06b3ba4c",
                                                "sense_id": "a7714356-fa19-31a4-aac7-a335ce2f081f",
                                                "text": "Also known as the Native Cashew, it is a member of the Anacardiaceae, the same plant family to which the Cashew and Mango trees belong."
                                            },
                                            {
                                                "example_id": "55e680bf-492c-46d6-b972-4a7d538b615e",
                                                "sense_id": "a7714356-fa19-31a4-aac7-a335ce2f081f",
                                                "text": "Cashew (Anacardium occidental L.) is an export-oriented crop grown for its nuts, a true drupe."
                                            },
                                            {
                                                "example_id": "d1b27525-0061-48c3-b089-c09aec6a1648",
                                                "sense_id": "a7714356-fa19-31a4-aac7-a335ce2f081f",
                                                "text": "Soft-wood grafting and veneer grafting are successful in cashew."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe911d20-d50e-3452-aa0e-edd6cc037c90",
                                        "entry_id": "36018b7b-7696-3901-b624-36eb8ce272d9",
                                        "glosses": [
                                            "A cashew nut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32ed59fd-486d-4d75-b81d-d082855aa18d",
                                                "sense_id": "fe911d20-d50e-3452-aa0e-edd6cc037c90",
                                                "text": "In some countries, cashews continue to be cracked manually although cracking machinery and other shelling mechanisms have been introduced."
                                            },
                                            {
                                                "example_id": "80d49595-8c43-4f5a-99e5-ec5120939c76",
                                                "sense_id": "fe911d20-d50e-3452-aa0e-edd6cc037c90",
                                                "text": "The bland cashew is a fitting substitute for higher priced almonds to extend the nut texture. In baking, however, almonds are more suitable for cake decoration than cashews."
                                            },
                                            {
                                                "example_id": "0d3d5b7d-1a8d-403f-ac53-3486a4ce1fb7",
                                                "sense_id": "fe911d20-d50e-3452-aa0e-edd6cc037c90",
                                                "text": "This is a spicy variation of Kung Pao Chicken using cashews rather than the more common peanuts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6019018-20c0-43e4-b8aa-e91ad210648c",
                        "source_entry_id": "64ec0140-b793-3a54-b50f-040b69c31474",
                        "source_sense_id": "a6ace613-76b3-3487-8796-ef0ef6235dc9",
                        "source_sense_description": "essbare Frucht des tropischen Nierenbaums/Cashewbaums",
                        "target_lang_word": "anacarde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anacarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4354a47-60e2-324b-aab8-69a15d06b1e4",
                                        "entry_id": "0d880f57-7818-3903-aa42-f23090e38c5d",
                                        "glosses": [
                                            "Fruit de l’anacardier, comprenant la noix de cajou et la pomme de cajou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2c3e6a7-11ba-4767-b0ec-80ca6ae56dd0",
                                                "sense_id": "f4354a47-60e2-324b-aab8-69a15d06b1e4",
                                                "text": "La production d’anacarde a entraîné des mutations sociales au niveau de certaines zones rurales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e54ccdc-5304-457c-8d72-9f63b6ca9241",
                        "source_entry_id": "64ec0140-b793-3a54-b50f-040b69c31474",
                        "source_sense_id": "a6ace613-76b3-3487-8796-ef0ef6235dc9",
                        "source_sense_description": "essbare Frucht des tropischen Nierenbaums/Cashewbaums",
                        "target_lang_word": "noix de cajou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noix de cajou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0dc1a255-26d3-329d-91a4-717810b50f94",
                                        "entry_id": "f877169f-6d6d-3e36-bd6d-1558006c610e",
                                        "glosses": [
                                            "Akène de l'anacardier se développant en premier à l'extrémité d'un pédoncule juteux et comestible lui aussi qui est un faux-fruit appelé pomme de cajou."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a38b5b5-560c-3340-90d1-f27ba8c7b6f5",
                                        "entry_id": "f877169f-6d6d-3e36-bd6d-1558006c610e",
                                        "glosses": [
                                            "Amande contenue dans cet akène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb27a67f-9779-4276-a7b1-ee62786981e3",
                                                "sense_id": "0a38b5b5-560c-3340-90d1-f27ba8c7b6f5",
                                                "text": "Au centre de la noix se trouve une seule amande en forme de demi-lune d'environ trois centimètres de longueur entourée d'une pellicule blanche. Elle deviendra, après avoir été grillée et salée, la noix de cajou commercialisée et dégustée à l'apéritif."
                                            },
                                            {
                                                "example_id": "dbc89e67-dac7-402b-b25f-9359e1ae0124",
                                                "sense_id": "0a38b5b5-560c-3340-90d1-f27ba8c7b6f5",
                                                "text": "Outre son intérêt sur le plan forestier, l’anacardier est cultivé essentiellement pour son fruit, la noix de cajou, dont l’amande est utilisée de plusieurs manières : elle entre dans la composition de nombreuses confiseries ou pâtisseries et sert à préparer du beurre d’anacarde : grillée et salée, elle peut être consommée seule ou en mélange avec d’autres noix ou fruits secs."
                                            }
                                        ]
                                    }
                                ]
