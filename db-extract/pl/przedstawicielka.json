                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98cd33ea-dcb4-4dab-a560-3d03236cc771",
                                "sense_id": "eaafea00-e309-34e3-bf83-11a99ff6c4e1",
