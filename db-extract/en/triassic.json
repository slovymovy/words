                                "target_senses": [
                                    {
                                        "sense_id": "f828ac34-5c0c-31d0-b1d0-1a69940c6339",
                                        "entry_id": "6efa41e4-4749-3ed2-983f-6168f573af4b",
                                        "glosses": [
                                            "Dreiheit, Gesamtheit, die aus drei Komponenten oder Elementen besteht"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3760a9c2-adae-434d-b512-7b43c7ec0921",
                                                "sense_id": "f828ac34-5c0c-31d0-b1d0-1a69940c6339",
                                                "text": "Auf zahlreichen figürlichen Monumenten aus römischer Zeit bildet dieser syrische Gott zusammen mit Venus und Merkur eine Trias."
                                            },
                                            {
                                                "example_id": "2f67395c-ea30-4c09-aa3a-b28a11297d34",
                                                "sense_id": "f828ac34-5c0c-31d0-b1d0-1a69940c6339",
                                                "text": "„Aber die Herrschaft der »langen Kerls« und Phallokraten ging zu Ende, als die Trias von Penicillin, Antibabypille oder der daraus resultierenden Emanzipation die Herren der Schöpfung zu solchen der Erschöpfung machte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e30b681d-b394-3c41-a6b1-5522c2212b29",
                                        "entry_id": "6efa41e4-4749-3ed2-983f-6168f573af4b",
                                        "glosses": [
                                            "ältestes System des Mesozoikums (vor etwa 248 bis 214 Millionen Jahren)"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd734f15-19be-46cc-97b5-f74cca7e5efe",
                                                "sense_id": "e30b681d-b394-3c41-a6b1-5522c2212b29",
                                                "text": "„Diese fluvialen Sandsteine und Konglomerate sind von mächtigen Dolomitabfolgen mit eingeschalteten bituminösen Schiefern, von Flachwasserkalken und Evaporiten der Mittleren Trias überlagert.“"
                                            },
                                            {
                                                "example_id": "99ee0ec7-97d3-47b7-9363-89c2b08aacc1",
                                                "sense_id": "e30b681d-b394-3c41-a6b1-5522c2212b29",
                                                "text": "„Zur Zeit der Trias vor über 200 Millionen Jahren waren weite Teile West- und Mitteleuropas von einem großen Meer bedeckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fef74728-7c9d-3f8a-ac1c-a860026667ff",
                                        "entry_id": "6efa41e4-4749-3ed2-983f-6168f573af4b",
                                        "glosses": [
                                            "gemeinschaftliches Auftreten dreier Symptome"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74cb9d18-124a-4470-9a7b-2e2a95aec2da",
                                                "sense_id": "fef74728-7c9d-3f8a-ac1c-a860026667ff",
                                                "text": "Die Trias aus Arthritis, Urethritis und Konjunktivitis wird als Reiter-Syndrom oder Morbus Reiter bezeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
