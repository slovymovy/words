                "entry_id": "a27e03e4-18c6-3687-b659-64877857f2c1",
                "word": "unfreedom",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4cc2e32f-d32a-4183-be3b-0906926b2e48",
                        "entry_id": "a27e03e4-18c6-3687-b659-64877857f2c1",
                        "tags": [
                            "plural"
                        ],
                        "form": "unfreedoms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "179ca8ee-18bf-33a4-b446-fc587088e3cb",
                        "entry_id": "a27e03e4-18c6-3687-b659-64877857f2c1",
                        "glosses": [
                            "The condition of being unfree."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7dc3873a-5d28-406d-964c-a2124f7836bd",
                                "sense_id": "179ca8ee-18bf-33a4-b446-fc587088e3cb",
                                "text": "It was as if all the unfreedom in which he'd spent his seven decades of life were embodied in this six-year-old but essentially brand-new chair."
                            },
                            {
                                "example_id": "261712cc-cde3-4e42-a481-8c2ece15d06e",
                                "sense_id": "179ca8ee-18bf-33a4-b446-fc587088e3cb",
                                "text": "A comfortable, smooth, reasonable, democratic unfreedom prevails in advanced industrial civilization, a token of technical progress."
                            },
                            {
                                "example_id": "a8448589-d519-4e6a-abf3-61ec5bbc4d2b",
                                "sense_id": "179ca8ee-18bf-33a4-b446-fc587088e3cb",
                                "text": "We feel free because we lack the very language to articulate our unfreedom."
                            },
                            {
                                "example_id": "b8d1c998-a938-4203-895b-f6e4b00a0f80",
                                "sense_id": "179ca8ee-18bf-33a4-b446-fc587088e3cb",
                                "text": "She is her father's daughter in a way that has finally brought her back to unfreedom . . . the last misfortune bequeathed to her by the terrible man who was her father."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2aef665-6349-36a0-a01d-b58a75afd5c8",
                        "entry_id": "a27e03e4-18c6-3687-b659-64877857f2c1",
                        "glosses": [
                            "A particular limitation of one's freedom."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "3fb54949-fee3-4d16-9ea4-64c280bdeb45",
                                "sense_id": "a2aef665-6349-36a0-a01d-b58a75afd5c8",
                                "text": "Perhaps most notably, our enquiries into the existence of unfreedoms are steps toward the measurement of the overall freedom of each individual and of each society."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8400da5-85f4-4a8b-a855-d8cda90b8047",
                        "source_entry_id": "a27e03e4-18c6-3687-b659-64877857f2c1",
                        "source_sense_description": "the condition of being unfree",
                        "target_lang_word": "Unfreiheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unfreiheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc2f951a-b679-3a06-b0cf-8082c3014998",
                                        "entry_id": "0310f260-28e3-3a79-b7c0-6e7e8e5ff33c",
                                        "glosses": [
                                            "Fehlen der Freiheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0da8e3c9-0d6f-4647-aaf4-5bda2afd0aaf",
                                                "sense_id": "cc2f951a-b679-3a06-b0cf-8082c3014998",
                                                "text": "„Man hört ja wohl von solchen erzählen, die den Tod der Unfreiheit vorzogen.“"
                                            },
                                            {
                                                "example_id": "9e7d4527-7db4-4dc3-91a6-9343272c3f58",
                                                "sense_id": "cc2f951a-b679-3a06-b0cf-8082c3014998",
                                                "text": "„Wir können ihm nur seine Unfreiheit nicht verzeihen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
