                "senses": [
                    {
                        "sense_id": "901ba99e-6aca-3569-b3bd-6b8c5c048604",
                        "entry_id": "ca77b12b-47ca-3598-9a68-c91a9df67758",
                        "glosses": [
                            "das Entstehen von Geruch; Abgabe von Geruchsstoffen an die Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "462fd224-f656-4ea1-a411-e2f8125e3bb7",
                                "sense_id": "901ba99e-6aca-3569-b3bd-6b8c5c048604",
                                "text": "„Ausgehend von der Klärung der Geruchsentstehung und -wirkung sowie des Entstehens eines Geruchseindruckes beim Menschen, werden herkömmliche Verfahren zur Geruchsbestimmung im Kapitel 2 vorgestellt.“"
                            },
                            {
                                "example_id": "6d65cd32-97cd-4e37-9dd8-8aa0fc0070b5",
                                "sense_id": "901ba99e-6aca-3569-b3bd-6b8c5c048604",
                                "text": "„In den Hautbereichen, die vornehmlich mit den ekkrinen Schweißdrüsen bestückt sind, liegt der pH-Wert etwa bei 5 – 6. Bei den Hautarealen, die zum großen Teil mit apokrinen Drüsen versehen sind, kommt es im Falle der Schweißverdunstung allerdings zu einem Anstieg des pH-Wertes und hierdurch zu basischen Haut eaktionen, was hinsichtlich der schweißbedingten Geruchsentstehung von zentraler Bedeutung ist.“"
                            },
                            {
                                "example_id": "be83ba1f-0c85-4203-85d9-ef9a004d66d1",
                                "sense_id": "901ba99e-6aca-3569-b3bd-6b8c5c048604",
                                "text": "„Zunächst wurden die Ursachen der Geruchsentstehung und -verbreitung ermittelt.“"
                            },
                            {
                                "example_id": "de5b0b37-11b6-4d1a-8432-355424e3b1ab",
                                "sense_id": "901ba99e-6aca-3569-b3bd-6b8c5c048604",
                                "text": "„ Ein anderes vielversprechendes Einsatzgebiet der probiotischen Bakterien sei die Vermeidung der Geruchsentstehung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
