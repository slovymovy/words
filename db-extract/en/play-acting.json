                                        "glosses": [
                                            "Ausübung des Berufs eines Schauspielers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f6c89ec-fc25-428b-9ba9-c53cdc784edb",
                                                "sense_id": "035a3200-6862-3b1c-85f2-3c29f08c1a0e",
                                                "text": "Die Schauspielerei bedeutete ihr mehr als alles andere."
                                            },
                                            {
                                                "example_id": "b8b669e9-3055-40fb-9c64-e1a579c9d750",
                                                "sense_id": "035a3200-6862-3b1c-85f2-3c29f08c1a0e",
                                                "text": "„Sie würde noch einmal gründlich über ihren Traum nachdenken müssen und über die Schauspielerei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fc5508bb-bdaa-35a3-bfc0-a7c8f7575f1b",
                                        "entry_id": "34e8f590-d01d-336d-b3ae-09b89c6744f1",
                                        "glosses": [
                                            "Verhalten, etwas vorzuspielen, vorzugeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c14ad78c-f5b2-4a4c-b037-17ad8f54d0d9",
                                                "sense_id": "fc5508bb-bdaa-35a3-bfc0-a7c8f7575f1b",
                                                "text": "„Und da sie ihre Vorstellung offenbar für gelungene Schauspielerei hielt, gellte ihr Gekreisch durch die ganze Wohnung.“"
                                            },
                                            {
                                                "example_id": "f92b2e08-c514-4632-bef3-9ff231e3a223",
                                                "sense_id": "fc5508bb-bdaa-35a3-bfc0-a7c8f7575f1b",
                                                "text": "„Doch die ganze Schauspielerei nützte ihr nichts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
