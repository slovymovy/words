                "senses": [
                    {
                        "sense_id": "56d34c7d-3031-316a-a682-b4df420818d8",
                        "entry_id": "0d7dc7b7-c2c6-3438-8390-6de25d86b754",
                        "glosses": [
                            "Testverfahren der Linguistik / Psychologie zur Bestimmung der Konnotationen (Nebenbedeutungen, Einstellungen), die Versuchspersonen mit einem Testwort oder einer anderen Testeinheit verbinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d594d4a-975b-49b3-bb71-94e40f6dc12d",
                                "sense_id": "56d34c7d-3031-316a-a682-b4df420818d8",
                                "text": "Das Polaritätsprofil für das Wort \"Hund\" als Testeinheit könnte zeigen, dass verschiedene Personen unterschiedliche Einstellungen zu diesen Tieren haben."
                            },
                            {
                                "example_id": "3ac40e51-21ae-494c-8259-1af5d02bfbdb",
                                "sense_id": "56d34c7d-3031-316a-a682-b4df420818d8",
                                "text": "Ein Polaritätsprofil besteht aus einer Reihe von Skalen, die durch antonyme Adjektive gebildet werden (z.B.: heiß - kalt; groß - klein)."
                            },
                            {
                                "example_id": "7230ceae-f6f2-4582-8e20-b460b1d578cb",
                                "sense_id": "56d34c7d-3031-316a-a682-b4df420818d8",
                                "text": "„Wie die Bilder im einzelnen wirken, können wir ebenfalls mit Hilfe des Polaritätsprofils feststellen.“"
                            },
                            {
                                "example_id": "d8d5ffc0-cf99-4fa7-8047-bf44adc84304",
                                "sense_id": "56d34c7d-3031-316a-a682-b4df420818d8",
                                "text": "„Demgegenüber nutzt P.R. Hofstätter zur Veranschaulichung die die Skaleneinträge verknüpfenden Polaritätsprofile;…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
