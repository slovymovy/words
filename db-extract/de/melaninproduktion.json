                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b22de79-9f66-4298-a433-ecd48103a964",
                                "sense_id": "e3621938-403b-3b0b-9e6b-ec0cf6f9ef59",
                                "text": "„Die Melanozyten werden durch verschiedene Signale zur Melaninproduktion angeregt.“"
                            },
                            {
                                "example_id": "d00f304f-cccb-4203-a013-4e4cdd3d5bfd",
                                "sense_id": "e3621938-403b-3b0b-9e6b-ec0cf6f9ef59",
                                "text": "„Eine dritte mögliche Substanz ist Phenylalanin, eine essenzielle Aminosäure, die Ausgangssubstanz der Melaninproduktion ist.“"
                            },
                            {
                                "example_id": "79665d2d-45f4-414f-953b-a4abfddcde10",
                                "sense_id": "e3621938-403b-3b0b-9e6b-ec0cf6f9ef59",
                                "text": "„Beim Albinismus besteht eine angeborene Störung der Melaninproduktion.“"
                            },
                            {
                                "example_id": "82e989ee-5a71-4962-b323-5919ae15c50e",
                                "sense_id": "e3621938-403b-3b0b-9e6b-ec0cf6f9ef59",
                                "text": "„Eine verminderte Melaninproduktion und gleichzeitige Lufteinschlüsse im Haarschaft sind für den grauweißen Haarton des alten Menschen verantwortlich.“"
                            },
                            {
                                "example_id": "b181d005-1040-4914-87c8-a5c4dddbc312",
                                "sense_id": "e3621938-403b-3b0b-9e6b-ec0cf6f9ef59",
                                "text": "„Oft steigt dabei auch die Melaninproduktion, und die natürliche Farbe tritt wieder stärker hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
