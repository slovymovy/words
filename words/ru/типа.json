                                "tr": "Biz sadece, <w>yani</w>, parkta yürüyorduk.",
                                "es": "Simplemente estábamos, <w>en plan</w>, paseando por el parque.",
                                "zh": "我们当时就<w>算是</w>在公园里散步。"
                            }
                        },
                        {
                            "text": "Это здание <w>типа</w> замка.",
                            "target_lang_translations": {
                                "en": "This building is <w>like</w> a castle.",
                                "nl": "Dit gebouw is <w>soort van</w> een kasteel.",
                                "pl": "Ten budynek jest <w>coś jak</w> zamek.",
                                "de": "Dieses Gebäude ist <w>wie</w> ein Schloss.",
                                "fr": "Ce bâtiment est <w>genre</w> un château.",
                                "it": "Questo edificio è <w>tipo</w> un castello.",
                                "cs": "Tato budova je <w>něco jako</w> zámek.",
                                "tr": "Bu bina kale <w>gibi</w> bir şey.",
                                "es": "Este edificio es <w>como</w> un castillo.",
                                "zh": "这栋建筑<w>像</w>城堡一样。"
                            }
                        }
