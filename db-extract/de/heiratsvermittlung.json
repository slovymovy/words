                        "source_entry_id": "d8047b18-42fa-3bcc-a2a3-83cc0543a746",
                        "source_sense_id": "02c72b90-5548-3aed-8624-f6ce9e1669ec",
                        "source_sense_description": "kommerzielle Vermittlung von Ehen",
                        "target_lang_word": "matchmaking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matchmaking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b31da25-d56a-3193-82f9-2adfe3979884",
                                        "entry_id": "27af744c-1083-3a50-b1e7-f19e9be3b5fa",
                                        "glosses": [
                                            "An attempt to make two people romantically interested in each other, especially an attempt to set up a date between people or to arrange a marriage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b472b9c6-4ea3-4e47-bee6-64bdd6f44165",
                                                "sense_id": "0b31da25-d56a-3193-82f9-2adfe3979884",
                                                "text": "Patty, your timing is excellent. There's Claude over there. Want me to do some matchmaking?"
                                            },
                                            {
                                                "example_id": "f19ff79c-b8bc-4d9e-9f17-d80532151dc6",
                                                "sense_id": "0b31da25-d56a-3193-82f9-2adfe3979884",
                                                "text": "The marriage was highly approved of by Mrs. Shelby, who, with a little womanly complacency in match-making, felt pleased to unite her handsome favorite with one of her own class who seemed in every way suited to her;"
                                            },
                                            {
                                                "example_id": "161a2251-f0d3-4451-924d-46964bad9078",
                                                "sense_id": "0b31da25-d56a-3193-82f9-2adfe3979884",
                                                "text": "I planned the match from that hour; and when such success has blessed me in this instance, dear papa, you cannot think that I shall leave off match-making."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf4e9b72-ab75-3780-a6d4-419c4d585b8f",
                                        "entry_id": "27af744c-1083-3a50-b1e7-f19e9be3b5fa",
                                        "glosses": [
                                            "A service aiming to bring together sellers and buyers or potential partners."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc46220a-4d99-4ce7-ac60-a91b76fcbd91",
                                                "sense_id": "bf4e9b72-ab75-3780-a6d4-419c4d585b8f",
                                                "text": "... there was evidence that they did provide information for day care matchmaking to the potential users and givers of care."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebe7aa5c-316a-346b-b3b0-8e7654f3a2b4",
                                        "entry_id": "27af744c-1083-3a50-b1e7-f19e9be3b5fa",
                                        "glosses": [
                                            "The act or process of locating suitable players to take part in a multiplayer game session."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8baff807-a524-403b-8fc2-1000b55491bd",
                                                "sense_id": "ebe7aa5c-316a-346b-b3b0-8e7654f3a2b4",
                                                "text": "It turns out, however, that there wasn't actually anything different going on behind the matchmaking scenes, because Bungie forgot to turn skill-based matchmaking on. I believe the kids call this \"getting caught in 4K.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "779696ce-90a1-30bf-b767-5ca96b4a6904",
                                        "entry_id": "27af744c-1083-3a50-b1e7-f19e9be3b5fa",
                                        "glosses": [
                                            "The manufacture of matches for kindling or burning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
