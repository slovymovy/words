                                        "entry_id": "944d9dcc-97c9-3f45-9104-bffdd02f1120",
                                        "glosses": [
                                            "An ostensory, or monstrance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1be0e1d-9969-48ca-8d34-9fdf9018f858",
                                                "sense_id": "0452253e-af4b-3b7e-8d70-104f6f0695fe",
                                                "text": "In the cemetery, the ostensorium, also known as a monstrance, will mark the grave of a member of the clergy. This medieval device is an altar vessel of the Eucharist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
