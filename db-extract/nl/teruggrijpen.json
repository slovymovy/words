                                "target_senses": [
                                    {
                                        "sense_id": "e861038c-b737-3bae-b2a7-966bd742bbaf",
                                        "entry_id": "99b6b888-6242-380e-bcdf-b67404d5440e",
                                        "glosses": [
                                            "Courir de nouveau."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c44e98c1-062c-4986-919f-e52d83e944df",
                                                "sense_id": "e861038c-b737-3bae-b2a7-966bd742bbaf",
                                                "text": "J’ai couru et recouru."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8310628b-b67b-3c73-96cd-0b022ac1cc36",
                                        "entry_id": "99b6b888-6242-380e-bcdf-b67404d5440e",
                                        "glosses": [
                                            "Demander du secours ; s’adresser à quelqu’un pour en obtenir quelque chose."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "202d50ff-3885-4b5b-8124-c3332be01686",
                                                "sense_id": "8310628b-b67b-3c73-96cd-0b022ac1cc36",
                                                "text": "Voyez-vous […] nous avons à Paris plusieurs catégories de malandrins. Pour nous en garantir, il nous faut recourir à des hommes présentant des qualités particulières. Ces hommes sont des mouchards, comme vous les appelez."
                                            },
                                            {
                                                "example_id": "b6312585-4764-4952-97f1-001d8d16a07f",
                                                "sense_id": "8310628b-b67b-3c73-96cd-0b022ac1cc36",
                                                "text": "Si les grains ont souffert de l’intempérie des saisons, il faudra recourir au criblage qui produit ordinairement un pour cent de déchet, lequel sera vendu au profit de la République."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fa28016-6451-388d-89ce-a2118bbfce09",
                                        "entry_id": "99b6b888-6242-380e-bcdf-b67404d5440e",
                                        "glosses": [
                                            "Se pourvoir."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48ca53f9-744b-4cef-8056-712910466121",
                                                "sense_id": "1fa28016-6451-388d-89ce-a2118bbfce09",
                                                "text": "Recourir en cassation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14dd3d34-b308-3353-adba-6ee8ac08e051",
                                        "entry_id": "99b6b888-6242-380e-bcdf-b67404d5440e",
                                        "glosses": [
                                            "User ; utiliser ; avoir recours ; en parlant des choses."
                                        ],
                                        "tags": [
