                },
                {
                    "sense_id": "e09388eb-54ba-3ec3-b2e1-0ceea1981f69",
                    "sense_definition": "oddać lub przekazać rzecz w odpowiednie miejsce w celu wykonania na niej określonej czynności",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "przekazywanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wczoraj <w>dałem</w> zimowy płaszcz do profesjonalnej pralni chemicznej.",
                            "target_lang_translations": {
