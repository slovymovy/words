                                        "sense_id": "f7a2384d-6806-37b5-a75c-fad293bd365e",
                                        "entry_id": "04cd053b-b96d-3129-8761-99ff124ef5b8",
                                        "glosses": [
                                            "Teilbereich der Völkerkunde, der sich damit befasst, die Merkmale der einzelnen Kulturen darzustellen/zu erfassen"
                                        ],
                                        "tags": [
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1a27c59-c0c8-4ff8-825c-1e294a3f5436",
                                                "sense_id": "f7a2384d-6806-37b5-a75c-fad293bd365e",
                                                "text": "„Die Ethnographie, die eine ihrer Aufgaben darin sieht, Einzelbeobachtungen zu Aussagen über »Völker« zu verallgemeinern, droht ständig ein Scheitern an der Komplexität ihres Gegenstandes.“"
                                            }
