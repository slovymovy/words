                        ],
                        "examples": [
                            {
                                "example_id": "77ec02b7-46c5-417d-831a-a84d95985c9a",
                                "sense_id": "9caf4eaf-e426-3d42-bba6-6d76b89b0ffa",
                                "text": "Die Weltbevölkerung benötigt durchschnittlich 1,7 Terawatt elektrische Leistung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
