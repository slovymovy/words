                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a2920191-3939-3c0d-a3f2-bafb48b6ee5f",
                                        "entry_id": "741e14c7-0599-35d9-b858-8d27cae5a7ea",
                                        "glosses": [
                                            "класс материалов, представляющий собой вспененные (ячеистые) пластические массы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "427079ff-2cd3-4e1e-9b02-b1d9fdb1d3e0",
                                                "sense_id": "a2920191-3939-3c0d-a3f2-bafb48b6ee5f",
                                                "text": "Если нет поролона, можно использовать пенопласт, который остаётся от упаковок."
                                            }
