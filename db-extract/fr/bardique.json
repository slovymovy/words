                                        "sense_id": "aec3e206-0234-310b-9493-714c8a6a1b71",
                                        "entry_id": "c072bfb2-7e86-3b33-ac76-19fc3f377078",
                                        "glosses": [
                                            "A bardic circle or competition: a gathering or contest at which stories, poems, and/or songs are recited."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "624886f0-67ae-4c9d-83c0-8bfce0171918",
                                                "sense_id": "aec3e206-0234-310b-9493-714c8a6a1b71",
                                                "text": "[...] especially at Samhain, Yule, and Oimelc/Imbolg/Brigantia, we'd gather everyone into the living room around the fireplace and present our ritual enactments, hold our bardics, play music, dance, etc.—all before the great altar."
                                            },
                                            {
