                            "metonymisch"
                        ],
                        "examples": [
                            {
                                "example_id": "ccc3681c-9002-428e-8ad1-181904bd95e0",
                                "sense_id": "7444b95e-73ad-36a6-b186-973a33456886",
                                "text": "Insmeren met zonnebrand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37287d15-8906-463a-9d4a-84a5f76c363c",
                        "source_entry_id": "772d6d5f-3b42-3c2a-849f-a13cb3521d4b",
                        "source_sense_id": "99e159f3-383f-33ac-970b-df7cc1b88fa1",
                        "source_sense_description": "de vaak pijnlijke gevolgen van een blootstelling van de huid aan een te grote dosis ultraviolet licht",
                        "target_lang_word": "Sonnenbrand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonnenbrand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f78879e-a293-3c6b-8901-b07465aaa11f",
                                        "entry_id": "8c6d2fce-a07c-3446-b59d-3f48ab13340b",
                                        "glosses": [
                                            "durch die Sonne verursachte Hautverbrennung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdf55df0-a2cb-4823-87a8-dd805b57d167",
                                                "sense_id": "4f78879e-a293-3c6b-8901-b07465aaa11f",
                                                "text": "„Eine schmale Frau mit Dauerwelle und Sonnenbrand im Gesicht springt auf.“"
                                            },
                                            {
                                                "example_id": "709733ea-d355-4d2d-9a1e-7cb10c307988",
                                                "sense_id": "4f78879e-a293-3c6b-8901-b07465aaa11f",
                                                "text": "Selbst das starke Sonnenschutzmittel hat wenig Vorbeugung gegen den Sonnenbrand erzielen können."
                                            },
                                            {
                                                "example_id": "95b30677-4889-4331-94ce-6128ca0ed865",
                                                "sense_id": "4f78879e-a293-3c6b-8901-b07465aaa11f",
                                                "text": "„Mittags mußte man im Schatten liegen, wenn man sich keinen Sonnenbrand holen wollte oder einen Hitzschlag oder einen Sonnenstich.“"
                                            },
                                            {
                                                "example_id": "74658d0d-bee3-430e-bb92-81aa0fee4c6a",
                                                "sense_id": "4f78879e-a293-3c6b-8901-b07465aaa11f",
                                                "text": "„Wir sehen ein Pferd im Sonnenbrand stehen; es ist am Widerrist durchgescheuert, und zahllose Fliegen sitzen in den tiefen Wunden.“"
                                            },
                                            {
                                                "example_id": "cac11e2f-2c50-4214-9cc1-6d606b04c146",
                                                "sense_id": "4f78879e-a293-3c6b-8901-b07465aaa11f",
                                                "text": "„Gewisse von Felsen durchsetzte Sandküsten in der Normandie haben diese Färbung, ein rostiges Rotbraun, ein wenig Sonnenbrand, auch im Winter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cfb283e-c0d5-4d77-a251-325367ea631a",
                        "source_entry_id": "772d6d5f-3b42-3c2a-849f-a13cb3521d4b",
                        "source_sense_id": "99e159f3-383f-33ac-970b-df7cc1b88fa1",
                        "source_sense_description": "de vaak pijnlijke gevolgen van een blootstelling van de huid aan een te grote dosis ultraviolet licht",
                        "target_lang_word": "sunburn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sunburn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97fc5f58-a7c5-37d7-a7be-c67675afd2b6",
                                        "entry_id": "5efd8497-1efe-3ee6-a9d9-7108178a5e5f",
                                        "glosses": [
                                            "A burn on the skin caused by excess exposure to the sun's rays."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c389fce-6d76-3312-8012-d4b69d896763",
                                        "entry_id": "5efd8497-1efe-3ee6-a9d9-7108178a5e5f",
                                        "glosses": [
                                            "A burn on the tissue of crop plants or their fruits (especially if they are rich in water like tomatoes, grapes, apples, gooseberries) caused by excess exposure to the sun's rays."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "937cf8df-edd5-3bda-801b-b6ea41e01f19",
                                        "entry_id": "5efd8497-1efe-3ee6-a9d9-7108178a5e5f",
                                        "glosses": [
                                            "Suntan."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04155b9e-a805-49bf-b256-c1c7cbda5457",
                                                "sense_id": "937cf8df-edd5-3bda-801b-b6ea41e01f19",
                                                "text": "The neutral colours showed off her café au lait sunburn."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sunburn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "434fc127-95b3-34d0-a40c-c0c25ebab69e",
                                        "entry_id": "8c4b9df1-caad-3da2-97a4-8d7e18fd3c1d",
                                        "glosses": [
                                            "To receive a sunburn."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e663efd-80b7-470d-bb3d-65226bbd7f45",
                                                "sense_id": "434fc127-95b3-34d0-a40c-c0c25ebab69e",
                                                "text": "c. 1613, John Webster, The Duchess of Malfi, London: D.N. and T.C., 1678, Act V, Scene 2, p. 64,\nI have brought\nYour grace a Salamanders skin, to keep you\nFrom sun-burning."
                                            },
                                            {
                                                "example_id": "0e0f2abb-533f-4a52-8eeb-498dc681a805",
                                                "sense_id": "434fc127-95b3-34d0-a40c-c0c25ebab69e",
                                                "text": "1724, Aaron Hill, The Plain Dealer, No. 81, 28 December, 1724, London: S. Richardson and A. Wilde, Volume 2, p. 199,\n[…] there is a Country, in the World, call’d Turkey; where Women are secur’d against the Danger of Sun-burning, by being kept out of the open Air, and lock’d up, like other Jewels, in Places where no Mischief can reach ’em."
                                            },
                                            {
                                                "example_id": "2f34a9bd-3b93-4e34-83c4-f755ea629012",
                                                "sense_id": "434fc127-95b3-34d0-a40c-c0c25ebab69e",
                                                "text": "All foliage is necessary in Texas to keep the tomato fruit from sunburning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7f3f9f6-8f9d-3035-bc92-6cf68e16fbf5",
                                        "entry_id": "8c4b9df1-caad-3da2-97a4-8d7e18fd3c1d",
                                        "glosses": [
                                            "To burn or tan (someone's skin) by the sun; to allow (a part of one's body) to become sunburnt."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dca3bbf-07e6-4520-ac4e-408c061c5d70",
                                                "sense_id": "f7f3f9f6-8f9d-3035-bc92-6cf68e16fbf5",
                                                "text": "My Aunt charg’d me not to pull off my Glove for fear of Sun-burning my hand."
                                            },
                                            {
                                                "example_id": "cf2683eb-3ba2-405b-a49d-2ed9a0ac5090",
                                                "sense_id": "f7f3f9f6-8f9d-3035-bc92-6cf68e16fbf5",
                                                "text": "As we crossed the Colorado-Utah border I saw God in the sky in the form of huge gold sunburning clouds above the desert […]"
                                            },
                                            {
                                                "example_id": "de7a8373-1b99-4d2d-bcca-2467399e3d89",
                                                "sense_id": "f7f3f9f6-8f9d-3035-bc92-6cf68e16fbf5",
                                                "text": "“Oh shoot, I’ve sunburned the top half of my boobs,” she said, frowning down her chest."
                                            },
                                            {
                                                "example_id": "f93d5a05-a186-4996-b835-cb617893415d",
                                                "sense_id": "f7f3f9f6-8f9d-3035-bc92-6cf68e16fbf5",
                                                "text": "If you are serious about protecting your eyes, look into wearing goggles or alpine glasses that protect the sides of the eyes as well as the direct path of light into them. I once hiked up Mary’s Glacier wearing only a hat. That night after the hike I couldn’t sleep. I had sunburnt my eyes. It felt like hot pokers were being stuffed into my head. I could not open my eyes for four days."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c42d107-9678-4997-ac2d-75b5d8bdbec9",
                        "source_entry_id": "772d6d5f-3b42-3c2a-849f-a13cb3521d4b",
                        "source_sense_id": "99e159f3-383f-33ac-970b-df7cc1b88fa1",
                        "source_sense_description": "de vaak pijnlijke gevolgen van een blootstelling van de huid aan een te grote dosis ultraviolet licht",
                        "target_lang_word": "coup de soleil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coup de soleil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88c80080-221b-3741-85e6-1f79f5ee89ad",
                                        "entry_id": "29d13fec-ea69-3096-bd8f-f661e29c373c",
                                        "glosses": [
                                            "Brûlure de la peau provoquée par une exposition plus ou moins longue au soleil."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1f05d48-f01a-4d1e-8bdc-23663db07de7",
                                                "sense_id": "88c80080-221b-3741-85e6-1f79f5ee89ad",
                                                "text": "Nous ne sommes pas restés très longtemps à la plage hier, nous ne voulions pas attraper de coup de soleil."
                                            },
                                            {
                                                "example_id": "b0e964cb-3ec3-4edd-a248-07c39e11fcd7",
                                                "sense_id": "88c80080-221b-3741-85e6-1f79f5ee89ad",
                                                "text": "Rougon mourut presque subitement, quinze mois après son mariage, d’un coup de soleil qu’il reçut, une après-midi, en sarclant un plant de carottes."
                                            },
                                            {
                                                "example_id": "aabab3ef-80b3-4e04-820c-0edb36dcf92b",
                                                "sense_id": "88c80080-221b-3741-85e6-1f79f5ee89ad",
                                                "text": "Bien entendu, au bout de quelques jours après l’arrivée à la mer, ils sont couverts de coups de soleil, gémissants, et prêts à jurer qu`ils prendront désormais mille précautions. Le coup de soleil, c'est le baptême d’Apollon. Crème de concombre, vaseline et jambières de toile. Au bout de douze heures, il n'en est plus question, et les plaisirs, désormais « vaccinés », de l'eau et du feu astral peuvent recommencer."
                                            },
                                            {
                                                "example_id": "c01f5789-c98a-4763-b0fd-e76d425883ca",
                                                "sense_id": "88c80080-221b-3741-85e6-1f79f5ee89ad",
                                                "text": "Duchotel.— Mais tu ne connais donc pas Cassagne ? C’est son coup de soleil… Tu ne sais donc pas qu’il a attrapé un coup de soleil en Afrique, et depuis, ça lui a enlevé la mémoire ?…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6ca5ca3-422e-32cc-bca0-f2da6dd29f7c",
                                        "entry_id": "29d13fec-ea69-3096-bd8f-f661e29c373c",
                                        "glosses": [
                                            "Fragmentation d’une roche par la chaleur du jour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3053dd0e-2bd0-471c-8dd1-8ce62c326e05",
                                                "sense_id": "e6ca5ca3-422e-32cc-bca0-f2da6dd29f7c",
                                                "text": "Le phénomène du « coup de soleil » peut provoquer des ruptures de grains des roches telles que le basalte très peu de temps après le mise en œuvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74f4c016-c9a1-3f90-94f5-5ff48090f45f",
                                        "entry_id": "29d13fec-ea69-3096-bd8f-f661e29c373c",
                                        "glosses": [
                                            "Dessèchement d’un tronc ou d’une branche exposé à la lumière directe du soleil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78df2bec-ad4f-4fce-a3d3-277593b6d6f3",
                                                "sense_id": "74f4c016-c9a1-3f90-94f5-5ff48090f45f",
                                                "text": "Le hêtre réagit bien aux éclaircies, même tardives. Il est peu sujet à la formation de gourmands. Il faut cependant maintenir un sous-étage pour éviter les coups de soleil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
