                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79977502-70cb-4a0a-b48d-64c7ae56ab91",
                                                "sense_id": "91eeda3e-96df-3782-b0a7-5848241f1364",
                                                "text": "Aids, such as a Zimmer frame, walking stick, or foot-drop splint may be needed at some point by many patients."
                                            },
                                            {
                                                "example_id": "541bee62-9574-4685-aaff-01ece3426a60",
                                                "sense_id": "91eeda3e-96df-3782-b0a7-5848241f1364",
                                                "text": "These are three- or four-legged frames, on wheels, which remind one of a modern-day Zimmer frame."
                                            }
