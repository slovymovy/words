                    "frequency": "Middle",
                    "semantic_group_id": "funeraire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans son testament, il a demandé que son <w>cercueil</w> reste fermé pendant son enterrement."
                        },
                        {
                            "text": "Les proches ont porté le <w>cercueil</w> jusqu'au lieu de repos avec beaucoup de recueillement."
                        }
                    ],
                    "synonyms": [
                        "bière",
                        "boîte",
                        "caisse",
                        "sapin"
                    ],
                    "common_phrases": [
