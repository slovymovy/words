                ],
                "senses": [
                    {
                        "sense_id": "63a6aa04-405b-39ad-8d16-16fc64eedc59",
                        "entry_id": "66339379-5e2f-3d6e-9803-72ce77eeb0fe",
                        "glosses": [
                            "junge Frau, Frau, Ehefrau in nordamerikanischen Ethnien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e3d3eb4-7291-4b33-809d-b0209fed2216",
                                "sense_id": "63a6aa04-405b-39ad-8d16-16fc64eedc59",
                                "text": "Eine Squaw schürte das Feuer, die andere kümmerte sich um das Fleisch."
                            },
                            {
                                "example_id": "6cf574d5-5479-4262-abcc-189e705b4f2c",
                                "sense_id": "63a6aa04-405b-39ad-8d16-16fc64eedc59",
                                "text": "„Er hätte in Chickamauga den Zug verlassen, sich in Tabakblätter und Kuhdung hüllen und sich eine Squaw nehmen sollen.“"
                            },
                            {
                                "example_id": "1f67763a-fcfa-46be-9563-94e22fe74f58",
                                "sense_id": "63a6aa04-405b-39ad-8d16-16fc64eedc59",
                                "text": "„Die Squaw, die die Decke webte, lehnte sich irgendwie vor, so dass man ihren Busen und so sehen konnte.“"
                            },
                            {
                                "example_id": "159001a4-8b5e-4692-9fe7-143ec03b20e4",
                                "sense_id": "63a6aa04-405b-39ad-8d16-16fc64eedc59",
                                "text": "„Weder irgendwelche Witze über sie noch alte Squaws können daran etwas ändern.“"
                            },
                            {
                                "example_id": "08eba1c3-729e-41a4-8a0d-ac7460f444ff",
                                "sense_id": "63a6aa04-405b-39ad-8d16-16fc64eedc59",
                                "text": "„Vor den offenen Hütten saßen einige Squaws mit ihren Töchtern, Welschkorn aushülsend, Hanf brechend oder Tabakspflanzen schichtend; die Kinder hingen an den Außenwänden auf einem langen hohlen trogartigen Brettchen oder einer Rinde ausgestreckt, ihre Hände und Füße mit Buffaloriemen an das hohle Brett geschnallt, mit keiner andern Bekleidung als einem Streifen Kaliko um die Hüften: die gewöhnliche Art dieser Indianer, ihre Kinder das ganze Leben hindurch in der aufrechten Stellung zu erhalten, die sie und ihre Besieger so sehr charakterisiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
