                                    },
                                    {
                                        "sense_id": "6aae906f-159c-399d-82e9-83888b84e02c",
                                        "entry_id": "0d054c60-2725-31c5-a42a-a591a4f6430c",
                                        "glosses": [
                                            "Verbindung aus Alaun, die als blutstillendes Mittel eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36a36b93-b5cc-4572-ab66-5f22a015bc67",
                                                "sense_id": "6aae906f-159c-399d-82e9-83888b84e02c",
                                                "text": "„Es bedeutet jene Erscheinung, die man beim Essen einer Quitte an den Lippen beobachten kann oder an einer Rasierwunde, wenn der Alaunstein darüberstreicht.“"
                                            },
                                            {
                                                "example_id": "1cf23c59-8a3c-482d-8974-02193d303cbc",
                                                "sense_id": "6aae906f-159c-399d-82e9-83888b84e02c",
                                                "text": "„Bei Blutungen soll man keinen Alaunstein, sondern Alaunwasser benutzen, weil das hygienischer ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
