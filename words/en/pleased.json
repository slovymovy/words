{
    "word_family": [
        "please",
        "pleasure",
        "pleasant",
        "displease",
        "displeasure"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "181ae457-0992-389d-86c9-25eca9e69a4e",
                    "sense_definition": "Feeling or showing pleasure and satisfaction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>pleased</w> to meet you at last.",
                            "target_lang_translations": {
                                "ru": "Я наконец-то <w>рад</w> встретиться с вами.",
                                "zh": "终于见到你，我感到很<w>高兴</w>。"
                            }
                        },
                        {
                            "text": "She was <w>pleased</w> with her good exam results.",
                            "target_lang_translations": {
                                "ru": "Она была <w>довольна</w> своими хорошими результатами экзаменов.",
                                "zh": "她对自己的优异考试成绩感到很<w>满意</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "happy",
                        "satisfied",
                        "content",
                        "glad"
                    ],
                    "antonyms": [
                        "displeased",
                        "unhappy"
                    ],
                    "common_phrases": [
                        "pleased to meet you",
                        "pleased with",
                        "pleased to hear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий или выражающий удовольствие и удовлетворение.",
                        "zh": "感到或表现出快乐和满足。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "довольный",
                                "target_lang_sense_clarification": "испытывающий удовлетворение"
                            },
                            {
                                "target_lang_word": "рад",
                                "target_lang_sense_clarification": "испытывающий радость (краткая форма)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高兴",
                                "target_lang_sense_clarification": "感到快乐或满意"
                            },
                            {
                                "target_lang_word": "满意",
                                "target_lang_sense_clarification": "对结果或现状感到满足"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "17738ecd-6d64-3b66-90f8-ec2895135963",
                    "sense_definition": "Simple past and past participle of <w>please</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unexpected gift <w>pleased</w> her greatly.",
                            "target_lang_translations": {
                                "ru": "Неожиданный подарок очень её <w>порадовал</w>.",
                                "zh": "那份意外的礼物极大地<w>取悦</w>了她。"
                            }
                        },
                        {
                            "text": "It <w>pleased</w> the committee to approve the plan.",
                            "target_lang_translations": {
                                "ru": "Комитету <w>было угодно</w> утвердить план.",
                                "zh": "委员会<w>乐于</w>批准这项计划。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола please.",
                        "zh": "使某人感到高兴或满足（please 的过去式和过去分词）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порадовал",
                                "target_lang_sense_clarification": "доставил радость"
                            },
                            {
                                "target_lang_word": "угодил",
                                "target_lang_sense_clarification": "сделал приятное, удовлетворил"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使……高兴",
                                "target_lang_sense_clarification": "让某人感到愉悦"
                            },
                            {
                                "target_lang_word": "令……满意",
                                "target_lang_sense_clarification": "符合某人的意愿"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}