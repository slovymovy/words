                "senses": [
                    {
                        "sense_id": "d06620ea-2a23-3644-86d7-2d6feebd0238",
                        "entry_id": "bc5ad12b-2b9f-322a-b906-bea0f8f0545c",
                        "glosses": [
                            "sehr große Firma in der Automobilbranche (manchmal mit mehreren Marken)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82dfb827-e5a6-4c87-a787-a0c4b4a5b8b0",
                                "sense_id": "d06620ea-2a23-3644-86d7-2d6feebd0238",
                                "text": "„Was war am 18. Nov. 2010? – Der US-amerikanische Autokonzern General Motors (GM) kehrt an die Börse zurück.“"
                            },
                            {
                                "example_id": "de86c724-a11d-4e4f-8d29-b6408d698e5b",
                                "sense_id": "d06620ea-2a23-3644-86d7-2d6feebd0238",
                                "text": "„Der deutsche Volkswagen-Konzern war mit einem Umsatz von 62,4 Milliarden Euro der umsatzstärkste Autokonzern der Welt.“"
                            },
                            {
                                "example_id": "47a8be83-cfdb-4bc1-b520-dc7b73a919d9",
                                "sense_id": "d06620ea-2a23-3644-86d7-2d6feebd0238",
                                "text": "„Was war am 7. Mai. 1998? – London: Daimler-Benz und Chrysler geben ihre Fusion zum drittgrößten Autokonzern der Welt bekannt.“"
                            },
                            {
                                "example_id": "104d170c-2baa-4594-a217-4a039f469947",
                                "sense_id": "d06620ea-2a23-3644-86d7-2d6feebd0238",
                                "text": "„Was war am 28. Jul. 2005? – DaimlerChrysler teilt nach einer Aufsichtsratssitzung mit, dass Vorstandschef Jürgen Schrempp den Autokonzern zum Jahresende verlässt.“"
                            },
                            {
                                "example_id": "cb804e57-ce96-4b85-bfd1-b1a0ca664c46",
                                "sense_id": "d06620ea-2a23-3644-86d7-2d6feebd0238",
                                "text": "„EU-Kommission erlaubt Fusion von Fiat Chrysler und PSA – Die geplant Megafusion zwischen dem Opel-Mutterkonzern PSA und FCA darf kommen. Mit ihr entsteht der viertgrößte Autokonzern der Welt.“"
                            },
                            {
                                "example_id": "449c7bf5-4ac8-46ea-b662-eabdc589fd41",
                                "sense_id": "d06620ea-2a23-3644-86d7-2d6feebd0238",
                                "text": "„Dieselskandal – […] Der Wolfsburger Autokonzern hat am Dienstag (Ortszeit) einen Antrag zur Überprüfung des Falls beim Obersten US-Gericht eingereicht.“"
                            },
                            {
                                "example_id": "1ed4b4f9-0af4-4260-b635-6b5444629f49",
                                "sense_id": "d06620ea-2a23-3644-86d7-2d6feebd0238",
                                "text": "„Europas größter Autokonzern Volkswagen baut in den kommenden Jahren mit Partnern ein Netz eigener Batteriezellfabriken auf.“"
                            },
                            {
                                "example_id": "fa659406-c33a-4d14-b62d-dbd0c18b5bb7",
                                "sense_id": "d06620ea-2a23-3644-86d7-2d6feebd0238",
                                "text": "„[…] der japanische Autokonzern Toyota hat seine Expansionspläne in Indien auf Eis gelegt […].“"
                            },
                            {
                                "example_id": "769e74bb-aa33-425a-850a-362446044206",
                                "sense_id": "d06620ea-2a23-3644-86d7-2d6feebd0238",
                                "text": "„Merkel ist in Brüssel als stählerne Lobbyistin der deutschen Autokonzerne aufgetreten und hat höhere CO2-Grenzwerte verhindert, die Profite von Porsche und BMW gesenkt hätten.“"
                            },
                            {
                                "example_id": "4466b570-548a-4afa-ab5b-98f8524e0f39",
                                "sense_id": "d06620ea-2a23-3644-86d7-2d6feebd0238",
                                "text": "„Bob Lutz: «Die Autokonzerne wissen, dass es vorbei ist» – Selbstfahrende Autos verändern alles. […] Die neue Art der Mobilität wird das Geschäftsmodell der etablierten Autokonzerne auf den Kopf stellen, sagt der ehemalige Auto-Top-Manager Bob Lutz (86) voraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
