            {
                "entry_id": "cd97dc10-bcfd-3b14-a5e2-7fa2b464a95d",
                "word": "Mélusine",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dab594de-7f2d-4dc1-9efe-bbfe1b03083d",
                        "entry_id": "cd97dc10-bcfd-3b14-a5e2-7fa2b464a95d",
                        "tags": [],
                        "form": "Merlusine"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "42a0cd1b-bdc6-3cab-b4e6-1ef0fdee6ff5",
                        "entry_id": "cd97dc10-bcfd-3b14-a5e2-7fa2b464a95d",
                        "glosses": [
                            "Fée ayant une queue de serpent quand elle se baigne, et à l’origine de la maison des Lusignan, d’après la tradition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beacb8c8-cb55-4986-9906-4f1430d3c0f3",
                                "sense_id": "42a0cd1b-bdc6-3cab-b4e6-1ef0fdee6ff5",
                                "text": "À Ligny, aussi, depuis le haut Moyen-Âge, Mélusine se baignait dans l’Ornain, les nuits de clair de lune."
                            },
                            {
                                "example_id": "bf947aa9-c797-4c1f-9050-2252c7c0fc6a",
                                "sense_id": "42a0cd1b-bdc6-3cab-b4e6-1ef0fdee6ff5",
                                "text": "Au vrai, nos vouivres et notre Mélusine sont « serpentes » et non femmes-poissons, encore qu’il y ait grande analogie."
                            },
                            {
                                "example_id": "5b2176b2-9360-4018-9dad-9b1a1eb01107",
                                "sense_id": "42a0cd1b-bdc6-3cab-b4e6-1ef0fdee6ff5",
                                "text": "Cette famille des Lusignan aurait été protégée par la fée Mélusine, d’où le surnom actuel du château."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
