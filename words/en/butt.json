                },
                {
                    "sense_id": "7e56bdc0-52db-3b30-a62d-6ea182a9679d",
                    "sense_definition": "The thicker or blunt end of a tool or weapon, especially the end of a firearm opposite to the firing mechanism.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier struck the door with the <w>butt</w> of his rifle to break it open.",
                            "target_lang_translations": {
                                "ru": "Солдат ударил в дверь <w>прикладом</w> винтовки, чтобы выломать ее.",
                                "es": "El soldado golpeó la puerta con la <w>culata</w> de su rifle para forzarla.",
                                "zh": "士兵用步枪的<w>枪托</w>撞击门，试图将其撞开。"
                            }
                        },
                        {
                            "text": "He held the pistol by the barrel and used the <w>butt</w> as a hammer.",
                            "target_lang_translations": {
                                "ru": "Он держал пистолет за ствол и использовал <w>рукоятку</w> как молоток.",
                                "es": "Sujetó la pistola por el cañón y usó el <w>mango</w> como martillo.",
                                "zh": "他握住手枪的枪管，把<w>枪柄</w>当锤子用。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rifle butt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утолщенный или тупой конец инструмента или оружия; приклад.",
                        "es": "El extremo más grueso o romo de una herramienta o arma, especialmente la parte de un arma de fuego opuesta al cañón.",
                        "zh": "工具或武器较粗或钝的一端，尤指枪托。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приклад",
                                "target_lang_sense_clarification": "у винтовки или ружья"
                            },
                            {
                                "target_lang_word": "рукоятка",
                                "target_lang_sense_clarification": "у пистолета"
                            },
