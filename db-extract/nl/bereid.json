                    {
                        "sense_id": "f464fefa-1cf9-38eb-953a-b5d59a60750a",
                        "entry_id": "b14f6766-8f39-37f7-b06f-14c52cdfcecc",
                        "glosses": [
                            "akkoord gaand, instemmend: bereid tot actie"
