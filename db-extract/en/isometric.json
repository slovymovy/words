                        "sense_id": "6d3c349d-5520-3174-8ff1-80d3cd5f8dbb",
                        "entry_id": "cf9e2bdb-0efb-317e-a45a-b9c65bdd4b8a",
                        "glosses": [
                            "Of or exhibiting equality in dimensions."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "523d29ff-c7a7-388a-890c-598d9161d4b6",
                        "entry_id": "cf9e2bdb-0efb-317e-a45a-b9c65bdd4b8a",
                        "glosses": [
                            "Being or relating to a geometric system of three equal axes lying at right angles to each other (especially in crystallography)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "57d054f1-bfd3-380a-a3a9-20a2c5abb404",
                        "entry_id": "cf9e2bdb-0efb-317e-a45a-b9c65bdd4b8a",
                        "glosses": [
                            "Of or involving muscular contraction against resistance in which the length of the muscle remains the same. See also: Wikipedia:isometric exercise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6308001-29da-4435-9e06-b10888f2a979",
                                "sense_id": "57d054f1-bfd3-380a-a3a9-20a2c5abb404",
                                "text": "One of the most effective isometric exercises for the deskbound is to sit up quite straight and tighten the large muscles of the buttocks, holding for a count of eight, then release."
                            },
                            {
                                "example_id": "46b86f08-f455-4642-91e9-3abef3e70bef",
                                "sense_id": "57d054f1-bfd3-380a-a3a9-20a2c5abb404",
                                "text": "Antonyms include tonic movements auxotonic and isotonic which are divided into concentric and eccentric."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd416188-8361-3727-8393-1edd859e7fde",
                        "entry_id": "cf9e2bdb-0efb-317e-a45a-b9c65bdd4b8a",
                        "glosses": [
                            "Taking place at constant volume because of being confined by rigid boundaries."
                        ],
                        "tags": [
                            "of a thermodynamic process"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0d969d7-3e33-4c48-b53e-4cf8c28cc713",
                        "source_entry_id": "cf9e2bdb-0efb-317e-a45a-b9c65bdd4b8a",
                        "source_sense_description": "exhibiting equality in dimensions",
                        "target_lang_word": "isometrisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isometrisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de1da8b1-bb54-3028-b617-43e82d5202e7",
                                        "entry_id": "de653724-7766-384a-b4cd-7fa2a0fd16a6",
                                        "glosses": [
                                            "von gleichbleibender Länge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "984a2e83-8670-48ee-bd36-c269378d5b1b",
                                                "sense_id": "de1da8b1-bb54-3028-b617-43e82d5202e7",
                                                "text": "Die isometrischen Übungen sind gut für den Muskelaufbau."
                                            },
                                            {
                                                "example_id": "11ec7fd5-3444-4310-9122-b51ccf49eaf3",
                                                "sense_id": "de1da8b1-bb54-3028-b617-43e82d5202e7",
                                                "text": "Die „Anspannung eines Muskels ohne Veränderung seiner Länge“ nennt man „isometrische Muskelkontraktion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "83d7ee4a-c992-3274-a90b-d4d461ee9a53",
                                        "entry_id": "de653724-7766-384a-b4cd-7fa2a0fd16a6",
                                        "glosses": [
                                            "von gleichbleibendem/gleichmäßigem Wachstum"
                                        ],
                                        "tags": [
                                            "Biologie (speziell Botanik)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62070a41-6840-40b5-9196-760f86992229",
                                                "sense_id": "83d7ee4a-c992-3274-a90b-d4d461ee9a53",
                                                "text": "Die Pflanze wächst isometrisch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1366864d-fa6c-31ec-8899-0ace895a12fe",
                                        "entry_id": "de653724-7766-384a-b4cd-7fa2a0fd16a6",
                                        "glosses": [
                                            "Abstände erhaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b88aa4c3-b561-4f40-936f-cc555e37284c",
                                                "sense_id": "1366864d-fa6c-31ec-8899-0ace895a12fe",
                                                "text": "„Zwei metrische Räume M₁ und M₂ heißen isometrisch, wenn es eine bijektive Abbildung",
                                                "translation": "ist für alle x₁, x₂, die Element von M₁ sind.“"
                                            },
                                            {
                                                "example_id": "46c34d88-def3-48d0-8e05-961d6c7d542b",
                                                "sense_id": "1366864d-fa6c-31ec-8899-0ace895a12fe",
                                                "text": "Jede orthogonale Abbildung ist also insbesondere isometrisch."
                                            },
                                            {
                                                "example_id": "ed32dc41-1ecb-4852-868b-b270d028f594",
                                                "sense_id": "1366864d-fa6c-31ec-8899-0ace895a12fe",
                                                "text": "Ist eine isometrische Abbildung zusätzlich auch noch surjektiv, insgesamt also bijektiv, so ist ihre Umkehrung f: X – X offenbar auch isometrisch, und die Abbildung heißt eine Isometrie zwischen X und X."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
