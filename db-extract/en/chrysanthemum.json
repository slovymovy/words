                                        "sense_id": "b4facaed-19e3-38ef-9805-c3a51a0c3643",
                                        "entry_id": "3a4b0dbc-9c7a-349b-a78a-e27a4d9ce2d6",
                                        "glosses": [
                                            "цветок такого растения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
