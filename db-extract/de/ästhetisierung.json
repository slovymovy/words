                "senses": [
                    {
                        "sense_id": "10da47bf-510b-3f9d-8601-3f454d73644d",
                        "entry_id": "af156754-26d3-3fe8-8deb-8ea29238146c",
                        "glosses": [
                            "Darstellung von etwas als ästhetisches Objekt (harmonisch und schön oder hässlich); das Reduzieren von etwas auf das (gefällige) Äußere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2afe592-4125-439c-9dd6-0f02f34da374",
                                "sense_id": "10da47bf-510b-3f9d-8601-3f454d73644d",
                                "text": "„Auf welche Weisen sich diese Ansprüche einer Ästhetisierung der Politik und einer Politisierung der Kunst entwickelten, rekonstruiert dieses Buch anhand zahlreicher Beispiele im Längsschnitt durch die 1920er und 1930er Jahre.“"
                            },
                            {
                                "example_id": "e03e3011-d867-4621-a956-b487a5c71078",
                                "sense_id": "10da47bf-510b-3f9d-8601-3f454d73644d",
                                "text": "„Im Zuge einer Ästhetisierung von Praktiken, Gegenständen und Denkformen scheint inzwischen alles irgendwie mit Kreativem und Künstlerischem verbunden.“"
                            },
                            {
                                "example_id": "ebcd175b-722b-43ae-9073-ef94f1b22b71",
                                "sense_id": "10da47bf-510b-3f9d-8601-3f454d73644d",
                                "text": "„Heute erleben wir in der universalen Ästhetisierung des Alltags die falsche Realisierung dieses Programms.“"
                            },
                            {
                                "example_id": "cc4ada27-dac2-4ae1-9fca-b8f79da41504",
                                "sense_id": "10da47bf-510b-3f9d-8601-3f454d73644d",
                                "text": "„Die Ästhetisierung der Werbung und die Warenästhetik gehören zu den früh auch textlinguistisch beachteten Phänomenen.“"
                            },
                            {
                                "example_id": "8acab6be-ae99-45fb-9d1f-2df790110dc0",
                                "sense_id": "10da47bf-510b-3f9d-8601-3f454d73644d",
                                "text": "„Die äußere Ästhetisierung des Leiblichen darf also nicht bloß anästhetische Maskerade sein, sondern sie ist Ausdruck der inneren Person.“"
                            },
                            {
                                "example_id": "10138959-f7c1-4593-a1f2-3d938b4e76e2",
                                "sense_id": "10da47bf-510b-3f9d-8601-3f454d73644d",
                                "text": "„Das Metier Mode ist so anziehend, weil es durch die Medien ein Maximum an Ästhetisierung und Identifizierung für junge Leute mit sich gebracht hat.“"
                            },
                            {
                                "example_id": "66386609-e6d5-4c74-9c5f-44d73793c0a6",
                                "sense_id": "10da47bf-510b-3f9d-8601-3f454d73644d",
                                "text": "„Das Kunstmuseum als religiöser Ort Religion begegnet dem modernen Menschen als ein Prozess zunehmender Ästhetisierung.“"
                            },
                            {
                                "example_id": "cb89ce56-2e34-4075-82cb-344181b8ad04",
                                "sense_id": "10da47bf-510b-3f9d-8601-3f454d73644d",
                                "text": "„Mit der Ästhetisierung ist in erster Linie, das Einbringen von Spielelementen in den Arbeitsprozess gemeint.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
