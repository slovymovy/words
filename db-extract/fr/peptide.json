                    {
                        "translation_id": "77f4ce8b-bd93-4de4-bc05-248838744213",
                        "source_entry_id": "03fa3333-b838-3230-839e-a859f15172c5",
                        "source_sense_id": "84f4deb4-e277-3a7e-9eb4-5f724f445cff",
