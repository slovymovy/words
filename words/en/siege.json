{
    "word_family": [
        "besieger"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c328c2d0-a3bc-3d81-a5df-5b513c9fdb26",
                    "sense_definition": "A military operation in which an army surrounds a town, building, or fortress to cut off supplies and compel surrender.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army laid <w>siege</w> to the enemy city for several months. ",
                            "target_lang_translations": {
                                "tr": "Ordu, düşman şehrini birkaç ay boyunca <w>kuşattı</w>."
                            }
                        },
                        {
                            "text": "During the <w>siege</w>, essential supplies were rationed among the residents.",
                            "target_lang_translations": {
                                "tr": "<w>Kuşatma</w> sırasında, temel ihtiyaç maddeleri mahalle sakinleri arasında karneye bağlandı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lay siege to",
                        "under siege",
                        "state of siege"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir ordunun, ikmal yollarını kesmek ve teslim olmaya zorlamak amacıyla bir şehri, binayı veya kaleyi kuşattığı askeri harekat."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kuşatma",
                                "target_lang_sense_clarification": "askeri abluka veya çevreleme"
                            },
                            {
                                "target_lang_word": "muhasara",
                                "target_lang_sense_clarification": "kuşatma (eski/resmi kullanım)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a74c70b3-1cf9-3fed-a577-6059f35a88e5",
                    "sense_definition": "A prolonged period of difficulty, illness, or persistent distress.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She faced a painful <w>siege</w> of illness that kept her away from work all winter.",
                            "target_lang_translations": {
                                "tr": "Tüm kış onu işinden alıkoyan ağrılı bir hastalık <w>dönemiyle</w> karşı karşıya kaldı."
                            }
                        },
                        {
                            "text": "The small business managed to survive a <w>siege</w> of financial trouble.",
                            "target_lang_translations": {
                                "tr": "Küçük işletme, finansal sıkıntıların getirdiği zorlu <w>süreci</w> atlatmayı başardı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Uzun süren bir zorluk, hastalık veya kalıcı sıkıntı dönemi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "zorlu dönem",
                                "target_lang_sense_clarification": "sürekli sıkıntı veya hastalık süreci"
                            },
                            {
                                "target_lang_word": "kuşatma",
                                "target_lang_sense_clarification": "mecazi anlamda, baskı altında olma"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "176827f4-9a10-367f-b243-eba1034b7ee8",
                    "sense_definition": "A seat, especially an official seat or throne used by someone of authority.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king sat upon his royal <w>siege</w> to address the nobles.",
                            "target_lang_translations": {
                                "tr": "Kral, soylulara hitap etmek için krallık <w>tahtına</w> oturdu."
                            }
                        },
                        {
                            "text": "Ancient stories describe knights occupying their designated <w>siege</w> at the table.",
                            "target_lang_translations": {
                                "tr": "Kadim hikayeler, şövalyelerin masadaki kendilerine ayrılmış <w>koltuklara</w> oturduğunu anlatır."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used historically"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle yetkili biri tarafından kullanılan resmi bir koltuk veya taht."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "taht",
                                "target_lang_sense_clarification": "eski dilde resmi makam koltuğu"
                            },
                            {
                                "target_lang_word": "makam koltuğu",
                                "target_lang_sense_clarification": "yetkili kimsenin oturduğu yer"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "80d0f81d-0ea8-3de6-8e70-27bbaaf652ee",
                    "sense_definition": "To surround a city or fortress with armed forces in order to capture it.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forces moved to <w>siege</w> the castle after cutting off supply lines.",
                            "target_lang_translations": {
                                "tr": "Birlikler, ikmal hatlarını kestikten sonra kaleyi <w>kuşatmak</w> için harekete geçti."
                            }
                        },
                        {
                            "text": "They attempted to <w>siege</w> the stronghold during the harsh winter.",
                            "target_lang_translations": {
                                "tr": "Çetin kış şartlarında kaleyi <w>kuşatmaya</w> çalıştılar."
                            }
                        }
                    ],
                    "synonyms": [
                        "besiege"
                    ],
                    "target_lang_definitions": {
                        "tr": "Ele geçirmek amacıyla bir şehri veya kaleyi silahlı kuvvetlerle çevrelemek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kuşatmak",
                                "target_lang_sense_clarification": "askeri olarak etrafını çevirmek"
                            },
                            {
                                "target_lang_word": "muhasara etmek",
                                "target_lang_sense_clarification": "çevreleyip baskı altına almak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}