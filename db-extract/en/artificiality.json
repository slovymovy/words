                    },
                    {
                        "translation_id": "dcc36b39-e4aa-4c03-840a-4b4e1e957858",
                        "source_entry_id": "62809bf7-68d2-376a-ad48-08e838fac86c",
                        "source_sense_description": "The quality of being artificial",
                        "target_lang_word": "Geschraubtheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschraubtheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e04aa22e-f779-3f76-ae11-76c1110d38fd",
                                        "entry_id": "9fded775-2eda-3e5b-8243-b2831dd2d0c0",
                                        "glosses": [
                                            "geschraubte, gezierte, gekünstelte Art und Weise"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db58bcd8-4c0b-4e70-b657-3243e0a4c98a",
                                                "sense_id": "e04aa22e-f779-3f76-ae11-76c1110d38fd",
                                                "text": "„Mit der tuntigen Geschraubtheit seiner Sprache, dem abgespreizten kleinen Fingerchen, blinkenden Goldzähnen, Rüschchen-Hemden und den Kajalbalken unter den Augen wirkt sein Pirat wie eine Mischung aus barockem Lebemann und abgehalftertem Rock ’n’ Roller.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c08b64a-882b-3f57-bc71-c6f8fc28a811",
                                        "entry_id": "9fded775-2eda-3e5b-8243-b2831dd2d0c0",
                                        "glosses": [
                                            "Handlung oder Äußerung, die geschraubt oder gekünstelt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e288a20-b608-48bb-a36b-8618910e78f7",
                                                "sense_id": "7c08b64a-882b-3f57-bc71-c6f8fc28a811",
                                                "text": "„Fast beständig gleicht er einem Zerrbilde, voll von Wortspielen, Geschraubtheiten, und frechen, nichtsachtenden Humors, aber allenthalben voll Witz und der grausamsten Bitterkeiten gegen alle Stände und Zustände der Gesellschaft.“"
                                            },
                                            {
                                                "example_id": "699ed5ec-afe2-4e7c-8bec-855bc1bf7135",
                                                "sense_id": "7c08b64a-882b-3f57-bc71-c6f8fc28a811",
                                                "text": "„Und im Schatten von Zypressen und Pinien, in einem „Zustand des ausgestreckten Halbschlafs, im absichtslosen Dösen und Dämmern“ verschmelzen Innen- und Außenwelt, ein Erlebnis, das die Sprache nicht nachvollziehen kann und zwangsläufig in Geschraubtheiten und Platitüden enden muß: …“"
                                            },
                                            {
                                                "example_id": "bc3cc4ee-0bc7-4f8e-b197-3d3bed65fa0d",
                                                "sense_id": "7c08b64a-882b-3f57-bc71-c6f8fc28a811",
                                                "text": "„Hören Sie, Garzón, kommen Sie mir nicht mit irgendeinem Mist von wegen der Bahn, ich bin Ihre Chefin, also lassen sie die Geschraubtheiten, und verhalten sie sich natürlich!“"
                                            },
                                            {
                                                "example_id": "5f4c1eb5-f74d-448d-b78e-5002fff89f87",
                                                "sense_id": "7c08b64a-882b-3f57-bc71-c6f8fc28a811",
                                                "text": "„Dies war die Partei der Gebildeten (Cultos), oder diejenigen Schriftsteller, welche für sich eine besonders zierlich und gebildete Schreibart beanspruchten, und die, indem sie versuchten, ihre Ansprüche zu rechtfertigen, sich in die lächerlichsten Ausschweifungen, Geschraubtheiten und Gelehrtthuereien verirrten.“"
                                            },
                                            {
                                                "example_id": "f4fb80ce-4c68-4874-94b0-04034bd81497",
                                                "sense_id": "7c08b64a-882b-3f57-bc71-c6f8fc28a811",
                                                "text": "„Er ist ein Opfer der modischen Geschraubtheiten unsrer Zeit, die Dinge will oder wenigstens wollte, die man nicht wollen soll, oder die nur immer der soll, der innerlich darauf eingerichtet ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
