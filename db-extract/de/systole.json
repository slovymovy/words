                ],
                "senses": [
                    {
                        "sense_id": "201bb310-789a-3889-b65b-b5bc204e387c",
                        "entry_id": "19944b59-ebb8-34c1-b83d-beced62b78f5",
                        "glosses": [
                            "Phase, in der sich der Herzmuskel zusammenzieht (kontrahiert) und damit das Blut ausströmt"
                        ],
                        "tags": [
                            "Physiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "a98e6e4d-acbe-4b19-b178-86b5a2f13dd5",
                                "sense_id": "201bb310-789a-3889-b65b-b5bc204e387c",
                                "text": "„Jede Systole beginnt damit, dass die Herzmuskelzellen der gefüllten Ventrikel in einer bestimmten Reihenfolge durch einen elektrischen Impuls erregt werden.“"
                            },
                            {
                                "example_id": "e295bbed-3beb-422e-81cd-a397bfe26652",
                                "sense_id": "201bb310-789a-3889-b65b-b5bc204e387c",
                                "text": "„Das Herz arbeitet im rhythmischen Wechsel zwischen Erschlaffung (Diastole) und Anspannung (Systole) und hält damit den Blutstrom im kleinen und großen Kreislauf aufrecht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "385a7329-e5ff-3cfc-b99f-7bb0d1c61e3e",
                        "entry_id": "19944b59-ebb8-34c1-b83d-beced62b78f5",
                        "glosses": [
                            "vom Versmaß erzwungene Kürzung eines langen Vokals oder Diphthongs"
                        ],
                        "tags": [
                            "antike Verslehre"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "142439db-3489-49c0-8942-3c19db32c1bb",
                        "source_entry_id": "19944b59-ebb8-34c1-b83d-beced62b78f5",
                        "source_sense_id": "201bb310-789a-3889-b65b-b5bc204e387c",
                        "target_lang_word": "systole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "systole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60fce927-de52-3192-acc5-86de4613bdf4",
                                        "entry_id": "e7478ee3-c728-36f9-9182-560440f75393",
                                        "glosses": [
                                            "The rhythmic contraction of the heart, by which blood is driven through the arteries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eeef3aa-ed48-467b-9d1e-c5787d0a474f",
                                                "sense_id": "60fce927-de52-3192-acc5-86de4613bdf4",
                                                "text": "[…] I did almoſt beleeve, that the motion of the Heart vvas knovvn to God alone: For neither could I rightly diſtinguiſh, vvhich vvay the Diaſtole and Systole came to be, nor vvhen nor vvhere the dilation and conſtriction had its exiſtence."
                                            },
                                            {
                                                "example_id": "b9e6269d-8be5-4e9f-a6f9-7a6632596213",
                                                "sense_id": "60fce927-de52-3192-acc5-86de4613bdf4",
                                                "text": "A double systole catapulted him into full consciousness again, and he promised his uncorrected self that he would limit his daily ration of cigarettes to a couple of heartbeats."
                                            },
                                            {
                                                "example_id": "7bc5c6f2-2b2e-406a-96d5-169efc66e4f9",
                                                "sense_id": "60fce927-de52-3192-acc5-86de4613bdf4",
                                                "text": "There is no essential virtue in comfort. To be relaxed is good if it is part of a process of systole and diastole. Relaxation comes between phases of tenseness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eacbc3a7-6b17-3607-abb7-5ab7dd9a7659",
                                        "entry_id": "e7478ee3-c728-36f9-9182-560440f75393",
                                        "glosses": [
                                            "A shortening of a naturally long vowel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f533035-a1c4-3524-996d-6617b80d576b",
                                        "entry_id": "e7478ee3-c728-36f9-9182-560440f75393",
                                        "glosses": [
                                            "The shortest noncontractible loop on a compact metric space."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f28edaac-7bb3-3bf9-b305-427c6c26ebf8",
                                        "entry_id": "e7478ee3-c728-36f9-9182-560440f75393",
                                        "glosses": [
                                            "The contraction of the contractile vesicles in certain algae, plasmodia, and zoospores."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
