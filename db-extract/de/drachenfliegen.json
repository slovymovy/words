                ],
                "senses": [
                    {
                        "sense_id": "ffa9c06e-eb1c-3a95-b7c5-1bd729283dfb",
                        "entry_id": "19811d31-29ac-3399-9765-72d29f3ddea1",
                        "glosses": [
                            "Luftsportart mit einem Hängegleiter sowie das Betätigen in diesem Sport"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b865c29-0cf9-45e0-a623-a0162ed3521a",
                                "sense_id": "ffa9c06e-eb1c-3a95-b7c5-1bd729283dfb",
                                "text": "„So entziehen sich ausgereifte Sports wie das Bungeespringen, Reiten, Tauchen oder Drachenfliegen dieser Subsumierung als Risikosport, sobald objektivierende Beweisforderungen und wissenschaftliche Maßstäbe an die Zuordnung gelegt werden.“"
                            },
                            {
                                "example_id": "0dd83287-0bdc-442a-9e52-dd2211da486b",
                                "sense_id": "ffa9c06e-eb1c-3a95-b7c5-1bd729283dfb",
                                "text": "„Die goldene Regel des Drachenfliegens heißt, möglichst viel Umsicht walten lassen.“"
                            },
                            {
                                "example_id": "44f5ab7c-d1be-4e0e-901c-435b72cfa695",
                                "sense_id": "ffa9c06e-eb1c-3a95-b7c5-1bd729283dfb",
                                "text": "„Drachenfliegen ist heute mindestens ebenso sicher wie Segelfliegen – dank enormer technischer Entwicklungen.“"
                            },
                            {
                                "example_id": "8c06a72b-7711-4057-9367-068265145206",
                                "sense_id": "ffa9c06e-eb1c-3a95-b7c5-1bd729283dfb",
                                "text": "„Das Bundesarbeitsgericht hat sogar das Drachenfliegen als nicht besonders gefährlich angesehen.“"
                            },
                            {
                                "example_id": "e36f54f0-d931-4b19-86b6-7bc1a3e2b08e",
                                "sense_id": "ffa9c06e-eb1c-3a95-b7c5-1bd729283dfb",
                                "text": "„Neben Beschränkungen der Sportarten selbst beispielweise war das im Westen, aber auch in Polen und der Tschechoslowakei sehr populäre Drachenfliegen in der DDR verboten, wurden manche der stadtnahen Flugplätze wie Saarmund und Eggersdorf willkürlich wegen Fluchtgefahr geschlossen.“"
                            },
                            {
                                "example_id": "d9676468-221e-4e7e-9b6a-42ad6ff36b41",
                                "sense_id": "ffa9c06e-eb1c-3a95-b7c5-1bd729283dfb",
                                "text": "„Drachenfliegen ist eine anspruchsvolle, dynamische Flugsportart. Sie erfordert überdurchschnittlich gute körperliche Fitness und regelmäßiges Training.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
