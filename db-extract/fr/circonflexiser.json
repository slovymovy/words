                    {
                        "sense_id": "461f664c-216e-3d2d-b7ee-c2e7c61a8f2c",
                        "entry_id": "e324ba29-cebb-307e-a62e-570f51216939",
                        "glosses": [
                            "Utiliser un accent circonflexe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e0de2ee-6eee-4e1e-a3ab-aeb7f6ea34c4",
                                "sense_id": "461f664c-216e-3d2d-b7ee-c2e7c61a8f2c",
                                "text": "[…] et l’on ne peut pas en vouloir à un homme, même enseignant, de circonflexiser à tort quand le sommet de l’État s’exprime aussi mal qu’aujourd’hui."
                            }
                        ]
                    },
                    {
                        "sense_id": "59729d4e-d426-3079-b856-f3bd953047b4",
                        "entry_id": "e324ba29-cebb-307e-a62e-570f51216939",
                        "glosses": [
                            "Donner à ses sourcils la forme d’un accent circonflexe."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c610213d-d0bf-41d3-9aa4-36a80498f72c",
                                "sense_id": "59729d4e-d426-3079-b856-f3bd953047b4",
                                "text": "Alors, je boude, je circonflexise, je croise les bras et j’écris plus de post jusqu'à ce que vous répondiez."
                            }
                        ]
                    },
                    {
                        "sense_id": "906933e0-95a4-3909-8fa1-2ae8160b68ca",
