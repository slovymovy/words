                        "examples": [
                            {
                                "example_id": "b648f5b4-19d0-4d81-9331-94aa62dc35ee",
                                "sense_id": "e427305d-1309-3a0b-ad8a-d7745cdea94f",
                                "text": "Sprechen Sie Gujarati?"
                            },
                            {
                                "example_id": "5dd45a93-6a1c-4c1f-8b5d-62f82f056e76",
                                "sense_id": "e427305d-1309-3a0b-ad8a-d7745cdea94f",
                                "text": "Wie heißt das auf Gujarati?"
                            },
                            {
                                "example_id": "58b971ea-36e8-4f9a-9fcd-ba4b431e5ac9",
                                "sense_id": "e427305d-1309-3a0b-ad8a-d7745cdea94f",
                                "text": "Wie kann ich mein Gujarati verbessern?"
                            },
                            {
                                "example_id": "aba81292-4486-4c22-be2d-51dfb210a791",
                                "sense_id": "e427305d-1309-3a0b-ad8a-d7745cdea94f",
                                "text": "Das Gujarati ist mit dem Hindi verwandt."
                            },
                            {
                                "example_id": "f2d508cb-bd55-4e16-9921-e76e612dc5c5",
                                "sense_id": "e427305d-1309-3a0b-ad8a-d7745cdea94f",
                                "text": "„Das Programm dieses Kanals drehte sich hauptsächlich um Kochsendungen, so viel hatte Sunny immerhin herausgefunden, obwohl ausschließlich Gujarati gesprochen wurde.“"
                            },
                            {
                                "example_id": "43003e71-1afc-45ab-bd0b-726c1960b3e0",
                                "sense_id": "e427305d-1309-3a0b-ad8a-d7745cdea94f",
                                "text": "„Er bat ihn, Gujarati zu sprechen, da doch er und alle anderen Anwesenden Gujaratis seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
