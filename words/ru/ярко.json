                                "target_lang_sense_clarification": "lleno de luz"
                            },
                            {
                                "target_lang_word": "vivo",
                                "target_lang_sense_clarification": "nítido o intenso (ej. recuerdos)"
                            }
                        ],
                        "fr": [
