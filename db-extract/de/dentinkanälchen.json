                "senses": [
                    {
                        "sense_id": "3404e11c-41af-37b9-81ac-0ef4163e0da5",
                        "entry_id": "dc0f9db3-ca4f-336e-bacf-f6765a1c78c5",
                        "glosses": [
                            "ca. 1–2 µm große Hohlräume, die das Dentin des Zahns eines Säugetiers oder Menschen von außen nach innen durchziehen in dem Fortsätze der Odontoblasten (Dentinbildungszellen) sowie marklose Nervenfasern verlaufen"
                        ],
                        "tags": [
                            "Zahnmedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "4f601b51-ae64-426c-8a49-7205e5f93d56",
                                "sense_id": "3404e11c-41af-37b9-81ac-0ef4163e0da5",
                                "text": "In den Dentinkanälchen befindet sich der Dentinliquor."
                            },
                            {
                                "example_id": "661feb15-926b-459d-ab21-be7226080b88",
                                "sense_id": "3404e11c-41af-37b9-81ac-0ef4163e0da5",
                                "text": "Nicht biokompatible Füllungsbestandteile können via Dentinkanälchen zu einer Pulpitis führen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
