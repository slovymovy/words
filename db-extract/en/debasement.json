                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06249bc3-d2e1-4c8a-8205-e12ab72ea90b",
                                "sense_id": "37bf155e-c889-3244-be74-76b20400fb3d",
                                "text": "Severus' currency debasement was the largest since the reign of Nero.",
                                "translation": "De muntontwaarding van keizer Severus was de grootste sinds het bewind van Nero."
                            }
                        ]
                    },
                    {
                        "sense_id": "b246bf53-0de0-327a-8011-a122811f1dfb",
                        "entry_id": "5a242ee2-43e8-34eb-bdc3-9bae2090e52c",
                        "glosses": [
                            "overdrachtelijk afwaardering, een verlaging van standaard of aanzien van een persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4889099d-74c6-4d2f-812c-d5e3818a4d0d",
                                "sense_id": "b246bf53-0de0-327a-8011-a122811f1dfb",
                                "text": "Seeing in Alexa the value which Aubyn, through his debasement of her love, has produced for him, Glennard again laments his inadequacy.",
                                "translation": "Omdat hij in Alexa de waarde zag die Aubyn, door de afwaardering van haar liefde, voor hem had voortgebracht, beklaagde Glennard opnieuw zijn eigen ontoereikendheid."
                            }
                        ]
                    }
