                "senses": [
                    {
                        "sense_id": "b4754cc8-11e7-3c2c-a6db-bc100b83aa89",
                        "entry_id": "66abd5a0-8eb8-39b5-b7f5-c7f5669feab8",
                        "glosses": [
                            "Eigenschaft eines Musikstücks, mit Stimmen in mehreren Tonarten (Tonalität) komponiert zu sein"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "df2e3b35-ba84-4b68-a625-cac00d34bfa5",
                                "sense_id": "b4754cc8-11e7-3c2c-a6db-bc100b83aa89",
                                "text": "„Resultat ist keine durchhörbare Polytonalität, bei welcher die unterschiedlichen Schichten wahrgenommen werden können, sondern ein ‚wüstes‘ Zusammenklingen, eine Kakophonie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cfc9e680-95a6-35ac-93b7-b2c405968146",
                        "entry_id": "66abd5a0-8eb8-39b5-b7f5-c7f5669feab8",
                        "glosses": [
                            "Passage eines Musikstücks, in der mehrere Tonarten verwendet werden"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "ffee9853-5b15-4e1b-ab7b-042fbdc3b5c8",
                                "sense_id": "cfc9e680-95a6-35ac-93b7-b2c405968146",
                                "text": "„In den USA mixte indessen Charles Ives (1874–1954) komplexe Harmonien, Polyrhythmen und Polytonalitäten mit alten amerikanischen Hymnen und Volksmusik, wodurch er schließlich den Pulitzerpreis für Musik gewann.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
