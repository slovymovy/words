                "forms": [
                    {
                        "form_id": "aaa53550-a250-43cc-9cec-9db1405083c6",
                        "entry_id": "6925bb2b-cf35-3b25-966c-7649975649e7",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "retournables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3cb3b09f-7092-34a1-86ef-91725512f3a6",
                        "entry_id": "6925bb2b-cf35-3b25-966c-7649975649e7",
                        "glosses": [
                            "Qui peut être retourné."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0d6c94a8-d10d-3b14-b1fe-9281d16fe7d0",
                        "entry_id": "6925bb2b-cf35-3b25-966c-7649975649e7",
                        "glosses": [
                            "Qualifie une pièce de tissu d'un vêtement que l'on peut découdre et recoudre dans l'autre sens lorsqu'il est usé."
                        ],
                        "tags": [
                            "colloquial",
                            "dated",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "83efff12-9bb6-4493-8ee4-36bed5170834",
                                "sense_id": "0d6c94a8-d10d-3b14-b1fe-9281d16fe7d0",
                                "text": "Dans les années 1960, le col retournable était un gros argument pour vendre une chemise."
                            }
                        ]
                    },
                    {
                        "sense_id": "79447cdc-2407-3d20-998b-0784d221127d",
                        "entry_id": "6925bb2b-cf35-3b25-966c-7649975649e7",
                        "glosses": [
                            "Que l'on doit réexpédier."
                        ],
                        "tags": [
                            "dated",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "8409c426-2daa-4fe8-b6bb-56feb4257838",
                                "sense_id": "79447cdc-2407-3d20-998b-0784d221127d",
                                "text": "De plus en plus, l'emballage non retournable fait de nouveaux adeptes et l'on s'oriente de plus en plus vers un emballage standard, de dimensions et de poids constants."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ed19a66-4676-3385-a326-dde3952c0cfe",
                        "entry_id": "6925bb2b-cf35-3b25-966c-7649975649e7",
                        "glosses": [
                            "Qualifie une terre arable, un sol que l'on peut labourer."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "3569bf77-b67c-4e38-bb20-9191d8b16c26",
                                "sense_id": "6ed19a66-4676-3385-a326-dde3952c0cfe",
                                "text": "Il s'agit de prairies naturelles non retournables, mises en valeur par la fauche ou la pâture."
                            }
                        ]
                    },
                    {
                        "sense_id": "dda0a6b5-5181-3af0-9d35-1ba7032be315",
                        "entry_id": "6925bb2b-cf35-3b25-966c-7649975649e7",
                        "glosses": [
                            "Dont on peut retourner l'argument, en parlant d'un débat, d'une controverse, etc."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "126f983f-8e1b-4aa5-9f57-a3224a940b79",
                                "sense_id": "dda0a6b5-5181-3af0-9d35-1ba7032be315",
                                "text": "Parfois, certes, un aphorisme se réduit à un cliché ou à une vérité générale facilement « retournable », ou d'une application si large qu'il ne résiste pas à l'analyse."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0fe85a8-2167-326d-b174-057ad066799c",
                        "entry_id": "6925bb2b-cf35-3b25-966c-7649975649e7",
                        "glosses": [
                            "Qui coïncide après retournement."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "c20c3f19-3fd4-4e46-b9e6-66a14d02d085",
                                "sense_id": "b0fe85a8-2167-326d-b174-057ad066799c",
                                "text": "C'est ce qu'on exprime en disant que la droite est une ligne retournable (dans le plan) et le plan une surface retournable (dans l'espace); on entend par là que l'une et l'autre coïncident avec elles-mêmes après retournement."
                            }
                        ]
                    }
                ],
