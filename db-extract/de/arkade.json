                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14fa6851-bb04-4381-8ddb-f934c12684df",
                                "sense_id": "69f924c3-1044-3f2f-b796-f503ba0a5db7",
                                "text": "Neulich lief mir unter den Arkaden der mittelalterlichen Altstadt von Bern der sympathische Zürcher Nationalrat Peter Spaelti über den Weg, dessen gebräuntes Gesicht verrät, daß Leben und Regieren ihm Spaß machen.",
                                "translation": "Récemment, sous une arcade de la ville médiévale de Berne, je croisais le visage bronzé, heureux de vivre et de régner, de l’exubérant conseiller national zurichois Peter Spaelti."
                            }
                        ]
                    }
                ],
