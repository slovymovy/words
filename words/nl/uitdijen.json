{
    "word_family": [
        "dij"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c39c039-000b-38ce-8e1a-51f1068926e4",
                    "sense_definition": "In omvang toenemen of groter worden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "groei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wetenschappers ontdekten dat het heelal nog steeds blijft <w>uitdijen</w>.",
                            "target_lang_translations": {
                                "en": "Scientists discovered that the universe is still continuing to <w>expand</w>."
                            }
                        },
                        {
                            "text": "De storm zal door de warmte <w>uitdijen</w> tot een enorme tyfoon.",
                            "target_lang_translations": {
                                "en": "Due to the heat, the storm will <w>expand</w> into a massive typhoon."
                            }
                        }
                    ],
                    "synonyms": [
                        "expanderen",
                        "uitzetten"
                    ],
                    "antonyms": [
                        "krimpen",
                        "slinken"
                    ],
                    "common_phrases": [
                        "verder uitdijen"
                    ],
                    "target_lang_definitions": {
                        "en": "To increase in size, volume, or extent."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "expand",
                                "target_lang_sense_clarification": "To become larger in size, volume, or scope."
                            },
                            {
                                "target_lang_word": "enlarge",
                                "target_lang_sense_clarification": "To make or become larger."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05ef3379-f25f-3887-9b20-1399b63f8885",
                    "sense_definition": "In aantal of hoeveelheid toenemen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "groei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De populatie van deze diersoort zal de komende jaren <w>uitdijen</w>.",
                            "target_lang_translations": {
                                "en": "The population of this animal species will <w>grow</w> in the coming years."
                            }
                        },
                        {
                            "text": "Door nieuwe projecten zal de natuurlijke leefomgeving <w>uitdijen</w>.",
                            "target_lang_translations": {
                                "en": "Due to new projects, the natural habitat will <w>expand</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "toenemen",
                        "aangroeien"
                    ],
                    "antonyms": [
                        "inkrimpen"
                    ],
                    "target_lang_definitions": {
                        "en": "To increase in number or quantity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "increase",
                                "target_lang_sense_clarification": "To become larger in quantity or magnitude."
                            },
                            {
                                "target_lang_word": "grow",
                                "target_lang_sense_clarification": "To increase in size, number, or amount."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b1866e9-7884-329c-a4b1-33c206ada263",
                    "sense_definition": "Dikker worden of opzwellen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "groei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Laat het licht langzaam <w>uitdijen</w> zodat het de hele kamer vult.",
                            "target_lang_translations": {
                                "en": "Let the light slowly <w>swell</w> so that it fills the entire room."
                            }
                        },
                        {
                            "text": "De rivier begon door de hevige regenval merkbaar te <w>uitdijen</w>.",
                            "target_lang_translations": {
                                "en": "The river began to <w>swell</w> noticeably due to the heavy rainfall."
                            }
                        }
                    ],
                    "synonyms": [
                        "opzwellen",
                        "zwellen"
                    ],
                    "antonyms": [
                        "verschrompelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To become thicker or bulge due to internal pressure or fluid."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swell",
                                "target_lang_sense_clarification": "To become larger or distended, often due to fluid or pressure."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77ed623b-e9ee-3043-9de3-5f151d4483b9",
                    "sense_definition": "Zich in omvang vergroten.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "groei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het begrotingstekort heeft <w>zich</w> de afgelopen maanden flink <w>uitgedijd</w>.",
                            "target_lang_translations": {
                                "en": "The budget deficit has <w>expanded</w> significantly over the past few months."
                            }
                        },
                        {
                            "text": "De invloed van het bedrijf heeft <w>zich</w> internationaal <w>uitgedijd</w>.",
                            "target_lang_translations": {
                                "en": "The company's influence has <w>expanded</w> internationally."
                            }
                        }
                    ],
                    "synonyms": [
                        "vergroten"
                    ],
                    "target_lang_definitions": {
                        "en": "To increase in size or scope, often used reflexively."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "expand",
                                "target_lang_sense_clarification": "To increase in scope or extent."
                            },
                            {
                                "target_lang_word": "grow",
                                "target_lang_sense_clarification": "To develop or increase in influence or size."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}