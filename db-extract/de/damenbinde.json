                "senses": [
                    {
                        "sense_id": "52aa4108-8043-3fbd-9ffb-abe914b78ea7",
                        "entry_id": "51cbdcbc-414f-39a3-aa87-c01d35669737",
                        "glosses": [
                            "aus saugfähigen Materialien bestehende Einlage für die Unterhose zur Aufnahme des Menstruationsblutes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72a976e9-2ffe-43a5-ae53-efb82f4095a2",
                                "sense_id": "52aa4108-8043-3fbd-9ffb-abe914b78ea7",
                                "text": "Gert kaufte neue Damenbinden für seine Frau und seine Töchter."
                            },
                            {
                                "example_id": "268e6e21-24ae-4a3b-9508-935a79a0c507",
                                "sense_id": "52aa4108-8043-3fbd-9ffb-abe914b78ea7",
                                "text": "Damenbinden dürfen nicht über die Toilette entsorgt werden."
                            },
                            {
                                "example_id": "f35650f8-895b-4e0d-8008-cf651ecd2aa7",
                                "sense_id": "52aa4108-8043-3fbd-9ffb-abe914b78ea7",
                                "text": "Sie hat jeden Monat einen immensen Verbrauch an Damenbinden."
                            },
                            {
                                "example_id": "92719930-d8b7-469b-9733-f52f01f0cb1b",
                                "sense_id": "52aa4108-8043-3fbd-9ffb-abe914b78ea7",
                                "text": "In der Eingangshalle hat jemand eine unbenutzte Damenbinde verloren."
                            },
                            {
                                "example_id": "c16060e2-d20e-4026-9790-2b7475f5e221",
                                "sense_id": "52aa4108-8043-3fbd-9ffb-abe914b78ea7",
                                "text": "Als überraschend ihre Menstruation einsetzte, musste sie ihre Kollegin nach einer Damenbinde fragen."
                            },
                            {
                                "example_id": "f28cf72a-96fa-4606-a631-e85a99fbebf8",
                                "sense_id": "52aa4108-8043-3fbd-9ffb-abe914b78ea7",
                                "text": "„Sie wäre vor Scham fast gestorben, als sie um Damenbinden bitten musste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
