                                        "sense_id": "2fc9b647-c61c-3ccd-83db-a64aba8b4af3",
                                        "entry_id": "c56b4146-d6c1-3982-9cb7-b06cbeab6448",
                                        "glosses": [
                                            "een abstract symbool van een gemeente, bedrijf, stichting e.d. of een herkenningsteken waarin een naam of afkorting op kunstzinnige wijze is verbeeld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "597846d5-31ff-42f9-8a05-ce737d8d7158",
                                                "sense_id": "2fc9b647-c61c-3ccd-83db-a64aba8b4af3",
                                                "text": "De stichting heeft een nieuw beeldmerk laten ontwerpen."
                                            },
                                            {
                                                "example_id": "ea3c3ccc-1399-4da3-864f-655bdd7f1604",
                                                "sense_id": "2fc9b647-c61c-3ccd-83db-a64aba8b4af3",
                                                "text": "Het beeldmerk wordt vanavond gepresenteerd op een informatiebijeenkomst voor bedrijven. De naam van het gebied Zoutmarke komt ook tot uiting in het logo, dat de vorm van een gestileerd zoutkristal heeft. De bijeenkomst is bedoeld voor ondernemers en bedrijven in het gebied en wordt gehouden in het Grolschcomplex."
                                            }
