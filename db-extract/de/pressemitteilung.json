                                        "glosses": [
                                            "An official written statement that is sent to the media so that it can be publicized."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "667835e1-66f8-4bf7-9c34-e3cb19c0de48",
                                                "sense_id": "ae87ebf8-c3b4-364b-b98e-099ec44f5d2c",
                                                "text": "The company sent out a press release announcing its new product."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dba17c60-9bd0-430e-b1d3-466570715f29",
                        "source_entry_id": "9ed06f5d-cdf3-32e1-836c-70aa765609f6",
                        "source_sense_id": "62fca556-4ca9-3633-8519-f89d5ef75100",
                        "source_sense_description": "Mitteilung an die Presse",
                        "target_lang_word": "communiqué de presse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "communiqué de presse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "889afab2-4242-31c8-931d-5b0a6343d654",
                                        "entry_id": "af29d585-b579-361b-8b0e-feb95e3313c3",
                                        "glosses": [
                                            "Document court destiné à la presse et aux médias et rédigé par une organisation à une occasion particulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9e85110-6e86-47f4-aa5e-202554228f1f",
                                                "sense_id": "889afab2-4242-31c8-931d-5b0a6343d654",
                                                "text": "Certains journalistes ne font que copier les communiqués de presse… bonjour l’indépendance !"
                                            },
                                            {
                                                "example_id": "88a471f6-4062-4515-9ac5-cdfc1fd43131",
                                                "sense_id": "889afab2-4242-31c8-931d-5b0a6343d654",
                                                "text": "Un communiqué de presse se suffit à lui-même : ne joignez jamais de lettre d’accompagnement ou de coupure de presse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
