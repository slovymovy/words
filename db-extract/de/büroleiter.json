                    {
                        "sense_id": "c4221cfd-0ab9-3016-9262-b900cce4175a",
                        "entry_id": "0edeb8f6-241c-348d-a7c5-66555e32a9ee",
                        "glosses": [
                            "für die Mitarbeiter eines Büros verantwortlicher Vorgesetzter in leitender Position"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81846746-e4f8-419e-8f1d-999a45d5bf0d",
                                "sense_id": "c4221cfd-0ab9-3016-9262-b900cce4175a",
                                "text": "„Der studierte Soziologe war in der SPD auch unter anderem Büroleiter von Franz Müntefering und Bundesgeschäftsführer.“"
                            },
                            {
                                "example_id": "79d9e0e3-93be-4358-827c-bb26f5dbbefd",
                                "sense_id": "c4221cfd-0ab9-3016-9262-b900cce4175a",
                                "text": "„Von 1999 bis 2006 war er Büroleiter der damaligen Regierungschefs Manfred Stolpe und Matthias Platzeck (beide SPD), danach war er fünf Jahre lang Chef der Staatskanzlei.“"
                            }
                        ],
