                        "target_lang_word": "pédologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pédologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "235576e6-21f9-3959-9535-1fe7e92c90c7",
                                        "entry_id": "79395ae3-7c6d-33cd-9df5-888b224ab3e5",
                                        "glosses": [
                                            "Spécialiste l’étude des sols."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47aed8e0-5fd6-42e0-b796-ac17e61ac5b5",
                                                "sense_id": "235576e6-21f9-3959-9535-1fe7e92c90c7",
                                                "text": "Le pédologue bénéficie en quelques jours de l’expérience et des observations accumulées depuis des décennies par les agriculteurs sur les sols de leur terroir."
                                            },
                                            {
                                                "example_id": "4c5d6109-e7a3-42ca-a273-8c3ce27c927e",
                                                "sense_id": "235576e6-21f9-3959-9535-1fe7e92c90c7",
                                                "text": "Les sols formés sur la craie, par contre, ont peu retenu l'attention des pédologues. Ces sols sont considérés comme des exemples de rendzine vraie, où aucune évolution n'est possible."
                                            },
                                            {
                                                "example_id": "e0cc90ef-b40a-4888-b6ea-a7d961ff7896",
                                                "sense_id": "235576e6-21f9-3959-9535-1fe7e92c90c7",
                                                "text": "Par conséquent, le substratum (horizon C des pédologues) n’est pas la craie, sauf dans les rendzines blanches, qui sont l’exception."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
