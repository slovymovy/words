                "senses": [
                    {
                        "sense_id": "a1fb9af4-51e2-35fc-b248-44f254a1a57a",
                        "entry_id": "3d586d1b-a7f4-313f-a923-79bad3e5cf08",
                        "glosses": [
                            "regionale Regierung (Reich), die ca 250 nach Christus neben dem allerorts vorherrschenden römischen Reich aus dessen ehemaligen nordwestlichen Provinzen bestand"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "8c4916dd-837b-4ed5-88da-c05e0bfdc832",
                                "sense_id": "a1fb9af4-51e2-35fc-b248-44f254a1a57a",
                                "text": "„Die Beispiele der Sonderreiche in Gallien und Palmyra eröffneten, was die eigene Karrieregestaltung anging, verlockende Aussichten.“"
                            },
                            {
                                "example_id": "dc596c16-5132-4e8b-8919-ec0cc47b001b",
                                "sense_id": "a1fb9af4-51e2-35fc-b248-44f254a1a57a",
                                "text": "„258–277 bildete sich ein gallisches Sonderreich, das erst unter Aurelian dem Römischen Reich wieder angegliedert wurde.“"
                            },
                            {
                                "example_id": "76a5a70a-061a-4ffc-b6f3-c033218f5a03",
                                "sense_id": "a1fb9af4-51e2-35fc-b248-44f254a1a57a",
                                "text": "„Die Mehrzahl dieser Usurpationen konnte durch Gallienus und seine Generäle niedergeschlagen werden. Doch Marcus Cassianus Latinius Postumus gelang es in den drei gallischen Provinzen dauerhaft eine Art Sonderreich zu errichten […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
