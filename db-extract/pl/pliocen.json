                                        "glosses": [
                                            "Of a geologic epoch within the Neogene period from about 5.3 to 1.7 million years ago; marked by the appearance of humanity's first ancestors."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
