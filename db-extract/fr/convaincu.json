                        ],
                        "form": "convaincus"
                    },
                    {
                        "form_id": "ae4043a8-af17-454a-bfc2-2e3be03b1f9b",
                        "entry_id": "6c6d18b9-de61-303c-a065-90cc9b5b54c7",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "convaincue"
                    },
                    {
                        "form_id": "6bc481c5-8aa8-434d-84d1-0ec2219db612",
                        "entry_id": "6c6d18b9-de61-303c-a065-90cc9b5b54c7",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "convaincues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b4f881f4-af12-342f-b4e7-8c13c3b8c5d2",
                        "entry_id": "6c6d18b9-de61-303c-a065-90cc9b5b54c7",
                        "glosses": [
                            "Intimement persuadé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ca48c1f-69d1-4a79-8162-c96ba50e10e8",
                                "sense_id": "b4f881f4-af12-342f-b4e7-8c13c3b8c5d2",
                                "text": "Elle est d'ailleurs convaincue que vous l'aimez trop pour vous galvauder comme ce M. Pibrac qui n'est pas de votre monde."
                            },
                            {
                                "example_id": "5cd85a66-d92c-4364-a91a-07c78e0fe1a0",
                                "sense_id": "b4f881f4-af12-342f-b4e7-8c13c3b8c5d2",
                                "text": "Je suis convaincue que François Legault verrait les choses autrement s’il risquait de se retrouver à la rue le premier juillet."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d45da48-ff8f-31dd-beef-b304e453db42",
                        "entry_id": "6c6d18b9-de61-303c-a065-90cc9b5b54c7",
                        "glosses": [
                            "Qui marque de la conviction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6bed2b9-b87d-4baa-b452-ec60a7793c5b",
                                "sense_id": "2d45da48-ff8f-31dd-beef-b304e453db42",
                                "text": "Parler d’un ton convaincu."
                            }
                        ]
                    },
                    {
                        "sense_id": "edaba18a-4f3e-3f0f-88b7-874839286e57",
                        "entry_id": "6c6d18b9-de61-303c-a065-90cc9b5b54c7",
                        "glosses": [
                            "Convaincant ; qui marque la conviction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "652ff29b-3c74-432a-ac97-91afdb1e3048",
                                "sense_id": "edaba18a-4f3e-3f0f-88b7-874839286e57",
                                "text": "Logeur, manager, élève d’Utrillo, M.G. cumulait ces fonctions de l’air le plus cérémonieux et le plus convaincu du monde."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7af21d0-8b8e-32f8-9a39-37548fb3734e",
                        "entry_id": "6c6d18b9-de61-303c-a065-90cc9b5b54c7",
                        "glosses": [
                            "Fervent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62ccab57-9b92-46c5-b514-52dc639487b6",
                                "sense_id": "b7af21d0-8b8e-32f8-9a39-37548fb3734e",
                                "text": "Homme intelligent et sympathique, d’un commerce agréable, musulman convaincu mais tolérant, c'est un des rares Marocains qui ont tiré un profit réel de leur séjour en Europe."
                            }
                        ]
                    },
                    {
                        "sense_id": "91be6105-afab-3581-a8da-8cd06cbd52b4",
                        "entry_id": "6c6d18b9-de61-303c-a065-90cc9b5b54c7",
                        "glosses": [
                            "Reconnu coupable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f6ee0c4-a180-4f90-b362-f915b873507c",
                                "sense_id": "91be6105-afab-3581-a8da-8cd06cbd52b4",
                                "text": "La loi de Lynch était fréquemment appliquée ; un homme convaincu de meurtre ou de vol pouvait se voir arrêter, juger, et… pendre, en moins d’un quart d’heure, pour peu qu’un comité de vigilance énergique s'emparât de lui."
                            }
                        ]
                    }
                ],
