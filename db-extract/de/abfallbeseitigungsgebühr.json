                "senses": [
                    {
                        "sense_id": "bd8bc184-1b67-3246-b9c2-94001cb71b66",
                        "entry_id": "ceab2258-4d17-36fa-9575-f023bdf29c29",
                        "glosses": [
                            "für die Entsorgung von Abfall zu zahlender Geldbetrag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5902973-8cfb-4473-8985-71194c559be5",
                                "sense_id": "bd8bc184-1b67-3246-b9c2-94001cb71b66",
                                "text": "„Die Abfallbeseitigungsgebühr wird von den Gemeinden auf Grundlage einer Satzung erhoben.“"
                            },
                            {
                                "example_id": "7ee8193a-0772-4031-baef-8efc0eeacc49",
                                "sense_id": "bd8bc184-1b67-3246-b9c2-94001cb71b66",
                                "text": "„Die Abfallbeseitigungsgebühr gehört zu den Grundbesitzabgaben, also jenen Abgaben und Gebühren, die ein im Grundbuch eingetragener Grundstückseigentümer leisten muss.“"
                            },
                            {
                                "example_id": "a542c462-0818-49b8-b50a-e2eb5393911d",
                                "sense_id": "bd8bc184-1b67-3246-b9c2-94001cb71b66",
                                "text": "„Zahlen die Mieter einer Wohnung die fälligen Abfallbeseitigungsgebühren nicht, so ist die Behörde berechtigt, nachträglich die ausstehenden Gebühren von den Hauseigentümern zu fordern.“"
                            },
                            {
                                "example_id": "9ad761ab-5ba0-4ea7-9be6-04c3c5ebe70b",
                                "sense_id": "bd8bc184-1b67-3246-b9c2-94001cb71b66",
                                "text": "„Für das Einsammeln und Abfahren des Abfalls und die Bereitstellung der Restmüllbehälter erhebt die Stadt Kerpen Abfallbeseitigungsgebühren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
