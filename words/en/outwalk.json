{
    "word_family": [
        "walk",
        "walker",
        "walkable",
        "walkway"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f870e521-a03e-314f-830c-f342e1f9b138",
                    "sense_definition": "To walk faster than someone or something else.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "outpace_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He jogs so slowly that I can easily <w>outwalk</w> him on the trail.",
                            "target_lang_translations": {
                                "zh": "他慢跑得太慢了，以至于在小路上我步行都能轻松<w>走得比</w>他<w>快</w>。"
                            }
                        },
                        {
                            "text": "She increased her pace to <w>outwalk</w> the crowd leaving the stadium.",
                            "target_lang_translations": {
                                "zh": "她加快了脚步，以便在步行中<w>赶超</w>离开体育场的人群。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outpace"
                    ],
                    "common_phrases": [
                        "easily outwalk",
                        "outwalk the competition"
                    ],
                    "target_lang_definitions": {
                        "zh": "走得比某人或某物更快"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "走得比……快",
                                "target_lang_sense_clarification": "速度上走得更快"
                            },
                            {
                                "target_lang_word": "步行赶超",
                                "target_lang_sense_clarification": "步行超过"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65786666-2f2f-3e99-aee8-089dc2e45baf",
                    "sense_definition": "To walk a greater distance or for a longer time than another.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "outpace_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the charity challenge, she <w>outwalked</w> all other participants by logging over fifty miles.",
                            "target_lang_translations": {
                                "zh": "在慈善挑战赛中，她徒步超过五十英里，<w>走得比</w>所有其他参赛者都<w>远</w>。"
                            }
                        },
                        {
                            "text": "The experienced hiker managed to <w>outwalk</w> the rest of the group on the mountain trek.",
                            "target_lang_translations": {
                                "zh": "这位经验丰富的徒步旅行者在山地徒步中，徒步耐力成功<w>胜过</w>了队伍中的其他人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outdistance"
                    ],
                    "common_phrases": [
                        "outwalk opponents"
                    ],
                    "target_lang_definitions": {
                        "zh": "比某人步行更远的距离或更长的时间"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "走得比……远",
                                "target_lang_sense_clarification": "在距离或持久力上胜过"
                            },
                            {
                                "target_lang_word": "步行胜过",
                                "target_lang_sense_clarification": "步行里程或时长超过"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}