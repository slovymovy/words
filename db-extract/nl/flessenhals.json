                "senses": [
                    {
                        "sense_id": "88b29dd8-d57c-3ff3-b7f0-d9c0fe8e49c6",
                        "entry_id": "a68958b8-cf6c-3c77-b1df-85654eaa7ced",
                        "glosses": [
                            "knelpunt in infrastructuur / nauwe doorgang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6df40609-19f6-405d-96a2-792a5e330a28",
                                "sense_id": "88b29dd8-d57c-3ff3-b7f0-d9c0fe8e49c6",
                                "text": "Ondertussen blijft het Damrak een flessenhals vol met toeristen en forensen."
                            },
                            {
                                "example_id": "eee4121a-0889-4fcd-9001-e9b15dd5e7d4",
                                "sense_id": "88b29dd8-d57c-3ff3-b7f0-d9c0fe8e49c6",
                                "text": "De verkeerstunnels op de Nederlandse snelwegen zijn in 2015 minstens 11 duizend keer korte tijd gesloten voor alle verkeer omdat een te hoge vrachtwagen de tunnel naderde. Die plotselinge tunnelsluitingen hebben de Nederlandse economie volgens een berekening van de TU Delft zo'n 165 miljoen euro schade toegebracht. De Velsertunnel bij IJmuiden was vorig jaar verreweg de grootste flessenhals. Maar liefst 8677 keer sprong het licht bij deze tunnel op rood, gemiddeld één keer per uur."
                            }
                        ]
                    }
