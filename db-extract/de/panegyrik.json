                        "glosses": [
                            "lobende, festliche Rede an einen Herrscher"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "bdd90929-5afc-4040-bec3-c95613ec8e2c",
                                "sense_id": "b5dbd049-6d4a-39bf-92b1-a98794948e05",
                                "text": "„Christliche Erbauungsschriften und Predigten verdrängten immer mehr die traditionelle, heidnisch geprägte Panegyrik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
