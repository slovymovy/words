                "senses": [
                    {
                        "sense_id": "cb3823f2-2a47-3450-a7a7-9413d4d3b7ac",
                        "entry_id": "773d45c7-ecbf-3d65-99d7-4c659c7c7279",
                        "glosses": [
                            "Variante orthographique de retester (tester à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c305eaa-329a-4296-8ec8-14445493de05",
                                "sense_id": "cb3823f2-2a47-3450-a7a7-9413d4d3b7ac",
                                "text": "S’il ne le fait pas, cela veut tout simplement dire qu’il faut reprendre la synchronisation et re-tester un peu plus tard."
                            },
                            {
                                "example_id": "5ec1ff29-2c7a-49f1-87d8-e54e4290c684",
                                "sense_id": "cb3823f2-2a47-3450-a7a7-9413d4d3b7ac",
                                "text": "« Peut-être, peut-être, peut-être », en marketeur, vous direz plutôt « Tester, tester et re-tester »."
                            },
                            {
                                "example_id": "4c18430d-35db-4bd1-b769-78f57c2cf707",
                                "sense_id": "cb3823f2-2a47-3450-a7a7-9413d4d3b7ac",
                                "text": "Après, ne comptez pas le facteur temps, à la fois pour imaginer le jeu, le maquetter, le tester, le modifier, le re-tester… etc… ^([sic : etc.]) il m’est arrivé de re-maquetter intégralement un jeu 3 fois…"
                            }
                        ]
                    }
