                "senses": [
                    {
                        "sense_id": "fdd87c8c-4409-3004-bccc-43e6615bab1f",
                        "entry_id": "0c4b2912-f0ce-3e28-92b4-a1a8711642a5",
                        "glosses": [
                            "Of, related to, or suffering from paraplegia. Paralyzed from the lower half of the body down."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "51b90432-7f8b-4f6c-a019-6ece601b4a36",
                                "sense_id": "fdd87c8c-4409-3004-bccc-43e6615bab1f",
                                "text": "The guard looks at you with a troubled, uncomfortable glare, like that of a man who must explain to his paraplegic daughter that her dreams of becoming a ballerina will never come true."
                            }
                        ]
                    }
                ],
                "translations": [
