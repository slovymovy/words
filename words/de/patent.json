                    "frequency": "High",
                    "semantic_group_id": "schutzrecht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Erfinderin möchte für ihre neue Technologie ein <w>Patent</w> anmelden."
                        },
                        {
                            "text": "Das Unternehmen besitzt mehrere wertvolle <w>Patente</w> im Bereich der Medizintechnik."
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "ein Patent anmelden",
                        "ein Patent erteilen"
