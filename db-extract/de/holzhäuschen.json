                "senses": [
                    {
                        "sense_id": "5a0a4b69-ed3e-357f-8afa-ce108e74aead",
                        "entry_id": "0605a2e1-2a0c-37f8-afcb-4e39391ebeda",
                        "glosses": [
                            "kleines Haus aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5132428f-ed25-4c31-aae7-35e5b4fdef8e",
                                "sense_id": "5a0a4b69-ed3e-357f-8afa-ce108e74aead",
                                "text": "„Vor dem Aerodrom liegt noch ein großer Platz mit verdächtigen Holzhäuschen, für die wir andere Aufschriften erwartet hätten, als: Garage, Grand Büfett International und so weiter.“"
                            },
                            {
                                "example_id": "3db45ef5-d122-4a85-98d7-c449c71d5f28",
                                "sense_id": "5a0a4b69-ed3e-357f-8afa-ce108e74aead",
                                "text": "„Aber gleichwohl gibt es das Haus, ein Holzhäuschen mit Lattenwänden, ein niedriges Erdgeschoß mit Dachboden, baufällig vor Alter, ein Überbleibsel von dem alten Flecken Reikevig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
