                        "cross_references": []
                    },
                    {
                        "translation_id": "e2fe5f7a-4bf4-49e0-a091-7e8e39e61438",
                        "source_entry_id": "8dceab2a-6f9d-3a67-88e8-6c3482f81aa9",
                        "source_sense_id": "c841697e-53c0-3b0f-9955-2a6d83fe2284",
                        "target_lang_word": "obig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "acb039bc-b67c-3823-a7ba-7eb2074726d4",
                                        "entry_id": "045153e0-d455-391e-843e-1e85d2f72dc9",
                                        "glosses": [
                                            "in einem Schriftstück oberhalb einer Textstelle erwähnt oder dargestellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "300ab9b9-48c3-444f-942a-4463769578f0",
                                                "sense_id": "acb039bc-b67c-3823-a7ba-7eb2074726d4",
                                                "text": "Ich schrieb den obigen Text am Nachmittag des 10. Januar."
                                            },
                                            {
                                                "example_id": "9addf6ce-4123-4143-91da-222adca5ce47",
                                                "sense_id": "acb039bc-b67c-3823-a7ba-7eb2074726d4",
                                                "text": "Hinzu kommt, dass wir, gerade indem wir die obigen Fragen stellen, die europäischen Werte eigentlich schon bejahen."
                                            },
                                            {
                                                "example_id": "4ca8bb04-e669-49f9-a940-7911008bbeab",
                                                "sense_id": "acb039bc-b67c-3823-a7ba-7eb2074726d4",
                                                "text": "Die Vernunft kann nicht Quelle unserer Begriffe des moralisch Guten oder Bösen sein“, sagte David Hume. Zumindest nicht primäre Quelle: Das kann man aus obigem Experiment lesen."
                                            },
                                            {
                                                "example_id": "d83a3867-c887-46c0-aa52-e58db326cc67",
                                                "sense_id": "acb039bc-b67c-3823-a7ba-7eb2074726d4",
                                                "text": "Wer von ihnen ist bereit, ein Volksbegehren mit obiger Zielsetzung (Steuersenkung durch Staatsreform) zu unterstützen?"
                                            },
                                            {
                                                "example_id": "324f0d0f-0c91-4b75-ab63-216f7fa07f6e",
                                                "sense_id": "acb039bc-b67c-3823-a7ba-7eb2074726d4",
                                                "text": "Zu welchem Ende dann, und mit obig ausführlichen Bedingnissen wir eröftertem Peter Prosch diese Konzession unter etwelch aus unsern Miträten Handschrift und Petschaften verfertiget, bestellen lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6a82017f-2faf-3b04-90bb-63d8aeb539eb",
                                        "entry_id": "045153e0-d455-391e-843e-1e85d2f72dc9",
                                        "glosses": [
                                            "oberhalb von"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d202527-8f7f-4e44-9978-ae2db7e3b8d5",
                                                "sense_id": "6a82017f-2faf-3b04-90bb-63d8aeb539eb",
                                                "text": "„Sie ist nach der Ersäuffung obig der Ziegelscheune, die damahls über der Brücke gestanden, zwischen denen 2. Bergen begraben worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d79e0960-5514-4a5a-8683-eff45220131e",
                        "source_entry_id": "8dceab2a-6f9d-3a67-88e8-6c3482f81aa9",
                        "source_sense_id": "c841697e-53c0-3b0f-9955-2a6d83fe2284",
                        "target_lang_word": "susdit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "susdit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17ee74da-3078-38d1-a5aa-9a91fd3301a3",
                                        "entry_id": "434fc460-b854-3d1a-bf49-572b741a9c65",
                                        "glosses": [
                                            "Nommé ci-dessus."
                                        ],
                                        "tags": [
                                            "Style juridique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6db8b506-8b0e-437c-bd0e-e35c00b9fb6b",
                                                "sense_id": "17ee74da-3078-38d1-a5aa-9a91fd3301a3",
                                                "text": "En revanche, il se jeta avec fureur sur d’autres documents que l’on lui présenta et se mit à griffonner avec une ardeur qui aurait fait honneur à M. Dumont lui-même, entassant allégués sur allégués, ajoutant les dits aux susdits, mettant la cité dans le comté, le comté dans le district et le district dans la province ; enfin n’omettant rien de tout ce qui pouvait rendre son style parfaitement barbare et inintelligible, et par là même parfaitement légal et irréprochable."
                                            },
                                            {
                                                "example_id": "ce7bd045-baae-4d24-8a3a-aba651178af2",
                                                "sense_id": "17ee74da-3078-38d1-a5aa-9a91fd3301a3",
                                                "text": "En 1708, le deuxième dimanche de Carême, les reliques de sainte Gaudence, envoyées de Rome pour la paroisse d’Hauteville, ont été enchâssées dans un reliquaire de bois doré dans l'église de cette ville par M. le doyen de Rethel avec solennité. Les paroissiens d’Hauteville et ceux de Son sont venus en processions avec armes et flambeaux, et ont emporté les dites reliques en la susdite paroisse d’Hauteville."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "susdit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8819498a-cb1c-37a3-b8cf-c448d8879e9f",
                                        "entry_id": "66d10116-3698-3ffa-9ee5-f20d35323cd4",
                                        "glosses": [
                                            "Objet ou personne susdit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58b52ec5-e641-48e4-8510-63d2028d23b4",
                                                "sense_id": "8819498a-cb1c-37a3-b8cf-c448d8879e9f",
                                                "text": "Eh bien en ce moment, nous sommes en train de boire du « petit bleu » avec le susdit chez un énorme mastroquet, en l'honneur des absents et du bon vieux clocher."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
