                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>clench</w> of the nail ensures the board stays in place.",
                            "target_lang_translations": {
