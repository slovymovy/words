                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "first of all",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e4dbd6f-3942-3f98-8ef4-a54de0f79571",
                                        "entry_id": "d0e538b2-8d7d-3e3e-9872-e3efa44be5be",
                                        "glosses": [
                                            "Firstly; before anything else."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable",
                                            "sequence"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ba3ca31-21ab-4811-9a3e-82829caf6216",
                                                "sense_id": "4e4dbd6f-3942-3f98-8ef4-a54de0f79571",
                                                "text": "Be strong, live happie, and love, but first of all / Him whom to love is to obey, and keep / His great command; […]"
                                            },
                                            {
                                                "example_id": "5292f773-0ac3-4f20-ad2c-6820ac483524",
                                                "sense_id": "4e4dbd6f-3942-3f98-8ef4-a54de0f79571",
                                                "text": "\"My dear sir,\" said Hube in an authoritative manner to the receptionist askancing Thales, \"first of all, we aren't tourists. Secondly, this isn't a rat, this is the present embodiment of the spiritual leader of millions of people in India […]"
                                            },
                                            {
                                                "example_id": "dd02aff1-a7e2-4a38-b688-06e212d13e08",
                                                "sense_id": "4e4dbd6f-3942-3f98-8ef4-a54de0f79571",
                                                "text": "\"I must say, I quite enjoy having the best detective in the business, and the fastest gun in the West, on my payroll.\" \"First of all,\" Clint said tightly, \"I'm not the fastest gun in the West, and second, I'm not on your payroll.\" Royce held up both of his hands. \"I didn't mean to offend you, sir[…]\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b41b3e9-9ce4-47f9-8d31-7556b5c0c3ae",
                        "source_entry_id": "aa0f4419-b445-3461-995e-63dd7b610bc8",
                        "source_sense_id": "12bac5d6-f1d3-3e8e-941f-8c14ab13aeba",
                        "source_sense_description": "vor allem/allen anderen, an absolut erster Stelle",
                        "target_lang_word": "avant toute chose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avant toute chose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe8f3803-6c6a-36bb-9b81-036687b9cf1a",
                                        "entry_id": "22b9b311-0bc3-3a58-9b1e-4cb7aa6fbbcc",
                                        "glosses": [
                                            "Variante orthographique de avant toutes choses."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05af9896-034d-4291-99ca-6fd2f842bdf4",
                                                "sense_id": "fe8f3803-6c6a-36bb-9b81-036687b9cf1a",
                                                "text": "J'exhorte donc, avant toute chose, à faire des prières, des supplications, des requêtes, des actions de grâces, pour tous les hommes,"
                                            },
                                            {
                                                "example_id": "70e734bf-1adf-46e0-ac4c-f37dfcea7de7",
                                                "sense_id": "fe8f3803-6c6a-36bb-9b81-036687b9cf1a",
                                                "text": "– Léonce, avant toute chose, je vous en supplie (elle avait pris ses mains dans les siennes), dites-moi... Comment faites-vous pour passer votre vie avec un pareil énergumène ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f19bafe-5d71-4d56-accb-e628e1294067",
                        "source_entry_id": "aa0f4419-b445-3461-995e-63dd7b610bc8",
