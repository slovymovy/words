                "senses": [
                    {
                        "sense_id": "a5be3b04-e1dc-3412-91e3-e526c1a3c66b",
                        "entry_id": "ebcf5105-afef-3445-8894-8b206dec1eb2",
                        "glosses": [
                            "eine auf die Schriften von Karl Marx und Friedrich Engels aufbauende Erkenntnis-, Geschichts-, Wirtschafts- und Gesellschaftstheorie, wie sich darauf berufende oder daraus ableitende politische Praxis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d93d7fd8-be5c-4ee4-b74c-1e01dace3192",
                                "sense_id": "a5be3b04-e1dc-3412-91e3-e526c1a3c66b",
                                "text": "Lenin war ein Anhänger des Marxismus."
                            },
                            {
                                "example_id": "017e34ef-e935-4b53-9fba-9c7ca6c251fa",
                                "sense_id": "a5be3b04-e1dc-3412-91e3-e526c1a3c66b",
                                "text": "„Die Sandinisten mit ihrer Mischung aus Nationalismus, Befreiungstheologie und Marxismus näherten sich zunehmend der kubanischen Position an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5114899-7c06-461c-9509-b8d6de4d7a93",
                        "source_entry_id": "ebcf5105-afef-3445-8894-8b206dec1eb2",
                        "source_sense_id": "a5be3b04-e1dc-3412-91e3-e526c1a3c66b",
                        "target_lang_word": "Marxism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marxism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffa4710e-8d7c-3d7c-9f81-28cb5f72f475",
                                        "entry_id": "2a0f81f1-dc8d-361e-9b32-ee014d145c76",
                                        "glosses": [
                                            "The socialist and communist philosophy and political program founded by Karl Marx and Friedrich Engels."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d08be2f-3ebd-3ed3-b541-6dc724cf30d6",
                                        "entry_id": "2a0f81f1-dc8d-361e-9b32-ee014d145c76",
                                        "glosses": [
                                            "The socialist and communist theory of the followers of Karl Marx and Friedrich Engels; a radical, revolutionary political philosophy that aims to capture state power, introduce a dictatorship of the proletariat, and then progress to communism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "664c6384-5a31-3229-82ff-89434e082195",
                                        "entry_id": "2a0f81f1-dc8d-361e-9b32-ee014d145c76",
                                        "glosses": [
                                            "Any left-wing ideology, government regulations, or policies promoting a welfare state, nationalisation, etc."
                                        ],
                                        "tags": [
                                            "Western",
                                            "colloquial",
                                            "countable",
                                            "derogatory",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1a01ede-e95c-42df-ba7e-27e8f09b914a",
                        "source_entry_id": "ebcf5105-afef-3445-8894-8b206dec1eb2",
                        "source_sense_id": "a5be3b04-e1dc-3412-91e3-e526c1a3c66b",
                        "target_lang_word": "marxisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marxisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b058f8f1-25b8-3c3c-874a-06e50a14d003",
                                        "entry_id": "3c8949f8-3f06-3ddb-9b1e-ba526214910e",
                                        "glosses": [
                                            "Idéologie communiste telle que professée par Karl Marx ou ses adeptes."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4188704-6ef9-4a5b-aa7e-016f3cb04648",
                                                "sense_id": "b058f8f1-25b8-3c3c-874a-06e50a14d003",
                                                "text": "Bernstein, échappé de la dogmatique marxiste, raisonnait parfois à la manière des épistémologues de son temps, lesquels étaient néopositivistes et néokantiens. Mais, il n'était pas passé du marxisme au néokantisme par une apostasie."
                                            },
                                            {
                                                "example_id": "fc62f515-f5cc-4ffe-8a96-902485fe6a21",
                                                "sense_id": "b058f8f1-25b8-3c3c-874a-06e50a14d003",
                                                "text": "Quand le mouvement islamiste radical s'empara de la direction des syndicats d'étudiants, à la fin des années 1970, nombre de ses chefs étaient versés dans d'autres idéologies, le marxisme en particulier, ou étaient d'anciens marxistes."
                                            },
                                            {
                                                "example_id": "be09a60d-52a9-4118-bf6a-60fab8776ad5",
                                                "sense_id": "b058f8f1-25b8-3c3c-874a-06e50a14d003",
                                                "text": "Cet ouvriérisme de prophètes était en effet le fruit de la révision du marxisme opérée par Lénine, qui […] avait hérité d’un marxisme revu par le populisme russe, et ébranlé par la crise révisionniste."
                                            },
                                            {
                                                "example_id": "40f11c3f-f5a7-43d0-9493-da50ea47f169",
                                                "sense_id": "b058f8f1-25b8-3c3c-874a-06e50a14d003",
                                                "text": "Inspirés par le marxisme, les porte-paroles de ce courant soutiennent qu’il est primordial de réunir les conditions objectives avant de lancer l’attaque révolutionnaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
