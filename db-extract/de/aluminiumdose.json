                ],
                "senses": [
                    {
                        "sense_id": "78bc925b-7f6e-3ea3-b058-9410622e34e3",
                        "entry_id": "16c568cb-6c81-3827-ab41-0837b9545ace",
                        "glosses": [
                            "Dose aus Aluminium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a17ba5b9-5531-4970-aebb-5edb94c6d4c4",
                                "sense_id": "78bc925b-7f6e-3ea3-b058-9410622e34e3",
                                "text": "„Nur ein paar Relikte ihrer Lebensform haben sie zwischen den Ruinen hinterlassen: \"Rindfleischlyoner\" steht auf einer runden Aluminiumdose, daneben liegen die Getränkepulvermischung \"Exotic\" und ein paar Scheiben Vollkornbrot im Dreck.“"
                            },
                            {
                                "example_id": "0abaab3f-04d5-43a7-9650-51e39e6032bb",
                                "sense_id": "78bc925b-7f6e-3ea3-b058-9410622e34e3",
                                "text": "„In diesem kurzen Zeitraum hat das Recycling der Aluminiumdose 95 % der Energie und 100 % der Ressourcen gespart.“"
                            },
                            {
                                "example_id": "f588fadc-b46c-4cd2-b346-2d22bfa4e573",
                                "sense_id": "78bc925b-7f6e-3ea3-b058-9410622e34e3",
                                "text": "„Aus der Abbildung wird ersichtlich, dass die Nano-PET-Flasche im Vergleich zur Aluminiumdose rund ein Drittel weniger Treibhausgase verursacht, während im Vergleich zur Glasflasche das Umweltentlastungspotenzial sogar rund 60% beträgt.“"
                            },
                            {
                                "example_id": "d7f1d6a6-934c-4599-a147-7b5c5edf7748",
                                "sense_id": "78bc925b-7f6e-3ea3-b058-9410622e34e3",
                                "text": "„Die Gefäße sind sofort zu verschließen und in die mit Nummern versehenen Aluminiumdosen zu stecken.“"
                            },
                            {
                                "example_id": "bbdcaee0-a59b-4bc2-9f57-f4c812eb325b",
                                "sense_id": "78bc925b-7f6e-3ea3-b058-9410622e34e3",
                                "text": "„Aluminiumdosen, die damals gerade entwickelt wurden, hatten weniger Gewicht und waren einfacher in der Herstellung als Dosen aus Stahlblech; […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
