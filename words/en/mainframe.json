{
    "word_family": [
        "frame",
        "framework"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dde9b8a6-1755-3d31-a70b-3a90d3f071d1",
                    "sense_definition": "A large, powerful computer used by large organizations to manage many simultaneous tasks and connected terminals.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank relies on a <w>mainframe</w> to process millions of transactions every single day.",
                            "target_lang_translations": {
                                "zh": "这家银行依靠一台<w>大型机</w>来处理每天数以百万计的交易。"
                            }
                        },
                        {
                            "text": "Large corporations often use a <w>mainframe</w> to handle their complex data processing needs.",
                            "target_lang_translations": {
                                "zh": "大型企业通常使用<w>大型机</w>来处理其复杂的数据处理需求。"
                            }
                        }
                    ],
                    "synonyms": [
                        "maxicomputer",
                        "maxi"
                    ],
                    "common_phrases": [
                        "mainframe computer",
                        "mainframe system"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种大型、功能强大的计算机，供大型组织用于管理大量并发任务和连接的终端。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大型机",
                                "target_lang_sense_clarification": "指用于处理海量数据和复杂任务的大型计算机系统。"
                            },
                            {
                                "target_lang_word": "主机",
                                "target_lang_sense_clarification": "在特定语境下指代核心计算设备。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc069160-f782-3c51-9c2d-18b139560ba5",
                    "sense_definition": "A computer chassis that hosts and interconnects various hardware modules.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician opened the <w>mainframe</w> to replace the faulty memory module.",
                            "target_lang_translations": {
                                "zh": "技术人员打开了<w>机箱</w>以更换故障的内存模块。"
                            }
                        },
                        {
                            "text": "All internal components are securely mounted within the <w>mainframe</w> chassis.",
                            "target_lang_translations": {
                                "zh": "所有内部组件都牢固地安装在<w>主机架</w>内。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "容纳并互连各种硬件模块的计算机机箱。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "机箱",
                                "target_lang_sense_clarification": "指容纳计算机内部硬件的框架结构。"
                            },
                            {
                                "target_lang_word": "主机架",
                                "target_lang_sense_clarification": "指用于安装和连接硬件模块的物理框架。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3f59912-fe5d-373b-9778-66eb6896e9a5",
                    "sense_definition": "The primary structural frame of a vehicle or similar machine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accident caused significant damage to the vehicle's <w>mainframe</w>.",
                            "target_lang_translations": {
                                "zh": "事故对车辆的<w>主框架</w>造成了严重损坏。"
                            }
                        },
                        {
                            "text": "Engineers inspected the <w>mainframe</w> to ensure the structural integrity of the aircraft.",
                            "target_lang_translations": {
                                "zh": "工程师检查了<w>主框架</w>以确保飞机的结构完整性。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "车辆或类似机器的主要结构框架。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "主框架",
                                "target_lang_sense_clarification": "指机器或车辆的主要承重结构。"
                            },
                            {
                                "target_lang_word": "车架",
                                "target_lang_sense_clarification": "特指车辆的底盘或主体结构。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}