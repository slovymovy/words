                    },
                    {
                        "translation_id": "716eae0e-1bb1-4031-b5e1-02eedf19612e",
                        "source_entry_id": "6ae7212f-6654-3177-a72b-62757143202c",
                        "source_sense_id": "7e7d11d8-ea92-3366-abaf-ced91441dadf",
                        "source_sense_description": "schriftlicher Vertrag zwischen Arbeitnehmer und Arbeitgeber",
                        "target_lang_word": "contrat de travail",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrat de travail",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dbcc1887-73b5-3842-9a54-2ec3951c5f0e",
                                        "entry_id": "b0368a82-ba42-3afa-a449-6dfc5c800451",
                                        "glosses": [
                                            "Accord par lequel une personne, le salarié, s’engage à fournir un travail sous la conduite et la direction d’une autre, l’employeur, en échange d’une rémunération, le salaire."
                                        ],
                                        "tags": [
                                            "Droit du travail"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76df8ff3-1105-4c05-9cdb-35af1ec800ec",
                                                "sense_id": "dbcc1887-73b5-3842-9a54-2ec3951c5f0e",
                                                "text": "L’idée de clause résolutoire n’est pas non plus étrangère à la rupture des contrats de travail conclus avec un couple de travailleurs."
                                            },
                                            {
                                                "example_id": "a9453e75-a92c-495a-a0a0-19135f133bb6",
                                                "sense_id": "dbcc1887-73b5-3842-9a54-2ec3951c5f0e",
                                                "text": "Le législateur définit le contrat de travail comme le contrat par lequel un travailleur s’engage contre rémunération à fournir un travail sous l’autorité d’un employeur (art. 2, 3, 4, 5 loi du 3 juillet 1978)."
                                            },
                                            {
                                                "example_id": "4a8e116d-3de7-4ae8-8a15-ff350365f5e0",
                                                "sense_id": "dbcc1887-73b5-3842-9a54-2ec3951c5f0e",
                                                "text": "Le fameux « lien de subordination » qui caractérise tout contrat de travail, je ne pouvais qu’y être allergique. Ça avait d’ailleurs bien été le cas durant les dix-huit mois passés aux Presses de la Cité : j’avais développé un trouble psychosomatique qui disparut le jour même où je reçus ma lettre de licenciement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f731033-470c-36c6-afd4-7679e8fc450f",
                                        "entry_id": "b0368a82-ba42-3afa-a449-6dfc5c800451",
                                        "glosses": [
                                            "Document signé par l’employeur et la personne salariée où sont rédigées les spécifications de l’accord conclu en vue de l’exercice d’un emploi dans le cadre du droit du travail."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50fb0ab5-8e9e-44cf-b3c7-44cdc517c8b7",
                                                "sense_id": "6f731033-470c-36c6-afd4-7679e8fc450f",
                                                "text": "Il faudrait que vous nous envoyiez votre contrat de travail."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a98602d-e9a4-4ecc-a097-1c8206cee103",
                        "source_entry_id": "6ae7212f-6654-3177-a72b-62757143202c",
