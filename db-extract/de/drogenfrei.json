                    },
                    {
                        "form_id": "93c4074a-4373-4d91-9fbc-29613bd1036c",
                        "entry_id": "6b7e2e62-b7e1-33fb-bb54-bedcbb9598a2",
                        "tags": [
                            "positive",
                            "predicative",
                            "singular",
                            "neuter"
                        ],
                        "form": "es ist drogenfrei"
                    },
                    {
                        "form_id": "7379c8d8-7816-4930-8976-b6dfb3d9a5ae",
                        "entry_id": "6b7e2e62-b7e1-33fb-bb54-bedcbb9598a2",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind drogenfrei"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8dd29a8d-4572-37d1-a577-f65230fd5f8f",
                        "entry_id": "6b7e2e62-b7e1-33fb-bb54-bedcbb9598a2",
                        "glosses": [
                            "keine Drogen enthaltend, nicht mit Drogen oder dessen Spuren belastet"
                        ],
                        "tags": [
                            "bezogen auf einen Ort oder Gegenstand"
                        ],
                        "examples": [
                            {
                                "example_id": "59afc27c-6447-4ba3-82a3-add686df19f6",
                                "sense_id": "8dd29a8d-4572-37d1-a577-f65230fd5f8f",
                                "text": "„Wir haben gründlich durchsucht, diese Wohnung ist drogenfrei: kein Kokain, kein Heroin, kein Mariuhana und auch sonst nicht.“"
                            },
                            {
                                "example_id": "5751c68d-ff3f-4ad6-8282-22bffe41d5e9",
                                "sense_id": "8dd29a8d-4572-37d1-a577-f65230fd5f8f",
                                "text": "„Es gibt auf der ganzen Welt kein einziges drogenfreies Gefängnis“, sagt [der ehemalige Gefängnisarzt und Buchautor Karlheinz] Keppler."
                            },
                            {
                                "example_id": "a7a926f9-41c7-4567-bf28-89794df259a7",
                                "sense_id": "8dd29a8d-4572-37d1-a577-f65230fd5f8f",
                                "text": "Zwischendurch hatte sich auch die NPD Saar zu Wort gemeldet, das Vorgehen von [Bürgermeister Franz-Josef] Berg begrüßt und die Sammlung von Unterschriften für ein drogenfreies Saarland angekündigt."
                            },
                            {
                                "example_id": "1d70dfaf-3ef5-4852-9911-b4f472bed413",
                                "sense_id": "8dd29a8d-4572-37d1-a577-f65230fd5f8f",
                                "text": "Alkohol und Amphetamin, Kaffee und Cannabis: Drogen sind Teil der menschlichen Geschichte. Die Idee einer drogenfreien Welt hält der Politikwissenschaftler Robert Feustel deshalb für einen Denkfehler."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f31c5e92-7f3f-3859-9855-af8c6ad15d95",
                        "entry_id": "6b7e2e62-b7e1-33fb-bb54-bedcbb9598a2",
                        "glosses": [
                            "keine Drogen (mehr) konsumierend; clean"
                        ],
                        "tags": [
                            "bezogen auf eine oder mehrere Personen"
                        ],
                        "examples": [
                            {
                                "example_id": "f060bfcb-2928-45ad-a2cf-b346c9d0880b",
                                "sense_id": "f31c5e92-7f3f-3859-9855-af8c6ad15d95",
                                "text": "Ich bin seit meinem Entzug vor fünf Jahren drogenfrei."
                            },
                            {
                                "example_id": "555f00c9-21d6-4c73-8d6a-abb20c30d2b4",
                                "sense_id": "f31c5e92-7f3f-3859-9855-af8c6ad15d95",
                                "text": "In einem alten Armeegebäude am Strand von Santa Monica lebten bald über hundert Drogenabhängige freiwillig drogenfrei."
                            },
                            {
                                "example_id": "71c72dc1-809c-48e1-9f7c-e6092cbe1f7c",
                                "sense_id": "f31c5e92-7f3f-3859-9855-af8c6ad15d95",
                                "text": "In einer Bochumer Methadonambulanz bekommen Drogensüchtige die Ersatzdroge Methadon […]. Das Programm hilft vielen, ein normales Leben zu führen – drogenfrei werden jedoch nur die wenigsten."
                            },
                            {
                                "example_id": "c53c0f82-4f9e-438b-aa1d-bdd3ca096c03",
                                "sense_id": "f31c5e92-7f3f-3859-9855-af8c6ad15d95",
                                "text": "Der philippinische Präsident Rodrigo Duterte will seinen Kampf gegen Drogenkriminelle weiter verschärfen. Um sein Ziel einer drogenfreien Gesellschaft zu erreichen, werde er noch weit mehr Menschen als bisher töten, sagte Duterte."
                            },
                            {
                                "example_id": "aea9c1c3-68e6-42e5-a2ec-be0018fdd538",
                                "sense_id": "f31c5e92-7f3f-3859-9855-af8c6ad15d95",
                                "text": "Können wir damit leben, wenn unsere Athleten bei Welt- und Europameisterschaften ohne Spritze nicht mehr Spitze sind? Jammert dann wirklich niemand, wenn unsere Sportnation drogenfrei auf Platz 17 des Medaillenspiegels landet?"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
