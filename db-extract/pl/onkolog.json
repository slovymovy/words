                    },
                    {
                        "translation_id": "2d576030-06df-4e89-aa96-3e1e03a3be46",
                        "source_entry_id": "a653a0bf-1aa7-36f0-ae6b-958849317d3d",
                        "source_sense_id": "3720d230-ea6c-34a7-a93d-ca4aceebbc2e",
