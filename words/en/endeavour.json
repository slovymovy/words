{
    "word_family": [
        "endeavourer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b419583-e995-3b6e-a2a8-147c93db7eca",
                    "sense_definition": "To make an earnest effort; to try hard to achieve something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists <w>endeavour</w> to find a sustainable solution to the energy crisis.",
                            "target_lang_translations": {
                                "ru": "Ученые <w>стремятся</w> найти устойчивое решение энергетического кризиса.",
                                "es": "Los científicos se <w>esfuerzan</w> por encontrar una solución sostenible a la crisis energética."
                            }
                        },
                        {
                            "text": "We must <w>endeavour</w> to finish the project before the deadline next week.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>постараться</w> закончить проект до крайнего срока на следующей неделе.",
                                "es": "Debemos <w>esforzarnos por</w> terminar el proyecto antes de la fecha límite de la próxima semana."
                            }
                        }
                    ],
                    "synonyms": [
                        "strive",
                        "attempt",
                        "try",
                        "venture"
                    ],
                    "antonyms": [
                        "neglect",
                        "idle"
                    ],
                    "common_phrases": [
                        "endeavour to finish",
                        "endeavour to understand"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прилагать серьезные усилия; стараться изо всех сил достичь чего-либо.",
                        "es": "Hacer un esfuerzo sincero y tenaz; esforzarse o intentar con ahínco lograr algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стремиться",
                                "target_lang_sense_clarification": "прилагать усилия к достижению цели"
                            },
                            {
                                "target_lang_word": "стараться",
                                "target_lang_sense_clarification": "делать все возможное"
                            },
                            {
                                "target_lang_word": "пытаться",
                                "target_lang_sense_clarification": "предпринимать попытку"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "esforzarse",
                                "target_lang_sense_clarification": "poner empeño o afán en lograr algo"
                            },
                            {
                                "target_lang_word": "intentar",
                                "target_lang_sense_clarification": "procurar o hacer el esfuerzo por conseguir algo"
                            },
                            {
                                "target_lang_word": "empeñarse",
                                "target_lang_sense_clarification": "poner mucha constancia en una meta"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79974688-59e6-37b1-a5f2-e971bd3a0ed6",
                    "sense_definition": "A purposeful or serious attempt to achieve a goal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Writing a complete history of the world is a massive <w>endeavour</w> for any author.",
                            "target_lang_translations": {
                                "ru": "Написание полной истории мира — это масштабное <w>начинание</w> для любого автора.",
                                "es": "Escribir una historia completa del mundo es una enorme <w>empresa</w> para cualquier autor."
                            }
                        },
                        {
                            "text": "The team was successful in its <w>endeavour</w> to climb the highest peak.",
                            "target_lang_translations": {
                                "ru": "Команда добилась успеха в своем <w>стремлении</w> покорить высочайшую вершину.",
                                "es": "El equipo tuvo éxito en su <w>empeño</w> de escalar el pico más alto."
                            }
                        }
                    ],
                    "synonyms": [
                        "effort",
                        "undertaking",
                        "enterprise",
                        "attempt"
                    ],
                    "antonyms": [
                        "inactivity",
                        "failure"
                    ],
                    "common_phrases": [
                        "artistic endeavour",
                        "scientific endeavour",
                        "human endeavour"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Целенаправленная или серьезная попытка достичь цели.",
                        "es": "Intento o empeño serio y decidido por lograr un objetivo; empresa o esfuerzo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усилие",
                                "target_lang_sense_clarification": "напряжение сил для достижения чего-либо"
                            },
                            {
                                "target_lang_word": "начинание",
                                "target_lang_sense_clarification": "новое, часто сложное дело"
                            },
                            {
                                "target_lang_word": "попытка",
                                "target_lang_sense_clarification": "действие, направленное на достижение цели"
                            },
                            {
                                "target_lang_word": "стремление",
                                "target_lang_sense_clarification": "настойчивое желание достичь чего-либо"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "esfuerzo",
                                "target_lang_sense_clarification": "empleo enérgico del vigor o actividad para un fin"
                            },
                            {
                                "target_lang_word": "empresa",
                                "target_lang_sense_clarification": "acción ardua o tarea compleja que se emprende"
                            },
                            {
                                "target_lang_word": "empeño",
                                "target_lang_sense_clarification": "deseo vehemente o intento perseverante"
                            },
                            {
                                "target_lang_word": "iniciativa",
                                "target_lang_sense_clarification": "proyecto o tarea emprendida"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}