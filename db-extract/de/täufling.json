                "senses": [
                    {
                        "sense_id": "67a25818-8380-32e2-bdb3-7c2b21d9b31a",
                        "entry_id": "da050636-85cd-308e-b2b8-092b7f019270",
                        "glosses": [
                            "jemand, der getauft wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c0e15dc-f17e-4b8e-8c16-a3448b31c8e6",
                                "sense_id": "67a25818-8380-32e2-bdb3-7c2b21d9b31a",
                                "text": "„In Äthiopien ist es Brauch, den Täufling mit dem ganzen Körper ins Taufbecken zu tauchen.“"
                            },
                            {
                                "example_id": "6cc5a056-b47d-4ab2-b957-4ff4b4975bb4",
                                "sense_id": "67a25818-8380-32e2-bdb3-7c2b21d9b31a",
                                "text": "„Auf dem Bild sieht man einen Pfarrer, der einem Täufling mit dem Hammer ein Kreuz in den Bauchnabel treibt.“"
                            },
                            {
                                "example_id": "446191c8-c684-48d1-92f2-1800672dca7c",
                                "sense_id": "67a25818-8380-32e2-bdb3-7c2b21d9b31a",
                                "text": "„Oma Kreft allerdings schüttelt den Kopf, nachdem sie abwechselnd den Täufling und seine Urgroßmutter gemustert hat.“"
                            },
                            {
                                "example_id": "24a37f1e-5cc6-4668-b303-9a20f147ff84",
                                "sense_id": "67a25818-8380-32e2-bdb3-7c2b21d9b31a",
                                "text": "„Da steht er vor ihnen mit dem Kind, das getauft werden soll, und vielleicht hilft ihm Dr. Deering oder sonst ein anderer Diakon beim Eintauchen des Täuflings.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
