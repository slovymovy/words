                    {
                        "sense_id": "84bc257a-c5bf-31a1-bea4-a0b0fe2974c3",
                        "entry_id": "0b947ebf-4ff2-36ea-bcda-26a45eedf290",
                        "glosses": [
                            "uitgave waarin alle zaken die ter verkoop worden aangeboden op een veiling staan vermeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce4dd7d6-8873-40cb-8836-a4378bcab4bf",
                                "sense_id": "84bc257a-c5bf-31a1-bea4-a0b0fe2974c3",
                                "text": "De opbrengst was volgens de veilingcatalogus bestemd voor het Wereld Natuur Fonds, maar later kwam naar buiten dat Bernhard de 700.000 euro had gebruikt voor een privéproject."
                            },
                            {
                                "example_id": "cd15a479-1abf-45c7-b3d2-303eafa28f0c",
                                "sense_id": "84bc257a-c5bf-31a1-bea4-a0b0fe2974c3",
                                "text": "Op het moment dat en veilingcatalogus wordt gemaakt, ben je verplicht die aan te bieden aan het Art Loss Register, een database waar alle gestolen kunst van de hele wereld in zit, zegt Vercauteren. Op dat moment kwam de naam Schoonhoven boven. \"Wat ik niet snap is dat Sotheby's in Londen niet onmiddellijk gereageerd heeft op die alarmbel, want die is allesbepalend.\""
                            },
                            {
                                "example_id": "d7d32163-f2dd-47bf-a374-36c058fc6a7b",
                                "sense_id": "84bc257a-c5bf-31a1-bea4-a0b0fe2974c3",
                                "text": "De eigenaar had de vaas laten taxeren toen hij een soortgelijke vaas in een veilingcatalogus voorbij zag komen. Vooraf werd geschat dat de vaas minstens 450.000 euro zou opbrengen."
                            }
                        ]
                    }
