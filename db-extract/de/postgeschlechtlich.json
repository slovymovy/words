                    }
                ],
                "senses": [
                    {
                        "sense_id": "2623053a-19c0-3445-a413-923df9bba329",
                        "entry_id": "0e215a31-1850-3e55-a2c9-321cce6ba631",
                        "glosses": [
                            "sich auf eine Gesellschaft beziehend, in der Menschen nicht mehr einem Geschlecht zugeordnet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e53b7c2c-8706-44f8-8269-1d60bcb74310",
                                "sense_id": "2623053a-19c0-3445-a413-923df9bba329",
                                "text": "„Wird sich das aus dem Patriarchat und dessen Konzept von naturgegebener Sexualität befreiende Männer-Bild in einer offen gehaltenen Geschlechter-Differenz ausgestalten oder sich auflösen in eine postgeschlechtliche Differenz von Personen (Kursbuch: Männer, Berlin 1997)?“"
                            },
                            {
                                "example_id": "9bb9c7c8-ce51-4e52-aac1-ebcd1d55163d",
                                "sense_id": "2623053a-19c0-3445-a413-923df9bba329",
                                "text": "„Eine Vorläuferstellung kommt in diesem Bereich dem Berliner Künstlerpaar EVA & ADELE zu, das seit 1991 bei künstlerischen Ereignissen wie im Alltag in selbst entworfenen Fantasiekleidern als postgeschlechtliche Personen auftritt, als Fusionen von Mann und Frau und als engelsartige Erscheinungen aus der Zukunft, wobei sie in Verarbeitung dieser Erfahrung neue autofiktionale Ausdrucksformen in Malerei, Zeichnung, Fotografie und Video entwickeln.“"
                            },
                            {
                                "example_id": "d205299c-3890-4afe-9420-44ce81cb4950",
                                "sense_id": "2623053a-19c0-3445-a413-923df9bba329",
                                "text": "„Insbesondere im akademischen Diskurs wurden Ideen einer ‚postgeschlechtlichen Epoche‘ aufgegriffen, in der sich Menschen jenseits von Geschlechtlichkeiten begegneten.“"
                            },
                            {
                                "example_id": "31bd80b1-9f7a-40ea-8161-1ffe7a983edb",
                                "sense_id": "2623053a-19c0-3445-a413-923df9bba329",
                                "text": "„Die Grüne Jugend träumt von einer normbefreiten, postgeschlechtlichen Zukunft.“"
                            },
                            {
                                "example_id": "f9be131e-1f9b-4442-a129-d726ac1a92d8",
                                "sense_id": "2623053a-19c0-3445-a413-923df9bba329",
                                "text": "„Sie treibt ihre Interpretation des einsamen Superstars der späten Sechzigerjahre ins fast postgeschlechtlich Androgyne – und so wirkt ihr Dylan wie ein düster egomanischer Vorläufer David Bowies aus Haynes’ Glamrock-Hymne ‚Velvet Goldmine‘ (1998).“"
                            },
                            {
                                "example_id": "96294371-c0ff-4c77-aa78-02222cfb1c40",
                                "sense_id": "2623053a-19c0-3445-a413-923df9bba329",
                                "text": "„Der Cyborg ist ein Wesen in einer postgeschlechtlichen Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac135658-e653-4b59-8e01-78b2c95877cf",
                        "source_entry_id": "0e215a31-1850-3e55-a2c9-321cce6ba631",
                        "source_sense_id": "2623053a-19c0-3445-a413-923df9bba329",
                        "source_sense_description": "sich auf eine Gesellschaft beziehend, in der Menschen nicht mehr einem Geschlecht zugeordnet werden",
                        "target_lang_word": "postgender",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "postgender",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dee3fb46-3c37-3615-913c-739e94408160",
                                        "entry_id": "268fc9c2-ecad-37f2-add0-208ec3665e0c",
                                        "glosses": [
                                            "beyond gender; not (any longer) gendered."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51c38519-acbc-4162-be4e-c53cd0b77657",
                                                "sense_id": "dee3fb46-3c37-3615-913c-739e94408160",
                                                "text": "Gay and lesbian folks don't have a corner on the market — of course there are straight people who think about gender — but odds were better that our gay and lesbian friends were going to be a little more postgender in their thinking, […]"
                                            },
                                            {
                                                "example_id": "30e4fec3-cc71-4878-a813-c192c358afc7",
                                                "sense_id": "dee3fb46-3c37-3615-913c-739e94408160",
                                                "text": "Those who gesture with revolutionary fervor toward a postgender or post-binary or post-male-dominated world cannot, as the old saw has it, get there from here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55ca842b-f546-313c-945d-6f2666fc9716",
                                        "entry_id": "268fc9c2-ecad-37f2-add0-208ec3665e0c",
                                        "glosses": [
                                            "Which divides household labor equally or in a manner other than according to traditional gender roles."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dba115f6-d733-4413-a955-b9ce3fc990f5",
                                                "sense_id": "55ca842b-f546-313c-945d-6f2666fc9716",
                                                "text": "Traditional gender manifests itself among postgender dual-career couples in a common, but not universal, tendency for wives to hold higher standards for household cleanliness."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "postgender",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acec9fb3-56d3-396d-8a31-a27bc7b99839",
                                        "entry_id": "44ce11eb-c4cf-30ef-9316-df5a8f731f46",
                                        "glosses": [
                                            "A person who is postgender, who is not (any longer) gendered, or who does not (any longer) identify as gendered."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2d3f600-c182-478b-8608-2ed81bb4253d",
                                                "sense_id": "acec9fb3-56d3-396d-8a31-a27bc7b99839",
                                                "text": "Contributors to Posthuman Bodies, edited by Judith Halberstam and Ira Livingston, offer futuristic looks at \"queers,\" trans-genders, postgenders, and automated teller machines,"
                                            },
                                            {
                                                "example_id": "dbcbe5a5-574e-4b89-ae10-14a4f784017b",
                                                "sense_id": "acec9fb3-56d3-396d-8a31-a27bc7b99839",
                                                "text": "Similarly, there will be all sorts of individuals among trans-people too: we are not represented by transsexuals only, there are transvestites, transgenders, genderblenders, postgenders etc. in our midst."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
