                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99a49147-5917-4fc4-99be-1b5b0932b838",
                                                "sense_id": "71474931-7e51-318e-a720-2f4b6d5ad983",
                                                "text": "Et le voilà qui se met à signer, à signer… sans les lire, une demi-douzaine d’actes notariés, lui qui ne mettait jamais son parafe sur un acte sans l’épeler, pour ainsi dire, lettre par lettre."
                                            }
