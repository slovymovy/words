                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это была, <w>пожалуй</w>, самая крупная сделка в истории отрасли.",
                            "target_lang_translations": {
                                "en": "It was, <w>perhaps</w>, the biggest deal in the industry's history.",
                                "nl": "Dit was <w>misschien</w> wel de grootste deal in de geschiedenis van de sector.",
                                "pl": "To była, <w>chyba</w>, największa transakcja w historii branży.",
                                "de": "Das war <w>wohl</w> das größte Geschäft in der Geschichte der Branche.",
                                "fr": "C'était, <w>peut-être</w>, la plus grosse transaction de l'histoire du secteur.",
                                "it": "È stato, <w>forse</w>, l'affare più grande nella storia del settore.",
                                "cs": "Byl to <w>možná</w> největší obchod v historii odvětví.",
                                "tr": "Bu, <w>belki de</w> sektör tarihindeki en büyük anlaşmaydı.",
                                "es": "Fue, <w>quizás</w>, el acuerdo más grande en la historia de la industria.",
                                "zh": "这<w>大概</w>是该行业历史上最大的一笔交易。"
                            }
                        },
                        {
                            "text": "Было уже, <w>пожалуй</w>, за полночь, когда гости начали расходиться.",
                            "target_lang_translations": {
                                "en": "It was already, <w>probably</w>, past midnight when the guests started to leave.",
                                "nl": "Het was <w>waarschijnlijk</w> al na middernacht toen de gasten begonnen te vertrekken.",
                                "pl": "Było już, <w>chyba</w>, po północy, kiedy goście zaczęli się rozchodzić.",
                                "de": "Es war <w>vielleicht</w> schon nach Mitternacht, als die Gäste anfingen zu gehen.",
                                "fr": "Il était déjà, <w>probablement</w>, minuit passé quand les invités ont commencé à partir.",
                                "it": "Era già, <w>probabilmente</w>, passata mezzanotte quando gli ospiti hanno iniziato ad andare via.",
                                "cs": "Bylo už <w>asi</w> po půlnoci, když se hosté začali rozcházet.",
                                "tr": "Konuklar dağılmaya başladığında saat <w>galiba</w> gece yarısını geçmişti.",
                                "es": "Ya era, <w>probablemente</w>, pasada la medianoche cuando los invitados comenzaron a irse.",
                                "zh": "客人们开始离开时，<w>或许</w>已经过了午夜。"
                            }
                        }
