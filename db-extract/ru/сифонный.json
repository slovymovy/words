                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65f0f64d-23f4-4e91-9135-0d9011bc977d",
                                                "sense_id": "adf651c8-cc4c-340d-a9aa-acb62be5f67b",
                                                "text": "He used a rubber tube to siphon petrol from the car's fuel tank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50e90af7-7e9d-34ff-9d00-1d14ebe7b20b",
                                        "entry_id": "004573a3-862d-316b-be0a-8091059525d1",
                                        "glosses": [
                                            "To transfer directly."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "290fa6ad-d462-4136-ac67-5a9415d22d6a",
                                                "sense_id": "50e90af7-7e9d-34ff-9d00-1d14ebe7b20b",
                                                "text": "Today's teenagers are siphoning dangerous levels of membrane-damaging noise directly into their eardrums, with long-term effects that otologists prophesy will be disastrous for their hearing and lead to an epidemic of middle-aged deafness in the next thirty years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7398a5a-5aa3-31df-9dc2-463b22241a44",
                                        "entry_id": "004573a3-862d-316b-be0a-8091059525d1",
                                        "glosses": [
                                            "To steal or skim off something, such as money, in small amounts; to embezzle."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55450d7a-4d0e-4ac9-9794-bf1fa25f8e89",
                                                "sense_id": "f7398a5a-5aa3-31df-9dc2-463b22241a44",
                                                "text": "In Juchipila power to the whole community of thirty thousand evaporated as the supraheavy grid buried alongside the little mountain cantina siphoned energy from the entire west-central portion of the Namerican national power net."
                                            },
                                            {
                                                "example_id": "a479ea7e-15da-40e4-890a-9304c356e3d8",
                                                "sense_id": "f7398a5a-5aa3-31df-9dc2-463b22241a44",
                                                "text": "Attempting to “unfeel” whatever you feel is a huge drain on your energy, and that effort can siphon off the power you need to crunch your problem."
                                            },
                                            {
                                                "example_id": "3a9eb35d-dd08-4d7c-b535-3164788491c7",
                                                "sense_id": "f7398a5a-5aa3-31df-9dc2-463b22241a44",
                                                "text": "Artiles, a Republican operative with a reputation for a foul mouth and sharp elbows, is accused of financing a sham candidate whose candidacy was intended to siphon votes from a legitimate Democratic candidate in a state Senate race in South Florida’s 37th District. The candidate has the same last name as then-Democratic incumbent Jose Javier Rodriguez but did not actively campaign for the seat and has since admitted being recruited as a spoiler."
                                            }
                                        ]
                                    }
                                ]
