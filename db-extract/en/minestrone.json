                                        "glosses": [
                                            "stevige groentesoep met deegwaar of graan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c9dfce1-8f4d-4f86-9c55-81026fe7d319",
                                                "sense_id": "24feef55-d192-3674-ad27-c907c62c5a7d",
                                                "text": "Als voorgerecht at men graag fruit, eventueel met ham, zoals nu nog in Italië. 's Avonds een stevige soep met veel groenten, een soort \"minestrone\", of bouillon met eieren, kaas en geroosterd brood, waarin de \"zuppa pavese\" is te herkennen, en grote witte bonen, gestoofd in olijfolie met salie, ui en knoflook, nog altijd één van de meest traditionele en meest geliefde gerechten in Toscane."
                                            },
                                            {
                                                "example_id": "1ec82734-fc66-4481-b669-d6c7c0a7bc32",
                                                "sense_id": "24feef55-d192-3674-ad27-c907c62c5a7d",
                                                "text": "De meest geliefkoosde geregten der Milanezen zijn: de minestrone, rijstsoep met groente, en de risotto, 30 à 40 c. de portie."
                                            }
                                        ]
                                    }
                                ]
                            }
