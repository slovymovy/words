                            },
                            {
                                "example_id": "36eb872b-8ab0-4e0f-8f6e-8367e7eb3156",
                                "sense_id": "f09eeffb-b42c-3d96-9d42-4aac80828286",
                                "text": "La couronne de comte est perlée."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd1a890e-6aee-3a67-8690-4d4012eaa2a0",
                        "entry_id": "cd2a55e2-e80b-3818-a684-613e96226752",
                        "glosses": [
