                    {
                        "sense_id": "09c0385b-b785-30ff-b838-9e401b0598ab",
                        "entry_id": "9504eaa5-bd39-3c80-9a1e-ef3e923526f4",
                        "glosses": [
                            "Glycol : diol non géminal, souvent vicinal."
                        ],
                        "tags": [
                            "Chimie organique"
                        ],
                        "examples": [
                            {
                                "example_id": "adc05db2-d8ea-4ab1-babf-045575737b2e",
                                "sense_id": "09c0385b-b785-30ff-b838-9e401b0598ab",
                                "text": "Glykole werden in Frostschutzmitteln verwendet.",
                                "translation": "Les glycols sont utilisés dans des produits antigel."
                            }
                        ]
                    },
                    {
                        "sense_id": "0912db7c-aea9-3265-879c-ac0a4a22a6c3",
                        "entry_id": "9504eaa5-bd39-3c80-9a1e-ef3e923526f4",
                        "glosses": [
                            "Glycol : éthylène glycol, le plus simple des glycols au sens 1."
                        ],
                        "tags": [
                            "especially",
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "29530e74-a86a-49b9-9410-280a64347923",
                                "sense_id": "0912db7c-aea9-3265-879c-ac0a4a22a6c3",
                                "text": "Glykol ist das einfachste nichtgeminale Diol.",
                                "translation": "Le glycol est le plus simple des diols non géminaux. Note : Le plus simple des diols en absolu est le méthanediol, mais ce diol géminal – qui n’est donc pas un glycol – est peu stable."
                            }
                        ]
                    }
