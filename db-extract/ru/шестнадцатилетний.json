                            {
                                "example_id": "d6ab2f77-8566-4dce-9be5-4b345f6311fe",
                                "sense_id": "4315e1e9-3a0e-3efa-8c22-12b8ab087f4d",
                                "text": "шестнадцатиле́тняя де́вушка",
                                "translation": "a girl of sixteen; a sixteen-year-old girl",
                                "english": "a girl of sixteen; a sixteen-year-old girl"
                            },
                            {
                                "example_id": "acf1d252-e792-4775-b2a7-95f999b100e0",
                                "sense_id": "4315e1e9-3a0e-3efa-8c22-12b8ab087f4d",
                                "text": "Во второ́м этаже́ на́шего до́ма помеща́лась золотошве́йня, и в ней, среди́ мно́гих де́вушек-мастери́ц, жила́ шестнадцатиле́тняя го́рничная Та́ня.",
                                "translation": "The second story of our house was occupied by an embroidery shop, and there, among many girl workers, lived the sixteen year old chamber-maid, Tanya.",
                                "english": "The second story of our house was occupied by an embroidery shop, and there, among many girl workers, lived the sixteen year old chamber-maid, Tanya."
                            }
