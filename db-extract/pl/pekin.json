                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98f274e5-77c1-4634-935f-7f81d7d26321",
                                "sense_id": "3012f326-8c06-3c0f-bb28-da52ebeaa0f5",
                                "text": "Podczas ferii zimowych mieszkaliśmy w najdroższym hotelu w Pekinie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
