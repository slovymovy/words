                                                "example_id": "e7653d78-ffb5-448d-aa84-aa90d7780230",
                                                "sense_id": "01a7b818-8185-3cd7-b216-37dd2e4af31f",
                                                "text": "Feuilles, tige velues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "187e5bb9-5031-3340-9f77-049444f3d15e",
                                        "entry_id": "b9aeeb3a-ad34-3ad6-84dd-c6465e101d0d",
                                        "glosses": [
                                            "Brut, non dégrossi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "987722f4-42a0-4437-85e6-96c7c9142ae6",
                                                "sense_id": "187e5bb9-5031-3340-9f77-049444f3d15e",
                                                "text": "Pierre velue, pierre à bâtir telle qu’elle sort de la carrière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fdf789d-5dd3-35d0-9942-fcd9490f0744",
                                        "entry_id": "b9aeeb3a-ad34-3ad6-84dd-c6465e101d0d",
                                        "glosses": [
                                            "Qui est couvert d’une végétation abondante → voir chevelu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c83665e-7ed1-4087-801a-9f2783393a15",
                                                "sense_id": "0fdf789d-5dd3-35d0-9942-fcd9490f0744",
                                                "text": "À sa droite des collines velues en haut desquelles des moulins agitaient leurs ailes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc0f6c0d-a575-38de-a653-ddd8b751212e",
                                        "entry_id": "b9aeeb3a-ad34-3ad6-84dd-c6465e101d0d",
                                        "glosses": [
                                            "Particulièrement complexe, difficile à comprendre pour les non-initiés."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec7da351-2c3a-4a49-bd09-ecf1a2d13f0d",
                                                "sense_id": "cc0f6c0d-a575-38de-a653-ddd8b751212e",
                                                "text": "Perceval : Le plus facile à apprendre, c’est le sirop. […] Enfin, avec mes règles simplifiées, parce que les règles originales, elles sont velues."
                                            }
                                        ]
