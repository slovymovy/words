                                                "sense_id": "194d6e21-59c5-3e6a-9870-7e0f90019d78",
                                                "text": "Hark, countrymen! either renew the fight, / Or tear the lions out of England's coat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5cf416b-c658-3db2-89c8-d97bcc452aa7",
                                        "entry_id": "0a3cdcfb-5b2f-37b5-bd84-0eadd6ac4ba9",
                                        "glosses": [
                                            "A coat card."
                                        ],
                                        "tags": [
