                ],
                "senses": [
                    {
                        "sense_id": "45fa8d92-7296-3068-9f6e-6b876d116dbb",
                        "entry_id": "91846e8b-4f62-3a54-ae62-de341b5535cf",
                        "glosses": [
                            "zeer schadelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "902f9a27-4ea2-4e89-8526-e98ffb510fb7",
                                "sense_id": "45fa8d92-7296-3068-9f6e-6b876d116dbb",
                                "text": "De Mekong kent een uitzonderlijke visdiversiteit. Critici vrezen dat de damprojecten nefast zullen zijn voor de migratieroutes van de vissen en dus voor de voedselvoorziening van de bevolking, voor wie vis het belangrijkste onderdeel is van de maaltijden. Als alle dammen gebouwd worden, dreigt naar schatting 220.000 tot 440.000 ton witte vis te verdwijnen."
                            },
                            {
                                "example_id": "cbc79d01-9d34-4f78-bb4d-f1b2c83e663f",
                                "sense_id": "45fa8d92-7296-3068-9f6e-6b876d116dbb",
                                "text": "Tegen dat de heli, uit het westen, ter plaatse is heeft die al heel wat brandstof verbruikt. Dan moest die rekening houden met een lange terugvlucht. Dat is nefast bij opsporingsacties of achtervolgingen."
                            }
                        ]
                    }
                ],
