                "senses": [
                    {
                        "sense_id": "520d94ac-a074-3c54-b6c7-76b309b1a011",
                        "entry_id": "8fe47df9-bc16-3ce4-8b30-6d0367695bec",
                        "glosses": [
                            "wie eine Zitrone (schmeckend)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d641e9c4-5258-425a-aa9b-8831c6c50aca",
                                "sense_id": "520d94ac-a074-3c54-b6c7-76b309b1a011",
                                "text": "„Er produziert einen zitronig süßen Geschmack und Geruch, wobei er einen extrem starken, euphorischen und glücklichen Rausch auslöst.“"
                            },
                            {
                                "example_id": "162e0d44-a83c-4f44-82b4-42fa9cb7e210",
                                "sense_id": "520d94ac-a074-3c54-b6c7-76b309b1a011",
                                "text": "„Sein Glas, dachte er, war mit Wasser gefüllt, aber die sprudelnde Flüssigkeit schmeckt ungewohnt lecker, leicht zitronig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
