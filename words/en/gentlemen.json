            "senses": [
                {
                    "sense_id": "b7de2e51-6114-3b2e-bfc9-2796dba3b56d",
                    "sense_definition": "Plural of <w>gentleman</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "people_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ladies and <w>gentlemen</w>, please welcome our next guest to the stage.",
                            "target_lang_translations": {
                                "ru": "Дамы и <w>господа</w>, пожалуйста, поприветствуйте нашего следующего гостя на сцене.",
                                "zh": "女士们、<w>先生们</w>，请欢迎我们的下一位嘉宾上台。"
                            }
                        },
                        {
                            "text": "Two <w>gentlemen</w> in dark suits were waiting in the lobby.",
                            "target_lang_translations": {
                                "ru": "Два <w>джентльмена</w> в темных костюмах ждали в вестибюле.",
                                "zh": "两位身穿深色西装的<w>绅士</w>正在大厅等候。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ladies and gentlemen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число слова «джентльмен»; вежливые, воспитанные мужчины или форма вежливого обращения к группе людей.",
                        "zh": "指有礼貌、有教养的男士，或用于正式场合对一群男性的尊称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "господа",
                                "target_lang_sense_clarification": "вежливое обращение"
                            },
                            {
                                "target_lang_word": "джентльмены",
                                "target_lang_sense_clarification": "воспитанные мужчины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "先生们",
                                "target_lang_sense_clarification": "正式场合的尊称"
                            },
                            {
                                "target_lang_word": "绅士",
                                "target_lang_sense_clarification": "指有教养的男士"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35559ed4-b539-3e14-b243-9268bf354db6",
                    "sense_definition": "A men's room or lavatory intended for use by men.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "place_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Excuse me, could you tell me where the <w>gentlemen</w> is located?",
                            "target_lang_translations": {
                                "ru": "Простите, не могли бы вы подсказать, где находится <w>мужской туалет</w>?",
                                "zh": "打扰一下，请问<w>男洗手间</w>在哪里？"
                            }
                        },
                        {
                            "text": "He excused himself from the table to visit the <w>gentlemen</w>.",
                            "target_lang_translations": {
                                "ru": "Он извинился и вышел из-за стола, чтобы посетить <w>мужскую уборную</w>.",
                                "zh": "他向桌上的人告罪一声，起身去用<w>男洗手间</w>了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужской туалет или уборная (часто используется как вежливый эвфемизм).",
