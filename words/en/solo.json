{
    "word_family": [
        "soloist"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2bd72905-f90d-36dd-a8b9-71f1a70dac73",
                    "sense_definition": "Done by one person alone, without companions or an instructor.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "alone_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She enjoys taking <w>solo</w> trips to different countries to explore at her own pace.",
                            "target_lang_translations": {
                                "ru": "Ей нравится совершать <w>одиночные</w> поездки в разные страны, чтобы исследовать их в своем собственном темпе.",
                                "zh": "她喜欢去不同的国家进行<w>单独</w>旅行，按照自己的节奏探索。"
                            }
                        },
                        {
                            "text": "The pilot was nervous before his first <w>solo</w> flight.",
                            "target_lang_translations": {
                                "ru": "Пилот нервничал перед своим первым <w>самостоятельным</w> полетом.",
                                "zh": "飞行员在第一次<w>单飞</w>前感到很紧张。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unaccompanied",
                        "single-handed",
                        "lone",
                        "solitary",
                        "individual",
                        "private"
                    ],
                    "antonyms": [
                        "accompanied",
                        "joint",
                        "collective"
                    ],
                    "common_phrases": [
                        "solo career",
                        "solo traveler",
                        "solo effort",
                        "solo flight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполняемый одним человеком, без спутников или инструктора.",
                        "zh": "由一个人独自完成，没有同伴或指导。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одиночный",
                                "target_lang_sense_clarification": "без сопровождения (о путешествиях, действиях)"
                            },
                            {
                                "target_lang_word": "самостоятельный",
                                "target_lang_sense_clarification": "без инструктора (о полетах, заданиях)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单独的",
                                "target_lang_sense_clarification": "指没有同伴的"
                            },
                            {
                                "target_lang_word": "独立的",
                                "target_lang_sense_clarification": "指没有指导的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "251b0a49-2433-3004-b748-49a9a1d3d582",
                    "sense_definition": "Relating to a musical performance played or sung by one person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>solo</w> part of the concerto is extremely difficult to play.",
                            "target_lang_translations": {
                                "ru": "<w>Сольная</w> партия концерта чрезвычайно сложна для исполнения.",
                                "zh": "协奏曲的<w>独奏</w>部分极难演奏。"
                            }
                        },
                        {
                            "text": "He released a <w>solo</w> album after leaving the band.",
                            "target_lang_translations": {
                                "ru": "Он выпустил <w>сольный</w> альбом после ухода из группы.",
                                "zh": "离开乐队后，他发行了一张<w>个人</w>专辑。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "solo album",
                        "solo artist",
                        "solo instrument"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к музыкальному исполнению одним человеком.",
                        "zh": "指由一个人演奏或演唱的音乐表演。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сольный",
                                "target_lang_sense_clarification": "музыкальный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "独奏的",
                                "target_lang_sense_clarification": "音乐表演"
                            },
                            {
                                "target_lang_word": "个人的",
                                "target_lang_sense_clarification": "指个人专辑或作品"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "13741087-c637-3ebb-9b4b-86c14103cc53",
                    "sense_definition": "In a way that is done alone, without anyone else.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "alone_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years in a group, the singer decided to go <w>solo</w>.",
                            "target_lang_translations": {
                                "ru": "После многих лет в группе певец решил начать выступать <w>соло</w>.",
                                "zh": "在组合待了多年后，这位歌手决定<w>单飞</w>。"
                            }
                        },
                        {
                            "text": "He prefers to fly <w>solo</w> when working on complex projects.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает работать <w>в одиночку</w>, когда занимается сложными проектами.",
                                "zh": "处理复杂项目时，他更喜欢<w>独自</w>工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "alone",
                        "independently",
                        "single-handedly"
                    ],
                    "antonyms": [
                        "together",
                        "jointly"
                    ],
                    "common_phrases": [
                        "go solo",
                        "fly solo"
                    ],
                    "target_lang_definitions": {
                        "ru": "В одиночку, без чьей-либо помощи или участия.",
                        "zh": "以独自一人的方式，没有他人的帮助或参与。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в одиночку",
                                "target_lang_sense_clarification": "без других людей"
                            },
                            {
                                "target_lang_word": "самостоятельно",
                                "target_lang_sense_clarification": "независимо"
                            },
                            {
                                "target_lang_word": "соло",
                                "target_lang_sense_clarification": "о карьере или выступлении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "独自",
                                "target_lang_sense_clarification": "没有他人"
                            },
                            {
                                "target_lang_word": "单独",
                                "target_lang_sense_clarification": "独立地"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bcf372fa-400d-39f5-bc77-59c8f2d8552f",
                    "sense_definition": "A musical performance given by one person, or a piece of music written for one performer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "music_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drummer played an impressive five-minute <w>solo</w> during the concert.",
                            "target_lang_translations": {
                                "ru": "Барабанщик сыграл впечатляющее пятиминутное <w>соло</w> во время концерта.",
                                "zh": "鼓手在音乐会期间演奏了一段令人印象深刻的五分钟<w>独奏</w>。"
                            }
                        },
                        {
                            "text": "She practiced the violin <w>solo</w> every day for a month.",
                            "target_lang_translations": {
                                "ru": "Она репетировала скрипичное <w>соло</w> каждый день в течение месяца.",
                                "zh": "她练习了一个月的小提琴<w>独奏</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "duet",
                        "ensemble"
                    ],
                    "common_phrases": [
                        "guitar solo",
                        "drum solo",
                        "piano solo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальное произведение или партия для одного исполнителя.",
                        "zh": "由一个人进行的音乐表演，或为一名演奏者创作的乐曲。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соло",
                                "target_lang_sense_clarification": "музыкальное произведение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "独奏",
                                "target_lang_sense_clarification": "音乐表演"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc26f4f2-0b47-39e0-8362-7160abd7bfa0",
                    "sense_definition": "An action or task performed by one person alone, particularly a pilot's first flight without an instructor.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alone_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Completing his first <w>solo</w> was a major milestone in his aviation training.",
                            "target_lang_translations": {
                                "ru": "Завершение первого <w>самостоятельного вылета</w> стало важной вехой в его летной подготовке.",
                                "zh": "完成第一次<w>单飞</w>是他飞行训练中的一个重要里程碑。"
                            }
                        },
                        {
                            "text": "This project is a <w>solo</w>, so I am responsible for everything.",
                            "target_lang_translations": {
                                "ru": "Этот проект — <w>соло</w>, поэтому я отвечаю за всё.",
                                "zh": "这是一个<w>个人项目</w>，所以我对一切负责。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, выполняемое в одиночку, особенно первый самостоятельный полет пилота.",
                        "zh": "由一个人独自完成的行动或任务，尤指飞行员在没有教练陪同下的首次飞行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самостоятельный вылет",
                                "target_lang_sense_clarification": "авиация"
                            },
                            {
                                "target_lang_word": "соло",
                                "target_lang_sense_clarification": "индивидуальное выступление или действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单飞",
                                "target_lang_sense_clarification": "航空术语"
                            },
                            {
                                "target_lang_word": "个人项目",
                                "target_lang_sense_clarification": "独自完成的任务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae4342b7-80df-3c50-95f4-5303618092f2",
                    "sense_definition": "A single shot of espresso coffee.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "coffee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I ordered a <w>solo</w> because I didn't want too much caffeine.",
                            "target_lang_translations": {
                                "ru": "Я заказал <w>соло</w>, потому что не хотел слишком много кофеина.",
                                "zh": "我点了一份<w>单份浓缩咖啡</w>，因为我不想摄入太多咖啡因。"
                            }
                        },
                        {
                            "text": "The barista prepared a <w>solo</w> macchiato for the customer.",
                            "target_lang_translations": {
                                "ru": "Бариста приготовил макиато <w>соло</w> для клиента.",
                                "zh": "咖啡师为顾客准备了一杯<w>单份浓缩咖啡</w>玛奇朵。"
                            }
                        }
                    ],
                    "antonyms": [
                        "doppio"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одинарная порция эспрессо.",
                        "zh": "一份单份浓缩咖啡。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соло",
                                "target_lang_sense_clarification": "кофе"
                            },
                            {
                                "target_lang_word": "одинарный эспрессо",
                                "target_lang_sense_clarification": "напиток"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单份浓缩咖啡",
                                "target_lang_sense_clarification": "咖啡饮品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e5827e7-d83b-3615-8c4f-c41004708180",
                    "sense_definition": "A card game similar to whist where one player plays against the others.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather taught us how to play <w>solo</w> on rainy afternoons.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка учил нас играть в <w>соло</w> дождливыми днями.",
                                "zh": "祖父在雨天的午后教我们玩<w>索罗牌</w>。"
                            }
                        },
                        {
                            "text": "He won the round of <w>solo</w> despite having a difficult hand.",
                            "target_lang_translations": {
                                "ru": "Он выиграл раунд в <w>соло</w>, несмотря на плохие карты на руках.",
                                "zh": "尽管手牌很差，他还是赢得了那局<w>索罗牌</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Карточная игра, похожая на вист, где один игрок играет против остальных.",
                        "zh": "一种类似于惠斯特牌的纸牌游戏，由一名玩家对抗其他玩家。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соло",
                                "target_lang_sense_clarification": "карточная игра"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "索罗牌",
                                "target_lang_sense_clarification": "纸牌游戏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d7d996b-9275-3448-81a1-36ae0c07f4b5",
                    "sense_definition": "To perform a task or activity alone, especially to fly an aircraft without an instructor for the first time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alone_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student pilot is expected to <w>solo</w> after twenty hours of instruction.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что курсант <w>вылетит самостоятельно</w> после двадцати часов обучения.",
                                "zh": "学员飞行员预计在接受二十小时指导后可以<w>单飞</w>。"
                            }
                        },
                        {
                            "text": "She decided to <w>solo</w> on the project rather than waiting for a team.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>работать в одиночку</w> над проектом, вместо того чтобы ждать команду.",
                                "zh": "她决定<w>独自</w>完成这个项目，而不是等待团队。"
                            }
