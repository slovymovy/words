                "senses": [
                    {
                        "sense_id": "b097e31c-a7bf-31d8-bafc-c2a9523da580",
                        "entry_id": "29065472-7570-38d7-a524-efb6b2a61cd3",
                        "glosses": [
                            "ein geschlossenes Warengestell mit Kühltechnik in dem Tiefkühlprodukte lagern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63840759-93e2-49ad-bd95-9cc4553a6a83",
                                "sense_id": "b097e31c-a7bf-31d8-bafc-c2a9523da580",
                                "text": "Im Tiefkühlregal lagern Waren bei −15 °C bis −25 °C und es hat eine dicht schließende Glastür, so dass man bereits vor dem Öffnen der Tür zwischen den einzelnen Tiefkühlprodukten auswählen kann."
                            },
                            {
                                "example_id": "73c091f8-fcd5-494d-bf81-bd36533991b1",
                                "sense_id": "b097e31c-a7bf-31d8-bafc-c2a9523da580",
                                "text": "„Im Tiefkühlregal des Supermarktes gibt es eine riesige Auswahl an Lebensmitteln, Halbfertigprodukten und kompletten Menüs.“"
                            },
                            {
                                "example_id": "8c118b08-9387-4bdb-a4cb-6f3b73f238b8",
                                "sense_id": "b097e31c-a7bf-31d8-bafc-c2a9523da580",
                                "text": "„Eine sehr gute Alternative bieten Kräuter aus dem Tiefkühlregal! “"
                            },
                            {
                                "example_id": "d3050483-2dae-4a24-a5df-82294e8190c5",
                                "sense_id": "b097e31c-a7bf-31d8-bafc-c2a9523da580",
                                "text": "„Bei diesen Produkten ist Skepsis gegenüber den Tiefkühlregalen sicher angebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
