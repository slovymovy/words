                        "target_lang_word": "Striegel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Striegel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90fcf61c-18ca-3391-bb20-cba1f49b2819",
                                        "entry_id": "8f4ecc6d-09e2-394d-9e91-6667c2f50f41",
                                        "glosses": [
                                            "gezähntes Gerät, harte Bürste zum Reinigen und zur Fellpflege bestimmter Haustiere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d8fb781-1b72-4751-b174-5f6d21cf6367",
                                                "sense_id": "90fcf61c-18ca-3391-bb20-cba1f49b2819",
                                                "text": "Seit der Antike wird der grobe Schmutz mit einem Striegel aus dem Pferdefell gekratzt, bevor es mit der weicheren Bürste (Kardätsche) gesäubert und geglättet wird."
                                            },
                                            {
                                                "example_id": "6efdf6c6-7212-448e-a5e6-e36ce694168c",
                                                "sense_id": "90fcf61c-18ca-3391-bb20-cba1f49b2819",
                                                "text": "Der Striegel ist ursprünglich ein eiserner Kamm, der mit zwei oder mehreren Reihen kurzer Zähne versehen ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c38b64a4-a2fc-3817-978f-750fdd774f5c",
                                        "entry_id": "8f4ecc6d-09e2-394d-9e91-6667c2f50f41",
                                        "glosses": [
                                            "Gerät zum Abschaben der Kruste aus Öl, Staub und Schweiß"
                                        ],
                                        "tags": [
                                            "Antike",
                                            "Sportutensil"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db41f071-8ee8-4b53-807b-58fa701c2e0d",
                                                "sense_id": "c38b64a4-a2fc-3817-978f-750fdd774f5c",
                                                "text": "Die Marmorstatue stellt einen Athleten dar, der sich mit dem Striegel in der linken Hand Sand und Öl vom ausgestreckten rechten Arm entfernt."
                                            },
                                            {
                                                "example_id": "98225994-84b7-4e95-af71-5f8c2bdd6f47",
                                                "sense_id": "c38b64a4-a2fc-3817-978f-750fdd774f5c",
                                                "text": "Unterdessen feierte der Arkadier Xenias die Lycäen mit Opfern und Kampfspielen, und setzte goldene Striegel als Preis aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
