    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f77ac37c-9830-30e4-b167-ff8e75105c67",
                    "sense_definition": "Not welcome; causing discomfort, annoyance, or regret.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news of unexpected budget cuts came as an <w>unwelcome</w> surprise to the entire team.",
                            "target_lang_translations": {
                                "ru": "Новость о неожиданном сокращении бюджета стала <w>неприятным</w> сюрпризом для всей команды."
                            }
                        },
                        {
                            "text": "His cold manner made me feel like an <w>unwelcome</w> guest in the house.",
                            "target_lang_translations": {
                                "ru": "Его холодное обращение заставило меня почувствовать себя <w>нежеланным</w> гостем в этом доме."
                            }
                        }
                    ],
                    "synonyms": [
                        "undesirable",
                        "unwanted"
                    ],
                    "antonyms": [
                        "welcome"
                    ],
                    "common_phrases": [
                        "unwelcome surprise",
                        "unwelcome guest",
                        "unwelcome attention",
                        "unwelcome reminder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нежелательный, неприятный или вызывающий дискомфорт; тот, кому не рады."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нежеланный",
                                "target_lang_sense_clarification": "о госте, событии или чувстве, которому не рады"
                            },
                            {
                                "target_lang_word": "нежелательный",
                                "target_lang_sense_clarification": "о последствиях, сюрпризах или внимании"
                            },
                            {
                                "target_lang_word": "неприятный",
                                "target_lang_sense_clarification": "вызывающий досаду или огорчение"
                            },
                            {
                                "target_lang_word": "незваный",
                                "target_lang_sense_clarification": "пришедший без приглашения, нежданный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9abfd991-0328-3f07-84c6-73dc43c946a8",
                    "sense_definition": "To treat someone as unwelcome or make them feel unwanted.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local residents gathered outside to <w>unwelcome</w> the controversial politician.",
                            "target_lang_translations": {
                                "ru": "Местные жители собрались снаружи, чтобы <w>оказать холодный прием</w> неоднозначному политику."
                            }
                        },
                        {
                            "text": "Nobody spoke to him at the gathering, effectively choosing to <w>unwelcome</w> him.",
                            "target_lang_translations": {
                                "ru": "На встрече с ним никто не разговаривал, решив тем самым дать ему понять, что <w>ему здесь не рады</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cold-shoulder",
                        "reject"
                    ],
                    "antonyms": [
                        "welcome"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказывать нерадушный прием; давать понять кому-либо, что ему здесь не рады."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нерадушно принять",
                                "target_lang_sense_clarification": "встретить холодно или враждебно"
                            },
                            {
                                "target_lang_word": "оказать холодный прием",
                                "target_lang_sense_clarification": "продемонстрировать нежелание видеть кого-либо"
                            },
                            {
                                "target_lang_word": "проигнорировать",
                                "target_lang_sense_clarification": "показать нежелательность присутствия через игнорирование"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}