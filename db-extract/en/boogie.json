                    {
                        "sense_id": "c02aeafb-879c-35ba-9d85-485923fadec1",
                        "entry_id": "3ef16d2f-17de-3862-8ac8-cad90521b377",
                        "glosses": [
                            "To move, walk, leave, exit."
