                "senses": [
                    {
                        "sense_id": "ac233574-ccf5-3eac-ba4c-a5ed6ca17dab",
                        "entry_id": "ceeac719-372a-3f86-a2fc-f169cf9123e4",
                        "glosses": [
                            "An area of rolling hills (downs), often grassy pasture over chalk or limestone."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "def9d2d0-b153-40e1-960d-ba4f92cecf50",
                                "sense_id": "ac233574-ccf5-3eac-ba4c-a5ed6ca17dab",
                                "text": "Hail! every distant hill, and downland plain!\nYour dew-hid beauties Fancy oft unveils;"
                            },
                            {
                                "example_id": "36969d75-dc81-4dc7-a3dd-69788d98828d",
                                "sense_id": "ac233574-ccf5-3eac-ba4c-a5ed6ca17dab",
                                "text": "[…] I walked on to Canterbury early in the morning. It was now winter again; and the fresh, cold windy day, and the sweeping downland, brightened up my hopes a little."
                            },
                            {
                                "example_id": "8549456e-7e48-45d6-a36b-30b6941ba7ca",
                                "sense_id": "ac233574-ccf5-3eac-ba4c-a5ed6ca17dab",
                                "text": "I traversed the downland\nWhereon the bleak hill-graves of Chieftains\nBulge barren of tree;"
                            },
                            {
                                "example_id": "571486df-3317-47cc-a764-187456599323",
                                "sense_id": "ac233574-ccf5-3eac-ba4c-a5ed6ca17dab",
                                "text": "Shortly after leaving Godshill, a lengthy climb begins through rolling downland country at 1 in 75, easing to 1 in 103."
                            },
                            {
                                "example_id": "f989f010-6e47-43b4-85c0-03512322ac8b",
                                "sense_id": "ac233574-ccf5-3eac-ba4c-a5ed6ca17dab",
                                "text": "The large cement works nearby are served by sidings, and strike a sudden jarring industrial note in the midst of the rural downland scene."
                            },
                            {
                                "example_id": "eae97c50-b7d4-46c5-8cc1-b06783e9a0f1",
                                "sense_id": "ac233574-ccf5-3eac-ba4c-a5ed6ca17dab",
                                "text": "I was surprised to see that the plane had been wrecked, not on one of the hefty cliff faces of our mountain, but on a gentle green hillside, merging into downland."
                            },
                            {
                                "example_id": "86d93a64-9069-4fd6-8e86-ff840d3c4786",
                                "sense_id": "ac233574-ccf5-3eac-ba4c-a5ed6ca17dab",
                                "text": "He drank another whisky then left the pub and climbed slowly up the downlands, bent as the trees and shrubs were bent."
                            }
                        ]
                    }
                ],
