                    },
                    {
                        "translation_id": "07fe0c69-e9f0-4539-bc54-5bfbd8d49830",
                        "source_entry_id": "788bd407-bbd8-3b2f-87d5-844192ef6639",
                        "source_sense_id": "84f186f4-dc23-3c46-afe3-86351f69819c",
                        "source_sense_description": "een op een speciale manier ingepakt cadeau",
                        "target_lang_word": "surprise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surprise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28da8989-1cf0-3005-b37b-223af19d26ad",
                                        "entry_id": "48c3a467-c0a6-3dbb-b892-3233623607d3",
                                        "glosses": [
                                            "Action par laquelle on surprend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "274dd258-c167-4506-8125-980e29e5b03f",
                                                "sense_id": "28da8989-1cf0-3005-b37b-223af19d26ad",
                                                "text": "Il s’est rendu maître de cette place par surprise."
                                            },
                                            {
                                                "example_id": "7a13f188-f9a5-4ad1-916f-807d067e6092",
                                                "sense_id": "28da8989-1cf0-3005-b37b-223af19d26ad",
                                                "text": "Il a usé de surprise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ad8a36a-e81c-3ba5-a45f-d3f79a4907a7",
                                        "entry_id": "48c3a467-c0a6-3dbb-b892-3233623607d3",
                                        "glosses": [
                                            "Événement inattendu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a9eecc5-d1d5-4c4b-81d9-9ac4ab330fb9",
                                                "sense_id": "2ad8a36a-e81c-3ba5-a45f-d3f79a4907a7",
                                                "text": "Pour éviter les surprises, je ne traiterai avec lui que par écrit."
                                            },
                                            {
                                                "example_id": "a3b4d595-7469-407b-8968-2ac3fdc547fb",
                                                "sense_id": "2ad8a36a-e81c-3ba5-a45f-d3f79a4907a7",
                                                "text": "Se défendre de la surprise des sens, des surprises de l’amour-propre."
                                            },
                                            {
                                                "example_id": "4903202d-ed07-460b-bf33-5a46de07f093",
                                                "sense_id": "2ad8a36a-e81c-3ba5-a45f-d3f79a4907a7",
                                                "text": "Faire une surprise à quelqu’un. — Ménager à quelqu’un une surprise agréable."
                                            },
                                            {
                                                "example_id": "1f6e90dd-b7d8-40de-a18f-63b75d2616a0",
                                                "sense_id": "2ad8a36a-e81c-3ba5-a45f-d3f79a4907a7",
                                                "text": "Qu'est-ce qu'une surprise? Un événement inattendu qui provoque en nous de la peine ou de la joie; c'est bref, une surprise; on s'en remet toujours, qu'elle soit bonne ou mauvaise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce8c7ff1-3cbc-3c93-9462-ef5501118820",
                                        "entry_id": "48c3a467-c0a6-3dbb-b892-3233623607d3",
                                        "glosses": [
                                            "Qui n'est pas attendu."
                                        ],
                                        "tags": [
                                            "En apposition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "840021c6-ed63-4774-9949-e814b17870f2",
                                                "sense_id": "ce8c7ff1-3cbc-3c93-9462-ef5501118820",
                                                "text": "Cela par esprit de repartie, pour la raison qu’à la mi-février les Allemands, profitant d’une relève sans doute nonchalante, avaient lancé une attaque surprise qui leur avait permis d'avancer sur un front d'un kilomètre et demi au sud de Ripont. Il s’agissait de regagner coûte que coûte le terrain perdu..."
                                            },
                                            {
                                                "example_id": "c148037e-84dd-4890-ae5a-543edcfc2ef4",
                                                "sense_id": "ce8c7ff1-3cbc-3c93-9462-ef5501118820",
                                                "text": "Un cadeau surprise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceb8ff6b-827d-36c2-9b0f-9f2b66597a70",
                                        "entry_id": "48c3a467-c0a6-3dbb-b892-3233623607d3",
                                        "glosses": [
                                            "Qui réserve une surprise; dont le contenu n'est pas révélé d'emblée."
                                        ],
                                        "tags": [
                                            "En apposition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44256899-78f3-4cc9-aa79-1ce1d4ad7303",
                                                "sense_id": "ceb8ff6b-827d-36c2-9b0f-9f2b66597a70",
                                                "text": "Une pochette surprise ; un cornet surprise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97bf3fdf-b440-3a9c-a011-3aef14c8445d",
                                        "entry_id": "48c3a467-c0a6-3dbb-b892-3233623607d3",
                                        "glosses": [
                                            "État de l’esprit qui est frappé par quelque chose d’inattendu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01176643-c0fb-426e-83ca-6d8235c2d977",
                                                "sense_id": "97bf3fdf-b440-3a9c-a011-3aef14c8445d",
                                                "text": "Mais, comme elle débouchait enfin sur la place Gaillon, la jeune fille s’arrêta net de surprise."
                                            },
                                            {
                                                "example_id": "1ae45b08-3c6c-4551-a8c9-af8cf4beaeb8",
                                                "sense_id": "97bf3fdf-b440-3a9c-a011-3aef14c8445d",
                                                "text": "Grande donc fut sa surprise lorsque […] il se vit appréhender vigoureusement par deux douaniers qui s’étaient dissimulés dans l’intérieur du taillis et dont il n’avait naturellement pu soupçonner la présence."
                                            },
                                            {
                                                "example_id": "f069f851-b43a-4b7a-8e5f-93afaec69b9b",
                                                "sense_id": "97bf3fdf-b440-3a9c-a011-3aef14c8445d",
                                                "text": "Cet accident a causé une grande surprise. — Tout le monde fut dans une profonde surprise. — Je ne reviens pas de ma surprise."
                                            },
                                            {
                                                "example_id": "52668cac-39b0-4f36-a698-ae8e302a3f49",
                                                "sense_id": "97bf3fdf-b440-3a9c-a011-3aef14c8445d",
                                                "text": "Éprouver une douce surprise."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "surprise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95aad4e3-3be0-3721-93d2-f33dd19bd62b",
                                        "entry_id": "cfc3cc8f-3b4b-3715-a1ab-69781aeaef0a",
                                        "glosses": [
                                            "Féminin singulier de surpris."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bca90db8-61ec-4d4a-9728-906460fdbaa6",
                                                "sense_id": "95aad4e3-3be0-3721-93d2-f33dd19bd62b",
                                                "text": "Quand elle recadre le président de la fédération de gymnastique [James Blateau] en lui disant qu’il a un pouvoir de sanction, même elle est surprise qu’il ne le sache pas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "surprise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af5c2953-fe54-338e-82d2-152ab0ad0d26",
                                        "entry_id": "661bcc78-d01d-3a30-844b-285f2ca6f58f",
                                        "glosses": [
                                            "Participe passé féminin singulier de surprendre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4f39d3e-5f66-422c-b59d-1fbab38b825c",
                                                "sense_id": "af5c2953-fe54-338e-82d2-152ab0ad0d26",
                                                "text": "Je l’avais surprise en train de flirtailler avec un échalas de treize ans, Antoine, qui n’avait pour lui que la situation sociale de son père, conseiller municipal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
