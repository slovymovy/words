                "senses": [
                    {
                        "sense_id": "4ad21a67-8b16-36d4-8995-f66b7745f267",
                        "entry_id": "32bc5721-a6f1-3095-ab11-a833a338fd7b",
                        "glosses": [
                            "sphärische Linse mit positiver, vergrößernder Brechkraft, die parallel eingestrahltes Licht sammelt und es in der Brennebene fokussiert"
                        ],
                        "tags": [
                            "Optik"
                        ],
                        "examples": [
                            {
                                "example_id": "4b6ce9e7-4d51-4495-afe8-665ca12304f2",
                                "sense_id": "4ad21a67-8b16-36d4-8995-f66b7745f267",
                                "text": "Sammellinsen können bikonvex, plankonvex oder konkav-konvex sein."
                            },
                            {
                                "example_id": "21ae9594-8688-405e-b5b8-d02707688b1d",
                                "sense_id": "4ad21a67-8b16-36d4-8995-f66b7745f267",
                                "text": "Sie [die Platte] ist in der Mitte zu einer Sammellinse geschliffen, die nach außen hin von prismenförmigen Ringen umgeben ist, so daß die Sammelwirkung einer viel größeren Linse erreicht wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
