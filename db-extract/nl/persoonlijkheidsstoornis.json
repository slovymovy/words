                "senses": [
                    {
                        "sense_id": "364904a2-a561-321e-a31c-adcb0ce865bf",
                        "entry_id": "770394fd-8500-3125-8cc5-7d5109c71905",
                        "glosses": [
                            "stoornis in de persoonlijkheid die normaal functioneren hindert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b17aae7-9b65-4d35-9be4-bb56a0938c81",
                                "sense_id": "364904a2-a561-321e-a31c-adcb0ce865bf",
                                "text": "'Ik geloof met honderd procent zekerheid dat Trump voldoet aan de criteria van een onbehandelbare persoonlijkheidsstoornis'"
                            },
                            {
                                "example_id": "e438b859-c6eb-4a03-b747-de82a525e5fd",
                                "sense_id": "364904a2-a561-321e-a31c-adcb0ce865bf",
                                "text": "‘Van Hitler, Mao Zedong en Stalin staat wel min of meer vast dat ze een narcistische persoonlijkheidsstoornis hadden, zij voldeden aan de uiterlijke kenmerken én er is genoeg biografische kennis over hen verzameld. Nou, we weten wat die drie in de wereldgeschiedenis hebben aangericht.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c213709c-1de9-46f8-afaf-243113b5aaa4",
                        "source_entry_id": "770394fd-8500-3125-8cc5-7d5109c71905",
                        "source_sense_id": "364904a2-a561-321e-a31c-adcb0ce865bf",
                        "target_lang_word": "personality disorder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "personality disorder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab238321-f0ff-3f3d-b298-ae48dc0499da",
                                        "entry_id": "837dfeea-9c9f-357c-bf8f-224488420018",
                                        "glosses": [
                                            "Any of a class of mental disorders characterized by ongoing rigid patterns of thought and action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfdd114d-adfe-4c2f-a513-a61ea4ff3a90",
                                                "sense_id": "ab238321-f0ff-3f3d-b298-ae48dc0499da",
                                                "text": "They hadn't reckoned with the attendant personality disorders, which the coldness, the darkness, the dampness, the crampedness and the loneliness were doing nothing to decrease."
                                            },
                                            {
                                                "example_id": "d0b6e2c8-4218-472f-96bb-1957b5fb9222",
                                                "sense_id": "ab238321-f0ff-3f3d-b298-ae48dc0499da",
                                                "text": "Insanity can be cured. Personality disorders are so inextricably entwined with the heart and mind and soul that it is well-nigh impossible to excise them. It would be far less difficult to eradicate Diane's giant rose tattoo than it would be to change her perception of herself and others."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
