            "senses": [
                {
                    "sense_id": "61712e35-50f1-3f9c-b9f0-2f77b2e992f8",
                    "sense_definition": "Exprime l'impatience et le vif désir de voir un événement ou un moment arriver au plus tôt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "souhait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue semaine de travail, <w>vivement</w> le week-end pour pouvoir enfin se reposer."
                        },
                        {
                            "text": "<w>Vivement</w> que le printemps arrive, car cet hiver a été particulièrement froid et pluvieux."
                        }
                    ],
                    "common_phrases": [
                        "vivement ce soir",
                        "vivement demain",
                        "vivement les vacances"
                    ]
                },
                {
                    "sense_id": "b80fe886-039d-3680-a175-35635dbc8fef",
                    "sense_definition": "Avec vivacité, promptitude, ardeur ou rapidité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rapidite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant a couru <w>vivement</w> vers sa mère dès qu'il l'a aperçue sur le quai de la gare."
                        },
                        {
                            "text": "Le conducteur a tourné <w>vivement</w> le volant pour éviter un obstacle apparu sur la chaussée."
                        }
                    ],
                    "synonyms": [
                        "rapidement",
                        "promptement",
                        "lestement"
                    ],
                    "antonyms": [
                        "lentement",
                        "mollement"
                    ],
                    "common_phrases": [
                        "marcher vivement",
                        "réagir vivement"
                    ]
                },
                {
                    "sense_id": "7009404e-6a66-3e5e-b8aa-497db034a89b",
                    "sense_definition": "D'une manière profonde, intense ou avec force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a tenu à remercier <w>vivement</w> toute son équipe pour ce travail exceptionnel."
                        },
