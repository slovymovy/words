                                        ],
                                        "tags": [
                                            "om het daarvoor genoemde te preciseren"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e01acf4a-fb13-43d4-a5ee-3c6ed72661c5",
                                                "sense_id": "230ca695-0307-3e10-93b9-c699e1f51e99",
                                                "text": "Centraal in zijn betoog staat de aanname dat „onze rijkdom en ons vermogen tot adaptatie” nog zullen stijgen. Het argument dat we met meer rijkdom, casu quo meer economische groei, de klimaatproblemen kunnen oplossen negeert dat meer economische groei meer klimaatverandering veroorzaakt."
                                            }
