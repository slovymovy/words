                        "examples": [
                            {
                                "example_id": "432c4aed-0dec-4a48-9bb4-dfc46c2ca8e0",
                                "sense_id": "0001bb33-cd2c-3f5a-964d-458a6ef95f13",
                                "text": "The Nationalist Defense Ministry claimed Communist guns on the mainland coast were silenced by effective counterfire. By Nationalist count, the Reds fired 444 shells, of which 162 hit Matsu Island, 112 Peikantang Island and 170 landed in the sea."
                            },
                            {
                                "example_id": "6810bf8c-bf18-4da8-b9e1-524c1566a9fb",
                                "sense_id": "0001bb33-cd2c-3f5a-964d-458a6ef95f13",
                                "text": "The second attack vehicle had difficulty navigating around the debris from the first attack, and was met with defensive counterfire by security personnel assigned to the hotel."
                            }
                        ]
                    },
