            {
                "entry_id": "ad8ea1b1-c153-3ff2-8457-060dd05f9934",
                "word": "psychologiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "284919ec-f895-3502-b81d-806db713662c",
                        "entry_id": "ad8ea1b1-c153-3ff2-8457-060dd05f9934",
                        "glosses": [
                            "D'une manière psychologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd2e07b8-5eb7-412a-b821-4cdaef4d48f2",
                                "sense_id": "284919ec-f895-3502-b81d-806db713662c",
                                "text": "L’appareil de production se présente comme une gigantesque machine à mobiliser psychologiquement et physiquement qui laisse choir les individus à risque, c’est-à-dire tous ceux qui incarnent une autre manière de vivre."
                            },
                            {
                                "example_id": "14709c4d-ffe8-4afd-9a6c-c41d71425389",
                                "sense_id": "284919ec-f895-3502-b81d-806db713662c",
                                "text": "Comprimée sur soi, nous dit-il, l’humanité est normalement amenée à s’échauffer psychologiquement et à s’ultra-personnaliser."
                            },
                            {
                                "example_id": "5c790056-8d9f-40cb-a36f-239f42fba4a1",
                                "sense_id": "284919ec-f895-3502-b81d-806db713662c",
                                "text": "Le « supporteurisme », terme peu usité et barbare, désigne cette attitude qui engage pleinement, autant physiquement que psychologiquement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9483d68-08ed-4601-b1b4-d4f12afb87a6",
                        "source_entry_id": "ad8ea1b1-c153-3ff2-8457-060dd05f9934",
                        "source_sense_id": "284919ec-f895-3502-b81d-806db713662c",
                        "target_lang_word": "psychologically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
