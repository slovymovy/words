                                    {
                                        "sense_id": "9801352a-f61c-3e95-beac-ecc4db2c44a8",
                                        "entry_id": "19372702-6d9c-3199-baee-e0659dabca3c",
                                        "glosses": [
                                            "Able to hear, as opposed to deaf."
                                        ],
