                            {
                                "example_id": "8e244469-dcb1-4e8a-8b05-b4997990ddf3",
                                "sense_id": "94d0df4a-678a-3665-a1f2-64a5b5e37bae",
                                "text": "The code works, but I must refactor it before it is production quality."
                            }
                        ]
