                                                "sense_id": "6fee721b-341c-3d82-ba4b-daf25c6b1723",
                                                "text": "The senate hath sent about three several quests to search you out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b488c7c-4f9b-378a-8af3-8bb5af98db94",
                                        "entry_id": "f4b826bf-105a-374c-a85e-68f97d35e629",
                                        "glosses": [
                                            "An inquest; a jury of inquest."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9f98dde-072a-4d0a-9206-208330094744",
                                                "sense_id": "7b488c7c-4f9b-378a-8af3-8bb5af98db94",
                                                "text": "To 'cide this title is impanneled\n A quest of thoughts, all tenants to the heart,\n And by their verdict is determined\n The clear eye's moiety and the dear heart's part […]"
                                            }
                                        ]
                                    }
                                ]
