                        "glosses": [
                            "To feel or perceive beforehand or in advance; to have a presentiment of."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d09fcb8f-197c-4997-a4fe-4bf89402bf14",
                                "sense_id": "14c8a71f-c10b-3a6d-a4a6-67ee9b2f816f",
                                "text": "Such a studie was yong Catoes, in fore-feeling his approaching end, who lighting upon Platoes discourse of the soules immortality."
                            },
                            {
                                "example_id": "b4be6181-12a2-4488-9b4b-9bb2964d6c9a",
                                "sense_id": "14c8a71f-c10b-3a6d-a4a6-67ee9b2f816f",
                                "text": "[…] as touching most fundamental topics, there had got to be established in him some positive convictions, which he forefelt would abide in him essentially unmodified so long as his intelligent part remained unimpaired."
                            }
                        ]
                    }
