                ],
                "senses": [
                    {
                        "sense_id": "9659de43-8726-3afe-bbd1-e430f2641d3f",
                        "entry_id": "5de9a31b-be8f-3a7e-bcc3-5d2502c202b7",
                        "glosses": [
                            "Rede, die dazu eingesetzt wird, gegen jemanden oder etwas zu hetzen"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "a3ef297b-0b51-4890-8590-866798a56800",
                                "sense_id": "9659de43-8726-3afe-bbd1-e430f2641d3f",
                                "text": "„Die Presse stellte ihn als Clown dar, und er war dreimal von südafrikanischen Gerichten wegen Hetzreden verurteilt worden, dennoch würde Malema in Zukunft eine Führungsposition in Südafrika einnehmen.“"
                            },
                            {
                                "example_id": "2f8bed54-3bdf-4edb-8ed3-5da7cd3940e9",
                                "sense_id": "9659de43-8726-3afe-bbd1-e430f2641d3f",
                                "text": "„Manche halten Hetzreden, manche schieben stumm Einkaufswagen mit Bomben und Raketen vor sich her.“"
                            },
                            {
                                "example_id": "99cc1974-3a35-4090-9c9b-dba205cba40c",
                                "sense_id": "9659de43-8726-3afe-bbd1-e430f2641d3f",
                                "text": "„Enos Nkala löste im Juni 1980 mit einer Hetzrede in Entumbane, wo ZANLA-Einheiten kaserniert worden waren, Straßenkämpfe zwischen Anhängern beider Parteien aus, in die sehr bald die Truppen einbezogen wurden.“"
                            },
                            {
                                "example_id": "222223ea-1b0d-494b-846c-2d3c828e8e65",
                                "sense_id": "9659de43-8726-3afe-bbd1-e430f2641d3f",
                                "text": "„Problematisch wird es jedoch, wenn einem das Ausrufezeichen andauernd in Hetzreden auf dem Bildschirm begegnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
