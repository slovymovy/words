                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6899da63-b8c3-44f2-8c04-7dda861481d1",
                        "entry_id": "063699dc-0890-3466-9f62-b12281cfa281",
                        "tags": [
                            "plural"
                        ],
                        "form": "ondins"
                    },
                    {
                        "form_id": "fc6ac19a-87db-4e4a-b1e6-8e211f37c29a",
                        "entry_id": "063699dc-0890-3466-9f62-b12281cfa281",
                        "tags": [
                            "un sens féminin"
                        ],
                        "form": "ondine"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "613ce059-4616-3110-b2ad-69e2f964d86e",
                        "entry_id": "063699dc-0890-3466-9f62-b12281cfa281",
                        "glosses": [
                            "Génie des eaux dans la mythologie germanique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d34547e-5178-4b1f-bf9a-84badfff2e7a",
                                "sense_id": "613ce059-4616-3110-b2ad-69e2f964d86e",
                                "text": "Chaque flot est un ondin qui nage dans le courant, chaque courant est un sentier qui serpente vers mon palais, et mon palais est bâti fluide, au fond du lac, dans le triangle du feu, de la terre et de l’air."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0967196-81d5-3eb5-bca9-66b19f01ba42",
                        "entry_id": "063699dc-0890-3466-9f62-b12281cfa281",
                        "glosses": [
                            "Créature mythique représentée avec un torse humain et une queue de poisson ; sirène, triton."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": [
                            {
                                "example_id": "2385c9ad-aa2d-4ac1-ad3e-07a55e1fa307",
                                "sense_id": "a0967196-81d5-3eb5-bca9-66b19f01ba42",
                                "text": "Elle se mit à rayonner dans les mémoires avec la douceur, la tristesse argentées de la vieille ballade danoise dont l'héroïne est enlevée par un ondin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf7c09a5-47a2-4608-b17c-ded77d0c3e28",
                        "source_entry_id": "063699dc-0890-3466-9f62-b12281cfa281",
                        "source_sense_id": "613ce059-4616-3110-b2ad-69e2f964d86e",
                        "source_sense_description": "(Mythologie)",
                        "target_lang_word": "водяной",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "водяной",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ee18d8be-a845-30dc-84eb-c79af376259c",
                                        "entry_id": "e719a854-fd25-3889-99b2-d038f3246f80",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным вода"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8e09b9e-96ff-467f-8310-29c3c7cb3c77",
                                                "sense_id": "ee18d8be-a845-30dc-84eb-c79af376259c",
                                                "text": "Я знаю твоего брата Вильяма, тот завидный речной корабельщик и на славу водяную силу братать может искусными устройствами."
                                            },
                                            {
                                                "example_id": "b744dc45-b48b-4d00-9dbc-a80c1627d505",
                                                "sense_id": "ee18d8be-a845-30dc-84eb-c79af376259c",
                                                "text": "— Мы у советской власти по водяному делу на первой заметке стоим."
                                            },
                                            {
                                                "example_id": "80d305e8-505b-42b8-bd57-2760cea06256",
                                                "sense_id": "ee18d8be-a845-30dc-84eb-c79af376259c",
                                                "text": "— Да! Будем брать водяной балласт и погружаться. ― С этим, Алёша, обожди…"
                                            },
                                            {
                                                "example_id": "21c5bfd3-6be7-4ba9-9094-dd12c8567a21",
                                                "sense_id": "ee18d8be-a845-30dc-84eb-c79af376259c",
                                                "text": "Внизу лежала широкая, в полземли, зелёная полоса, вся изрезанная темноватыми водяными жилами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "584072d7-4abd-3ee0-b2fb-8092b7c608bc",
                                        "entry_id": "e719a854-fd25-3889-99b2-d038f3246f80",
                                        "glosses": [
                                            "свойственный воде, характерный для неё"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88248f37-87d9-48c2-864a-660e6f513dbe",
                                                "sense_id": "584072d7-4abd-3ee0-b2fb-8092b7c608bc",
                                                "text": "Реки, добежав до вздутого, устрашающего моря, бросались вспять, шипящим напором отщелкивали чугунные люки и быстро поднимали водяные спины в музейных подвалах, облизывая хрупкие, разваливающиеся сырым песком коллекции, шаманские маски из петушиных перьев, кривые заморские мечи, шитые бисером халаты, жилистые ноги злых, разбуженных среди ночи сотрудников."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7691d119-94a9-3c0d-b938-17cae98cf1b3",
                                        "entry_id": "e719a854-fd25-3889-99b2-d038f3246f80",
                                        "glosses": [
                                            "содержащий воду или какую-либо жидкость, похожую на неё"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92c491c9-28f4-4339-a567-917151b22491",
                                                "sense_id": "7691d119-94a9-3c0d-b938-17cae98cf1b3",
                                                "text": "Ключик смотрел в окно на сплошной водяной занавес ливня, на переулок, похожий на реку, покрытую белыми пузырями, освещавшимися молниями, которые вставали вдруг и дрожали среди аспидных туч, как голые берёзы."
                                            },
                                            {
                                                "example_id": "c2fdc526-3786-40e7-a1bb-b743b4dbc5cb",
                                                "sense_id": "7691d119-94a9-3c0d-b938-17cae98cf1b3",
                                                "text": "Воздух насыщен водяной пылью, в которой мерцающими полосками вязнут лучи наших фонарей. ❬…❭ В общем, группа оказалась в естественном водолазном колоколе, и весь вопрос теперь заключался в том, на сколько ещё может подняться давление, не выдавит ли оно водяные пробки сифонов, ведь, что за ними, мы так и не узнали."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f98b729a-8112-34d0-a877-e7fe2822d5eb",
                                        "entry_id": "e719a854-fd25-3889-99b2-d038f3246f80",
                                        "glosses": [
                                            "перен., разг. бесцветный или слабоокрашенный"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b316474-78d3-300b-8f4f-a15ba18ca45c",
                                        "entry_id": "e719a854-fd25-3889-99b2-d038f3246f80",
                                        "glosses": [
                                            "живущий, произрастающий в воде, обитающий на воде, около воды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10b10328-8026-4921-bce4-8e2476b9e0c5",
                                                "sense_id": "1b316474-78d3-300b-8f4f-a15ba18ca45c",
                                                "text": "Между цветами особенно интересны водяные растения, исполинские лилии и лотос: они росли в наполненной водою канаве."
                                            },
                                            {
                                                "example_id": "cbf0dc34-426d-493f-b132-e7120e323e45",
                                                "sense_id": "1b316474-78d3-300b-8f4f-a15ba18ca45c",
                                                "text": "Если вдогонку стенусу помчится другое водяное насекомое, то, попав в область, где поверхностное натяжение воды уменьшилось, оно начинает тонуть под действием собственного веса."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de0e998d-e07d-3c1c-9bc2-c6780c69c95d",
                                        "entry_id": "e719a854-fd25-3889-99b2-d038f3246f80",
                                        "glosses": [
                                            "осуществляемый с помощью воды, приводимый в движение водой или силою падающей воды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4756af19-c587-4f91-b83f-9a4fd9e001cd",
                                                "sense_id": "de0e998d-e07d-3c1c-9bc2-c6780c69c95d",
                                                "text": "Эти водохранилища нужны не только для получения напора воды, необходимого для работы водяных турбин, приводящих в движение генераторы электрического тока, но и для регулирования расхода воды по сезонам года."
                                            },
                                            {
                                                "example_id": "2c292759-6bba-4a25-aebd-a791ef13af43",
                                                "sense_id": "de0e998d-e07d-3c1c-9bc2-c6780c69c95d",
                                                "text": "В одном Козельском уезде во времена Петра было сто четыре водяных мельницы на маленьких речушках."
                                            },
                                            {
                                                "example_id": "5c765aaf-6707-4420-93f4-e70d11ea7d3e",
                                                "sense_id": "de0e998d-e07d-3c1c-9bc2-c6780c69c95d",
                                                "text": "Здесь помогут комнатные фонтанчики, работающие от небольших водяных насосов."
                                            },
                                            {
                                                "example_id": "44f6b2d8-4b7f-4ea2-ac9c-04b8f4121ac3",
                                                "sense_id": "de0e998d-e07d-3c1c-9bc2-c6780c69c95d",
                                                "text": ".. можно продлить срок службы алмазного диска и избавиться от кирпичной пыли, сделав устройство для струйного водяного охлаждения режущей кромки диска и используя предварительно замоченный кирпич .."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47df286f-3eb6-3826-8743-66555f00f4fe",
                                        "entry_id": "e719a854-fd25-3889-99b2-d038f3246f80",
                                        "glosses": [
                                            "устар. или редк. предназначенный для движения по воде"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88f59a3f-3195-460f-9214-86b72c1911a6",
                                                "sense_id": "47df286f-3eb6-3826-8743-66555f00f4fe",
                                                "text": "По этому поводу один из наших читателей сообщает, что водяные лыжи ― изобретение не новое."
                                            },
                                            {
                                                "example_id": "ff3952a6-7c1c-427f-a9fb-c64837565ea5",
                                                "sense_id": "47df286f-3eb6-3826-8743-66555f00f4fe",
                                                "text": "Мы посещали знаменитую первую Сельскохозяйственную выставку в Нескучном саду, где толпы крестьян, колхозников и единоличников .. толпились на берегу разукрашенной Москвы-реки, восхищаясь маленьким дюралевым «юнкерсом» на водяных лыжах, который то поднимался в воздух, делая круги над пёстрым табором выставки, то садился на воду, бегущую синей рябью под дряхлым Крымским мостом .."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "водяной",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "be0e77fe-cf0c-3630-89b7-d1a422df28f3",
                                        "entry_id": "bb561938-fab3-3908-848c-a82d24fad50f",
                                        "glosses": [
                                            "мифол., фолькл. в поверьях славянских и других народов: фантастическое существо, злой дух, воплощение стихии воды как отрицательного и опасного начала; чаще всего выступает в облике мужчины с отдельными чертами животного (лапы вместо рук, рога на голове) или безобразного старика, опутанного тиной, с большой бородой и зелёными усами; в некоторых сказках: морской царь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "364e176c-5af8-4dde-9a38-27193db8ed9d",
                                                "sense_id": "be0e77fe-cf0c-3630-89b7-d1a422df28f3",
                                                "text": "Потому и спать нельзя в ночь на Ивана Купала: слишком много ведьм, леших, чертей, водяных и прочей нечистой силы."
                                            },
                                            {
                                                "example_id": "ddaf997c-43bd-4e7e-a6f4-027dbfa2e099",
                                                "sense_id": "be0e77fe-cf0c-3630-89b7-d1a422df28f3",
                                                "text": "Водяной же, или сванский бог, которого они когда-то поставили сторожить это озеро, теперь мало кого пугал."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
