                "senses": [
                    {
                        "sense_id": "530e75bb-8cf2-3abf-8747-094fdccec322",
                        "entry_id": "3ac26647-1789-3b9a-8da4-471504f5cb2d",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "873c3f66-de08-4ece-b2d1-4cb1b7b35520",
                                "sense_id": "530e75bb-8cf2-3abf-8747-094fdccec322",
                                "text": "Frau Störchle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "71224952-40d4-452f-b242-652cf6c32b8f",
                                "sense_id": "530e75bb-8cf2-3abf-8747-094fdccec322",
                                "text": "Herr Störchle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9139c6a7-5c4b-4fb6-8979-d7569cc116ba",
                                "sense_id": "530e75bb-8cf2-3abf-8747-094fdccec322",
                                "text": "Die Störchles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "0be0afcc-1318-4319-89f3-3fe2eaf33268",
                                "sense_id": "530e75bb-8cf2-3abf-8747-094fdccec322",
                                "text": "Der Störchle trägt nie die Pullover, die die Störchle ihm strickt."
                            },
                            {
                                "example_id": "49632b93-58f2-4211-96cb-67d708ec5936",
                                "sense_id": "530e75bb-8cf2-3abf-8747-094fdccec322",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Störchle kommt, geht der Herr Störchle.“"
                            },
                            {
                                "example_id": "9ef9bc73-cb21-4d34-abf0-b276a547a7af",
                                "sense_id": "530e75bb-8cf2-3abf-8747-094fdccec322",
                                "text": "Störchle kommt und geht."
                            },
                            {
                                "example_id": "f5e0e328-8d1c-41e2-855e-c77137363eba",
                                "sense_id": "530e75bb-8cf2-3abf-8747-094fdccec322",
                                "text": "Störchles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
