                "translations": [
                    {
                        "translation_id": "fd37285d-588c-4ffe-8641-7a0ea98d7600",
                        "source_entry_id": "52440884-e69a-335e-8b74-32f91b2b08cf",
                        "source_sense_id": "4dbd99f2-5369-36c4-9961-780c8443c69e",
                        "target_lang_word": "totalitarian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "totalitarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15747750-39d3-35bc-9835-6c1d63de8da0",
                                        "entry_id": "02592f38-2e22-3a51-bc15-92b52bbf89b3",
                                        "glosses": [
                                            "Of or relating to a system of government where the people have virtually no authority and the state wields absolute control of every aspect of the country, socially, financially, and politically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "886a7601-804d-4735-b6f7-1e2b48193e88",
                                                "sense_id": "15747750-39d3-35bc-9835-6c1d63de8da0",
                                                "text": "The divine truth is stronger than totalitarian falsehoods."
                                            },
                                            {
                                                "example_id": "cd91a434-7c16-4e05-aedd-13ae2d8e74cc",
                                                "sense_id": "15747750-39d3-35bc-9835-6c1d63de8da0",
                                                "text": "Only history can tell us where China will go from here. The Chinese leadership's brutal crackdown on students seeking fundamental democratic rights makes it difficult to chart the future. Those brave students who laid down their lives against the tanks of Tiananmen Square confirmed what I'd always believed: that no totalitarian society can bottle up the instinctive drive of men and women to be free, and that once you give a captive people a little freedom, they'll demand still more."
                                            },
                                            {
                                                "example_id": "1208208a-dc2b-48b2-a02d-e411b560ddaa",
                                                "sense_id": "15747750-39d3-35bc-9835-6c1d63de8da0",
                                                "text": "Well, last night these two bouncers / And one of 'em's alright, the other one's the scary one / His way or no way, totalitarian"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "totalitarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e8900b4-c1a0-32bd-838a-07cef2040f69",
                                        "entry_id": "6135c1cd-f7b1-3e60-9118-497da9a04ec7",
                                        "glosses": [
                                            "An advocate of totalitarianism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
