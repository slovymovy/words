                                        "glosses": [
                                            "mamífero carnívoro da família Herpestidae, de nome científico Herpestes ichneumon (mangusto‑egípcio) ou outras espécies do género Herpestes, caracterizado pelo corpo alongado, pernas curtas, cauda comprida e comportamento ágil, encontrado principalmente na África e na Ásia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17edcd76-d6fd-4723-9e90-c66259cfe703",
                                                "sense_id": "025ca290-ded7-317c-87f3-eb38480b46db",
                                                "text": "O mangusto é conhecido por sua habilidade de caçar serpentes, inclusive espécies venenosas, graças à sua agilidade e reflexos rápidos"
                                            }
                                        ]
                                    }
                                ]
                            }
