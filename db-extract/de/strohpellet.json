                        "examples": [
                            {
                                "example_id": "44501ded-8159-405a-a1cc-33793e899f42",
                                "sense_id": "d70557c8-e941-361d-92d7-07f67af655fe",
                                "text": "„Strohpellets gehören zu der halmgutartigen Biomasse, der zur heutigen Zeit ein hohes Potential zur Nutzung als Brennstoff, aufgrund der steigenden Preise von den allgemeinen Holzbrennstoffe, zugesprochen wird. “"
                            },
                            {
                                "example_id": "337390c1-2ac0-4105-921d-980460b9f176",
                                "sense_id": "d70557c8-e941-361d-92d7-07f67af655fe",
                                "text": "„Strohpellets werden meist als Biofestbrennstoff für Heizungen und Blockheizkraftwerke (BHKW), aber auch als Einstreu für Haustiere bzw. Stalltiere verwendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
