                        "glosses": [
                            "соединять вместе, объединять в нечто общее, целое"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "876f2dfc-14e4-3e28-bff2-772d189bb907",
                        "entry_id": "1d4cd84b-7ae7-3f3b-ad09-65152ae3412a",
                        "glosses": [
                            "придавать общее значение чему-либо частному, единичному, распространять суждение о единичном на множество объектов"
                        ],
                        "tags": [],
