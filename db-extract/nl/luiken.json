                                "sense_id": "ecc97cca-4ae9-3af0-a276-219e76705e09",
                                "text": "De opkomende zon duwt zich door de spleten van de luiken en toont de contouren van de slaapkamer."
                            },
                            {
                                "example_id": "e66ba10b-752a-4e69-9ae9-69be5642188c",
                                "sense_id": "ecc97cca-4ae9-3af0-a276-219e76705e09",
                                "text": "Beneden waren de luiken nog halfgesloten en de weinige meubels stonden in het donker."
                            }
                        ]
                    }
                ],
