                                "target_senses": [
                                    {
                                        "sense_id": "3d36f033-bd03-317f-bdc5-272711b7f57f",
                                        "entry_id": "ff75d301-a63c-32e8-b6fc-47a4c69235d0",
                                        "glosses": [
                                            "The act of corrupting or subverting morale, discipline, courage, hope, etc., or the state of being corrupted or subverted in morale."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97f98595-6a82-4dc1-be26-3844764f8e63",
                                                "sense_id": "3d36f033-bd03-317f-bdc5-272711b7f57f",
                                                "text": "the demoralization of an army or navy"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27cbdd86-8f47-4666-85be-49693ad99f03",
                        "source_entry_id": "9dc43c33-5cb4-36b6-b4fe-2e508e341cb9",
                        "target_lang_word": "Demoralisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c43538c5-11db-4c22-a256-663969a3ce93",
                        "source_entry_id": "9dc43c33-5cb4-36b6-b4fe-2e508e341cb9",
                        "target_lang_word": "démoralisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démoralisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f963d13-8510-3c35-8e15-17f54d2b9581",
                                        "entry_id": "5ebe1f66-fc9c-33fa-9d2b-c23d3f54f239",
                                        "glosses": [
                                            "Action de démoraliser ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e459727-3d3c-4fd0-82e0-62612eb39ab3",
                                                "sense_id": "8f963d13-8510-3c35-8e15-17f54d2b9581",
                                                "text": "Même les raisons qui, aujourd'hui, riveraient une femme de cœur au sort de son époux, la vieillesse, la maladie, le départ pour le front, étaient cyniquement alléguées par elles pour quitter leur foyer ; et, symptôme plus grave de démoralisation, elles ne choquaient plus une opinion inhumaine et blasée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
