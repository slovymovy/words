                    {
                        "translation_id": "849ad6e8-c397-4863-a6ad-0f3adf4eedac",
                        "source_entry_id": "12571518-f91a-386f-8e39-f1ea47c4b537",
                        "source_sense_id": "9e7f1230-539b-3cd2-94be-c1ddc95cb28c",
                        "source_sense_description": "a rigid bracelet or anklet, especially one with no clasp",
                        "target_lang_word": "Armreif",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Armreif",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f958aa8e-f434-3ff1-b80b-699e937fe48a",
                                        "entry_id": "9cce5dd6-561e-3403-ba5a-fe7caabb61e0",
                                        "glosses": [
                                            "als Schmuck getragener Reif um Arm oder Handgelenk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1f8203e-4029-4951-869b-a558fea9d7cc",
                                                "sense_id": "f958aa8e-f434-3ff1-b80b-699e937fe48a",
                                                "text": "„Schon die Wikinger ritzten Abbildungen des Tiers in Armreife und Metallbeschläge, und während der Völkerwanderung wurden Fibeln der Franken und Alemannen mit Schlangen verziert.“"
                                            },
                                            {
                                                "example_id": "0cec4b10-5ae6-4721-85cb-2ff6a94f574d",
                                                "sense_id": "f958aa8e-f434-3ff1-b80b-699e937fe48a",
                                                "text": "„Verschwunden ist auch der goldene Armreif, den er seiner Frau einmal aus Usbekistan mitgebracht hat, und ein Ring, den sie vom Zahnarzt Krause, ihrem Liebhaber vor seiner Zeit, einmal geschenkt bekommen hat – mit einem Saphir in der Mitte, ringsherum kleine Brillanten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10dec725-a9bb-4164-b3cc-98b763b01c90",
                        "source_entry_id": "12571518-f91a-386f-8e39-f1ea47c4b537",
                        "source_sense_id": "9e7f1230-539b-3cd2-94be-c1ddc95cb28c",
                        "source_sense_description": "a rigid bracelet or anklet, especially one with no clasp",
                        "target_lang_word": "Armring",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Armring",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d989380a-4aca-335c-9cf6-340f43091310",
                                        "entry_id": "42124571-8f23-3076-a3a7-ac98872bd303",
                                        "glosses": [
                                            "Schmuckstück, das am Arm getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17407530-5372-4505-a14b-ceeb25cc5cd4",
                                                "sense_id": "d989380a-4aca-335c-9cf6-340f43091310",
                                                "text": "„Neben Armringen finden sich bei Frauen mancher Siedlungsgebiete auch Beinringe.“"
                                            },
                                            {
                                                "example_id": "17a9bef3-1bfc-47df-ad02-bc3997d25703",
                                                "sense_id": "d989380a-4aca-335c-9cf6-340f43091310",
                                                "text": "„Aus Gold waren ein Halsring, zwei Armringe und mehrere Fingerringe, dazu kamen Fibeln aus Gold und Perlen aus Glas und Bernstein, ein Bernsteinstab und ein Eisenmesser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "402f67d4-1437-491b-b041-21342eb45ca6",
                        "source_entry_id": "12571518-f91a-386f-8e39-f1ea47c4b537",
                        "source_sense_id": "9e7f1230-539b-3cd2-94be-c1ddc95cb28c",
