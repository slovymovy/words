                "senses": [
                    {
                        "sense_id": "4cd2d319-000f-3343-9b2e-724dbc84662d",
                        "entry_id": "1e61d34d-9997-34c9-a5e2-8aaaf490b033",
                        "glosses": [
                            "portentous; prophetic; acting as a presage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01f81e33-9e59-484d-bb9f-5bac22c355bf",
                                "sense_id": "4cd2d319-000f-3343-9b2e-724dbc84662d",
                                "text": "The raven, from a neighbouring oak, responded the portentive croak."
                            },
                            {
                                "example_id": "c98f73be-f5b8-43fe-80c9-7196b69f1f89",
                                "sense_id": "4cd2d319-000f-3343-9b2e-724dbc84662d",
                                "text": "Astrological calculations of nativities, lucky and unlucky days and seasons, are by some regarded, and even moles on the surface of the skin are thought to be portentive of good or bad fortune."
                            },
                            {
                                "example_id": "6131ac84-5fff-4ca3-bc00-7e64b411d3c9",
                                "sense_id": "4cd2d319-000f-3343-9b2e-724dbc84662d",
                                "text": "The growing use of cement during the city's florrescence was innovative and extraordinarily portentive of modern engineering skills."
                            }
                        ]
                    },
                    {
                        "sense_id": "be0c7d6c-af13-388b-aec1-e1156954fca6",
                        "entry_id": "1e61d34d-9997-34c9-a5e2-8aaaf490b033",
                        "glosses": [
                            "Indicating that something is likely to happen in the future."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25de7fc3-3bcb-4a8b-a952-edba632ac54d",
                                "sense_id": "be0c7d6c-af13-388b-aec1-e1156954fca6",
                                "text": "The potential portentive forms, consisting of the potential stem plus the post-clitic -noko, occur with a further post-cliticised contracted form of ylvk 'having said', the perfect participle of 'say', in a clause of negative purpose."
                            }
                        ]
                    }
