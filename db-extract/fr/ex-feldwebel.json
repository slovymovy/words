                        "examples": [
                            {
                                "example_id": "54afffe9-9da2-4f7f-94b6-3691c41cc37e",
                                "sense_id": "23fa2e55-a4cd-3e19-a07a-425c8e68f729",
                                "text": "Certes, le commissaire continuait à ne lui inspirer qu’une confiance relative, malgré l’initiative dont il avait fait preuve en lui présentant l’ex-feldwebel."
                            },
                            {
                                "example_id": "bc847d86-8f4c-4aea-984b-0cf72d5fdcfb",
                                "sense_id": "23fa2e55-a4cd-3e19-a07a-425c8e68f729",
                                "text": "L’ex-feldwebel, dressé à l’allemande, court, jappe, cognotte du poing à tort et à travers."
                            },
                            {
                                "example_id": "2d8df2ae-c641-4f17-81f5-24113982da78",
                                "sense_id": "23fa2e55-a4cd-3e19-a07a-425c8e68f729",
                                "text": "L’abbé Bauer, ex-feldwebel, devant le tribunal militaire de Paris."
                            }
                        ]
                    }
