                    },
                    {
                        "translation_id": "38a15bc5-75b3-403c-bb94-31d972bfcf2b",
                        "source_entry_id": "faf9e80f-d134-3a11-9a63-f7e509e672a8",
                        "target_lang_word": "Tankstelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tankstelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1696dec6-3fc3-3c05-b90f-31becbf926fa",
                                        "entry_id": "8180fe04-71af-3a8d-86c4-c1497fd1db3d",
                                        "glosses": [
                                            "Station zum Betanken von Fahrzeugen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa8f0689-c857-47a8-a3c9-0b2bcef72fd2",
                                                "sense_id": "1696dec6-3fc3-3c05-b90f-31becbf926fa",
                                                "text": "Auf deutschen Autobahnen befindet sich etwa alle 50 Kilometer eine Tankstelle."
                                            },
                                            {
                                                "example_id": "aba2bc9a-4439-4ce0-ac00-eb88b03a20db",
                                                "sense_id": "1696dec6-3fc3-3c05-b90f-31becbf926fa",
                                                "text": "Fahr zur nächsten Tankstelle, der Tank ist fast leer."
                                            },
                                            {
                                                "example_id": "a05ffd7f-bbf1-40ec-8a53-b808de56f289",
                                                "sense_id": "1696dec6-3fc3-3c05-b90f-31becbf926fa",
                                                "text": "„An der nächsten Tankstelle lässt sie sich von uns absetzen und tritt den Rückweg an.“"
                                            },
                                            {
                                                "example_id": "1282438d-704a-4d34-84b5-19d95ce12680",
                                                "sense_id": "1696dec6-3fc3-3c05-b90f-31becbf926fa",
                                                "text": "„Kein Zweifel, Anrath hat ihre Tankstelle im Telefonbuch nachgeschlagen und ihre Nummer gewählt.“"
                                            },
                                            {
                                                "example_id": "ec70b497-7549-4462-864b-cfd9428f6f08",
                                                "sense_id": "1696dec6-3fc3-3c05-b90f-31becbf926fa",
                                                "text": "„Nach wenigen Metern erreichte ich die noch im Bau befindliche Auffahrt der Tankstelle.“"
                                            },
                                            {
                                                "example_id": "857fab05-21ad-44f3-ab09-1536e5e10a04",
                                                "sense_id": "1696dec6-3fc3-3c05-b90f-31becbf926fa",
                                                "text": "„Außer Schokokeksen hatte die Tankstelle dem hungrigen Reisenden nicht viel zu bieten, dafür aber einen Geldwechsel-Service.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3550bd2-ed54-48c5-ad58-76d8689f9c78",
                        "source_entry_id": "faf9e80f-d134-3a11-9a63-f7e509e672a8",
                        "target_lang_word": "Zapfsäule",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zapfsäule",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48d10ff4-7e2c-37ca-bab3-1c3fdaac7247",
                                        "entry_id": "e6df4461-7ab7-382e-8664-ab3866e31416",
                                        "glosses": [
                                            "Anlage zum Einfüllen von Kraftstoffen in Kraftfahrzeuge an einer Tankstelle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aea63e3d-c2b8-4b21-9210-38d722115df8",
                                                "sense_id": "48d10ff4-7e2c-37ca-bab3-1c3fdaac7247",
                                                "text": "An einer Zapfsäule tankte er den Wagen."
                                            },
                                            {
                                                "example_id": "cb28b782-583f-4f10-8295-f52ddc7ec9d0",
                                                "sense_id": "48d10ff4-7e2c-37ca-bab3-1c3fdaac7247",
                                                "text": "In letzter Zeit erleben viele Bürger einen Preisschock an der Zapfsäule."
                                            },
                                            {
                                                "example_id": "f670ed9c-b0b1-41a7-99c1-ae6e03dbbd03",
                                                "sense_id": "48d10ff4-7e2c-37ca-bab3-1c3fdaac7247",
                                                "text": "„Die Bundesregierung macht den Autofahrern trotz Rekordpreisen an der Zapfsäule wenig Hoffnung auf eine höhere Pendlerpauschale.“"
                                            },
                                            {
                                                "example_id": "438f104f-202a-4ee0-a422-d57303991a19",
                                                "sense_id": "48d10ff4-7e2c-37ca-bab3-1c3fdaac7247",
                                                "text": "„Während ich noch darauf warte, dass eine Zapfsäule frei wird, steigt sie bereits aus dem Bus.“"
                                            },
                                            {
                                                "example_id": "87915cb2-0132-47d1-bda1-6e10968e253f",
                                                "sense_id": "48d10ff4-7e2c-37ca-bab3-1c3fdaac7247",
                                                "text": "„Als Val aus der Tankstelle fuhr, riss sie beinahe die Zapfsäule auf der Beifahrerseite um.“"
                                            },
                                            {
                                                "example_id": "aa51aca3-45b1-4e0a-bcd7-3f69bb71c351",
                                                "sense_id": "48d10ff4-7e2c-37ca-bab3-1c3fdaac7247",
                                                "text": "„Im Zentrum der Stadt fanden wir eine Tankstelle und ich fuhr an eine Zapfsäule.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
