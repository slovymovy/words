                "senses": [
                    {
                        "sense_id": "ba2c8fc5-03ae-3d4f-b64a-a556ee65d791",
                        "entry_id": "c6c2bab6-4f2c-340c-8ffa-248165fe7e83",
                        "glosses": [
                            "zu einem Bündel zusammengefasste isolierte Drahtleitungen, die Signale oder Energie übertragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "084eb23c-b826-4ccf-94de-34ef9743f38d",
                                "sense_id": "ba2c8fc5-03ae-3d4f-b64a-a556ee65d791",
                                "text": "„Er legt den Kabelbaum in den Motorraum und schraubt ihn fest.“"
                            },
                            {
                                "example_id": "3fba2a24-877c-4fde-8c22-03a835c780d6",
                                "sense_id": "ba2c8fc5-03ae-3d4f-b64a-a556ee65d791",
                                "text": "„Trotz langer Entwicklungsarbeit hatte der Porsche Kinderkrankheiten. ‚Am Anfang hatten wir am Kabelbaum sehr dünne Kabel verwendet, die bei Bewegungen schnell brachen und anfangs fummelt man ja ständig an allem herum‘, sagt Broedersdorff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
