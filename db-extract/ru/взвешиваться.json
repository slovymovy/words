                ],
                "senses": [
                    {
                        "sense_id": "e35d18a4-6bee-3dc8-bcca-1dab3d054901",
                        "entry_id": "a4f9ba5b-2966-301b-8853-c062fd089363",
                        "glosses": [
                            "измерять массу собственного тела с помощью весов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3969329c-ab64-4252-bc56-c53fcdc27b00",
                                "sense_id": "e35d18a4-6bee-3dc8-bcca-1dab3d054901",
                                "text": "Щёки смотрителя покрылись бледным загаром, каждый день он взвешивался и в весе медленно прибавлялся."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0abaa89-8943-34a8-867a-a0cafdcf05a9",
                        "entry_id": "a4f9ba5b-2966-301b-8853-c062fd089363",
                        "glosses": [
                            "страд. к взвешивать (определять вес)"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "7c78f6fb-1533-4ac3-b788-7970a7c181d9",
                                "sense_id": "f0abaa89-8943-34a8-867a-a0cafdcf05a9",
                                "text": "Зерно не взвешивалось, и румынские интенданты предполагали, что его здесь скопилось несколько тысяч тонн."
                            }
                        ]
                    },
                    {
                        "sense_id": "064cab1c-3d95-3b85-ab57-5afe22c96b3f",
                        "entry_id": "a4f9ba5b-2966-301b-8853-c062fd089363",
                        "glosses": [
                            "страд. к взвешивать (обдумывать, тщательно оценивать)"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "93e38412-b8cb-49eb-a514-eb6f96d4bc5e",
                                "sense_id": "064cab1c-3d95-3b85-ab57-5afe22c96b3f",
                                "text": "Но даже во время азарта каждое слово взвешивалось этими деловыми людьми, потому что и за карточным столом нужно было проявить себя человеком сдержанным и умным, с которым можно вести дела."
                            }
                        ]
                    }
