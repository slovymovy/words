                "translations": [
                    {
                        "translation_id": "aa241c67-1c30-44bf-bdef-20b5bfb42c39",
                        "source_entry_id": "abe8e6e2-a386-30f6-a09a-dd25af19480e",
                        "source_sense_id": "dd15d430-8ecd-35af-adef-56052e20ce82",
