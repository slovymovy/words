                ],
                "translations": [
                    {
                        "translation_id": "04de4e6e-7337-4e79-9dea-7739f42a8759",
                        "source_entry_id": "5d6b12a6-5006-3bbd-9e54-64a3dc594273",
                        "target_lang_word": "generative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "generative",
