                "senses": [
                    {
                        "sense_id": "bda4e42f-b4d2-3fc2-ae60-7e841616e383",
                        "entry_id": "b9b60152-4439-3c25-a160-1dd9337d6ec5",
                        "glosses": [
                            "разг. уменьш.-ласк. к свежак; что-либо свежее (свежеиспечённое, свежеприготовленное, свежевыловленное и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2460611-0182-44f1-bfd7-07f6300cc5a9",
                                "sense_id": "bda4e42f-b4d2-3fc2-ae60-7e841616e383",
                                "text": "Вот и пряники, свежачок, всего недельные — и зубок не надо!"
                            },
                            {
                                "example_id": "7883ee9e-296c-4066-a89a-024b4f94c42b",
                                "sense_id": "bda4e42f-b4d2-3fc2-ae60-7e841616e383",
                                "text": "Книжка вышла в свет в 1995 году — не ахти какой свежачок, согласитесь."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e55d903-5442-36d9-bbb1-c2251867b526",
                        "entry_id": "b9b60152-4439-3c25-a160-1dd9337d6ec5",
                        "glosses": [
                            "разг. свежий ветер, воздух"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "985eabdb-de2b-4881-a4af-0e9787c4564c",
                                "sense_id": "6e55d903-5442-36d9-bbb1-c2251867b526",
                                "text": "Потом мне объяснили, что в тот день задувал приличный свежачок."
                            },
                            {
                                "example_id": "1a203212-2bdd-462f-bbe0-e08588da7397",
                                "sense_id": "6e55d903-5442-36d9-bbb1-c2251867b526",
                                "text": "С северной стороны тянул понизовый свежачок, и Гриша передёрнулся от озноба."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd68af86-dd6f-31c4-a8a9-b83a12589079",
                        "entry_id": "b9b60152-4439-3c25-a160-1dd9337d6ec5",
                        "glosses": [
                            "перен., разг. одуш. кто-либо вновь прибывший, незнакомый; новичок, новенькая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e72124d-6248-4e0e-9e02-572738f9cc4e",
                                "sense_id": "fd68af86-dd6f-31c4-a8a9-b83a12589079",
                                "text": "Сощурив левый глаз и прицелившись правым, он спросил: — Свежачок? — В каком смысле? — не понял я. — У нас в части впервые? Я кивнул."
                            }
                        ]
                    }
