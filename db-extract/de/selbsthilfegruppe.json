                "senses": [
                    {
                        "sense_id": "5a549ceb-c1e0-3de6-9cc0-fc3203008c5b",
                        "entry_id": "1c92dfcb-852a-39d1-9c77-f988b4c9ad6c",
                        "glosses": [
                            "Gruppe von Personen, die gemeinsam versuchen, ein spezielles Problem, das sie alle haben, zu bewältigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e9c0a2-accb-477d-8af5-62289c2884ad",
                                "sense_id": "5a549ceb-c1e0-3de6-9cc0-fc3203008c5b",
                                "text": "„Ansonsten hat sich aber die sexuelle Aufklärung dank der zahllosen Illustriertenartikel, Talkshows, Ratgeber, Interessenvertretungen und Selbsthilfegruppen flächendeckend weit verbreitet.“"
                            },
                            {
                                "example_id": "5a7c3665-dd6c-4a88-bb3b-6fefc9061084",
                                "sense_id": "5a549ceb-c1e0-3de6-9cc0-fc3203008c5b",
                                "text": "„Der federführende Legastheniker der kommaphoben Selbsthilfegruppe ist zu meiner Erleichterung »nach Diktat verreist«.“"
                            },
                            {
                                "example_id": "51e5394b-a8e0-4d9f-b475-7990854e7b38",
                                "sense_id": "5a549ceb-c1e0-3de6-9cc0-fc3203008c5b",
                                "text": "„Ich gebe in Selbsthilfegruppen nie meinen richtigen Namen an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
