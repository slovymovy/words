                                                "sense_id": "e71522ed-0a9a-33bf-90da-f414172d07a3",
                                                "text": "„Seither ist jahrelang zwischen beiden vergeblich über Demilitarisierung verhandelt worden.“"
                                            },
                                            {
                                                "example_id": "707a0f65-4944-41bd-9164-f54a9d57962e",
                                                "sense_id": "e71522ed-0a9a-33bf-90da-f414172d07a3",
                                                "text": "„Eine Schlüsselrolle bei der freiwilligen Demilitarisierung Britanniens spielte Kaiser Honorius.“"
                                            }
