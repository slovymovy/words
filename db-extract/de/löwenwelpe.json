                "senses": [
                    {
                        "sense_id": "2ed4ff0f-ba18-3c44-a46b-79d1bcaef186",
                        "entry_id": "843f830b-0398-30b4-9f49-2b9b01bbcc1c",
                        "glosses": [
                            "Jungtier eines Löwen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8710729a-56c6-4c38-bdb7-aafbb040bfb9",
                                "sense_id": "2ed4ff0f-ba18-3c44-a46b-79d1bcaef186",
                                "text": "„Zunächst stellt sie sich krank; nur das Löwenwelpen könne sie retten.“"
                            },
                            {
                                "example_id": "a233b4eb-fecb-47eb-94e6-2bc2feddf223",
                                "sense_id": "2ed4ff0f-ba18-3c44-a46b-79d1bcaef186",
                                "text": "„Für die hohe Mortalität unter den Löwenwelpen ist zum Teil die Nachlässigkeit der Löwenmütter schuld.“"
                            },
                            {
                                "example_id": "bbc0478f-b383-486e-be64-e5bc909a1a12",
                                "sense_id": "2ed4ff0f-ba18-3c44-a46b-79d1bcaef186",
                                "text": "„Er saß auf einer Parkbank und hielt einen Löwenwelpen an der Leine!“"
                            },
                            {
                                "example_id": "0daf8fc7-a690-4221-b27f-2f874cb81085",
                                "sense_id": "2ed4ff0f-ba18-3c44-a46b-79d1bcaef186",
                                "text": "„Einige Löwenwelpen ließ man von einer Hündin großziehen, beispielsweise das Überlebende eines Dreierwurfes dieser Löwin vom 8.7. 1827 in Zürich […]“"
                            },
                            {
                                "example_id": "8205b885-5057-469b-8b70-85046db7ad89",
                                "sense_id": "2ed4ff0f-ba18-3c44-a46b-79d1bcaef186",
                                "text": "„Der Umgang mit Raubtieren war zeitweise so leichtsinnig, dass zwei australische Hippies 1969 im Londoner Kaufhaus Harrods sogar einen Löwenwelpen kaufen konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
