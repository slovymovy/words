                {
                    "sense_id": "c2092582-bd1e-3f8c-a36c-7feaaec1df18",
                    "sense_definition": "Ласковое обращение или название любимого человека, обычно ребёнка или женщины.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "люди_обращение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Какая же ты у меня <w>лапушка</w>, всегда готова прийти на помощь.",
                            "target_lang_translations": {
                                "en": "You are such a <w>sweetheart</w>, always ready to help."
                            }
                        },
                        {
                            "text": "Мама нежно обняла дочку и назвала её своей маленькой <w>лапушкой</w>.",
                            "target_lang_translations": {
                                "en": "The mother gently hugged her daughter and called her her little <w>darling</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "лапочка",
                        "лапуля"
                    ],
                    "common_phrases": [
                        "моя лапушка",
                        "маленькая лапушка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное ласкательное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An affectionate term of address or reference for a loved person, typically a child or a woman."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "darling",
                                "target_lang_sense_clarification": "term of endearment for a loved person"
                            },
                            {
                                "target_lang_word": "sweetheart",
                                "target_lang_sense_clarification": "affectionate address or name for someone beloved"
                            },
                            {
                                "target_lang_word": "honey",
                                "target_lang_sense_clarification": "informal affectionate term of address"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b89d46f-1ce3-359c-ba81-3d28b4a170af",
                    "sense_definition": "Уменьшительно-ласкательное к <w>лапа</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "анатомия",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Котёнок сладко спал и вытянул свои мягкие <w>лапушки</w> вперед.",
                            "target_lang_translations": {
                                "en": "The kitten slept sweetly and stretched its soft little <w>paws</w> forward."
                            }
                        },
                        {
                            "text": "Она осторожно взяла щенка за маленькую <w>лапушку</w>, чтобы вытащить занозу.",
                            "target_lang_translations": {
                                "en": "She gently took the puppy by its little <w>paw</w> to pull out a splinter."
                            }
                        }
                    ],
