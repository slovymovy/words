{
    "word_family": [
        "верх",
        "верхний",
        "верхушка",
        "вершина",
        "верховой"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "252c0b64-3f33-3ef4-874e-22eeb53a186e",
                    "sense_definition": "На верхнем этаже здания или помещения.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "loc_floors",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Моя спальня находится <w>наверху</w>, а кухня внизу.",
                            "target_lang_translations": {
                                "en": "My bedroom is <w>upstairs</w>, and the kitchen is downstairs.",
                                "it": "La mia camera da letto si trova <w>di sopra</w>, mentre la cucina è di sotto."
                            }
                        },
                        {
                            "text": "Соседи <w>наверху</w> снова громко слушают музыку.",
                            "target_lang_translations": {
                                "en": "The neighbors <w>upstairs</w> are listening to loud music again.",
                                "it": "I vicini <w>di sopra</w> ascoltano di nuovo la musica ad alto volume."
                            }
                        }
                    ],
                    "synonyms": [
                        "сверху"
                    ],
                    "antonyms": [
                        "внизу"
                    ],
                    "common_phrases": [
                        "соседи наверху",
                        "комната наверху",
                        "ждать наверху"
                    ],
                    "target_lang_definitions": {
                        "en": "On the upper floor of a building.",
                        "it": "Al piano superiore di un edificio o di una stanza."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "upstairs",
                                "target_lang_sense_clarification": "on a higher floor"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "di sopra",
                                "target_lang_sense_clarification": "riferito a un piano superiore"
                            },
                            {
                                "target_lang_word": "al piano di sopra",
                                "target_lang_sense_clarification": "più specifico per indicare il piano"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd3dc776-643b-3f47-98b5-67aff6b56722",
                    "sense_definition": "В верхней части чего-либо, на высоте; в более высоком месте.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "loc_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Посмотри, что там <w>наверху</w> на полке.",
                            "target_lang_translations": {
                                "en": "Look at what is <w>up there</w> on the shelf.",
                                "it": "Guarda cosa c'è <w>lassù</w> sullo scaffale."
                            }
                        },
                        {
                            "text": "Мы забрались на гору, и <w>наверху</w> был сильный ветер.",
                            "target_lang_translations": {
                                "en": "We climbed the mountain, and there was a strong wind <w>at the top</w>.",
                                "it": "Siamo saliti sulla montagna e <w>in cima</w> c'era un forte vento."
                            }
                        }
                    ],
                    "synonyms": [
                        "вверху",
                        "сверху"
                    ],
                    "antonyms": [
                        "внизу"
                    ],
                    "common_phrases": [
                        "там наверху",
                        "где-то наверху"
                    ],
                    "target_lang_definitions": {
                        "en": "In a higher place or position; at a height.",
                        "it": "In un luogo o posizione più elevata; in alto."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "above",
                                "target_lang_sense_clarification": "general location overhead"
                            },
                            {
                                "target_lang_word": "up there",
                                "target_lang_sense_clarification": "indicating a specific high location"
                            },
                            {
                                "target_lang_word": "at the top",
                                "target_lang_sense_clarification": "at the highest point"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "in alto",
                                "target_lang_sense_clarification": "posizione elevata generale"
                            },
                            {
                                "target_lang_word": "lassù",
                                "target_lang_sense_clarification": "indicando un luogo lontano in alto"
                            },
                            {
                                "target_lang_word": "in cima",
                                "target_lang_sense_clarification": "al punto più alto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68e2bef7-9449-3ca8-b312-9a04a234a096",
                    "sense_definition": "В руководящих органах, среди начальства или властей.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это важное решение было принято <w>наверху</w>.",
                            "target_lang_translations": {
                                "en": "This important decision was made <w>at the top</w>.",
                                "it": "Questa decisione importante è stata presa <w>ai piani alti</w>."
                            }
                        },
                        {
                            "text": "У него есть связи <w>наверху</w>, поэтому он не волнуется.",
                            "target_lang_translations": {
                                "en": "He has connections <w>at the top</w>, so he isn't worried.",
                                "it": "Ha delle conoscenze <w>ai piani alti</w>, quindi non è preoccupato."
                            }
                        }
                    ],
                    "synonyms": [
                        "в верхах"
                    ],
                    "common_phrases": [
                        "решить наверху",
                        "связи наверху",
                        "доложить наверху"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Among the leadership, bosses, or authorities.",
                        "it": "Tra i vertici, i dirigenti o le autorità."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at the top",
                                "target_lang_sense_clarification": "in the hierarchy or management"
                            },
                            {
                                "target_lang_word": "high up",
                                "target_lang_sense_clarification": "in a position of power"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "ai piani alti",
                                "target_lang_sense_clarification": "riferito alla gerarchia o al potere"
                            },
                            {
                                "target_lang_word": "ai vertici",
                                "target_lang_sense_clarification": "riferito alla dirigenza"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "5c0011c1-a916-31e0-a1a4-f0e4d36400e0",
                    "sense_definition": "В верхней части чего-либо (употребляется с родительным падежом).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Наверху</w> страницы нужно написать своё имя.",
                            "target_lang_translations": {
                                "en": "You need to write your name <w>at the top of</w> the page.",
                                "it": "Devi scrivere il tuo nome <w>in cima alla</w> pagina."
                            }
                        },
                        {
                            "text": "Птица свила гнездо <w>наверху</w> старого дерева.",
                            "target_lang_translations": {
                                "en": "The bird built a nest <w>at the top of</w> the old tree.",
                                "it": "L'uccello ha costruito il nido <w>in cima a un</w> vecchio albero."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "наверху лестницы",
                        "наверху страницы",
                        "наверху списка"
                    ],
                    "target_lang_definitions": {
                        "en": "At the highest part of something.",
                        "it": "Nella parte più alta di qualcosa."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at the top of",
                                "target_lang_sense_clarification": "standard prepositional phrase"
                            },
                            {
                                "target_lang_word": "on top of",
                                "target_lang_sense_clarification": "resting on the surface"
                            },
                            {
                                "target_lang_word": "atop",
                                "target_lang_sense_clarification": "literary or formal"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "in cima a",
                                "target_lang_sense_clarification": "parte superiore di un oggetto o luogo"
                            },
                            {
                                "target_lang_word": "in alto a",
                                "target_lang_sense_clarification": "posizione superiore su una superficie"
                            }
                        ]
                    },
                    "antonyms": [
                        "внизу"
                    ]
                }
            ]
        }
    ]
}