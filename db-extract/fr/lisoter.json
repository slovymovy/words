                "senses": [
                    {
                        "sense_id": "8df6fca1-e9c8-3b62-bc9c-e654ede84501",
                        "entry_id": "bb67b263-e6ef-3fad-b0d3-4595fb257a1a",
                        "glosses": [
                            "Lire un peu, lire distraitement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e92bdbff-3d0c-408d-bea4-5d519fafc564",
                                "sense_id": "8df6fca1-e9c8-3b62-bc9c-e654ede84501",
                                "text": "Hier, en attendant qu’on vienne annoncer le dîner, je lisotais un magazine quelconque."
                            },
                            {
                                "example_id": "79960893-a21b-436a-ac0c-a890119e380c",
                                "sense_id": "8df6fca1-e9c8-3b62-bc9c-e654ede84501",
                                "text": "Il lisotait, travaillotait, écrivotait, observotait, synthéticotait, transcendentalisotait, jusqu’au déjeuner, recommençait jusqu’au dîner ; puis il s’allait coucher et dormait d’un profond sommeil."
                            },
                            {
                                "example_id": "02d762b4-b156-4d00-8ec3-487fa9773d5e",
                                "sense_id": "8df6fca1-e9c8-3b62-bc9c-e654ede84501",
                                "text": "Génial de pouvoir embarquer autant de titres etde pouvoir, selon votre humeur, feuilleter celui-ci ou lisoter celui-là !"
                            }
                        ]
                    }
                ],
