                    },
                    {
                        "translation_id": "b241f718-cfcd-4b32-a2f0-7b47a17cdfdd",
                        "source_entry_id": "5ca10fe3-0e2a-37ed-96bf-302c9c4ed5b1",
                        "source_sense_id": "10e31e3f-d748-3b0a-988e-a7d929a146f7",
                        "target_lang_word": "bouvière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bouvière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df629621-6c3d-3f36-a566-b6d1aa3b5765",
                                        "entry_id": "ebebe66a-1c61-31fe-96e5-97a31cf887f3",
                                        "glosses": [
                                            "Femme qui soigne et conduit des bœufs."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ce8a43f-05c0-405b-8cf6-e8583553bcc6",
                                                "sense_id": "df629621-6c3d-3f36-a566-b6d1aa3b5765",
                                                "text": "Charles n'aurait pas mieux demandé, et cependant il ménagea la vaincue. Tant il est vrai qu'une femme, fût-ce même une bouvière, conserve toujours des droits sur un cœur bien placé."
                                            },
                                            {
                                                "example_id": "85f583ea-635b-4769-9242-294a64eca331",
                                                "sense_id": "df629621-6c3d-3f36-a566-b6d1aa3b5765",
                                                "text": "Quoi de plus risible que la petitesse des moyens de cette comtesse […]! Elle a pour page un petit vacher, et pour femme de chambre une bouvière, qui lui saboule la tête en lui ôtant ses coiffes."
                                            },
                                            {
                                                "example_id": "67964f23-52bf-4ec7-916d-9e05037de100",
                                                "sense_id": "df629621-6c3d-3f36-a566-b6d1aa3b5765",
                                                "text": "Par le soupirail grillagé passent une branche d'arbre et une voix de femme aigre et lente. Une bouvière solitaire et qui tiaule."
                                            },
                                            {
                                                "example_id": "8a9d4109-930c-426a-8a9d-a2a66f571d20",
                                                "sense_id": "df629621-6c3d-3f36-a566-b6d1aa3b5765",
                                                "text": "Elle avait commencé de sévir dans le faubourg de Langogne, au printemps 1764. […]. C'est une bouvière, précisément, qui va se trouver, la première, face à face avec la Bête ; une pauvre dame qui ne devra son salut qu'en ayant l'idée d'aller se réfugier au cœur de son troupeau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bouvière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce25fc95-001b-3cea-bd44-55186ab0df90",
                                        "entry_id": "596b48ab-282d-3bfa-977b-32975c92b6e2",
                                        "glosses": [
                                            "Espèce de petit poisson osseux d'eau douce d’Europe, de la famille des carpes, au corps comprimé et haut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c36ec9c-f6a4-4601-a3b6-ca9ca675e11b",
                                                "sense_id": "ce25fc95-001b-3cea-bd44-55186ab0df90",
                                                "text": "Il n’entre en jeu pour les poissons « nombreux et petits » que les gardons, les ablettes et les bouvières."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
