{
    "word_family": [
        "immediate",
        "immediately"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc84ca3e-578e-3170-bb5f-5d7c404022ac",
                    "sense_definition": "The quality of happening right away without delay.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>immediacy</w> of the response surprised everyone in the room.",
                            "target_lang_translations": {
                                "ru": "<w>Незамедлительность</w> ответа удивила всех в комнате."
                            }
                        },
                        {
                            "text": "He valued the <w>immediacy</w> of digital communication for urgent tasks.",
                            "target_lang_translations": {
                                "ru": "Он ценил <w>быстроту</w> цифровой связи для решения срочных задач."
                            }
                        }
                    ],
                    "synonyms": [
                        "instantaneity"
                    ],
                    "common_phrases": [
                        "sense of immediacy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство происходить немедленно, без задержки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незамедлительность",
                                "target_lang_sense_clarification": "отсутствие задержки во времени"
                            },
                            {
                                "target_lang_word": "быстрота",
                                "target_lang_sense_clarification": "оперативность, скорость реакции"
                            },
                            {
                                "target_lang_word": "мгновенность",
                                "target_lang_sense_clarification": "моментальный характер действия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3e21325-cd3a-3a66-939a-bc0ac41285a0",
                    "sense_definition": "The quality of being direct and without any intermediate steps or agents.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "directness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>immediacy</w> of the experience made it feel very personal.",
                            "target_lang_translations": {
                                "ru": "<w>Непосредственность</w> этого опыта сделала его очень личным."
                            }
                        },
                        {
                            "text": "She preferred the <w>immediacy</w> of face-to-face meetings over emails.",
                            "target_lang_translations": {
                                "ru": "Она предпочитала <w>прямой контакт</w> личных встреч общению по электронной почте."
                            }
                        }
                    ],
                    "synonyms": [
                        "plainness",
                        "unambiguousness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство быть прямым, непосредственным, без промежуточных звеньев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непосредственность",
                                "target_lang_sense_clarification": "отсутствие посредников или промежуточных этапов"
                            },
                            {
                                "target_lang_word": "прямой контакт",
                                "target_lang_sense_clarification": "прямой, близкий характер взаимодействия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7b6a494-8409-3041-a277-16e326be28de",
                    "sense_definition": "The state of having direct awareness or understanding of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "directness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist captured the <w>immediacy</w> of the moment in her painting.",
                            "target_lang_translations": {
                                "ru": "Художница передала в своей картине <w>живую непосредственность</w> момента."
                            }
                        },
                        {
                            "text": "He felt a sudden <w>immediacy</w> of danger as the storm approached.",
                            "target_lang_translations": {
                                "ru": "С приближением бури он внезапно ощутил всю <w>остроту</w> опасности."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ощущение живой связи с моментом, острая близость или реалистичность восприятия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "острота",
                                "target_lang_sense_clarification": "живость, яркость и непосредственность восприятия"
                            },
                            {
                                "target_lang_word": "непосредственность",
                                "target_lang_sense_clarification": "живое ощущение текущего момента"
                            },
                            {
                                "target_lang_word": "эффект присутствия",
                                "target_lang_sense_clarification": "ощущение близости и реальности происходящего"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}