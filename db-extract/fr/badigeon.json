        "fr-extract.jsonl": [
            {
                "entry_id": "bc7846e8-18fc-33f7-93ba-4d3802248e2b",
                "word": "badigeon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a52f2eff-3d13-48a1-8e9f-15a6c8732d67",
                        "entry_id": "bc7846e8-18fc-33f7-93ba-4d3802248e2b",
                        "tags": [
                            "plural"
                        ],
                        "form": "badigeons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aeedc1a6-72ef-34f5-bb54-fac1c9189f68",
                        "entry_id": "bc7846e8-18fc-33f7-93ba-4d3802248e2b",
                        "glosses": [
                            "Couleur en détrempe dont on peint les murailles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6bd4eba-d435-4f8b-a7dd-167679a9c3cc",
                                "sense_id": "aeedc1a6-72ef-34f5-bb54-fac1c9189f68",
                                "text": "Le badigeon, au grand désappointement des voyageurs et des antiquaires, règne en souverain à Séville ; les maisons mettent trois, quatre fois par an des chemises de chaux, ce qui leur donne un air de soin et de propreté, mais dérobe aux investigations les restes des sculptures arabes et gothiques qui les ornaient anciennement."
                            },
                            {
                                "example_id": "df62a7e9-883a-4b7d-85ed-7195813fc6ca",
                                "sense_id": "aeedc1a6-72ef-34f5-bb54-fac1c9189f68",
                                "text": "Une église qui serait passable, d’ailleurs, si elle n’était encroûtée par le plus épais des badigeons qu’aient jamais rêvés les conseils de fabrique."
                            },
                            {
                                "example_id": "99e69ac8-ed20-4356-a986-6983bc9da6a7",
                                "sense_id": "aeedc1a6-72ef-34f5-bb54-fac1c9189f68",
                                "text": "Décrépir les Pensées, ce serait peut-être ôter le badigeon qui recouvre des pierres sculptées. On verrait ce que Pascal aurait pensé si, au lieu de se retirer à Port-Royal, il avait été rejoindre Descartes en Hollande."
                            },
                            {
                                "example_id": "9270b4b6-ea3d-48fd-9458-ec908c3d4f42",
                                "sense_id": "aeedc1a6-72ef-34f5-bb54-fac1c9189f68",
                                "text": "On peut exécuter le badigeon plusieurs mois après la pose de la finition."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f064f1c-4a17-4429-95bf-bf0bd2dab78c",
                        "source_entry_id": "bc7846e8-18fc-33f7-93ba-4d3802248e2b",
                        "source_sense_id": "aeedc1a6-72ef-34f5-bb54-fac1c9189f68",
                        "source_sense_description": "Couleur en détrempe dont on peint les murailles.",
                        "target_lang_word": "Tünche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tünche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "800462cd-1752-380c-86d9-454539418ed2",
                                        "entry_id": "69448ac3-4d1d-36b9-a8e6-a78df6c70390",
                                        "glosses": [
                                            "aus weißer (oder oft mit Farbstoffen getönter) Kalkmilch bestehende, mitunter auch Leim als Bindemittel enthaltende Anstrichfarbe, mit der Wände gestrichen werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b41507b-1d22-4441-8573-f78a6ff5f6fb",
                                                "sense_id": "800462cd-1752-380c-86d9-454539418ed2",
                                                "text": "Die Wand war mit Tünche gestrichen."
                                            },
                                            {
                                                "example_id": "fdd75de3-dc7d-419d-a85f-9a5a95b50484",
                                                "sense_id": "800462cd-1752-380c-86d9-454539418ed2",
                                                "text": "„Da war eine beſchädigte Stelle in dem Bewurf, welche wie ein Land ausſah mit Seen und Städten, und ein Häufchen von groben Sandkörnern ſtellte eine glückſelige Inſelgruppe vor; weiterhin erſtreckte ſich eine lange Schweinsborſte, welche aus dem Pinſel gefallen und in der blauen Tünche ſtecken geblieben war; denn Jobſt hatte im letzten Herbſt einmal ein kleines Reſtchen ſolcher Tünche gefunden und damit es nicht umkommen ſollte, eine Viertelswandseite damit angeſtrichen, ſo weit es reichen wollte, und zwar hatte er die Stelle bemalt, wo er zunächſt im Bette lag.“"
                                            },
                                            {
                                                "example_id": "2648b17e-ca76-4637-a778-4615369dc1d0",
                                                "sense_id": "800462cd-1752-380c-86d9-454539418ed2",
                                                "text": "„Wie jetzt das Kirchlein ſich präſentirt, ſticht es jedenfalls ſehr vortheilhaft von dem gegenüber gelegenen Schloßbau ab, mit dem es nur das Alleräußerlichſte und Gleichgültigſte, die gelbe Tünche, gemein hat.“"
                                            },
                                            {
                                                "example_id": "541e0376-391a-47a7-8d5a-ca90aea2d5e7",
                                                "sense_id": "800462cd-1752-380c-86d9-454539418ed2",
                                                "text": "«Denn es gehe die Rede, daß in dem älteren Flügel des Hauſes etwas nicht richtig ſei. […] Die alte Mama beklagte ſich über ſo beunruhigende Herumbietungen, die doch keinen vernünftigen Grund haben könnten; der alte Herr verwies darauf, daß mit Luft und Licht und friſcher Tünche der neuen Arbeiten das Unweſen ſich wol verziehen werde.»"
                                            },
                                            {
                                                "example_id": "89d05da5-c416-41ed-818c-80f60b52b067",
                                                "sense_id": "800462cd-1752-380c-86d9-454539418ed2",
                                                "text": "„Er kannte jeden kleinsten Pinselstrich der Tünche, die beiden Stellen, an denen Nägel wieder ausgezogen waren, und sehr genau die fünf Stellen, wo früherer Nageleinschlag übertüncht war.“"
                                            },
                                            {
                                                "example_id": "9357743c-b520-4989-9c21-3353cf23afd6",
                                                "sense_id": "800462cd-1752-380c-86d9-454539418ed2",
                                                "text": "„An der feuchten Wand, von der die Tünche bröckelte, ein unbeholfener Öldruck des Sultans und ein paar gerahmte Koransprüche.“"
                                            },
                                            {
                                                "example_id": "bd02cccf-6dde-457e-9c68-e732e06b40b2",
                                                "sense_id": "800462cd-1752-380c-86d9-454539418ed2",
                                                "text": "„Er habe in seinen Analysen keine Spur von Pigmenten (Farbstoffen) in den Tünchen gefunden, mit denen die Festung all die Jahrhunderte gestrichen worden sei.“"
                                            },
                                            {
                                                "example_id": "d8ec9243-916b-4f58-9386-392572601e61",
                                                "sense_id": "800462cd-1752-380c-86d9-454539418ed2",
                                                "text": "„Die Malerei wird derzeit mit Skalpell und Glasfaser-Stiften von den Tünchen der vergangenen Jahrhunderte befreit.“"
                                            },
                                            {
                                                "example_id": "0e1428a2-5654-44e6-bd82-d76243536312",
                                                "sense_id": "800462cd-1752-380c-86d9-454539418ed2",
                                                "text": "„Die Tünche der Fassade wurde durch einen frischen roten Schmiss aus der Ruhe gebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b4cca5a9-1ca5-339c-9982-a3f21b7ce1d5",
                                        "entry_id": "69448ac3-4d1d-36b9-a8e6-a78df6c70390",
                                        "glosses": [
                                            "vor allem auf die Gesichtshaut aufgetragenes kosmetisches Mittel zur Verschönerung beziehungsweise (insbesondere in den darstellenden Künsten) zur Veränderung des Aussehens"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e27ae256-b932-4b5d-893e-a9c7b679d0c1",
                                                "sense_id": "b4cca5a9-1ca5-339c-9982-a3f21b7ce1d5",
                                                "text": "„Ehrlich gesagt: was wir gesehen haben, waren thönerne Beine, und was wie gesunde Fleischfarbe erschien, war nur aufgemalte Tünche.“"
                                            },
                                            {
                                                "example_id": "efcc45f0-6f6a-4968-a2d3-7458b94b5258",
                                                "sense_id": "b4cca5a9-1ca5-339c-9982-a3f21b7ce1d5",
                                                "text": "„‚Dafür sehen Sie aber recht propper aus, Frau Paulsen‘, konnte sich Barbara die Bemerkung nicht verkneifen, ‚oder ist das alles Tünche, was Sie im Gesicht tragen?‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "90f7c664-da21-3f1d-8a96-4d88da23ff52",
                                        "entry_id": "69448ac3-4d1d-36b9-a8e6-a78df6c70390",
                                        "glosses": [
                                            "etwas, was einen Sachverhalt, das äußere Erscheinungsbild, den wahren Hintergrund oder das eigentliche Wesen verschleiern, verdecken soll"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "no-plural",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43a17d57-a611-44b4-8b82-2830d4bbbf57",
                                                "sense_id": "90f7c664-da21-3f1d-8a96-4d88da23ff52",
                                                "text": "„Der Mittelſtand wird langſam, aber ſicher zerrieben — die mühſam bewahrte Haltung der Bürgerlichen iſt heute ſchon häufig Tünche, und nach oben und unten wandern ſie ab: nach oben — das ſind die Kriegs- und Revolutionsgewinnler; nach unten: die proletariſierten Maſſen.“"
                                            },
                                            {
                                                "example_id": "e972574a-f335-432b-a52b-707efe07f4b4",
                                                "sense_id": "90f7c664-da21-3f1d-8a96-4d88da23ff52",
                                                "text": "„Jetzt gehe mit dem Wert seines Geldes seine demokratische Tünche vollends dahin.“"
                                            },
                                            {
                                                "example_id": "ffe3ea2a-83fb-4844-91eb-7652ed6ce528",
                                                "sense_id": "90f7c664-da21-3f1d-8a96-4d88da23ff52",
                                                "text": "„Man könnte sagen, sie sind alle ‚schlecht getauft‘, unter der dünnen Tünche von Christentum sind sie geblieben, was ihre Ahnen waren, die einem barbarischen Polytheismus huldigten.“"
                                            },
                                            {
                                                "example_id": "6346837f-0167-4336-96db-b9e83c3eec25",
                                                "sense_id": "90f7c664-da21-3f1d-8a96-4d88da23ff52",
                                                "text": "„Euer Gedicht, Verehrter, das Ihr mit dem Marschbefehl ›Transzendieren!‹ überschrieben und dessen Titel Ihr später, Gott sei Dank, durch einen sehr viel besseren ersetzt habet, hat mir nie so recht gefallen, weil es etwas Befehlendes, etwas Moralisierendes oder Schulmeisterliches hat. Könnte man ihm dieses Element nehmen oder vielmehr diese Tünche abwaschen, so wäre es eines Eurer schönsten Gedichte, das habe ich soeben wieder bemerkt.“"
                                            },
                                            {
                                                "example_id": "063ebbc6-e42e-4a41-ab48-0346e954501e",
                                                "sense_id": "90f7c664-da21-3f1d-8a96-4d88da23ff52",
                                                "text": "„Jetzt hält die Tünche nicht mehr, und es kommen Geschichten zum Vorschein, über die wir 40 Jahre lang nie gesprochen haben.“"
                                            },
                                            {
                                                "example_id": "66e33f60-6e9a-4e67-966f-be895540b8b2",
                                                "sense_id": "90f7c664-da21-3f1d-8a96-4d88da23ff52",
                                                "text": "„Frühe Auslandsaufenthalte in Indien und Brasilien – Kahanes Vater war Journalist – begründen ihre Liebe zum Süden und zu den dort lebenden Menschen ebenso wie sie der unter der Tünche sozialistischer Gesinnung fortdauernde Rassismus und Antisemitismus der DDR schon früh anwidert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
