                        "zh": [
                            {
                                "target_lang_word": "泰国菜",
                                "target_lang_sense_clarification": "指代烹饪风格或菜肴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69cdcbcc-7ca3-31be-b139-4aff79e937b5",
                    "sense_definition": "A domestic cat breed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Thai</w> is related to the modern Siamese cat but has a different head shape.",
                            "target_lang_translations": {
                                "ru": "<w>Тайская кошка</w> родственна современной сиамской, но имеет другую форму головы.",
                                "zh": "<w>泰国猫</w>与现代暹罗猫有亲缘关系，但头部形状不同。"
                            }
                        },
                        {
                            "text": "My neighbor owns a beautiful <w>Thai</w> with striking blue eyes.",
                            "target_lang_translations": {
                                "ru": "У моего соседа есть красивая <w>тайская кошка</w> с поразительными голубыми глазами.",
                                "zh": "我的邻居养了一只眼睛非常漂亮的<w>泰国猫</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Thai cat"
                    ],
                    "target_lang_definitions": {
