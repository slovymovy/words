                    ]
                },
                {
                    "sense_id": "49ee636d-0df4-37a9-970f-52c7fe3c2392",
                    "sense_definition": "Relation logique liant deux propositions, où la vérité de la première entraîne nécessairement celle de la seconde.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En logique formelle, une <w>implication</w> est fausse seulement si l'hypothèse est vraie et la conclusion fausse."
                        },
                        {
                            "text": "Le professeur a dessiné une flèche d'<w>implication</w> entre les deux théorèmes."
                        }
                    ],
                    "synonyms": [
