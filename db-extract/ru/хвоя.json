                    },
                    {
                        "translation_id": "e3b8a9cb-1aff-4d3f-b443-e4b07b92d5a8",
                        "source_entry_id": "0f266c49-be93-34a2-b46c-9903ab71083a",
                        "source_sense_description": "иглообразная листва",
                        "target_lang_word": "aiguilles (de conifères)",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "149ed8a3-02fa-4513-9fb1-eae72df89d86",
                        "source_entry_id": "0f266c49-be93-34a2-b46c-9903ab71083a",
                        "source_sense_description": "иглообразная листва",
                        "target_lang_word": "épine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa695e3f-3ec0-306e-8851-242f900049bd",
                                        "entry_id": "9a1a412a-95d7-3463-8312-650aef08bfc5",
                                        "glosses": [
                                            "Branche, feuille, stipule ou partie de feuille transformée en un organe allongé et piquant ; par opposition à l’aiguillon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ce56c5b-1199-4db6-a316-ac85bac3b4a8",
                                                "sense_id": "aa695e3f-3ec0-306e-8851-242f900049bd",
                                                "text": "Une maigre brousse arborescente hérisse les parties basses du terrain — bouquets de daschi et de candili garnis de plus d’épines que de feuilles."
                                            },
                                            {
                                                "example_id": "bdff76a1-6703-443b-b54e-18cada0bd7d3",
                                                "sense_id": "aa695e3f-3ec0-306e-8851-242f900049bd",
                                                "text": "Le Rosier ou la Ronce portent des aiguillons non pas des épines à l’inverse, par exemple, d’un Robinier, le faux-acacia qui envahit nos bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89bb9259-bebb-3f8b-96ff-fbbea79d945a",
                                        "entry_id": "9a1a412a-95d7-3463-8312-650aef08bfc5",
                                        "glosses": [
                                            "Piquant que l’on trouve sur une plante indifféremment de son origine tissulaire."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f70e27bf-07b5-497b-85c2-acec9e3076d8",
                                                "sense_id": "89bb9259-bebb-3f8b-96ff-fbbea79d945a",
                                                "text": "Botaniquement c’est très vrai. les rosiers n’ont pas d’épines. Mais nul botanistes n’aura la puissance d’empêcher le proverbe d'affirmer qu’il n’y a pas de rose sans épines."
                                            },
                                            {
                                                "example_id": "eb9f88bf-e3d6-44d8-b59e-2259fa423ead",
                                                "sense_id": "89bb9259-bebb-3f8b-96ff-fbbea79d945a",
                                                "text": "Un jour, par exemple, parlant de ses quatre épines, [la rose] avait dit au petit prince: - Ils peuvent venir, les tigres, avec leurs griffes !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5a5dfe9-62b1-3a39-9d10-fee4de73633d",
                                        "entry_id": "9a1a412a-95d7-3463-8312-650aef08bfc5",
                                        "glosses": [
                                            "Espèce d’arbre ou d’arbrisseau dont les branches ont des piquants."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3404327a-3b36-427b-a26c-b4bb66ea56b6",
                                                "sense_id": "a5a5dfe9-62b1-3a39-9d10-fee4de73633d",
                                                "text": "On commence d’abord par nettoyer le sol en arrachant les ronces, les épines, les bruyères, etc., puis on procède à l’abattage du taillis."
                                            },
                                            {
                                                "example_id": "8fdacf73-9650-4416-8921-100d001d5bf5",
                                                "sense_id": "a5a5dfe9-62b1-3a39-9d10-fee4de73633d",
                                                "text": "La haie actuelle, composée d’épine et de sureau restera en l’état."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "980b3cd3-ed56-33b1-afc3-85141eb0c1e3",
                                        "entry_id": "9a1a412a-95d7-3463-8312-650aef08bfc5",
                                        "glosses": [
                                            "Espèce d’arbre ou d’arbrisseau dont les branches ont des piquants.",
                                            "Piquants de châtaignes, de poires, etc."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08d90825-c9cf-315b-b24c-bcd366177578",
                                        "entry_id": "9a1a412a-95d7-3463-8312-650aef08bfc5",
                                        "glosses": [
                                            "Difficultés ; choses qui donnent beaucoup de peine ou qui sont désagréables, fâcheuses."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f3b1228-36bd-4aae-a10d-6ff381582d45",
                                                "sense_id": "08d90825-c9cf-315b-b24c-bcd366177578",
                                                "text": "— Ah ! monsieur, dans l’exercice de mon pénible ministère, il y a bien des épines. Mais aussi, que de fruits !"
                                            },
                                            {
                                                "example_id": "70a5370f-2526-4927-80ac-82ad305edd32",
                                                "sense_id": "08d90825-c9cf-315b-b24c-bcd366177578",
                                                "text": "Pour Pavlov le chemin de la vie fut jonché d’épines, plein d’amertume , de déceptions et de luttes acharnées…"
                                            },
                                            {
                                                "example_id": "c9fa92c9-cf08-46fe-b966-eeac2df8c12f",
                                                "sense_id": "08d90825-c9cf-315b-b24c-bcd366177578",
                                                "text": "Il n’y a pas de science dont l’étude ne soit pleine d’épines et de difficultés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8c16de7-b784-3d1c-9ae1-3e82a83a309c",
                                        "entry_id": "9a1a412a-95d7-3463-8312-650aef08bfc5",
                                        "glosses": [
