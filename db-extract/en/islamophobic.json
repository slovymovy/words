                        ]
                    },
                    {
                        "translation_id": "85132002-4b17-461c-a21f-783119cd64c7",
                        "source_entry_id": "35e65fa7-031a-38d5-94dd-24aa472cd23a",
                        "source_sense_id": "a7d9baaa-cba0-30c0-b01e-e4ee9d905d70",
                        "source_sense_description": "Islamophobic",
                        "target_lang_word": "islamfeindlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "islamfeindlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c48d521-2749-37e1-8d3b-29ade5acb41c",
                                        "entry_id": "949d4be3-0ef7-378c-956e-97fd6c0a8003",
                                        "glosses": [
                                            "sehr deutlich, sehr negativ gegenüber der Religion des Islams eingestellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ab9ef3a-a88c-4b37-a32f-b07a39903092",
                                                "sense_id": "3c48d521-2749-37e1-8d3b-29ade5acb41c",
                                                "text": "„Die Initiatoren schüren mit ausländerfeindlicher Hetze und islamfeindlicher Agitation Vorurteile und Ängste.“"
                                            },
                                            {
                                                "example_id": "d0e6c9fe-e037-42ca-8c59-fb65853302c1",
                                                "sense_id": "3c48d521-2749-37e1-8d3b-29ade5acb41c",
                                                "text": "„Eine der islamfeindlichsten Aktionen des Westens war nach Meinung der IPW die Unterstützung, die westliche Medien der anti-islamischen Politik Gorbatschows zukommen ließen.“"
                                            },
                                            {
                                                "example_id": "4b0b4c96-8602-4583-b10d-54e3fdf0b605",
                                                "sense_id": "3c48d521-2749-37e1-8d3b-29ade5acb41c",
                                                "text": "„Liebe Userinnen und User, versuchen Sie doch bitte, Ihre unterschiedlichen Positionen zum Nahostkonflikt auszutauschen – ohne sich antisemitisch oder islamfeindlich zu äußern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c0242b1-43b8-44a6-8cc4-5e78f91c5a8c",
                        "source_entry_id": "35e65fa7-031a-38d5-94dd-24aa472cd23a",
                        "source_sense_id": "a7d9baaa-cba0-30c0-b01e-e4ee9d905d70",
                        "source_sense_description": "Islamophobic",
                        "target_lang_word": "islamophob",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "islamophob",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd552d39-8c5d-3cdb-864b-06b4add49fc2",
                                        "entry_id": "e702549f-8089-3261-a5de-002b860955d4",
                                        "glosses": [
                                            "(oft starke) Abneigung gegen den Islam oder gegen Muslime habend oder so eine Abneigung zeigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ca9af63-f0f9-477a-9b69-288c8a9987d7",
                                                "sense_id": "bd552d39-8c5d-3cdb-864b-06b4add49fc2",
                                                "text": "„Wie mir ergeht es vielen. Der Vorwurf, islamophob zu sein, wenn man Kritik am Islam übt, wird mittlerweile fast reflexhaft erhoben.“"
                                            },
                                            {
                                                "example_id": "01861f58-64f6-4ab2-a4a0-e471063965de",
                                                "sense_id": "bd552d39-8c5d-3cdb-864b-06b4add49fc2",
                                                "text": "„Ich wehre mich dagegen zu sagen, die Niederlande seien auf einmal islamophob. Holland hat keine Angst vor dem Islam.“"
                                            },
                                            {
                                                "example_id": "074c9d61-725e-4ca0-8aeb-f543fb221cba",
                                                "sense_id": "bd552d39-8c5d-3cdb-864b-06b4add49fc2",
                                                "text": "„Bei seiner Kritik an dem Islamgesetz wiederholte Erdogan auch seinen regelmäßig erhobenen Vorwurf, Muslime sähen sich im Westen und vor allem in Europa islamophoben Vorurteilen ausgesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
