                "senses": [
                    {
                        "sense_id": "e8a8dd43-ff50-3b3c-b685-9690196e1621",
                        "entry_id": "3c626672-4fdb-3d71-a1de-3e2d276fb52b",
                        "glosses": [
                            "Autodrom, Autorennbahn, Motodrom"
                        ],
                        "tags": [],
