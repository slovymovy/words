                                "target_senses": [
                                    {
                                        "sense_id": "62ef6f90-c058-32be-9077-65fdfae6251e",
                                        "entry_id": "79870bf5-c3ac-312e-8ddf-95d0085def47",
                                        "glosses": [
                                            "To bale a shaft dry."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e466385-90b0-41fd-a4c3-2a0c435944cb",
                                                "sense_id": "62ef6f90-c058-32be-9077-65fdfae6251e",
                                                "text": "Forking the water, is drawing it all out; and when it is done, they say, “the mine or the water is forked;” and “the engine is in fork.”"
                                            }
