                        ],
                        "examples": [
                            {
                                "example_id": "b8a999a8-7acc-4103-b28d-22c98efed8f5",
                                "sense_id": "37bac94e-87ea-365e-be7e-32129cdb377e",
                                "text": "As in the Salem Witch Hunt mobbings, the McMartin Preschool Sexual Abuse Case mobbings also provides^([sic]) an opportunity for analyzing what could have been done, but wasn't, to stop a relentless social process that hurt everyone in its wake[…]"
                            }
                        ]
                    },
                    {
