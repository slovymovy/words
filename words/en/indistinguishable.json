{
    "word_family": [
        "distinguish",
        "distinguishable",
        "indistinguishability",
        "indistinguishably"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6077d070-3c21-3164-ac9b-ce30360555b4",
                    "sense_definition": "Impossible to tell apart or recognize as different from someone or something else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "differentiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The replica was so well made that it was practically <w>indistinguishable</w> from the original painting.",
                            "target_lang_translations": {
                                "ru": "Реплика была сделана настолько качественно, что была практически <w>неотличима</w> от оригинальной картины."
                            }
                        },
                        {
                            "text": "From a distance, the twin brothers look completely <w>indistinguishable</w>.",
                            "target_lang_translations": {
                                "ru": "Издалека братья-близнецы кажутся совершенно <w>неразличимыми</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "identical",
                        "interchangeable"
                    ],
                    "antonyms": [
                        "distinguishable"
                    ],
                    "common_phrases": [
                        "virtually indistinguishable",
                        "practically indistinguishable",
                        "almost indistinguishable",
                        "indistinguishable from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Такой, который невозможно отличить от кого-либо или чего-либо другого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неразличимый",
                                "target_lang_sense_clarification": "о сходстве, одинаковости предметов или людей"
                            },
                            {
                                "target_lang_word": "неотличимый",
                                "target_lang_sense_clarification": "не отличающийся от чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53b70c27-4d45-3f85-8fdc-154dedd27abb",
                    "sense_definition": "Impossible to perceive clearly, discern, or detect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quiet whisper was <w>indistinguishable</w> beneath the loud hum of the traffic.",
                            "target_lang_translations": {
                                "ru": "Тихий шепот был <w>неразличим</w> из-за громкого гула транспорта."
                            }
                        },
                        {
                            "text": "Through the heavy fog, the outlines of the distant trees were completely <w>indistinguishable</w>.",
                            "target_lang_translations": {
                                "ru": "Сквозь густой туман очертания далеких деревьев были совершенно <w>неразличимы</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "imperceptible",
                        "indiscernible"
                    ],
                    "antonyms": [
                        "distinguishable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Такой, который невозможно четко воспринять, увидеть, услышать или распознать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неразличимый",
                                "target_lang_sense_clarification": "о зрительном или слуховом восприятии"
                            },
                            {
                                "target_lang_word": "неуловимый",
                                "target_lang_sense_clarification": "едва заметный для восприятия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63535014-82ca-399e-8a7e-753244922afa",
                    "sense_definition": "Something that cannot be distinguished from another item in a group.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In quantum mechanics, particles can be treated as identical <w>indistinguishables</w>.",
                            "target_lang_translations": {
                                "ru": "В квантовой механике частицы могут рассматриваться как идентичные <w>неразличимые частицы</w>."
                            }
                        },
                        {
                            "text": "The philosopher discussed the identity of <w>indistinguishables</w> in his famous lecture.",
                            "target_lang_translations": {
                                "ru": "В своей знаменитой лекции философ обсуждал принцип тождества <w>неразличимых</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "identity of indistinguishables"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечто, что невозможно отличить от другого объекта в группе (в философии и физике)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неразличимый объект",
                                "target_lang_sense_clarification": "в научном или философском контексте"
                            },
                            {
                                "target_lang_word": "тождественный объект",
                                "target_lang_sense_clarification": "в квантовой механике или логике"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}