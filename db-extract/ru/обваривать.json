                                        "glosses": [
                                            "Brûler avec un liquide bouillant ou de la vapeur résultant de cette ébullition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "528b4f7c-6378-4402-b9d1-269caba80526",
                                                "sense_id": "c00010ec-f288-3e88-93f5-711c001bdfe4",
                                                "text": "Pour tuer les chrysalides, on ébouillante les cocons des vers à soie."
                                            },
                                            {
                                                "example_id": "6c1d95d7-9bf2-47ed-a6d9-7ef6cc442823",
                                                "sense_id": "c00010ec-f288-3e88-93f5-711c001bdfe4",
                                                "text": "Il s’est cruellement ébouillanté."
                                            },
                                            {
                                                "example_id": "a328a7ef-e041-41b1-8b0f-712fd976e15b",
                                                "sense_id": "c00010ec-f288-3e88-93f5-711c001bdfe4",
                                                "text": "Il vit que ses adversaires avaient le visage rouge comme la peau des porcs ébouillantés."
