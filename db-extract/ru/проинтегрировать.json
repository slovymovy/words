                ],
                "translations": [
                    {
                        "translation_id": "07a925a4-1927-4e04-bbd5-795a48e774d2",
                        "source_entry_id": "2f819924-1750-3361-ae3e-35076f67ca65",
                        "source_sense_id": "9eec0eca-ee96-3ba2-a056-e0a08a5c1e25",
                        "target_lang_word": "integrate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "integrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "676d8100-4d3b-3e9a-b5b8-195c4b250c51",
                                        "entry_id": "ac9e6198-cbd6-3c3a-ab50-33afa19c4277",
                                        "glosses": [
                                            "To include as a constituent part or functionality."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ab337db-5802-48a0-9020-69ecb0c5e17c",
                                                "sense_id": "676d8100-4d3b-3e9a-b5b8-195c4b250c51",
                                                "text": "They were keen to integrate their new skills into the performance."
                                            },
                                            {
                                                "example_id": "5012e588-6b91-47aa-9015-40bf2fbe7428",
                                                "sense_id": "676d8100-4d3b-3e9a-b5b8-195c4b250c51",
                                                "text": "All of Peter Schickele's music, both straight and comedic are integrated side by side in this chapter."
                                            },
                                            {
                                                "example_id": "08647071-a1ce-4a63-8caf-9a7a72daa597",
                                                "sense_id": "676d8100-4d3b-3e9a-b5b8-195c4b250c51",
                                                "text": "Along the way, companies such as Facebook and Google employ every useful foot soldier, including social scientists such as [Alexander] Kogan who are willing to put their shoulders to the wheel as they help the company learn, perfect, and integrate the cutting-edge methods that can conquer the next frontier […]"
                                            },
                                            {
                                                "example_id": "7c316da2-a1d4-4f61-b4a4-0fe961156e05",
                                                "sense_id": "676d8100-4d3b-3e9a-b5b8-195c4b250c51",
                                                "text": "Vendors must also describe to the Air Force whether they have experience integrating the device with payloads from other businesses, if they are capable of supporting flight test operations and working with ground support equipment and how soon the capability can be delivered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bf4f7e9-dd52-304c-b213-5f97f85be48b",
                                        "entry_id": "ac9e6198-cbd6-3c3a-ab50-33afa19c4277",
                                        "glosses": [
                                            "To join a group or an environment harmoniously; to make oneself fit in."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "reflexive",
                                            "sometimes",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "957f2bbb-0f4a-4cc0-87be-d7a987f2c7d5",
                                                "sense_id": "8bf4f7e9-dd52-304c-b213-5f97f85be48b",
                                                "text": "The refugees integrated well into the community."
                                            },
                                            {
                                                "example_id": "a96b9be7-3af0-408c-a2c5-1b59b0bf7411",
                                                "sense_id": "8bf4f7e9-dd52-304c-b213-5f97f85be48b",
                                                "text": "The eco-friendly building integrates with the forest around it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc3d2328-d4b6-3666-893d-92314d31e875",
                                        "entry_id": "ac9e6198-cbd6-3c3a-ab50-33afa19c4277",
                                        "glosses": [
                                            "To form into one whole; to make entire; to complete; to renew; to restore; to perfect."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "574367e3-2ea1-40b4-94c7-76572d28fa97",
                                                "sense_id": "cc3d2328-d4b6-3666-893d-92314d31e875",
                                                "text": "Virtually free of pain, she has integrated the broken pieces of her life, is a loving and loved wife and mother, and is back at her job."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bba97b90-8fd6-3939-8103-afee255d6a00",
                                        "entry_id": "ac9e6198-cbd6-3c3a-ab50-33afa19c4277",
                                        "glosses": [
                                            "To give the sum or total of a varying quantity over an interval such as a period of time or an area."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9134a76-5f9d-4249-877d-a388bbae780a",
                                                "sense_id": "bba97b90-8fd6-3939-8103-afee255d6a00",
                                                "text": "Data gathered at each remote site include sulphur dioxide in parts per million, a five-minute integrated wind direction to the nearest degree and a five-minute integrated wind speed to the nearest one-tenth knot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2acd8d9-d34e-30eb-9ff4-666f8c22afdf",
                                        "entry_id": "ac9e6198-cbd6-3c3a-ab50-33afa19c4277",
                                        "glosses": [
                                            "To subject to the operation of integration; to find the integral of an equation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa3220f8-b1cf-4d94-9db7-a31ceee2306f",
                                                "sense_id": "c2acd8d9-d34e-30eb-9ff4-666f8c22afdf",
                                                "text": "As Example 9 indicates, we can integrate sinⁿ x if we know how to integrate sinⁿ⁻² x."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28c67a4d-88cb-342a-aa23-2054a2425b48",
                                        "entry_id": "ac9e6198-cbd6-3c3a-ab50-33afa19c4277",
                                        "glosses": [
                                            "To desegregate, as a school or neighborhood."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16ea86db-20e2-4174-a8cd-0b622ba6505e",
                                                "sense_id": "28c67a4d-88cb-342a-aa23-2054a2425b48",
                                                "text": "President Eisenhower had to call out the National Guard to integrate Little Rock Central High School."
                                            },
                                            {
                                                "example_id": "038cb046-2c96-4eab-8410-ceb97e66d4b4",
                                                "sense_id": "28c67a4d-88cb-342a-aa23-2054a2425b48",
                                                "text": "That's because this place is racist, but also because most black filmmakers don't have an interest in integrating. They've accepted the premise that they must stay in their lane […]"
                                            },
                                            {
                                                "example_id": "e0585c4c-cc29-415f-a2e8-7e451abd4411",
                                                "sense_id": "28c67a4d-88cb-342a-aa23-2054a2425b48",
                                                "text": "I continued on the bus without him. It worked out fine. I went on to Tampa, Fla. That was the first time we integrated the buses. All the way down, sitting in the front row."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f470fdd6-a2e5-3085-8641-7866aca69cf3",
                                        "entry_id": "ac9e6198-cbd6-3c3a-ab50-33afa19c4277",
                                        "glosses": [
                                            "To combine compatible elements in order to incorporate them."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
