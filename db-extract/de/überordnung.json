                "senses": [
                    {
                        "sense_id": "47eee44d-f8df-373a-be8b-b842b749db64",
                        "entry_id": "7a4b8d3e-6a54-37f0-89a7-35f4b1b0950b",
                        "glosses": [
                            "Einnehmen eines höheren oder wichtigeren Ranges oder Stellung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36b77beb-a28c-4acb-bad1-c004cc246860",
                                "sense_id": "47eee44d-f8df-373a-be8b-b842b749db64",
                                "text": "„Sie hat nämlich verhindert, daß sich eine klare Überordnung der politischen über die administrative Ebene entwickeln konnte.“"
                            },
                            {
                                "example_id": "a7bc7795-2023-4057-8037-998a3aea109d",
                                "sense_id": "47eee44d-f8df-373a-be8b-b842b749db64",
                                "text": "„Darin spiegelt sich die von Thomas vollzogene Überordnung der Kirche der Ethik über den Staat.“"
                            },
                            {
                                "example_id": "e2d4063d-84bf-4905-add6-71eaa07fd291",
                                "sense_id": "47eee44d-f8df-373a-be8b-b842b749db64",
                                "text": "„Zugleich kritisiert er die Unterscheidung von Priester- und Laienstand mit der Überordnung des Priestertums unter einem eigenen geistlichen Recht.“"
                            },
                            {
                                "example_id": "e655e746-39f1-472b-994d-6ea75b0074f4",
                                "sense_id": "47eee44d-f8df-373a-be8b-b842b749db64",
                                "text": "„Aristoteles hat gezeigt, daß die Überordnung der Ziele nicht ins Endlose fortgehen kann.“"
                            },
                            {
                                "example_id": "4825ec79-67d2-4ac6-9943-5ec6203ef36e",
                                "sense_id": "47eee44d-f8df-373a-be8b-b842b749db64",
                                "text": "„Sie erweckt den Anschein, die Überordnung der Spezies ‚Mensch‘ gegenüber (anderen) Tierarten sei Speziesismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "17e96eff-2970-3c01-b51c-cac8d049afc1",
                        "entry_id": "7a4b8d3e-6a54-37f0-89a7-35f4b1b0950b",
                        "glosses": [
                            "Taxon zwischen Klasse und Ordnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a51b0c0-3778-409f-9947-0f580b87d261",
                                "sense_id": "17e96eff-2970-3c01-b51c-cac8d049afc1",
                                "text": "„Die Dictyoptera sind eine Überordnung der Insekten, in der die Schaben, mit etwa 4600 Arten, die Termiten, mit etwa 3000 Arten, und die Fangschrecken, mit etwa 2300 Arten, zusammengefasst werden.“"
                            },
                            {
                                "example_id": "96f3c019-2450-414e-bf23-32f03a304a40",
                                "sense_id": "17e96eff-2970-3c01-b51c-cac8d049afc1",
                                "text": "„Zu dieser Überordnung, die sich nach dem Zerbrechen des Urkontinents Gondwana vor hundert Millionen Jahren in Afrika entwickelte, zählen Elefanten und Erdferkel.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
