                        "source_entry_id": "c41c43ab-672a-3895-86f7-76a88ebb007f",
                        "source_sense_id": "6dc6ba4d-35ad-3b40-8391-02440e606cec",
                        "source_sense_description": "a historical region in Asia",
                        "target_lang_word": "Turkestan",
