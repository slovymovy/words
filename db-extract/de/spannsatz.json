                "senses": [
                    {
                        "sense_id": "0bfce696-4a49-399e-88c4-a7f697f48e18",
                        "entry_id": "406fc1b4-51f6-3142-bb70-e5c1daa86a26",
                        "glosses": [
                            "(Teil-)Satz, bei dem das finite Verb die letzte Satzgliedposition einnimmt"
                        ],
                        "tags": [
                            "Syntax",
                            "Deutsch"
                        ],
                        "examples": [
                            {
                                "example_id": "abddbe65-d341-4bc3-b92e-d496d4cda53c",
                                "sense_id": "0bfce696-4a49-399e-88c4-a7f697f48e18",
                                "text": "In dem Gliedsatz von \"Es ist gut, dass der Junge gerne Fußball spielt\" steht das finite Verb \"spielt\" an letzter Satzgliedposition; dieser Gliedsatz ist deshalb ein Spannsatz."
                            },
                            {
                                "example_id": "1f513ad0-a022-4867-844e-83457899aefb",
                                "sense_id": "0bfce696-4a49-399e-88c4-a7f697f48e18",
                                "text": "„Beim Stirnsatz steht das Finitum am Anfang des Satzes, beim Kernsatz nach dem ersten Satzglied und beim Spannsatz am Ende des Satzes.“"
                            },
                            {
                                "example_id": "ff93f593-9575-4200-b02d-542d56931b36",
                                "sense_id": "0bfce696-4a49-399e-88c4-a7f697f48e18",
                                "text": "„Wie steht es nun mit der Feldeinteilung bei den beiden anderen Satztypen, dem Stirnsatz und dem Spannsatz?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "23eb653a-770c-3dee-8525-2e1a9252ca17",
                        "entry_id": "406fc1b4-51f6-3142-bb70-e5c1daa86a26",
                        "glosses": [
                            "Element, das eine Nabe mit einer Welle (Maschinenteil) verbindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3029e89-0f2a-4269-a6e2-877ceda904b6",
                                "sense_id": "23eb653a-770c-3dee-8525-2e1a9252ca17",
                                "text": "„Ein Spannsatz ist eine kraftschlüssige Welle-Nabe-Verbindung im Maschinenbau.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
