{
    "word_family": [
        "cafeteria",
        "cybercafe",
        "caffeine"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "823b5068-3bda-3d5c-8133-6763b427ebf3",
                    "sense_definition": "A small restaurant selling light meals and drinks, especially coffee.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "coffee_shop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to meet at the <w>cafe</w> for breakfast.",
                            "target_lang_translations": {
                                "ru": "Мы решили встретиться в <w>кафе</w> за завтраком.",
                                "zh": "我们决定在<w>咖啡馆</w>见面吃早餐。"
                            }
                        },
                        {
                            "text": "She ordered a latte and a croissant at the local <w>cafe</w>.",
                            "target_lang_translations": {
                                "ru": "Она заказала латте и круассан в местной <w>кофейне</w>.",
                                "zh": "她在当地的<w>咖啡厅</w>点了一杯拿铁和一个牛角面包。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coffee shop",
                        "coffeehouse",
                        "bistro"
                    ],
                    "common_phrases": [
                        "internet cafe",
                        "sidewalk cafe",
                        "outdoor cafe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой ресторан, где подают легкие закуски и напитки, особенно кофе.",
                        "zh": "一种供应轻食和饮料，特别是咖啡的小型餐馆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кафе",
                                "target_lang_sense_clarification": "общее название заведения общественного питания"
                            },
                            {
                                "target_lang_word": "кофейня",
                                "target_lang_sense_clarification": "заведение, специализирующееся на кофе и десертах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "咖啡馆",
                                "target_lang_sense_clarification": "提供咖啡和简餐的休闲场所"
                            },
                            {
                                "target_lang_word": "咖啡厅",
                                "target_lang_sense_clarification": "通常指环境较舒适的咖啡店"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02861269-0aec-38bb-9c5b-4a122fa92faa",
                    "sense_definition": "A convenience store, originally one that sold coffee and similar basic items.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ran down to the corner <w>cafe</w> to buy some milk and a newspaper.",
                            "target_lang_translations": {
                                "ru": "Он сбегал в угловой <w>магазинчик</w>, чтобы купить молока и газету.",
                                "zh": "他跑去街角的<w>便利店</w>买了些牛奶和报纸。"
                            }
                        },
                        {
                            "text": "The neighborhood <w>cafe</w> stays open late for basic groceries.",
                            "target_lang_translations": {
                                "ru": "Соседняя <w>лавка</w> открыта допоздна для продажи основных продуктов.",
                                "zh": "这家社区<w>小卖部</w>营业到很晚，方便购买基本生活用品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "convenience store",
                        "corner shop"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in South Africa and some dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой магазин товаров первой необходимости (региональное значение, ЮАР).",
                        "zh": "一种小型便利店，最初销售咖啡及基本生活用品（主要见于南非等地区）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "магазинчик",
                                "target_lang_sense_clarification": "небольшой магазин у дома"
                            },
                            {
                                "target_lang_word": "лавка",
                                "target_lang_sense_clarification": "торговая точка с продуктами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "便利店",
                                "target_lang_sense_clarification": "销售日常必需品的小型零售店"
                            },
                            {
                                "target_lang_word": "小卖部",
                                "target_lang_sense_clarification": "社区内的小型杂货店"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "191544e5-657a-35e1-9c56-41f10ea7b6d0",
                    "sense_definition": "Acronym of Corporate Average Fuel Economy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new <w>CAFE</w> standards require cars to be more fuel-efficient.",
                            "target_lang_translations": {
                                "ru": "Новые стандарты <w>CAFE</w> требуют, чтобы автомобили были более экономичными.",
                                "zh": "新的<w>CAFE</w>标准要求汽车必须更加节能。"
                            }
                        },
                        {
                            "text": "Automakers are working hard to meet the latest <w>CAFE</w> targets.",
                            "target_lang_translations": {
                                "ru": "Автопроизводители усердно работают над достижением последних целевых показателей <w>CAFE</w>.",
                                "zh": "汽车制造商正在努力达到最新的<w>CAFE</w>指标。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "CAFE standards"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "acronym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура стандартов средней экономии топлива (Corporate Average Fuel Economy).",
                        "zh": "企业平均燃油经济性（Corporate Average Fuel Economy）标准的缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "CAFE",
                                "target_lang_sense_clarification": "аббревиатура названия стандартов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "CAFE",
                                "target_lang_sense_clarification": "汽车燃油经济性标准缩写"
                            }
                        ]
                    }
                }
            ]
        }
    ]
