                        "examples": [
                            {
                                "example_id": "037ea1a3-e507-446d-a9fd-93fae37c146f",
                                "sense_id": "6d4ac915-ad0a-3e85-b11b-15d41c63fad3",
                                "text": "De reconstructie van Tonio's laatste dagen en uren verliest dan haar vooropgezette vergeefsheid, en verandert in een zoektocht naar de verdwenen en opgegeven jongen zelf."
                            },
                            {
                                "example_id": "210cd991-d8cd-430b-8ab3-4ab536826d38",
                                "sense_id": "6d4ac915-ad0a-3e85-b11b-15d41c63fad3",
                                "text": "Het is een indrukwekkend beeld van vergeefsheid. Net als die andere twee JSF’s, bij Fort Nieuwersluis en Fort Asperen. Stuk voor stuk kunstwerken die samen met de oude Hollandse Waterlinievestingen symbool staan voor 'nutteloze oorlogsinvesteringen'."
                            }
                        ]
                    }
