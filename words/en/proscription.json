    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "65c0e1f6-8d19-3ea0-af53-68d2de019620",
                    "sense_definition": "An official prohibition, ban, or restriction on something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "prohibition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strict <w>proscription</w> against using mobile phones during exams was strictly enforced."
                        },
                        {
                            "text": "Religious leaders issued a <w>proscription</w> against certain types of secular entertainment."
                        }
                    ],
                    "synonyms": [
                        "ban",
                        "prohibition",
                        "interdict",
                        "embargo"
                    ],
                    "antonyms": [
                        "permission",
                        "authorization",
                        "allowance"
                    ]
                },
                {
                    "sense_id": "fdaadb30-a15f-3d5c-9ad6-d07dedd423d0",
                    "sense_definition": "The act of condemning, denouncing, or outlawing someone or something, or the state of being so condemned.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "proscription_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The authoritarian regime maintained control through the constant <w>proscription</w> of opposing political parties."
                        },
                        {
                            "text": "Her outspoken criticism led to her formal <w>proscription</w> by the academic board."
                        }
                    ],
                    "synonyms": [
                        "outlawry",
                        "denunciation",
                        "banishment"
                    ]
                },
                {
                    "sense_id": "1e76561f-2032-3018-bdf6-acd59d5de2cc",
                    "sense_definition": "A formal decree, statute, or legal order that prohibits or restricts an action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "prohibition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new legal <w>proscription</w> prevented foreign entities from purchasing domestic farmland."
                        },
                        {
                            "text": "Several businesses challenged the municipal <w>proscription</w> in court as unconstitutional."
                        }
                    ],
                    "synonyms": [
                        "edict",
                        "injunction",
                        "decree"
                    ]
                },
                {
                    "sense_id": "3568559d-b746-390a-9f59-7dded9e86c88",
                    "sense_definition": "A decree of condemnation or public identification of political enemies for banishment or execution, especially in ancient Rome.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "proscription_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was wholly unopposed, for the boldest spirits had fallen in battle, or in the <w>proscription</w>."
                        },
                        {
                            "text": "Many Roman citizens lost their lives and property during Sulla's brutal <w>proscription</w>."
                        }
                    ],
                    "synonyms": [
                        "condemnation",
                        "attainder"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical context referring to ancient Roman decrees"
                        }
                    ]
                }
