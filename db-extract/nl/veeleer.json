                        "sense_id": "c52f4511-c6cd-3282-8461-578a19544229",
                        "entry_id": "92f1f06f-39ee-3790-a5ed-c813f78079c1",
                        "glosses": [
                            "eerder, liever"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "5cea34c6-6520-4fe1-9b8b-69a5e9dbf710",
                                "sense_id": "c52f4511-c6cd-3282-8461-578a19544229",
                                "text": "Heb elkander lief, maar maak van de liefde geen band: laat zij veeleer zijn een golvende zee tussen de kusten van je zielen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fd9de76-0437-4051-afc4-b5f6827cdf8e",
                        "source_entry_id": "92f1f06f-39ee-3790-a5ed-c813f78079c1",
                        "source_sense_id": "c52f4511-c6cd-3282-8461-578a19544229",
                        "target_lang_word": "preferably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preferably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0e3cb30-efb9-3cec-b9c4-baf1e5de5b7f",
                                        "entry_id": "8bd55a67-bbbc-39fd-9524-d6bdd8a4f25e",
                                        "glosses": [
                                            "In preference; by choice; in a preferable manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0be4a668-29df-47bc-a98d-28c04ac6317f",
                                                "sense_id": "b0e3cb30-efb9-3cec-b9c4-baf1e5de5b7f",
                                                "text": "The nondegerming system grinds corn, preferably white dent corn, into meal with little, if any, separation of germ."
                                            },
                                            {
                                                "example_id": "65e2f976-9730-4477-a761-b8bcc3dfa3a2",
                                                "sense_id": "b0e3cb30-efb9-3cec-b9c4-baf1e5de5b7f",
                                                "text": "He felt having a Micronesian navigator meant he needed a pureblooded Polynesian, preferably a Hawaiian, as captain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d6635aa-6244-42d3-bd71-8943b58c7c57",
                        "source_entry_id": "92f1f06f-39ee-3790-a5ed-c813f78079c1",
                        "source_sense_id": "c52f4511-c6cd-3282-8461-578a19544229",
                        "target_lang_word": "rather",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ceb6583-9c8f-3bd7-888f-d4fa7dfc54a4",
                                        "entry_id": "f330b719-879f-3ead-a584-a8ffcd80906d",
                                        "glosses": [
                                            "Used to specify a choice or preference; preferably, in preference to. (Now usually followed by than)"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6985433d-9eb4-46db-9da8-e00f54733bb0",
                                                "sense_id": "1ceb6583-9c8f-3bd7-888f-d4fa7dfc54a4",
                                                "text": "They'd rather've spent the money on a holiday."
                                            },
                                            {
                                                "example_id": "3f437654-38dc-4671-9ebc-24ef1cd492cb",
                                                "sense_id": "1ceb6583-9c8f-3bd7-888f-d4fa7dfc54a4",
                                                "text": "I s'pose we'd better clean the kitchen, but we had much rather not do anything right now."
                                            },
                                            {
                                                "example_id": "fef32885-b769-4b6a-8e8f-c4f65b5d4061",
                                                "sense_id": "1ceb6583-9c8f-3bd7-888f-d4fa7dfc54a4",
                                                "text": "Tomorrow's impossible. We'd rather you came next weekend."
                                            },
                                            {
                                                "example_id": "28297418-812d-4248-89ef-724c1091feb2",
                                                "sense_id": "1ceb6583-9c8f-3bd7-888f-d4fa7dfc54a4",
                                                "text": "I'd rather not have spent all the money, but it really was an emergency."
                                            },
                                            {
                                                "example_id": "8651f868-e047-4a08-93b4-404591b5be21",
                                                "sense_id": "1ceb6583-9c8f-3bd7-888f-d4fa7dfc54a4",
                                                "text": "I would like this one rather than the other one."
                                            },
                                            {
                                                "example_id": "25c1a0f3-2dce-44be-b6fc-186eb0d74c96",
                                                "sense_id": "1ceb6583-9c8f-3bd7-888f-d4fa7dfc54a4",
                                                "text": "Firstly, I continue to base most species treatments on personally collected material, rather than on herbarium plants."
                                            },
                                            {
                                                "example_id": "0c25c80d-c580-4282-a9d3-cb8031637e52",
                                                "sense_id": "1ceb6583-9c8f-3bd7-888f-d4fa7dfc54a4",
                                                "text": "I'd rather dance with you than talk with you / So why don't we just move into the other room"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6ad0e3f-4a8c-31b9-8a9e-def6efc738bd",
                                        "entry_id": "f330b719-879f-3ead-a584-a8ffcd80906d",
                                        "glosses": [
                                            "Used to introduce a contradiction; on the contrary."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b68130dc-b292-4c2f-a670-687ebc05286e",
                                                "sense_id": "a6ad0e3f-4a8c-31b9-8a9e-def6efc738bd",
                                                "text": "It wasn't supposed to be popular; rather, it was supposed to get the job done."
                                            },
                                            {
                                                "example_id": "8bfc92a5-70c1-4c93-a3c1-055934060d6e",
                                                "sense_id": "a6ad0e3f-4a8c-31b9-8a9e-def6efc738bd",
                                                "text": "She didn't go along, but rather went home instead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e49cd2b-90f8-3a63-89c2-589d5d3f5fdc",
                                        "entry_id": "f330b719-879f-3ead-a584-a8ffcd80906d",
                                        "glosses": [
                                            "Introducing a qualification or clarification; more precisely. (Now usually preceded by or.)"
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c292e80b-ea09-4d07-8388-39aeb83b0332",
                                                "sense_id": "9e49cd2b-90f8-3a63-89c2-589d5d3f5fdc",
                                                "text": "What the pupil already knew was indeed rather taken for granted than expressed, but it performed the useful function of transcending all textbooks, and supplanting all studies."
                                            },
                                            {
                                                "example_id": "8279c8eb-4516-48da-9e59-054180cf5cd1",
                                                "sense_id": "9e49cd2b-90f8-3a63-89c2-589d5d3f5fdc",
                                                "text": "1898, J. A. Hamilton, \"Stanley, Edward George Geoffrey Smith\", in Sidney Lee (Ed.), Dictionary of National Biography, Volume LIV: Stanhope–Stovin, The MacMillan Company, page 60,\nHis ‘Iliad’ is spirited and polished, and, though often rather a paraphrase than a translation, is always more truly poetic than most of the best translations."
                                            },
                                            {
                                                "example_id": "35fffaf1-35d2-4c2c-8218-9b8e7501acc2",
                                                "sense_id": "9e49cd2b-90f8-3a63-89c2-589d5d3f5fdc",
                                                "text": "All this was extraordinarily distasteful to Churchill.[…]Never before had he felt such repulsion when the vicar displayed his characteristic bluntness or coarseness of speech. In the present connection—or rather as a transition from the subject that had started their conversation—such talk had been distressingly out of place."
                                            },
                                            {
                                                "example_id": "a0a5e332-7e2e-4275-948b-5cfe9b7a97e8",
                                                "sense_id": "9e49cd2b-90f8-3a63-89c2-589d5d3f5fdc",
                                                "text": "I didn't want to leave. Or rather I did, just not alone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d203acef-531f-30d8-b0d5-a44aebb25c36",
                                        "entry_id": "f330b719-879f-3ead-a584-a8ffcd80906d",
                                        "glosses": [
                                            "Somewhat, quite; to an unexpected degree."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac05a5f9-8ad8-40e0-8485-d1a3dd59f5c7",
                                                "sense_id": "d203acef-531f-30d8-b0d5-a44aebb25c36",
                                                "text": "It's been rather/quite a good meal overall, but this melon is rather too tasteless."
                                            },
                                            {
                                                "example_id": "761e0f4c-81ae-4100-bb7a-2f3f3e8c8dd3",
                                                "sense_id": "d203acef-531f-30d8-b0d5-a44aebb25c36",
                                                "text": "We had some rather worse news today."
                                            },
                                            {
                                                "example_id": "50b8286a-129e-4b14-a946-0f408f3774fe",
                                                "sense_id": "d203acef-531f-30d8-b0d5-a44aebb25c36",
                                                "text": "We’ll be seeing rather a lot of you over the next few days."
                                            },
                                            {
                                                "example_id": "e354a8d8-964a-4794-8583-14b0075beead",
                                                "sense_id": "d203acef-531f-30d8-b0d5-a44aebb25c36",
                                                "text": "I'd rather like a cup of tea. - Oh, would you? I'd rather have a mug of beer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ebde4dd-d742-350c-bb6d-c6c9c93bd3a6",
                                        "entry_id": "f330b719-879f-3ead-a584-a8ffcd80906d",
                                        "glosses": [
                                            "More quickly."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d53d710-1d9e-4e42-a891-14768be490d4",
                                                "sense_id": "4ebde4dd-d742-350c-bb6d-c6c9c93bd3a6",
                                                "text": "Pompey, being elated and filled with confidence by this victory, made all haste to engage Sertorius himself, and the rather lest Metellus should come in for a share in the honour of the victory."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38a6c378-f6cb-3dc0-8a6f-7883a5ed1eba",
                                        "entry_id": "72ebcd8d-043c-3046-bb47-10e251334349",
                                        "glosses": [
                                            "Prior; earlier; former."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bb472fb-1154-486a-a1ab-4f504ad8a689",
                                                "sense_id": "38a6c378-f6cb-3dc0-8a6f-7883a5ed1eba",
                                                "text": "Now no man dwelleth at the rather town of Damietta."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21b89ebe-2ce9-304d-9c9e-915f86f79a1c",
                                        "entry_id": "b481f76b-b907-3061-ac79-b235ede597bd",
                                        "glosses": [
                                            "An enthusiastic affirmation."
                                        ],
                                        "tags": [
                                            "England",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f79ba04-9cb2-40a5-a253-f443764efa5e",
                                                "sense_id": "21b89ebe-2ce9-304d-9c9e-915f86f79a1c",
                                                "text": "Would you like some? –Rather!"
                                            },
                                            {
                                                "example_id": "d70ae8c1-4fac-41a8-9fc6-0066f8d94aa9",
                                                "sense_id": "21b89ebe-2ce9-304d-9c9e-915f86f79a1c",
                                                "text": "\"Do you mean to say, young man,\" she said frostily, \"that you expect me to drink this stuff?\" ¶ \"Rather! Bucks you up, you know.\""
                                            },
                                            {
                                                "example_id": "7c52c334-ae50-4874-8db0-f675b838de86",
                                                "sense_id": "21b89ebe-2ce9-304d-9c9e-915f86f79a1c",
                                                "text": "\"Farewell, Daughter of Eve,\" said he. \"Perhaps I may keep the handkerchief?\"\n\"Rather!\" said Lucy, and then ran towards the far-off patch of daylight as quickly as her legs would carry her."
                                            },
                                            {
                                                "example_id": "9dab59a1-fc6a-4bdd-ae42-a73109f1fa53",
                                                "sense_id": "21b89ebe-2ce9-304d-9c9e-915f86f79a1c",
                                                "text": "\"Some of us stupid old die-hards believe that there is yet room for pride in one's work, Pook,\" Mr Pants said with dangerous emphasis. \"Oh, rather, sir. I'd much sooner walk to London Town than ride in one of those motorcars we've heard tell of, sir.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7965a997-2ad9-3f9e-835f-52a0c3667608",
                                        "entry_id": "73fef44a-32a0-31da-b6dd-542160463260",
                                        "glosses": [
                                            "A choice or a preference."
                                        ],
                                        "tags": [
                                            "dated",
                                            "informal",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ec11a93-e641-46bd-a5fe-0a46e4e5ee84",
                                                "sense_id": "7965a997-2ad9-3f9e-835f-52a0c3667608",
                                                "text": "If I had my rathers I'd make up my own band. Art Blakey on the skins, Charlie Mingus on the bass, John Coltrane on the sax, Harry Edison on the horn-"
                                            },
                                            {
                                                "example_id": "7d3e7cf1-a606-4e19-a2a8-2dae41b3a257",
                                                "sense_id": "7965a997-2ad9-3f9e-835f-52a0c3667608",
                                                "text": "I would rather do it by myself. I would rather, if I had my rathers, not be seen doing it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bff9390-9756-3449-866c-c30f94db5483",
                                        "entry_id": "c364ad14-db50-3b53-9372-21672ed0ff3d",
                                        "glosses": [
                                            "To prefer; to prefer to."
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c96b60d9-bb01-4863-94e8-82ff23938e02",
                                                "sense_id": "6bff9390-9756-3449-866c-c30f94db5483",
                                                "text": "Until just before the pie was popped into the heat. A few of them suddenly realized who put that gorgeous hunk of crackers together, and gaped. We grinned back, but very cool. The ones who knew said nothing, rathering to die than let on they had been hustled by two negative dudes."
                                            },
                                            {
                                                "example_id": "c001f78b-494c-4c04-b8ce-c545cc3fa148",
                                                "sense_id": "6bff9390-9756-3449-866c-c30f94db5483",
                                                "text": "It was a plain brown dress, more or less the colour of my hair; and the walls of our kitchen being also brown, when I came downstairs again I could hardly be seen. I should have rathered a blue gown, or a violet one; […]"
                                            },
                                            {
                                                "example_id": "2cfa4f28-aa43-433f-af5c-00f7992a7734",
                                                "sense_id": "6bff9390-9756-3449-866c-c30f94db5483",
                                                "text": "So you must excuse my saying anything I did: all it was, that up to the very last I had understood us all to be friendly — apart, that is, from his rathering me not there. How was I to know he would flash out so wicked?"
                                            },
                                            {
                                                "example_id": "745c3584-2357-4e31-83db-810506e24f45",
                                                "sense_id": "6bff9390-9756-3449-866c-c30f94db5483",
                                                "text": "\"That was a killer,\" said Chris. \"I'd rathered die in St. Bernard than spent one minute over there. I would have rathered the storm, shaking with the wind and rain hitting in the boat for an eternity than spending any time there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2502f79f-cbde-474a-b9b5-8df11aee0d9c",
                        "source_entry_id": "92f1f06f-39ee-3790-a5ed-c813f78079c1",
                        "source_sense_id": "c52f4511-c6cd-3282-8461-578a19544229",
                        "target_lang_word": "antes",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antes",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "37bf3342-9d4e-355f-83eb-40adc82a9912",
                                        "entry_id": "cfaf78e1-2a45-3cb8-bae3-6b2d2d7e45b3",
                                        "glosses": [
                                            "Indica que algo tiene lugar primero o previo en un orden de sucesión en el espacio."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e81788e-de11-4c29-9a7e-20e16f65a477",
                                                "sense_id": "37bf3342-9d4e-355f-83eb-40adc82a9912",
                                                "text": "En Europa, de sur a norte, España está antes que Francia."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "antes",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "2f3d3944-274e-32e3-bd1e-559ebff22756",
                                        "entry_id": "9bf01aa2-b95c-30a0-9acf-149e37bd2f25",
                                        "glosses": [
                                            "Indica que algo ocurre primero en el tiempo, que precede o es previo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "068ddbe8-9700-48e0-8629-48b9e2585dde",
                                                "sense_id": "2f3d3944-274e-32e3-bd1e-559ebff22756",
                                                "text": "Lávate las manos antes de comer.\nEn resumen, habría acabado antes con \"un grupo de científicos catalanes mentirosos, en medio de una crisis sanitaria global, promueven la administración de un veneno\"."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "antes",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "9bc7b7de-9770-3165-b456-815e7b26fdda",
                                        "entry_id": "cd18ee8d-82fd-3f28-b174-00788ba50175",
                                        "glosses": [
                                            "Indica precedencia, primacía, prioridad o preferencia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5394c201-3130-4882-b5df-0364e2848a4e",
                                                "sense_id": "9bc7b7de-9770-3165-b456-815e7b26fdda",
                                                "text": "Satisfacer las necesidades básicas está antes que el lujo."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "antes",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "1b340105-001f-3409-acb3-f4a8882101e0",
                                        "entry_id": "eee38a1d-1653-3f08-97ea-e962647afa83",
                                        "glosses": [
                                            "Introduce una idea o frase que contradice y se prefiere a otra previa: por el contrario."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61642749-68f3-47ef-bc48-d64c0956ac79",
                                                "sense_id": "1b340105-001f-3409-acb3-f4a8882101e0",
                                                "text": "No temo los peligros, antes los busco."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "antes",
                                "target_lang_code": "es",
                                "target_senses": [
