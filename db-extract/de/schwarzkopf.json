                ],
                "senses": [
                    {
                        "sense_id": "8e702f72-af2d-31fd-ac0c-6e4111c8438e",
                        "entry_id": "c9564c62-bde7-34d9-abe9-76077152d4e4",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c805c3f9-c8de-40a2-bc76-7acb31858761",
                                "sense_id": "8e702f72-af2d-31fd-ac0c-6e4111c8438e",
                                "text": "Frau Schwarzkopf ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "787548b7-27b3-4de5-b8ea-0d44e7be04c2",
                                "sense_id": "8e702f72-af2d-31fd-ac0c-6e4111c8438e",
                                "text": "Herr Schwarzkopf wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "58121fa8-db02-433e-ac51-c1c6e744225d",
                                "sense_id": "8e702f72-af2d-31fd-ac0c-6e4111c8438e",
                                "text": "Die Schwarzkopfs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "fc1cb9a9-c024-486f-ae51-624b0f58e10f",
                                "sense_id": "8e702f72-af2d-31fd-ac0c-6e4111c8438e",
                                "text": "Der Schwarzkopf trägt nie die Schals, die die Schwarzkopf ihm strickt."
                            },
                            {
                                "example_id": "c8e7db94-f9ad-4399-b663-375f6b593e7f",
                                "sense_id": "8e702f72-af2d-31fd-ac0c-6e4111c8438e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schwarzkopf kommt, geht der Herr Schwarzkopf.“"
                            },
                            {
                                "example_id": "521ee63d-d0ac-4bc1-8aa2-4c76c3afa2bf",
                                "sense_id": "8e702f72-af2d-31fd-ac0c-6e4111c8438e",
                                "text": "Schwarzkopf kommt und geht."
                            },
                            {
                                "example_id": "6f99e8a1-1e17-46f3-b6f0-479a3c948d27",
                                "sense_id": "8e702f72-af2d-31fd-ac0c-6e4111c8438e",
                                "text": "Schwarzkopfs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
