                                "target_senses": [
                                    {
                                        "sense_id": "545f8a12-7197-3bc8-9850-f31027d7d241",
                                        "entry_id": "9dbff8ae-f262-37a6-8710-92910462cabf",
                                        "glosses": [
                                            "To act in response."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "026f51f7-8c92-4ade-bec3-c932a20bbd68",
                                                "sense_id": "545f8a12-7197-3bc8-9850-f31027d7d241",
                                                "text": "How did she react to the news?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3de5c13d-b017-3b10-8690-fcdf352139b1",
                                        "entry_id": "9dbff8ae-f262-37a6-8710-92910462cabf",
                                        "glosses": [
                                            "To act or perform a second time; to do over again; to reenact."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65d7a87a-4ac5-4245-be86-4654c12effee",
                                                "sense_id": "3de5c13d-b017-3b10-8690-fcdf352139b1",
                                                "text": "It is somewhat extraordinary, that the offence for which James II, was expelled, that of setting up power by assumption, should be re-acted, under another shape and form, by the parliament that expelled him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b508bcb8-32e4-3175-904f-691b4676ab9c",
                                        "entry_id": "9dbff8ae-f262-37a6-8710-92910462cabf",
                                        "glosses": [
                                            "To return an impulse or impression; to resist the action of another body by an opposite force"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b777164-6c98-44fc-91ef-35db9463d46f",
                                                "sense_id": "b508bcb8-32e4-3175-904f-691b4676ab9c",
                                                "text": "Every body reacts on the body that impels it from its natural state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0661881-8bd7-3292-9de2-6cabfb065b2a",
                                        "entry_id": "9dbff8ae-f262-37a6-8710-92910462cabf",
                                        "glosses": [
                                            "To act upon each other; to exercise a reciprocal or a reverse effect, as two or more chemical agents; to act in opposition."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5229f3ff-3298-300c-8194-7bdfb6a4f144",
                                        "entry_id": "9dbff8ae-f262-37a6-8710-92910462cabf",
                                        "glosses": [
                                            "To cause chemical agents to react; to cause one chemical agent to react with another."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd851ae5-8f29-3ef7-9083-24f4191c017d",
                                        "entry_id": "9dbff8ae-f262-37a6-8710-92910462cabf",
                                        "glosses": [
                                            "To post a reaction (icon or emoji indicating how one feels about a posted message)."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "react",
