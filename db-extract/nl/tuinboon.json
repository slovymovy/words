                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddeb4010-7ffb-46cd-89e8-7bd1e54b7ac9",
                                                "sense_id": "471b4935-65c4-3d93-adb4-3fa06dd4bff3",
                                                "text": "Sparky is a good bean, even if he is a carpet-bagging bean at that."
                                            },
                                            {
                                                "example_id": "2529a50f-835d-4516-8c13-d92ba542a5b1",
                                                "sense_id": "471b4935-65c4-3d93-adb4-3fa06dd4bff3",
                                                "text": "i dont want boid (whoever said that) he is mean. boid is a mean bean."
                                            },
                                            {
                                                "example_id": "74845793-6850-4dcf-b2de-d9b964033161",
                                                "sense_id": "471b4935-65c4-3d93-adb4-3fa06dd4bff3",
                                                "text": "\"Good, because we like you. You're okay. You're a good bean.\" \"I never thought I'd be friends with a cheerleader,\" I said."
