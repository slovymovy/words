                                    {
                                        "sense_id": "77933f3e-f8ba-3522-939a-4ba9c5ab2725",
                                        "entry_id": "ca4b62b6-85c9-3336-b8b7-ad48ac558db7",
                                        "glosses": [
                                            "Personne se tenant sur le dos en position couchée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a40407-bdac-4424-847b-4e667cf83e42",
                                                "sense_id": "77933f3e-f8ba-3522-939a-4ba9c5ab2725",
                                                "text": "Elle alla à Berck pour y rencontrer une espèce de sainte qui avait consacré sa vie aux « allongés »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "229ccf79-6cdb-390a-8e39-0046c1fd934a",
                                        "entry_id": "ca4b62b6-85c9-3336-b8b7-ad48ac558db7",
                                        "glosses": [
                                            "Personne atteinte de la tuberculose."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "698b706c-1dfd-4819-b067-795d73b6165c",
                                                "sense_id": "229ccf79-6cdb-390a-8e39-0046c1fd934a",
                                                "text": "On trouvera ainsi dans le courrier : les dactylos, les coloniaux, les exilés, les cols bleus, les aviateurs…. La majorité de ces groupes sont très genrés, à l’exception notable des “allongés”, ceux qui, en traitement pour la tuberculose sont allongés en sanatorium."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "allongé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d2ea432-e161-33e7-8284-61085b236761",
                                        "entry_id": "c604fa98-db35-39b6-a9f7-80fc5d17dfee",
                                        "glosses": [
                                            "Café allongé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "400a7172-b3cf-4f6d-a3fc-146561a88751",
                                                "sense_id": "4d2ea432-e161-33e7-8284-61085b236761",
                                                "text": "Elle réapparaît au bout de deux minutes, pend son manteau à une patère, commande un allongé au serveur et vient s’asseoir devant Simon qui la dévisage en silence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "allongé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b70a54d-73f3-333a-96db-d62d95119a5e",
                                        "entry_id": "a4868f2d-2d02-3b3f-9d5d-dd942cdde4bc",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe allonger."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c3030a0-ccd5-451a-9e55-ee06ad3227ed",
                                                "sense_id": "5b70a54d-73f3-333a-96db-d62d95119a5e",
                                                "text": "On l’avait allongé sur une petite échelle utilisée comme civière, et il avait fallu que ses collègues restés dehors le protégeassent par un tir de rafale pour empêcher Bobby de l’atteindre à nouveau alors qu’on le sortait."
                                            }
                                        ]
                                    }
