                                "sense_id": "bec0d2ec-1228-375b-b1d7-2ddc67e560f9",
                                "text": "L'Ibérie comprend l'Espagne et le Portugal.",
                                "translation": "Iberia includes Spain and Portugal.",
                                "english": "Iberia includes Spain and Portugal."
                            }
                        ]
                    }
