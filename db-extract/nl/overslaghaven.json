                        "entry_id": "6233b562-cfa3-381d-9947-7bfb85f753e6",
                        "glosses": [
                            "haven waar goederen van het ene naar het andere schip worden overgeheveld (met name van zeeschepen naar binnenvaartschepen en andersom)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eb7d8a2-bace-4165-9511-d09b4d68741a",
                                "sense_id": "be80ff7b-cc02-3b73-9645-94f14e7bb24c",
                                "text": "En vergeet niet dat we nog altijd een belangrijke overslaghaven voor olie, graan en kolen zijn."
                            },
                            {
                                "example_id": "680780a6-1296-4ade-9eb4-a2cd22cc440f",
                                "sense_id": "be80ff7b-cc02-3b73-9645-94f14e7bb24c",
                                "text": "De economie werd in hoog tempo omgevormd. Daarbij werd goed gekeken naar het buitenland. Zo werd Singapore's enorme overslaghaven geënt op de Rotterdamse haven. In 1965 was het bruto product per hoofd van de bevolking 500 euro. Nu is dat 55.000 euro: meer dan 100 keer zo veel."
                            }
                        ]
                    }
