                    },
                    {
                        "translation_id": "ccfd70e7-190a-4720-b858-fc7f827423b3",
                        "source_entry_id": "39359185-ef63-3a84-aafc-d1f5216dea39",
                        "source_sense_description": "несомненно, наверняка",
                        "target_lang_word": "certes",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "certes",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81bc2c8d-ba8d-3fd4-80a0-b045dc6e6439",
                                        "entry_id": "42e2b354-750d-3bf4-b10a-a7139a389f75",
                                        "glosses": [
                                            "Certainly, indeed."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0f586bf-7e0f-4653-8b87-76715e732c80",
                                                "sense_id": "81bc2c8d-ba8d-3fd4-80a0-b045dc6e6439",
                                                "text": "[F]or certes, ſayes he, / I haue already choſen my officer, and what was he? / Forſooth, a great Arithmeticion, [...]"
                                            },
                                            {
                                                "example_id": "1e4b0f69-bd68-4e43-a798-4b6313fcfd1c",
                                                "sense_id": "81bc2c8d-ba8d-3fd4-80a0-b045dc6e6439",
                                                "text": "This was very unpleasant, at least to myself; though, certes, it did not prey upon the minds of the others."
                                            },
                                            {
                                                "example_id": "d4d56cd1-4010-4e9b-96b4-331394f8f895",
                                                "sense_id": "81bc2c8d-ba8d-3fd4-80a0-b045dc6e6439",
                                                "text": "Here, certes, was no lost soul, but one who had gone joyfully to meet her Lord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "6681c5e6-dae0-4d5c-8c39-c055cf03275f",
