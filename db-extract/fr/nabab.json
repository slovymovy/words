        "fr-extract.jsonl": [
            {
                "entry_id": "9ec632a7-f2db-3a7a-ae0c-c4a7a14079b3",
                "word": "nabab",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ed2037a4-4abb-4731-beaa-acfd094e7950",
                        "entry_id": "9ec632a7-f2db-3a7a-ae0c-c4a7a14079b3",
                        "tags": [
                            "plural"
                        ],
                        "form": "nababs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ffc3987e-9fb0-3140-a4e6-55d4ee7acba0",
                        "entry_id": "9ec632a7-f2db-3a7a-ae0c-c4a7a14079b3",
                        "glosses": [
                            "Prince dans l’Inde moghole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e82e18b-e04f-47ad-be31-75a9e1dcd888",
                                "sense_id": "ffc3987e-9fb0-3140-a4e6-55d4ee7acba0",
                                "text": "Le nabab de Visapour traitait alors avec le pescha, chef de la République maratte, de la levée de plusieurs escadrons qu'il voulait prendre à sa solde."
                            },
                            {
                                "example_id": "a9ffabaf-ec58-48a5-8f74-663c2dcfdf19",
                                "sense_id": "ffc3987e-9fb0-3140-a4e6-55d4ee7acba0",
                                "text": "C’est quelque nabab qui arrive de l’Inde."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb9078b9-effe-359e-989a-39843223aff3",
                        "entry_id": "9ec632a7-f2db-3a7a-ae0c-c4a7a14079b3",
                        "glosses": [
                            "Personne riche."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "33386ec8-75b7-445f-a98e-c040ef625d3d",
                                "sense_id": "eb9078b9-effe-359e-989a-39843223aff3",
                                "text": "On venait pour apprendre les dernières informations de l’Action parallèle, pour voir le dernier homme que Diotime, comme on disait, s’était fait venir, un nabab allemand, un riche Juif, un original qui écrivait des poèmes, dictait les cours du charbon et fraternisait avec l’empereur d’Allemagne."
                            },
                            {
                                "example_id": "2a858d22-7ec2-4b2e-847a-2ac0463f955a",
                                "sense_id": "eb9078b9-effe-359e-989a-39843223aff3",
                                "text": "Hydra, par les temps qui concourent, rappelle une cité interdite. Jamais barbe d’intégriste n’a effleuré ses mimosas, jamais odeur de poudre n’a faussé les senteurs de sa félicité. Les nababs du bled y vivent en rentiers, la panse bien garnie, l’œil rivé sur le trip des cupidités."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49932226-fd1c-4a8d-b0ba-37ff288195e7",
                        "source_entry_id": "9ec632a7-f2db-3a7a-ae0c-c4a7a14079b3",
                        "target_lang_word": "Nabob",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nabob",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f57a2e1c-93eb-32a6-956a-3922a3d713c4",
                                        "entry_id": "fdc4e5a2-1477-30ac-afbb-9fb83e936b9a",
                                        "glosses": [
                                            "Provinzgouverneur in den indischen islamischen Reichen (Ehrentitel)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "428701c2-61ee-3066-a493-c3df9aaee4df",
                                        "entry_id": "fdc4e5a2-1477-30ac-afbb-9fb83e936b9a",
                                        "glosses": [
                                            "ungeheuer reicher Mann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35f523d6-47f5-4623-979e-4dc3e5410ccc",
                                                "sense_id": "428701c2-61ee-3066-a493-c3df9aaee4df",
                                                "text": "„Es gab Nabobs in jenen Tagen - ich meine, in der Zeit der Konjunktur.“"
                                            },
                                            {
                                                "example_id": "b634950b-65dc-4ea3-9024-479174567056",
                                                "sense_id": "428701c2-61ee-3066-a493-c3df9aaee4df",
                                                "text": "„Von Kepis Standpunkt aus sind alle Nabobs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61eb7d25-bad2-41f8-b19e-9ccdb7c5efcf",
                        "source_entry_id": "9ec632a7-f2db-3a7a-ae0c-c4a7a14079b3",
                        "target_lang_word": "nabob",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nabob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f9b8324-3dc0-3fdf-b62b-0041511b1134",
                                        "entry_id": "98c5c1a5-6eb7-3707-a965-dfe646e04854",
                                        "glosses": [
                                            "An Indian ruler within the Mogul empire."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a640f388-6309-4def-b189-9dfa87d8bf1e",
                                                "sense_id": "7f9b8324-3dc0-3fdf-b62b-0041511b1134",
                                                "text": "They have drained the treasuries of Nabobs, who must fill them by oppressing the industry of their subjects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ee980c7-d95e-3678-9e1e-17d43f4e5631",
                                        "entry_id": "98c5c1a5-6eb7-3707-a965-dfe646e04854",
                                        "glosses": [
                                            "Someone of great wealth or importance."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "181676d6-fb39-467d-a09b-da56b18130cd",
                                                "sense_id": "4ee980c7-d95e-3678-9e1e-17d43f4e5631",
                                                "text": "Mr. Glentworth had never quitted Europe, and his wealth was either good English landed property, or equally undeniable English consols; still he was a stranger, very rich, and suddenly come from abroad. Such a man was necessarily a nabob in Mr. Palmer's eyes. India had been the place for making large fortunes in his young days."
                                            },
                                            {
                                                "example_id": "1a16be87-1b7a-4c49-ab7a-7cec103c822a",
                                                "sense_id": "4ee980c7-d95e-3678-9e1e-17d43f4e5631",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers. Piling debt onto companies’ balance-sheets is only a small part of what leveraged buy-outs are about, they insist. Improving the workings of the businesses they take over is just as core to their calling, if not more so. Much of their pleading is public-relations bluster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c8381d7-7899-3bae-b23a-f949a32c8abd",
                                        "entry_id": "98c5c1a5-6eb7-3707-a965-dfe646e04854",
                                        "glosses": [
                                            "A person with a grandiose style or manner."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a61ef76-9ec2-4434-95aa-36de9837c5aa",
                        "source_entry_id": "9ec632a7-f2db-3a7a-ae0c-c4a7a14079b3",
                        "target_lang_word": "nawab",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nawab",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38a7ce7a-7799-3037-b24c-f296ac9b4cc9",
                                        "entry_id": "9ac2f8ae-9e56-3067-b32b-128587e52cf7",
                                        "glosses": [
                                            "A Muslim official in South Asia acting as a provincial deputy ruler under the Mughal empire; a local governor."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98c11029-ead3-45fa-bb84-d9d0b062fce7",
                                                "sense_id": "38a7ce7a-7799-3037-b24c-f296ac9b4cc9",
                                                "text": "Colonel Altamont, the Nawaub of Lucknow’s prime favourite, an extraordinary man, who had, it was said, embraced Mahometanism, and undergone a thousand wild and perilous adventures was at present in this country, trying to negotiate with the Begum Clavering, the sale of the Nawaub’s celebrated nose-ring diamond, ‘the light of the Dewan.’"
                                            },
                                            {
                                                "example_id": "fc017a3f-8243-4b7a-806f-b4781eeb652f",
                                                "sense_id": "38a7ce7a-7799-3037-b24c-f296ac9b4cc9",
                                                "text": "The nawabs of Bhopal, Ranput, Murshidabad, and Dhaka, along with the nizam of Hyderabad, all affirmed that the sultan has misled Muslims with his “erroneous” call to jihad and insisted that Indian Muslims had a duty to support Great Britain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a23323e1-8fa5-36ce-9c71-61dad7ff6c01",
                                        "entry_id": "9ac2f8ae-9e56-3067-b32b-128587e52cf7",
                                        "glosses": [
                                            "Any of various nymphalid butterflies of the genus Polyura (possibly a subgenus of genus Charaxes)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
