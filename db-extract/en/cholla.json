                        "sense_id": "1efbc0ae-4731-3565-96ed-b4b9199dbdca",
                        "entry_id": "ed719793-b195-34ab-bd14-5ae756226da7",
                        "glosses": [
                            "Any of several species of cactus in the genus Cylindropuntia, having very spiny, cylindrical stem segments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eb0fccd-14ae-4a62-b965-fdd854982eab",
                                "sense_id": "1efbc0ae-4731-3565-96ed-b4b9199dbdca",
                                "text": "Throughout Arizona the floors of such caves are found covered with a deep bed of chollas."
                            },
                            {
                                "example_id": "c89a3bb6-bf7d-4fbe-ab35-3a5fe17ee90f",
                                "sense_id": "1efbc0ae-4731-3565-96ed-b4b9199dbdca",
                                "text": "The cholla was two feet high, and six feet in diameter."
                            },
                            {
                                "example_id": "9b35bbec-c7ab-4b91-a067-8eba9205ba99",
                                "sense_id": "1efbc0ae-4731-3565-96ed-b4b9199dbdca",
                                "text": "The terrain was thick with cholla and clumps of it clung to the horses with spikes that would drive through a bootsole to the bones within […]"
                            },
                            {
                                "example_id": "cabba304-f756-448c-a2d6-c17b9e73f512",
                                "sense_id": "1efbc0ae-4731-3565-96ed-b4b9199dbdca",
                                "text": "On the front nine, Jones stuck to Woods like a cholla cactus."
                            }
                        ]
                    }
                ],
