                                                "sense_id": "399c9850-0774-3479-9161-0c616e31463b",
                                                "text": "„so auf einmahl alles verlohren und noch obendrauf die prostitution“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
