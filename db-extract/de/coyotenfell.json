                "senses": [
                    {
                        "sense_id": "e92ffaeb-732d-3fa5-ae37-ffd5de30ea63",
                        "entry_id": "b646303c-eded-3d5a-9ed0-823a5af322a1",
                        "glosses": [
                            "(abgezogenes) Fell eines Coyoten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed68f454-f845-4194-96ca-d5d6cc90743a",
                                "sense_id": "e92ffaeb-732d-3fa5-ae37-ffd5de30ea63",
                                "text": "„Den breiten Rand, an dem viele ihren Tabak und sonstige Kleinigkeiten befestigten, hatten sie mit Coyotenfell oder Klapperschlangenhaut benäht.“"
                            },
                            {
                                "example_id": "ee7038f1-ac69-4065-bcd0-c97bc65a5516",
                                "sense_id": "e92ffaeb-732d-3fa5-ae37-ffd5de30ea63",
                                "text": "„Er spürte, wie seine Erregung unter dem Coyotenfell des Rocks anschwoll.“"
                            },
                            {
                                "example_id": "5ec1837d-90c1-4ec0-b9fc-4c6ee5287c4c",
                                "sense_id": "e92ffaeb-732d-3fa5-ae37-ffd5de30ea63",
                                "text": "„Das Coyotenfell über seinen Schultern galt als ein Zeichen seiner neuen Machtbefugnis, denn er war vor kurzem zu einem der sechs Ältesten des Dorfes ernannt worden.“"
                            },
                            {
                                "example_id": "ce503b68-d996-4e90-9636-22108ffd96ca",
                                "sense_id": "e92ffaeb-732d-3fa5-ae37-ffd5de30ea63",
                                "text": "„Coloa, auf einem Coyotenfell sitzend, verzehrte die wohlschmeckenden Früchte, die sie kaum dem Namen nach kannte, mit gutem Appetit.“"
                            },
                            {
                                "example_id": "38e469f5-bd49-41e2-8243-4c985f82c1ea",
                                "sense_id": "e92ffaeb-732d-3fa5-ae37-ffd5de30ea63",
                                "text": "„Für einen schönen Wolfspelz erhielten sie bis zu 3 $ und für ein Coyotenfell zwischen 1 und 2 $.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
