                "senses": [
                    {
                        "sense_id": "23833525-24cc-3ed3-aea9-007ac3b548d0",
                        "entry_id": "adb017eb-0a90-3ceb-bc16-20c7a603a368",
                        "glosses": [
                            "Qui appartient au clergé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42eff98c-496e-4b2d-9545-97aae332984d",
                                "sense_id": "23833525-24cc-3ed3-aea9-007ac3b548d0",
                                "text": "Les fonctions cléricales."
                            }
                        ]
                    },
                    {
                        "sense_id": "d39bc6d0-bfad-3467-a485-b4f327f88786",
                        "entry_id": "adb017eb-0a90-3ceb-bc16-20c7a603a368",
                        "glosses": [
                            "Qui professe le cléricalisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc91f3d6-90c1-40dd-b0c2-08805d6c36f4",
                                "sense_id": "d39bc6d0-bfad-3467-a485-b4f327f88786",
                                "text": "Au temps de la République cléricale, la Société de Saint-Vincent-de-Paul était une belle officine de surveillance sur les fonctionnaires de tout ordre et de tout grade."
                            },
                            {
                                "example_id": "8a1a4c54-8b54-4e73-b11b-4fbdd527f8ed",
                                "sense_id": "d39bc6d0-bfad-3467-a485-b4f327f88786",
                                "text": "La Bretagne du Léon et celle de la Cornouaille n'ont pas exactement la même manière de se comporter vis-à-vis de l’Église. Les littérateurs bretons eux-mêmes opposent l’une à l’autre, couramment, la Bretagne cléricale du Léon et la Bretagne républicaine de Cornouaille."
                            },
                            {
                                "example_id": "f5ad375d-241a-41ed-b34c-27b1f0212d09",
                                "sense_id": "d39bc6d0-bfad-3467-a485-b4f327f88786",
                                "text": "Il se jette dans la mêlée qu’il domine de haut, il soutient le chant d’une voix ample, et il gueule plus fort que les autres gamins, tout en calottant le Maloret :\n« Les cléricaux la trogne – Trente-six pieds de charogne. – La merde aux boyaux – pour faire crever les cléricaux... »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "989a88a0-8950-4a57-9f16-b45ad0c22216",
                        "source_entry_id": "adb017eb-0a90-3ceb-bc16-20c7a603a368",
                        "source_sense_id": "23833525-24cc-3ed3-aea9-007ac3b548d0",
                        "source_sense_description": "Qui appartient au clergé.",
                        "target_lang_word": "clerical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clerical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a7d30f7-ee83-3b7c-a759-c91454fb287c",
                                        "entry_id": "350f65c0-bbfd-3fb5-b626-94a2d39a0d15",
                                        "glosses": [
                                            "Of or relating to clerks or their work."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d407524c-3f37-4621-8470-108362a6b985",
                                                "sense_id": "3a7d30f7-ee83-3b7c-a759-c91454fb287c",
                                                "text": "‘The groans of this sick person,’ he said, ‘distract my attention. And without that it is extremely difficult to guard against clerical errors in this climate.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8db2699-e232-3bb7-9ffa-88038bbe83d8",
