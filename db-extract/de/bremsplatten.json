                "senses": [
                    {
                        "sense_id": "302f9f67-d602-3edc-a113-d061e0dd444f",
                        "entry_id": "61afc36e-eb74-33f2-9083-af7aa1df930e",
                        "glosses": [
                            "Reifenschaden auf der Lauffläche, der bei harten Bremsmanövern entstehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a1ce16c-e0ad-4b32-8051-42f94607f3b3",
                                "sense_id": "302f9f67-d602-3edc-a113-d061e0dd444f",
                                "text": "„Bei Vollbremsungen aus hoher Geschwindigkeit kann ein so genannter Bremsplatten entstehen.“"
                            },
                            {
                                "example_id": "44ddb3c1-4c99-4a3e-a9c2-6c2b53aac77f",
                                "sense_id": "302f9f67-d602-3edc-a113-d061e0dd444f",
                                "text": "„Doch während alle Drehungen und unfreiwilligen Umwege lediglich Sekundenverluste bedeuteten, kämpfte Kimi Raikkönnen als Spitzenfahrer die Hälfte des Rennens mit einem Bremsplatten am Vorderrad, den er sich durch einen Ausflug ins Kiesbett holte.“"
                            },
                            {
                                "example_id": "3a608b27-9eea-430a-9fa2-df4b65bf8782",
                                "sense_id": "302f9f67-d602-3edc-a113-d061e0dd444f",
                                "text": "„Außerdem verhindert ABS das Entstehen von Flachstellen auf der Lauffläche der Reifen (Bremsplatten) und entlastet die Fahrerin/den Fahrer bei ganz extremen Bremsvorgängen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
