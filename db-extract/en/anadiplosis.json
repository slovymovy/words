                                        "entry_id": "2848b65b-33e2-31d8-a6f1-060330a01db5",
                                        "glosses": [
                                            "figura de linguagem que consiste na repetição da última palavra ou expressão de uma oração ou frase no início da seguinte, com intenção de realce"
                                        ],
