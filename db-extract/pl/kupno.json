                                        "tags": [
                                            "Handel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "156e1498-5707-4780-9ca1-cbee26a9fa00",
                                                "sense_id": "78f1b5a1-fa03-384b-8608-b11e0a3bdc0c",
                                                "text": "Der Kauf einer Sache im Internet kann innerhalb von zwei Wochen widerrufen werden."
                                            },
                                            {
                                                "example_id": "79277f7d-ebdd-4362-a880-dea16ff212b2",
                                                "sense_id": "78f1b5a1-fa03-384b-8608-b11e0a3bdc0c",
