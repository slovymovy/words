                    {
                        "translation_id": "3a98036b-2951-49aa-a220-86e2301174eb",
                        "source_entry_id": "c9a7d5ca-1c28-33e6-91da-c8897477aac2",
                        "source_sense_id": "7113abd5-36e4-3890-8295-577c5099eb1f",
