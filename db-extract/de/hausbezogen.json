                        ],
                        "form": "sie sind hausbezogen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d8ca89f-0ce6-308e-93ac-2e0a7982354d",
                        "entry_id": "96738537-da6e-3102-9e68-a37bf516e0f9",
                        "glosses": [
                            "das Haus, das eigene Heim betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85945859-4819-4554-8a67-5960da2e2865",
                                "sense_id": "3d8ca89f-0ce6-308e-93ac-2e0a7982354d",
                                "text": "„Es ist ein Ort, wo man sehr hausbezogen leben kann, vieles findet in den eigenen vier Räumen statt.“"
                            },
                            {
                                "example_id": "8a610261-e8c8-4972-b868-e8b0fb7e68fc",
                                "sense_id": "3d8ca89f-0ce6-308e-93ac-2e0a7982354d",
                                "text": "„Die entsprechenden Kosten sind hausbezogen und fallen daher bei adäquaten Betriebsgrößen nicht ins Gewicht.“"
                            },
                            {
                                "example_id": "3282fbd9-2db3-4375-83b0-2cb5a724e93f",
                                "sense_id": "3d8ca89f-0ce6-308e-93ac-2e0a7982354d",
                                "text": "„Er sieht in der hausbezogenen Tätigkeit die Hauptaufgabe des Menschen und nicht in der Teilhabe am öffentlichen Leben.“"
                            },
                            {
                                "example_id": "c25d1e6d-65eb-41dc-bb4b-d81c216871d5",
                                "sense_id": "3d8ca89f-0ce6-308e-93ac-2e0a7982354d",
                                "text": "„In diesem Fall hat der Verwalter hausbezogene Wirtschaftspläne und Jahresabrechnungen aufzustellen und den Untergemeinschaften zur Beschlussfassung vorzulegen.“"
                            },
                            {
                                "example_id": "fd358dc7-4f00-496f-8f93-853b5c25df28",
                                "sense_id": "3d8ca89f-0ce6-308e-93ac-2e0a7982354d",
