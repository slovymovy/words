                ],
                "senses": [
                    {
                        "sense_id": "c20ea19a-44f9-3329-93d3-5863576045bf",
                        "entry_id": "4b5b5e82-adce-36d2-8e6d-8ac4eea27a8c",
                        "glosses": [
                            "Poignard malais dont la lame est parfois ondulée."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "e19f53e4-7afb-415e-b30c-c236a9f6a4c1",
                                "sense_id": "c20ea19a-44f9-3329-93d3-5863576045bf",
                                "text": "Un cris, ou poignard malais, trempé dans un poison autre que celui du grand upas, donne un mort plus lente et précédée de convulsions. Puis, lorsque ce cris a servi, si le possesseur veut lui rendre toute sa vertu vénéneuse, il faut le raviver par du jus de citron."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "c024ea90-9199-38af-9ffd-6d20d6c581e1",
                "word": "cris",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "51b6fccb-1d49-45b5-8009-43374d752027",
                        "entry_id": "c024ea90-9199-38af-9ffd-6d20d6c581e1",
                        "tags": [
                            "singular"
                        ],
                        "form": "cri"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "843a2f5f-b17e-3b6f-9c66-aa424c6fd676",
                        "entry_id": "c024ea90-9199-38af-9ffd-6d20d6c581e1",
                        "glosses": [
                            "Pluriel de cri."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e40fa927-b10c-4db8-a85e-cbeee5a1f663",
                                "sense_id": "843a2f5f-b17e-3b6f-9c66-aa424c6fd676",
                                "text": "On n’entend que des cris d’oiseaux de mer, goélands et macreuses, qui s’abandonnent aux caprices du vent."
                            },
                            {
                                "example_id": "3898753d-bfae-43c9-b8f9-1f76bf2db4de",
                                "sense_id": "843a2f5f-b17e-3b6f-9c66-aa424c6fd676",
                                "text": "Les matches se disputaient au milieu d’un grand vacarme produit par les cris des parieurs comme les parties de chistera en Espagne."
                            },
                            {
                                "example_id": "2010df59-d3e7-423e-96c4-6ddf941a31b5",
                                "sense_id": "843a2f5f-b17e-3b6f-9c66-aa424c6fd676",
                                "text": "Dans la loge de la vedette, à gauche, les chiens jappaient à petits cris aigus."
                            },
                            {
                                "example_id": "e91ff6d5-563d-46a2-af64-ca598532dcd7",
                                "sense_id": "843a2f5f-b17e-3b6f-9c66-aa424c6fd676",
                                "text": "Les cris des coqs, les sabots des ânes poussés par l’encouragement sonore et monotone des paysans, réveillèrent Elhamy le lendemain."
                            },
                            {
                                "example_id": "340a0b16-0bb7-4ea1-b7bd-7309c6a6eec5",
                                "sense_id": "843a2f5f-b17e-3b6f-9c66-aa424c6fd676",
                                "text": "Des nuits entières, durant un mois, j’ai entendu hurler des hommes que l’on torturait, et leurs cris résonnent pour toujours dans ma mémoire."
                            }
                        ]
                    }
                ],
