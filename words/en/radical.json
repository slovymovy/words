                        "zh": [
                            {
                                "target_lang_word": "部首",
                                "target_lang_sense_clarification": "汉字查字法中的偏旁"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a989530d-027d-31e4-976a-b23ba6c27631",
                    "sense_definition": "An atom, molecule, or ion that has at least one unpaired valence electron, making it highly reactive.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Antioxidants are important because they help neutralize a free <w>radical</w> in the body.",
                            "target_lang_translations": {
                                "ru": "Антиоксиданты важны, потому что они помогают нейтрализовать свободные <w>радикалы</w> в организме.",
                                "zh": "抗氧化剂很重要，因为它们有助于中和体内的<w>自由基</w>。"
                            }
                        },
                        {
                            "text": "The chemical reaction was triggered by the presence of a highly unstable <w>radical</w>.",
                            "target_lang_translations": {
