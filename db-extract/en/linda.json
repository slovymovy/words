                "forms": [],
                "senses": [
                    {
                        "sense_id": "b9447964-2835-3def-8129-063ba1fa9c00",
                        "entry_id": "fe758d88-a200-3855-b585-556d98ab7c40",
                        "glosses": [
                            "A female given name from the Germanic languages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "075a83d1-e531-4988-8a14-9ae2e5461262",
                                "sense_id": "b9447964-2835-3def-8129-063ba1fa9c00",
                                "text": "The Orange-Tree stood in a Wood which belong'd to a Princess, who liv'd in a magnificent Palace not far off, and us'd to walk there. This Princess was young, beautiful and witty, and her Name Linda."
                            },
                            {
                                "example_id": "e3b81e19-b221-416f-8477-8cdaa9dd3245",
                                "sense_id": "b9447964-2835-3def-8129-063ba1fa9c00",
                                "text": "When I go to sleep / I never count sheep / I count all the charms about Linda."
                            }
                        ]
                    },
                    {
                        "sense_id": "b41d9ee5-4035-3ec8-8b7f-1fc674b4fd0c",
                        "entry_id": "fe758d88-a200-3855-b585-556d98ab7c40",
                        "glosses": [
                            "A census-designated place in Yuba County, California, United States."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "427872e6-8cf0-350e-901d-f1fea11ffd0c",
                        "entry_id": "fe758d88-a200-3855-b585-556d98ab7c40",
                        "glosses": [
                            "A coordination language for parallel computing environments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67f77847-05f4-4c5e-86c0-f2b4fdddd315",
                                "sense_id": "427872e6-8cf0-350e-901d-f1fea11ffd0c",
                                "text": "The aim of this paper is to analyse the concept of extending the parallel logic programming paradigm with Linda-like operations, thus facilitating distributed data storage, access and management."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90e47953-69c4-48e9-a2b4-bf2691b866ef",
