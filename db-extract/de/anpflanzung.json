                        "glosses": [
                            "Stück Land, auf dem Pflanzen eingesetzt wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47543c74-7271-4afe-814d-c07115c4b982",
                                "sense_id": "01c979f2-5711-3cc8-8769-a2ba0e6c9825",
                                "text": "Diese Anpflanzung wurde bereits voriges Jahr angelegt."
