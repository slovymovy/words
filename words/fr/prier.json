                    ]
                },
                {
                    "sense_id": "5837be64-bfd1-3a64-b296-10a7e3d55852",
                    "sense_definition": "Inviter ou convier formellement quelqu'un à un événement ou à un repas.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le marquis avait <w>prié</w> de nombreux artistes célèbres à son grand banquet."
                        },
                        {
                            "text": "Elle fut <w>priée</w> à dîner dans un restaurant réputé de la capitale."
