                        "sense_id": "f6986f56-274a-341d-96d6-bfa38c70825a",
                        "entry_id": "dd2defed-1ced-34b7-89c4-ab4e1448744d",
                        "glosses": [
                            "Île de Grèce."
                        ],
                        "tags": [
