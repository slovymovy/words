                "senses": [
                    {
                        "sense_id": "352a3538-e608-3b58-9844-c833f1a68343",
                        "entry_id": "3f82137d-e762-396b-a079-f2a22f075b7a",
                        "glosses": [
                            "Eigenschaft, nicht einsetzbar zu sein, wenn es notwendig wäre"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27cc24a1-c41b-404f-a61a-f3b37e517421",
                                "sense_id": "352a3538-e608-3b58-9844-c833f1a68343",
                                "text": "Wegen seiner notorischen Unzuverlässigkeit können wir ihn in unserem Team leider nicht einsetzen."
                            },
                            {
                                "example_id": "f63c5d8e-3eaa-4f88-b07c-a2e05fde4181",
                                "sense_id": "352a3538-e608-3b58-9844-c833f1a68343",
                                "text": "„Die Unzuverlässigkeit von Reisefreundschaften kennt kein Alter.“"
                            },
                            {
                                "example_id": "89baa0fb-3a07-4c04-a351-31ee063450c0",
                                "sense_id": "352a3538-e608-3b58-9844-c833f1a68343",
                                "text": "„Im Januar 1916 wurde er im brandenburgischen Jüterbog als Richtkanonier ausgebildet und wegen seiner weltanschaulichen Unzuverlässigkeit sofort in eine Verdächtigenkompanie gesteckt.“"
                            }
                        ],
