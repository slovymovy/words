                        "form": "ру́шась"
                    },
                    {
                        "form_id": "47388e31-1844-41d3-bee9-9e3b87223a02",
                        "entry_id": "042db59f-4d7b-32ac-a07d-15da2cc7556d",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "ру́шившись"
                    },
                    {
                        "form_id": "29cf40f8-b0b8-43be-b624-3a25f0542bb9",
                        "entry_id": "042db59f-4d7b-32ac-a07d-15da2cc7556d",
