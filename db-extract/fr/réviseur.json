                                        "glosses": [
                                            "The clerk who tallies cost of purchases and accepts payment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "067c7975-ddfd-408e-a7e5-e393669070a3",
                                                "sense_id": "34fb46ac-7e48-37d7-802d-79f224a72b15",
                                                "text": "There was a long line at the grocery store because the checker was so slow."
                                            },
                                            {
                                                "example_id": "40273b1c-a297-4a7a-98cd-748d5985abe6",
                                                "sense_id": "34fb46ac-7e48-37d7-802d-79f224a72b15",
                                                "text": "Bud Brown said something to the checker he was supervising; she had been craning around to see what was happening. She flushed and began to run her calculator again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34dfc1a8-5f8e-32f5-8500-aa7148177bae",
