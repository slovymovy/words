                ],
                "translations": [
                    {
                        "translation_id": "c2b57bfe-2f9d-4cd1-a41b-0aa6779a7cfc",
                        "source_entry_id": "3f17e9db-0894-39a9-a7a5-3ee9b95c1966",
                        "source_sense_description": "mystery or deep secret",
                        "target_lang_word": "Arkanum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arkanum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f32ec88-8621-36d5-9053-122b7b31711d",
                                        "entry_id": "b4dab976-aebd-39e1-9080-a0cc9a46ea80",
                                        "glosses": [
                                            "Geheimnis, das Geheimgehaltene als Teil einer Geheimlehre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b95dc0fe-fb51-4ac1-8356-f03f9c0ecd19",
                                                "sense_id": "7f32ec88-8621-36d5-9053-122b7b31711d",
                                                "text": "„Das Buch bleibt »bis tief ins Hochmittelalter hinein ein Gegenstand der Verehrung und des Respekts, ein Numinosum als Wort- und Zeichenträger, ganz abgesehen von der Kostbarkeit im materiellen Sinn. Ein Arkanum für den analphabetischen Laien, hat es, dank seiner Rolle in der Liturgie und seinem Gehalt, sakralen, wenn nicht gar magischen Charakter auch für den Gebildeten. (Max Wehrli)«“"
                                            },
                                            {
                                                "example_id": "f7b1d1cc-cc59-48e9-9c5f-a3c78c68e54a",
                                                "sense_id": "7f32ec88-8621-36d5-9053-122b7b31711d",
                                                "text": "„Die Übung schweigender Konzentration ist also aus einem Arkanum zum Normalfall unserer Arbeitswelt geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ffd81645-1886-3560-9ec5-812727ced85a",
                                        "entry_id": "b4dab976-aebd-39e1-9080-a0cc9a46ea80",
                                        "glosses": [
                                            "Geheimmittel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa8ecaaa-c5b8-4578-8c07-c177355da277",
                                                "sense_id": "ffd81645-1886-3560-9ec5-812727ced85a",
                                                "text": "„Die Masse des Arzneimittels hielt Paracelsus nur für die äußere Hülle, worin das Arkanum selbst immateriell enthalten ist.“"
                                            },
                                            {
                                                "example_id": "1f774b87-5f66-4b49-97da-953b88e2c2c2",
                                                "sense_id": "ffd81645-1886-3560-9ec5-812727ced85a",
                                                "text": "„Der Leidende, der Jahre lang ängstlich und furchtsam sein Zimmer kaum zu verlassen gewagt, entschloß sich mit enthusiastischer Freude nach dem Orte zu reisen, wo das Arkanum für sein langwieriges Übel sich befinden sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c37971db-314f-4371-b974-c44e42073149",
                        "source_entry_id": "3f17e9db-0894-39a9-a7a5-3ee9b95c1966",
                        "source_sense_description": "mystery or deep secret",
                        "target_lang_word": "Geheimnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geheimnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d007ba5-ada7-3e4c-964e-1391adf3f3b0",
                                        "entry_id": "5f6ca3c6-7019-30e1-ace9-d783c1247f85",
                                        "glosses": [
                                            "verborgene Handlung oder Information"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a61c7d24-665c-4d23-ad96-d7b5e09b6484",
                                                "sense_id": "0d007ba5-ada7-3e4c-964e-1391adf3f3b0",
                                                "text": "Diese kleine Episode bleibt auf ewig unser Geheimnis."
                                            },
                                            {
                                                "example_id": "bdb83738-86fc-4e90-a3f7-e0657fc16a13",
                                                "sense_id": "0d007ba5-ada7-3e4c-964e-1391adf3f3b0",
                                                "text": "Das Verhältnis zwischen Karl und Lisa ist doch ein offenes Geheimnis."
                                            },
                                            {
                                                "example_id": "34439242-36f5-4f1d-820a-83450ca3d773",
                                                "sense_id": "0d007ba5-ada7-3e4c-964e-1391adf3f3b0",
                                                "text": "„Es gab keinen Platz für Geheimnisse und Intimität.“"
                                            },
                                            {
                                                "example_id": "ab789b0e-b169-4739-a034-83c1bbe85a55",
                                                "sense_id": "0d007ba5-ada7-3e4c-964e-1391adf3f3b0",
                                                "text": "„Ich war stolz, dass ich von dem großen Geheimnis der Erwachsenen erfahren hatte.“"
                                            },
                                            {
                                                "example_id": "c1c79fae-3bb5-4f6d-935e-e253aa625083",
                                                "sense_id": "0d007ba5-ada7-3e4c-964e-1391adf3f3b0",
                                                "text": "„Trotzdem musste sie die Geheimnisse mit jemandem teilen.“"
                                            },
                                            {
                                                "example_id": "70284539-e854-4f8a-8ef9-59bd03896250",
                                                "sense_id": "0d007ba5-ada7-3e4c-964e-1391adf3f3b0",
                                                "text": "„Das Geheimnis von Masaryks Erfolg war seine Orientierung nach dem Westen.“"
                                            },
                                            {
                                                "example_id": "3c5bcacd-7a4d-4a4d-9b46-a9005280736e",
                                                "sense_id": "0d007ba5-ada7-3e4c-964e-1391adf3f3b0",
                                                "text": "„Bald sickerte das Geheimnis durch, daß dieser Schachmeister in seinem Privatleben außerstande war, in irgendeiner Sprache einen Satz ohne orthographischen Fehler zu schreiben,“ […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
