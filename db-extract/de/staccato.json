                ],
                "translations": [
                    {
                        "translation_id": "61c9c011-9185-4e58-ba58-7c45d819b736",
                        "source_entry_id": "e9b48aef-fe3e-3641-8b82-a2aeb9018b67",
                        "source_sense_id": "186f3bb8-7388-33fd-99c9-ebb497d35970",
                        "target_lang_word": "staccato",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "staccato",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c8ff1e6-a2cf-36bc-8fea-bfae48ec60f2",
                                        "entry_id": "3295d2e5-1625-3d55-8880-8686c5a69e3e",
                                        "glosses": [
                                            "An articulation marking directing that a note or passage of notes are to be played in an abruptly disconnected manner, with each note sounding for a very short duration, and a short break lasting until the sounding of the next note; as opposed to legato. Staccato is indicated by a dot directly above or below the notehead."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3115d652-0354-3220-989f-d329c82cf180",
                                        "entry_id": "3295d2e5-1625-3d55-8880-8686c5a69e3e",
                                        "glosses": [
                                            "A passage having this mark."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4ac6e1b-66bf-3f5b-b306-aca2951cd83f",
                                        "entry_id": "3295d2e5-1625-3d55-8880-8686c5a69e3e",
                                        "glosses": [
                                            "Any sound resembling a musical staccato."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4b0a382-4148-4470-aeb8-f0d4d190b59f",
                                                "sense_id": "e4ac6e1b-66bf-3f5b-b306-aca2951cd83f",
                                                "text": "According to the syllable-timed hypothesis, Spanish syllables as staccato."
                                            },
                                            {
                                                "example_id": "67533af7-86c9-4316-ad22-57f0ca8c08b8",
                                                "sense_id": "e4ac6e1b-66bf-3f5b-b306-aca2951cd83f",
                                                "text": "The tumultuous noise resolved itself now into the disorderly mingling of many voices, the gride of many wheels, the creaking of waggons, and the staccato of hoofs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "staccato",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95ca6677-c5df-3356-94cb-ee7364052f7a",
                                        "entry_id": "c43f5264-7e59-3352-91e9-b5a43ae48600",
                                        "glosses": [
                                            "played in this style"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dddef3a-a975-4456-9b55-22edec0d57a9",
                                                "sense_id": "95ca6677-c5df-3356-94cb-ee7364052f7a",
                                                "text": "Now, play the same passage very staccato."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "staccato",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07838d16-0376-35fc-9251-771d54656f0c",
                                        "entry_id": "c16d7eb7-5d0c-3d49-a3a1-0b059c05f22a",
                                        "glosses": [
                                            "Describing a passage having this mark."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "632f1ebb-7c7b-399a-934c-2c7a02e52044",
                                        "entry_id": "c16d7eb7-5d0c-3d49-a3a1-0b059c05f22a",
                                        "glosses": [
                                            "Made up of abruptly disconnected parts or sounds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1833f7a9-e7d0-43e6-97f0-578e341c388f",
                                                "sense_id": "632f1ebb-7c7b-399a-934c-2c7a02e52044",
                                                "text": "The same nervous staccato laugh broke from her thin lips, and her fingers began to play with a long tortoise-shell paper-knife."
                                            },
                                            {
                                                "example_id": "ba371e1f-085e-4ca9-a089-229407ca4273",
                                                "sense_id": "632f1ebb-7c7b-399a-934c-2c7a02e52044",
                                                "text": "A kind of tense peace, like the centre of a cyclone, descended. Not for long, of course, for already stealing upon one's hearing would be the staccato bark and thrust of the banker bringing up the rear."
                                            },
                                            {
                                                "example_id": "f9756124-6819-4820-af6a-4c392f26613e",
                                                "sense_id": "632f1ebb-7c7b-399a-934c-2c7a02e52044",
                                                "text": "The water-level route, the whistle and the loud staccato exhaust of this great engine recalled most vividly memories of the New York Central Hudsons highballing along the Hudson River between Harmon and Albany!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "463f2c87-83a8-4b1d-9dd6-7d49f5d3937f",
                        "source_entry_id": "e9b48aef-fe3e-3641-8b82-a2aeb9018b67",
                        "source_sense_id": "186f3bb8-7388-33fd-99c9-ebb497d35970",
                        "target_lang_word": "staccato",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "staccato",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86acef73-cb3b-3405-955c-9bb7397d56b1",
                                        "entry_id": "a4bb0088-60ac-34ca-bff6-05618877331d",
                                        "glosses": [
                                            "De façon hachée, avec les notes détachées"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aec9419e-eb63-47df-b96f-51823f508271",
                                                "sense_id": "86acef73-cb3b-3405-955c-9bb7397d56b1",
                                                "text": "Il faut jouer ce passage un peu plus staccato."
                                            },
                                            {
                                                "example_id": "5e45bae1-d477-4c3f-aef3-47533031a2ef",
                                                "sense_id": "86acef73-cb3b-3405-955c-9bb7397d56b1",
                                                "text": "Le staccato de la pluie cinglait les vitres."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "staccato",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c80fb9c-7d94-3d93-844a-b593504066a3",
                                        "entry_id": "2254b192-ac64-344b-b50a-5ae51758fe0b",
                                        "glosses": [
                                            "Phrasé musical dans lequel les notes des motifs et des phrases musicales doivent être exécutées avec des suspensions entre elles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6f8ad37-d396-49da-9025-134cba72ea0f",
                                                "sense_id": "5c80fb9c-7d94-3d93-844a-b593504066a3",
                                                "text": "Le staccato de la flûte ressemble plus à de discrets hoquets de rire qu'à des soubresauts sanglotants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea5a7f1f-46ce-3aa0-b207-2fee7948df8b",
                                        "entry_id": "2254b192-ac64-344b-b50a-5ae51758fe0b",
                                        "glosses": [
                                            "Bruit saccadé rappelant un staccato."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9e1d3b9-01d1-4b58-b728-5a1effb6911a",
                                                "sense_id": "ea5a7f1f-46ce-3aa0-b207-2fee7948df8b",
                                                "text": "Le staccato d'une moto lancée à toute vitesse éveilla la ruelle proche."
                                            },
                                            {
                                                "example_id": "a4a35ed3-3227-4742-99be-5147701ebcf7",
                                                "sense_id": "ea5a7f1f-46ce-3aa0-b207-2fee7948df8b",
                                                "text": "Le tant attendu \"Feu à volonté !\" déchire l'air. Le tunnel se remplit du staccato des fusils d'assaut et du tonnerre de la mitrailleuse lourde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44e7647d-8b84-3af7-b093-1c3563c03ac2",
                                        "entry_id": "2254b192-ac64-344b-b50a-5ae51758fe0b",
                                        "glosses": [
                                            "Façon de parler saccadée rappelant un staccato."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80bac12a-6535-4b56-9035-3a279be3a6ce",
                                                "sense_id": "44e7647d-8b84-3af7-b093-1c3563c03ac2",
                                                "text": "Il accentuait exagérément les dernières syllabes, particularité qui transformait son phrasé en staccato de pistolet-mitrailleur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
