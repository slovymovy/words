                        "source_sense_id": "0a99b145-ea01-3efc-b129-09d2d5de5e6d",
                        "source_sense_description": "Eigenschaft wie Herrlichkeit, Erhabenheit oder Größe, die von etwas oder jemanden ausgeht",
                        "target_lang_word": "majesty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "majesty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48e22824-d864-36d4-a8c8-61c0af8f7e7f",
                                        "entry_id": "63a7a0a7-1da7-3a73-81c6-7226dfad608c",
                                        "glosses": [
                                            "The quality of being impressive, great, dignified, powerful, sovereign, or any combination thereof."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ea8ab81-2ba9-48ca-a933-99bd4304a9ca",
                                                "sense_id": "48e22824-d864-36d4-a8c8-61c0af8f7e7f",
