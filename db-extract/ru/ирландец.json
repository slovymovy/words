                    {
                        "translation_id": "d790b356-04a4-4c88-9309-b8bbd29306c3",
                        "source_entry_id": "af68873a-d0aa-32f5-88e3-3c4cbcd5354b",
                        "source_sense_id": "98837a90-eebd-3525-b30b-96586aaac495",
                        "target_lang_word": "Ire",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ire",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "712d3d54-b8fc-3366-a128-a17696ecc18c",
                                        "entry_id": "9483a869-8020-304b-a471-755bc0b6cd2d",
                                        "glosses": [
                                            "Staatsbürger von Irland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "737f0d4b-3233-4b60-baba-2523e60b9920",
                                                "sense_id": "712d3d54-b8fc-3366-a128-a17696ecc18c",
                                                "text": "Patrick ist gebürtiger Ire."
                                            },
                                            {
                                                "example_id": "ab5739d4-8f01-4eee-bb04-93341197f653",
                                                "sense_id": "712d3d54-b8fc-3366-a128-a17696ecc18c",
                                                "text": "„Ein einzelner war es, der sich plötzlich mitten zwischen die Wütenden warf und den Arm des Iren ergriff.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1aecf600-ec94-3f82-9aeb-7faad651c563",
                                        "entry_id": "9483a869-8020-304b-a471-755bc0b6cd2d",
                                        "glosses": [
                                            "Angehöriger des irischen Volkes, aus Irland stammende Person, Bewohner der Insel Irland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddfc70af-6eb4-4319-9dec-5f34cd11bc3b",
                                                "sense_id": "1aecf600-ec94-3f82-9aeb-7faad651c563",
                                                "text": "Im 19. Jahrhundert wanderten viele Iren in die USA aus."
                                            },
                                            {
                                                "example_id": "e8e10b1a-b5ee-4d27-b9e4-a3b261d5a9ea",
                                                "sense_id": "1aecf600-ec94-3f82-9aeb-7faad651c563",
                                                "text": "„Der Zug näherte sich nun dem Wachthause, der Ire hielt jedoch alle zehn Schritte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63790b9d-056c-4181-a752-8a9f45ea6c41",
                        "source_entry_id": "af68873a-d0aa-32f5-88e3-3c4cbcd5354b",
                        "source_sense_id": "98837a90-eebd-3525-b30b-96586aaac495",
                        "target_lang_word": "Irländer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Irländer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b88e3abf-5569-371f-878f-e507eeec475c",
                                        "entry_id": "9f6cb503-a665-34da-8fc3-209adb6b045b",
                                        "glosses": [
                                            "Person, die in Irland lebt oder dort geboren wurde"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83a5bf32-f9b5-40d9-8b17-102723cc20ed",
                                                "sense_id": "b88e3abf-5569-371f-878f-e507eeec475c",
                                                "text": "„Der lustige Irländer wurde in seinen Familienbekenntnissen zum Leidwesen der Männer von Opelousas, wie es schien, durch zwei Milizen unterbrochen, die Gewehr in Arm nun von dem Wachthause ankamen, um ihn mit seinen zwei Gefährten in Empfang zu nehmen.“"
                                            },
                                            {
                                                "example_id": "90f10db0-334a-4a1a-bce8-c3f2481393cf",
                                                "sense_id": "b88e3abf-5569-371f-878f-e507eeec475c",
                                                "text": "„Der Mann, der den ersten Schlag geführt hatte, war ein kleiner, untersetzter Irländer mit brennend roten Haaren und noch röterem Bart, in Hemdsärmeln, mit offenem Kragen und einer zu kurzen, engen Nankinghose, was seiner Figur einen komischen Anstrich gab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
