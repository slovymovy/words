                        "glosses": [
                            "Extrêmement violent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2c099bb-7e17-4e95-8175-2ae53cdfb132",
                                "sense_id": "159b38f8-4424-3612-973a-e29cdbff8547",
                                "text": "Moi j’ai toujours peur quand elle revient de chez ses grands-parents, parce qu’il y a la télé souvent allumée, les infos et tout, et qu’elle voit des images archi-violentes, traumatisantes."
                            },
                            {
                                "example_id": "a57f4b34-ad59-4845-a35b-1aee0cb0f5d0",
                                "sense_id": "159b38f8-4424-3612-973a-e29cdbff8547",
                                "text": "Je rêve d’un club qui endosse le rôle de soupape de décompression de cette société archi-violente dans laquelle on est compressé tous les jours."
                            },
                            {
                                "example_id": "1fbbb425-d747-41df-ad56-4ac2b6e83a4b",
                                "sense_id": "159b38f8-4424-3612-973a-e29cdbff8547",
                                "text": "Nous sommes une compagnie d’archi-violents ; soyons archi-violents… et pour cela laissons-nous marcher sur les pieds comme des agneaux ; ce sera la grande violence spirituelle, la nouveauté, l’impossible."
                            }
                        ]
                    }
