                "senses": [
                    {
                        "sense_id": "677b90b6-e536-35d1-8787-eafb4e191352",
                        "entry_id": "7dd6208e-7968-3d3c-8324-fb5580cdbed1",
                        "glosses": [
                            "Qui a de l’affliction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "081ddeb7-3fa2-405b-9bde-17dc8486ae8d",
                                "sense_id": "677b90b6-e536-35d1-8787-eafb4e191352",
                                "text": "[…] légère, étourdie, folle même, elle riait de tout, ne s’intéressait à rien ; confondait la tristesse avec l’humeur, et ne voyait dans une personne affligée qu’une personne ennuyeuse."
                            },
                            {
                                "example_id": "1f1cd7f2-0b6d-4e97-8301-ee0a58536cf7",
                                "sense_id": "677b90b6-e536-35d1-8787-eafb4e191352",
                                "text": "Désormais, je voyais clair dans cette petite âme de rouée. J’avais été mystifié comme un collégien et j’en restais confus encore plus qu’affligé."
                            },
                            {
                                "example_id": "2f282dcd-4c92-46c1-98cd-019cef9f45b0",
                                "sense_id": "677b90b6-e536-35d1-8787-eafb4e191352",
                                "text": "Vous pouvez aller cette après-midi à Wuthering Heights, si vous voulez, et dire que je ne suis pas irrité, mais affligé de l’avoir perdue ; d’autant plus que je ne puis croire qu’elle soit jamais heureuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "9542fe6d-8fe8-3e92-adeb-e214fa513acd",
                        "entry_id": "7dd6208e-7968-3d3c-8324-fb5580cdbed1",
                        "glosses": [
                            "Doté ; pourvu."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "d29b1617-f181-4697-ab45-ca2c87f2d141",
                                "sense_id": "9542fe6d-8fe8-3e92-adeb-e214fa513acd",
                                "text": "La voilà affligée de cent mille livres de rente."
                            },
                            {
                                "example_id": "457c1d67-261c-439b-8d3a-c6eafaac2552",
                                "sense_id": "9542fe6d-8fe8-3e92-adeb-e214fa513acd",
                                "text": "Affligés du bonnet d’âne."
                            }
                        ]
                    }
                ],
                "translations": [
