                "forms": [
                    {
                        "form_id": "fd05ac73-34eb-4a86-8550-224f45c4aee1",
                        "entry_id": "cfcb81b2-8472-39ee-b35b-a88ab5b715bd",
                        "tags": [
                            "plural"
                        ],
                        "form": "marginalisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "18af1d6b-1f92-3579-98ea-b3cb1cf044ae",
                        "entry_id": "cfcb81b2-8472-39ee-b35b-a88ab5b715bd",
                        "glosses": [
                            "Action d’écarter de la norme, notamment d’un groupe, de la société."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91a1b21f-28fe-4690-9257-1a65e4753700",
                                "sense_id": "18af1d6b-1f92-3579-98ea-b3cb1cf044ae",
                                "text": "La marginalisation peut à son tour donner naissance à la stigmatisation, et ce, même à l'intérieur du monde de la drogue."
                            },
                            {
                                "example_id": "c576df10-b709-4132-ba49-8c90120740d0",
                                "sense_id": "18af1d6b-1f92-3579-98ea-b3cb1cf044ae",
                                "text": "J’ai distingué sept représentations théoriques du phénomène de la marginalisation : l’anomie, la désorganisation sociale, la déviance, le comportement à risque élevé, la marginalisation, l’exclusion et la déprivation."
                            },
                            {
                                "example_id": "9d6425cb-a1fe-4c32-9155-3eb89594dacd",
                                "sense_id": "18af1d6b-1f92-3579-98ea-b3cb1cf044ae",
                                "text": "L'attention est ainsi également attirée sur les positions sociales qui précisément ne subissent pas de marginalisation ni de discrimination ; un travail qui a été systématiquement entamé ces dernières années par les études critiques de la masculinité, celles de la blanchitude (whiteness) et la critique de l’hétéronormativité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ca2eacb-a491-480a-948d-e6b89cc91edd",
                        "source_entry_id": "cfcb81b2-8472-39ee-b35b-a88ab5b715bd",
                        "source_sense_id": "18af1d6b-1f92-3579-98ea-b3cb1cf044ae",
                        "target_lang_word": "Ausgrenzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausgrenzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b54bc99d-242f-3d09-97d5-0d683fb9250f",
                                        "entry_id": "ca1b52f9-61e2-3151-9753-ab1458cb2857",
                                        "glosses": [
                                            "Ausschluss von etwas oder jemandem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c7179fa-8ea4-48e9-8935-a940bf55f54c",
                                                "sense_id": "b54bc99d-242f-3d09-97d5-0d683fb9250f",
                                                "text": "Der Mensch neigt zur Ausgrenzung des Fremden und der Fremden."
                                            },
                                            {
                                                "example_id": "5daff690-0a58-4e58-b559-11f1c6e2c544",
                                                "sense_id": "b54bc99d-242f-3d09-97d5-0d683fb9250f",
                                                "text": "Eine so frühzeitige Ausgrenzung der Finanzierungsaspekte halte ich für riskant."
                                            },
                                            {
                                                "example_id": "b99c16c1-42a3-489b-86e7-777f3a341481",
                                                "sense_id": "b54bc99d-242f-3d09-97d5-0d683fb9250f",
                                                "text": "„Es liegt nicht nur am Geld: Wer zur Unterschicht gehört, trägt in den Augen anderer oft die falsche Kleidung, spricht falsch und benimmt sich falsch. Klassismus wird diese kulturelle Ausgrenzung genannt, die sozialen Aufstieg fast unmöglich macht.“"
                                            },
                                            {
                                                "example_id": "4e3d8a1a-cf2b-45de-9860-a9d1c94b6eae",
                                                "sense_id": "b54bc99d-242f-3d09-97d5-0d683fb9250f",
                                                "text": "„Obgleich es im Laufe der Geschichte immer wieder zu Spannungen zwischen Schiiten und Sunniten kam, die auch in Gewalt mündeten, führte die Zugehörigkeit zur Schia lange nicht zu einer politischen Ausgrenzung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81a5d825-c366-4efb-ac0a-17155f1d73fa",
                        "source_entry_id": "cfcb81b2-8472-39ee-b35b-a88ab5b715bd",
                        "source_sense_id": "18af1d6b-1f92-3579-98ea-b3cb1cf044ae",
                        "target_lang_word": "Marginalisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marginalisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcf06541-6f49-3df6-9fba-af2525313808",
                                        "entry_id": "caf82f80-61ab-31f0-8afc-732d7c7f2aff",
                                        "glosses": [
                                            "die Abdrängung von Minderheiten an den Rand der Gesellschaft, Exklusion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78ed954d-41bd-4ab1-80fc-5f8856549060",
                                                "sense_id": "bcf06541-6f49-3df6-9fba-af2525313808",
                                                "text": "Besonders in Metropolen der Entwicklungsländer ist die Marginalisierung bestimmter Teile der Bevölkerung äußerst verheerend."
                                            },
                                            {
                                                "example_id": "a42a251d-ea08-4fd6-990f-516bdcca95ff",
                                                "sense_id": "bcf06541-6f49-3df6-9fba-af2525313808",
                                                "text": "„Das unkritische Streben der jungen Elitevertreter aus den benachteiligten Provinzen, in den pakistanischen Staatsdienst aufzusteigen, ist bemerkenswert. Denn objektiv betrachtet, stellt die staatliche Politik eine wesentliche Ursache für die politische und ökonomische Marginalisierung dieser Provinzen dar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
