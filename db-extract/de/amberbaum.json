                "senses": [
                    {
                        "sense_id": "c3846a64-fb3a-3aa2-a983-50ee9a8b37e6",
                        "entry_id": "77f2b878-d5b7-30e3-b494-8c96299887a1",
                        "glosses": [
                            "hoher, laubabwerfender Baum, der in Nord- und Mittelamerika sowie in Kleinasien vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80e2f273-bf9b-4fb1-867c-42c2c06dad1e",
                                "sense_id": "c3846a64-fb3a-3aa2-a983-50ee9a8b37e6",
                                "text": "„Um neues Land hinzuzugewinnen, brennen die Einheimischen gnadenlos die ökologisch wertvollen Schilfbestände nieder, fällen ganze Waldgebiete der seltenen Amberbäume.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
