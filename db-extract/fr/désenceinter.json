                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2052e3a7-061d-405e-9100-20cfcca2b0a4",
                                "sense_id": "68c14e36-e189-3b53-a956-a60dddaf21c9",
                                "text": "Une femme enceinte est punie de trois semaines de cachot, après avoir été dûment désenceintée."
                            },
                            {
                                "example_id": "89c462e9-795d-4a60-9aeb-223e217d658d",
                                "sense_id": "68c14e36-e189-3b53-a956-a60dddaf21c9",
                                "text": "Créature du passage et de la transition (même s’il est porté dans le ventre de la Morte pendant huit siècles…), dès que sa mère est « désenceintée, » il doit faire face aux forces réellement « sombres » symbolisées par Eshuoro et tous ceux qui sont impliqués dans la « danse macabre » du « mouvement de transition. »"
                            },
                            {
                                "example_id": "4af1471d-19c8-4258-9f02-fefd125f63ad",
                                "sense_id": "68c14e36-e189-3b53-a956-a60dddaf21c9",
                                "text": "J’ai fait la bêtise avec ma femme, là, je vais venir avec elle pour la désenceinter avant qu’elle soit enceinte!"
                            }
                        ]
                    }
