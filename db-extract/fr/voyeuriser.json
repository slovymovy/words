                "senses": [
                    {
                        "sense_id": "b1195d7e-4690-333d-a761-53163edba83f",
                        "entry_id": "7688e603-37c9-3c26-bb96-6060b481759e",
                        "glosses": [
                            "Regarder en voyeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7408e60d-6ca1-4c0f-8a33-b8852852d66f",
                                "sense_id": "b1195d7e-4690-333d-a761-53163edba83f",
                                "text": "Nombreux étaient les maîtres Toulouse-Lautrec, Degas, Bonnard, Balthus, Ingres, qui en avaient profité pour déshabiller puis voyeuriser le corps de leur modèle."
                            },
                            {
                                "example_id": "d490f59b-31d9-4c92-9c22-c0c41c8361a3",
                                "sense_id": "b1195d7e-4690-333d-a761-53163edba83f",
                                "text": "Il faudrait être maso pour les voyeuriser !"
                            },
                            {
                                "example_id": "e5666a56-6034-4439-8f0b-dd3dbb747a6d",
                                "sense_id": "b1195d7e-4690-333d-a761-53163edba83f",
                                "text": "Il y a un plaisir malsain à voyeuriser des corps torturés, à s'indigner, et à rendre la violence par des insultes racistes."
                            }
                        ]
                    }
