                                        "glosses": [
                                            "Unité de mesure de distance, de symbole kpc, équivalente à mille parsecs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8198561d-7ad0-4b23-b6c3-59fdf24f6dac",
                                                "sense_id": "a272ea6b-7738-3fcb-addb-01b72143526f",
                                                "text": "Les distances des autres objets célestes n’appartenant pas au système solaire sont bien plus grandes et se mesurent couramment en kiloparsecs."
                                            },
                                            {
                                                "example_id": "265d20a5-f311-4b88-a452-9724865b8bf2",
                                                "sense_id": "a272ea6b-7738-3fcb-addb-01b72143526f",
                                                "text": "Pour les étoiles, et les galaxies, l’unité la plus utilisée est le parsec (pc) et ses multiples (kiloparsec et megaparsec)."
                                            }
                                        ]
                                    }
                                ]
