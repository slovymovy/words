                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сводить с ума",
                                "target_lang_sense_clarification": "лишать рассудка"
                            },
                            {
                                "target_lang_word": "бесить",
                                "target_lang_sense_clarification": "приводить в ярость или исступление"
                            }
                        ]
