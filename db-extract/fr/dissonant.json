                                    },
                                    {
                                        "sense_id": "d9943d99-63bd-3ec8-a9b3-8ea6acc70282",
                                        "entry_id": "dab14949-c65b-3de7-930b-44987caa72c8",
                                        "glosses": [
                                            "Of figures, etc.: having opposite signs (for example, positive and negative)."
                                        ],
