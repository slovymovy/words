                    }
                ],
                "senses": [
                    {
                        "sense_id": "0a2ffa0c-4557-30f6-9a60-74594f30e863",
                        "entry_id": "274daa64-9cd0-3d63-be51-53b3f86045b2",
                        "glosses": [
                            "het polariseren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09a2ce9e-56ee-45a7-911d-899392b690bc",
                                "sense_id": "0a2ffa0c-4557-30f6-9a60-74594f30e863",
                                "text": "Hoe meet je de polarisatie van een magneet?"
                            }
                        ]
                    },
                    {
                        "sense_id": "7f6565f0-aacd-3d70-9778-cc560b8ad416",
                        "entry_id": "274daa64-9cd0-3d63-be51-53b3f86045b2",
                        "glosses": [
                            "het binnen de samenleving en/of politiek sterker en duidelijker worden van maatschappelijke tegenstellingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc5ebff5-eb04-49ce-b82c-a6376a3bc564",
                                "sense_id": "7f6565f0-aacd-3d70-9778-cc560b8ad416",
                                "text": "Aan deze kant van de Atlantische Oceaan wordt het politieke landschap gekenmerkt door een versterking van radicale antidemocratische, neofascistische krachten; door onliberale democratieën en autoritaire, racistische, antimoderne partijen; maar ook door polarisatie, pessimisme en ja, cynisme ten opzichte van het heersende systeem waarvan grote delen van de Europese bevolking vinden dat het hen niet langer vertegenwoordigt."
                            },
                            {
                                "example_id": "5c16fd5a-3fd4-46f0-93d3-a587a8d2f06f",
                                "sense_id": "7f6565f0-aacd-3d70-9778-cc560b8ad416",
                                "text": "Er is veel polarisatie binnen de samenleving."
                            },
                            {
                                "example_id": "ed49d0f7-06de-40da-9432-629c252cd4a8",
                                "sense_id": "7f6565f0-aacd-3d70-9778-cc560b8ad416",
                                "text": "48 miljoen kinderen niet gevaccineerd, mede door desinformatie en politieke polarisatie"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2415106-6def-4114-894e-f9ac351a5c84",
                        "source_entry_id": "274daa64-9cd0-3d63-be51-53b3f86045b2",
                        "target_lang_word": "polarisation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polarisation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "688ca46a-cc00-316b-a867-b351053a3c64",
                                        "entry_id": "bfbd2346-9592-301c-8ddd-ebb9adfc8626",
                                        "glosses": [
                                            "Non-Oxford British English standard spelling of polarization."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "countable",
                                            "nonstandard",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "977080fe-ed5e-453e-a7c5-2d72ece85485",
                                                "sense_id": "688ca46a-cc00-316b-a867-b351053a3c64",
                                                "text": "One wonders whether such an event, a conscious, improbable-but-made-probable event, took place at the time of creation, the act itself being nothing but a polarisation (or separation quality-wise) of the attributeless Nirguna, a separation of zero plus x and minus x. This is indeed the genesis of the Big Bang theory of science."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5747d004-61dd-4995-a4a6-ed33b92384ca",
                        "source_entry_id": "274daa64-9cd0-3d63-be51-53b3f86045b2",
                        "target_lang_word": "polarization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polarization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f69437bf-db82-31f7-ba84-348b9e641909",
                                        "entry_id": "2c12b98f-fc03-3b1e-bc19-2240035b56c8",
                                        "glosses": [
                                            "The production or the condition of polarity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "696e63f6-72a4-42e5-a0e8-8dfc17e8be76",
                                                "sense_id": "f69437bf-db82-31f7-ba84-348b9e641909",
                                                "text": "The subtopologies that we discovered include: a glide-symmetric analog of the quantum spin Hall effect, an hourglass-flow topology (exemplified by our recently-proposed KHgSb material class), and quantized non-Abelian polarizations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00c3afc8-cc13-392b-a5e3-c682c0e519fb",
                                        "entry_id": "2c12b98f-fc03-3b1e-bc19-2240035b56c8",
                                        "glosses": [
                                            "The production or the condition of polarity.",
                                            "The grouping of opinions into two extremes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa666755-30f3-4d2a-aae1-9ff2fa0cd26f",
                                                "sense_id": "00c3afc8-cc13-392b-a5e3-c682c0e519fb",
                                                "text": "What frazzled pollsters, surly op-ed pages, snarling cable talkfests and issue-starved candidates for office need is a fresh source of hot-eyed national polarization."
                                            },
                                            {
                                                "example_id": "7c8b8486-7239-45a5-9551-87104dba24bb",
                                                "sense_id": "00c3afc8-cc13-392b-a5e3-c682c0e519fb",
                                                "text": "Polarization is tearing at the seams of democracies around the world, from Brazil and India to Poland and Turkey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b622b52-7ee0-3e14-9d37-3c6dbb72cc08",
                                        "entry_id": "2c12b98f-fc03-3b1e-bc19-2240035b56c8",
                                        "glosses": [
                                            "The production or the condition of polarity.",
                                            "The production of polarized light; the direction in which the electric field of an electromagnetic wave points."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e89570c7-6766-479d-99dc-66c3b2dfa6f8",
                                                "sense_id": "6b622b52-7ee0-3e14-9d37-3c6dbb72cc08",
                                                "text": "We don’t usually notice polarization because direct sunlight and light from ordinary incandescent and fluorescent bulbs is unpolarized: it contains equal mixtures of horizontally and vertically polarized light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c5b0dfe-94a1-37f6-8c6b-d67dcfe11b48",
                                        "entry_id": "2c12b98f-fc03-3b1e-bc19-2240035b56c8",
                                        "glosses": [
                                            "The production or the condition of polarity.",
                                            "The separation of positive and negative charges in a nucleus, atom, molecule or system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a10b358-9c52-4abd-8270-d463821cbf2f",
                        "source_entry_id": "274daa64-9cd0-3d63-be51-53b3f86045b2",
                        "target_lang_word": "polarisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polarisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8aa6c5bb-1af6-391d-b80d-b74fd403f4cd",
                                        "entry_id": "6dbdd398-5bad-3f33-8e3a-0e97b36ffde3",
                                        "glosses": [
                                            "État particulier de la lumière qui rend sa propagation dépendante de l’orientation d’un milieu anisotrope qu’elle traverse."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18e4b3f5-dab9-4a8f-b279-94585e28985b",
                                                "sense_id": "8aa6c5bb-1af6-391d-b80d-b74fd403f4cd",
                                                "text": "Lorsque, le 2 février 1903, M. Blondlot, professeur de physique à la Faculté des Sciences de l'Université de Nancy, membre correspondant de l'Académie des Sciences, adressait à cette académie une note sur la polarisation des rayons X, considérés jusque-là comme impolarisables, qui donc eût pu prévoir que cette petite question de physique pure allait soulever des problèmes passionnants et des controverses […]."
                                            },
                                            {
                                                "example_id": "20da8566-caee-4249-956d-52eab8f9682a",
                                                "sense_id": "8aa6c5bb-1af6-391d-b80d-b74fd403f4cd",
                                                "text": "La teinte de polarisation reste dans les noirs bleutés lorsque les fibres sont entre-croisées, et monte jusqu'à des couleurs chaudron lorsqu'elles sont parallèles."
                                            },
                                            {
                                                "example_id": "f7019512-d312-4009-a014-dd7850297e30",
                                                "sense_id": "8aa6c5bb-1af6-391d-b80d-b74fd403f4cd",
                                                "text": "teinte de polarisation = palette de couleurs obtenue lors de l'observation d'un minéral en lumière polarisée. L'échelle des couleurs est divisée en ordres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04856fbe-0631-3731-85ca-7b6e24ad4a73",
                                        "entry_id": "6dbdd398-5bad-3f33-8e3a-0e97b36ffde3",
                                        "glosses": [
                                            "État particulier d’une onde électromagnétique qui se caractérise par une orientation privilégiée de l’oscillation transversale de l’onde."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8178059-de2d-3463-bf63-d4aa5594e60d",
                                        "entry_id": "6dbdd398-5bad-3f33-8e3a-0e97b36ffde3",
                                        "glosses": [
                                            "Création d’un dipôle électrique, d’une différence de potentiel."
                                        ],
                                        "tags": [
                                            "Magnétisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "265e5c0e-41b6-4b03-ae86-bc521f9e2cc3",
                                                "sense_id": "b8178059-de2d-3463-bf63-d4aa5594e60d",
                                                "text": "— Ainsi le neurone présente une polarisation fonctionnelle : la circulation des informations y est unidirectionnelle, cellulipète dans les dendrites et cellulifuge dans l'axone."
                                            },
                                            {
                                                "example_id": "517b6110-0c9d-4e3a-8f94-69b2e37816da",
                                                "sense_id": "b8178059-de2d-3463-bf63-d4aa5594e60d",
                                                "text": "Polarisation d’un diélectrique : création de dipôles électriques au niveau microscopique en présence d’un champ magnétique, ce qui produit un champ électrique."
                                            },
                                            {
                                                "example_id": "f7415077-3a31-4ee8-8eb1-a6661166400d",
                                                "sense_id": "b8178059-de2d-3463-bf63-d4aa5594e60d",
                                                "text": "Polarisation des électrodes : apparition d’une différence de potentiel contraire à la force électromotrice d’un électrolyseur ou d’une pile qui en abaisse l’efficacité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "609c6f53-ee16-3620-9f95-66e33c50b456",
                                        "entry_id": "6dbdd398-5bad-3f33-8e3a-0e97b36ffde3",
                                        "glosses": [
                                            "Décalage de la valeur d’une grandeur par rapport à une valeur de référence, effectué en vue de fixer les conditions de fonctionnement d’un système."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c12059fc-cf5f-38ec-abff-b5e8aff0c8e7",
                                        "entry_id": "6dbdd398-5bad-3f33-8e3a-0e97b36ffde3",
                                        "glosses": [
                                            "Dans le cas d’une antenne, caractéristique traduisant son adaptation à l'orientation du champ électrique de l'onde reçue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a04c881-c77d-3a9c-92d3-7977fc75e630",
                                        "entry_id": "6dbdd398-5bad-3f33-8e3a-0e97b36ffde3",
                                        "glosses": [
                                            "Clivage prononcé entre deux visions ou options politiques."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0618575-ff50-4355-bb74-340e6ca16044",
                                                "sense_id": "3a04c881-c77d-3a9c-92d3-7977fc75e630",
                                                "text": "Dans les semaines précédant le dernier référendum sur la souveraineté, on assista à une polarisation politique exceptionnelle. Emportés par une dynamique quasiment irrésistible, tous les acteurs politiques québécois furent amenés à « choisir leur camp »."
                                            },
                                            {
                                                "example_id": "e9748060-6070-4792-af2e-e1d3fd579911",
                                                "sense_id": "3a04c881-c77d-3a9c-92d3-7977fc75e630",
                                                "text": "Si un politicien comme Donald Trump n’a pas son équivalent dans l’histoire, la polarisation ne devrait pas nous étonner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
