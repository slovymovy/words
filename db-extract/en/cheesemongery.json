                    {
                        "sense_id": "a44b3d65-1459-39c2-abf9-54e445664076",
                        "entry_id": "50e5b85f-153c-36e6-a63b-601c1898aa64",
                        "glosses": [
                            "Cheese and/or butter sold by a cheesemonger."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5db7cf3b-2144-41b1-8a56-e9b88977e3a9",
                                "sense_id": "a44b3d65-1459-39c2-abf9-54e445664076",
                                "text": "She had never been into these crowded streets alone before, and, dazzled by the glittering shop-windows, and confused by the headlong throng and seemingly interminable confusion of their traffic, got herself into continual scrapes by running against the different people she met, receiving such sarcastic admonitions in return as, 'That's your way, my darling,' accompanied by a smart shove from a young gentleman, with a round wooden tray of fresh butter and other cheesemongeries on his head, which she had nearly overturned in the concussion;"
                            },
                            {
                                "example_id": "225f14d7-1a92-4813-b55f-669b8ee6002a",
                                "sense_id": "a44b3d65-1459-39c2-abf9-54e445664076",
                                "text": "I observe spices, sugar, all sorts of groceries, all sorts of cheesemongery, all sorts of tinned provisions"
                            },
                            {
                                "example_id": "cda42be3-e199-435a-a92b-2b8c37089186",
                                "sense_id": "a44b3d65-1459-39c2-abf9-54e445664076",
                                "text": "Supply of meat, cheesemongery, flour, grocery, poultry, drugs, disinfectants, clothing, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea9c7ca3-b7fd-3a69-b941-8afb510e77f0",
                        "entry_id": "50e5b85f-153c-36e6-a63b-601c1898aa64",
                        "glosses": [
                            "The building where a cheesemonger sells dairy goods."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "69b5f743-be3d-4736-a2e8-e795725e505e",
                                "sense_id": "ea9c7ca3-b7fd-3a69-b941-8afb510e77f0",
                                "text": "Here are two tripe-shops, a few considerable cheesemongeries, and one medicinal herb-shop."
                            },
                            {
                                "example_id": "d33eee90-271d-4d73-a40c-a866ac4d7759",
                                "sense_id": "ea9c7ca3-b7fd-3a69-b941-8afb510e77f0",
                                "text": "We stretched the cord across pine forests [ocotales] up to the old cheesemongery of Tranquilino, at a distance of 30 cords, where we erected a stone marker."
                            },
                            {
                                "example_id": "9cb8a474-fff3-4d94-9a0a-ce4738f0b432",
                                "sense_id": "ea9c7ca3-b7fd-3a69-b941-8afb510e77f0",
                                "text": "William Small's cheesemongery can be seen in the valley below."
                            }
                        ]
                    },
                    {
                        "sense_id": "521633e7-7d99-330a-a730-dfc42ae058a7",
                        "entry_id": "50e5b85f-153c-36e6-a63b-601c1898aa64",
                        "glosses": [
                            "The work of a cheesemonger; the selling of cheese."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6cc8a197-b51c-4db0-95ca-a8a173cb0d14",
                                "sense_id": "521633e7-7d99-330a-a730-dfc42ae058a7",
                                "text": "WANTED an Apprentice in the Grocery and Cheesemongery business, a Youth of 16 years of age of good disposition, active, and wishing to oblige, and willing to attend the regulation of a Dissenting family, on week and sabbath days;"
                            },
                            {
                                "example_id": "8c7386eb-1a33-4ef9-b0ad-06422495ee70",
                                "sense_id": "521633e7-7d99-330a-a730-dfc42ae058a7",
                                "text": "Mr. Tuggs attended to the grocery department; Mrs. Tuggs to the cheesemongery; and Miss Tuggs to her education."
                            },
                            {
                                "example_id": "917d71e7-85be-4871-8293-f11c45f314be",
                                "sense_id": "521633e7-7d99-330a-a730-dfc42ae058a7",
                                "text": "I was doing tolerably well in the cheesemongery line, and was paying my way, which is something in these hard times."
                            }
                        ]
                    }
