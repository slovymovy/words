                "senses": [
                    {
                        "sense_id": "3ab87dc8-c414-32e8-9228-c8170c71daea",
                        "entry_id": "d4b8fad8-d5d2-3e60-ac89-24472b781d07",
                        "glosses": [
                            "Composé organique de la famille des aldéhydes et dont la molécule se compose de 2 atomes d'hydrogène, 1 de carbone et 1 d'oxygène, il est utilisé comme désinfectant, conservateur et surtout pour la production de polymères et autres produits chimiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b896411-1d35-4672-88eb-960bcfa92556",
                                "sense_id": "3ab87dc8-c414-32e8-9228-c8170c71daea",
                                "text": "Le méthanal a été classé en juin 2004 comme « cancérigène certain » par le Centre international de recherche sur le cancer (CIRC)."
                            },
                            {
                                "example_id": "133f9940-96b1-45be-a426-b15d18012557",
                                "sense_id": "3ab87dc8-c414-32e8-9228-c8170c71daea",
                                "text": "La seule exception est le méthanal où le groupe carbonyle est associé à deux hydrogènes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
