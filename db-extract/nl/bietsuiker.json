                                        "sense_id": "2f02a911-208f-3e1b-af81-8a5f8c8d92bb",
                                        "entry_id": "f4d19859-fb67-39d6-8c32-535a247e314d",
                                        "glosses": [
                                            "Sugar made from sugar beet as opposed to sugar cane."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abe2436e-c00d-495d-b737-a4744f7a558f",
                                                "sense_id": "2f02a911-208f-3e1b-af81-8a5f8c8d92bb",
                                                "text": "Holonym: sugar beet"
                                            },
                                            {
                                                "example_id": "8509b2df-ff18-4d75-acbb-e67e0ee3af9b",
                                                "sense_id": "2f02a911-208f-3e1b-af81-8a5f8c8d92bb",
                                                "text": "Honey, maple sirup or sugar, molasses, and various commercial sirups can well be used in the place of cane or beet sugar. All these substitutes for cane or beet sugar are good for certain uses. Skillful combination of two or more of them will often produce the desired sweetness without the flavor of any one of them being too pronounced. For example, when honey is combined with corn sirup, the mixture is sweeter than corn sirup alone and the pronounced flavor of the honey is modified. During the sugar shortage, confections made of sweets other than cane or beet sugar should be used, and they should take the place of a sweet dessert instead of being eaten in addition to other sweet foods."
                                            }
