                ],
                "senses": [
                    {
                        "sense_id": "a7a50d4a-cdab-32fb-be39-55973755e0ee",
                        "entry_id": "402b9382-9c8b-36cb-9204-715ffa5167e2",
                        "glosses": [
                            "Intolérance au lactose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2461fd2-dfc9-484d-80bd-8920253721f0",
                                "sense_id": "a7a50d4a-cdab-32fb-be39-55973755e0ee",
                                "text": "Wegen seiner Laktoseintoleranz musste er die ihm angebotene Milch ablehnen.",
                                "translation": "À cause de son intolérance au lactose, il a dû refuser le lait qu’il s’est vu proposer."
                            },
                            {
                                "example_id": "13aa5069-077a-4a0c-8c12-c273ee3cca85",
                                "sense_id": "a7a50d4a-cdab-32fb-be39-55973755e0ee",
                                "text": "Bei der Laktoseintoleranz wird das Verdauungsenzym Laktase nicht oder nur ungenügend produziert. Dies führt zu Blähungen, Durchfall oder Bauchschmerzen.",
                                "translation": "Dans le cas de l’intolérance au lactose, l’enzyme digestive lactase n’est pas produite ou seulement en quantité insuffisante. Cela provoque des ballonnements, des diarrhées ou des douleurs abdominales."
                            }
                        ]
                    }
                ],
