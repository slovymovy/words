                                        "sense_id": "56715ebb-6219-3846-ad41-da291cc39bf0",
                                        "entry_id": "f44debf6-9cd9-386c-92fb-861ed156ad6b",
                                        "glosses": [
                                            "Disturbance or disruption."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f654cddf-975d-4b22-8ad9-e1b8db7606e4",
                                                "sense_id": "56715ebb-6219-3846-ad41-da291cc39bf0",
                                                "text": "My late arrival caused the professor considerable upset."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "019a6333-8682-33bd-856b-7f1fad434f63",
                                        "entry_id": "f44debf6-9cd9-386c-92fb-861ed156ad6b",
                                        "glosses": [
                                            "An unexpected victory of a competitor or candidate that was not favored to win."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b11a1dad-3725-4935-90ea-48475695ae46",
                                                "sense_id": "019a6333-8682-33bd-856b-7f1fad434f63",
                                                "text": "But it is probably the biggest upset for the away side since Ronnie Radford smashed a famous goal as Hereford defeated Newcastle 2-1 in 1972."
                                            },
                                            {
                                                "example_id": "b3abf7fe-cf52-43c3-80c2-288744d4b43c",
                                                "sense_id": "019a6333-8682-33bd-856b-7f1fad434f63",
                                                "text": "Sanders’s win in Michigan was one of the greatest upsets in modern political history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f224d80-f02b-39a3-bc36-352db0be312f",
                                        "entry_id": "f44debf6-9cd9-386c-92fb-861ed156ad6b",
                                        "glosses": [
                                            "An overturn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13deeb85-7ca3-4015-95c8-7218ce890c80",
                                                "sense_id": "6f224d80-f02b-39a3-bc36-352db0be312f",
                                                "text": "\"collision and upset\": impact with another object or an overturn for whatever reason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e0397b1-328a-3832-9a64-e7e4ecfd6ea6",
                                        "entry_id": "f44debf6-9cd9-386c-92fb-861ed156ad6b",
                                        "glosses": [
                                            "An upset stomach."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10d1555b-0d87-4427-9d10-4f4e1b52d12c",
                                                "sense_id": "5e0397b1-328a-3832-9a64-e7e4ecfd6ea6",
                                                "text": "“Bob, let's cancel the baby sitter. With this upset stomach, I can't go out tonight.”\n“Sure you can, Liz! Try Pepto-Bismol. Hospital tests prove it relieves upsets. And it's great for indigestion or nausea, too!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daa3fe95-c02f-36f9-ab93-3fc43fd56d1c",
                                        "entry_id": "f44debf6-9cd9-386c-92fb-861ed156ad6b",
                                        "glosses": [
                                            "An upper set; a subset (X,≤) of a partially ordered set with the property that, if x is in U and x≤y, then y is in U."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8d21665-3dfa-3ed0-b5b6-3ea9f5aef4cf",
                                        "entry_id": "f44debf6-9cd9-386c-92fb-861ed156ad6b",
                                        "glosses": [
                                            "The dangerous situation where the flight attitude or airspeed of an aircraft is outside the designed bounds of operation, possibly resulting in loss of control."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a0c2357-318a-4810-8969-d93b7b8bc4f2",
                                                "sense_id": "d8d21665-3dfa-3ed0-b5b6-3ea9f5aef4cf",
                                                "text": "The Board determines that the probable cause of this accident was the unfavorable interaction of severe vertical air drafts and large longitudinal control displacements resulting in a longitudinal upset from which a successful recovery was not made."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9df9a4d3-e8ad-35c9-9789-d13e5aeb193b",
                                        "entry_id": "f44debf6-9cd9-386c-92fb-861ed156ad6b",
                                        "glosses": [
                                            "A woven row supporting the foundation rods for the uprights of a basket."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b08fa13e-eb29-439c-b148-ee911bd68f2f",
                                                "sense_id": "9df9a4d3-e8ad-35c9-9789-d13e5aeb193b",
                                                "text": "Willow basket making, an artisan inserting bye-stakes in the upsets."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "upset",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65045610-4e53-36b0-9465-5b63fb9b7cb4",
                                        "entry_id": "04663a68-a9bb-322d-8c22-3e12f4c390fd",
                                        "glosses": [
                                            "Angry, distressed, or unhappy."
                                        ],
                                        "tags": [
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd4d62b0-0f85-40a6-8856-5f54f740408e",
                                                "sense_id": "65045610-4e53-36b0-9465-5b63fb9b7cb4",
                                                "text": "He was upset when she refused his friendship."
                                            },
                                            {
                                                "example_id": "80db85e1-23b5-4558-b84c-639ddc3d6fde",
                                                "sense_id": "65045610-4e53-36b0-9465-5b63fb9b7cb4",
                                                "text": "My children often get upset with their classmates."
                                            },
                                            {
                                                "example_id": "db0e7000-715c-4e8c-b63e-e727be0f13f3",
                                                "sense_id": "65045610-4e53-36b0-9465-5b63fb9b7cb4",
                                                "text": "We were shocked when we asked a disruptive man in the front row to move to the back, and when he subsequently left, the producer's helpers were so upset for him they gave him two free tickets to the next 'women's music' production."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "439900e5-3d04-364b-a516-027c90b7e43c",
                                        "entry_id": "04663a68-a9bb-322d-8c22-3e12f4c390fd",
                                        "glosses": [
                                            "Feeling unwell, nauseated, or ready to vomit."
                                        ],
                                        "tags": [
                                            "of a stomach or gastrointestinal tract"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d5dece0-5cda-4af5-80fb-66baea5b884a",
                                                "sense_id": "439900e5-3d04-364b-a516-027c90b7e43c",
                                                "text": "His stomach was upset, so he didn't want to move."
                                            },
                                            {
                                                "example_id": "fdcf4340-d928-46c4-92c2-09d61ab33336",
                                                "sense_id": "439900e5-3d04-364b-a516-027c90b7e43c",
                                                "text": "Bryan came home from school with an upset tummy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "upset",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92cd8d1b-951b-33c1-a5be-6aafd0e7a174",
