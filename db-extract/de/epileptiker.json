                                "target_senses": [
                                    {
                                        "sense_id": "11bdf900-772b-3311-a9ed-454dcab37d00",
                                        "entry_id": "1df7acdb-59ce-39b9-8940-c980479d1de3",
                                        "glosses": [
                                            "A person who has epilepsy."
                                        ],
                                        "tags": [],
                                        "examples": [
