                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fe3c082-4402-42bc-a2e4-bd3f5dac5645",
                                "sense_id": "b437e18d-00c6-3b2f-bb06-3ee2ad089f90",
                                "text": "Der Vorturner meisterte die Sportübungen bravourös."
                            },
                            {
                                "example_id": "905c9bfc-4604-411c-bf2f-8a16676cbcc7",
                                "sense_id": "b437e18d-00c6-3b2f-bb06-3ee2ad089f90",
                                "text": "Als Benecke bereits im Jahr 1819 wieder nach Berlin ging, zählte die Turnerschaft immerhin bereits 140 Mitglieder in acht Riegen, die jeweils über zwei oder drei Vorturner verfügten."
                            },
                            {
                                "example_id": "3ad86fad-f8f3-4308-82df-1275a0f98acf",
                                "sense_id": "b437e18d-00c6-3b2f-bb06-3ee2ad089f90",
                                "text": "In Unternehmen werden die Führungskräfte eher abfällig bzw. geringschätzig mit „Vorturner“ bezeichnet."
                            }
                        ],
