                    "frequency": "High",
                    "semantic_group_id": "separation_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De brede rivier <w>scheidt</w> de twee dorpen van elkaar.",
                            "target_lang_translations": {
                                "en": "The wide river <w>separates</w> the two villages from each other.",
                                "ru": "Широкая река <w>разделяет</w> две деревни друг от друга.",
                                "pl": "Szeroka rzeka <w>dzieli</w> te dwie wioski od siebie.",
                                "de": "Der breite Fluss <w>trennt</w> die beiden Dörfer voneinander.",
                                "fr": "Le large fleuve <w>sépare</w> les deux villages l'un de l'autre.",
                                "it": "Il largo fiume <w>separa</w> i due villaggi l'uno dall'altro.",
                                "cs": "Široká řeka od sebe obě vesnice <w>odděluje</w>.",
                                "tr": "Geniş nehir iki köyü birbirinden <w>ayırıyor</w>.",
                                "es": "El ancho río <w>separa</w> los dos pueblos entre sí."
                            }
                        },
                        {
                            "text": "Je moet thuis het afval goed <w>scheiden</w> voor recycling.",
                            "target_lang_translations": {
                                "en": "You must <w>separate</w> waste properly at home for recycling.",
                                "ru": "Дома нужно тщательно <w>сортировать</w> мусор для переработки.",
                                "pl": "W domu musisz odpowiednio <w>segregować</w> odpady do recyklingu.",
                                "de": "Man muss den Müll zu Hause für das Recycling gut <w>trennen</w>.",
                                "fr": "Il faut bien <w>trier</w> les déchets à la maison pour le recyclage.",
                                "it": "A casa devi <w>differenziare</w> bene i rifiuti per il riciclaggio.",
                                "cs": "Doma musíte odpad správně <w>třídit</w> pro recyklaci.",
                                "tr": "Geri dönüşüm için evde çöpleri iyi <w>ayrıştırmalısın</w>.",
                                "es": "En casa debes <w>separar</w> bien los residuos para el reciclaje."
                            }
                        }
