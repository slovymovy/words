                "senses": [
                    {
                        "sense_id": "40e453d7-7d18-3a42-a01f-ff6c7d594113",
                        "entry_id": "9498b92b-d4e9-3484-8675-0c3db99b6b23",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57f4e2bf-96f3-4b3d-ae61-2cec33d70907",
                                "sense_id": "40e453d7-7d18-3a42-a01f-ff6c7d594113",
                                "text": "Frau Vogelgsang ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b8731f24-da33-43d8-81eb-68cdc90585b2",
                                "sense_id": "40e453d7-7d18-3a42-a01f-ff6c7d594113",
                                "text": "Herr Vogelgsang wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "326bb188-84c7-43b8-87eb-976693abb3a3",
                                "sense_id": "40e453d7-7d18-3a42-a01f-ff6c7d594113",
                                "text": "Die Vogelgsangs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d25a4e47-42d2-4782-bbbe-c0bc645142cf",
                                "sense_id": "40e453d7-7d18-3a42-a01f-ff6c7d594113",
                                "text": "Der Vogelgsang trägt nie die Schals, die die Vogelgsang ihm strickt."
                            },
                            {
                                "example_id": "ffaf7ba1-3d76-492f-9c05-bc535309ee49",
                                "sense_id": "40e453d7-7d18-3a42-a01f-ff6c7d594113",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Vogelgsang kommt, geht der Herr Ullrich.“"
                            },
                            {
                                "example_id": "27957f0a-ff86-4c97-bae9-2a9eb8f46929",
                                "sense_id": "40e453d7-7d18-3a42-a01f-ff6c7d594113",
                                "text": "Vogelgsang kommt und geht."
                            },
                            {
                                "example_id": "433cdeec-bd53-46d3-a6be-7e6c6cb56010",
                                "sense_id": "40e453d7-7d18-3a42-a01f-ff6c7d594113",
                                "text": "Vogelgsangs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
