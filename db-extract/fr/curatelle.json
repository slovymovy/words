                ],
                "senses": [
                    {
                        "sense_id": "86eef985-129c-30db-9b61-7f2e64b5b2f9",
                        "entry_id": "d2b34f2c-e973-3ec5-b7ce-03a75f966445",
                        "glosses": [
                            "Pouvoir et charge de curateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cc7bbec-3ca3-4b59-b1ce-f33e16e8f3b1",
                                "sense_id": "86eef985-129c-30db-9b61-7f2e64b5b2f9",
                                "text": "La curatelle est prononcée pour une durée maximale de cinq ans lors de sa mise en place."
                            },
                            {
                                "example_id": "401a9a53-c446-4b75-b147-1f68994f32b8",
                                "sense_id": "86eef985-129c-30db-9b61-7f2e64b5b2f9",
                                "text": "On lui donna la curatelle de cette succession."
                            },
                            {
                                "example_id": "f82bcca9-180e-4236-b92e-e016ce8e3f58",
                                "sense_id": "86eef985-129c-30db-9b61-7f2e64b5b2f9",
                                "text": "Il est encore en curatelle."
                            },
                            {
                                "example_id": "d1e51cd2-ae27-4859-8fba-ff1d11f813c1",
                                "sense_id": "86eef985-129c-30db-9b61-7f2e64b5b2f9",
                                "text": "Il est sous la curatelle d’un tel."
                            },
                            {
                                "example_id": "a5e482e5-889b-4b37-96cf-5f412f678d6c",
                                "sense_id": "86eef985-129c-30db-9b61-7f2e64b5b2f9",
                                "text": "Il s’est fait décharger de cette curatelle."
                            }
                        ]
                    }
                ],
                "translations": [
