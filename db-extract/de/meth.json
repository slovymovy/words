                        ],
                        "examples": [
                            {
                                "example_id": "a3bbfd10-db76-4ae8-b0c3-a5a2abf2d623",
                                "sense_id": "cdde96b4-f626-3593-857c-c3fca76c12f6",
                                "text": "„Eine halbe Stunde nach seiner unerfreulichen Begegnung mit den drei Möchtegerngangstern auf der 8th Street SE hatte Court einen Drogendeal, Heroin oder Meth, hinter einer Tankstelle an der Savannah Avenue beobachtet.“"
                            },
                            {
                                "example_id": "f612112a-164c-4560-9012-d679965a31f2",
                                "sense_id": "cdde96b4-f626-3593-857c-c3fca76c12f6",
                                "text": "„Gemeinsam mit einheimischen Kriminellen überschwemmte die Firma die betreffenden Stadtviertel mit nahezu kostenlosen Opioiden, Fentanyl und Meth.“"
                            },
                            {
                                "example_id": "91925d40-4d91-4500-b1f5-42929231cb84",
                                "sense_id": "cdde96b4-f626-3593-857c-c3fca76c12f6",
                                "text": "„Als ich ins Revier zurückkehre, bin ich vom Koffein leicht aufgedreht, während im vierten Stock alle wirken, als wären sie auf Meth.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
