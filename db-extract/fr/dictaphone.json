                "senses": [
                    {
                        "sense_id": "cf64f7e2-6f8b-3855-a5a8-47ea806ee49a",
                        "entry_id": "7873c06e-ef53-341e-a183-d32f42c85082",
                        "glosses": [
                            "Appareil de bureau inventé dans les années 1960 pour pouvoir dicter du courrier sans avoir recours à la présence d’une sténo. Les bandes (en forme de manchon), puis les disquettes ou les minis cassettes étaient transmises au \\\"pool dactylo\\\" ou au secrétariat pour la frappe."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "486e0351-692e-3172-a72f-44d52ed6af72",
                        "entry_id": "7873c06e-ef53-341e-a183-d32f42c85082",
                        "glosses": [
                            "(aujourd'hui) Appareil d’enregistrement du son, de très petite taille et facilement transportable, utilisé pour dicter le courrier et la prise de notes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "424ad00f-84c5-4419-b9c0-844e938e9156",
                                "sense_id": "486e0351-692e-3172-a72f-44d52ed6af72",
                                "text": "Mais les dictaphones, c’est pour les vrais journalistes, ceux dont les articles sont publiés !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b82a4d3e-bd19-4c52-826c-c2d291534b3a",
                        "source_entry_id": "7873c06e-ef53-341e-a183-d32f42c85082",
                        "target_lang_word": "Diktiergerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diktiergerät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbbd8bd6-4a83-382d-b56a-7f5844df038d",
                                        "entry_id": "8a1ef1fb-bc4e-3d88-a47e-07e102b3a918",
                                        "glosses": [
                                            "Gerät zum Aufsprechen und Abhören von Text"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ac57b66-287a-4a54-8a02-3fcd2ca7d99c",
                                                "sense_id": "cbbd8bd6-4a83-382d-b56a-7f5844df038d",
                                                "text": "Der Bauleiter ging durch den Rohbau und hielt sämtliche Mängel auf seinem Diktiergerät fest."
                                            },
                                            {
                                                "example_id": "b9793e11-6ab1-4c60-a87c-3793f843611c",
                                                "sense_id": "cbbd8bd6-4a83-382d-b56a-7f5844df038d",
                                                "text": "Chef, Ihr Diktiergerät muss defekt sein, auf dem Band ist nur ein Rauschen zu hören!"
                                            },
                                            {
                                                "example_id": "1bcbd725-e2c1-407b-8301-3ad9082eb1e1",
                                                "sense_id": "cbbd8bd6-4a83-382d-b56a-7f5844df038d",
                                                "text": "„Jeder Befund wird außerdem vom Obduzenten auf ein Diktiergerät gesprochen.“"
                                            },
                                            {
                                                "example_id": "a9d96c34-a852-4d04-90ee-ab1853854254",
                                                "sense_id": "cbbd8bd6-4a83-382d-b56a-7f5844df038d",
                                                "text": "„Er horchte nach, ob das Diktiergerät noch lief, musste sichergehen, dass das Geständnis aufgezeichnet wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
