{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "44d5dfbd-dab9-33cb-9d7c-dccdc63e4251",
                    "sense_definition": "A residential area where a large number of houses or apartments have been built together in a planned way, often by the government.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "land_areas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She grew up on a large council <w>estate</w> in London.",
                            "target_lang_translations": {
                                "ru": "Она выросла в большом муниципальном <w>жилом массиве</w> в Лондоне.",
                                "zh": "她在伦敦的一个大型政府<w>住宅区</w>长大。"
                            }
                        },
                        {
                            "text": "The children played football in the park near the housing <w>estate</w>.",
                            "target_lang_translations": {
                                "ru": "Дети играли в футбол в парке рядом с <w>жилым комплексом</w>.",
                                "zh": "孩子们在<w>住宅区</w>附近的公园里踢足球。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "housing estate",
                        "council estate",
                        "industrial estate",
                        "trading estate"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жилой район с плановой застройкой, часто состоящий из однотипных домов или квартир (особенно муниципального жилья).",
                        "zh": "由政府或机构统一规划建设的住宅区，通常包含大量公寓或房屋。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жилой массив",
                                "target_lang_sense_clarification": "район плотной застройки"
                            },
                            {
                                "target_lang_word": "микрорайон",
                                "target_lang_sense_clarification": "административно-территориальная единица жилой застройки"
                            },
                            {
                                "target_lang_word": "жилой комплекс",
                                "target_lang_sense_clarification": "группа жилых домов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "住宅区",
                                "target_lang_sense_clarification": "规划建设的居住区域"
                            },
                            {
                                "target_lang_word": "居住小区",
                                "target_lang_sense_clarification": "城市中成片的住宅区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e2daede-e24e-39a0-9713-881eba5b4dc9",
                    "sense_definition": "A large area of land in the country, usually with a large house, owned by one person, family, or organization.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "land_areas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family owns a vast <w>estate</w> in the north of Scotland.",
                            "target_lang_translations": {
                                "ru": "Семья владеет огромным <w>поместьем</w> на севере Шотландии.",
                                "zh": "这个家族在苏格兰北部拥有一座广阔的<w>庄园</w>。"
                            }
                        },
                        {
                            "text": "They spent the weekend walking around the grounds of the country <w>estate</w>.",
                            "target_lang_translations": {
                                "ru": "Они провели выходные, гуляя по территории загородной <w>усадьбы</w>.",
                                "zh": "他们周末在乡村<w>庄园</w>的庭院里散步。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "country estate",
                        "private estate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой земельный участок с домом, обычно в сельской местности, принадлежащий одному владельцу.",
                        "zh": "位于乡村的大片土地，通常包含一座大型宅邸，归个人、家族或组织所有。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поместье",
                                "target_lang_sense_clarification": "земельное владение, обычно с усадьбой"
                            },
                            {
                                "target_lang_word": "имение",
                                "target_lang_sense_clarification": "земельное владение помещика"
                            },
                            {
                                "target_lang_word": "усадьба",
                                "target_lang_sense_clarification": "дом с прилегающими строениями и угодьями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "庄园",
                                "target_lang_sense_clarification": "拥有大片土地和宅邸的私人领地"
                            },
                            {
                                "target_lang_word": "地产",
                                "target_lang_sense_clarification": "指代大面积的土地所有权"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "796774d0-3ff7-3bc7-98c2-74ba6a9edbb7",
                    "sense_definition": "All the money, property, and assets owned by a person, especially considered as a whole after they die.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "assets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He left his entire <w>estate</w> to his three children.",
                            "target_lang_translations": {
                                "ru": "Он оставил всё своё <w>имущество</w> троим детям.",
                                "zh": "他将全部<w>遗产</w>留给了他的三个孩子。"
                            }
                        },
                        {
                            "text": "The lawyer is helping us manage the <w>estate</w> of my late grandfather.",
                            "target_lang_translations": {
                                "ru": "Юрист помогает нам управлять <w>наследством</w> моего покойного дедушки.",
                                "zh": "律师正在帮助我们处理我已故祖父的<w>遗产</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "real estate",
                        "personal estate",
                        "estate tax",
                        "estate agent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Всё имущество, активы и деньги, принадлежащие человеку, особенно рассматриваемые как наследство.",
                        "zh": "个人拥有的全部财产、资产和资金，尤指去世后留下的遗产。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "имущество",
                                "target_lang_sense_clarification": "собственность человека"
                            },
                            {
                                "target_lang_word": "наследство",
                                "target_lang_sense_clarification": "имущество, переходящее после смерти"
                            },
                            {
                                "target_lang_word": "состояние",
                                "target_lang_sense_clarification": "совокупность материальных благ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "遗产",
                                "target_lang_sense_clarification": "死者留下的财产"
                            },
                            {
                                "target_lang_word": "资产",
                                "target_lang_sense_clarification": "个人或机构拥有的财产总和"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93e90ec9-d735-32f0-b859-696b1f67e860",
                    "sense_definition": "A car with a large storage area behind the seats and a rear door that opens upwards.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought an <w>estate</w> because we need space for the dog.",
                            "target_lang_translations": {
                                "ru": "Мы купили <w>универсал</w>, потому что нам нужно место для собаки.",
                                "zh": "我们买了一辆<w>旅行车</w>，因为我们需要空间放狗。"
                            }
                        },
                        {
                            "text": "He loaded the luggage into the back of the <w>estate</w>.",
                            "target_lang_translations": {
                                "ru": "Он погрузил багаж в багажник <w>универсала</w>.",
                                "zh": "他把行李装进了<w>旅行车</w>的后部。"
                            }
                        }
                    ],
                    "synonyms": [
                        "station wagon",
                        "wagon",
                        "estate car"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Автомобиль с большим багажным отделением позади сидений и задней дверью, открывающейся вверх.",
                        "zh": "一种后部有宽大储物空间且后门向上开启的轿车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "универсал",
                                "target_lang_sense_clarification": "тип кузова автомобиля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "旅行车",
                                "target_lang_sense_clarification": "具有大后备箱的轿车车型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c3f6f65-cea2-3df9-90e2-6f9110cc613d",
                    "sense_definition": "A major social class or political group that historically had specific rights and powers, such as the clergy or nobility.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_class",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clergy was traditionally known as the First <w>Estate</w>.",
                            "target_lang_translations": {
                                "ru": "Духовенство традиционно называлось Первым <w>сословием</w>.",
                                "zh": "教士在传统上被称为第一<w>等级</w>。"
                            }
                        },
                        {
                            "text": "Representatives from the three <w>estates</w> gathered to advise the king.",
                            "target_lang_translations": {
                                "ru": "Представители трёх <w>сословий</w> собрались, чтобы дать совет королю.",
                                "zh": "来自三个<w>等级</w>的代表聚集在一起为国王提供建议。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Third Estate",
                        "Fourth Estate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Историческая социальная группа или класс, обладавший определёнными правами и обязанностями.",
                        "zh": "历史上具有特定权利和权力的主要社会阶层或政治团体，如教士或贵族。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сословие",
                                "target_lang_sense_clarification": "социальная группа в докапиталистическом обществе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "等级",
                                "target_lang_sense_clarification": "历史上的社会阶层"
                            },
                            {
                                "target_lang_word": "阶层",
                                "target_lang_sense_clarification": "社会地位的划分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32f3f7dd-1445-3bcf-9aaa-ed5d04a9ebcc",
                    "sense_definition": "The collective information technology resources and infrastructure owned by an organization.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "assets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is upgrading its entire IT <w>estate</w> to improve security.",
                            "target_lang_translations": {
                                "ru": "Компания модернизирует всю свою ИТ-<w>инфраструктуру</w> для повышения безопасности.",
                                "zh": "公司正在升级其整个<w>IT基础设施</w>以提高安全性。"
                            }
                        },
                        {
                            "text": "Managing a complex digital <w>estate</w> requires significant investment.",
                            "target_lang_translations": {
                                "ru": "Управление сложным цифровым <w>хозяйством</w> требует значительных инвестиций.",
                                "zh": "管理复杂的数字<w>资产</w>需要大量的投资。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business/technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность ресурсов информационных технологий и инфраструктуры, принадлежащих организации.",
                        "zh": "组织所拥有的信息技术资源和基础设施的集合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инфраструктура",
                                "target_lang_sense_clarification": "комплекс взаимосвязанных структур или объектов"
                            },
                            {
                                "target_lang_word": "парк оборудования",
                                "target_lang_sense_clarification": "совокупность технических средств"
                            },
                            {
                                "target_lang_word": "хозяйство",
                                "target_lang_sense_clarification": "в значении совокупности имущества и оборудования"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "IT基础设施",
                                "target_lang_sense_clarification": "组织内部的计算机资源系统"
                            },
                            {
                                "target_lang_word": "信息系统",
                                "target_lang_sense_clarification": "组织的技术资源集合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c2b5fdd-7d68-332c-94c7-54456517d03d",
                    "sense_definition": "A person's condition, status, or stage in life.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a man of low <w>estate</w> but high ambition.",
                            "target_lang_translations": {
                                "ru": "Он был человеком низкого <w>происхождения</w>, но больших амбиций.",
                                "zh": "他是一个出身<w>地位</w>卑微但志向远大的人。"
                            }
                        },
                        {
                            "text": "She sought to improve her <w>estate</w> through education and hard work.",
                            "target_lang_translations": {
                                "ru": "Она стремилась улучшить своё <w>положение</w> через образование и упорный труд.",
                                "zh": "她试图通过教育和努力工作来改善自己的<w>境遇</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "man's estate",
                        "low estate",
                        "high estate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Положение человека в обществе, статус или этап жизни (устаревшее или литературное).",
                        "zh": "一个人的社会地位、身份或人生阶段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "положение",
                                "target_lang_sense_clarification": "статус в обществе"
                            },
                            {
                                "target_lang_word": "состояние",
                                "target_lang_sense_clarification": "звание или социальный статус"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地位",
                                "target_lang_sense_clarification": "社会身份或阶级"
                            },
                            {
                                "target_lang_word": "境遇",
                                "target_lang_sense_clarification": "所处的状况或阶段"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "80882f05-8e22-3844-a5c7-31e87ba22d73",
                    "sense_definition": "Previously owned or secondhand, especially referring to high-quality items like jewelry sold from a person's assets.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "secondhand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She found a beautiful <w>estate</w> diamond ring at the auction.",
                            "target_lang_translations": {
                                "ru": "Она нашла на аукционе красивое <w>антикварное</w> кольцо с бриллиантом.",
                                "zh": "她在拍卖会上发现了一枚精美的<w>传世</w>钻戒。"
                            }
                        },
                        {
                            "text": "The shop specializes in fine <w>estate</w> jewelry and antiques.",
                            "target_lang_translations": {
                                "ru": "Магазин специализируется на изысканных <w>фамильных</w> драгоценностях и антиквариате.",
                                "zh": "这家店专门经营精美的<w>传世</w>珠宝和古董。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "estate jewelry",
                        "estate sale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к предметам (обычно драгоценностям), ранее находившимся в чьей-либо собственности, часто антикварным.",
                        "zh": "指二手或曾属于他人的高品质物品，常用于珠宝或古董。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фамильный",
                                "target_lang_sense_clarification": "передаваемый по наследству в семье"
                            },
                            {
                                "target_lang_word": "антикварный",
                                "target_lang_sense_clarification": "старинный и ценный"
                            },
                            {
                                "target_lang_word": "из частной коллекции",
                                "target_lang_sense_clarification": "ранее принадлежавший частному лицу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传世",
                                "target_lang_sense_clarification": "指代从前人手中流传下来的物品"
                            },
                            {
                                "target_lang_word": "二手",
                                "target_lang_sense_clarification": "非全新的物品"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9884d2ea-026f-3d4b-9436-b2df7b81b9f4",
                    "sense_definition": "To give an estate or property to someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "give",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy lord <w>estated</w> his loyal servant with a small farm.",
                            "target_lang_translations": {
                                "ru": "Богатый лорд <w>наделил</w> своего верного слугу небольшой фермой.",
                                "zh": "富有的领主<w>封赐</w>给他的忠诚仆人一个小农场。"
                            }
                        },
                        {
                            "text": "He was <w>estated</w> with lands in the western province.",
                            "target_lang_translations": {
                                "ru": "Он был <w>наделён поместьем</w> в западной провинции.",
                                "zh": "他被<w>授予</w>了西部省份的土地。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наделять кого-либо поместьем или землёй.",
                        "zh": "将土地或庄园授予某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наделять поместьем",
                                "target_lang_sense_clarification": "давать землю во владение"
                            },
                            {
                                "target_lang_word": "жаловать имением",
                                "target_lang_sense_clarification": "торжественно передавать владение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "封赐",
                                "target_lang_sense_clarification": "授予土地或爵位"
                            },
                            {
                                "target_lang_word": "授予",
                                "target_lang_sense_clarification": "给予财产所有权"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}