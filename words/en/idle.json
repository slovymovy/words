{
    "word_family": [
        "idleness",
        "idly",
        "idler"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5578b1c4-a6b4-3ac8-b096-ab028f8829e3",
                    "sense_definition": "Averse to work, labor, or physical effort; lazy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "laziness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>idle</w> student failed to complete his homework on time.",
                            "target_lang_translations": {
                                "ru": "<w>Ленивый</w> студент не смог вовремя закончить домашнее задание.",
                                "zh": "那个<w>懒惰的</w>学生没能按时完成作业。"
                            }
                        },
                        {
                            "text": "Don't be so <w>idle</w>; come and help us clean the garden.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>ленивым</w>; иди и помоги нам убраться в саду.",
                                "zh": "别那么<w>游手好闲</w>了，过来帮我们打扫花园。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lazy",
                        "slothful",
                        "indolent",
                        "work-shy",
                        "bone-idle"
                    ],
                    "antonyms": [
                        "industrious",
                        "hardworking",
                        "busy"
                    ],
                    "common_phrases": [
                        "idle hands",
                        "idle fellow",
                        "bone idle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не желающий работать или прилагать усилия; ленивый.",
                        "zh": "厌恶工作、劳动或体力活动；懒惰的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ленивый",
                                "target_lang_sense_clarification": "склонный к лени"
                            },
                            {
                                "target_lang_word": "праздный",
                                "target_lang_sense_clarification": "живущий без дела"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "懒惰的",
                                "target_lang_sense_clarification": "形容人懒散"
                            },
                            {
                                "target_lang_word": "游手好闲的",
                                "target_lang_sense_clarification": "形容人无所事事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bab5703-363f-3b0e-b470-0b4d83d545cb",
                    "sense_definition": "Not being used, occupied, or operating; inactive.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "inactivity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory machines have been <w>idle</w> since the company closed down.",
                            "target_lang_translations": {
                                "ru": "Заводские станки <w>простаивают</w> с тех пор, как компания закрылась.",
                                "zh": "自从公司倒闭后，工厂的机器就一直处于<w>闲置</w>状态。"
                            }
                        },
                        {
                            "text": "He didn't know what to do with his <w>idle</w> money, so he invested it.",
                            "target_lang_translations": {
                                "ru": "Он не знал, что делать со своими <w>свободными</w> деньгами, поэтому инвестировал их.",
                                "zh": "他不知道该怎么处理这些<w>闲置</w>资金，于是就把它们投资了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inactive",
                        "unused",
                        "disused",
                        "dormant"
                    ],
                    "antonyms": [
                        "active",
                        "operational",
                        "busy"
                    ],
                    "common_phrases": [
                        "idle hours",
                        "lie idle",
                        "stand idle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не используемый, не занятый или не работающий; бездействующий.",
                        "zh": "未被使用、占用或运行；不活动的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бездействующий",
                                "target_lang_sense_clarification": "неактивный"
                            },
                            {
                                "target_lang_word": "простаивающий",
                                "target_lang_sense_clarification": "о технике или предприятиях"
                            },
                            {
                                "target_lang_word": "свободный",
                                "target_lang_sense_clarification": "о деньгах или ресурсах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闲置的",
                                "target_lang_sense_clarification": "指物品或设备未被使用"
                            },
                            {
                                "target_lang_word": "停滞的",
                                "target_lang_sense_clarification": "指状态不活跃"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a77a1cc2-6c2e-3c4c-a7a8-e34e27914657",
                    "sense_definition": "Not engaged in any occupation or employment; unemployed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inactivity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hundreds of <w>idle</w> workers gathered outside the gates hoping for news.",
                            "target_lang_translations": {
                                "ru": "Сотни <w>незанятых</w> рабочих собрались у ворот в надежде на новости.",
                                "zh": "数百名<w>失业</w>工人聚集在门口，希望能得到消息。"
                            }
                        },
                        {
                            "text": "She felt frustrated being <w>idle</w> for so long after losing her job.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала разочарование, оставаясь <w>без работы</w> так долго после увольнения.",
                                "zh": "失业这么久一直<w>闲着</w>，她感到很沮丧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unemployed",
                        "jobless",
                        "out of work"
                    ],
                    "antonyms": [
                        "employed"
                    ],
                    "common_phrases": [
                        "idle workers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий работы или занятости; безработный.",
                        "zh": "没有从事任何职业或工作；失业的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незанятый",
                                "target_lang_sense_clarification": "не имеющий дела"
                            },
                            {
                                "target_lang_word": "безработный",
                                "target_lang_sense_clarification": "не трудоустроенный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失业的",
                                "target_lang_sense_clarification": "没有工作"
                            },
                            {
                                "target_lang_word": "闲散的",
                                "target_lang_sense_clarification": "没有固定职业"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6f024de-82e6-3022-aa8b-5ec483d394df",
                    "sense_definition": "Without foundation, serious purpose, or effect; pointless or trivial.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "triviality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was just <w>idle</w> chatter, so I didn't pay much attention to it.",
                            "target_lang_translations": {
                                "ru": "Это была просто <w>пустая</w> болтовня, поэтому я не обратил на нее особого внимания.",
                                "zh": "那不过是<w>无聊的</w>闲聊，所以我没太在意。"
                            }
                        },
                        {
                            "text": "He made an <w>idle</w> threat to quit, but everyone knew he wouldn't leave.",
                            "target_lang_translations": {
                                "ru": "Он высказал <w>пустую</w> угрозу уволиться, но все знали, что он не уйдет.",
                                "zh": "他发出了<w>空洞的</w>辞职威胁，但大家都知道他不会走。"
                            }
                        }
                    ],
                    "synonyms": [
                        "baseless",
                        "vain",
                        "trivial",
                        "pointless",
                        "futile",
                        "unfounded"
                    ],
                    "antonyms": [
                        "serious",
                        "meaningful"
                    ],
                    "common_phrases": [
                        "idle threat",
                        "idle gossip",
                        "idle speculation",
                        "idle curiosity",
                        "idle talk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий основания, серьезной цели или эффекта; бессмысленный или пустой.",
                        "zh": "没有根据、严肃目的或效果；无意义或琐碎的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "бессодержательный (о разговорах)"
                            },
                            {
                                "target_lang_word": "праздный",
                                "target_lang_sense_clarification": "бесцельный (о любопытстве)"
                            },
                            {
                                "target_lang_word": "беспочвенный",
                                "target_lang_sense_clarification": "необоснованный (об угрозах)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无聊的",
                                "target_lang_sense_clarification": "指谈话或行为空洞"
                            },
                            {
                                "target_lang_word": "空洞的",
                                "target_lang_sense_clarification": "指威胁或言论没有实质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db7e693f-fc14-39be-a2b7-6cdef812b21c",
                    "sense_definition": "Empty or vacant.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emptiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The house stood <w>idle</w> and empty for many years.",
                            "target_lang_translations": {
                                "ru": "Дом стоял <w>пустым</w> и заброшенным много лет.",
                                "zh": "这栋房子<w>空置</w>了多年。"
                            }
                        },
                        {
                            "text": "He stared across the <w>idle</w> landscape where nothing moved.",
                            "target_lang_translations": {
                                "ru": "Он смотрел на <w>пустынный</w> пейзаж, где ничто не двигалось.",
                                "zh": "他凝视着那片<w>荒凉的</w>景色，那里没有任何动静。"
                            }
                        }
                    ],
                    "synonyms": [
                        "empty",
                        "vacant",
                        "void"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пустой или незанятый.",
                        "zh": "空的或空缺的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "незаполненный"
                            },
                            {
                                "target_lang_word": "пустынный",
                                "target_lang_sense_clarification": "безлюдный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空置的",
                                "target_lang_sense_clarification": "指房屋或空间无人使用"
                            },
                            {
                                "target_lang_word": "荒凉的",
                                "target_lang_sense_clarification": "指景观无人迹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d416f31-f50a-3164-bee5-356d88310c25",
                    "sense_definition": "Light-headed or foolish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "foolishness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>idle</w> youth laughed at things he did not understand.",
                            "target_lang_translations": {
                                "ru": "<w>Легкомысленный</w> юноша смеялся над вещами, которых не понимал.",
                                "zh": "那个<w>轻浮的</w>年轻人嘲笑他所不理解的事物。"
                            }
                        },
                        {
                            "text": "His <w>idle</w> thoughts led him to make a silly mistake.",
                            "target_lang_translations": {
                                "ru": "Его <w>глупые</w> мысли привели его к нелепой ошибке.",
                                "zh": "他<w>愚笨的</w>想法导致他犯了一个愚蠢的错误。"
                            }
                        }
                    ],
                    "synonyms": [
                        "foolish",
                        "silly"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкомысленный или глупый.",
                        "zh": "轻浮的或愚蠢的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легкомысленный",
                                "target_lang_sense_clarification": "ветреный"
                            },
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "глупый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻浮的",
                                "target_lang_sense_clarification": "指态度不庄重"
                            },
                            {
                                "target_lang_word": "愚笨的",
                                "target_lang_sense_clarification": "指思想浅薄"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0d57cdd9-9bc5-3588-a6e2-b825896c37ce",
                    "sense_definition": "To run at a slow speed while out of gear or disconnected from a load (of an engine).",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "engine_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He let the car <w>idle</w> in the driveway while he ran inside.",
                            "target_lang_translations": {
                                "ru": "Он оставил машину <w>работать на холостом ходу</w> на подъездной дорожке, пока бегал внутрь.",
                                "zh": "他让车在车道上<w>怠速</w>运转，自己跑进屋里去了。"
                            }
                        },
                        {
                            "text": "The truck was <w>idling</w> loudly, filling the air with exhaust fumes.",
                            "target_lang_translations": {
                                "ru": "Грузовик громко <w>работал на холостом ходу</w>, наполняя воздух выхлопными газами.",
                                "zh": "卡车大声地<w>怠速</w>运转，空气中充满了废气。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tick over"
                    ],
                    "common_phrases": [
                        "engine idle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать на низкой скорости без нагрузки (о двигателе).",
                        "zh": "指发动机在脱离负载的情况下以低速运转。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "работать на холостом ходу",
                                "target_lang_sense_clarification": "о двигателе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "怠速",
                                "target_lang_sense_clarification": "发动机空转状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78b8014f-0514-3b27-bf68-cdf6d22a5095",
                    "sense_definition": "To spend time doing nothing or wasting time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "wasting_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>idled</w> away the whole afternoon sitting by the river.",
                            "target_lang_translations": {
                                "ru": "Они <w>пробездельничали</w> весь день, сидя у реки.",
                                "zh": "他们坐在河边<w>虚度</w>了整个下午。"
                            }
                        },
                        {
                            "text": "Stop <w>idling</w> and get back to your work immediately.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>бездельничать</w> и немедленно возвращайся к работе.",
                                "zh": "别再<w>游荡</w>了，立刻回去工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "loaf",
                        "laze",
                        "loiter"
                    ],
                    "common_phrases": [
                        "idle away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проводить время ничего не делая или тратить время попусту.",
                        "zh": "虚度光阴或浪费时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бездельничать",
                                "target_lang_sense_clarification": "ничего не делать"
                            },
                            {
                                "target_lang_word": "лодырничать",
                                "target_lang_sense_clarification": "лениться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虚度",
                                "target_lang_sense_clarification": "浪费时间"
                            },
                            {
                                "target_lang_word": "游荡",
                                "target_lang_sense_clarification": "无所事事地闲逛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0dc6128a-002c-32bd-aff4-bf69eff2af66",
                    "sense_definition": "To cause an engine to run at a slow speed without a load.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "engine_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>idle</w> the engine for a minute before turning it off.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>подержать</w> двигатель <w>на холостом ходу</w> минуту перед выключением.",
                                "zh": "熄火前你应该让发动机<w>怠速</w>运转一分钟。"
                            }
                        },
                        {
                            "text": "The mechanic <w>idled</w> the car to check for any strange noises.",
                            "target_lang_translations": {
                                "ru": "Механик <w>запустил</w> машину <w>на холостом ходу</w>, чтобы проверить наличие странных шумов.",
                                "zh": "技工让车<w>怠速</w>运转以检查是否有异响。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить двигатель работать на низкой скорости без нагрузки.",
                        "zh": "使发动机在无负载的情况下以低速运转。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "держать на холостом ходу",
                                "target_lang_sense_clarification": "не выключать двигатель"
                            },
                            {
                                "target_lang_word": "гонять вхолостую",
                                "target_lang_sense_clarification": "о механизме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使怠速",
                                "target_lang_sense_clarification": "让发动机空转"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d853e574-2123-36cc-8478-2c0e82926e67",
                    "sense_definition": "To spend in idleness; to waste or consume.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "wasting_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>idled</w> his inheritance on frivolous parties and travel.",
                            "target_lang_translations": {
                                "ru": "Он <w>промотал</w> свое наследство на легкомысленные вечеринки и путешествия.",
                                "zh": "他把遗产都<w>挥霍</w>在轻浮的派对和旅行上了。"
                            }
                        },
                        {
                            "text": "Do not <w>idle</w> your precious opportunities.",
                            "target_lang_translations": {
                                "ru": "Не <w>упускай</w> свои драгоценные возможности.",
                                "zh": "不要<w>浪费</w>你宝贵的机会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "waste",
                        "squander"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тратить впустую; проматывать.",
                        "zh": "在闲散中度过；浪费或消耗。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проматывать",
                                "target_lang_sense_clarification": "растрачивать"
                            },
                            {
                                "target_lang_word": "тратить попусту",
                                "target_lang_sense_clarification": "упускать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挥霍",
                                "target_lang_sense_clarification": "浪费钱财"
                            },
                            {
                                "target_lang_word": "浪费",
                                "target_lang_sense_clarification": "虚度机会"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b44b36d6-af24-32b2-b9bd-9fd0100fcc0a",
                    "sense_definition": "The state of an engine running at low speed without a load.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "engine_state",
                    "name_type": "no",
                    "examples": [
                        {
