                    {
                        "form_id": "95592d0a-c405-4f8e-8620-1e4f9945f8a7",
                        "entry_id": "97c32c08-e6f3-3d2c-8ca7-ad5d3a10fd9c",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "inconséquente"
                    },
                    {
                        "form_id": "5050c2dc-bc7a-4303-8cc0-0800f558ac27",
                        "entry_id": "97c32c08-e6f3-3d2c-8ca7-ad5d3a10fd9c",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "inconséquentes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1dae81d3-d5e3-32c0-8ffd-6b2cd7a74c3f",
                        "entry_id": "97c32c08-e6f3-3d2c-8ca7-ad5d3a10fd9c",
                        "glosses": [
                            "Qui agit, qui parle sans se conformer à ses propres principes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93e69b9c-49a6-4d8a-8584-41b2a1834c7f",
                                "sense_id": "1dae81d3-d5e3-32c0-8ffd-6b2cd7a74c3f",
                                "text": "Il est aussi inconséquent dans sa conduite que dans ses propos."
                            },
                            {
                                "example_id": "591f3877-acf5-4511-bd32-53c2adb9b7c8",
                                "sense_id": "1dae81d3-d5e3-32c0-8ffd-6b2cd7a74c3f",
                                "text": "Raisonnement inconséquent. Propos inconséquents. Conduite inconséquente."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff09b098-06a9-3894-99dc-49208289e067",
                        "entry_id": "97c32c08-e6f3-3d2c-8ca7-ad5d3a10fd9c",
                        "glosses": [
                            "Qui fait beaucoup d’écarts, qui a de la légèreté dans sa conduite, qui oublie ce qu’exigent les bienséances."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b90f2de5-a79f-408e-ac34-6500e5fabb4b",
                                "sense_id": "ff09b098-06a9-3894-99dc-49208289e067",
                                "text": "Quand une femme est inconséquente, le mari serait, selon loi, minotaurisé."
                            },
                            {
                                "example_id": "cd2318b6-7b86-4d35-966b-49c73bd68132",
                                "sense_id": "ff09b098-06a9-3894-99dc-49208289e067",
                                "text": "Pour écrire ses impressions dans un pareil journal et pour laisser ensuite traîner son manuscrit, il faut être à la fois naïve et inconséquente…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ddd1690-64f1-4da9-be95-c18ade9f3120",
                        "source_entry_id": "97c32c08-e6f3-3d2c-8ca7-ad5d3a10fd9c",
                        "target_lang_word": "inconsequent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconsequent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a0bfd60-127d-3f9f-a5f2-5464081db665",
                                        "entry_id": "fa455d8e-ee6c-3e59-ae12-b8758c113cb4",
                                        "glosses": [
                                            "Alternative form of inconsequential."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d0c541d-e950-4ff9-ac98-ad86a8ee2a27",
                                                "sense_id": "6a0bfd60-127d-3f9f-a5f2-5464081db665",
                                                "text": "—Don’t mope over it all day, he said. I’m inconsequent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "264ecbb4-0b74-3217-9723-29a76acee454",
                                        "entry_id": "fa455d8e-ee6c-3e59-ae12-b8758c113cb4",
                                        "glosses": [
                                            "illogical; not following from the premises"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "debb26c1-49a4-481b-81d4-4b4146619abb",
                                                "sense_id": "264ecbb4-0b74-3217-9723-29a76acee454",
                                                "text": "She looked at him a minute, and it came to him as he met it an inconsequent sense that her eyes, when one got their full clearness, were still as beautiful as they had been in youth, only beautiful with a strange, cold light - a light that somehow was a part of the effect, if it wasn't rather a part of the cause, of the pale, hard sweetness of the season and the hour."
                                            },
                                            {
                                                "example_id": "bc8d613d-4293-4e9d-9e9e-96c1523653b6",
                                                "sense_id": "264ecbb4-0b74-3217-9723-29a76acee454",
                                                "text": "That possibility was now ever so much further from sight than on the eve of his arrival, and he perfectly felt that, should it come at all, it would have to be at best inconsequent and violent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b18719a-7944-4ecd-bdc6-87244eeb10c1",
                        "source_entry_id": "97c32c08-e6f3-3d2c-8ca7-ad5d3a10fd9c",
