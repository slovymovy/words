                    {
                        "sense_id": "85e002a0-29c7-32e7-8364-4b8394e544cf",
                        "entry_id": "547f29bd-cbcb-396b-8286-da651f6e1a43",
                        "glosses": [
                            "een schaal die de winnaar van een competitie of toernooi ontvangt als tegen dat hij of zij gewonnen heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8b82cb4-2ac6-4597-b36b-e4e91b645052",
                                "sense_id": "85e002a0-29c7-32e7-8364-4b8394e544cf",
                                "text": "Maar wat graag zou Dusan Tadic morgenmiddag de kampioensschaal in zijn handen houden, door te winnen van AZ. Nota bene de wedstrijd waarbij voor het eerst sinds lange tijd weer supporters in de Johan Cruijff Arena aanwezig zijn. Maar als PSV vanavond tegen FC Groningen geen punten verspeelt, blijft de trofee op het bondskantoor in Zeist. \"Ja, dat is jammer.\""
                            },
                            {
                                "example_id": "5be3b7c7-3f80-4ba6-9f28-9092d02ef709",
                                "sense_id": "85e002a0-29c7-32e7-8364-4b8394e544cf",
                                "text": "Dan weten we ook of een van de meest besproken personen uit de voetballerij van het laatste jaar het wel of niet aangedurfd heeft om Cambuur persoonlijk de kampioensschaal van de eerste divisie uit te reiken."
                            }
                        ]
                    }
