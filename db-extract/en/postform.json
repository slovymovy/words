                "senses": [
                    {
                        "sense_id": "5ab7c2b1-bf70-3b98-a25a-83933c056c8c",
                        "entry_id": "896ce382-5699-37c8-b2b4-41f17de2fcc9",
                        "glosses": [
                            "To shape or mold as a final stage of construction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b5e7119-c9cf-4128-9f35-738a3a981679",
                                "sense_id": "5ab7c2b1-bf70-3b98-a25a-83933c056c8c",
                                "text": "Polyester laminates which are made with woven fabric fillers postform much more satisfactorily than do paper base laminates."
                            },
                            {
                                "example_id": "2d29fcc7-7ace-40be-a9d8-9ad64ddef5b5",
                                "sense_id": "5ab7c2b1-bf70-3b98-a25a-83933c056c8c",
                                "text": "Whether you postform laminated plastic (the machine here is heating a seamless phenolic plastic counter top), or rely on temperature indicating controllers for any of a thousand other reasons, Fenwal's 541 is the easiest to operate!"
                            },
                            {
                                "example_id": "fcd26398-1058-4594-8b6b-98132b528e5a",
                                "sense_id": "5ab7c2b1-bf70-3b98-a25a-83933c056c8c",
                                "text": "An interesting post-processing capability provided by the thermoplastic matrix in the pultrusion market is the ability to postform within certain constraints and to join profiles by welding."
                            }
                        ]
                    }
                ],
